    """Data Management & Productivity"""

    def __init__(self):
        self.label = "Data Management & Productivity"
        self.alias = "datamgmt"
        self.description = "Keyed dataset diff, typed Excel/CSV import, spatial sequential numbering and long-to-wide pivot, on a Basic licence. Added since the first list: Rule-Based Attribute Update; Disperse Stacked Points; Coordinate Notation Converter. All tools run in the foreground (background geoprocessing is not used)." + " (v" + __version__ + ")"
        self.tools = [KeyedDatasetDiff, TypedExcelImport, SpatialSequentialNumbering, PivotLongToWide, RuleTableAttributeUpdater, CoincidentPointDisperser, CoordinateNotationsCodec]
