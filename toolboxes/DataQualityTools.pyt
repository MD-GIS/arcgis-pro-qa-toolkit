# Toolbox (generated)
# ==========================================================================

class Toolbox(object):
    """Data Quality & Validation"""

    def __init__(self):
        self.label = "Data Quality & Validation"
        self.alias = "dataquality"
        self.description = "Read-only checks and opt-in fixes for attribute domains, keys, geometry quality, bilingual names, multi-value code fields and near-miss vocabulary spellings. Added since the first list: QC Scorecard Report; Positional Accuracy Report (NSSDA/ASPRS); Tile Edge Match Check; Topology Check (Lite); Broken Text Encoding Detector. All tools run in the foreground (background geoprocessing is not used)." + " (v" + __version__ + ")"
        self.tools = [DomainConformanceAudit, NormalisedKeyDiagnostics, GeometryQualityChecker, BilingualNameQA, MultiValueCodeValidator, NearMissVocabularyChecker, QcScorecardAtlas, CheckPointAccuracyReport, TileEdgeConsistencyChecker, TopologyLite, MojibakeDetector]
