# ==========================================================================
# common/errors.py
# ==========================================================================
# Error type used by every tool: a failure always states its cause and its fix.

class ToolError(Exception):
    """A user-facing failure.

    ``cause`` says what went wrong, ``fix`` says what the user can do about it.
    ``str(err)`` gives one readable sentence pair suitable for ``arcpy.AddError``.
    """

    def __init__(self, cause, fix=None):
        Exception.__init__(self, cause)
        self.cause = cause
        self.fix = fix

    def __str__(self):
        if self.fix:
            return "{0} Fix: {1}".format(self.cause, self.fix)
        return str(self.cause)


# ==========================================================================
# common/numeric.py
# ==========================================================================
# Numbers as ArcGIS stores them: single-precision (FLOAT) values.
#
# FLOAT fields hold 32-bit floats (fieldtypes.html), so a value typed as 0.1
# reads back from a cursor as 0.10000000149011612. Comparing that with the text
# "0.1" or with a DOUBLE 0.1 fails although the user sees the same number.
#
# * ``float32_shortest(value)``: the shortest decimal float that rounds to the
#   same 32-bit value (0.10000000149011612 -> 0.1); non-floats unchanged.
# * ``float32_equal(a, b)``: True when two numbers are the same 32-bit float.
# * ``is_single_field(field)``: True for a FLOAT field dict (``Field.type`` "Single").
# * ``exact_number(value)``: a number for comparisons and dictionary keys that
#   keeps integers exact (BigInteger values above 2**53 stay distinct) while
#   1, 1.0 and "1" stay equal.
#
# Pure Python (``struct``), no arcpy. Shared by every toolbox: reuse these
# instead of adding another copy.

_NUMERIC_SINGLE_TYPES = frozenset(["single", "float"])
# Integer text as ArcGIS writes it: ASCII digits only, optional sign.
_NUMERIC_INT_TEXT = re.compile(r"^[+-]?[0-9]+$")


def _numeric_pack(value):
    """4-byte single-precision form of ``value`` or ``None`` (overflow, not a number)."""
    try:
        return struct.pack("<f", value)
    except (OverflowError, struct.error, TypeError):
        return None


def float32_shortest(value):
    """Shortest decimal float with the same single-precision value as ``value``.

    Non-floats, NaN, infinities and values outside the single range are
    returned unchanged.
    """
    if not isinstance(value, float) or value != value or value in (float("inf"), float("-inf")):
        return value
    target = _numeric_pack(value)
    if target is None:
        return value
    for digits in range(1, 10):
        candidate = float("{0:.{1}g}".format(value, digits))
        if _numeric_pack(candidate) == target:
            return candidate
    return value


def float32_equal(a, b):
    """True if numbers ``a`` and ``b`` are the same single-precision value."""
    if isinstance(a, bool) or isinstance(b, bool):
        return False
    try:
        fa, fb = float(a), float(b)
    except (TypeError, ValueError):
        return False
    pa, pb = _numeric_pack(fa), _numeric_pack(fb)
    return pa is not None and pa == pb


def is_single_field(field):
    """True for a FLOAT (single-precision) field dict."""
    return str(field.get("type") or "").casefold() in _NUMERIC_SINGLE_TYPES


def exact_number(value):
    """``value`` as an exact number (``int`` or ``float``), or ``None``.

    ``float()`` loses the last digits of integers above 2**53 (BigInteger
    fields, 16+ digit identifiers), so two different keys or codes would
    compare equal. Integers stay ``int`` here, integer text ("0012",
    "9007199254740993") becomes ``int``, other numbers and numeric text become
    ``float``. Python's ``int`` and ``float`` compare and hash exactly, so 1,
    1.0 and "1" still give equal keys. NaN and values that are not numbers
    give ``None``.
    """
    if value is None:
        return None
    if isinstance(value, int):
        return int(value)  # bool -> 0 / 1, as float() gave
    if isinstance(value, float):
        return None if value != value else value
    if isinstance(value, str):
        text = value.strip()
        if _NUMERIC_INT_TEXT.match(text):
            try:
                return int(text)
            except ValueError:  # over Python's integer text limit
                return None
    try:
        number = float(value)
    except (TypeError, ValueError, OverflowError):
        return None
    return None if number != number else number


# ==========================================================================
# common/messages.py
# ==========================================================================
# Message collector so pure cores can report progress without importing arcpy.
#
# A core appends messages to a ``MessageCollector``; the tool adapter later sends
# them to ArcGIS Pro (see ``arcio.flush_messages``). Levels follow the toolkit
# rule: ``info`` for normal progress, ``warning`` only for things the user must
# act on, ``error`` only for real failure.

MESSAGE_INFO = "info"
MESSAGE_WARNING = "warning"
MESSAGE_ERROR = "error"


class MessageCollector(object):
    """Ordered list of ``(level, text)`` pairs."""

    def __init__(self):
        self.items = []

    def info(self, text):
        self.items.append((MESSAGE_INFO, str(text)))

    def warning(self, text):
        self.items.append((MESSAGE_WARNING, str(text)))

    def error(self, text):
        self.items.append((MESSAGE_ERROR, str(text)))

    def extend(self, other):
        """Append all messages of another collector, keeping their order."""
        self.items.extend(other.items)

    def texts(self, level=None):
        """Message texts, optionally only those of one level."""
        return [t for (lvl, t) in self.items if level is None or lvl == level]

    def has_errors(self):
        return any(lvl == MESSAGE_ERROR for (lvl, _t) in self.items)

    def counts(self):
        """Number of messages per level, e.g. ``{"info": 3, "warning": 1, "error": 0}``."""
        result = {MESSAGE_INFO: 0, MESSAGE_WARNING: 0, MESSAGE_ERROR: 0}
        for lvl, _t in self.items:
            result[lvl] = result.get(lvl, 0) + 1
        return result

    def clear(self):
        self.items = []

    def __len__(self):
        return len(self.items)


# ==========================================================================
# common/text.py
# ==========================================================================
# Text normalisation, placeholder detection, scripts, edit distance, natural sort.
#
# Pure Python (stdlib only). Every character set is a fixed, documented constant
# so results never depend on the Python or Unicode database version for the
# characters that matter here.
#
# Main entry points:
#
# * ``to_nfc(text)``: Unicode canonical composition (NFC). ``normalize_text``
#   and ``arabic_normalize`` always apply it first, so a decomposed spelling
#   (macOS export, PDF copy: "u" + combining diaeresis, Arabic yeh + combining
#   hamza) gets the same result as the precomposed one.
# * ``normalize_text(value, ...)``: options-driven cleaning (whitespace,
#   invisible marks, control characters, digits, case, Arabic folding).
# * ``arabic_normalize(text, ...)``: Arabic-aware folding (tashkeel, tatweel,
#   alef forms, alef maqsura / teh marbuta options, Persian letters, digits).
# * ``is_placeholder(value, ...)``: "N/A", "-", "null", "none", "0000" ...
# * ``script_of(text)`` / ``script_profile(text)``: Arabic / Latin / mixed / digits.
# * ``levenshtein`` / ``damerau_levenshtein``: bounded edit distances.
# * ``natural_sort_key``: "Lot 2" before "Lot 10".
#
# ``None`` is passed through unchanged by every normaliser (a null is not an
# empty string; callers decide how to report it).

# --------------------------------------------------------------------------
# Character sets (fixed lists)
# --------------------------------------------------------------------------

# Whitespace that is folded to an ordinary space: ASCII space and tab, NBSP,
# U+1680, U+2000-U+200A, U+202F, U+205F, U+3000. Line breaks are separate.
TEXT_SPACES = frozenset(
    [u" ", u"\u0009", u" ", u" ", u" ", u" ", u"　"]
    + [chr(c) for c in range(0x2000, 0x200B)])

# Line breaks: LF, CR, VT, FF, NEL, LINE SEPARATOR, PARAGRAPH SEPARATOR.
TEXT_LINE_BREAKS = frozenset([u"\n", u"\r", u"\x0b", u"\x0c", u"\x85", u" ", u" "])

# Invisible format characters removed by ``remove_invisible``: zero width
# space, BOM / zero width no-break space, word joiner, soft hyphen, LRM, RLM,
# Arabic letter mark, bidi embeddings/overrides (U+202A-202E) and isolates
# (U+2066-2069).
TEXT_INVISIBLE = frozenset(
    [u"​", u"﻿", u"⁠", u"­", u"‎", u"‏", u"؜"]
    + [chr(c) for c in range(0x202A, 0x202F)]
    + [chr(c) for c in range(0x2066, 0x206A)])

# Zero width non-joiner / joiner. They change Arabic and Persian shaping, so
# they are removed only when asked (``joiners=True``).
TEXT_JOINERS = frozenset([u"‌", u"‍"])

# Arabic harakat / tashkeel: U+064B-U+065F, superscript alef U+0670,
# Quranic marks U+06D6-U+06ED (excluding U+06DD/U+06DE symbols) and U+0610-061A.
TEXT_ARABIC_TASHKEEL = frozenset(
    [chr(c) for c in range(0x064B, 0x0660)] + [u"ٰ"]
    + [chr(c) for c in range(0x0610, 0x061B)]
    + [chr(c) for c in range(0x06D6, 0x06EE) if c not in (0x06DD, 0x06DE, 0x06E5, 0x06E6)])
TEXT_ARABIC_TATWEEL = u"ـ"

# Alef with madda / hamza above / hamza below / wasla -> bare alef.
TEXT_ALEF_FORMS = {u"آ": u"ا", u"أ": u"ا", u"إ": u"ا",
                   u"ٱ": u"ا"}
TEXT_ALEF_MAQSURA = {u"ى": u"ي"}      # alef maqsura -> yeh
TEXT_TEH_MARBUTA = {u"ة": u"ه"}       # teh marbuta -> heh
# Persian / Urdu letters -> Arabic equivalents (keheh -> kaf, farsi yeh -> yeh).
TEXT_PERSIAN_LETTERS = {u"ک": u"ك", u"ی": u"ي"}

# Arabic-Indic (U+0660-0669) and extended / Persian (U+06F0-06F9) digits -> ASCII.
TEXT_DIGIT_MAP = dict([(chr(0x0660 + i), str(i)) for i in range(10)]
                      + [(chr(0x06F0 + i), str(i)) for i in range(10)])
# Arabic decimal separator and thousands separator (only with separators=True).
TEXT_ARABIC_SEPARATORS = {u"٫": u".", u"٬": u","}

# Default placeholder spellings (compared after trim, whitespace collapse and
# casefold). All-zero strings are handled separately (``zero_run``).
TEXT_DEFAULT_PLACEHOLDERS = frozenset([
    u"n/a", u"n.a.", u"na", u"n\\a", u"-", u"--", u"---", u"null", u"<null>", u"none",
    u"nil", u"?", u"??", u".", u"unknown", u"tbd", u"#n/a", u"x"])


# --------------------------------------------------------------------------
# Small building blocks
# --------------------------------------------------------------------------

def collapse_whitespace(text, keep_line_breaks=False):
    """Fold every ``TEXT_SPACES`` character (and line breaks, unless
    ``keep_line_breaks``) to one space, collapse runs and trim the ends."""
    if text is None:
        return None
    out = []
    pending = False
    for ch in text:
        if ch in TEXT_SPACES or (not keep_line_breaks and ch in TEXT_LINE_BREAKS):
            pending = True
            continue
        if ch in TEXT_LINE_BREAKS:
            # keep the break itself; drop spaces around it
            out.append(ch)
            pending = False
            continue
        if pending and out and out[-1] not in TEXT_LINE_BREAKS:
            out.append(u" ")
        pending = False
        out.append(ch)
    return u"".join(out).strip(u" ")


def has_line_breaks(text):
    """True if ``text`` contains any ``TEXT_LINE_BREAKS`` character."""
    return bool(text) and any(ch in TEXT_LINE_BREAKS for ch in text)


def is_control_char(ch):
    """True for C0/C1 control characters other than line breaks and tab."""
    if ch in TEXT_LINE_BREAKS or ch == u"\t":
        return False
    return unicodedata.category(ch) == "Cc"


def has_control_chars(text):
    """True if ``text`` contains a control character (see ``is_control_char``)."""
    return bool(text) and any(is_control_char(ch) for ch in text)


def strip_control_chars(text, line_breaks=False):
    """Remove control characters; with ``line_breaks=True`` also line breaks and tabs."""
    if text is None:
        return None
    return u"".join(ch for ch in text if not is_control_char(ch)
                    and not (line_breaks and (ch in TEXT_LINE_BREAKS or ch == u"\t")))


def remove_invisible(text, joiners=False):
    """Remove ``TEXT_INVISIBLE`` marks (and ZWNJ/ZWJ when ``joiners``)."""
    if text is None:
        return None
    return u"".join(ch for ch in text if ch not in TEXT_INVISIBLE
                    and not (joiners and ch in TEXT_JOINERS))


def has_invisible(text, joiners=True):
    """True if ``text`` contains an invisible mark (ZWNJ/ZWJ count unless ``joiners=False``)."""
    return bool(text) and any(ch in TEXT_INVISIBLE or (joiners and ch in TEXT_JOINERS)
                              for ch in text)


def fold_digits(text, separators=False):
    """Arabic-Indic and Persian digits -> ASCII; with ``separators`` also
    U+066B -> "." and U+066C -> ","."""
    if text is None:
        return None
    out = []
    for ch in text:
        if ch in TEXT_DIGIT_MAP:
            out.append(TEXT_DIGIT_MAP[ch])
        elif separators and ch in TEXT_ARABIC_SEPARATORS:
            out.append(TEXT_ARABIC_SEPARATORS[ch])
        else:
            out.append(ch)
    return u"".join(out)


def to_nfc(text):
    """Unicode canonical composition (NFC) of a text; anything else (``None``,
    numbers, dates) is returned unchanged.

    Canonically equivalent spellings look identical and must compare equal:
    "u" + U+0308 becomes U+00FC, Arabic yeh + combining hamza above
    (U+064A U+0654) becomes U+0626. Only canonical equivalence is applied
    (not NFKC), so ligatures, superscripts and full-width forms are kept.
    """
    if isinstance(text, str):
        return unicodedata.normalize("NFC", text)
    return text


def _text_is_presentation_form(ch):
    c = ord(ch)
    return (0xFB50 <= c <= 0xFDFF) or (0xFE70 <= c <= 0xFEFE)


def _text_presentation_nfkc(ch):
    """NFKC of one presentation form. The isolated tashkeel forms (U+FE70-FE7E) and the
    shadda ligatures (U+FC5E-FC63) decompose into SPACE + mark(s); the space only carries
    the sign, so it is dropped (otherwise removing the mark as tashkeel leaves a space)."""
    comp = unicodedata.normalize("NFKC", ch)
    if len(comp) > 1 and comp[0] == u" " and all(unicodedata.combining(c) for c in comp[1:]):
        return comp[1:]
    return comp


def arabic_normalize(text, tashkeel=True, tatweel=True, alef=True, alef_maqsura=True,
                     teh_marbuta=False, persian=True, digits=True, presentation=True,
                     marks=True):
    """Arabic-aware folding; each step is an option.

    Unicode NFC is always applied first (``to_nfc``): without it a combining
    hamza (U+0654) of a decomposed spelling would be removed as tashkeel,
    while its precomposed equivalent U+0626 is kept.

    * ``presentation``: Arabic presentation forms (U+FB50-FDFF, U+FE70-FEFE)
      are decomposed with NFKC, applied to those code points only;
    * ``tashkeel``: remove ``TEXT_ARABIC_TASHKEEL``; ``tatweel``: remove U+0640;
    * ``alef``: U+0622/0623/0625/0671 -> U+0627;
    * ``alef_maqsura``: U+0649 -> U+064A (on by default);
    * ``teh_marbuta``: U+0629 -> U+0647 (off by default: it changes meaning);
    * ``persian``: U+06A9 -> U+0643, U+06CC -> U+064A;
    * ``digits``: Arabic-Indic / Persian digits -> ASCII;
    * ``marks``: remove invisible marks including ZWNJ/ZWJ, LRM/RLM, ALM.
    """
    if text is None:
        return None
    text = to_nfc(text)
    if presentation:
        text = u"".join(_text_presentation_nfkc(ch) if _text_is_presentation_form(ch) else ch
                        for ch in text)
    out = []
    for ch in text:
        if tashkeel and ch in TEXT_ARABIC_TASHKEEL:
            continue
        if tatweel and ch == TEXT_ARABIC_TATWEEL:
            continue
        if marks and (ch in TEXT_INVISIBLE or ch in TEXT_JOINERS):
            continue
        if alef and ch in TEXT_ALEF_FORMS:
            ch = TEXT_ALEF_FORMS[ch]
        elif alef_maqsura and ch in TEXT_ALEF_MAQSURA:
            ch = TEXT_ALEF_MAQSURA[ch]
        elif teh_marbuta and ch in TEXT_TEH_MARBUTA:
            ch = TEXT_TEH_MARBUTA[ch]
        elif persian and ch in TEXT_PERSIAN_LETTERS:
            ch = TEXT_PERSIAN_LETTERS[ch]
        elif digits and ch in TEXT_DIGIT_MAP:
            ch = TEXT_DIGIT_MAP[ch]
        out.append(ch)
    return u"".join(out)


def strip_leading_zeros(text):
    """``"007"`` -> ``"7"`` and ``"000"`` -> ``"0"`` for ASCII-digit-only strings;
    anything else is returned unchanged."""
    if text and text.isascii() and text.isdigit():
        return text.lstrip(u"0") or u"0"
    return text


def date_text(value):
    """ISO text of a date/time value; a datetime at exactly 00:00:00 is written as
    the date only ("2024-01-05"), so a DATE field value at midnight, a DATEONLY
    value and an ISO date typed as text give the same text. Other values: ``None``.
    """
    if isinstance(value, datetime.datetime):
        if value.time() == datetime.time(0, 0):
            return value.date().isoformat()
        return value.isoformat(" ")
    if isinstance(value, (datetime.date, datetime.time)):
        return value.isoformat()
    return None


def value_to_text(value):
    """Text form of a cell value for key comparison.

    ``None`` stays ``None``; integral floats lose ``.0`` (``1.0`` -> ``"1"``);
    other numbers use ``repr``-exact ``str``; bools become ``"True"``/``"False"``.
    """
    if value is None:
        return None
    if isinstance(value, bool):
        return str(value)
    if isinstance(value, float):
        if value != value or value in (float("inf"), float("-inf")):
            return str(value)
        if value == int(value):
            return str(int(value))
        return repr(value)
    if isinstance(value, bytes):
        return value.decode("utf-8", "replace")
    return value if isinstance(value, str) else str(value)


def normalize_text(value, trim=True, collapse=True, casefold=False, invisible=True,
                   controls=True, digits=True, leading_zeros=False, arabic=None):
    """Options-driven normalisation of one value (``None`` stays ``None``).

    Order: ``value_to_text`` -> Unicode NFC (always, ``to_nfc``) -> controls
    (removed, line breaks kept for ``collapse``) -> invisible marks -> Arabic (``arabic`` is ``None`` for
    off, ``True`` for defaults, or a dict of ``arabic_normalize`` options)
    -> digits -> whitespace (``collapse`` folds all spaces and line breaks
    to one space; else only ``trim``) -> casefold -> leading zeros.
    """
    text = value_to_text(value)
    if text is None:
        return None
    text = to_nfc(text)
    if controls:
        text = strip_control_chars(text)
    if invisible:
        text = remove_invisible(text)
    if arabic:
        text = arabic_normalize(text, **(arabic if isinstance(arabic, dict) else {}))
    if digits:
        text = fold_digits(text)
    if collapse:
        text = collapse_whitespace(text)
    elif trim:
        text = text.strip(u"".join(sorted(TEXT_SPACES | TEXT_LINE_BREAKS)))
    if casefold:
        text = text.casefold()
    if leading_zeros:
        text = strip_leading_zeros(text)
    return text


def is_blank(value):
    """True for ``None`` and for text that is empty after removing whitespace,
    line breaks and invisible marks."""
    if value is None:
        return True
    if not isinstance(value, str):
        return False
    return collapse_whitespace(remove_invisible(value, joiners=True)) == u""


def is_placeholder(value, placeholders=None, zero_run=3, blank=False):
    """True if ``value`` is a placeholder such as "N/A", "-", "null", "none".

    The value is compared after invisible-mark removal, digit folding,
    whitespace collapse and casefold with ``placeholders`` (an iterable of
    spellings, compared casefolded; default ``TEXT_DEFAULT_PLACEHOLDERS``).
    ``zero_run``: strings of at least this many zeros and nothing else
    ("000", "0000") count; ``None``/0 disables. ``blank``: empty/whitespace
    counts as a placeholder too (default False: report blanks separately).
    Non-text values (numbers, dates, ``None``) are never placeholders.
    """
    if not isinstance(value, str):
        return False
    text = collapse_whitespace(fold_digits(remove_invisible(value, joiners=True))).casefold()
    if text == u"":
        return bool(blank)
    pool = TEXT_DEFAULT_PLACEHOLDERS if placeholders is None else \
        frozenset(collapse_whitespace(str(p)).casefold() for p in placeholders)
    if text in pool:
        return True
    if zero_run and len(text) >= zero_run and text.strip(u"0") == u"":
        return True
    return False


# --------------------------------------------------------------------------
# Scripts
# --------------------------------------------------------------------------

SCRIPT_ARABIC = "arabic"
SCRIPT_LATIN = "latin"
SCRIPT_MIXED = "mixed"
SCRIPT_DIGITS = "digits"
SCRIPT_OTHER = "other"
SCRIPT_EMPTY = "empty"

_TEXT_ARABIC_BLOCKS = ((0x0600, 0x06FF), (0x0750, 0x077F), (0x08A0, 0x08FF),
                       (0xFB50, 0xFDFF), (0xFE70, 0xFEFF))


def _text_in_arabic_block(c):
    for lo, hi in _TEXT_ARABIC_BLOCKS:
        if lo <= c <= hi:
            return True
    return False


def script_profile(text):
    """Character counts: ``{"arabic", "latin", "other_letters", "ascii_digits",
    "arabic_digits", "other_digits", "other"}``.

    Letters are Unicode category L*; Arabic = letters in the Arabic blocks;
    Latin = letters whose Unicode name starts with "LATIN". Combining marks
    (tashkeel), spaces and punctuation count as "other".
    """
    counts = {"arabic": 0, "latin": 0, "other_letters": 0, "ascii_digits": 0,
              "arabic_digits": 0, "other_digits": 0, "other": 0}
    for ch in text or u"":
        cat = unicodedata.category(ch)
        c = ord(ch)
        if cat == "Nd":
            if u"0" <= ch <= u"9":
                counts["ascii_digits"] += 1
            elif ch in TEXT_DIGIT_MAP:
                counts["arabic_digits"] += 1
            else:
                counts["other_digits"] += 1
        elif cat.startswith("L"):
            if _text_in_arabic_block(c):
                counts["arabic"] += 1
            elif unicodedata.name(ch, "").startswith("LATIN"):
                counts["latin"] += 1
            else:
                counts["other_letters"] += 1
        else:
            counts["other"] += 1
    return counts


def script_of(text):
    """Dominant script of ``text``.

    ``"empty"`` (no letters or digits), ``"digits"`` (digits only, any
    script), ``"arabic"``, ``"latin"``, ``"other"`` (letters of one other
    script family) or ``"mixed"`` (letters of more than one of Arabic /
    Latin / other). Digits never make a text mixed.
    """
    p = script_profile(text)
    families = [k for k in ("arabic", "latin", "other_letters") if p[k]]
    if not families:
        if p["ascii_digits"] or p["arabic_digits"] or p["other_digits"]:
            return SCRIPT_DIGITS
        return SCRIPT_EMPTY
    if len(families) > 1:
        return SCRIPT_MIXED
    return {"arabic": SCRIPT_ARABIC, "latin": SCRIPT_LATIN,
            "other_letters": SCRIPT_OTHER}[families[0]]


def has_mixed_digits(text):
    """True if ``text`` mixes ASCII digits with Arabic-Indic/Persian digits."""
    p = script_profile(text)
    return bool(p["ascii_digits"] and p["arabic_digits"])


# --------------------------------------------------------------------------
# Edit distance
# --------------------------------------------------------------------------

def levenshtein(a, b, max_distance=None):
    """Levenshtein distance (insert, delete, substitute; each cost 1).

    With ``max_distance`` the computation stops early and returns
    ``max_distance + 1`` as soon as the distance is known to exceed it.
    ``None`` inputs are treated as empty strings.
    """
    a = a or u""
    b = b or u""
    if a == b:
        return 0
    if len(a) < len(b):
        a, b = b, a
    if max_distance is not None and len(a) - len(b) > max_distance:
        return max_distance + 1
    if not b:
        return len(a)
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i] + [0] * len(b)
        row_min = i
        for j, cb in enumerate(b, 1):
            cost = 0 if ca == cb else 1
            v = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            cur[j] = v
            if v < row_min:
                row_min = v
        if max_distance is not None and row_min > max_distance:
            return max_distance + 1
        prev = cur
    d = prev[-1]
    if max_distance is not None and d > max_distance:
        return max_distance + 1
    return d


def damerau_levenshtein(a, b, max_distance=None):
    """Optimal-string-alignment distance: Levenshtein plus transposition of
    two adjacent characters (cost 1). A substring is never edited twice, so
    ``("CA", "ABC")`` is 3 (the unrestricted Damerau distance would be 2).

    ``max_distance`` bounds as in ``levenshtein``.
    """
    a = a or u""
    b = b or u""
    if a == b:
        return 0
    if max_distance is not None and abs(len(a) - len(b)) > max_distance:
        return max_distance + 1
    if not a or not b:
        return max(len(a), len(b))
    n = len(b)
    two_back = None
    prev = list(range(n + 1))
    prev_min = 0
    for i in range(1, len(a) + 1):
        cur = [i] + [0] * n
        row_min = i
        for j in range(1, n + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            v = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            if (two_back is not None and j > 1 and a[i - 1] == b[j - 2]
                    and a[i - 2] == b[j - 1]):
                v = min(v, two_back[j - 2] + 1)
            cur[j] = v
            if v < row_min:
                row_min = v
        # Later cells come from this row or, by a transposition, from the
        # previous row plus 1: both minima bound the final distance.
        if max_distance is not None and min(row_min, prev_min + 1) > max_distance:
            return max_distance + 1
        two_back, prev, prev_min = prev, cur, row_min
    d = prev[-1]
    if max_distance is not None and d > max_distance:
        return max_distance + 1
    return d


# --------------------------------------------------------------------------
# Natural sort
# --------------------------------------------------------------------------

def natural_sort_key(value):
    """Sort key that orders digit runs numerically: "Lot 2" < "Lot 10".

    Digits are folded to ASCII first (Arabic-Indic digits sort as numbers),
    text chunks are compared casefolded, and the raw text is the last
    tie-break, so the order is total and deterministic ("7" < "007" < "07"
    is decided by the raw strings). ``None`` sorts before every text;
    non-text values are converted with ``value_to_text``. Signs and decimal
    points are not interpreted ("1.5" is 1, ".", 5).
    """
    if value is None:
        return (0, (), u"")
    raw = value_to_text(value)
    text = fold_digits(raw)
    chunks = []
    i = 0
    n = len(text)
    while i < n:
        j = i
        if text[i].isascii() and text[i].isdigit():
            while j < n and text[j].isascii() and text[j].isdigit():
                j += 1
            chunks.append((0, int(text[i:j]), u""))
        else:
            while j < n and not (text[j].isascii() and text[j].isdigit()):
                j += 1
            chunks.append((1, 0, text[i:j].casefold()))
        i = j
    return (1, tuple(chunks), raw)


# ==========================================================================
# common/issues.py
# ==========================================================================
# Unified QC issue schema and the adapters that fill it (pure Python, no arcpy).
#
# The QC Scorecard Report reads the Detail outputs of the toolkit's quality tools and
# turns every row into one *issue*, a plain dict with the keys of
# ``UNI_FIELDS`` (``RUN_ID`` is added by the caller)::
#
#     TOOL, RULE_ID, SOURCE, SRC_OID, SEVERITY, X, Y, MESSAGE, FIELD, VALUE
#
# There is **one adapter function per tool**; none of the tools is changed. The column
# names an adapter expects are the REAL names ArcGIS Pro wrote in the captured
# outputs (``tests/fixtures/pro/<Tool>/<case>/``), not names taken from documents:
#
# =========================  =======================================================
# GeometryQualityChecker     SRC_OID, CHECK, PART, VERTEX, VALUE, UNIT, DETAIL
#                            (point feature class; location = the point)
# DomainConformanceAudit     SRC_TABLE, SRC_OID, FIELD, SUBTYPE_CODE, DOMAIN, VALUE,
#                            ISSUE, SUGGESTED (table: no location of its own)
# LineNetworkRules           RULE, LAYER, SRC_OID, NODE_ID, DEGREE, VALUE, DETAIL
#                            (point feature class; location = the point)
# unified table              RULE_ID, SEVERITY, MESSAGE and SRC_OID (or OID); optional
#                            RUN_ID, TOOL, SOURCE, X, Y, FIELD, VALUE
# =========================  =======================================================
#
# A row given to an adapter is a dict ``{column name: value}`` plus the special keys
# ``"_xy"`` (``(x, y)`` taken from the row's geometry, or ``None``). Columns an
# adapter does not know are not lost: they are appended to MESSAGE as ``NAME=value``.
#
# The tools write no severity. ``UNI_SEVERITY_BY_RULE`` is this toolkit's own default
# classification (a judgement, not a standard); the Atlas lets a threshold table
# override it per rule.

UNI_TOOL_GEOMETRY = "GeometryQualityChecker"
UNI_TOOL_DOMAIN = "DomainConformanceAudit"
UNI_TOOL_NETWORK = "LineNetworkRules"
UNI_TOOL_UNIFIED = "UNIFIED"
UNI_TOOLS = (UNI_TOOL_GEOMETRY, UNI_TOOL_DOMAIN, UNI_TOOL_NETWORK, UNI_TOOL_UNIFIED)
UNI_TOOL_AUTO = "AUTO"

UNI_ERROR = "ERROR"
UNI_WARNING = "WARNING"
UNI_INFO = "INFO"
UNI_SEVERITIES = (UNI_ERROR, UNI_WARNING, UNI_INFO)

# Column order of the unified issue table. The handoff calls the object id column OID;
# the toolkit's own outputs all call it SRC_OID and OID is not used as a field name here.
UNI_FIELDS = ("RUN_ID", "TOOL", "RULE_ID", "SOURCE", "SRC_OID", "SEVERITY", "X", "Y",
              "MESSAGE", "FIELD", "VALUE")

UNI_MESSAGE_MAX = 1000   # characters kept in MESSAGE
UNI_VALUE_MAX = 254      # characters kept in VALUE / FIELD / SOURCE / RULE_ID

# Default severity per rule (the tools write none). Unknown rules: UNI_DEFAULT_SEVERITY.
UNI_DEFAULT_SEVERITY = UNI_WARNING
UNI_SEVERITY_BY_RULE = {
    # GeometryQualityChecker
    "SPIKE": UNI_ERROR,
    "NEAR_DUP_VERTEX": UNI_ERROR,
    "SHORT_SEGMENT": UNI_WARNING,
    "SLIVER": UNI_WARNING,
    "TINY_AREA": UNI_WARNING,
    "TINY_PART": UNI_WARNING,
    "REMOTE_PART": UNI_WARNING,
    # DomainConformanceAudit: the stored value is not a valid code of its domain
    "OUT_OF_DOMAIN": UNI_ERROR,
    "OUT_OF_RANGE": UNI_ERROR,
    "DESCRIPTION_AS_CODE": UNI_ERROR,
    "CASE_OR_SPACE_VARIANT": UNI_ERROR,
    "AMBIGUOUS_DESCRIPTION": UNI_ERROR,
    "INVALID_SUBTYPE": UNI_ERROR,
    "NULL_VALUE": UNI_WARNING,
    # LineNetworkRules
    "DANGLE": UNI_ERROR,
    "PSEUDO_NODE": UNI_WARNING,
    "T_MISS": UNI_ERROR,
    "WIDE_NODE_CLUSTER": UNI_WARNING,
    "POINT_NOT_ON_LINE": UNI_ERROR,
    "POINT_NOT_ON_ENDPOINT": UNI_ERROR,
}

# Columns that belong to the table itself, never to the issue.
_UNI_SYSTEM_COLUMNS = frozenset(["OBJECTID", "FID", "SHAPE", "SHAPE_LENGTH", "SHAPE_AREA",
                                 "SHAPE_LEN", "GLOBALID", "OID@", "SHAPE@", "SHAPE@JSON"])

# Required columns (upper case) per tool; a table is recognised as the first whose
# required columns are all present (unified first, then the others).
_UNI_REQUIRED = (
    (UNI_TOOL_UNIFIED, ("RULE_ID", "SEVERITY", "MESSAGE")),
    (UNI_TOOL_GEOMETRY, ("SRC_OID", "CHECK", "DETAIL")),
    (UNI_TOOL_DOMAIN, ("SRC_TABLE", "SRC_OID", "FIELD", "DOMAIN", "VALUE", "ISSUE")),
    (UNI_TOOL_NETWORK, ("RULE", "LAYER", "SRC_OID", "DETAIL")),
)
# Known (consumed) columns per tool; everything else goes to MESSAGE.
_UNI_KNOWN = {
    UNI_TOOL_GEOMETRY: ("SRC_OID", "CHECK", "PART", "VERTEX", "VALUE", "UNIT", "DETAIL"),
    UNI_TOOL_DOMAIN: ("SRC_TABLE", "SRC_OID", "FIELD", "SUBTYPE_CODE", "DOMAIN", "VALUE",
                      "ISSUE", "SUGGESTED"),
    UNI_TOOL_NETWORK: ("RULE", "LAYER", "SRC_OID", "NODE_ID", "DEGREE", "VALUE", "DETAIL"),
    UNI_TOOL_UNIFIED: ("RUN_ID", "TOOL", "RULE_ID", "SOURCE", "SRC_OID", "OID", "SEVERITY",
                       "X", "Y", "MESSAGE", "FIELD", "VALUE"),
}
# The hygiene table of DomainConformanceAudit (out_domain_table) is a different output.
_UNI_DOMAIN_HYGIENE = ("DOMAIN", "RECORD_TYPE", "ISSUE")


def uni_clean_text(value, limit=None):
    """Text for a table or an HTML page: ``None`` stays ``None``; control characters
    (except tab and line breaks, which become spaces) are removed; the text is cut to
    ``limit`` characters with an ellipsis."""
    if value is None:
        return None
    if isinstance(value, float):
        text = uni_format_number(value)
    else:
        text = str(value)
    out = []
    for ch in text:
        if ch in "\t\r\n":
            out.append(" ")
        elif ord(ch) < 32 or ord(ch) in (127, 0xFFFE, 0xFFFF) or 0xD800 <= ord(ch) <= 0xDFFF:
            continue
        else:
            out.append(ch)
    text = "".join(out).strip()
    if limit is not None and len(text) > limit:
        text = text[:max(limit - 3, 0)] + "..."
    return text


def uni_format_number(value):
    """Short text of a number (6 significant digits); other values as text."""
    if isinstance(value, bool):
        return str(value)
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        if math.isnan(value) or math.isinf(value):
            return ""
        return "{0:.6g}".format(value)
    return str(value)


def uni_normalise_severity(value, default=UNI_DEFAULT_SEVERITY):
    """``ERROR`` / ``WARNING`` / ``INFO`` from any capitalisation (``WARN`` too);
    ``(severity, recognised)`` where ``recognised`` is False when ``default`` was used."""
    text = str(value).strip().upper() if value is not None else ""
    aliases = {"ERR": UNI_ERROR, "CRITICAL": UNI_ERROR, "WARN": UNI_WARNING,
               "INFORMATION": UNI_INFO, "NOTE": UNI_INFO}
    text = aliases.get(text, text)
    if text in UNI_SEVERITIES:
        return text, True
    return default, False


def uni_severity_for(rule_id):
    """Default severity of a rule id (``UNI_DEFAULT_SEVERITY`` for an unknown rule)."""
    return UNI_SEVERITY_BY_RULE.get(str(rule_id).strip().upper(), UNI_DEFAULT_SEVERITY)


def _uni_upper_row(row):
    """``{UPPER NAME: value}`` of the attribute columns of a row (special keys dropped)."""
    return dict((str(k).upper(), v) for k, v in row.items() if not str(k).startswith("_"))


def uni_detect_tool(columns):
    """Which tool's Detail output (or the unified schema) a table with these column
    names is; ``None`` when none matches. Names are compared in upper case."""
    names = set(str(c).upper() for c in columns)
    if "OID" in names and "SRC_OID" not in names:
        names.add("SRC_OID")   # the unified schema as the handoff spells it
    for tool, required in _UNI_REQUIRED:
        if all(name in names for name in required):
            return tool
    return None


def uni_missing_columns(tool, columns):
    """Required columns (upper case) of ``tool`` that a table with ``columns`` lacks."""
    names = set(str(c).upper() for c in columns)
    if "OID" in names and "SRC_OID" not in names:
        names.add("SRC_OID")
    for name, required in _UNI_REQUIRED:
        if name == tool:
            return [c for c in required if c not in names]
    return []


def uni_is_domain_hygiene_table(columns):
    """True for the usage / hygiene table of DomainConformanceAudit (not an issue table)."""
    names = set(str(c).upper() for c in columns)
    return all(name in names for name in _UNI_DOMAIN_HYGIENE) and "SRC_OID" not in names


def uni_describe_columns_needed():
    """Text for an error message: the columns each supported table must have."""
    parts = []
    for tool, required in _UNI_REQUIRED:
        parts.append("{0}: {1}".format("unified issue table" if tool == UNI_TOOL_UNIFIED else tool,
                                       ", ".join(required)))
    return "; ".join(parts)


def _uni_extras(upper_row, tool):
    """Text ``NAME=value`` of the columns the adapter does not know (empty values skipped)."""
    known = set(_UNI_KNOWN[tool])
    parts = []
    for name in sorted(upper_row):
        if name in known or name in _UNI_SYSTEM_COLUMNS:
            continue
        value = upper_row[name]
        if value is None or (isinstance(value, str) and not value.strip()):
            continue
        parts.append("{0}={1}".format(name, uni_clean_text(value, 80)))
    return "; ".join(parts)


def _uni_message(text, extras, rule_id):
    text = uni_clean_text(text) or ""
    if not text:
        text = str(rule_id)
    if extras:
        text = "{0} [{1}]".format(text, extras)
    return uni_clean_text(text, UNI_MESSAGE_MAX)


def _uni_xy(row):
    xy = row.get("_xy")
    if xy is None:
        return None, None
    try:
        x, y = float(xy[0]), float(xy[1])
    except (TypeError, ValueError, IndexError):
        return None, None
    if math.isnan(x) or math.isnan(y) or math.isinf(x) or math.isinf(y):
        return None, None
    return x, y


def _uni_int(value):
    try:
        if value is None or (isinstance(value, str) and not value.strip()):
            return None
        if isinstance(value, int) and not isinstance(value, bool):
            return value
        if isinstance(value, str):
            try:
                # a text ObjectID field (``arcio.oid_field_spec`` in a folder) keeps every digit;
                # float() would round ids of more than 15 digits
                return int(value.strip())
            except ValueError:
                pass
        return int(float(value))
    except (TypeError, ValueError, OverflowError):
        return None


def _uni_issue(tool, rule_id, source, oid, severity, x, y, message, field, value,
               sev_from="default"):
    """One issue. ``_sev_from`` says where the severity came from: ``default`` (the toolkit's
    default for the rule; the source tools write none), ``table`` (a unified table's own
    SEVERITY column) or ``guess`` (an unrecognised value, taken as WARNING)."""
    return {"_sev_from": sev_from, "TOOL": tool,
            "RULE_ID": uni_clean_text(rule_id, UNI_VALUE_MAX) or "UNKNOWN",
            "SOURCE": uni_clean_text(source, UNI_VALUE_MAX),
            "SRC_OID": oid, "SEVERITY": severity, "X": x, "Y": y,
            "MESSAGE": message,
            "FIELD": uni_clean_text(field, UNI_VALUE_MAX),
            "VALUE": uni_clean_text(value, UNI_VALUE_MAX)}


def adapt_geometry_quality(rows, source=None):
    """GeometryQualityChecker ``out_features`` rows -> issues.

    RULE_ID = CHECK; SOURCE = ``source`` (the checked dataset; the tool's output carries no
    dataset name); SRC_OID = SRC_OID; X, Y = the error point; MESSAGE = DETAIL;
    VALUE = VALUE + UNIT (for example ``2.29153 deg``). PART and VERTEX are only in DETAIL.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("CHECK")
        severity = uni_severity_for(rule)
        x, y = _uni_xy(row)
        value = r.get("VALUE")
        value_text = None
        if value is not None and uni_format_number(value) != "":
            value_text = uni_format_number(value)
            if r.get("UNIT"):
                value_text += " " + str(r["UNIT"])
        message = _uni_message(r.get("DETAIL"), _uni_extras(r, UNI_TOOL_GEOMETRY), rule)
        out.append(_uni_issue(UNI_TOOL_GEOMETRY, rule, source, _uni_int(r.get("SRC_OID")),
                              severity, x, y, message, None, value_text))
    return out


_UNI_DOMAIN_TEXT = {
    "OUT_OF_DOMAIN": "is not a code of domain {domain}",
    "OUT_OF_RANGE": "is outside the range of domain {domain}",
    "DESCRIPTION_AS_CODE": "is the description of a code of domain {domain}, not the code",
    "CASE_OR_SPACE_VARIANT": "differs from a code of domain {domain} only by case or spaces",
    "AMBIGUOUS_DESCRIPTION": "matches more than one description of domain {domain}",
    "INVALID_SUBTYPE": "is not a defined subtype",
    "NULL_VALUE": "is empty although domain {domain} applies",
}


def adapt_domain_conformance(rows, source=None):
    """DomainConformanceAudit ``out_table`` rows (violations) -> issues.

    RULE_ID = ISSUE; SOURCE = SRC_TABLE (``source`` only when that is empty); SRC_OID = SRC_OID;
    FIELD = FIELD; VALUE = VALUE; MESSAGE is built from the columns (field, value, domain,
    subtype, suggestion). The table has no geometry, so X and Y are empty unless the caller
    locates the feature later (``QcScorecardAtlas`` does, from the checked dataset).
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("ISSUE")
        field = r.get("FIELD")
        value = r.get("VALUE")
        domain = r.get("DOMAIN")
        template = _UNI_DOMAIN_TEXT.get(str(rule).strip().upper() if rule is not None else "",
                                        "has the issue " + str(rule))
        shown = "empty" if value is None else "'{0}'".format(uni_clean_text(value, 120))
        text = "Field {0}: value {1} {2}".format(field, shown,
                                                 template.format(domain=domain or "(none)"))
        if r.get("SUBTYPE_CODE") is not None and uni_format_number(r["SUBTYPE_CODE"]) != "":
            text += " (subtype {0})".format(uni_format_number(r["SUBTYPE_CODE"]))
        if r.get("SUGGESTED") not in (None, ""):
            text += "; suggested: {0}".format(uni_clean_text(r["SUGGESTED"], 80))
        message = _uni_message(text + ".", _uni_extras(r, UNI_TOOL_DOMAIN), rule)
        table = r.get("SRC_TABLE")
        x, y = _uni_xy(row)
        out.append(_uni_issue(UNI_TOOL_DOMAIN, rule, table if table not in (None, "") else source,
                              _uni_int(r.get("SRC_OID")), uni_severity_for(rule), x, y, message,
                              field, value))
    return out


def adapt_line_network_rules(rows, source=None):
    """LineNetworkRules ``out_errors`` rows -> issues.

    RULE_ID = RULE; SOURCE = LAYER (``source`` only when that is empty; point-rule rows name
    the rule-point layer); SRC_OID = SRC_OID; X, Y = the error point; MESSAGE = DETAIL;
    VALUE = VALUE (metres) when present. NODE_ID and DEGREE are not carried.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("RULE")
        x, y = _uni_xy(row)
        value = r.get("VALUE")
        value_text = None
        if value is not None and uni_format_number(value) != "":
            value_text = uni_format_number(value) + " m"
        layer = r.get("LAYER")
        message = _uni_message(r.get("DETAIL"), _uni_extras(r, UNI_TOOL_NETWORK), rule)
        out.append(_uni_issue(UNI_TOOL_NETWORK, rule, layer if layer not in (None, "") else source,
                              _uni_int(r.get("SRC_OID")), uni_severity_for(rule), x, y, message,
                              None, value_text))
    return out


def adapt_unified(rows, source=None):
    """Rows already in the unified schema -> issues.

    SEVERITY is normalised (an unrecognised one becomes WARNING and the issue gets
    ``"_severity_guess": True``). X and Y come from the columns X and Y, else from the row's
    geometry. TOOL defaults to ``UNIFIED``; SOURCE to ``source``. RUN_ID is not carried.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("RULE_ID")
        severity, recognised = uni_normalise_severity(r.get("SEVERITY"))
        x, y = None, None
        try:
            if r.get("X") is not None and r.get("Y") is not None:
                x, y = float(r["X"]), float(r["Y"])
                if math.isnan(x) or math.isnan(y) or math.isinf(x) or math.isinf(y):
                    x, y = None, None
        except (TypeError, ValueError):
            x, y = None, None
        if x is None:
            x, y = _uni_xy(row)
        oid = _uni_int(r.get("SRC_OID") if r.get("SRC_OID") is not None else r.get("OID"))
        tool = uni_clean_text(r.get("TOOL"), UNI_VALUE_MAX) or UNI_TOOL_UNIFIED
        extras = _uni_extras(r, UNI_TOOL_UNIFIED)
        message = _uni_message(r.get("MESSAGE"), extras, rule)
        src = r.get("SOURCE")
        issue = _uni_issue(tool, rule, src if src not in (None, "") else source, oid, severity,
                           x, y, message, r.get("FIELD"), r.get("VALUE"),
                           "table" if recognised else "guess")
        if not recognised:
            issue["_severity_guess"] = True
        out.append(issue)
    return out


UNI_ADAPTERS = {UNI_TOOL_GEOMETRY: adapt_geometry_quality,
                UNI_TOOL_DOMAIN: adapt_domain_conformance,
                UNI_TOOL_NETWORK: adapt_line_network_rules,
                UNI_TOOL_UNIFIED: adapt_unified}


def uni_adapt(tool, rows, source=None):
    """Issues of ``rows`` with the adapter of ``tool`` (one of ``UNI_TOOLS``)."""
    return UNI_ADAPTERS[tool](rows, source)


def uni_issue_row(issue, run_id):
    """Values of one issue in ``UNI_FIELDS`` order (for the output table)."""
    values = dict(issue)
    values["RUN_ID"] = run_id
    return [values.get(name) for name in UNI_FIELDS]


# ==========================================================================
# common/fields.py
# ==========================================================================
# Field lookup that tolerates the way people actually type field names.
#
# Rule (toolkit engineering rule 1): match the **alias first, then the name**,
# ignoring case, spaces, dashes and underscores. The caller is told which one
# matched so it can report it. Two or more candidates is an error that lists them;
# the tool never guesses.
#
# Fields are plain dicts as returned by ``arcio.describe_dataset``::
#
#     {"name": "NAME_EN", "alias": "Name (English)", "type": "String",
#      "length": 50, "domain": None, ...}

# Characters ignored when comparing field names (besides all Unicode whitespace).
_FIELDS_IGNORED = frozenset("-_‐‑‒–—ـ")  # dashes, underscore, Arabic tatweel

MATCHED_BY_ALIAS = "alias"
MATCHED_BY_NAME = "name"


def normalize_field_name(text):
    """Comparison key for a field name or alias.

    NFKC-normalises (so Arabic presentation forms and full-width Latin compare
    equal to their plain forms), case-folds, and drops whitespace, dashes,
    underscores and the Arabic tatweel.
    """
    if text is None:
        return ""
    text = unicodedata.normalize("NFKC", str(text)).casefold()
    return "".join(ch for ch in text if not ch.isspace() and ch not in _FIELDS_IGNORED)


def describe_field(field):
    """Human readable ``NAME (alias: Alias)`` label for messages."""
    alias = field.get("alias")
    if alias and alias != field["name"]:
        return "{0} (alias: {1})".format(field["name"], alias)
    return field["name"]


def match_field(fields, wanted, required=True, label=None, exact_name_first=False):
    """Find the field the user means by ``wanted``.

    Returns ``(field, matched_by)`` where ``matched_by`` is ``"alias"`` or
    ``"name"``; returns ``(None, None)`` when nothing matches and ``required``
    is False. Raises ``ToolError`` for an ambiguous match, or for no match when
    ``required`` is True. ``label`` names the parameter in messages.

    ``exact_name_first``: use it when ``wanted`` comes from a ``Field``
    parameter (a field *name* picked from the list). A field whose name equals
    ``wanted`` exactly (then ignoring case only) wins before any alias, so a
    different field that merely carries that text as its alias is never used.
    Rule 1 (alias first, tolerant comparison) still applies when nothing has
    that exact name, e.g. for typed or configured names.
    """
    if exact_name_first and wanted:
        for same in (lambda n: n == wanted, lambda n: n.casefold() == str(wanted).casefold()):
            hits = [f for f in fields if f.get("name") is not None and same(f["name"])]
            if len(hits) == 1:
                return hits[0], MATCHED_BY_NAME
    key = normalize_field_name(wanted)
    what = label or "field"
    if not key:
        if required:
            raise ToolError("No {0} was given.".format(what),
                            "Choose a field from the list.")
        return None, None

    for matched_by, attr in ((MATCHED_BY_ALIAS, "alias"), (MATCHED_BY_NAME, "name")):
        hits = [f for f in fields if normalize_field_name(f.get(attr)) == key]
        if len(hits) == 1:
            return hits[0], matched_by
        if len(hits) > 1:
            raise ToolError(
                "The {0} '{1}' is ambiguous: it matches the {2} of {3} fields: {4}.".format(
                    what, wanted, attr, len(hits), ", ".join(describe_field(f) for f in hits)),
                "Type the exact field name instead, or rename one of the fields or aliases.")

    if required:
        available = ", ".join(describe_field(f) for f in fields) or "(none)"
        raise ToolError(
            "The {0} '{1}' was not found by alias or by name.".format(what, wanted),
            "Choose one of the available fields: {0}.".format(available))
    return None, None


def match_fields(fields, wanted_names, label=None, exact_name_first=False):
    """Resolve several required fields at once.

    Returns a list of ``(wanted, field, matched_by)`` in the given order.
    """
    return [(w,) + match_field(fields, w, True, label, exact_name_first) for w in wanted_names]


def match_message(wanted, field, matched_by):
    """Message text reporting how a field was resolved."""
    return "Field '{0}' matched {1} by {2}.".format(wanted, describe_field(field), matched_by)


def text_field_length(values, minimum=1):
    """Width for a text field that must hold every value in ``values``.

    ``None`` values are ignored; other values are measured as ``str(value)``.
    Engineering rule 8: text widths are derived from the longest value written.
    """
    longest = 0
    for value in values:
        if value is not None:
            longest = max(longest, len(str(value)))
    return max(int(minimum), longest)


# ==========================================================================
# common/domains.py
# ==========================================================================
# Coded-value and range domains, at field AND subtype level, as plain dicts.
#
# Engineering rule 2: read domains at field and subtype level, never guess a
# code, and when a needed value is not in the domain stop with a message that
# lists the accepted values.
#
# Structures (built by ``arcio.read_domains`` / ``arcio.read_subtypes``, or by
# hand in tests)::
#
#     domains = {"D_Status": {"name": "D_Status", "domain_type": "CodedValue",
#                             "field_type": "Short",
#                             "codes": {1: "Active", 2: "Retired"},
#                             "range": None}}
#
#     subtypes = {"field": "ROAD_CLASS",          # "" when the table has no subtypes
#                 "subtypes": {1: {"name": "Primary",
#                                  "domains": {"SURFACE": "D_Surface_Primary"}}}}
#
# Field-level domains come from the field dicts (``field["domain"]``).

_DOMAINS_NUMERIC_TYPES = frozenset(
    ["short", "long", "smallinteger", "integer", "biginteger", "float", "single", "double"])


def domain_for_field(field_name, field_domain, subtypes=None, subtype_code=None):
    """Name of the domain that applies to ``field_name`` for one row.

    If the table has a subtype field and ``subtype_code`` is one of its
    subtypes that lists this field, the subtype-level domain wins (``None``
    there means the subtype deliberately has no domain). Otherwise the
    field-level domain ``field_domain`` applies.
    """
    if subtypes and subtypes.get("field") and subtype_code is not None:
        entry = _domains_find_subtype(subtypes, subtype_code)
        if entry is not None:
            per_field = entry.get("domains") or {}
            for name, dom in per_field.items():
                if name.casefold() == str(field_name).casefold():
                    return dom or None
    return field_domain or None


def _domains_find_subtype(subtypes, code):
    table = subtypes.get("subtypes") or {}
    if code in table:
        return table[code]
    for key, entry in table.items():
        if _domains_same_value(key, code, numeric=True):
            return entry
    return None


def _domains_is_numeric(domain):
    return str(domain.get("field_type") or "").casefold() in _DOMAINS_NUMERIC_TYPES


def _domains_same_value(a, b, numeric):
    """Equality that treats 1, 1.0 and "1" as equal for numeric domains only."""
    if a is None or b is None:
        return a is b
    if numeric:
        # exact_number, not float(): BigInteger codes above 2**53 stay distinct.
        na, nb = exact_number(a), exact_number(b)
        return na is not None and na == nb
    return str(a) == str(b)


def accepted_values_text(domain, limit=50):
    """``code = description`` list for messages (truncated after ``limit``)."""
    if domain.get("domain_type") == "Range":
        low, high = domain.get("range") or (None, None)
        return "a value from {0} to {1}".format(low, high)
    pairs = ["{0} = {1}".format(c, d) for c, d in (domain.get("codes") or {}).items()]
    if len(pairs) > limit:
        pairs = pairs[:limit] + ["... ({0} more)".format(len(pairs) - limit)]
    return "; ".join(pairs) if pairs else "(the domain has no codes)"


class CodedValueIndex(object):
    """Set of the codes of one coded-value domain, built once.

    ``value in index`` gives the same answer as ``value_in_domain`` (numbers
    compared exactly for numeric domains, so "1", 1 and 1.0 are equal; text
    compared as text) in constant time instead of a scan over every code.
    """

    def __init__(self, domain):
        self.numeric = _domains_is_numeric(domain)
        self.keys = set()
        for code in (domain.get("codes") or {}):
            key = self._key(code)
            if key is not None:
                self.keys.add(key)

    def _key(self, value):
        if value is None:
            return None
        return exact_number(value) if self.numeric else str(value)

    def __contains__(self, value):
        key = self._key(value)
        return key is not None and key in self.keys


def value_in_domain(domain, value, index=None):
    """True if ``value`` is allowed by ``domain``. Nulls are not violations.

    ``index`` (a ``CodedValueIndex`` of a coded-value ``domain``) makes the
    test a dictionary lookup; pass it when testing many values.
    """
    if value is None or domain is None:
        return True
    numeric = _domains_is_numeric(domain)
    if domain.get("domain_type") == "Range":
        low, high = domain.get("range") or (None, None)
        lo, hi, number = exact_number(low), exact_number(high), exact_number(value)
        if lo is None or hi is None or number is None:
            return False
        return lo <= number <= hi
    if index is not None:
        return value in index
    return any(_domains_same_value(code, value, numeric) for code in (domain.get("codes") or {}))


def code_description(domain, code):
    """Description of ``code`` or ``None`` if it is not in the domain."""
    numeric = _domains_is_numeric(domain)
    for key, desc in (domain.get("codes") or {}).items():
        if _domains_same_value(key, code, numeric):
            return desc
    return None


def require_code(domain, value, field_name=None):
    """Return the stored code for ``value``, which may be a code or a description.

    Codes are tried first (exact type-aware match), then descriptions
    (case-insensitive). Raises ``ToolError`` listing the accepted values when
    there is no match, or when a description matches more than one code.
    """
    where = " for field '{0}'".format(field_name) if field_name else ""
    name = domain.get("name", "?")
    if domain.get("domain_type") == "Range":
        if value_in_domain(domain, value) and value is not None:
            return value
        raise ToolError(
            "The value '{0}'{1} is outside the range domain '{2}'.".format(value, where, name),
            "Use {0}.".format(accepted_values_text(domain)))
    numeric = _domains_is_numeric(domain)
    codes = domain.get("codes") or {}
    for code in codes:
        if _domains_same_value(code, value, numeric):
            return code
    wanted = str(value).strip().casefold()
    hits = [code for code, desc in codes.items() if str(desc).strip().casefold() == wanted]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        raise ToolError(
            "The description '{0}'{1} matches several codes in domain '{2}': {3}.".format(
                value, where, name, ", ".join(str(h) for h in hits)),
            "Give the code itself instead of the description.")
    raise ToolError(
        "The value '{0}'{1} is not in the coded-value domain '{2}'.".format(value, where, name),
        "Use one of the accepted values: {0}.".format(accepted_values_text(domain)))


# --------------------------------------------------------------------------
# Domains of fields copied to a new output
# --------------------------------------------------------------------------

def domain_fits_field_type(domain, keyword):
    """True when an output-workspace domain (``arcio.read_domains`` entry) can be
    assigned to a field of AddField type ``keyword`` (same field type, or a type
    that is not reported)."""
    field_type = str((domain or {}).get("field_type") or "")
    return not field_type or field_type.casefold() == str(keyword).casefold()


def keep_field_domain(spec, domain_name, out_domains):
    """Carry the field-level domain ``domain_name`` of a copied field to its
    output field spec (for ``arcio.add_fields``), as Copy Features does.

    ``out_domains``: the domains of the output workspace (``arcio.read_domains``
    / ``arcio.read_output_domains``; ``{}`` for a folder). The spec gets
    ``"domain"`` when that workspace has a domain of that name for the spec's
    field type, else ``"lost_domain"`` (see ``lost_domain_warning``). No domain:
    the spec is unchanged. Subtypes and subtype-level domains are not carried.
    Returns ``spec``.
    """
    if domain_name:
        if out_domains is not None and domain_name in out_domains and \
                domain_fits_field_type(out_domains[domain_name], spec["type"]):
            spec["domain"] = domain_name
        else:
            spec["lost_domain"] = domain_name
    return spec


def lost_domain_warning(specs, output):
    """Warning text, or ``None``, naming the copied fields of ``specs``
    (``keep_field_domain``) whose domain the output workspace of ``output`` does
    not have (same rule and wording as the datamgmt tools)."""
    lost = ["{0} ({1})".format(s["name"], s["lost_domain"]) for s in specs
            if s.get("lost_domain")]
    if not lost:
        return None
    return ("The workspace of {0} does not have the domain(s) of these copied fields (or has "
            "one of that name for another field type), so they have no domain there and show "
            "codes instead of descriptions: {1}. Add the domains to the output geodatabase and "
            "assign them (Assign Domain To Field), or write the output to the input's "
            "geodatabase.".format(output, ", ".join(lost)))


# ==========================================================================
# common/paths.py
# ==========================================================================
# Catalog path handling that never relies on the host operating system.
#
# Engineering rule 4: never destroy input. Before any delete or overwrite the
# tool compares normalised catalog paths and refuses if an output equals an
# input. ``os.path.normcase`` does nothing outside Windows, so normalisation is
# done by hand: separators, duplicate separators, trailing separators, ``.`` and
# ``..`` segments, Unicode form and case.

# Path components that end a workspace (everything after them is inside it).
_PATHS_WORKSPACE_EXTS = (".gdb", ".sde", ".gpkg", ".geodatabase", ".mdb")


def normalize_catalog_path(path):
    """Comparison key for a catalog path; not meant to be shown to users.

    ``C:/Data//City.GDB/Roads/`` and ``c:\\data\\city.gdb\\roads`` give the same key.
    """
    if path is None:
        return ""
    text = unicodedata.normalize("NFC", str(path).strip()).replace("/", "\\")
    unc = text.startswith("\\\\")
    parts = []
    for part in text.split("\\"):
        if part in ("", "."):
            continue
        if part == ".." and parts and parts[-1] != "..":
            parts.pop()
            continue
        parts.append(part)
    joined = "\\".join(parts)
    if unc:
        joined = "\\\\" + joined
    return joined.casefold()


# Files that belong to one shapefile / dBASE table in a folder workspace. In a
# folder, ``name``, ``name.shp`` and ``name.dbf`` (and every sidecar) are one
# dataset: Pro writes a table ``folder\name`` as ``name.dbf`` and a feature
# class as ``name.shp`` + ``name.shx`` + ``name.dbf`` + ...
FOLDER_DATASET_EXTS = (".shp", ".dbf", ".shx", ".prj", ".cpg", ".sbn", ".sbx", ".qix", ".fbn",
                       ".fbx", ".ain", ".aih", ".atx", ".ixs", ".mxs", ".xml")


def _paths_folder_stem(name):
    """Base name without shapefile/dBASE extensions (``roads.shp.xml`` -> ``roads``)."""
    text = str(name)
    while True:
        dot = text.rfind(".")
        if dot <= 0 or text[dot:].casefold() not in FOLDER_DATASET_EXTS:
            return text
        text = text[:dot]


def dataset_identity(path):
    """Canonical identity of the dataset a catalog path names (comparison key).

    * Geodatabase (and memory) datasets: ``<workspace>\\<name>``, ignoring case
      and separators; feature datasets are transparent (names are unique in a
      geodatabase), so ``a.gdb\\fds\\roads`` == ``a.gdb\\roads``.
    * Folder workspaces: ``<folder>\\<base name>`` without shapefile/dBASE
      extensions, so ``t``, ``t.dbf``, ``T.DBF``, ``t.shp`` and ``t.shx`` are the
      same dataset (they share one file set, and Pro resolves ``t`` to
      ``t.dbf`` / ``t.shp``). Other files (``t.csv``) keep their extension.
    * GeoPackage: ``x.gpkg\\main.roads`` (the way ArcGIS Pro lists it) and ``x.gpkg\\roads``
      are the same dataset.
    * A workspace path itself is its own identity.
    Returns ``""`` for an empty path.
    """
    if path is None or not str(path).strip():
        return ""
    text = str(path).strip()
    workspace = workspace_of(text)
    key = normalize_catalog_path(text)
    if not workspace or normalize_catalog_path(workspace) == key:
        return key
    name = split_catalog_path(text)[1]
    if is_folder_workspace(workspace):
        name = _paths_folder_stem(name)
    elif normalize_catalog_path(workspace).endswith(".gpkg") and name.casefold().startswith("main."):
        name = name[len("main."):]  # GeoPackage datasets are listed as <file>.gpkg\\main.<name>
    return normalize_catalog_path(workspace + "\\" + name)


def folder_dataset_candidates(path):
    """Paths an output may really occupy: for a folder output without a
    shapefile/dBASE extension, also ``.shp`` and ``.dbf`` (Pro adds one)."""
    text = str(path)
    workspace, name = split_catalog_path(text)
    if workspace and is_folder_workspace(workspace) and _paths_folder_stem(name) == name \
            and "." not in name:
        return [text, text + ".shp", text + ".dbf"]
    return [text]


def same_dataset(a, b):
    """True if two catalog paths name the same dataset (``dataset_identity``)."""
    key_a = dataset_identity(a)
    return bool(key_a) and key_a == dataset_identity(b)


# Run-scoped register of every dataset/file the running tool reads (quality review
# D1/D2: an input that a tool forgot to pass in ``inputs`` was overwritten). While a
# run is active (``arcio.guarded_run`` around ``execute``), ``refuse_if_same`` and the
# report checks compare outputs with these paths too, so a forgotten input can no
# longer be replaced. Outside a run (dialog validation) nothing is registered.
#
# Tables joined to an input layer are registered too, by NAME only: a layer reports
# the catalog path of its own table, never of the tables joined to it, so an
# output or report named like a joined table is refused in any workspace
# (conservative; re-review N1 of LineNetworkRules, first done in carto only).
_PATHS_RUN = {"active": False, "inputs": [], "joined": set()}

# Extensions of file tables a join can read (a qualifier such as ``valves.csv``).
_PATHS_JOIN_FILE_EXTS = ("csv", "txt", "tab", "dbf", "shp", "xls", "xlsx")


def begin_input_register():
    """Start a run: clear and activate the register of read datasets."""
    _PATHS_RUN["active"] = True
    _PATHS_RUN["inputs"] = []
    _PATHS_RUN["joined"] = set()


def end_input_register():
    """End a run: clear and deactivate the register."""
    _PATHS_RUN["active"] = False
    _PATHS_RUN["inputs"] = []
    _PATHS_RUN["joined"] = set()


def joined_table_names(fields):
    """Case-folded names of the tables a layer reads through joins.

    With a join, a layer's fields are qualified ``<table>.<field>`` (an enterprise
    table ``db.owner.table.field``); the table name is the last part before the
    field. The layer's own table is listed too (its fields are qualified as well).
    For a file table (``valves.csv.FIELD``) the file name and its stem are listed
    as well. A layer without qualified field names gives an empty set. ``fields``
    are dicts with a ``"name"`` (``arcio.field_info``) or objects with ``.name``.
    """
    names = set()
    for field in fields or []:
        name = (field.get("name") if isinstance(field, dict) else getattr(field, "name", "")) or ""
        if "." in name:
            qualifier = name.rsplit(".", 1)[0]
            pieces = qualifier.split(".")
            table = pieces[-1].strip()
            if table:
                names.add(table.casefold())
            if len(pieces) > 1 and table.casefold() in _PATHS_JOIN_FILE_EXTS and pieces[-2].strip():
                names.add((pieces[-2].strip() + "." + table).casefold())
                names.add(pieces[-2].strip().casefold())
    return names


def register_joined_tables(names):
    """Record names of tables joined to an input layer (ignored outside a run)."""
    if not _PATHS_RUN["active"]:
        return
    _PATHS_RUN["joined"].update(n.casefold() for n in names or () if n)


def registered_joined_tables():
    """Names registered by ``register_joined_tables`` (empty outside a run)."""
    return set(_PATHS_RUN["joined"]) if _PATHS_RUN["active"] else set()


def _paths_output_base(path):
    """Case-folded output name without a ``.shp`` / ``.dbf`` extension."""
    name = split_catalog_path(path)[1]
    if name.casefold().endswith((".dbf", ".shp")):
        name = name[:-4]
    return name.casefold()


def refuse_joined_table_outputs(outputs, joined):
    """Raise ``ToolError`` if an output has the name of a table read through a join.

    The output==input check compares catalog paths, and a layer reports only the
    path of its own table, not of the tables joined to it. So an output named
    like any table of a joined layer (``joined_table_names``) is refused, whatever
    its workspace (conservative: the joined table's workspace is not known).
    A report file is matched by its file name and by its name without extension.
    """
    if not joined:
        return
    for out in outputs:
        if not out:
            continue
        name = split_catalog_path(out)[1].casefold()
        candidates = set([_paths_output_base(out), name])
        if "." in name:
            candidates.add(name.rsplit(".", 1)[0])
        hit = sorted(candidates & set(joined))
        if hit:
            raise ToolError(
                "The output '{0}' has the name of a table that an input layer reads through "
                "a join ({1}); it could replace that table.".format(out, hit[0]),
                "Choose another output name, or remove the join from the layer.")


def register_inputs(paths):
    """Record datasets/files the running tool reads (ignored outside a run)."""
    if not _PATHS_RUN["active"]:
        return
    for path in paths or ():
        if path and str(path).strip() and path not in _PATHS_RUN["inputs"]:
            _PATHS_RUN["inputs"].append(path)


def registered_inputs():
    """Datasets/files registered by the running tool (empty outside a run)."""
    return list(_PATHS_RUN["inputs"]) if _PATHS_RUN["active"] else []


def refuse_if_same(outputs, inputs):
    """Raise ``ToolError`` if any output path equals any input path.

    ``None`` and empty entries are ignored. Inputs must already be resolved to
    catalog paths (a layer name is not a path; see ``arcio.describe_dataset``).
    During a guarded run every registered input (``registered_inputs``) is
    compared as well, whether or not the caller listed it, and an output named
    like a registered joined table (``registered_joined_tables``) is refused.
    """
    inputs = list(inputs or ()) + registered_inputs()
    refuse_joined_table_outputs(outputs, registered_joined_tables())
    for out in outputs:
        if not out:
            continue
        for inp in inputs:
            if inp and same_dataset(out, inp):
                raise ToolError(
                    "The output '{0}' is the same dataset as the input '{1}'.".format(out, inp),
                    "Choose a different output name or location; this tool never overwrites its input.")


def split_catalog_path(path):
    """Split into ``(parent, name)`` on the last ``\\`` or ``/``."""
    text = str(path).rstrip("\\/")
    cut = max(text.rfind("\\"), text.rfind("/"))
    if cut < 0:
        return "", text
    return text[:cut], text[cut + 1:]


def workspace_of(catalog_path):
    """Workspace that contains a dataset.

    The workspace is the path up to the last component ending in ``.gdb``,
    ``.sde``, ``.gpkg``, ``.geodatabase`` or ``.mdb`` (so a feature class
    inside a feature dataset still maps to its geodatabase); ``memory`` and
    ``in_memory`` are workspaces too. Otherwise (shapefiles, dBASE tables) it
    is the parent folder. The original spelling is kept.
    """
    text = str(catalog_path).rstrip("\\/")
    pieces = text.replace("/", "\\").split("\\")
    for i in range(len(pieces) - 1, -1, -1):
        low = pieces[i].casefold()
        if low.endswith(_PATHS_WORKSPACE_EXTS) or (i == 0 and low in ("memory", "in_memory")):
            if i == len(pieces) - 1:
                return text  # the path is itself a workspace
            return _paths_rejoin(text, i + 1)
    return split_catalog_path(text)[0]


def _paths_rejoin(text, count):
    """First ``count`` components of ``text`` with its original separators."""
    seen = 0
    for pos, ch in enumerate(text):
        if ch in "\\/":
            seen += 1
            if seen == count:
                return text[:pos]
    return text


def is_folder_workspace(workspace):
    """True if the workspace is a plain folder (shapefiles, dBASE).

    A container inside a geodatabase is not a folder: a feature dataset
    (``C:\\QA\\city.gdb\\Checks``, the parent ``split_catalog_path`` gives for an
    output in it) follows the rules of its geodatabase, so any component
    ending in ``.gdb``, ``.sde``, ``.gpkg``, ``.geodatabase`` or ``.mdb`` (or a
    leading ``memory`` / ``in_memory``) makes this False (RT7-Q-2).
    """
    pieces = str(workspace).rstrip("\\/").replace("/", "\\").split("\\")
    for i, piece in enumerate(pieces):
        low = piece.casefold()
        if low.endswith(_PATHS_WORKSPACE_EXTS) or (i == 0 and low in ("memory", "in_memory")):
            return False
    return True


def find_duplicate_outputs(outputs):
    """First pair ``(a, b)`` of outputs that name the same dataset, else ``None``.

    ``None`` and empty entries are ignored. Use it in ``updateMessages`` and
    at the start of ``execute`` so one output can never silently replace
    another output of the same run.
    """
    seen = {}
    for out in outputs:
        if not out:
            continue
        key = dataset_identity(out)
        if key in seen:
            return seen[key], out
        seen[key] = out
    return None


def refuse_duplicate_outputs(outputs):
    """Raise ``ToolError`` if two outputs are the same dataset."""
    pair = find_duplicate_outputs(outputs)
    if pair:
        raise ToolError(
            "Two outputs are the same dataset: '{0}' and '{1}'.".format(pair[0], pair[1]),
            "Give every output its own name.")


# ==========================================================================
# common/projection.py
# ==========================================================================
# Choose a projected, metric coordinate system for measuring.
#
# Engineering rule 3: lengths, areas and distances are measured in a projected
# metric system chosen from the data extent; degrees are never treated as
# metres. This module is pure: it decides *which* system to use. ``arcio``
# creates the ``arcpy.SpatialReference`` and projects at read time.
#
# Decision rules
# --------------
# 1. Input projected and **not** in the Web Mercator family -> keep it, convert
#    with its ``metersPerUnit``. (Web Mercator distorts distances: about x1.15 at
#    30 degrees latitude and x2 at 60.)
# 2. Otherwise use the UTM zone of the data centre: EPSG 326zz (north) or
#    327zz (south) on WGS 84. A geographic input on another datum (NAD27, ED50,
#    Ain el Abd 1970, ...) uses the EPSG UTM system of its OWN datum when one
#    exists for that zone (``DATUM_UTM_SERIES``, e.g. 4204 zone 38N -> 20438),
#    so no datum transformation is needed. Otherwise the WGS 84 zone is used
#    and a warning says that no datum transformation is applied (the result
#    may be offset by the datum shift) and how to avoid it. The centre longitude is the middle of the *smallest*
#    longitude arc that holds all sample longitudes, so data that crosses the
#    antimeridian (e.g. Fiji, 177E..178W) gets zone 60/1 and not zone 31.
#    A warning is issued if the data spans more than 3 UTM zones.
# 3. Polar data (centre latitude above 84N or below 80S, the UTM limits) uses
#    EPSG 3995 (WGS 84 / Arctic Polar Stereographic) or EPSG 3031
#    (WGS 84 / Antarctic Polar Stereographic), with the same datum warning for
#    an input that is not on WGS 84. The decision is marked ``"polar": True``:
#    both systems have their true scale at 71 degrees, so between 80 and 90
#    degrees they measure lengths 2-2.7 % and areas 4-5.4 % short.
#    ``choose_measuring`` (given ``geographic_sr``) therefore measures polar
#    data, and input already in a polar stereographic system (any one: recognised
#    from where the system puts probe points round the pole, ``polar_probe_points``
#    / ``is_polar_stereographic_probe``; ``arcio.sr_info`` adds the result as
#    ``"polar_stereographic"``), feature by feature (``local_tm_rows``: each polar
#    feature on its own polar stereographic projection with true scale at the
#    feature).
# Norway/Svalbard UTM zone exceptions are not applied (standard 6-degree zones).

WEB_MERCATOR_WKIDS = frozenset([3857, 102100, 102113, 3395, 54004, 900913])
ARCTIC_POLAR_WKID = 3995
ANTARCTIC_POLAR_WKID = 3031
# Common polar stereographic systems on WGS 84: EPSG 3995 / 3031, 3413 / 3976 (NSIDC) and
# UPS 32661 / 32761 / 5041 / 5042. Used only to tell their datum from the WKID
# (``gcs_wkid_of``). Whether an input IS polar stereographic is not taken from a WKID
# list (RT8-C-3): see ``is_polar_stereographic_probe``.
POLAR_STEREO_WKIDS = frozenset([3995, 3031, 3413, 3976, 32661, 32761, 5041, 5042])

# Probe of a projected system (RT8-C-3): the points ``polar_probe_points(sign)`` (WGS 84
# degrees, 4 meridians 90 degrees apart on 3 latitudes near one pole) are projected into
# the system (``arcio.sr_info``). A polar stereographic projection about that pole (any
# variant, any true-scale latitude, false origin, axis orientation, unit or ellipsoid of
# about the size of the Earth) puts each latitude on a circle round one centre, the
# meridians 90 degrees apart, and the radii in the ratio of the stereographic formula.
# Polar azimuthal equal-area or equidistant systems differ by 0.25-0.4 % in those ratios.
POLAR_PROBE_LATS = (80.0, 85.0, 89.0)
POLAR_PROBE_LONS = (0.0, 90.0, 180.0, -90.0)
POLAR_PROBE_TOLERANCE = 1e-3
MAX_UTM_ZONES_WITHOUT_WARNING = 3
WGS84_GCS_WKID = 4326

# UTM systems on datums other than WGS 84 (EPSG, not deprecated, standard 6-degree
# zones in metres; GDA94/GDA2020 MGA zones are UTM on that datum). Each row:
# (geographic WKID, hemisphere, first zone, last zone, WKID of the first zone); the
# WKIDs of a row are consecutive. Checked against the EPSG database (pyproj) in the
# tests. Unlisted datums fall back to WGS 84 UTM with a warning.
DATUM_UTM_SERIES = (
    (4131, "N", 48, 49, 3148),  # Indian 1960
    (4146, "N", 42, 47, 24342),  # Kalianpur 1975
    (4152, "N", 4, 5, 3750),  # NAD83(HARN)
    (4152, "N", 10, 19, 3740),  # NAD83(HARN)
    (4152, "S", 2, 2, 2195),  # NAD83(HARN)
    (4154, "N", 38, 41, 2058),  # ED50(ED77)
    (4159, "N", 32, 35, 2077),  # ELD79
    (4170, "N", 17, 22, 31986),  # SIRGAS 1995
    (4170, "S", 17, 25, 31992),  # SIRGAS 1995
    (4189, "N", 18, 20, 2201),  # REGVEN
    (4201, "N", 35, 38, 20135),  # Adindan
    (4204, "N", 36, 40, 20436),  # Ain el Abd
    (4205, "N", 38, 39, 20538),  # Afgooye
    (4209, "S", 34, 36, 20934),  # Arc 1950
    (4210, "N", 35, 37, 21095),  # Arc 1960
    (4210, "S", 35, 37, 21035),  # Arc 1960
    (4211, "S", 48, 50, 21148),  # Batavia
    (4218, "N", 18, 18, 21818),  # Bogota 1975
    (4222, "S", 34, 35, 22234),  # Cape
    (4223, "N", 32, 32, 22332),  # Carthage
    (4225, "S", 21, 25, 22521),  # Corrego Alegre 1970-72
    (4230, "N", 28, 38, 23028),  # ED50
    (4232, "N", 39, 40, 23239),  # Fahud
    (4238, "N", 46, 52, 23846),  # ID74
    (4238, "S", 47, 54, 23887),  # ID74
    (4239, "N", 46, 48, 23946),  # Indian 1954
    (4240, "N", 47, 48, 24047),  # Indian 1975
    (4245, "N", 47, 48, 24547),  # Kertau 1968
    (4247, "N", 18, 20, 24718),  # La Canoa
    (4248, "N", 17, 21, 24817),  # PSAD56
    (4248, "S", 17, 22, 24877),  # PSAD56
    (4258, "N", 28, 37, 25828),  # ETRS89
    (4263, "N", 31, 32, 26331),  # Minna
    (4267, "N", 1, 22, 26701),  # NAD27
    (4267, "N", 59, 60, 3370),  # NAD27
    (4269, "N", 1, 23, 26901),  # NAD83
    (4269, "N", 24, 24, 9712),  # NAD83
    (4269, "N", 59, 60, 3372),  # NAD83
    (4270, "N", 39, 40, 27039),  # Nahrwan 1967
    (4283, "S", 46, 47, 6736),  # GDA94
    (4283, "S", 48, 58, 28348),  # GDA94
    (4283, "S", 59, 59, 6738),  # GDA94
    (4301, "N", 51, 55, 3092),  # Tokyo
    (4307, "N", 29, 32, 30729),  # Nord Sahara 1959
    (4318, "N", 38, 39, 31838),  # NGN
    (4322, "N", 1, 60, 32201),  # WGS 72
    (4322, "S", 1, 60, 32301),  # WGS 72
    (4612, "N", 51, 55, 3097),  # JGD2000
    (4617, "N", 7, 10, 3154),  # NAD83(CSRS)
    (4617, "N", 11, 13, 2955),  # NAD83(CSRS)
    (4617, "N", 14, 16, 3158),  # NAD83(CSRS)
    (4617, "N", 17, 21, 2958),  # NAD83(CSRS)
    (4617, "N", 22, 22, 3761),  # NAD83(CSRS)
    (4617, "N", 23, 23, 9709),  # NAD83(CSRS)
    (4617, "N", 24, 24, 9713),  # NAD83(CSRS)
    (4618, "N", 17, 17, 5463),  # SAD69
    (4618, "N", 18, 22, 29168),  # SAD69
    (4618, "S", 17, 25, 29187),  # SAD69
    (4674, "N", 11, 22, 31965),  # SIRGAS 2000
    (4674, "N", 23, 24, 6210),  # SIRGAS 2000
    (4674, "S", 17, 25, 31977),  # SIRGAS 2000
    (4674, "S", 26, 26, 5396),  # SIRGAS 2000
    (4743, "N", 37, 39, 3391),  # Karbala 1979
    (4744, "N", 37, 39, 7005),  # Nahrwan 1934
    (4755, "N", 46, 52, 23866),  # DGN95
    (4755, "S", 47, 54, 23877),  # DGN95
    (4756, "N", 48, 49, 3405),  # VN-2000
    (4759, "N", 1, 19, 3708),  # NAD83(NSRS2007)
    (4759, "N", 59, 60, 3706),  # NAD83(NSRS2007)
    (6318, "N", 1, 19, 6330),  # NAD83(2011)
    (6318, "N", 59, 60, 6328),  # NAD83(2011)
    (6668, "N", 51, 55, 6688),  # JGD2011
    (7844, "S", 46, 59, 7846),  # GDA2020
)


def utm_zone(lon):
    """Standard 6-degree UTM zone number (1..60) of a longitude in degrees."""
    lon = _projection_wrap(lon)
    zone = int(math.floor((lon + 180.0) / 6.0)) + 1
    return min(max(zone, 1), 60)


def utm_wkid(lon, lat):
    """EPSG code of the WGS 84 UTM zone for a point."""
    return (32600 if lat >= 0 else 32700) + utm_zone(lon)


def _projection_wrap(lon):
    """Longitude in [-180, 180)."""
    return ((float(lon) + 180.0) % 360.0) - 180.0


def longitude_span(longitudes):
    """Smallest arc holding all longitudes: ``(west, east, centre, width)``.

    ``west``/``east``/``centre`` are wrapped to [-180, 180); ``width`` is in
    degrees (0..360). Works across the antimeridian: the arc is the complement
    of the largest gap between sorted longitudes.
    """
    lons = sorted(set(_projection_wrap(x) for x in longitudes))
    if not lons:
        raise ValueError("no longitudes")
    if len(lons) == 1:
        return lons[0], lons[0], lons[0], 0.0
    best_gap, best_i = -1.0, 0
    for i in range(len(lons)):
        nxt = lons[(i + 1) % len(lons)] + (360.0 if i == len(lons) - 1 else 0.0)
        gap = nxt - lons[i]
        if gap > best_gap:
            best_gap, best_i = gap, i
    west = lons[(best_i + 1) % len(lons)]
    east = lons[best_i]
    width = 360.0 - best_gap
    centre = _projection_wrap(west + width / 2.0)
    return west, east, centre, width


def count_utm_zones(west, width):
    """Number of UTM zones touched by an arc starting at ``west``."""
    if width >= 360.0:
        return 60
    first = int(math.floor((_projection_wrap(west) + 180.0) / 6.0))
    last = int(math.floor((_projection_wrap(west) + 180.0 + width) / 6.0))
    return min(last - first + 1, 60)


def is_web_mercator(wkid):
    return wkid is not None and int(wkid) in WEB_MERCATOR_WKIDS


# Equatorial circumference of the Web Mercator family (sphere or ellipsoid with
# a = 6378137 m): the x period of 3857/102100/102113/900913 (+-20,037,508.34 m)
# and of World Mercator 3395/54004.
WEB_MERCATOR_PERIOD_M = 2.0 * math.pi * 6378137.0


def x_period(sr_info):
    """Period of the x coordinate of a coordinate system, or ``None``: 360 for a
    geographic system (longitudes), the equatorial circumference (in the
    system's units) for the Web Mercator family, else ``None``. Coordinates
    ``x`` and ``x +- period`` are then the same place (antimeridian)."""
    sr_info = sr_info or {}
    if str(sr_info.get("type") or "") == "Geographic":
        return 360.0
    if is_web_mercator(sr_info.get("wkid")):
        return WEB_MERCATOR_PERIOD_M / float(sr_info.get("meters_per_unit") or 1.0)
    return None


def datum_utm_wkid(gcs_wkid, lon, lat):
    """WKID of the UTM zone of ``(lon, lat)`` on the datum of geographic system
    ``gcs_wkid``, or ``None`` when that datum has no EPSG UTM system there."""
    if not gcs_wkid:
        return None
    gcs_wkid = int(gcs_wkid)
    if gcs_wkid == WGS84_GCS_WKID:
        return utm_wkid(lon, lat)
    zone, hemi = utm_zone(lon), ("N" if lat >= 0 else "S")
    for gcs, h, first, last, code in DATUM_UTM_SERIES:
        if gcs == gcs_wkid and h == hemi and first <= zone <= last:
            return code + zone - first
    return None


def gcs_wkid_of(sr_info):
    """WKID of the geographic system (datum) under ``sr_info``, or ``None`` when it
    cannot be told from the WKID alone (custom or unlisted projected systems)."""
    sr_info = sr_info or {}
    wkid = sr_info.get("wkid")
    if not wkid:
        return None
    wkid = int(wkid)
    if str(sr_info.get("type") or "") == "Geographic":
        return wkid
    if is_web_mercator(wkid) or wkid in POLAR_STEREO_WKIDS \
            or 32601 <= wkid <= 32660 or 32701 <= wkid <= 32760:
        return WGS84_GCS_WKID
    for gcs, _h, first, last, code in DATUM_UTM_SERIES:
        if code <= wkid <= code + last - first:
            return gcs
    return None


def datum_mismatch_warning(label, other_info, decision):
    """Warning text when a further input (``label``) is on another datum than the
    measuring system of ``decision``: it is projected without a datum
    transformation. ``None`` when the datums match or cannot be told."""
    if not decision:
        return None
    target = decision.get("gcs_wkid")
    other = gcs_wkid_of(other_info)
    if target is None or other is None or target == other:
        return None
    return ("{0} ({1}) is on another datum than the measuring coordinate system (WKID {2}); "
            "it is projected to it without a datum transformation, so it may be offset "
            "from the other input by the datum shift (about 1 m between modern datums, up to "
            "several hundred metres for older ones). Project both inputs to the same projected "
            "metric coordinate system first (Project tool, with the right geographic "
            "transformation).".format(label, (other_info or {}).get("name") or other,
                                      decision.get("wkid")))


def sr_is_unknown(sr_info):
    """True for a dataset without a coordinate system (e.g. a shapefile with no
    .prj): type neither Projected nor Geographic and no WKID."""
    sr_info = sr_info or {}
    return (str(sr_info.get("type") or "") not in ("Projected", "Geographic")
            and not sr_info.get("wkid"))


def further_input_sr_check(label, other_info, decision, main_name=None):
    """Check the coordinate system of a further input (``label``) against the
    measuring ``decision`` of the main input.

    A cursor cannot project data whose system is unknown (audit gotcha 3), so
    its coordinates stay as they are. When the main input is projected for
    measuring, they would be compared with it in other units: ``ToolError``.
    When the main input is used in its own system, the further input is
    assumed to be in that system: returns a warning. ``None`` when the further
    input's system is known.
    """
    if not sr_is_unknown(other_info):
        return None
    fix = ("Define the coordinate system of {0} (Define Projection tool) and run the tool "
           "again.".format(label))
    if decision and decision.get("reproject"):
        raise ToolError(
            "{0} has an unknown coordinate system, so it cannot be projected to the measuring "
            "coordinate system (WKID {1}); its coordinates would be compared with the input "
            "in other units.".format(label, decision.get("wkid")), fix)
    return ("{0} has an unknown coordinate system; its coordinates are used as if they were "
            "in the coordinate system of the input ({1}). If they are not, {2}".format(
                label, main_name or "unknown", fix[0].lower() + fix[1:]))


def _projection_datum_warning(name, target_text):
    return ("The input coordinate system ({0}) is not on the WGS 84 datum and has no UTM "
            "system on its own datum for this area, so it is projected to {1} WITHOUT a datum "
            "transformation. Positions may be offset by the datum shift: about 1 m for modern "
            "datums (NAD83, ETRS89, GDA94), up to several hundred metres for older ones "
            "(NAD27, ED50, Ain el Abd 1970, Pulkovo 1942). For exact positions project the "
            "input to a projected metric coordinate system first (Project tool, with the right "
            "geographic transformation).".format(name, target_text))


def choose_metric_sr(sr_info, lonlat_samples=None):
    """Decide the measuring coordinate system.

    ``sr_info`` describes the input system: ``{"wkid": int or None,
    "type": "Projected" | "Geographic" | ..., "meters_per_unit": float or None,
    "name": str}``. ``lonlat_samples`` is an iterable of ``(lon, lat)`` in
    degrees (WGS 84) and is only needed when the input is not usable as is.

    Returns ``{"wkid", "meters_per_unit", "reproject", "gcs_wkid", "reason",
    "warnings"}`` (``gcs_wkid``: the datum of the measuring system, ``None`` if
    unknown), plus ``"utm_zones"`` (number of UTM zones the data spans) when a
    UTM zone is chosen and ``"datum_warnings"`` (the subset of ``warnings``
    about projecting without a datum transformation) when a new system is
    chosen. That warning only matters to a tool that compares positions with
    other data or writes measured positions in another system; a tool that
    writes its results back through the same projection may show it as
    information instead (``choose_measuring(..., datum_as_info=True)``);
    ``reproject`` is False when the input system is kept. An unknown system
    (type neither Projected nor Geographic and no WKID) is kept as is with a
    warning: it cannot be projected.
    Raises ``ToolError`` when a new system is needed but there are no samples.
    """
    sr_info = sr_info or {}
    wkid = sr_info.get("wkid")
    sr_type = str(sr_info.get("type") or "")
    mpu = sr_info.get("meters_per_unit")
    name = sr_info.get("name") or ("WKID {0}".format(wkid) if wkid else "unknown")

    if sr_type not in ("Projected", "Geographic") and not wkid:
        # Unknown coordinate system: a cursor cannot project it (coordinates stay as
        # they are, audit gotcha 3), so measuring "in UTM" would be a false claim.
        return {"wkid": None, "meters_per_unit": 1.0, "reproject": False, "gcs_wkid": None,
                "reason": "The input coordinate system is unknown; coordinates are used as "
                          "they are.",
                "warnings": ["The coordinate system of the input is unknown, so lengths, areas "
                             "and distances are in the data's own units and are reported as if "
                             "they were metres. Define the projection of the input (Define "
                             "Projection tool) for correct values."]}
    if sr_type == "Projected" and not is_web_mercator(wkid) and mpu:
        return {"wkid": wkid, "meters_per_unit": float(mpu), "reproject": False,
                "gcs_wkid": gcs_wkid_of(sr_info),
                "reason": "The input is already projected ({0}); it is used as is.".format(name),
                "warnings": []}

    samples = [(float(x), float(y)) for (x, y) in (lonlat_samples or [])
               if x is not None and y is not None
               and math.isfinite(float(x)) and math.isfinite(float(y))]
    if not samples:
        raise ToolError(
            "Cannot choose a metric coordinate system: the input has no usable coordinates.",
            "Check that the input contains features with geometry.")

    lats = [lat for (_lon, lat) in samples]
    centre_lat = (min(lats) + max(lats)) / 2.0
    why_not = ("is in the Web Mercator family, which distorts distances"
               if is_web_mercator(wkid) else "is not a projected system")
    warnings = []
    source_gcs = gcs_wkid_of(sr_info)
    foreign = source_gcs != WGS84_GCS_WKID      # None (custom datum) counts as foreign
    if centre_lat > 84.0 or centre_lat < -80.0:
        north = centre_lat > 84.0
        target = ARCTIC_POLAR_WKID if north else ANTARCTIC_POLAR_WKID
        label = "WGS 84 / {0} Polar Stereographic (EPSG {1})".format(
            "Arctic" if north else "Antarctic", target)
        if foreign:
            warnings.append(_projection_datum_warning(name, label))
        return {"wkid": target, "meters_per_unit": 1.0, "reproject": True, "polar": True,
                "gcs_wkid": WGS84_GCS_WKID, "datum_warnings": list(warnings),
                "reason": "The input ({0}) {1}; polar data {2} is measured in {3}.".format(
                    name, why_not, "north of 84N" if north else "south of 80S", label),
                "warnings": warnings}

    west, _east, centre_lon, width = longitude_span(lon for (lon, _lat) in samples)
    zones = count_utm_zones(west, width)
    target = utm_wkid(centre_lon, centre_lat)
    hemi = "N" if centre_lat >= 0 else "S"
    zone_text = "UTM zone {0}{1}".format(utm_zone(centre_lon), hemi)
    target_gcs = WGS84_GCS_WKID
    target_text = "WGS 84 / {0}".format(zone_text)
    if foreign:
        own = datum_utm_wkid(source_gcs, centre_lon, centre_lat)
        if own is not None:
            target, target_gcs = own, source_gcs
            target_text = "{0} on the input's own datum, so no datum transformation is " \
                          "needed".format(zone_text)
        else:
            warnings.append(_projection_datum_warning(
                name, "WGS 84 / {0} (EPSG {1})".format(zone_text, target)))
    datum_warnings = list(warnings)
    if zones > MAX_UTM_ZONES_WITHOUT_WARNING:
        warnings.append(
            "The data spans {0} UTM zones ({1:.1f} degrees of longitude); distances far from "
            "the centre zone are less accurate. Project the data to a suitable "
            "equidistant or equal-area system first for best results.".format(zones, width))
    return {"wkid": target, "meters_per_unit": 1.0, "reproject": True, "gcs_wkid": target_gcs,
            "reason": "The input ({0}) {1}; measuring in {2} (EPSG {3}).".format(
                name, why_not, target_text, target),
            "warnings": warnings, "utm_zones": zones, "datum_warnings": datum_warnings}


# --------------------------------------------------------------------------
# Per-feature local Transverse Mercator (wide geographic data)
# --------------------------------------------------------------------------
# One UTM zone cannot measure data that spans many zones: Transverse Mercator
# scale error grows with the square of the distance from the central meridian
# (about +0.1 % in area at 3 degrees, +40 % at 40 degrees on the equator, and
# far worse beyond). For such data each feature is projected on its own
# Transverse Mercator with the central meridian at the feature's centre and
# scale factor 1 (true scale on that meridian), in pure Python. The formulas
# are Krueger's series to order n**6 (C. F. F. Karney, "Transverse Mercator
# with an accuracy of a few nanometers", J. Geodesy 85, 2011, eqs. 6-11 and
# 35-36); within 3900 km of the central meridian they agree with an exact
# projection to well below a millimetre (checked against PROJ in the tests).
# The WGS 84 ellipsoid is used for every geographic system: other ellipsoids
# differ by less than 0.01 %, far below what a map-scale check can see.

TM_WGS84_A = 6378137.0
TM_WGS84_F = 1.0 / 298.257223563
# A feature reaching farther than this from its own central meridian (metres on
# its local Transverse Mercator) is measured with more than about 1 % area error
# even on that projection (warning). The scale error grows with the distance
# from the central meridian (k - 1 ~ x**2 / 2R**2), not with the longitude
# difference, which shrinks with cos(latitude): 9 degrees of longitude on the
# equator (a feature 18 degrees wide) is about 1,000 km, at 79 N only 190 km.
TM_MAX_FEATURE_OFFSET_M = TM_WGS84_A * math.pi / 20.0


def _projection_tm_constants(a=TM_WGS84_A, f=TM_WGS84_F):
    n = f / (2.0 - f)
    n2, n3 = n * n, n * n * n
    n4, n5, n6 = n2 * n2, n2 * n3, n3 * n3
    big_a = a / (1.0 + n) * (1.0 + n2 / 4.0 + n4 / 64.0 + n6 / 256.0)
    alpha = (
        n / 2.0 - 2.0 * n2 / 3.0 + 5.0 * n3 / 16.0 + 41.0 * n4 / 180.0 - 127.0 * n5 / 288.0
        + 7891.0 * n6 / 37800.0,
        13.0 * n2 / 48.0 - 3.0 * n3 / 5.0 + 557.0 * n4 / 1440.0 + 281.0 * n5 / 630.0
        - 1983433.0 * n6 / 1935360.0,
        61.0 * n3 / 240.0 - 103.0 * n4 / 140.0 + 15061.0 * n5 / 26880.0
        + 167603.0 * n6 / 181440.0,
        49561.0 * n4 / 161280.0 - 179.0 * n5 / 168.0 + 6601661.0 * n6 / 7257600.0,
        34729.0 * n5 / 80640.0 - 3418889.0 * n6 / 1995840.0,
        212378941.0 * n6 / 319334400.0)
    beta = (
        n / 2.0 - 2.0 * n2 / 3.0 + 37.0 * n3 / 96.0 - n4 / 360.0 - 81.0 * n5 / 512.0
        + 96199.0 * n6 / 604800.0,
        n2 / 48.0 + n3 / 15.0 - 437.0 * n4 / 1440.0 + 46.0 * n5 / 105.0
        - 1118711.0 * n6 / 3870720.0,
        17.0 * n3 / 480.0 - 37.0 * n4 / 840.0 - 209.0 * n5 / 4480.0 + 5569.0 * n6 / 90720.0,
        4397.0 * n4 / 161280.0 - 11.0 * n5 / 504.0 - 830251.0 * n6 / 7257600.0,
        4583.0 * n5 / 161280.0 - 108847.0 * n6 / 3991680.0,
        20648693.0 * n6 / 638668800.0)
    e = math.sqrt(f * (2.0 - f))
    return {"A": big_a, "alpha": alpha, "beta": beta, "e": e}


_PROJECTION_TM = _projection_tm_constants()


def tm_forward(lon, lat, lon0):
    """Transverse Mercator ``(x, y)`` in metres of ``(lon, lat)`` (degrees) on the
    WGS 84 ellipsoid, central meridian ``lon0``, scale factor 1, origin at the
    equator. Longitudes more than about 89 degrees from ``lon0`` are clamped
    (Transverse Mercator is not defined at 90 degrees on the equator)."""
    c = _PROJECTION_TM
    e = c["e"]
    lam = math.radians(_projection_wrap(float(lon) - float(lon0)))
    lam = max(min(lam, math.radians(89.999)), -math.radians(89.999))
    phi = math.radians(max(min(float(lat), 90.0), -90.0))
    sin_phi = math.sin(phi)
    if abs(sin_phi) >= 1.0:
        tau_c = math.copysign(1e300, sin_phi)
        xi_p, eta_p = math.copysign(math.pi / 2.0, sin_phi), 0.0
    else:
        tau_c = math.sinh(math.atanh(sin_phi) - e * math.atanh(e * sin_phi))
        xi_p = math.atan2(tau_c, math.cos(lam))
        eta_p = math.asinh(math.sin(lam) / math.hypot(tau_c, math.cos(lam)))
    xi, eta = xi_p, eta_p
    for j, a_j in enumerate(c["alpha"], 1):
        xi += a_j * math.sin(2 * j * xi_p) * math.cosh(2 * j * eta_p)
        eta += a_j * math.cos(2 * j * xi_p) * math.sinh(2 * j * eta_p)
    return c["A"] * eta, c["A"] * xi


def _projection_lat_from_conformal(tau_p):
    """Geodetic tan(latitude) from conformal tan(latitude) (Newton, Karney eq. 19-21)."""
    e = _PROJECTION_TM["e"]
    e2m = 1.0 - e * e
    tau = tau_p / e2m
    for _ in range(8):
        sigma = math.sinh(e * math.atanh(e * tau / math.sqrt(1.0 + tau * tau)))
        tau_pi = tau * math.sqrt(1.0 + sigma * sigma) - sigma * math.sqrt(1.0 + tau * tau)
        step = (tau_p - tau_pi) * (1.0 + e2m * tau * tau) / (
            e2m * math.sqrt(1.0 + tau_pi * tau_pi) * math.sqrt(1.0 + tau * tau))
        tau += step
        if abs(step) < 1e-14 * max(1.0, abs(tau)):
            break
    return tau


def tm_inverse(x, y, lon0):
    """Inverse of ``tm_forward``: ``(lon, lat)`` in degrees, ``lon`` near ``lon0``
    (``lon0`` plus an offset in -90..90, not wrapped)."""
    c = _PROJECTION_TM
    xi, eta = float(y) / c["A"], float(x) / c["A"]
    xi_p, eta_p = xi, eta
    for j, b_j in enumerate(c["beta"], 1):
        xi_p -= b_j * math.sin(2 * j * xi) * math.cosh(2 * j * eta)
        eta_p -= b_j * math.cos(2 * j * xi) * math.sinh(2 * j * eta)
    lam = math.atan2(math.sinh(eta_p), math.cos(xi_p))
    tau_p = math.sin(xi_p) / math.hypot(math.sinh(eta_p), math.cos(xi_p))
    tau = _projection_lat_from_conformal(tau_p)
    return float(lon0) + math.degrees(lam), math.degrees(math.atan(tau))


# Per-feature polar stereographic (features near a pole). Ellipsoidal formulas of
# J. P. Snyder, "Map Projections - A Working Manual" (USGS PP 1395, 1987), eqs. 15-9,
# 21-33 to 21-40, with scale 1 at the pole; ``local_tm_rows`` then divides the
# coordinates by the scale at the feature, so the feature is at true scale.
_PS_E = _PROJECTION_TM["e"]
_PS_C = math.sqrt((1.0 + _PS_E) ** (1.0 + _PS_E) * (1.0 - _PS_E) ** (1.0 - _PS_E))


def _projection_ps_rho(lat_toward_pole):
    """Distance from the pole (metres, scale 1 at the pole) of latitude ``lat``
    (degrees, positive toward the projection's pole)."""
    phi = math.radians(max(min(float(lat_toward_pole), 90.0), -89.999))
    s = math.sin(phi)
    t = math.tan(math.pi / 4.0 - phi / 2.0) / ((1.0 - _PS_E * s) / (1.0 + _PS_E * s)) ** (
        _PS_E / 2.0)
    return 2.0 * TM_WGS84_A * t / _PS_C


def _projection_ps_lat(rho):
    """Inverse of ``_projection_ps_rho``: latitude in degrees (toward the pole)."""
    t = float(rho) * _PS_C / (2.0 * TM_WGS84_A)
    phi = math.pi / 2.0 - 2.0 * math.atan(t)
    for _ in range(30):
        s = math.sin(phi)
        new = math.pi / 2.0 - 2.0 * math.atan(
            t * ((1.0 - _PS_E * s) / (1.0 + _PS_E * s)) ** (_PS_E / 2.0))
        if abs(new - phi) < 1e-15:
            phi = new
            break
        phi = new
    return math.degrees(phi)


def ps_scale(lat_toward_pole):
    """Linear scale of the polar stereographic (scale 1 at the pole) at a latitude."""
    phi = math.radians(min(abs(float(lat_toward_pole)), 90.0))
    if phi >= math.pi / 2.0 - 1e-12:
        return 1.0
    s = math.sin(phi)
    m = math.cos(phi) / math.sqrt(1.0 - _PS_E * _PS_E * s * s)
    return _projection_ps_rho(math.degrees(phi)) / (TM_WGS84_A * m)


def ps_forward(lon, lat, lon0, sign, k_ref=1.0):
    """Polar stereographic ``(x, y)`` in metres of ``(lon, lat)`` (degrees): pole
    ``sign`` (+1 north, -1 south), meridian ``lon0`` along the y axis with east
    +x and north +y on it (so ring orientation is kept), coordinates divided by
    ``k_ref`` (true scale where the scale equals ``k_ref``)."""
    rho = _projection_ps_rho(sign * float(lat)) / float(k_ref)
    lam = math.radians(_projection_wrap(float(lon) - float(lon0)))
    return rho * math.sin(lam), -sign * rho * math.cos(lam)


def ps_inverse(x, y, lon0, sign, k_ref=1.0):
    """Inverse of ``ps_forward``: ``(lon, lat)`` in degrees, ``lon`` within 180 of ``lon0``."""
    x, y = float(x) * float(k_ref), float(y) * float(k_ref)
    rho = math.hypot(x, y)
    lat = sign * _projection_ps_lat(rho)
    lam = math.atan2(x, -sign * y) if rho > 0.0 else 0.0
    return float(lon0) + math.degrees(lam), lat


def polar_probe_points(sign):
    """``[(lon, lat)]`` (WGS 84 degrees) to project into a system to test whether it is
    polar stereographic about the North (``sign`` 1) or South (-1) Pole: for each
    latitude of ``POLAR_PROBE_LATS``, the 4 longitudes of ``POLAR_PROBE_LONS``."""
    return [(lon, sign * lat) for lat in POLAR_PROBE_LATS for lon in POLAR_PROBE_LONS]


def is_polar_stereographic_probe(projected):
    """True when ``projected`` (the points of ``polar_probe_points`` in the same order,
    as ``(x, y)`` in the system tested; ``None`` or non-finite entries where a point
    could not be projected) is what a polar stereographic projection about that pole
    gives: every latitude on a circle round one common centre (the pole), the
    meridians 90 degrees apart, and the radii of the latitudes in the ratio of the
    stereographic formula (tolerance ``POLAR_PROBE_TOLERANCE``, relative)."""
    n = len(POLAR_PROBE_LONS)
    if projected is None or len(projected) != n * len(POLAR_PROBE_LATS):
        return False
    pts = []
    for p in projected:
        try:
            x, y = float(p[0]), float(p[1])
        except (TypeError, ValueError, IndexError):
            return False
        if not (math.isfinite(x) and math.isfinite(y)):
            return False
        pts.append((x, y))
    groups = [pts[i * n:(i + 1) * n] for i in range(len(POLAR_PROBE_LATS))]
    # Centre: midpoint of the opposite meridians (0 and 180, 90 and -90) of each latitude.
    mids = [((g[a][0] + g[a + 2][0]) / 2.0, (g[a][1] + g[a + 2][1]) / 2.0)
            for g in groups for a in (0, 1)]
    cx = sum(m[0] for m in mids) / len(mids)
    cy = sum(m[1] for m in mids) / len(mids)
    radii = []
    for g in groups:
        rs = [math.hypot(x - cx, y - cy) for x, y in g]
        r = sum(rs) / len(rs)
        if not r > 0.0 or any(abs(v - r) > POLAR_PROBE_TOLERANCE * r for v in rs):
            return False
        # Meridians 0 and 90 at a right angle round the pole.
        (x0, y0), (x1, y1) = g[0], g[1]
        dot = (x0 - cx) * (x1 - cx) + (y0 - cy) * (y1 - cy)
        if abs(dot) > POLAR_PROBE_TOLERANCE * rs[0] * rs[1]:
            return False
        radii.append(r)
    tol = POLAR_PROBE_TOLERANCE * radii[0]
    if any(math.hypot(m[0] - cx, m[1] - cy) > tol for m in mids):
        return False
    rho0 = _projection_ps_rho(POLAR_PROBE_LATS[0])
    for lat, r in zip(POLAR_PROBE_LATS[1:], radii[1:]):
        expected = _projection_ps_rho(lat) / rho0
        if abs((r / radii[0]) / expected - 1.0) > POLAR_PROBE_TOLERANCE:
            return False
    return True


def _projection_polar_sign(lats, width):
    """+1 / -1 when a feature is measured on a polar stereographic projection (all
    of it in one hemisphere and reaching beyond the UTM limits, 84N / 80S, or
    going round the pole above 60 degrees: more than 180 degrees of longitude),
    else 0."""
    if not lats:
        return 0
    if min(lats) >= 0.0 and (max(lats) > 84.0 or (width > 180.0 and min(lats) >= 60.0)):
        return 1
    if max(lats) <= 0.0 and (min(lats) < -80.0 or (width > 180.0 and max(lats) <= -60.0)):
        return -1
    return 0


def _projection_ps_node(node, lon0, sign, k_ref):
    if isinstance(node[0], (int, float)):
        x, y = ps_forward(node[0], node[1], lon0, sign, k_ref)
        return [x, y]
    return [_projection_ps_node(item, lon0, sign, k_ref) for item in node]


def _projection_lats(node, out):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            out.append(float(node[1]))
        else:
            for item in node:
                _projection_lats(item, out)


def local_ps_geometry(geom, lon0, sign):
    """Project a core geometry in degrees on the polar stereographic of pole
    ``sign`` with true scale at the feature: ``(geometry, k_ref, spread)``.

    ``k_ref`` is the geometric mean of the smallest and largest scale (scale 1 at
    the pole) over the vertices and the centre of the feature's extent (the pole
    itself for a feature around it); ``spread`` = largest / smallest scale, so
    the measures are within about ``spread - 1`` (area) of the truth."""
    lats = []
    _projection_lats(geom, lats)
    scales = [ps_scale(sign * lat) for lat in lats]
    raw = _projection_ps_node(geom, lon0, sign, 1.0)
    xs, ys = [], []
    _projection_xy(raw, xs, ys)
    cx, cy = (min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0
    scales.append(ps_scale(_projection_ps_lat(math.hypot(cx, cy))))
    k_min, k_max = min(scales), max(scales)
    k_ref = math.sqrt(k_min * k_max)
    return _projection_ps_node(geom, lon0, sign, k_ref), k_ref, k_max / k_min


def _projection_xy(node, xs, ys):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            xs.append(float(node[0]))
            ys.append(float(node[1]))
        else:
            for item in node:
                _projection_xy(item, xs, ys)


# A polar feature whose scale varies by more than this factor over it (largest /
# smallest, on its own polar stereographic) is measured with more than about 1 %
# area error: warning. 1.01 is reached by a feature from the pole to about 78 degrees.
PS_MAX_FEATURE_SPREAD = 1.01


def _projection_lonlats(node, out):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            out.append(float(node[0]))
        else:
            for item in node:
                _projection_lonlats(item, out)


def _projection_tm_node(node, lon0):
    if isinstance(node[0], (int, float)):
        x, y = tm_forward(node[0], node[1], lon0)
        return [x, y]
    return [_projection_tm_node(item, lon0) for item in node]


def local_tm_geometry(geom):
    """Project a core geometry in geographic degrees (a point ``[lon, lat]`` or
    nested lists of them) to the local Transverse Mercator of its own centre.

    Returns ``(projected geometry, lon0, width)``: ``lon0`` is the centre of the
    smallest longitude arc holding all vertices (works across the
    antimeridian), ``width`` that arc in degrees. ``(None, None, 0.0)`` for an
    empty geometry.
    """
    lons = []
    if geom:
        _projection_lonlats(geom, lons)
    if not lons:
        return None, None, 0.0
    _west, _east, lon0, width = longitude_span(lons)
    return _projection_tm_node(geom, lon0), lon0, width


def local_tm_point_to_lonlat(point, lon0, near_lon=None):
    """``[lon, lat]`` of a point ``(x, y)`` of ``local_tm_geometry``; the
    longitude is shifted by whole turns to be nearest ``near_lon`` (the
    feature's own longitudes, so data stored in 0..360 stays there)."""
    lon, lat = tm_inverse(point[0], point[1], lon0)
    if near_lon is not None:
        lon += 360.0 * round((float(near_lon) - lon) / 360.0)
    return [lon, lat]


# --------------------------------------------------------------------------
# Measuring plan of a tool (one UTM zone, or per-feature local TM)
# --------------------------------------------------------------------------

def choose_measuring(desc, metric_sr_for, collector, what, geographic_sr=None,
                     datum_as_info=False):
    """How to measure an input: ``{"read_sr", "wkid", "mpu", "local"}``.

    ``metric_sr_for`` is ``arcio.metric_sr_or_native`` (or ``arcio.metric_sr_for``,
    or any function ``desc -> (decision, spatial reference or None)``);
    ``collector`` a ``MessageCollector``. Pure: arcpy is only reached through
    the functions passed in.
    An input with no coordinates at all (empty, empty selection, only null
    geometries) keeps its own system: there is nothing to measure. A projected
    input keeps its own system (other inputs are projected into it by the
    cursor); otherwise a UTM zone is chosen from the data. An unknown system
    gives a warning and native units (``wkid`` ``None``, 1 metre per unit).

    Wide data (``local`` True): when the data needs projecting and spans more
    than ``MAX_UTM_ZONES_WITHOUT_WARNING`` UTM zones, one zone would measure
    features far from it with gross errors (area +100 % at 40 degrees from the
    central meridian). If ``geographic_sr`` (``arcpy.SpatialReference``) is
    given, the input is then read in geographic degrees (its own geographic
    system, or WGS 84 for Web Mercator) and every feature is measured on its
    own local Transverse Mercator (``local_tm_rows``); ``wkid`` is then the
    system of the degrees read, used to write points back.

    ``datum_as_info``: the decision's ``datum_warnings`` are shown as
    information, not warnings (for tools whose results go back through the
    same projection, so a datum shift cannot offset them).
    """
    sr_type = (desc["sr"] or {}).get("type")
    if sr_type not in ("Projected", "Geographic"):
        collector.warning(
            "The {0} has an unknown coordinate system, so it is read in its native "
            "coordinates and its units are taken as metres. Define the coordinate system "
            "(Define Projection) for reliable measurements.".format(what))
        return {"read_sr": desc["sr_object"], "wkid": None, "mpu": 1.0, "local": False}
    sr_name = (desc["sr"] or {}).get("name") or "unknown"
    # Polar stereographic input of any WKID (or none): recognised by ``arcio.sr_info``.
    polar_input = sr_type == "Projected" and bool((desc["sr"] or {}).get("polar_stereographic"))
    if geographic_sr is not None and polar_input:
        # Its own scale is not 1 near the pole (EPSG 3031/3995: 0.973 at 90 degrees; 3032:
        # true scale at 71S; 9354 IBCSO: 65S).
        collector.info(
            "The {0} is in a polar stereographic system ({1}) whose scale is not 1 near the "
            "pole, so it is read in WGS 84 geographic coordinates and each feature is measured "
            "on its own projection: polar stereographic with true scale at the feature for "
            "features beyond 84N / 80S, Transverse Mercator centred on the feature otherwise "
            "(WGS 84 ellipsoid).".format(what, sr_name))
        return {"read_sr": geographic_sr(WGS84_GCS_WKID), "wkid": WGS84_GCS_WKID, "mpu": 1.0,
                "local": True}
    decision, read_sr = metric_sr_for(desc)
    zones = decision.get("utm_zones") or 0
    polar = bool(decision.get("polar")) and decision.get("reproject")
    if geographic_sr is not None and decision.get("reproject") \
            and (zones > MAX_UTM_ZONES_WITHOUT_WARNING or polar):
        if sr_type == "Geographic":
            read_sr, wkid = desc["sr_object"], (desc["sr"] or {}).get("wkid")
            source = "its own geographic coordinates"
        else:
            read_sr, wkid = geographic_sr(WGS84_GCS_WKID), WGS84_GCS_WKID
            source = "WGS 84 geographic coordinates"
        if polar:
            collector.info(
                "The {0} ({1}) is not in a projected metric system and is polar data (centre "
                "{2}). The polar stereographic systems (EPSG 3995/3031) have their true scale at "
                "71 degrees and measure 2-3 % short near the pole, so the {0} is read in {3} and "
                "each feature is measured on its own projection: polar stereographic with true "
                "scale at the feature for features beyond 84N / 80S, Transverse Mercator "
                "centred on the feature otherwise (WGS 84 ellipsoid).".format(
                    what, sr_name, "north of 84N" if decision["wkid"] == ARCTIC_POLAR_WKID
                    else "south of 80S", source))
        else:
            collector.info(
                "The {0} ({1}) is not in a projected metric system and spans {2} UTM zones, too "
                "wide for one zone to measure accurately. It is read in {3} and each feature is "
                "measured on its own Transverse Mercator projection centred on the feature (WGS "
                "84 ellipsoid, true scale on its central meridian).".format(
                    what, sr_name, zones, source))
        return {"read_sr": read_sr, "wkid": wkid, "mpu": 1.0, "local": True}
    collector.info(decision["reason"])
    if polar:  # no per-feature measuring possible here: say what the bias is
        collector.warning(
            "Polar data is measured in {0} (EPSG {1}), whose true scale is at 71 degrees: "
            "lengths near the pole are up to 2.7 % and areas up to 5.4 % short.".format(
                "WGS 84 / Arctic Polar Stereographic" if decision["wkid"] == ARCTIC_POLAR_WKID
                else "WGS 84 / Antarctic Polar Stereographic", decision["wkid"]))
    as_info = (decision.get("datum_warnings") or []) if datum_as_info else []
    for text in decision["warnings"]:
        if text in as_info:
            collector.info(text.replace(
                " For exact positions project the input to a projected metric coordinate "
                "system first (Project tool, with the right geographic transformation).",
                " The results are written back through the same projection, so they are not "
                "offset."))
        else:
            collector.warning(text)
    if read_sr is None:
        read_sr = desc["sr_object"]
    return {"read_sr": read_sr, "wkid": decision["wkid"],
            "mpu": decision["meters_per_unit"], "local": False}


def local_tm_rows(rows, collector):
    """Rows ``{"oid", "shape", ...}`` in geographic degrees -> the same rows with
    ``shape`` projected on each feature's own local Transverse Mercator (metres).

    Returns ``(rows, frames)``; ``frames[oid] = (lon0, (lo, hi))`` turns a point of
    that feature back into degrees (``local_tm_point_back``): ``lo``/``hi`` are the
    smallest and largest longitude the feature stores, so points go back in the
    input's own longitude convention (-180..180 or 0..360). A feature with a
    vertex farther than ``TM_MAX_FEATURE_OFFSET_M`` from its central meridian
    (about 1,000 km) cannot be measured accurately on one projection: warning
    with its ObjectIDs.

    A feature near a pole (``_projection_polar_sign``: beyond 84N / 80S, or round
    the pole) is projected on a polar stereographic instead (``local_ps_geometry``,
    true scale at the feature); its frame is ``(lon0, (lo, hi), sign, k_ref)``. A
    polar feature whose scale varies by more than ``PS_MAX_FEATURE_SPREAD`` over
    it gets a warning.
    """
    out, frames, wide, polar_wide = [], {}, [], []
    for row in rows:
        new = dict(row)
        lons, lats = [], []
        if row["shape"]:
            _projection_lonlats(row["shape"], lons)
            _projection_lats(row["shape"], lats)
        if not lons:
            new["shape"] = None
            out.append(new)
            continue
        _west, _east, lon0, width = longitude_span(lons)
        stored = (min(lons), max(lons))  # stored range: the input's longitude convention
        sign = _projection_polar_sign(lats, width)
        if sign:
            shape, k_ref, spread = local_ps_geometry(row["shape"], lon0, sign)
            frames[row["oid"]] = (lon0, stored, sign, k_ref)
            if spread > PS_MAX_FEATURE_SPREAD:
                polar_wide.append(row["oid"])
        else:
            shape = _projection_tm_node(row["shape"], lon0)
            frames[row["oid"]] = (lon0, stored)
            if _projection_max_abs_x(shape) > TM_MAX_FEATURE_OFFSET_M:
                wide.append(row["oid"])
        new["shape"] = shape
        out.append(new)
    if polar_wide:
        collector.warning(
            "{0} polar feature(s) span too many degrees of latitude for one polar stereographic "
            "projection to measure them within about 1 % (ObjectIDs {1}). Split them, or "
            "project the input to an equal-area or equidistant system suited to them first."
            .format(len(polar_wide), ", ".join(str(o) for o in sorted(polar_wide)[:20]) +
                    (", ..." if len(polar_wide) > 20 else "")))
    if wide:
        collector.warning(
            "{0} feature(s) reach more than {1:,.0f} km from the central meridian of their own "
            "Transverse Mercator projection (ObjectIDs {2}); even on that projection their "
            "measures can be off by more than 1 %. Split them, or project the input to an "
            "equal-area or equidistant system suited to them first."
            .format(len(wide), TM_MAX_FEATURE_OFFSET_M / 1000.0, ", ".join(
                str(o) for o in sorted(wide)[:20]) + (", ..." if len(wide) > 20 else "")))
    return out, frames


def _projection_max_abs_x(node):
    """Largest ``|x|`` of the vertices of a projected core geometry (0 if empty)."""
    if not isinstance(node, (list, tuple)) or not node:
        return 0.0
    if isinstance(node[0], (int, float)):
        return abs(float(node[0]))
    return max(_projection_max_abs_x(item) for item in node)


def _projection_lon_into_range(lon, stored, lon0=None):
    """Shift ``lon`` by whole turns into the longitudes the feature stores.

    ``stored`` is ``(lo, hi)``, the smallest and largest stored longitude of the
    feature (a single number is taken as ``(x, x)``). The shift that puts ``lon``
    inside ``[lo, hi]``, or nearest to it, wins (RT7-A-1 / RT8-C-4: a point used
    to be wrapped toward the feature's first vertex, so a part across the
    antimeridian from it came back 360 degrees away). Ties (a point exactly on
    the antimeridian) keep the input's convention: -180..180 when every stored
    longitude is in it, else 0..360 when every one is in that, then the side of
    the feature's central meridian ``lon0`` (the point as projected back), then
    the shift nearest the middle of the stored range."""
    if isinstance(stored, (int, float)):
        lo = hi = float(stored)
    else:
        lo, hi = float(stored[0]), float(stored[1])
    if -180.0 <= lo and hi <= 180.0:
        window = (-180.0, 180.0)
    elif 0.0 <= lo and hi <= 360.0:
        window = (0.0, 360.0)
    else:
        window = None
    mid = (lo + hi) / 2.0
    base = float(lon) + 360.0 * round((mid - float(lon)) / 360.0)
    best, best_key = base, None
    for cand in (base - 360.0, base, base + 360.0):
        gap = max(lo - cand, cand - hi, 0.0)
        outside = 0 if window is None or window[0] - 1e-9 <= cand <= window[1] + 1e-9 else 1
        side = 0.0 if lon0 is None else round(abs(cand - float(lon)), 9)
        key = (round(gap, 9), outside, side, abs(cand - mid))
        if best_key is None or key < best_key:
            best, best_key = cand, key
    return best


def local_tm_point_back(point, frame):
    """A point of ``local_tm_rows`` back in the degrees read (``frame`` from it).

    The longitude is put in the range of the feature's own stored longitudes
    (``_projection_lon_into_range``), so it stays in the input's convention
    whichever part of a multipart or antimeridian-crossing feature it is on."""
    if point is None or frame is None:
        return point
    if len(frame) > 2:  # polar stereographic frame (lon0, (lo, hi), sign, k_ref)
        lon, lat = ps_inverse(point[0], point[1], frame[0], frame[2], frame[3])
    else:
        lon, lat = tm_inverse(point[0], point[1], frame[0])
    return [_projection_lon_into_range(lon, frame[1], frame[0]), lat]


def local_tm_point_to_frame(point, frame):
    """A point ``(lon, lat)`` in the degrees read projected on the plane of one
    feature of ``local_tm_rows`` (``frame`` from it): the inverse of
    ``local_tm_point_back``. Used to measure another input (e.g. points)
    against that feature on the feature's own projection."""
    if point is None or frame is None:
        return point
    if len(frame) > 2:  # polar stereographic frame (lon0, (lo, hi), sign, k_ref)
        x, y = ps_forward(point[0], point[1], frame[0], frame[2], frame[3])
    else:
        x, y = tm_forward(point[0], point[1], frame[0])
    return [x, y]


# ==========================================================================
# common/geom.py
# ==========================================================================
# Pure-Python planar geometry on the toolkit's core representation.
#
# Core representation (see ARCHITECTURE)::
#
#     point       (x, y)
#     multipoint  [(x, y), ...]
#     polyline    [path, ...]            path = [(x, y), ...]
#     polygon     [ring, ...]            ring = [(x, y), ..., first point again]
#     null/empty  None
#
# Polygon rings follow the Esri convention: outer rings clockwise, holes
# counter-clockwise. All measures are planar, in the units of the coordinates;
# project to a metric system first (see ``projection``).
#
# The geometry *kind* is one of ``"point"``, ``"multipoint"``, ``"polyline"``,
# ``"polygon"`` (lower case, as used in Esri JSON helpers below).

GEOM_POINT = "point"
GEOM_MULTIPOINT = "multipoint"
GEOM_POLYLINE = "polyline"
GEOM_POLYGON = "polygon"

_GEOM_SHAPE_TYPES = {"point": GEOM_POINT, "multipoint": GEOM_MULTIPOINT,
                     "polyline": GEOM_POLYLINE, "polygon": GEOM_POLYGON}


def kind_from_shape_type(shape_type):
    """Map a Describe ``shapeType`` (``"Polygon"``...) to a core kind.

    Returns ``None`` for unsupported types such as ``"MultiPatch"``.
    """
    return _GEOM_SHAPE_TYPES.get(str(shape_type or "").casefold())


# --------------------------------------------------------------------------
# Basic measures
# --------------------------------------------------------------------------

def iter_points(kind, geom):
    """Yield every vertex of a core geometry."""
    if geom is None:
        return
    if kind == GEOM_POINT:
        yield geom
    elif kind == GEOM_MULTIPOINT:
        for p in geom:
            yield p
    else:
        for part in geom:
            for p in part:
                yield p


def geometry_bbox(kind, geom):
    """``(xmin, ymin, xmax, ymax)`` or ``None`` for an empty geometry."""
    xs, ys = [], []
    for x, y in iter_points(kind, geom):
        xs.append(x)
        ys.append(y)
    if not xs:
        return None
    return (min(xs), min(ys), max(xs), max(ys))


def bbox_intersects(a, b, tolerance=0.0):
    """True if two bboxes overlap or touch (within ``tolerance``)."""
    if a is None or b is None:
        return False
    return not (a[2] + tolerance < b[0] or b[2] + tolerance < a[0]
                or a[3] + tolerance < b[1] or b[3] + tolerance < a[1])


def point_distance(a, b):
    return math.hypot(b[0] - a[0], b[1] - a[1])


def path_length(path):
    """Length of one path (or ring)."""
    return sum(point_distance(path[i], path[i + 1]) for i in range(len(path) - 1))


def polyline_length(paths):
    """Total length of a polyline (all parts)."""
    if not paths:
        return 0.0
    return sum(path_length(p) for p in paths)


def ring_signed_area(ring):
    """Shoelace signed area: positive for counter-clockwise rings.

    Coordinates are shifted to the first vertex first, which keeps full
    precision for data far from the origin (e.g. UTM northings near 10^7).
    """
    n = len(ring)
    if n < 3:
        return 0.0
    x0, y0 = ring[0]
    total = 0.0
    for i in range(n - 1):
        x1, y1 = ring[i][0] - x0, ring[i][1] - y0
        x2, y2 = ring[i + 1][0] - x0, ring[i + 1][1] - y0
        total += x1 * y2 - x2 * y1
    # An unclosed ring needs no extra term: after the shift its closing
    # segment ends at the origin, whose cross product is zero.
    return total / 2.0


def ring_is_clockwise(ring):
    """True for clockwise rings (Esri outer rings)."""
    return ring_signed_area(ring) < 0


def close_ring(ring):
    """Copy of ``ring`` with the first vertex repeated at the end if needed."""
    ring = [tuple(p) for p in ring]
    if ring and ring[0] != ring[-1]:
        ring.append(ring[0])
    return ring


def polygon_area(rings):
    """Area of a polygon (all parts, holes subtracted), always >= 0."""
    total = 0.0
    for outer, holes in group_rings(rings):
        total += abs(ring_signed_area(outer)) - sum(abs(ring_signed_area(h)) for h in holes)
    return max(total, 0.0)


def polygon_perimeter(rings):
    """Length of all rings (outer and holes), like ``SHAPE@LENGTH`` for polygons."""
    return sum(path_length(r) for r in (rings or []))


def geometry_length(kind, geom):
    """Length for lines, perimeter for polygons, 0 for points."""
    if geom is None:
        return 0.0
    if kind == GEOM_POLYLINE:
        return polyline_length(geom)
    if kind == GEOM_POLYGON:
        return polygon_perimeter(geom)
    return 0.0


def part_count(kind, geom):
    """Number of parts (points of a multipoint, paths, or outer rings)."""
    if geom is None:
        return 0
    if kind == GEOM_POINT:
        return 1
    if kind == GEOM_POLYGON:
        return len(group_rings(geom))
    return len(geom)


# --------------------------------------------------------------------------
# Rings, containment
# --------------------------------------------------------------------------

def point_on_segment(p, a, b, tolerance=1e-9):
    """True if ``p`` lies on segment ``a``-``b`` (within ``tolerance``)."""
    return point_segment_distance(p, a, b)[0] <= tolerance


def point_in_ring(p, ring, tolerance=1e-9):
    """``"in"``, ``"out"`` or ``"boundary"`` for a point and one ring (ray casting)."""
    x, y = p
    inside = False
    n = len(ring)
    for i in range(n - 1 if ring and ring[0] == ring[-1] else n):
        a = ring[i]
        b = ring[(i + 1) % n]
        if point_on_segment(p, a, b, tolerance):
            return "boundary"
        if (a[1] > y) != (b[1] > y):
            x_cross = a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
            if x < x_cross:
                inside = not inside
    return "in" if inside else "out"


class _GeomRingProbe(object):
    """``point_in_ring`` for many points against one large ring.

    The ring's edges are filed in horizontal bands, so a query only looks at
    the edges whose y range reaches the point (a ray crossing or a boundary
    hit needs exactly those). Same answers as ``point_in_ring``, at about
    the cost of the edges in one band instead of every edge.
    """

    def __init__(self, ring, tolerance=1e-9):
        self.ring = ring
        self.tolerance = tolerance
        n = len(ring)
        self.count = n - 1 if ring and ring[0] == ring[-1] else n
        ys = [p[1] for p in ring]
        self.y0, self.y1 = min(ys), max(ys)
        self.bands = max(1, self.count // 4)
        span = self.y1 - self.y0
        self.height = span / self.bands if span > 0 and math.isfinite(span) else 0.0
        if self.height <= 0:
            self.bands = 1
        self.edges = [[] for _ in range(self.bands)]
        for i in range(self.count):
            a, b = ring[i], ring[(i + 1) % n]
            lo, hi = self._band(min(a[1], b[1])), self._band(max(a[1], b[1]))
            for k in range(lo, hi + 1):
                self.edges[k].append(i)

    def _band(self, y):
        if self.height <= 0:
            return 0
        k = int(math.floor((y - self.y0) / self.height))
        return min(max(k, 0), self.bands - 1)

    def locate(self, p):
        """``"in"``, ``"out"`` or ``"boundary"`` (see ``point_in_ring``)."""
        x, y = p
        tol = self.tolerance
        if y < self.y0 - tol or y > self.y1 + tol:
            return "out"
        lo, hi = self._band(y - tol), self._band(y + tol)
        if lo == hi:
            candidates = self.edges[lo]
        else:
            seen = set()
            for k in range(lo, hi + 1):
                seen.update(self.edges[k])
            candidates = sorted(seen)
        ring, n = self.ring, len(self.ring)
        inside = False
        for i in candidates:
            a, b = ring[i], ring[(i + 1) % n]
            if (min(a[0], b[0]) - tol <= x <= max(a[0], b[0]) + tol
                    and min(a[1], b[1]) - tol <= y <= max(a[1], b[1]) + tol
                    and point_on_segment(p, a, b, tol)):
                return "boundary"
            if (a[1] > y) != (b[1] > y):
                x_cross = a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
                if x < x_cross:
                    inside = not inside
        return "in" if inside else "out"


# Rings with more vertices than this get a _GeomRingProbe in group_rings.
_GEOM_PROBE_MIN_VERTICES = 64


def _geom_ring_inside(inner, outer, probe=None):
    """True if ring ``inner`` lies inside ring ``outer`` (vertex test).

    Uses the first vertex that is not on the boundary of ``outer``; rings that
    share every vertex are treated as inside. ``probe`` is an optional
    ``_GeomRingProbe`` of ``outer`` (same answers, faster for large rings).
    """
    for p in inner:
        state = probe.locate(p) if probe is not None else point_in_ring(p, outer)
        if state != "boundary":
            return state == "in"
    return True


def group_rings(rings):
    """Group rings into polygons: ``[(outer, [holes...]), ...]``.

    Clockwise rings are outers and counter-clockwise rings are holes (Esri
    convention). Each hole is assigned to the smallest outer that contains it.
    A hole contained by no outer is kept as its own outer (bad orientation in
    the source), so no ring is ever lost. Degenerate rings (area 0) are
    treated as outers. Output order follows input order.

    Candidate outers for a hole come from a ``GridIndex`` of ring bboxes, so a
    multipart polygon with many parts and holes is not parts x holes ring
    tests (a ring can only contain a vertex of the hole if their bboxes meet,
    so the result is the same as testing every outer).
    """
    rings = [close_ring(r) for r in (rings or []) if len(r) >= 3]
    outers, holes = [], []
    for r in rings:
        (holes if ring_signed_area(r) > 0 else outers).append(r)
    groups = [(o, []) for o in outers]
    if not holes:
        return groups
    boxes = [_geom_ring_bbox(r) for r in rings]
    width = max(b[2] for b in boxes) - min(b[0] for b in boxes)
    height = max(b[3] for b in boxes) - min(b[1] for b in boxes)
    # About one grid cell per ring over the extent of all rings.
    cell = max(math.sqrt(width * height / len(rings)), max(width, height) / len(rings))
    index = GridIndex(cell if cell > 0 and math.isfinite(cell) else 1.0)
    areas = []
    for idx, o in enumerate(outers):
        index.insert(idx, _geom_ring_bbox(o))
        areas.append(abs(ring_signed_area(o)))
    # Banded edge index per large candidate ring, built on first use: one
    # outer with thousands of vertices and hundreds of holes (a coastline
    # with lakes) is then not holes x vertices segment tests (RT4-A-2).
    probes = {}
    for h in holes:
        box = _geom_ring_bbox(h)
        best, best_area = None, None
        for idx in index.query(box):  # ascending: ties keep the first outer
            outer = groups[idx][0]
            probe = probes.get(idx)
            if probe is None and len(outer) > _GEOM_PROBE_MIN_VERTICES:
                probe = probes[idx] = _GeomRingProbe(outer)
            if _geom_ring_inside(h, outer, probe):
                area = areas[idx]
                if best is None or area < best_area:
                    best, best_area = idx, area
        if best is None:
            index.insert(len(groups), box)
            areas.append(abs(ring_signed_area(h)))
            groups.append((h, []))
        else:
            groups[best][1].append(h)
    return groups


def _geom_ring_bbox(ring):
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    return (min(xs), min(ys), max(xs), max(ys))


def point_in_polygon(p, rings, include_boundary=True):
    """True if ``p`` is inside the polygon (holes excluded)."""
    for outer, holes in group_rings(rings):
        state = point_in_ring(p, outer)
        if state == "boundary":
            return include_boundary
        if state == "out":
            continue
        in_hole = False
        for h in holes:
            hs = point_in_ring(p, h)
            if hs == "boundary":
                return include_boundary
            if hs == "in":
                in_hole = True
                break
        if not in_hole:
            return True
    return False


# --------------------------------------------------------------------------
# Segments
# --------------------------------------------------------------------------

def point_segment_distance(p, a, b):
    """``(distance, closest_point, t)`` from ``p`` to segment ``a``-``b``.

    ``t`` is the position of the closest point along the segment (0..1).
    """
    ax, ay = a
    dx, dy = b[0] - ax, b[1] - ay
    seg2 = dx * dx + dy * dy
    if seg2 == 0.0:
        return point_distance(p, a), (ax, ay), 0.0
    t = ((p[0] - ax) * dx + (p[1] - ay) * dy) / seg2
    t = min(1.0, max(0.0, t))
    c = (ax + t * dx, ay + t * dy)
    return point_distance(p, c), c, t


def _geom_cross(o, a, b):
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])


def segment_intersection(a, b, c, d, tolerance=1e-12):
    """Intersection of segments ``a``-``b`` and ``c``-``d``.

    Returns ``None``, ``("point", (x, y))`` or ``("overlap", (p, q))`` for
    collinear overlapping segments (``p``-``q`` is the shared piece).
    """
    r = (b[0] - a[0], b[1] - a[1])
    s = (d[0] - c[0], d[1] - c[1])
    denom = r[0] * s[1] - r[1] * s[0]
    qp = (c[0] - a[0], c[1] - a[1])
    scale = max(1.0, abs(r[0]), abs(r[1]), abs(s[0]), abs(s[1]))
    if abs(denom) <= tolerance * scale * scale:
        # Parallel. Collinear?
        if abs(qp[0] * r[1] - qp[1] * r[0]) > tolerance * scale * scale:
            return None
        rr = r[0] * r[0] + r[1] * r[1]
        if rr == 0.0:
            if point_on_segment(a, c, d, tolerance * scale):
                return ("point", (a[0], a[1]))
            return None
        t0 = (qp[0] * r[0] + qp[1] * r[1]) / rr
        t1 = t0 + (s[0] * r[0] + s[1] * r[1]) / rr
        lo, hi = max(0.0, min(t0, t1)), min(1.0, max(t0, t1))
        if lo > hi + tolerance:
            return None
        p = (a[0] + lo * r[0], a[1] + lo * r[1])
        q = (a[0] + hi * r[0], a[1] + hi * r[1])
        if abs(hi - lo) <= tolerance:
            return ("point", p)
        return ("overlap", (p, q))
    t = (qp[0] * s[1] - qp[1] * s[0]) / denom
    u = (qp[0] * r[1] - qp[1] * r[0]) / denom
    eps = tolerance
    if -eps <= t <= 1 + eps and -eps <= u <= 1 + eps:
        return ("point", (a[0] + t * r[0], a[1] + t * r[1]))
    return None


def densify_path(path, max_segment):
    """Copy of ``path`` with extra vertices so no segment exceeds ``max_segment``."""
    if max_segment <= 0:
        raise ValueError("max_segment must be positive")
    if not path:
        return []
    out = [tuple(path[0])]
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        n = int(math.ceil(point_distance(a, b) / max_segment))
        for k in range(1, n):
            f = float(k) / n
            out.append((a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1])))
        out.append(tuple(b))
    return out


def densify_path_segments(path, max_segment, wrap_longitude=False):
    """Copy of ``path`` with extra vertices so no segment exceeds ``max_segment``,
    each segment densified on its own (original vertices kept).

    ``wrap_longitude`` (geographic data, x = longitude in degrees): a segment
    spanning more than 180 degrees of longitude is taken to cross the
    antimeridian the short way; its new vertices are interpolated on the
    unwrapped longitude and wrapped back into [-180, 180).
    """
    if max_segment <= 0:
        raise ValueError("max_segment must be positive")
    if not path:
        return []
    out = [tuple(path[0])]
    for i in range(len(path) - 1):
        a, b = tuple(path[i]), tuple(path[i + 1])
        bx = b[0]
        if wrap_longitude and abs(bx - a[0]) > 180.0:
            bx += -360.0 if bx > a[0] else 360.0
        n = int(math.ceil(math.hypot(bx - a[0], b[1] - a[1]) / max_segment))
        for k in range(1, n):
            f = float(k) / n
            x = a[0] + f * (bx - a[0])
            if wrap_longitude:
                x = ((x + 180.0) % 360.0) - 180.0
            out.append((x, a[1] + f * (b[1] - a[1])))
        out.append(b)
    return out


# --------------------------------------------------------------------------
# Spatial index
# --------------------------------------------------------------------------

class GridIndex(object):
    """Uniform grid of bounding boxes for fast candidate-pair search.

    ``insert(key, box)`` registers a bbox; ``query(box)`` returns keys whose
    bbox intersects ``box``; ``candidate_pairs()`` returns all ``(k1, k2)``
    with ``k1 < k2`` and intersecting bboxes, sorted. Keys must be orderable.
    Choose ``cell_size`` around the typical feature size (plus any search
    tolerance, which can be passed to ``query``/``candidate_pairs``).
    """

    def __init__(self, cell_size):
        if not cell_size or cell_size <= 0:
            raise ValueError("cell_size must be positive")
        self.cell_size = float(cell_size)
        self.cells = {}
        self.boxes = {}

    def _cells_for(self, box, tolerance=0.0):
        cs = self.cell_size
        x0 = int(math.floor((box[0] - tolerance) / cs))
        y0 = int(math.floor((box[1] - tolerance) / cs))
        x1 = int(math.floor((box[2] + tolerance) / cs))
        y1 = int(math.floor((box[3] + tolerance) / cs))
        for gx in range(x0, x1 + 1):
            for gy in range(y0, y1 + 1):
                yield (gx, gy)

    def insert(self, key, box):
        if box is None:
            return
        self.boxes[key] = box
        for cell in self._cells_for(box):
            self.cells.setdefault(cell, []).append(key)

    def query(self, box, tolerance=0.0):
        found = set()
        for cell in self._cells_for(box, tolerance):
            for key in self.cells.get(cell, ()):
                if key not in found and bbox_intersects(self.boxes[key], box, tolerance):
                    found.add(key)
        return sorted(found)

    def candidate_pairs(self, tolerance=0.0):
        pairs = set()
        for keys in self.cells.values():
            for i in range(len(keys)):
                for j in range(i + 1, len(keys)):
                    k1, k2 = keys[i], keys[j]
                    if k1 == k2:
                        continue
                    if k2 < k1:
                        k1, k2 = k2, k1
                    if (k1, k2) not in pairs and bbox_intersects(
                            self.boxes[k1], self.boxes[k2], tolerance):
                        pairs.add((k1, k2))
        if tolerance > 0:
            # Boxes closer than the tolerance may sit in non-adjacent-by-content cells.
            for k1, box in self.boxes.items():
                for k2 in self.query(box, tolerance):
                    if k1 < k2:
                        pairs.add((k1, k2))
        return sorted(pairs)


# --------------------------------------------------------------------------
# Esri JSON <-> core
# --------------------------------------------------------------------------

def esri_json_has_curves(data):
    """True if an Esri JSON geometry dict contains true curves."""
    return isinstance(data, dict) and ("curvePaths" in data or "curveRings" in data)


def esri_json_zm(data):
    """``(has_z, has_m)`` of an Esri JSON geometry dict.

    Esri JSON marks Z and M with ``"hasZ": true`` / ``"hasM": true``. When neither key is
    present a coordinate with three numbers is read as Z. ``esri_json_to_core`` drops both."""
    if not isinstance(data, dict):
        return False, False
    has_z, has_m = data.get("hasZ") is True, data.get("hasM") is True
    if "hasZ" in data or "hasM" in data:
        return has_z, has_m
    first = None
    for key in ("rings", "paths"):
        parts = data.get(key)
        if parts and parts[0]:
            first = parts[0][0]
            break
    if first is None and data.get("points"):
        first = data["points"][0]
    return (first is not None and len(first) >= 3), False


def _geom_xy(coord):
    return (float(coord[0]), float(coord[1]))


def _geom_is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def esri_json_to_core(data):
    """Convert an Esri JSON geometry dict to ``(kind, geom)``.

    Z and M values are dropped. Empty geometries give ``(kind, None)``.
    Raises ``ValueError`` for curves (handle them before calling) and for
    unknown structures.
    """
    if data is None:
        return None, None
    if esri_json_has_curves(data):
        raise ValueError("true curves must be densified before conversion")
    if "x" in data:
        x, y = data.get("x"), data.get("y")
        if not (_geom_is_number(x) and _geom_is_number(y)):
            return GEOM_POINT, None
        return GEOM_POINT, (float(x), float(y))
    if "points" in data:
        pts = [_geom_xy(c) for c in data["points"]]
        return GEOM_MULTIPOINT, (pts or None)
    if "paths" in data:
        paths = [[_geom_xy(c) for c in path] for path in data["paths"]]
        paths = [p for p in paths if p]
        return GEOM_POLYLINE, (paths or None)
    if "rings" in data:
        rings = [close_ring([_geom_xy(c) for c in ring]) for ring in data["rings"]]
        rings = [r for r in rings if r]
        return GEOM_POLYGON, (rings or None)
    raise ValueError("unsupported Esri JSON geometry: keys {0}".format(sorted(data)))


def core_to_esri_json(kind, geom, wkid=None):
    """Convert a core geometry to an Esri JSON dict (for ``arcpy.AsShape(d, True)``).

    Returns ``None`` for a null geometry.
    """
    if geom is None:
        return None
    if kind == GEOM_POINT:
        data = {"x": float(geom[0]), "y": float(geom[1])}
    elif kind == GEOM_MULTIPOINT:
        data = {"points": [[float(x), float(y)] for (x, y) in geom]}
    elif kind == GEOM_POLYLINE:
        data = {"paths": [[[float(x), float(y)] for (x, y) in path] for path in geom]}
    elif kind == GEOM_POLYGON:
        data = {"rings": [[[float(x), float(y)] for (x, y) in close_ring(r)] for r in geom]}
    else:
        raise ValueError("unknown geometry kind: {0}".format(kind))
    if wkid:
        data["spatialReference"] = {"wkid": int(wkid)}
    return data


# --------------------------------------------------------------------------
# Vertex angles, segment lengths, spikes
# --------------------------------------------------------------------------

def _geom_distinct_ring(path):
    """Ring vertices without the closing duplicate."""
    pts = [tuple(p) for p in path]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    return pts


def vertex_angle(a, b, c):
    """Interior angle at ``b`` between legs ``b->a`` and ``b->c`` in degrees
    (0..180). ``None`` if a leg has zero length. 0 = spike (the line turns
    back on itself), 180 = straight."""
    v1 = (a[0] - b[0], a[1] - b[1])
    v2 = (c[0] - b[0], c[1] - b[1])
    if (v1[0] == 0.0 and v1[1] == 0.0) or (v2[0] == 0.0 and v2[1] == 0.0):
        return None
    cross = v1[0] * v2[1] - v1[1] * v2[0]
    dot = v1[0] * v2[0] + v1[1] * v2[1]
    return math.degrees(math.atan2(abs(cross), dot))


def turn_angle(a, b, c):
    """Signed change of direction at ``b`` in degrees, in (-180, 180]:
    positive = left (counter-clockwise) turn, 0 = straight on.
    ``None`` if a leg has zero length."""
    d1 = (b[0] - a[0], b[1] - a[1])
    d2 = (c[0] - b[0], c[1] - b[1])
    if (d1[0] == 0.0 and d1[1] == 0.0) or (d2[0] == 0.0 and d2[1] == 0.0):
        return None
    cross = d1[0] * d2[1] - d1[1] * d2[0]
    dot = d1[0] * d2[0] + d1[1] * d2[1]
    ang = math.degrees(math.atan2(cross, dot))
    return 180.0 if ang == -180.0 else ang


def path_is_closed(path):
    """True if the path has at least 4 points and first == last."""
    return len(path) >= 4 and tuple(path[0]) == tuple(path[-1])


def path_vertex_angles(path, closed=None, signed=False):
    """Angle at every vertex: ``vertex_angle`` (or ``turn_angle`` if ``signed``).

    ``closed=None`` detects rings (``path_is_closed``). Open path: one value
    per vertex, ``None`` at both ends. Ring: one value per *distinct*
    vertex (the closing duplicate is not repeated); the first vertex uses
    the last distinct vertex as its predecessor. Zero-length legs give
    ``None`` (remove duplicate vertices first if needed).
    """
    fn = turn_angle if signed else vertex_angle
    if closed is None:
        closed = path_is_closed(path)
    if closed:
        pts = _geom_distinct_ring(path)
        n = len(pts)
        if n < 3:
            return [None] * n
        return [fn(pts[i - 1], pts[i], pts[(i + 1) % n]) for i in range(n)]
    pts = [tuple(p) for p in path]
    n = len(pts)
    out = [None] * n
    for i in range(1, n - 1):
        out[i] = fn(pts[i - 1], pts[i], pts[i + 1])
    return out


def segment_lengths(path):
    """Length of every segment of ``path`` (``len(path) - 1`` values)."""
    return [point_distance(path[i], path[i + 1]) for i in range(len(path) - 1)]


def segment_length_stats(path):
    """``{"count", "min", "max", "mean", "total"}`` of the segment lengths
    (``None`` values for a path with no segment)."""
    lengths = segment_lengths(path)
    if not lengths:
        return {"count": 0, "min": None, "max": None, "mean": None, "total": 0.0}
    total = sum(lengths)
    return {"count": len(lengths), "min": min(lengths), "max": max(lengths),
            "mean": total / len(lengths), "total": total}


def find_spikes(path, max_angle, closed=None):
    """Vertex indices whose interior angle is below ``max_angle`` degrees.

    Indices refer to ``path`` (for rings: distinct vertices, index 0 = the
    start/closing vertex). Zero-length legs are not spikes (see
    ``near_duplicate_vertices``).
    """
    return [i for i, ang in enumerate(path_vertex_angles(path, closed))
            if ang is not None and ang < max_angle]


def near_duplicate_vertices(path, tolerance):
    """Indices ``i`` where vertex ``i`` and the next vertex are at most
    ``tolerance`` apart (exact duplicates included). For a ring the closing
    duplicate itself is not reported, but the pair (last distinct, first)
    is checked and reported as the last distinct index."""
    closed = path_is_closed(path)
    pts = _geom_distinct_ring(path) if closed else [tuple(p) for p in path]
    n = len(pts)
    out = [i for i in range(n - 1) if point_distance(pts[i], pts[i + 1]) <= tolerance]
    if closed and n > 1 and point_distance(pts[-1], pts[0]) <= tolerance:
        out.append(n - 1)
    return out


def remove_repeated_vertices(path, tolerance=0.0):
    """Copy of ``path`` without vertices within ``tolerance`` of the previous
    kept vertex. The first and last vertex are always kept (the last one
    replaces a kept vertex that is too close to it)."""
    pts = [tuple(p) for p in path]
    if len(pts) < 2:
        return pts
    out = [pts[0]]
    for p in pts[1:]:
        if point_distance(out[-1], p) > tolerance:
            out.append(p)
    if len(out) == 1:
        out.append(pts[-1])
    elif out[-1] != pts[-1]:
        out[-1] = pts[-1]
    return out


# --------------------------------------------------------------------------
# Measures along a path, interpolation, splitting
# --------------------------------------------------------------------------

def path_measures(path):
    """Cumulative distance at every vertex (first = 0; empty path -> [])."""
    if not path:
        return []
    out = [0.0]
    for i in range(len(path) - 1):
        out.append(out[-1] + point_distance(path[i], path[i + 1]))
    return out


def path_point_at(path, distance):
    """Point at ``distance`` along ``path``, clamped to [0, length].
    ``None`` for an empty path."""
    if not path:
        return None
    if distance <= 0 or len(path) == 1:
        return tuple(path[0])
    run = 0.0
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        seg = point_distance(a, b)
        if seg > 0 and run + seg >= distance:
            f = (distance - run) / seg
            return (a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1]))
        run += seg
    return tuple(path[-1])


def path_midpoint(path):
    """Point at half the length of ``path``."""
    return path_point_at(path, path_length(path) / 2.0)


def locate_point_on_path(p, path):
    """Project ``p`` onto ``path``.

    Returns ``{"measure", "offset", "side", "segment", "point"}``: distance
    along the path of the closest point, distance from ``p`` to it, side
    ``"L"`` or ``"R"`` of the digitising direction (``""`` when on the line),
    the segment index and the closest point. The first closest segment wins
    on ties. ``None`` for a path with fewer than 2 vertices.
    """
    if len(path) < 2:
        return None
    best = None
    run = 0.0
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        d, c, t = point_segment_distance(p, a, b)
        seg = point_distance(a, b)
        if best is None or d < best[0]:
            cross = _geom_cross(a, b, p)
            side = "" if d == 0.0 or cross == 0.0 else ("L" if cross > 0 else "R")
            best = (d, run + t * seg, side, i, c)
        run += seg
    return {"offset": best[0], "measure": best[1], "side": best[2], "segment": best[3],
            "point": best[4]}


def split_path_at_distances(path, distances, min_length=0.0):
    """Split ``path`` at the given distances along it.

    Distances outside (0, length) are ignored and duplicates merged. Each
    piece keeps the original vertices between its cut points; the first and
    last piece end exactly on the original end vertices. Pieces not longer
    than ``min_length`` (default: zero-length pieces) are dropped.
    """
    pts = [tuple(p) for p in path]
    if len(pts) < 2:
        return []
    total = path_length(pts)
    cuts = sorted(set(float(d) for d in distances if 0.0 < d < total))
    measures = path_measures(pts)
    bounds = [0.0] + cuts + [total]
    pieces = []
    last = len(bounds) - 2
    for k in range(len(bounds) - 1):
        lo, hi = bounds[k], bounds[k + 1]
        piece = [pts[0] if k == 0 else path_point_at(pts, lo)]
        for i in range(1, len(pts) - 1):
            if lo < measures[i] < hi:
                piece.append(pts[i])
        piece.append(pts[-1] if k == last else path_point_at(pts, hi))
        if path_length(piece) > min_length:
            pieces.append(piece)
    return pieces


def split_path_at_vertices(path, min_length=0.0):
    """One two-point piece per segment; pieces not longer than ``min_length``
    (default: zero-length segments) are dropped."""
    pts = [tuple(p) for p in path]
    return [[pts[i], pts[i + 1]] for i in range(len(pts) - 1)
            if point_distance(pts[i], pts[i + 1]) > min_length]


def split_distances(length, max_length, mode="fixed"):
    """Cut distances so that no piece exceeds ``max_length``.

    ``"fixed"``: cuts at ``max_length``, ``2*max_length``, ... (the last piece
    is the remainder); ``"equal"``: ``ceil(length / max_length)`` equal
    pieces. A remainder shorter than 1e-9 * ``max_length`` is not cut off.
    """
    if max_length <= 0:
        raise ValueError("max_length must be positive")
    if mode not in ("fixed", "equal"):
        raise ValueError("mode must be 'fixed' or 'equal'")
    if length <= max_length * (1 + 1e-9):
        return []
    if mode == "equal":
        n = int(math.ceil(length / max_length - 1e-9))
        return [length * k / n for k in range(1, n)]
    eps = 1e-9 * max_length
    out = []
    k = 1
    while k * max_length < length - eps:
        out.append(k * max_length)
        k += 1
    return out


# ==========================================================================
# common/clip.py
# ==========================================================================
# Convex clipping and polygon centroids (pure Python).
#
# * Half-plane clipping of one ring (one Sutherland-Hodgman stage), the
#   bisector half-plane of two sites (Voronoi cells by successive clipping),
#   clipping against an axis-aligned rectangle or any convex ring.
# * Cyrus-Beck clipping of a segment against a convex ring (interior overlap
#   tests: a segment that only runs along the boundary has zero inside length
#   only if callers use ``strict=True``).
# * Ring / polygon centroids (area-weighted, holes subtracted).
#
# Deliberately **no general polygon-polygon overlay**. The subject ring may be
# concave when the clip region is convex; a concave subject can then produce
# zero-width "bridges" along the clip boundary (standard Sutherland-Hodgman
# behaviour): area and centroid stay correct, the vertex list is not
# simplified. Output rings are closed (first == last) and keep the
# orientation of the input ring; ``[]`` means nothing is left.
#
# A half-plane ``(a, b, c)`` is the set of points with ``a*x + b*y <= c``.

# Relative tolerance for "on the clip line" decisions.
CLIP_EPSILON = 1e-12


def _clip_open(ring):
    pts = [tuple(p) for p in ring]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    return pts


def _clip_finish(pts):
    """Drop consecutive duplicates; close; ``[]`` if fewer than 3 vertices."""
    out = []
    for p in pts:
        if not out or p != out[-1]:
            out.append(p)
    if len(out) > 1 and out[0] == out[-1]:
        out.pop()
    if len(out) < 3:
        return []
    return close_ring(out)


def clip_ring_halfplane(ring, a, b, c):
    """Keep the part of ``ring`` with ``a*x + b*y <= c`` (one Sutherland-Hodgman stage).

    Vertices within a relative tolerance of the line count as inside.
    Returns a closed ring or ``[]``.
    """
    pts = _clip_open(ring)
    if not pts:
        return []
    scale = max(1.0, abs(c), max(abs(a * x) + abs(b * y) for x, y in pts))
    eps = CLIP_EPSILON * scale
    vals = [a * x + b * y - c for x, y in pts]
    out = []
    n = len(pts)
    for i in range(n):
        p, q = pts[i], pts[(i + 1) % n]
        vp, vq = vals[i], vals[(i + 1) % n]
        p_in, q_in = vp <= eps, vq <= eps
        if p_in:
            out.append(p)
        if p_in != q_in and abs(vp - vq) > 0:
            t = vp / (vp - vq)
            if 0.0 < t < 1.0:
                out.append((p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])))
    return _clip_finish(out)


def bisector_halfplane(site, other):
    """Half-plane of points at least as close to ``site`` as to ``other``.

    ``|x - s|^2 <= |x - o|^2``  <=>  ``2(o - s) . x <= |o|^2 - |s|^2``.
    Raises ``ValueError`` for identical sites.
    """
    sx, sy = site
    ox, oy = other
    if sx == ox and sy == oy:
        raise ValueError("identical sites have no bisector")
    a = 2.0 * (ox - sx)
    b = 2.0 * (oy - sy)
    c = (ox * ox + oy * oy) - (sx * sx + sy * sy)
    return a, b, c


def rect_ring(xmin, ymin, xmax, ymax, clockwise=True):
    """Closed rectangle ring (clockwise = Esri outer ring by default)."""
    if clockwise:
        pts = [(xmin, ymin), (xmin, ymax), (xmax, ymax), (xmax, ymin)]
    else:
        pts = [(xmin, ymin), (xmax, ymin), (xmax, ymax), (xmin, ymax)]
    return close_ring(pts)


def clip_ring_rect(ring, xmin, ymin, xmax, ymax):
    """Sutherland-Hodgman clip of ``ring`` against an axis-aligned rectangle."""
    if xmin > xmax or ymin > ymax:
        raise ValueError("empty rectangle")
    out = ring
    for a, b, c in ((-1.0, 0.0, -xmin), (1.0, 0.0, xmax), (0.0, -1.0, -ymin), (0.0, 1.0, ymax)):
        out = clip_ring_halfplane(out, a, b, c)
        if not out:
            return []
    return out


def ring_is_convex(ring, tolerance=1e-9):
    """True if ``ring`` is convex (collinear vertices allowed, any orientation).

    Degenerate rings (fewer than 3 distinct vertices or zero area) are not convex.

    A vertex counts as collinear (no turn) only if the sine of its turn angle
    is at most ``tolerance`` (``|cross| <= tolerance * |e1| * |e2|``), plus a
    floating-point floor of ``CLIP_EPSILON * max|coordinate| * (|e1| + |e2|)``
    (a vertex within about 1e-12 of the coordinate size of the line through its
    neighbours). The test is relative to the edge lengths, not to the square
    of the coordinates: a densified edge that is slightly concave (a parallel
    projected to UTM, with a vertex every few hundred metres) turns by a tiny
    angle at each vertex but is still concave, and must be refused, however
    finely it is densified.
    """
    pts = _clip_open(ring)
    n = len(pts)
    if n < 3 or ring_signed_area(close_ring(pts)) == 0.0:
        return False
    floor = CLIP_EPSILON * max(1.0, max(max(abs(x), abs(y)) for x, y in pts))
    sign = 0
    for i in range(n):
        o, p, q = pts[i], pts[(i + 1) % n], pts[(i + 2) % n]
        ux, uy = p[0] - o[0], p[1] - o[1]
        vx, vy = q[0] - p[0], q[1] - p[1]
        cross = ux * vy - uy * vx
        lu, lv = math.hypot(ux, uy), math.hypot(vx, vy)
        if abs(cross) <= tolerance * lu * lv + floor * (lu + lv):
            continue
        s = 1 if cross > 0 else -1
        if sign == 0:
            sign = s
        elif s != sign:
            return False
    # A star polygon turns the same way at every vertex but winds twice.
    total = 0.0
    for i in range(n):
        o, p, q = pts[i - 1], pts[i], pts[(i + 1) % n]
        a1 = math.atan2(p[1] - o[1], p[0] - o[0])
        a2 = math.atan2(q[1] - p[1], q[0] - p[0])
        d = a2 - a1
        while d <= -math.pi:
            d += 2 * math.pi
        while d > math.pi:
            d -= 2 * math.pi
        total += d
    return abs(abs(total) - 2 * math.pi) < 1e-6


def _clip_hull_indexes(pts):
    """Indexes of the strict convex hull of ``pts`` (Andrew's monotone chain),
    counter-clockwise, collinear and duplicate points left out."""
    order = sorted(range(len(pts)), key=lambda i: pts[i])

    def cross(o, a, b):
        return ((pts[a][0] - pts[o][0]) * (pts[b][1] - pts[o][1]) -
                (pts[a][1] - pts[o][1]) * (pts[b][0] - pts[o][0]))

    lower, upper = [], []
    for i in order:
        while len(lower) >= 2 and cross(lower[-2], lower[-1], i) <= 0:
            lower.pop()
        lower.append(i)
    for i in reversed(order):
        while len(upper) >= 2 and cross(upper[-2], upper[-1], i) <= 0:
            upper.pop()
        upper.append(i)
    hull = lower[:-1] + upper[:-1]
    out = []
    for i in hull:  # duplicates of the first point can survive at both ends
        if not out or pts[i] != pts[out[-1]]:
            out.append(i)
    if len(out) > 1 and pts[out[0]] == pts[out[-1]]:
        out.pop()
    return out


def convex_hull_points(points):
    """Strict convex hull of ``points`` (``(x, y)`` tuples), counter-clockwise,
    open (first point not repeated); fewer than 3 points when they are collinear."""
    pts = sorted(set(tuple(p) for p in points))
    return [pts[i] for i in _clip_hull_indexes(pts)]


def near_convex_ring(ring, tolerance):
    """The convex hull of ``ring`` when the ring is convex up to ``tolerance``, else ``None``.

    ``tolerance`` is an absolute distance (coordinate units). The ring is accepted
    when (a) it runs around its convex hull in the hull's order (no star polygon, no
    loop) and (b) every vertex lies at most ``tolerance`` inside the hull edge of the
    stretch it belongs to. So the region between the ring and its hull is never
    deeper than ``tolerance``, however finely an edge is densified: a densified edge
    that bows inwards by more than ``tolerance`` anywhere is refused, while
    vertices on a straight edge that were rounded to the geodatabase resolution
    (a few 0.01 mm off the line) are accepted. The returned ring is the hull,
    closed, in the orientation of the input ring; it is exactly convex, so
    clipping with its half-planes is exact; its vertices are the hull vertices in
    the ring's own order, starting with the first of them in the ring (a strictly
    convex ring comes back unchanged, closed). Degenerate rings (fewer than 3
    distinct vertices, zero area) give ``None``.
    """
    pts = []
    for p in _clip_open(ring):
        if not pts or p != pts[-1]:
            pts.append(p)
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts.pop()
    n = len(pts)
    if n < 3:
        return None
    area = ring_signed_area(close_ring(pts))
    if area == 0.0:
        return None
    hull = _clip_hull_indexes(pts)
    if len(hull) < 3:
        return None
    # Position of every vertex along the ring, walked counter-clockwise (as the hull).
    if area > 0:
        pos = list(range(n))
    else:
        pos = [n - 1 - i for i in range(n)]
    walk = sorted(range(n), key=lambda i: pos[i])
    hpos = [pos[i] for i in hull]
    descents = sum(1 for k in range(len(hull)) if hpos[(k + 1) % len(hull)] < hpos[k])
    if descents != 1:
        return None  # the ring does not go round its hull once, in order
    for k in range(len(hull)):
        a, b = pts[hull[k]], pts[hull[(k + 1) % len(hull)]]
        ex, ey = b[0] - a[0], b[1] - a[1]
        length = math.hypot(ex, ey)
        if length == 0.0:
            continue
        start, end = hpos[k], hpos[(k + 1) % len(hull)]
        steps = (end - start) % n
        for s in range(1, steps):
            p = pts[walk[(start + s) % n]]
            # Left of a counter-clockwise hull edge = inside; depth below the edge.
            depth = (ex * (p[1] - a[1]) - ey * (p[0] - a[0])) / length
            if depth > tolerance:
                return None
    # Hull vertices in the ring's own order, starting at the first one met along the
    # ring, so a ring that is already strictly convex comes back unchanged.
    keep = sorted(hull)
    return close_ring([pts[i] for i in keep])


def convex_halfplanes(convex_ring):
    """The half-planes ``(a, b, c)`` whose intersection is ``convex_ring``
    (either orientation; zero-length edges skipped)."""
    pts = _clip_open(convex_ring)
    ccw = ring_signed_area(close_ring(pts)) > 0
    planes = []
    n = len(pts)
    for i in range(n):
        p, q = pts[i], pts[(i + 1) % n]
        dx, dy = q[0] - p[0], q[1] - p[1]
        if dx == 0.0 and dy == 0.0:
            continue
        # Inside is to the left of each edge for a CCW ring: cross(d, x - p) >= 0
        # <=> dy*x - dx*y <= dy*px - dx*py.
        a, b = dy, -dx
        if not ccw:
            a, b = -a, -b
        planes.append((a, b, a * p[0] + b * p[1]))
    return planes


def clip_ring_convex(ring, convex_ring):
    """Clip ``ring`` against a convex ring (``ValueError`` if not convex)."""
    if not ring_is_convex(convex_ring):
        raise ValueError("clip ring is not convex")
    out = ring
    for a, b, c in convex_halfplanes(convex_ring):
        out = clip_ring_halfplane(out, a, b, c)
        if not out:
            return []
    return out


def clip_segment_convex(p, q, convex_ring, strict=False):
    """Cyrus-Beck: the part of segment ``p``-``q`` inside a convex ring.

    Returns ``(t0, t1)`` parameters along the segment (0..1) or ``None``.
    ``strict=True`` uses the open interior: a segment lying on the boundary
    (or touching it at one point) gives ``None``. Tolerance is relative to
    the coordinate scale.
    """
    planes = convex_halfplanes(convex_ring)
    if not planes:
        return None
    dx, dy = q[0] - p[0], q[1] - p[1]
    scale = max(1.0, abs(p[0]), abs(p[1]), abs(q[0]), abs(q[1]))
    t0, t1 = 0.0, 1.0
    for a, b, c in planes:
        norm = math.hypot(a, b)
        eps = CLIP_EPSILON * scale * norm * 1e3
        num = c - (a * p[0] + b * p[1])     # >= 0 when p is inside
        den = a * dx + b * dy
        if strict:
            num -= eps
        else:
            num += eps
        if den == 0.0:
            if num < 0:
                return None
            continue
        t = num / den
        if den > 0:
            t1 = min(t1, t)
        else:
            t0 = max(t0, t)
        if t0 > t1:
            return None
    if strict and t1 - t0 <= 0.0:
        return None
    return (t0, t1)


def segment_inside_length(p, q, convex_ring, strict=True):
    """Length of segment ``p``-``q`` inside a convex ring (0.0 if none);
    ``strict`` as in ``clip_segment_convex``."""
    hit = clip_segment_convex(p, q, convex_ring, strict)
    if hit is None:
        return 0.0
    return (hit[1] - hit[0]) * math.hypot(q[0] - p[0], q[1] - p[1])


# --------------------------------------------------------------------------
# Centroids
# --------------------------------------------------------------------------

def ring_centroid(ring):
    """``(cx, cy, signed_area)`` of a ring (shoelace, shifted to the first
    vertex for precision). A zero-area ring gives the mean of its distinct
    vertices and area 0; an empty ring ``None``."""
    pts = _clip_open(ring)
    if not pts:
        return None
    x0, y0 = pts[0]
    n = len(pts)
    a2 = 0.0
    cx = cy = 0.0
    for i in range(n):
        x1, y1 = pts[i][0] - x0, pts[i][1] - y0
        x2, y2 = pts[(i + 1) % n][0] - x0, pts[(i + 1) % n][1] - y0
        cross = x1 * y2 - x2 * y1
        a2 += cross
        cx += (x1 + x2) * cross
        cy += (y1 + y2) * cross
    if a2 == 0.0:
        return (sum(p[0] for p in pts) / n, sum(p[1] for p in pts) / n, 0.0)
    return (x0 + cx / (3.0 * a2), y0 + cy / (3.0 * a2), a2 / 2.0)


def polygon_centroid(rings):
    """Area-weighted centroid ``(x, y)`` of a polygon (all parts, holes
    subtracted; ring orientation is taken from ``group_rings``, not from
    the sign of each ring). ``None`` for an empty polygon; a polygon of
    zero area gives the mean of its outer-ring vertices."""
    groups = group_rings(rings)
    if not groups:
        return None
    sx = sy = total = 0.0
    for outer, holes in groups:
        for ring, sign in [(outer, 1.0)] + [(h, -1.0) for h in holes]:
            cx, cy, a = ring_centroid(ring)
            w = sign * abs(a)
            sx += cx * w
            sy += cy * w
            total += w
    if total == 0.0:
        pts = [p for outer, _h in groups for p in _clip_open(outer)]
        return (sum(p[0] for p in pts) / len(pts), sum(p[1] for p in pts) / len(pts))
    return (sx / total, sy / total)


# ==========================================================================
# common/anchor.py
# ==========================================================================
# Pole of inaccessibility (label anchor) for polygons, pure Python.
#
# The pole of inaccessibility is the interior point farthest from the polygon
# boundary (holes included); its distance to the boundary is the radius of the
# largest inscribed circle. Implemented from the published description of the
# "polylabel" algorithm (Agafonkin, Mapbox blog, 2016): cover the bounding box
# with square cells, keep them in a priority queue ordered by the best distance
# any point of the cell could reach (centre distance + half diagonal), split the
# most promising cell into four, and stop exploring a cell once it cannot beat
# the best point found by more than ``precision``. No code was copied.
#
# Guarantee: the returned distance is within the *effective* precision of the
# true maximum (up to the cell budget, see ``ANCHOR_MAX_CELLS``). The effective
# precision is ``max(precision, ANCHOR_REL_PRECISION x the larger bbox side)``
# (``effective_precision``), so long strips cannot exhaust the cell budget;
# the first cells are never smaller than that precision, so thin slivers do not
# start with length / width cells either.
# Polygons with many edges measure distances through a ``SegmentGrid`` (same
# results as a full scan, without scanning every edge for every cell). The
# returned point is always inside the polygon when the polygon has an interior.
#
# Multipart polygons (``polygon_anchor``): the pole of the **largest part by
# area** (outer ring minus its holes) is returned; ties keep the first part in
# input order. This is decided once for every feature, so labels of multipart
# features always sit in their main part.

# Safety cap on the number of cells examined (precision far below the polygon
# size would otherwise explode); when reached, the best point so far is
# returned and ``polygon_anchor`` reports ``"capped": True``.
ANCHOR_MAX_CELLS = 200000


# Relative precision floor: the search never works finer than this fraction of
# the polygon's larger bbox side. A long strip (road, canal, river polygon) has a
# plateau of near-equal distances along its medial line; without a floor every
# cell of that plateau would be refined to ``precision`` and the search would
# run into ``ANCHOR_MAX_CELLS``. 1e-4 is 0.1 m on a 1 km polygon.
ANCHOR_REL_PRECISION = 1e-4

# Polygons with more edges than this use ``SegmentGrid`` for distances.
ANCHOR_GRID_MIN_SEGMENTS = 24


def effective_precision(precision, width, height):
    """Precision actually used: ``max(precision, ANCHOR_REL_PRECISION * max(width, height))``."""
    return max(float(precision), ANCHOR_REL_PRECISION * max(width, height))


class SegmentGrid(object):
    """Uniform grid over the segments of closed rings (or open paths).

    * ``nearest_distance(p)``: exact distance to the nearest segment, searched
      ring by ring of grid cells outwards (stops once no farther cell can be
      closer);
    * ``inside(p)``: even-odd ray-casting test using only the segments of the
      point's grid row (same crossing rule as a full scan, so the same answer);
    * ``signed_distance(p)``: positive inside, negative outside, 0 on an edge.

    Building is linear in the number of segments (plus the cells long segments
    cover); each query touches only nearby segments, so testing many points
    against a large polygon is not points x vertices.
    """

    def __init__(self, segments):
        self.segs = [(tuple(a), tuple(b)) for a, b in segments]
        xs = [p[0] for s in self.segs for p in s] or [0.0]
        ys = [p[1] for s in self.segs for p in s] or [0.0]
        self.x0, self.y0 = min(xs), min(ys)
        width, height = max(xs) - self.x0, max(ys) - self.y0
        n = max(len(self.segs), 1)
        size = max(width, height, 1e-300)
        cell = math.sqrt(max(width * height, size * size / n) / n)
        self.cell = max(cell, size / 4096.0, 1e-300)
        self.cols = int(width / self.cell) + 1
        self.rows = int(height / self.cell) + 1
        self.cells = {}
        self.bands = {}
        for idx, (a, b) in enumerate(self.segs):
            c0, c1 = sorted((self._col(a[0]), self._col(b[0])))
            r0, r1 = sorted((self._row(a[1]), self._row(b[1])))
            for r in range(r0, r1 + 1):
                self.bands.setdefault(r, []).append(idx)
                for c in range(c0, c1 + 1):
                    self.cells.setdefault((c, r), []).append(idx)

    def _col(self, x):
        return min(max(int((x - self.x0) / self.cell), 0), self.cols - 1)

    def _row(self, y):
        return min(max(int((y - self.y0) / self.cell), 0), self.rows - 1)

    def inside(self, p):
        x, y = p
        if y < self.y0 or y > self.y0 + self.rows * self.cell:
            return False
        inside = False
        for idx in self.bands.get(self._row(y), ()):
            a, b = self.segs[idx]
            if (a[1] > y) != (b[1] > y):
                if x < a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1]):
                    inside = not inside
        return inside

    def nearest_distance(self, p):
        if not self.segs:
            return float("inf")
        x, y = p
        cx = int(math.floor((x - self.x0) / self.cell))
        cy = int(math.floor((y - self.y0) / self.cell))
        best = float("inf")
        seen = set()
        # Rings that do not reach the grid yet are empty: start at the first one that does.
        start = max(0, cx - (self.cols - 1), -cx, cy - (self.rows - 1), -cy)
        limit = start + max(self.cols, self.rows) + 1
        for r in range(start, limit + 1):
            for gx in range(cx - r, cx + r + 1):
                for gy in ((cy - r, cy + r) if 0 < r else (cy,)):
                    best = self._scan(gx, gy, p, best, seen)
            for gy in range(cy - r + 1, cy + r):
                if r > 0:
                    best = self._scan(cx - r, gy, p, best, seen)
                    best = self._scan(cx + r, gy, p, best, seen)
            # Every segment not yet seen lies in a cell at least r rings away.
            if best <= r * self.cell:
                break
        return best

    def _scan(self, gx, gy, p, best, seen):
        for idx in self.cells.get((gx, gy), ()):
            if idx in seen:
                continue
            seen.add(idx)
            a, b = self.segs[idx]
            d = point_segment_distance(p, a, b)[0]
            if d < best:
                best = d
        return best

    def signed_distance(self, p):
        d = self.nearest_distance(p)
        if d == 0.0:
            return 0.0
        return d if self.inside(p) else -d


def _anchor_segments(rings):
    segs = []
    for ring in rings:
        pts = [tuple(p) for p in ring]
        if len(pts) > 1 and pts[0] != pts[-1]:
            pts.append(pts[0])
        for i in range(len(pts) - 1):
            segs.append((pts[i], pts[i + 1]))
    return segs


def signed_distance_to_rings(p, rings):
    """Distance from ``p`` to the nearest ring edge; positive inside the
    polygon formed by ``rings`` (even-odd rule, so holes count as outside),
    negative outside, 0 on the boundary."""
    segs = _anchor_segments(rings)
    if not segs:
        return float("-inf")
    return _anchor_signed(p, segs)


def _anchor_signed(p, segs):
    x, y = p
    inside = False
    best = float("inf")
    hypot = math.hypot
    for a, b in segs:
        ax, ay = a
        bx, by = b
        if (ay > y) != (by > y):
            x_cross = ax + (y - ay) * (bx - ax) / (by - ay)
            if x < x_cross:
                inside = not inside
        # Same arithmetic as common.geom.point_segment_distance, inlined: this
        # loop runs for every cell of the search (it dominates the run time).
        dx, dy = bx - ax, by - ay
        seg2 = dx * dx + dy * dy
        if seg2 == 0.0:
            d = hypot(ax - x, ay - y)
        else:
            t = ((x - ax) * dx + (y - ay) * dy) / seg2
            if t < 0.0:
                t = 0.0
            elif t > 1.0:
                t = 1.0
            d = hypot(ax + t * dx - x, ay + t * dy - y)
        if d < best:
            best = d
    if best == 0.0:
        return 0.0
    return best if inside else -best


def pole_of_inaccessibility(rings, precision=1.0):
    """``(x, y, distance)`` of the pole of inaccessibility of ``rings``.

    ``rings``: one polygon part (outer ring and its holes; orientation does
    not matter, even-odd rule). ``precision``: absolute tolerance on the
    distance, in coordinate units (must be > 0). Degenerate input (zero
    width or height) returns the bbox centre with distance 0; empty input
    returns ``None``.
    """
    result = _anchor_pole(rings, precision)
    return None if result is None else result[:3]


def pole_with_status(rings, precision=1.0, max_cells=None):
    """``(x, y, distance, capped, error_bound)`` for one polygon part (outer ring and
    its holes): like ``pole_of_inaccessibility`` plus whether the cell budget
    (``max_cells``, default ``ANCHOR_MAX_CELLS``) was reached. ``error_bound`` is an
    upper bound of how far ``distance`` can be below the true maximum: the effective
    precision when the search finished, the largest remaining cell potential minus
    ``distance`` when it was capped. Empty input gives ``(0.0, 0.0, 0.0, False, 0.0)``."""
    result = _anchor_pole(rings, precision, max_cells, True)
    return (0.0, 0.0, 0.0, False, 0.0) if result is None else result


def _anchor_pole(rings, precision, max_cells=None, with_bound=False):
    if not precision or precision <= 0:
        raise ValueError("precision must be positive")
    max_cells = ANCHOR_MAX_CELLS if max_cells is None else int(max_cells)

    def done(x, y, d, capped, bound):
        return (x, y, d, capped, bound) if with_bound else (x, y, d, capped)

    segs = _anchor_segments(rings)
    if not segs:
        return None
    xs = [p[0] for s in segs for p in s]
    ys = [p[1] for s in segs for p in s]
    xmin, ymin, xmax, ymax = min(xs), min(ys), max(xs), max(ys)
    width, height = xmax - xmin, ymax - ymin
    cell = min(width, height)
    if cell == 0.0:
        return done((xmin + xmax) / 2.0, (ymin + ymax) / 2.0, 0.0, False, 0.0)
    if all(ring_signed_area(list(r)) == 0.0 for r in rings):
        # No interior at all (e.g. a ring that runs out and back along a line):
        # nothing to search, and the search for a positive distance would only
        # run into the cell budget.
        return done((xmin + xmax) / 2.0, (ymin + ymax) / 2.0, 0.0, False, 0.0)
    precision = effective_precision(precision, width, height)
    # A tolerance above the larger bbox side says nothing more (no inscribed circle has a
    # radius above half the shorter side), but it made the first cell far larger than the
    # part, with its centre far outside: when the first guesses lie in a hole or notch the
    # search then split such cells with slow distance queries from far away (152 s for a
    # 1.7 m blob with a hole at a precision of 458,000 units).
    precision = min(precision, max(width, height))
    # First cells are never finer than the precision (a 3 km x 1 mm sliver would
    # otherwise start with 3,000,000 cells of side 1 mm, before any budget check),
    # and never so many that they alone use up a quarter of the cell budget.
    cell = max(cell, precision)
    first = math.ceil(width / cell) * math.ceil(height / cell)
    if first > max_cells // 4:
        cell *= math.sqrt(first / float(max(max_cells // 4, 1))) * 1.01
    if len(segs) > ANCHOR_GRID_MIN_SEGMENTS:
        signed = SegmentGrid(segs).signed_distance
    else:
        def signed(q):
            return _anchor_signed(q, segs)
    h = cell / 2.0
    heap = []
    counter = [0]

    def push(cx, cy, half):
        d = signed((cx, cy))
        potential = d + half * math.sqrt(2.0)
        counter[0] += 1
        # max-heap on potential; counter keeps the order deterministic
        heapq.heappush(heap, (-potential, counter[0], cx, cy, half, d))
        return d

    x = xmin
    while x < xmax:
        y = ymin
        while y < ymax:
            push(x + h, y + h, h)
            y += cell
        x += cell

    # Initial guesses: area centroid, then bbox centre.
    best = None
    cen = polygon_centroid([list(r) for r in rings])
    for gx, gy in ([cen] if cen else []) + [((xmin + xmax) / 2.0, (ymin + ymax) / 2.0)]:
        d = signed((gx, gy))
        if best is None or d > best[2]:
            best = (gx, gy, d)

    capped = False
    bound = precision
    # A first guess exactly on an edge gives a distance of float noise (~1e-15), not a
    # point inside: treat a distance this small as "nothing found yet" (comb case).
    on_edge = 1e-9 * max(width, height)
    while heap:
        neg_pot, _n, cx, cy, half, d = heapq.heappop(heap)
        if d > best[2]:
            best = (cx, cy, d)
        if -neg_pot <= 0.0:
            continue  # no point of this cell can be inside the polygon
        # While no interior point has been found (best distance <= 0, e.g. the
        # centroid of a U shape lies in its notch), keep splitting even when the
        # precision is coarser than the inscribed radius: an anchor must be inside.
        if best[2] > on_edge and -neg_pot - best[2] <= precision:
            continue
        if counter[0] >= max_cells:
            capped = True
            bound = max(-neg_pot - best[2], precision)
            break
        half2 = half / 2.0
        for ox, oy in ((-half2, -half2), (half2, -half2), (-half2, half2), (half2, half2)):
            push(cx + ox, cy + oy, half2)
    return done(best[0], best[1], max(best[2], 0.0), capped, bound)


def polygon_anchor(rings, precision=1.0, groups=None):
    """Pole of inaccessibility of a (multipart) polygon in the core representation.

    Returns ``{"point": (x, y), "distance", "part", "parts", "capped"}``:
    the pole of the largest part (index ``part`` in ``group_rings`` order),
    the inscribed-circle radius, the number of parts and whether the cell
    budget was reached. ``None`` for an empty polygon. ``groups``: the
    ``group_rings(rings)`` result when the caller already has it (the rings
    are then not grouped a second time).
    """
    if groups is None:
        groups = group_rings(rings)
    if not groups:
        return None
    best_idx, best_area = 0, None
    for idx, (outer, holes) in enumerate(groups):
        area = abs(ring_signed_area(outer)) - sum(abs(ring_signed_area(h)) for h in holes)
        if best_area is None or area > best_area:
            best_idx, best_area = idx, area
    outer, holes = groups[best_idx]
    x, y, d, capped = _anchor_pole([outer] + list(holes), precision)
    return {"point": (x, y), "distance": d, "part": best_idx, "parts": len(groups),
            "capped": capped}


# ==========================================================================
# common/linegraph.py
# ==========================================================================
# Planar line network from polylines: endpoint nodes, degree, dangles,
# pseudo-nodes, connected components (pure Python).
#
# Input: ``[(key, paths), ...]`` where ``paths`` is a polyline in the core
# representation (list of paths, path = list of ``(x, y)``). Every path (part)
# is one **edge** from its first to its last vertex. Interior vertices are not
# nodes (a line crossing another without a shared endpoint is not connected).
#
# Endpoint clustering (``cluster_points``): endpoints closer than or equal to
# ``tolerance`` are merged with a grid hash (cell = tolerance) and union-find.
# Clustering is **transitive**: if A-B and B-C are within tolerance, A, B and C
# form one node even when A-C is farther apart (a chain of points each within
# tolerance of the next can span more than the tolerance). ``tolerance == 0``
# merges only identical coordinates. The node location is the first member
# point in input order (an actual endpoint, deterministic), not an average.
#
# Degree = number of edge ends at a node; a closed path (both ends in the same
# node) contributes 2. Dangles are nodes of degree 1. Pseudo-nodes are nodes of
# degree 2 where two **different** edges meet (the start of a single closed loop
# is not a pseudo-node); whether they are reportable (equal attributes) is the
# caller's decision.

class DisjointSet(object):
    """Union-find with path halving and union by size; elements are 0..n-1."""

    def __init__(self, n):
        self.parent = list(range(n))
        self.size = [1] * n

    def find(self, i):
        parent = self.parent
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    def union(self, i, j):
        ri, rj = self.find(i), self.find(j)
        if ri == rj:
            return ri
        if self.size[ri] < self.size[rj] or (self.size[ri] == self.size[rj] and rj < ri):
            ri, rj = rj, ri
        self.parent[rj] = ri
        self.size[ri] += self.size[rj]
        return ri


def cluster_points(points, tolerance):
    """Cluster labels for ``points`` (transitive, see module docstring).

    Returns a list of cluster ids, one per point, numbered 0, 1, 2 ... in
    order of first appearance.
    """
    n = len(points)
    ds = DisjointSet(n)
    if tolerance is None or tolerance <= 0:
        first = {}
        for i, p in enumerate(points):
            key = (float(p[0]), float(p[1]))
            if key in first:
                ds.union(first[key], i)
            else:
                first[key] = i
    else:
        if not math.isfinite(tolerance):
            raise ValueError("cluster_points: the tolerance must be a finite number")
        # Cells of half the tolerance: two points in one cell are always within the
        # tolerance (diagonal 0.71 x tolerance), so a cell is one cluster without any
        # distance test; points within the tolerance are at most 2 cells apart. Each
        # pair of neighbouring cells is compared only while they are still separate
        # clusters, with an early exit, so dense data (or a tolerance much larger
        # than the data) no longer costs one distance test per pair of points.
        cell = float(tolerance) / 2.0
        grid = {}
        for i, p in enumerate(points):
            try:
                key = (int(math.floor(p[0] / cell)), int(math.floor(p[1] / cell)))
            except (OverflowError, ZeroDivisionError, ValueError):
                # a tolerance such as 1e-320 (cell 0 or p / cell = inf), or a NaN coordinate
                raise ValueError("cluster_points: the tolerance {0!r} is too small for the "
                                 "coordinates (or a coordinate is not finite)".format(tolerance))
            members = grid.get(key)
            if members is None:
                grid[key] = [i]
            else:
                ds.union(members[0], i)
                members.append(i)
        offsets = [(dx, dy) for dx in range(-2, 3) for dy in range(-2, 3) if (dx, dy) > (0, 0)]
        for (gx, gy), members in grid.items():
            for dx, dy in offsets:
                other = grid.get((gx + dx, gy + dy))
                if other is None or ds.find(members[0]) == ds.find(other[0]):
                    continue
                if _linegraph_any_close(points, members, other, tolerance):
                    ds.union(members[0], other[0])
    labels = []
    seen = {}
    for i in range(n):
        root = ds.find(i)
        if root not in seen:
            seen[root] = len(seen)
        labels.append(seen[root])
    return labels


def _linegraph_any_close(points, a_idx, b_idx, tolerance):
    """True if some point of ``a_idx`` is within ``tolerance`` of some point of ``b_idx``."""
    for i in a_idx:
        p = points[i]
        for j in b_idx:
            if point_distance(points[j], p) <= tolerance:
                return True
    return False


def build_line_graph(lines, tolerance=0.0):
    """Build the endpoint graph of ``lines`` (``[(key, paths), ...]``).

    Returns ``{"nodes": [...], "edges": [...]}``:

    * edge: ``{"id", "key", "part", "from", "to", "length", "closed"}``
      (``from``/``to`` are node ids; ``closed`` when both ends share a node);
    * node: ``{"id", "xy", "degree", "ends", "members"}`` where ``ends`` is
      a list of ``(edge_id, "from"|"to")`` in edge order and ``members`` the
      number of endpoints merged into the node.

    Parts with fewer than 2 vertices and null geometries are skipped.
    """
    edges = []
    points = []
    for key, paths in lines:
        for part_idx, path in enumerate(paths or []):
            if len(path) < 2:
                continue
            edges.append({"id": len(edges), "key": key, "part": part_idx,
                          "length": path_length(path)})
            points.append(tuple(path[0]))
            points.append(tuple(path[-1]))
    labels = cluster_points(points, tolerance)
    nodes = []
    for idx, label in enumerate(labels):
        if label == len(nodes):
            nodes.append({"id": label, "xy": points[idx], "degree": 0, "ends": [], "members": 0})
        nodes[label]["members"] += 1
    for edge in edges:
        f, t = labels[2 * edge["id"]], labels[2 * edge["id"] + 1]
        edge["from"], edge["to"], edge["closed"] = f, t, f == t
        nodes[f]["degree"] += 1
        nodes[f]["ends"].append((edge["id"], "from"))
        nodes[t]["degree"] += 1
        nodes[t]["ends"].append((edge["id"], "to"))
    return {"nodes": nodes, "edges": edges}


def node_degrees(graph):
    """``{node_id: degree}``."""
    return dict((n["id"], n["degree"]) for n in graph["nodes"])


def find_dangles(graph):
    """Nodes of degree 1 (free line ends), in node order."""
    return [n for n in graph["nodes"] if n["degree"] == 1]


def find_pseudo_nodes(graph):
    """Nodes where exactly two different edges meet (degree 2, not the start
    of a single closed loop). Returns ``[(node, edge_a, edge_b), ...]``."""
    edges = graph["edges"]
    out = []
    for n in graph["nodes"]:
        if n["degree"] != 2:
            continue
        (e1, _s1), (e2, _s2) = n["ends"]
        if e1 == e2:
            continue
        out.append((n, edges[e1], edges[e2]))
    return out


def connected_components(graph, join_parts=True):
    """Connected groups of edges.

    With ``join_parts`` (default) all parts of one feature key belong to the
    same component even if they do not touch (a multipart feature is one
    feature). Returns a list of ``{"edges": [ids], "keys": [keys], "nodes":
    [ids]}`` sorted by the smallest edge id; keys keep first-seen order.
    """
    edges = graph["edges"]
    nodes = graph["nodes"]
    ds = DisjointSet(len(nodes))
    first_node_of_key = {}
    for e in edges:
        ds.union(e["from"], e["to"])
        if join_parts:
            if e["key"] in first_node_of_key:
                ds.union(first_node_of_key[e["key"]], e["from"])
            else:
                first_node_of_key[e["key"]] = e["from"]
    groups = {}
    order = []
    for e in edges:
        root = ds.find(e["from"])
        if root not in groups:
            groups[root] = {"edges": [], "keys": [], "key_set": set(), "nodes": set()}
            order.append(root)
        g = groups[root]
        g["edges"].append(e["id"])
        if e["key"] not in g["key_set"]:   # set lookup: O(1), not O(len(keys))
            g["key_set"].add(e["key"])
            g["keys"].append(e["key"])
        g["nodes"].update((e["from"], e["to"]))
    out = []
    for root in order:
        g = groups[root]
        out.append({"edges": g["edges"], "keys": g["keys"], "nodes": sorted(g["nodes"])})
    return out


# ==========================================================================
# common/report.py
# ==========================================================================
# Reports: Excel workbook with Summary + Detail sheets, CSV fallback.
#
# Engineering rule 11: choose a writable report path **before** the main work
# (a workbook open in Excel is locked), write Excel via openpyxl when it is
# available and fall back to two CSV files when it is not.
#
# * ``choose_report_path(requested, inputs)`` -> target dict, raises
#   ``ToolError`` if the location is not writable, a file it would write is
#   one of the tool's inputs, or a file it would write already exists while
#   ``arcpy.env.overwriteOutput`` is off (engineering rule 13; RT7-P-4).
# * ``write_report(target, summary, detail_header, detail_rows)`` -> list of
#   written file paths.
#
# Text fidelity (to be stated on every tool page that offers a report):
#
# * Excel: control characters a cell cannot hold (U+0000-U+0008, U+000B, U+000C,
#   U+000E-U+001F) are written as a visible ``<U+XXXX>``; nothing is dropped
#   silently. Text cells are stored as text, never as formulas.
# * CSV: every character is kept as it is (control characters included); text
#   that a spreadsheet would run as a formula gets a leading apostrophe
#   (``neutralize_formula``).
# * Both: a lone UTF-16 surrogate (U+D800-U+DFFF, half of a pair; it cannot be
#   written as UTF-8) becomes U+FFFD.
#
# Every file is opened through ``_open_for_write`` so tests can simulate a
# locked file without touching the operating system.

REPORT_FORMAT_XLSX = "xlsx"
REPORT_FORMAT_CSV = "csv"

# Rows in one Excel worksheet (.xlsx), header included.
_REPORT_XLSX_MAX_ROWS = 1048576

# Excel rejects these control characters in cell text (XML 1.0: U+0000-U+0008, U+000B, U+000C,
# U+000E-U+001F; tab, line feed and carriage return are allowed). They are written as a visible
# "<U+XXXX>" instead of being dropped, so a value such as "Riyadh" + U+0001 never looks equal to
# "Riyadh" in an Excel report (NearMissVocabularyChecker round-5 review, D2; the same review
# finding exists for NormalisedKeyDiagnostics). Accepted ambiguity: a text that really contains
# "<U+0001>" looks the same; each tool's output table keeps the exact value.
_REPORT_ILLEGAL = dict((c, u"<U+{0:04X}>".format(c))
                       for c in list(range(0, 9)) + [11, 12] + list(range(14, 32)))
# A lone UTF-16 surrogate (half of a pair, U+D800-U+DFFF) cannot be encoded as UTF-8: the xlsx and
# csv writers raise UnicodeEncodeError on it (MojibakeDetector round 5, R5-1). It becomes U+FFFD in
# both formats (merged shared fix, round 6).
_REPORT_LONE_SURROGATES = dict.fromkeys(range(0xD800, 0xE000), u"\ufffd")
_REPORT_ILLEGAL.update(_REPORT_LONE_SURROGATES)


# A plain number such as "-5" or "+1.5e3" is not a formula and is left as is.
_REPORT_PLAIN_NUMBER = re.compile(r"^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$")


def neutralize_formula(value):
    """Text that a spreadsheet would run as a formula, made inert (CSV injection).

    Text starting with ``=``, ``@``, tab or carriage return, or with ``+``/``-``
    followed by something that is not a plain number, gets a leading
    apostrophe, so Excel shows it as text instead of evaluating it (OWASP
    "CSV injection" guidance). Other values are returned unchanged. Used for
    every CSV report cell; the Excel writer stores text cells as text instead.

    This CHANGES the text in the CSV file: ``-Riyadh`` is written as
    ``'-Riyadh`` and ``=1+1`` as ``'=1+1`` (a plain number such as ``-5`` or
    ``+1.5e3`` is kept). Kept on purpose: without it a value could run as a
    formula when the CSV is opened in Excel. Every tool page that offers a CSV
    report should say so; a program that reads the CSV must strip the
    apostrophe.
    """
    if not isinstance(value, str) or not value:
        return value
    first = value[0]
    if first in ("=", "@", "\t", "\r"):
        return "'" + value
    if first in "+-" and len(value) > 1 and not _REPORT_PLAIN_NUMBER.match(value):
        return "'" + value
    return value


def _open_for_write(path, mode, **kwargs):
    """Single place where report files are opened (test hook)."""
    return open(path, mode, **kwargs)


def _report_import_openpyxl():
    """Import openpyxl lazily; ``None`` when it is not installed."""
    try:
        import openpyxl
    except ImportError:
        return None
    return openpyxl


def _report_check_writable(path):
    """Raise ``ToolError`` if ``path`` cannot be written; leaves no new file behind."""
    folder = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(folder):
        raise ToolError("The report folder '{0}' does not exist.".format(folder),
                        "Choose an existing folder for the report.")
    existed = os.path.exists(path)
    try:
        handle = _open_for_write(path, "ab")
        handle.close()
    except (IOError, OSError):
        raise ToolError(
            "The report file '{0}' cannot be written; it is probably open in Excel "
            "or another program, or it is read-only.".format(path),
            "Close the file (or choose a different report name) and run the tool again.")
    if not existed:
        try:
            os.remove(path)
        except OSError:
            pass


def csv_report_paths(path):
    """``(summary_csv, detail_csv)`` for a requested report path."""
    base = os.path.splitext(path)[0]
    return base + "_summary.csv", base + "_detail.csv"


def _report_keys(path):
    """Comparison keys of a path: as given and absolute, plus its dataset identity."""
    text = str(path).strip().strip("'\"")
    keys = set([normalize_catalog_path(text), dataset_identity(text)])
    if text and not text.startswith("\\\\"):
        absolute = os.path.abspath(text)
        keys.update([normalize_catalog_path(absolute), dataset_identity(absolute)])
    keys.discard("")
    return keys


def refuse_report_on_inputs(paths, inputs):
    """Raise ``ToolError`` if a report file would replace (or contain) an input.

    ``paths`` are the files the report will really write (after extension
    normalisation and the CSV fallback names); ``inputs`` are input files,
    datasets or layer texts (anything that is not a path never matches).
    Paths are compared with ``paths.normalize_catalog_path`` and
    ``paths.dataset_identity``; an input inside the report file (e.g. a sheet
    ``book.xlsx\\Sheet1$``) also counts. During a guarded run every input the
    tool registered (``paths.registered_inputs``) is compared as well, and a
    report file named like a table joined to an input layer
    (``paths.registered_joined_tables``) is refused.
    """
    inputs = list(inputs or ()) + registered_inputs()
    refuse_joined_table_outputs(paths, registered_joined_tables())
    for out in paths:
        out_keys = _report_keys(out)
        for value in inputs:
            if not value:
                continue
            in_keys = _report_keys(value)
            inside = any(k.startswith(o + "\\") for k in in_keys for o in out_keys)
            if out_keys & in_keys or inside:
                raise ToolError(
                    "The report file '{0}' would replace the input '{1}'.".format(out, value),
                    "Choose another report name or folder; the tool never overwrites its "
                    "input.")


def _report_overwrite_allowed():
    """``arcpy.env.overwriteOutput`` as a bool (False when it cannot be read)."""
    try:
        return bool(arcpy.env.overwriteOutput)
    except Exception:
        return False


def refuse_existing_report_files(paths, overwrite):
    """Raise ``ToolError`` if a report file exists and overwriting is off.

    Pro's own output check only sees the parameter value; the files really
    written can differ (``book.xls`` -> ``book.xlsx``, ``audit.csv`` ->
    ``audit_summary.csv`` + ``audit_detail.csv``), so every one is checked
    here (engineering rule 13, RT7-P-4).
    """
    if overwrite:
        return
    for path in paths:
        if os.path.exists(path):
            raise ToolError(
                "The report file '{0}' already exists and overwriting outputs is off, so "
                "it was not replaced.".format(path),
                "Choose another report name or folder, or allow geoprocessing tools to "
                "overwrite existing outputs (arcpy.env.overwriteOutput) and run the tool "
                "again.")


def choose_report_path(requested, inputs=(), overwrite=None):
    """Decide the report format and check the target is writable.

    ``requested`` ends in ``.xlsx`` or ``.csv`` (anything else is treated as
    ``.xlsx``). If openpyxl is missing, or ``.csv`` was requested, two CSV
    files ``<name>_summary.csv`` and ``<name>_detail.csv`` are used instead.
    Returns ``{"format", "paths", "note"}``; ``note`` explains a fallback.
    Returns ``None`` when no report was requested. ``inputs`` (input files,
    datasets or parameter texts) are refused as report files, after the
    extension change (``book`` / ``book.xls`` -> ``book.xlsx``) and for both CSV
    fallback files (``refuse_report_on_inputs``). With overwriting off
    (``overwrite``; ``None`` reads ``arcpy.env.overwriteOutput``) an existing
    report file is refused (``refuse_existing_report_files``).
    """
    if not requested:
        return None
    requested = str(requested)
    note = None
    ext = os.path.splitext(requested)[1].casefold()
    if ext != ".csv" and _report_import_openpyxl() is not None:
        if ext != ".xlsx":
            requested = os.path.splitext(requested)[0] + ".xlsx"
        target = {"format": REPORT_FORMAT_XLSX, "paths": [requested], "note": None}
    else:
        if ext != ".csv":
            note = ("openpyxl is not available, so the report is written as two CSV files "
                    "instead of an Excel workbook.")
        target = {"format": REPORT_FORMAT_CSV, "paths": list(csv_report_paths(requested)),
                  "note": note}
    # The name as asked for counts too: 'attr.csv' writes attr_summary.csv, but a
    # report named like a table joined to an input layer is refused either way.
    refuse_joined_table_outputs([requested], registered_joined_tables())
    refuse_report_on_inputs(target["paths"], inputs)
    for path in target["paths"]:
        _report_check_writable(path)
    if overwrite is None:
        overwrite = _report_overwrite_allowed()
    refuse_existing_report_files(target["paths"], overwrite)
    return target


# An Excel cell holds at most 32,767 characters (counted in UTF-16 units). openpyxl writes longer
# text without complaint and Excel then cuts or "repairs" it silently. The cut is made AFTER the
# <U+XXXX> expansion above, so the expansion can never push a cell over the limit, and the cut cell
# ends with a visible marker (NearMissVocabularyChecker R6-D2, BilingualNameQA R6-1).
_REPORT_XLSX_MAX_CELL = 32767
_REPORT_XLSX_CUT_MARKER = u" ...[cut: an Excel cell holds 32,767 characters; choose a .csv report for the full text]"


def _report_utf16_units(text):
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def _report_fit_excel_cell(text):
    """``text`` cut to fit one Excel cell, with a visible marker when cut."""
    if len(text) <= _REPORT_XLSX_MAX_CELL // 2 or _report_utf16_units(text) <= _REPORT_XLSX_MAX_CELL:
        return text
    room = _REPORT_XLSX_MAX_CELL - len(_REPORT_XLSX_CUT_MARKER)
    kept, used = [], 0
    for ch in text:
        size = 2 if ord(ch) > 0xFFFF else 1
        if used + size > room:
            break
        kept.append(ch)
        used += size
    return u"".join(kept) + _REPORT_XLSX_CUT_MARKER


def _report_cell(value):
    """Cell value safe for openpyxl (control characters as ``<U+XXXX>``, see
    ``_REPORT_ILLEGAL``)."""
    if isinstance(value, str):
        return _report_fit_excel_cell(value.translate(_REPORT_ILLEGAL))
    if value is None or isinstance(value, (bool, int, float)):
        return value
    return str(value)


def _report_write_xlsx(path, summary, summary_header, detail_header, detail_rows, openpyxl):
    workbook = openpyxl.Workbook()
    sheets = ((workbook.active, "Summary", summary_header, summary),
              (workbook.create_sheet(), "Detail", detail_header, detail_rows))
    bold = openpyxl.styles.Font(bold=True)
    for sheet, title, header, rows in sheets:
        sheet.title = title
        sheet.append([_report_cell(h) for h in header])
        for cell in sheet[1]:
            cell.font = bold
        widths = [len(str(h)) for h in header]
        # Excel holds at most _REPORT_XLSX_MAX_ROWS rows; openpyxl would write
        # more without complaint and Excel would then drop or "repair" them.
        room = _REPORT_XLSX_MAX_ROWS - 2
        if len(rows) > room + 1:
            dropped = len(rows) - room
            rows = rows[:room] + [["{0} more rows not shown: an Excel sheet holds at most {1} "
                                   "rows. Choose a .csv report path to get every row."
                                   .format(dropped, _REPORT_XLSX_MAX_ROWS)]]
        # Track the row number ourselves: openpyxl's Worksheet.max_row scans
        # every cell written so far, which made long reports quadratic (RT4-A-4).
        row_index = 1
        for row in rows:
            values = [_report_cell(v) for v in row]
            sheet.append(values)
            row_index += 1
            for column, value in enumerate(values, 1):
                if isinstance(value, str):
                    # never let text such as "=x" become a formula
                    sheet.cell(row=row_index, column=column).data_type = "s"
            for i, v in enumerate(values[:len(widths)]):
                widths[i] = max(widths[i], len(str(v)) if v is not None else 0)
        sheet.freeze_panes = "A2"
        for i, width in enumerate(widths):
            sheet.column_dimensions[openpyxl.utils.get_column_letter(i + 1)].width = min(width + 2, 80)
    with _open_for_write(path, "wb") as handle:
        workbook.save(handle)


def _report_csv_text(value):
    """CSV cell text: control characters kept exactly, only lone surrogates become U+FFFD."""
    if isinstance(value, str):
        return value.translate(_REPORT_LONE_SURROGATES)
    return value


def _report_write_csv(path, header, rows):
    # utf-8-sig so Excel shows Arabic and other non-Latin text correctly.
    with _open_for_write(path, "w", newline="", encoding="utf-8-sig") as handle:
        writer = csv.writer(handle)
        writer.writerow([neutralize_formula(_report_csv_text(h)) for h in header])
        for row in rows:
            writer.writerow(["" if v is None else neutralize_formula(_report_csv_text(v)) for v in row])


def write_report(target, summary, detail_header, detail_rows, summary_header=("Item", "Value"), xlsx_builder=None):
    """Write the report chosen by ``choose_report_path``.

    ``summary`` is a list of rows (usually ``(item, value)`` pairs);
    ``detail_rows`` a list of rows matching ``detail_header``.
    ``xlsx_builder`` (optional) is a function ``builder(openpyxl) -> workbook`` that replaces the plain
    two-sheet Excel layout with the tool's own formatted workbook; this module opens the file and saves it
    (same error handling, same ``_open_for_write`` hook). The CSV fallback is unaffected: it always gets
    ``summary`` and ``detail_rows``.
    Returns the list of written paths. Raises ``ToolError`` if a file became
    unwritable after it was checked.
    """
    if target is None:
        return []
    # Inputs read after the report was chosen (lookup tables, vocabularies ...) are
    # registered by then: never replace one of them (quality review D1/D2).
    refuse_report_on_inputs(target["paths"], ())
    summary = [list(r) for r in summary]
    detail_rows = [list(r) for r in detail_rows]
    try:
        if target["format"] == REPORT_FORMAT_XLSX:
            openpyxl = _report_import_openpyxl()
            if xlsx_builder is not None:
                workbook = xlsx_builder(openpyxl)
                with _open_for_write(target["paths"][0], "wb") as handle:
                    workbook.save(handle)
            else:
                _report_write_xlsx(target["paths"][0], summary, list(summary_header),
                                   list(detail_header), detail_rows, openpyxl)
        else:
            _report_write_csv(target["paths"][0], list(summary_header), summary)
            _report_write_csv(target["paths"][1], list(detail_header), detail_rows)
    except (IOError, OSError) as exc:
        raise ToolError("The report could not be written: {0}".format(exc),
                        "Close the report file if it is open and run the tool again.")
    return list(target["paths"])


def choose_output_file(requested, extension, inputs=(), overwrite=None):
    """Check the target of a single output file (an HTML page, a PNG ...) before the work.

    ``extension`` is the wanted one with its dot (``".html"``): a path without extension gets
    it, a path with another extension has it replaced. Refused (``ToolError``): a folder that
    does not exist, a file that is one of ``inputs`` (or a registered input of the run), a
    file that cannot be opened for writing (open in a program, read-only), and an existing
    file while overwriting is off. Returns the path to write, or ``None`` when nothing was
    requested.
    """
    if not requested or not str(requested).strip():
        return None
    path = str(requested).strip()
    if os.path.splitext(path)[1].casefold() != extension.casefold():
        path = os.path.splitext(path)[0] + extension
    refuse_joined_table_outputs([path], registered_joined_tables())
    refuse_report_on_inputs([path], inputs)
    _report_check_writable(path)
    if overwrite is None:
        overwrite = _report_overwrite_allowed()
    refuse_existing_report_files([path], overwrite)
    return path


def write_text_file(path, text, encoding="utf-8"):
    """Write ``text`` to ``path`` (UTF-8, ``\\n`` line ends) through the same open hook as the
    reports. Raises ``ToolError`` when the file cannot be written."""
    refuse_report_on_inputs([path], ())
    try:
        with _open_for_write(path, "w", encoding=encoding, newline="\n") as handle:
            handle.write(text)
    except (IOError, OSError) as exc:
        raise ToolError("The file '{0}' could not be written: {1}".format(path, exc),
                        "Close the file if it is open and run the tool again.")
    return path


# ==========================================================================
# common/params.py
# ==========================================================================
# Consistent construction and reading of ``arcpy.Parameter`` objects.

def make_param(name, label, datatype, direction="Input", required=True, multi_value=False,
               default=None, value_list=None, category=None, depends_on=None, enabled=True,
               filter_type=None):
    """Create an ``arcpy.Parameter``.

    ``required`` may be True (``"Required"``), False (``"Optional"``) or the
    string ``"Derived"``. ``value_list`` fills ``filter.list`` (a value list
    for strings/numbers, field types for ``Field``, extensions for ``DEFile``);
    ``filter_type`` sets ``filter.type`` (e.g. ``"Range"``) before the list.
    ``depends_on`` is a parameter name or list of names.
    """
    if required == "Derived":
        parameter_type = "Derived"
        direction = "Output"
    else:
        parameter_type = "Required" if required else "Optional"
    param = arcpy.Parameter(
        name=name,
        displayName=label,
        direction=direction,
        datatype=datatype,
        parameterType=parameter_type,
        enabled=enabled,
        category=category,
        multiValue=multi_value)
    if filter_type is not None:
        param.filter.type = filter_type
    if value_list is not None:
        param.filter.list = list(value_list)
    if depends_on:
        param.parameterDependencies = [depends_on] if isinstance(depends_on, str) else list(depends_on)
    if default is not None:
        param.value = default
    return param


def derived_output(name, label, datatype):
    """Derived output parameter (set with ``arcpy.SetParameterAsText``)."""
    return make_param(name, label, datatype, required="Derived")


def param_map(parameters):
    """``{name: parameter}`` for a parameter list."""
    return dict((p.name, p) for p in parameters)


def param_index(parameters, name):
    """Index of the parameter called ``name``."""
    for i, p in enumerate(parameters):
        if p.name == name:
            return i
    raise KeyError(name)


def param_text(param):
    """``valueAsText`` or ``None`` when empty."""
    text = param.valueAsText
    if text is None or text == "":
        return None
    return text


def param_bool(param, default=False):
    """Boolean value of a ``GPBoolean`` parameter."""
    value = param.value
    if value is None:
        return default
    if isinstance(value, str):
        return value.strip().casefold() in ("true", "1", "yes")
    return bool(value)


def param_number(param, default=None):
    """Numeric value (float) of a parameter, or ``default`` when empty."""
    value = param.value
    if value is None or value == "":
        return default
    return float(value)


def split_multivalue(text):
    """Values of a multivalue parameter given as geoprocessing text, quote-aware.

    Values are separated by ``;``. A value that starts with a single or double quote runs to the
    matching closing quote that is followed by ``;`` or the end of the text, so a folder named
    ``inv;2026`` written as ``'C:\\data\\inv;2026'`` stays one value; inside quotes the quote character
    written twice is one literal quote. A quote that is never closed counts as part of a plain
    value (the old behaviour: split on ``;``, quotes stripped)."""
    if not text:
        return []
    text = str(text)
    values = []
    n, i = len(text), 0
    while i < n:
        while i < n and text[i] in " \t":
            i += 1
        if i >= n:
            break
        if text[i] in "'\"":
            quote, j, buf, closed = text[i], i + 1, [], False
            while j < n:
                ch = text[j]
                if ch == quote:
                    if j + 1 < n and text[j + 1] == quote:
                        buf.append(quote)
                        j += 2
                        continue
                    k = j + 1
                    while k < n and text[k] in " \t":
                        k += 1
                    if k >= n or text[k] == ";":
                        closed = True
                        j = k
                        break
                buf.append(ch)
                j += 1
            if closed:
                value = "".join(buf).strip()
                if value:
                    values.append(value)
                i = j + 1
                continue
        end = text.find(";", i)
        if end < 0:
            end = n
        value = text[i:end].strip().strip("'\"")
        if value:
            values.append(value)
        i = end + 1
    return values


def param_list(param):
    """Values of a multivalue parameter as a list of strings (quote-aware, ``split_multivalue``)."""
    return split_multivalue(param_text(param))


def parse_value_table_text(text):
    """Rows of a value table given as geoprocessing text.

    Rows are separated by ``;`` and cells by spaces; a cell containing spaces
    is wrapped in single quotes (or double quotes, for example around a path that holds an
    apostrophe) and an empty cell is written ``#``
    (e.g. ``"NAME ASC;'Lot No' DESC"``). Inside quotes the quote character written twice is
    one literal quote. Returns a list of lists of strings,
    with ``None`` for empty cells. Separators inside quotes are kept.
    """
    if text is None:
        return []
    rows, row, cell = [], [], []
    quote = None
    in_cell = False

    def end_cell():
        value = "".join(cell)
        row.append(None if (value == "#" or value == "") else value)
        del cell[:]

    chars = str(text)
    n = 0
    while n < len(chars):
        ch = chars[n]
        n += 1
        if quote:
            if ch == quote:
                if n < len(chars) and chars[n] == quote:
                    cell.append(ch)
                    n += 1
                else:
                    quote = None
            else:
                cell.append(ch)
            continue
        if ch in ("'", '"') and not cell:
            quote = ch
            in_cell = True
        elif ch == " ":
            if in_cell:
                end_cell()
                in_cell = False
        elif ch == ";":
            if in_cell:
                end_cell()
                in_cell = False
            if row:
                rows.append(list(row))
            del row[:]
        else:
            cell.append(ch)
            in_cell = True
    if in_cell:
        end_cell()
    if row:
        rows.append(list(row))
    return rows


def _params_vt_cell(cell):
    """Plain Python value of one value-table cell (``None`` when empty)."""
    if cell is None:
        return None
    if isinstance(cell, str):
        text = cell.strip()
        return None if text in ("", "#") else text
    if isinstance(cell, (bool, int, float)):
        return cell
    name = getattr(cell, "name", None)  # e.g. a Field object in a Field column
    if isinstance(name, str):
        return name
    return str(cell)


def param_value_table(param, columns=None):
    """Rows of a ``GPValueTable`` parameter as lists of plain values.

    Uses ``Parameter.values`` (a list of lists); rows given as text (for
    example when a script passes a string) are parsed with
    ``parse_value_table_text``. Empty cells (``#``, ``''``, empty text, or empty in
    ``valueAsText``: ArcGIS Pro returns an empty number cell as 0) become ``None``; rows whose
    cells are all empty are dropped. ``columns`` pads/cuts each row to that
    many cells.
    """
    raw = param.values
    if not raw:
        return []
    parsed_rows = []
    for item in raw:
        if isinstance(item, str):
            parsed_rows.extend(parse_value_table_text(item))
        elif isinstance(item, (list, tuple)):
            parsed_rows.append(list(item))
        else:
            parsed_rows.append([item])
    # ArcGIS Pro returns an empty numeric cell as 0 in ``values`` while the text shows
    # ``#`` (Pro session 1): a cell that is empty in ``valueAsText`` is empty (None).
    try:
        text_rows = parse_value_table_text(param.valueAsText)
    except Exception:  # an unreadable text never hides the values
        text_rows = []
    if len(text_rows) != len(parsed_rows):
        text_rows = []
    rows = []
    for k, row in enumerate(parsed_rows):
        values = [_params_vt_cell(c) for c in row]
        if text_rows:
            text = text_rows[k]
            values = [None if (i < len(text) and text[i] is None) or i >= len(text) else v
                      for i, v in enumerate(values)]
        if columns is not None:
            values = (values + [None] * columns)[:columns]
        if any(v is not None for v in values):
            rows.append(values)
    return rows


def input_texts(parameters):
    """Every value of the tool's Input parameters as text (multivalues split).

    ``parameters`` is the parameter list or a ``param_map`` dict. Used to
    refuse a report file that would replace an input
    (``report.choose_report_path(requested, inputs=input_texts(...))``).
    """
    params = parameters.values() if isinstance(parameters, dict) else parameters
    out = []
    for param in params:
        if param.direction != "Input":
            continue
        text = param_text(param)
        if text:
            out.extend(split_multivalue(text))
    return out


# ==========================================================================
# common/arcio.py
# ==========================================================================
# The only common module that touches arcpy: reading, writing, editing.
#
# Every arcpy name used here is listed in ARCHITECTURE.md and must be in the
# API audit. Geometry crosses the arcpy boundary as Esri JSON only:
# ``SHAPE@JSON`` + ``json.loads`` on read, ``arcpy.AsShape(esri_json, True)`` on
# write (decision D-003). Rows are plain dicts::
#
#     {"oid": 12, "shape": <core geometry or None>, "attrs": {"NAME": "A", ...}}

LAYER_DATA_TYPES = ("FeatureLayer", "TableView", "Layer")
GEOMETRY_KEYWORDS = {"point": "POINT", "multipoint": "MULTIPOINT",
                     "polyline": "POLYLINE", "polygon": "POLYGON"}
SHAPEFILE_MAX_TEXT = 254

# Curves are densified with Geometry.densify("ANGLE", distance, deviation):
# distance = geometry extent diagonal / _ARCIO_CURVE_DIVISIONS, deviation in radians.
_ARCIO_CURVE_DIVISIONS = 50.0
_ARCIO_CURVE_DEVIATION = math.radians(1.0)

# Depth of open edit sessions; deletes are refused while > 0 (ERROR 000496).
_ARCIO_EDIT_STATE = {"depth": 0}


# --------------------------------------------------------------------------
# ObjectID output fields (SRC_OID, REMOVED_BY, SITE_OID, ...)
# --------------------------------------------------------------------------

# ArcGIS Pro 3.2 and later can have 64-bit ObjectIDs, which a LONG field refuses on insert.
OID_LONG_MIN, OID_LONG_MAX = -2 ** 31, 2 ** 31 - 1
# REPORTED (ArcGIS Pro 3.3.2, job_410 BilingualNameQA section 5): inserting 2^53 + 1 into a
# BIGINTEGER field of a file geodatabase was refused with "Big integer values are currently
# limited to 53 bits."; the "ArcGIS field data types" page gives -(2^53 - 1) to 2^53 - 1.
OID_BIG_MAX = 2 ** 53 - 1
# REPORTED (job_410): a DOUBLE field of a dBASE table stored 1099511627783 (2^40 + 7) as
# 1099511627780.0 and kept 3000000001; job_403 stored 25030864197623.8 as 25030864197600.0.
# Both keep 12 significant digits, so a folder output takes a DOUBLE only while every ObjectID has
# at most 12 significant digits.
OID_DBF_DOUBLE_DIGITS = 12
# TEXT width for ObjectIDs in a folder output: a signed 64-bit integer has at most 19 digits + sign.
OID_TEXT_LENGTH = 20


def _arcio_oid_values(oids):
    return [int(o) for o in oids if o is not None and not isinstance(o, bool)]


def oid_significant_digits(value):
    """Significant decimal digits of the whole number ``value`` (0 has 1; trailing zeros do not
    count: 3000000000 has 1)."""
    text = str(abs(int(value))).rstrip("0")
    return max(1, len(text))


def oid_field_type(oids, workspace_is_folder):
    """``(AddField keyword, text length or None)`` for a field that holds the ObjectIDs ``oids``.

    * LONG while every id fits 32 bits (any workspace);
    * a geodatabase (or GeoPackage / memory) output: BIGINTEGER; an id beyond 2^53 - 1 in size
      raises ``ToolError`` (ArcGIS Pro refuses it: "Big integer values are currently limited to
      53 bits");
    * a folder (shapefile / dBASE) output: DOUBLE while every id has at most 12 significant digits
      (and is at most 2^53 - 1 in size), else TEXT of ``OID_TEXT_LENGTH`` characters (or the
      longest id) with every digit kept."""
    values = _arcio_oid_values(oids)
    if all(OID_LONG_MIN <= v <= OID_LONG_MAX for v in values):
        return "LONG", None
    if not workspace_is_folder:
        big = [v for v in values if abs(v) > OID_BIG_MAX]
        if big:
            worst = max(big, key=abs)
            raise ToolError(
                "ObjectID {0} is larger than 2^53 - 1 (9,007,199,254,740,991), the largest whole "
                "number a Big Integer field holds in ArcGIS Pro (\"Big integer values are "
                "currently limited to 53 bits\"), so the output cannot store it.".format(worst),
                "Write the output to a folder (shapefile or dBASE table), where such ObjectIDs are "
                "written as text with every digit kept, or copy the input to a new feature class "
                "or table (its ObjectIDs start at 1) and run the tool on the copy.")
        return "BIGINTEGER", None
    if all(abs(v) <= OID_BIG_MAX and oid_significant_digits(v) <= OID_DBF_DOUBLE_DIGITS
           for v in values):
        return "DOUBLE", None
    return "TEXT", max([OID_TEXT_LENGTH] + [len(str(v)) for v in values])


def oid_field_spec(oids, workspace_is_folder, name="SRC_OID", alias=None, label=None):
    """``(field spec, info message or None)`` for an ObjectID output field (``oid_field_type``).

    The message (None for LONG) says which type the field got and, for TEXT, why. ``label`` names
    the field in the message (default ``name``). Raises ``ToolError`` as ``oid_field_type``."""
    keyword, length = oid_field_type(oids, workspace_is_folder)
    spec = {"name": name, "type": keyword}
    if length:
        spec["length"] = length
    if alias:
        spec["alias"] = alias
    label = label or name
    if keyword == "LONG":
        return spec, None
    text = "Some ObjectIDs do not fit 32 bits (64-bit ObjectIDs); {0} is written as {1}.".format(
        label, keyword)
    if keyword == "TEXT":
        values = _arcio_oid_values(oids)
        many = sum(1 for v in values if abs(v) > OID_BIG_MAX
                   or oid_significant_digits(v) > OID_DBF_DOUBLE_DIGITS)
        text += (" A Double field in a shapefile or dBASE table keeps only {0} significant digits "
                 "and {1} ObjectID(s) have more, so the field is text ({2} characters) with every "
                 "digit kept.".format(OID_DBF_DOUBLE_DIGITS, many, length))
    return spec, text


def oid_output_field(out_path, oids, collector=None, name="SRC_OID", alias=None, label=None):
    """``oid_field_spec`` for a field of the output ``out_path`` (a folder output or not is read
    from the path); the message goes to ``collector.info``. Returns the field spec."""
    spec, note = oid_field_spec(oids, is_folder_workspace(workspace_of(out_path)), name=name,
                                alias=alias, label=label)
    if note and collector is not None:
        collector.info(note)
    return spec


def oid_field_value(spec, oid):
    """``oid`` as written to the field ``spec`` of ``oid_field_spec``: its digits for TEXT."""
    if oid is None or isinstance(oid, bool) or spec.get("type") != "TEXT":
        return oid
    return str(int(oid))


# --------------------------------------------------------------------------
# Describe
# --------------------------------------------------------------------------

def sr_info(sr):
    """Plain dict for a ``SpatialReference`` (``None`` stays ``None``).

    ``"polar_stereographic"``: 1 / -1 when a projected system is polar
    stereographic about the North / South Pole (``polar_stereographic_sign``), else
    ``None``."""
    if sr is None:
        return None
    sr_type = sr.type
    projected = sr_type == "Projected"
    return {"wkid": sr.factoryCode or None, "name": sr.name, "type": sr_type,
            "meters_per_unit": sr.metersPerUnit if projected else None,
            "polar_stereographic": polar_stereographic_sign(sr) if projected else None}


# (factoryCode, name) -> result of polar_stereographic_sign; systems with a WKID only.
_ARCIO_POLAR_CACHE = {}


def polar_stereographic_sign(sr):
    """1 / -1 when the projected system ``sr`` is polar stereographic about the North
    / South Pole, else ``None`` (RT8-C-3: any polar stereographic system, not a WKID
    list). The probe points of ``projection.polar_probe_points`` are projected into
    ``sr`` one by one (``arcpy.AsShape`` in WGS 84, ``Geometry.projectAs``) and tested
    with ``projection.is_polar_stereographic_probe``. A point that cannot be projected
    makes the system "not polar stereographic"."""
    key = (sr.factoryCode, sr.name) if sr.factoryCode else None
    if key is not None and key in _ARCIO_POLAR_CACHE:
        return _ARCIO_POLAR_CACHE[key]
    found = None
    for sign in (1, -1):
        projected = []
        for lon, lat in polar_probe_points(sign):
            try:
                shape = arcpy.AsShape({"x": lon, "y": lat, "spatialReference": {"wkid": 4326}},
                                      True).projectAs(sr)
                data = json.loads(shape.JSON)
                projected.append((float(data["x"]), float(data["y"])))
            except Exception:  # outside the system's domain: not this pole's projection
                projected.append(None)
        if is_polar_stereographic_probe(projected):
            found = sign
            break
    if key is not None:
        _ARCIO_POLAR_CACHE[key] = found
    return found


def field_info(field):
    """Plain dict for an ``arcpy.Field``."""
    return {"name": field.name, "alias": field.aliasName, "type": field.type,
            "length": field.length, "domain": field.domain or None,
            "nullable": field.isNullable, "editable": field.editable,
            "required": field.required}


def describe_dataset(path):
    """Describe a feature class, table or layer.

    Returns ``{"input", "catalog_path", "workspace", "name", "data_type",
    "is_layer", "shape_type", "sr", "sr_object", "oid_field", "fields", "has_z",
    "has_m"}`` (``has_z`` / ``has_m``: the dataset stores Z / M values; ``False`` when the
    describe result does not say).
    For a layer, ``catalog_path`` is the layer's data source, so output/input
    comparisons use the real dataset, while cursors still use ``input`` (so
    selections and definition queries are honoured).
    """
    if not path or not arcpy.Exists(path):
        raise ToolError("The input '{0}' does not exist.".format(path),
                        "Check the path or layer name, or browse to the dataset.")
    desc = arcpy.da.Describe(path)
    catalog = desc["catalogPath"]
    register_inputs([path, catalog])  # every described dataset is an input of the run
    fields = [field_info(f) for f in desc["fields"]]
    register_joined_tables(joined_table_names(fields))  # ... and so is every joined table
    sr = desc["spatialReference"] if "spatialReference" in desc else None
    return {
        "input": path,
        "catalog_path": catalog,
        "workspace": workspace_of(catalog),
        "name": split_catalog_path(catalog)[1],
        "data_type": desc["dataType"],
        "is_layer": desc["dataType"] in LAYER_DATA_TYPES,
        "shape_type": desc["shapeType"] if "shapeType" in desc else None,
        "sr": sr_info(sr),
        "sr_object": sr,
        "oid_field": desc["OIDFieldName"] if ("hasOID" in desc and desc["hasOID"]) else None,
        "fields": fields,
        "has_z": bool(desc["hasZ"]) if "hasZ" in desc else False,
        "has_m": bool(desc["hasM"]) if "hasM" in desc else False,
    }


# --------------------------------------------------------------------------
# Read
# --------------------------------------------------------------------------

def _arcio_densify_curve(shape):
    """Esri JSON dict of a curved geometry after densification."""
    ext = shape.extent
    diag = math.hypot(ext.width, ext.height) or 1.0
    dense = shape.densify("ANGLE", diag / _ARCIO_CURVE_DIVISIONS, _ARCIO_CURVE_DEVIATION)
    data = json.loads(dense.JSON)
    if esri_json_has_curves(data):
        raise ToolError("A true-curve geometry could not be densified.",
                        "Run the Densify tool on the input first, then rerun this tool.")
    return data


def read_features(path, fields=(), sr=None, where=None, geometry=True):
    """Read rows as dicts ``{"oid", "shape", "attrs"}``.

    ``path`` may be a layer (selection and definition query honoured).
    ``sr`` (an ``arcpy.SpatialReference``) projects geometry at read time so
    source ObjectIDs are kept. True curves (``curvePaths``/``curveRings``) are
    re-read with ``SHAPE@`` and densified (decision D-005). Z and M are dropped.
    """
    register_inputs([path])
    fields = list(fields)
    tokens = ["OID@"] + (["SHAPE@JSON"] if geometry else []) + fields
    first = 2 if geometry else 1
    rows, curved = [], {}
    with arcpy.da.SearchCursor(path, tokens, where_clause=where, spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None,
                   "attrs": dict(zip(fields, values[first:]))}
            if geometry and values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    curved[values[0]] = row
                else:
                    row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    if curved:
        with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@"], where_clause=where,
                                   spatial_reference=sr) as cursor:
            for oid, shape in cursor:
                if oid in curved and shape is not None:
                    curved[oid]["shape"] = esri_json_to_core(_arcio_densify_curve(shape))[1]
    return rows


def read_features_skip_curves(path, fields=(), sr=None, where=None, zm=None):
    """Like ``read_features`` but true-curve features are skipped, not densified.

    Returns ``(rows, skipped_oids)``. Tools that report individual vertices or
    segments use this: densified arcs would create artificial vertices.
    Skipped features are not in ``rows``.

    ``zm``: optional dict; when given, ``zm["z"]`` / ``zm["m"]`` are set to the lists of
    ObjectIDs of the features that carry Z / M values (which the core geometry drops).
    """
    register_inputs([path])
    fields = list(fields)
    rows, skipped = [], []
    with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@JSON"] + fields, where_clause=where,
                               spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "attrs": dict(zip(fields, values[2:]))}
            if values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    skipped.append(values[0])
                    continue
                if zm is not None:
                    has_z, has_m = esri_json_zm(data)
                    if has_z:
                        zm.setdefault("z", []).append(values[0])
                    if has_m:
                        zm.setdefault("m", []).append(values[0])
                row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    return rows, skipped


def iter_features(path, fields=(), sr=None, where=None, geometry=True):
    """Like ``read_features`` but a generator: one row at a time, nothing kept in memory.

    Yields ``{"oid", "shape", "attrs", "curved"}``. A true-curve feature is NOT densified
    here: ``shape`` is ``None`` and ``curved`` is True (callers that only draw an outline
    count and skip it). Without ``geometry`` the cursor has no shape token (tables).
    """
    register_inputs([path])
    fields = list(fields)
    tokens = ["OID@"] + (["SHAPE@JSON"] if geometry else []) + fields
    first = 2 if geometry else 1
    with arcpy.da.SearchCursor(path, tokens, where_clause=where, spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "curved": False,
                   "attrs": dict(zip(fields, values[first:]))}
            if geometry and values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    row["curved"] = True
                else:
                    row["shape"] = esri_json_to_core(data)[1]
            yield row


def count_rows(path, where=None):
    """Number of rows of a table, feature class or layer (a layer's selection and definition
    query are honoured). Counted with a cursor on the ObjectID, nothing is kept."""
    register_inputs([path])
    total = 0
    with arcpy.da.SearchCursor(path, ["OID@"], where_clause=where) as cursor:
        for _row in cursor:
            total += 1
    return total


# Straight segments of a geographic (or other non-metric) input are straight in
# THAT system; projecting only their vertices bends them (about 0.02 m off at the
# middle of a 1.5 km segment, 2 m at 15 km). Lines are therefore densified in
# their own system every ~ARCIO_DENSIFY_STEP_M before they are projected.
ARCIO_DENSIFY_STEP_M = 100.0
_ARCIO_METRES_PER_DEGREE = 111320.0


def densify_step_for(desc, decision):
    """Densify distance in the input's own units before reprojecting it, or
    ``None`` when the input is used as is (no projection, nothing bends)."""
    if not decision.get("reproject"):
        return None
    info = desc["sr"] or {}
    if info.get("type") == "Geographic":
        return ARCIO_DENSIFY_STEP_M / _ARCIO_METRES_PER_DEGREE
    mpu = info.get("meters_per_unit")
    if mpu:
        return ARCIO_DENSIFY_STEP_M / float(mpu)
    return None


def read_features_densified(path, fields=(), sr=None, step=None, skip_curves=False,
                            where=None, geographic=False):
    """Read lines/polygons projected to ``sr`` after densifying them in their own
    system, so the projected geometry follows the straight segments of the
    source system. Each segment is densified on its own in pure Python
    (``geom.densify_path_segments``), the result is rebuilt with
    ``arcpy.AsShape`` in the source system and projected with
    ``Geometry.projectAs``. Without a source WKID, ``Geometry.densify``
    ("DISTANCE") is used instead.

    Without ``sr`` or ``step`` this is ``read_features`` (or
    ``read_features_skip_curves`` with ``skip_curves``). True curves are
    skipped (``skip_curves``) or densified by angle first (D-005). Returns
    ``(rows, skipped_oids)``. Adds vertices: use only for measuring and
    snapping, never where the vertices themselves are the result.

    ``geographic``: the input is in a geographic system. A segment spanning
    more than 180 degrees of longitude is taken to cross the antimeridian the
    short way and is densified across it (only that segment is affected).
    """
    register_inputs([path])
    fields = list(fields)
    if sr is None or not step:
        if skip_curves:
            return read_features_skip_curves(path, fields, sr=sr, where=where)
        return read_features(path, fields, sr=sr, where=where), []
    rows, skipped = [], []
    with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@"] + fields, where_clause=where) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "attrs": dict(zip(fields, values[2:]))}
            shape = values[1]
            if shape is not None:
                if shape.hasCurves:
                    if skip_curves:
                        skipped.append(values[0])
                        continue
                    ext = shape.extent
                    diag = math.hypot(ext.width, ext.height) or 1.0
                    shape = shape.densify("ANGLE", diag / _ARCIO_CURVE_DIVISIONS,
                                          _ARCIO_CURVE_DEVIATION)
                source = json.loads(shape.JSON)
                kind, core = esri_json_to_core(source)
                own = shape.spatialReference
                wkid = own.factoryCode if own is not None else None
                if core is None:
                    rows.append(row)
                    continue
                if wkid:
                    dense = [densify_path_segments(part, step, geographic) for part in core]
                    shape = arcpy.AsShape(core_to_esri_json(kind, dense, wkid), True)
                    shape = shape.projectAs(sr)
                else:
                    shape = shape.densify("DISTANCE", step).projectAs(sr)
                data = json.loads(shape.JSON)
                if esri_json_has_curves(data):
                    raise ToolError("A true-curve geometry could not be densified.",
                                    "Run the Densify tool on the input first, then rerun "
                                    "this tool.")
                row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    return rows, skipped


def _arcio_coords(node, out):
    """Collect ``(x, y)`` pairs from any nested Esri JSON coordinate list."""
    if isinstance(node, (list, tuple)):
        if len(node) >= 2 and all(isinstance(v, (int, float)) for v in node[:2]):
            out.append((float(node[0]), float(node[1])))
        else:
            for item in node:
                _arcio_coords(item, out)
    elif isinstance(node, dict):
        for value in node.values():
            _arcio_coords(value, out)


def sample_lonlat(path, where=None, max_samples=5000):
    """Up to ``max_samples`` vertices of the input in WGS 84 degrees."""
    register_inputs([path])
    samples = []
    wgs84 = arcpy.SpatialReference(4326)
    with arcpy.da.SearchCursor(path, ["SHAPE@JSON"], where_clause=where,
                               spatial_reference=wgs84) as cursor:
        for (text,) in cursor:
            if not text:
                continue
            data = json.loads(text)
            if "x" in data:
                if data.get("x") is not None and data.get("y") is not None:
                    samples.append((float(data["x"]), float(data["y"])))
                continue
            data.pop("spatialReference", None)
            _arcio_coords(data, samples)
            if len(samples) > 2 * max_samples:
                samples = samples[::2]
    if len(samples) > max_samples:
        samples = samples[::int(math.ceil(len(samples) / float(max_samples)))]
    return samples


def metric_sr_for(desc, where=None):
    """Choose the measuring coordinate system for a described dataset.

    Returns ``(decision, spatial_reference)``; ``spatial_reference`` is
    ``None`` when the input system is kept (no projection needed). See
    ``projection.choose_metric_sr`` for ``decision``.
    """
    info = desc["sr"]
    try:
        decision = choose_metric_sr(info, None)  # enough when the input system is kept
    except ToolError:
        decision = choose_metric_sr(info, sample_lonlat(desc["input"], where))
    if not decision["reproject"]:
        return decision, None
    return decision, arcpy.SpatialReference(decision["wkid"])


def metric_sr_or_native(desc, where=None):
    """Like ``metric_sr_for``, but an input without any usable coordinates
    (empty, or only null geometries) in a geographic or Web Mercator system
    keeps its own system instead of failing: there is nothing to measure.

    The decision then has ``"empty": True`` and ``meters_per_unit`` 1.0.
    """
    try:
        return metric_sr_for(desc, where)
    except ToolError:
        info = desc["sr"] or {}
        return {"wkid": info.get("wkid"), "meters_per_unit": 1.0, "reproject": False,
                "reason": "The input has no features with coordinates, so nothing is "
                          "measured.", "warnings": [], "empty": True}, None


def read_domains(workspace):
    """``{name: domain dict}`` for all domains of a workspace (see ``domains``).

    The workspace is registered as an input of the run (a domain source)."""
    register_inputs([workspace])
    try:
        return _arcio_list_domains(workspace)
    except (RuntimeError, ValueError, OSError, arcpy.ExecuteError) as exc:
        # ListDomains is documented for geodatabases only; a GeoPackage, a missing or locked
        # geodatabase would otherwise end as a bare Python traceback.
        raise ToolError("The attribute domains of '{0}' could not be read: {1}".format(
            workspace, str(exc).strip() or type(exc).__name__),
            "Attribute domains exist only in geodatabases. Use a file, mobile or enterprise "
            "geodatabase, and check that it is not locked by another application.")


def _arcio_list_domains(workspace):
    result = {}
    if is_folder_workspace(workspace):
        return result
    for dom in arcpy.da.ListDomains(workspace):
        coded = dom.domainType == "CodedValue"
        result[dom.name] = {
            "name": dom.name,
            "domain_type": dom.domainType,
            "field_type": dom.type,
            "codes": dict(dom.codedValues or {}) if coded else {},
            "range": None if coded else tuple(dom.range),
            "description": dom.description,
        }
    return result


def read_output_domains(out_path):
    """Domains of the workspace an output path will be written to (its
    geodatabase, also when the output is in a feature dataset), for
    ``domains.keep_field_domain``. ``{}`` for a folder, or when they cannot be
    listed (e.g. ``memory``, or a location that does not exist yet)."""
    try:
        return _arcio_list_domains(workspace_of(out_path)) or {}
    except Exception:
        return {}


def read_subtypes(path):
    """Subtype structure (see ``domains``); ``{"field": "", "subtypes": {}}`` if none.

    Pass a catalog path (``describe_dataset(...)["catalog_path"]``). Shapefiles
    and other folder datasets have no subtypes and are not queried.
    """
    register_inputs([path])
    empty = {"field": "", "subtypes": {}}
    workspace = workspace_of(path)
    if workspace and (is_folder_workspace(workspace) or workspace.casefold().endswith(".gpkg")):
        return empty  # shapefiles, dBASE tables and GeoPackage tables have no subtypes
    raw = arcpy.da.ListSubtypes(path)
    field = ""
    subtypes = {}
    for code, info in raw.items():
        field = info["SubtypeField"] or field
        domains, defaults = {}, {}
        for name, values in info["FieldValues"].items():
            defaults[name] = values[0]
            domains[name] = values[1].name if values[1] is not None else None
        subtypes[code] = {"name": info["Name"], "default": info["Default"],
                          "domains": domains, "defaults": defaults}
    if not field:
        return empty
    return {"field": field, "subtypes": subtypes}


# Datatype keywords documented for arcpy.da.Walk (walk.html, API audit).
WALK_DATATYPES = ("Any", "CadDrawing", "FeatureClass", "FeatureDataset", "GeometricNetwork",
                  "LasDataset", "Layer", "Locator", "Map", "MosaicDataset", "NetworkDataset",
                  "ParcelDataset", "RasterCatalog", "RasterDataset", "RelationshipClass",
                  "RepresentationClass", "Table", "Terrain", "Tin", "Tool", "Topology",
                  "UtilityNetwork")


def walk_workspace(root, datatypes=("FeatureClass", "Table"), recursive=True):
    """List datasets under a folder or workspace with ``arcpy.da.Walk``.

    Walk is called once per datatype keyword (decided before the loop), so
    every item carries the keyword it was found with; ``type=`` is never
    passed (its effect on tables is undocumented, audit gotcha 41). Folders
    and connection files are not followed (``followlinks=False``).

    Returns ``{"items": [...], "errors": [...]}``: items are
    ``{"path", "name", "dirpath", "data_type"}`` sorted by normalised path,
    without duplicates (first datatype wins); errors are
    ``{"path", "message", "datatype"}`` (the Walk keyword that raised it) for every folder Walk could not read (its
    ``onerror`` callback) or a Walk that stopped with an exception. Errors
    never stop the listing.

    ``recursive=False`` (added for the project toolbox; the default keeps the
    old behaviour): sub-folders of a folder root are not entered, but
    geodatabases directly inside it are listed in full (a geodatabase is a
    workspace of the folder, not a sub-folder). Pruning edits ``dirnames`` in
    place on a top-down walk, so skipped folders are never read.
    """
    bad = [d for d in datatypes if d not in WALK_DATATYPES]
    if bad or not datatypes:
        raise ValueError("unknown Walk datatype(s): {0}".format(", ".join(map(str, bad)) or "none"))
    if not root or not (os.path.isdir(str(root)) or arcpy.Exists(root)):
        raise ToolError("The workspace or folder '{0}' does not exist.".format(root),
                        "Browse to an existing folder or geodatabase.")
    errors = []
    current = [None]            # the datatype keyword of the Walk that is running

    def on_error(err):
        errors.append({"path": getattr(err, "filename", None) or "", "message": str(err),
                       "datatype": current[0]})

    items = {}
    for datatype in datatypes:
        current[0] = datatype
        try:
            for dirpath, dirnames, filenames in arcpy.da.Walk(
                    root, topdown=True, onerror=on_error, followlinks=False, datatype=datatype):
                if not recursive and is_folder_workspace(workspace_of(dirpath) or dirpath):
                    if normalize_catalog_path(dirpath) != normalize_catalog_path(root):
                        dirnames[:] = []
                        continue
                    dirnames[:] = [d for d in dirnames if not is_folder_workspace(d)]
                for name in filenames:
                    path = os.path.join(dirpath, name)
                    key = normalize_catalog_path(path)
                    if key not in items:
                        items[key] = {"path": path, "name": name, "dirpath": dirpath,
                                      "data_type": datatype}
        except (RuntimeError, OSError) as exc:
            errors.append({"path": str(root), "message": "{0} ({1})".format(exc, datatype),
                           "datatype": datatype})
    listed = [items[k] for k in sorted(items)]
    register_inputs([i["path"] for i in listed])
    return {"items": listed, "errors": errors}


# --------------------------------------------------------------------------
# Create and write
# --------------------------------------------------------------------------

def overwrite_output():
    """Value of ``arcpy.env.overwriteOutput`` as a bool."""
    return bool(arcpy.env.overwriteOutput)


def _arcio_existing_outputs(out_path):
    """Existing datasets an output would replace: the path itself and, for a
    folder output without extension, the ``.shp`` / ``.dbf`` Pro would write
    (``paths.folder_dataset_candidates``)."""
    return [p for p in folder_dataset_candidates(out_path) if arcpy.Exists(p)]


def check_output_path(out_path, inputs=()):
    """Every check ``create_table``/``create_feature_class`` make, without side effects.

    Refuses an output equal to an input, a missing output location, an
    existing output when overwriting is off, and an invalid name. Tools that
    edit their input call it for all outputs **before** the backup and the
    edit session (rule 6), so a bad output can never stop the run after the
    input was changed.
    """
    refuse_if_same([out_path], inputs)
    workspace, name = split_catalog_path(out_path)
    if not workspace or not arcpy.Exists(workspace):
        raise ToolError("The output location '{0}' does not exist.".format(workspace),
                        "Choose an existing geodatabase or folder for the output.")
    if _arcio_existing_outputs(out_path) and not overwrite_output():
        raise ToolError("The output '{0}' already exists.".format(out_path),
                        "Choose a new name, or allow geoprocessing tools to overwrite "
                        "existing datasets (Options > Geoprocessing).")
    base = name
    if is_folder_workspace(workspace) and name.casefold().endswith((".shp", ".dbf")):
        base = name[:-4]
    valid = arcpy.ValidateTableName(base, validation_workspace(workspace))
    if valid != base:
        raise ToolError("The output name '{0}' is not valid in '{1}'.".format(name, workspace),
                        "Use a name such as '{0}' (letters, digits and underscores).".format(valid))


def _arcio_prepare_output(out_path, inputs):
    """Checks shared by feature class and table creation; returns ``(ws, name)``."""
    refuse_if_same([out_path], inputs)
    workspace, name = split_catalog_path(out_path)
    if not workspace or not arcpy.Exists(workspace):
        raise ToolError("The output location '{0}' does not exist.".format(workspace),
                        "Choose an existing geodatabase or folder for the output.")
    existing = _arcio_existing_outputs(out_path)
    if existing:
        if not overwrite_output():
            raise ToolError("The output '{0}' already exists.".format(out_path),
                            "Choose a new name, or allow geoprocessing tools to overwrite "
                            "existing datasets (Options > Geoprocessing).")
        for path in existing:
            safe_delete(path, inputs)
    base = name
    if is_folder_workspace(workspace) and name.casefold().endswith((".shp", ".dbf")):
        base = name[:-4]
    valid = arcpy.ValidateTableName(base, validation_workspace(workspace))
    if valid != base:
        raise ToolError("The output name '{0}' is not valid in '{1}'.".format(name, workspace),
                        "Use a name such as '{0}' (letters, digits and underscores).".format(valid))
    return workspace, name


def validation_workspace(workspace):
    """Workspace to pass to ``ValidateTableName`` / ``ValidateFieldName`` for an
    output container: a feature dataset is validated against its geodatabase
    (the Validate functions document file system and geodatabase workspaces);
    a folder or geodatabase is returned unchanged."""
    if workspace and not is_folder_workspace(workspace):
        return workspace_of(workspace) or workspace
    return workspace


def _arcio_folder_name(workspace, name, ext):
    """``name`` with ``ext`` (``.shp`` / ``.dbf``) added in a folder workspace when it has no
    extension: Pro takes an extension-less table name in a folder for an INFO table
    (ERROR 000734 with a space in the path; Pro session 1, S3)."""
    if is_folder_workspace(workspace) and "." not in name:
        return name + ext
    return name


def _arcio_output_path(workspace, name):
    return workspace + "\\" + _arcio_folder_name(workspace, name, ".shp")


# A shapefile/dBASE field name holds at most 10 BYTES in UTF-8, not 10 characters (REPORTED: Pro
# job_403, ThiessenPolygonsConvex log: Arabic names of 12 and 15 letters were stored as 5 letters,
# 10 bytes; one of 4 letters, 8 bytes, was kept whole).
DBF_FIELD_NAME_BYTES = 10


def dbf_field_name_bytes(name):
    """Bytes a shapefile/dBASE field name takes (UTF-8; a character above U+FFFF as 6, like
    ``_arcio_dbf_bytes``)."""
    return _arcio_dbf_bytes(name)


def cut_dbf_field_name(name, limit=DBF_FIELD_NAME_BYTES):
    """``name`` cut at a character boundary to at most ``limit`` bytes (see
    ``dbf_field_name_bytes``): what a dBASE workspace keeps of a field name."""
    kept, used = [], 0
    for ch in str(name):
        size = _arcio_dbf_bytes(ch)
        if used + size > limit:
            break
        kept.append(ch)
        used += size
    return "".join(kept)


_ARCIO_SYSTEM_FIELDS = ("OBJECTID", "FID", "OID", "SHAPE", "SHAPE_LENGTH", "SHAPE_AREA")


def unique_field_specs(out_path, field_specs, fixed=0, reserved=()):
    """Make the output names of ``field_specs`` unique in the output workspace.

    The first ``fixed`` specs (the tool's own fields) keep their names; any
    later spec whose validated name clashes (shapefile/dBASE names are cut to
    10 BYTES in UTF-8, so ROAD_NAME_EN and ROAD_NAME_AR both become ROAD_NAME_,
    and an Arabic name keeps at most 5 letters) is renamed the way Copy Features
    does: shortened and given ``_1``, ``_2``, ... Names of system fields (ObjectID, Shape, ... and ``Id`` in a
    folder) and ``reserved`` names are avoided too. Nothing is created.

    Returns ``(specs, renamed)``: copies of the specs with ``name`` set to the
    final output name (the original name is kept as ``alias`` when no alias
    was given) and a list of ``(original, new)`` pairs.
    """
    workspace = validation_workspace(split_catalog_path(out_path)[0])
    folder = is_folder_workspace(workspace)
    taken = set(n.casefold() for n in _ARCIO_SYSTEM_FIELDS)
    taken.update(str(r).casefold() for r in reserved)
    if folder:
        taken.add("id")
    # A new name must not be the (validated) name of a LATER spec either: with input fields ORIG_X
    # and ORIG_X_1 and ORIG_X reserved, ORIG_X must become ORIG_X_2, not ORIG_X_1 (which would then
    # hold another field's data while the real ORIG_X_1 moved to ORIG_X_1_1). Review R8 F2.
    names_ahead = set(arcpy.ValidateFieldName(sp["name"], workspace).casefold()
                      for sp in field_specs[fixed:])
    out, renamed = [], []
    for k, spec in enumerate(field_specs):
        spec = dict(spec)
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        if k >= fixed and actual.casefold() in taken:
            limit = DBF_FIELD_NAME_BYTES if folder else max(len(actual), 1) + 4
            number = 1
            while True:
                suffix = "_{0}".format(number)
                if folder:
                    # dBASE names are cut to 10 BYTES (UTF-8), not characters (REPORTED: Pro
                    # job_403, Thiessen: an Arabic name kept 5 letters = 10 bytes).
                    base = cut_dbf_field_name(actual, limit - len(suffix))
                else:
                    base = actual[:limit - len(suffix)]
                candidate = arcpy.ValidateFieldName(base + suffix, workspace)
                # A workspace that cuts names by bytes (ArcGIS Pro shapefiles: an Arabic letter
                # takes 2 of the 10 bytes) drops the suffix; shorten the base until it survives,
                # so each number costs a few calls instead of ~10,000 per collision (review R5 O1).
                while base and not candidate.endswith(suffix):
                    base = base[:-1]
                    candidate = arcpy.ValidateFieldName(base + suffix, workspace)
                if candidate.casefold() not in taken and candidate.casefold() not in names_ahead:
                    break
                number += 1
            renamed.append((spec["name"], candidate))
            if not spec.get("alias"):
                spec["alias"] = spec["name"]
            actual = candidate
        taken.add(actual.casefold())
        spec["name"] = actual
        out.append(spec)
    return out, renamed


def _arcio_dbf_bytes(value):
    """Bytes a dBASE text field needs for ``value`` as Pro writes it (UTF-8; characters above U+FFFF as 6)."""
    text = str(value)
    # "surrogatepass": a lone UTF-16 surrogate (U+D800-U+DFFF) counts its 3 bytes instead of
    # raising UnicodeEncodeError (round-6 shared finding; Mojibake/Bilingual inputs can hold one).
    return len(text.encode("utf-8", "surrogatepass")) + 2 * sum(1 for ch in text if ord(ch) > 0xFFFF)


def cut_utf8_bytes(text, folder, counter, marker=""):
    """``text`` as a dBASE/shapefile text field can hold it: at most 254 bytes as Pro writes them
    (UTF-8, an Arabic letter takes 2; characters above U+FFFF count 6, see ``_arcio_dbf_bytes``;
    REPORTED by ArcGIS Pro job_222 for dBASE tables). Longer text is cut at a character boundary
    by the same rule, so a cut value can never make ``_arcio_text_length`` refuse it, and counted
    in ``counter[0]``; outside a folder nothing is cut. ``marker`` (e.g. ``" ...[cut]"``, ASCII)
    is appended to a cut value, and the cut leaves room for it."""
    if not folder or not isinstance(text, str):
        return text
    if _arcio_dbf_bytes(text) <= SHAPEFILE_MAX_TEXT:
        return text
    counter[0] += 1
    limit = SHAPEFILE_MAX_TEXT - _arcio_dbf_bytes(marker)
    kept, used = [], 0
    for ch in text:
        size = _arcio_dbf_bytes(ch)
        if used + size > limit:
            break
        kept.append(ch)
        used += size
    return "".join(kept) + marker


def _arcio_utf16_units(value):
    """Length of ``value`` in UTF-16 code units: a character above U+FFFF counts 2. A file
    geodatabase text field counts its width this way (REPORTED: Pro job_403, MojibakeDetector:
    a DETAIL value as long as the field in characters, with 5 characters above U+FFFF, was
    refused with "Field length exceeded")."""
    text = str(value)
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def _arcio_text_length(spec, actual, folder):
    """Width of the TEXT field ``spec`` (output name ``actual``).

    ``length`` if given, else the longest of ``values``. In a folder
    (shapefile/dBASE, at most 254 characters) a ``length`` that is too wide
    but comes with the ``values`` to be written (e.g. a carried field with
    Pro's default length 255) is narrowed to 254 when every value fits, as
    Copy Features does (rule 8: the values decide). Raises ``ToolError``
    only when a value, or a fixed width without values, really needs more.
    """
    values = spec.get("values")
    length = spec.get("length") or text_field_length(values or ())
    if not folder and not spec.get("length") and values:
        # geodatabase / GeoPackage: the width in UTF-16 units (job_403), never narrower than before
        length = max([length] + [_arcio_utf16_units(v) for v in values if v is not None])
    if folder and values is not None:
        # A dBASE text field written by ArcGIS Pro (UTF-8 code page) holds at most 254 BYTES, not
        # characters (REPORTED: Pro job_251, Thiessen; job_222, another tool): an Arabic letter
        # needs 2. A 97-character name of 130 bytes in a 120-wide field lost its last 10 bytes
        # without any message. The width is raised to the widest value in bytes (capped at 254).
        # Characters above U+FFFF (mathematical letters, emoji) are written by Pro as two 3-byte
        # surrogates (CESU-8: 6 bytes, not 4; CONFIRMED in the bytes of a Pro job 274 dBASE file),
        # so they count 6.
        widest_bytes = max([_arcio_dbf_bytes(v) for v in values if v is not None] or [0])
        if widest_bytes > SHAPEFILE_MAX_TEXT:
            raise ToolError(
                "Field '{0}' holds a value of {1} characters ({2} bytes in UTF-8 as ArcGIS Pro writes them, where a "
                "character above U+FFFF such as an emoji takes 6); shapefiles and dBASE tables allow "
                "{3} bytes.".format(actual, text_field_length(values), widest_bytes,
                                    SHAPEFILE_MAX_TEXT),
                "Write the output to a file geodatabase instead of a folder.")
        return min(max(length, widest_bytes), SHAPEFILE_MAX_TEXT)
    if not folder or length <= SHAPEFILE_MAX_TEXT:
        return length
    if values is not None and spec.get("length"):
        longest = text_field_length(values)
        if longest <= SHAPEFILE_MAX_TEXT:
            return SHAPEFILE_MAX_TEXT
        raise ToolError(
            "Field '{0}' holds a value of {1} characters; shapefiles and dBASE tables allow {2}.".format(
                actual, longest, SHAPEFILE_MAX_TEXT),
            "Write the output to a file geodatabase instead of a folder.")
    raise ToolError(
        "Field '{0}' needs {1} characters; shapefiles and dBASE tables allow {2}.".format(
            actual, length, SHAPEFILE_MAX_TEXT),
        "Write the output to a file geodatabase instead of a folder.")


def plan_field_names(field_specs, workspace, reserved=()):
    """Valid output names for ``field_specs`` without creating anything.

    Returns ``{requested name: actual name}`` (``arcpy.ValidateFieldName``).
    Raises ``ToolError`` when two fields would get the same name, when a name
    equals one of ``reserved`` (e.g. the ObjectID field the new table gets),
    or when a shapefile/dBASE text field would be wider than 254 characters.
    Call it before the output is created so a bad schema never leaves a
    half-built output behind.
    """
    mapping = {}
    used = {}
    taken = set(str(r).casefold() for r in reserved)
    folder = is_folder_workspace(workspace)
    workspace = validation_workspace(workspace)
    for spec in field_specs:
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        key = actual.casefold()
        if key in used:
            raise ToolError("The output fields '{0}' and '{1}' would both be called '{2}'.".format(
                used[key], spec["name"], actual),
                "Give one of them another name{0}.".format(
                    " (dBASE/shapefile field names are cut to 10 bytes in UTF-8)" if folder else ""))
        if key in taken:
            raise ToolError("The output field '{0}' would be called '{1}', a name the new output "
                            "already uses.".format(spec["name"], actual),
                            "Give that field another name.")
        used[key] = spec["name"]
        if folder and spec["type"] == "TEXT":
            _arcio_text_length(spec, actual, folder)
        mapping[spec["name"]] = actual
    return mapping


def plan_output_fields(out_path, field_specs, fixed=0, reserved=()):
    """``unique_field_specs`` then ``plan_field_names`` for one output, before
    anything is created. Returns ``(specs, renamed)`` (see ``unique_field_specs``);
    raises ``ToolError`` for problems renaming cannot solve (e.g. a text field
    wider than a shapefile allows)."""
    specs, renamed = unique_field_specs(out_path, field_specs, fixed, reserved)
    plan_field_names(specs, split_catalog_path(out_path)[0])
    return specs, renamed


def add_fields(table, field_specs, workspace):
    """Add fields; return ``{requested name: actual name}``.

    ``field_specs``: dicts with ``name``, ``type`` (AddField keyword: TEXT,
    SHORT, LONG, DOUBLE, ...), optional ``alias``, ``length``, ``values`` and
    ``domain`` (a domain of the output workspace; AddField ignores unknown ones).
    A TEXT field without ``length`` gets the width of its longest value.
    """
    mapping = {}
    used = set()
    folder = is_folder_workspace(workspace)
    workspace = validation_workspace(workspace)
    for spec in field_specs:
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        if actual.casefold() in used:
            raise ToolError("Two output fields would both be called '{0}'.".format(actual),
                            "Rename one of them (shapefile field names are cut to 10 bytes in UTF-8).")
        used.add(actual.casefold())
        length = None
        if spec["type"] == "TEXT":
            length = _arcio_text_length(spec, actual, folder)
        arcpy.management.AddField(table, actual, spec["type"], field_length=length,
                                  field_alias=spec.get("alias") or None,
                                  field_domain=spec.get("domain") or None)
        mapping[spec["name"]] = actual
    return mapping


def create_feature_class(out_path, kind, sr, field_specs, inputs=(), has_z=False, has_m=False):
    """Create an output feature class; return ``(catalog path, field mapping)``.

    ``has_z`` / ``has_m``: create the output with Z / M values (``has_z="ENABLED"`` of
    Create Feature Class); the call is the same as before when both are False."""
    workspace, name = _arcio_prepare_output(out_path, inputs)
    options = {}
    if has_z:
        options["has_z"] = "ENABLED"
    if has_m:
        options["has_m"] = "ENABLED"
    result = arcpy.management.CreateFeatureclass(
        workspace, _arcio_folder_name(workspace, name, ".shp"),
        geometry_type=GEOMETRY_KEYWORDS[kind], spatial_reference=sr, **options)
    path = _arcio_created_path(result, workspace, _arcio_output_path(workspace, name))
    return path, _arcio_fields_or_delete(path, field_specs, workspace, inputs)


def create_table(out_path, field_specs, inputs=()):
    """Create an output table; return ``(catalog path, field mapping)``."""
    workspace, name = _arcio_prepare_output(out_path, inputs)
    name = _arcio_folder_name(workspace, name, ".dbf")
    result = arcpy.management.CreateTable(workspace, name)
    path = _arcio_created_path(result, workspace, workspace + "\\" + name)
    return path, _arcio_fields_or_delete(path, field_specs, workspace, inputs)


def _arcio_created_path(result, workspace, fallback):
    """Path of a dataset that Create Table / Create Feature Class just made.

    GeoPackage datasets are listed as ``<file>.gpkg\\main.<name>``, so for a GeoPackage the
    path the tool reports is used when it exists; everywhere else (and when the tool
    reports nothing usable) ``fallback`` (``workspace\\name``) is used, as before."""
    if not str(workspace).casefold().endswith(".gpkg"):
        return fallback
    try:
        reported = result.getOutput(0)
    except Exception:  # a result without a readable output keeps the old behaviour
        return fallback
    if isinstance(reported, str) and reported.strip() and arcpy.Exists(reported):
        return reported
    return fallback


def _arcio_fields_or_delete(path, field_specs, workspace, inputs):
    """``add_fields`` on a just-created output; if it fails, the empty output
    is deleted (never leave a half-built output behind) and the error raised."""
    try:
        return add_fields(path, field_specs, workspace)
    except Exception:
        try:
            safe_delete(path, inputs)
        except Exception:
            pass
        raise


def copy_for_output(in_path, out_path, field_specs, inputs=()):
    """Copy a layer/feature class (CopyFeatures) or table view (CopyRows) and add fields.

    ``in_path`` may be a layer: its selection and definition query are
    honoured. Feature inputs keep their geometry; tables are copied with
    CopyRows. The fields are added **outside** any edit session (schema
    changes inside one fail with ERROR 000496). ObjectIDs of the copy are
    new, so callers must match copied rows by attribute values, not by OID.
    Returns ``(catalog path, field mapping)``.
    """
    workspace, name = _arcio_prepare_output(out_path, inputs)
    desc = arcpy.da.Describe(in_path)
    is_features = "shapeType" in desc
    if is_features:
        path = _arcio_output_path(workspace, name)
        arcpy.management.CopyFeatures(in_path, path)
    else:
        path = workspace + "\\" + _arcio_folder_name(workspace, name, ".dbf")
        arcpy.management.CopyRows(in_path, path)
    return path, add_fields(path, field_specs, workspace)


def copy_features(in_path, out_path, inputs=()):
    """Copy features to a new output with ``arcpy.management.CopyFeatures``.

    Same output checks as ``create_feature_class`` (refuse input = output,
    respect ``overwriteOutput``, valid name). A layer input copies only its
    selected / definition-query features. Returns the output catalog path.
    Call it outside any edit session (it creates a dataset).
    """
    workspace, name = _arcio_prepare_output(out_path, inputs)
    path = _arcio_output_path(workspace, name)
    arcpy.management.CopyFeatures(in_path, path)
    return path


# Value written instead of None to a shapefile / dBASE field, by Describe field type.
# ArcGIS Pro refuses None there ("RuntimeError: The field is not nullable. [VALUE]",
# Pro session 1, S3); dates and other types are left as they are.
_ARCIO_FOLDER_DEFAULTS = {"SmallInteger": 0, "Integer": 0, "BigInteger": 0, "Single": 0.0,
                          "Double": 0.0, "String": ""}


def _arcio_folder_defaults(path, field_names):
    """``{index: default}`` for the fields of a folder output that cannot hold None."""
    if not is_folder_workspace(workspace_of(path)):
        return {}
    types = dict((f.name.casefold(), f.type) for f in arcpy.da.Describe(path)["fields"])
    out = {}
    for i, name in enumerate(field_names):
        default = _ARCIO_FOLDER_DEFAULTS.get(types.get(str(name).casefold()))
        if default is not None:
            out[i] = default
    return out


def insert_rows(path, field_names, rows, kind=None, wkid=None, null_fields=None):
    """Insert rows; return the number inserted.

    With ``kind`` each row is ``(core geometry, values)``; without it, ``values``. The
    geometry may also be an Esri JSON dict (passed to ``arcpy.AsShape`` as it is, so Z
    and M in it are kept).
    ``null_fields``: optional set; the names of ``field_names`` that received
    at least one ``None`` are added to it (see ``folder_null_number_warning``).
    In a folder output (shapefile / dBASE) a ``None`` number is written as 0 and
    a ``None`` text as ``""`` (the type default; ArcGIS Pro refuses None there),
    and the field is still added to ``null_fields`` so the tool warns once
    naming it.
    """
    field_names = list(field_names)
    tokens = (["SHAPE@"] if kind else []) + field_names
    defaults = _arcio_folder_defaults(path, field_names)
    count = 0
    with arcpy.da.InsertCursor(path, tokens) as cursor:
        for row in rows:
            if kind:
                geom, values = row
            else:
                geom, values = None, row
            values = list(values)
            if null_fields is not None:
                for name, value in zip(field_names, values):
                    if value is None:
                        null_fields.add(name)
            for i, default in defaults.items():
                if i < len(values) and values[i] is None:
                    values[i] = default
            if kind:
                data = geom if isinstance(geom, dict) else core_to_esri_json(kind, geom, wkid)
                shape = arcpy.AsShape(data, True) if data is not None else None
                cursor.insertRow([shape] + values)
            else:
                cursor.insertRow(values)
            count += 1
    return count


def insert_shaped_rows(path, field_names, rows, null_fields=None):
    """Insert rows whose geometry is an ``arcpy.Geometry`` taken from another dataset.

    Each row is ``(geometry or None, values)``; the geometry is written as it is (a
    true curve stays a curve), so the output must be a feature class of the same
    geometry type and coordinate system. ``null_fields`` and the handling of empty
    numbers in a shapefile / dBASE output are the same as in ``insert_rows``.
    Returns the number of rows inserted.
    """
    field_names = list(field_names)
    defaults = _arcio_folder_defaults(path, field_names)
    count = 0
    with arcpy.da.InsertCursor(path, ["SHAPE@"] + field_names) as cursor:
        for geom, values in rows:
            values = list(values)
            if null_fields is not None:
                for name, value in zip(field_names, values):
                    if value is None:
                        null_fields.add(name)
            for i, default in defaults.items():
                if i < len(values) and values[i] is None:
                    values[i] = default
            cursor.insertRow([geom] + values)
            count += 1
    return count


_ARCIO_NUMBER_TYPES = ("SHORT", "LONG", "BIGINTEGER", "FLOAT", "DOUBLE")


def folder_null_number_warning(path, field_specs, mapping, null_fields, note=""):
    """Warning text, or ``None``, for empty numbers written to a folder output.

    A shapefile or dBASE table cannot store an empty (null) number: Add Field
    documents that nulls are only supported in a geodatabase and that zeros
    are inserted for numeric fields. ``field_specs`` are the specs the output
    was created with, ``mapping`` their ``{name: actual name}`` and
    ``null_fields`` the actual names ``insert_rows`` saw ``None`` in.
    ``note`` (optional) is added to say what the 0 means for those fields.
    """
    if not null_fields or not is_folder_workspace(workspace_of(path)):
        return None
    names, texts = [], []
    for spec in field_specs:
        actual = mapping.get(spec["name"], spec["name"])
        if str(spec.get("type", "")).upper() in _ARCIO_NUMBER_TYPES and actual in null_fields:
            names.append(actual)
        elif str(spec.get("type", "")).upper() == "TEXT" and actual in null_fields:
            texts.append(actual)
    if not names and not texts:
        return None
    parts = []
    if names:
        parts.append("Field(s) {0} of '{1}' have empty values, but a shapefile or dBASE table "
                     "cannot store an empty number: they are stored as 0, so 0 there can also "
                     "mean 'empty'.".format(", ".join(names), path))
    if texts:
        parts.append("Field(s) {0} of '{1}' have empty values, stored as empty text (a "
                     "shapefile or dBASE table cannot store an empty value).".format(
                         ", ".join(texts), path))
    text = " ".join(parts)
    if note:
        text += " " + note.strip()
    return text + (" Write the output to a file geodatabase to keep empty values empty.")


def update_rows(path, field_names, changes, where=None, null_fields=None):
    """Apply ``{oid: {field: value}}``; only rows whose values change are written.

    Returns the number of rows updated. Call inside ``edit_session``.
    ``null_fields``: optional set; the names of ``field_names`` that are set to
    ``None`` in at least one row are added to it (see
    ``folder_null_number_warning``).
    """
    field_names = list(field_names)
    count = 0
    with arcpy.da.UpdateCursor(path, ["OID@"] + field_names, where_clause=where) as cursor:
        for row in cursor:
            change = changes.get(row[0])
            if not change:
                continue
            new = list(row)
            for i, name in enumerate(field_names):
                if name in change:
                    new[i + 1] = change[name]
                    if null_fields is not None and change[name] is None:
                        null_fields.add(name)
            if new != list(row):
                cursor.updateRow(new)
                count += 1
    return count


# --------------------------------------------------------------------------
# Delete, backup, edit session
# --------------------------------------------------------------------------

def safe_delete(path, inputs=()):
    """Delete ``path`` unless it is an input or an edit session is open."""
    if _ARCIO_EDIT_STATE["depth"] > 0:
        raise ToolError("Refusing to delete '{0}' while an edit session is open.".format(path),
                        "This is a bug in the tool: deletes must happen before or after editing.")
    refuse_if_same([path], inputs)
    if arcpy.Exists(path):
        arcpy.management.Delete(path)


def _arcio_name_keys(path):
    """Comparison keys of a path with and without a .shp/.dbf extension."""
    key = normalize_catalog_path(path)
    keys = set([key])
    if key.endswith((".shp", ".dbf")):
        keys.add(key[:-4])
    return keys


def backup_copy(path, avoid=()):
    """Copy ``path`` to ``<name>_backupN`` next to it; return the copy's path.

    ``N`` is the first number whose name neither exists nor is one of the
    paths in ``avoid`` (pass the run's output paths, so an output can never
    replace the backup). Raises ``ToolError`` if the copy fails, so callers
    stop before editing.
    """
    taken = set()
    for other in avoid:
        if other:
            taken |= _arcio_name_keys(other)
    workspace, name = split_catalog_path(path)
    stem, ext = name, ""
    if is_folder_workspace(workspace) and "." in name:
        stem, ext = name.rsplit(".", 1)
        ext = "." + ext
    number = 1
    while True:
        candidate = "{0}\\{1}_backup{2}{3}".format(workspace, stem, number, ext)
        if not arcpy.Exists(candidate) and not (_arcio_name_keys(candidate) & taken):
            break
        number += 1
    try:
        arcpy.management.Copy(path, candidate)
    except (arcpy.ExecuteError, RuntimeError, OSError) as exc:
        raise ToolError("The backup copy of '{0}' failed, so nothing was edited: {1}".format(
            path, exc), "Check free disk space and write permission, then run the tool again.")
    if not arcpy.Exists(candidate):
        raise ToolError("The backup copy '{0}' was not created, so nothing was edited.".format(
            candidate), "Check write permission on the workspace, then run the tool again.")
    return candidate


@contextlib.contextmanager
def edit_session(workspace):
    """One ``arcpy.da.Editor`` session with one operation; rollback on failure.

    On success the operation is stopped and edits saved; on any exception the
    operation is aborted, the session stopped without saving, and the
    exception re-raised. Deletes are refused while the session is open.
    """
    editor = arcpy.da.Editor(workspace)
    editor.startEditing(False, True)
    _ARCIO_EDIT_STATE["depth"] += 1
    try:
        editor.startOperation()
    except BaseException:
        _ARCIO_EDIT_STATE["depth"] -= 1
        editor.stopEditing(False)
        raise
    try:
        yield editor
    except BaseException:
        try:
            editor.abortOperation()
        finally:
            _ARCIO_EDIT_STATE["depth"] -= 1
            editor.stopEditing(False)
        raise
    committed = False
    try:
        editor.stopOperation()
        editor.stopEditing(True)
        committed = True
    finally:
        _ARCIO_EDIT_STATE["depth"] -= 1
        if not committed and editor.isEditing:
            try:
                editor.abortOperation()
            finally:
                editor.stopEditing(False)


# --------------------------------------------------------------------------
# Messages, progress, outputs, environment
# --------------------------------------------------------------------------

def flush_messages(collector):
    """Send a ``MessageCollector``'s messages to ArcGIS Pro and clear it."""
    for level, text in collector.items:
        if level == MESSAGE_ERROR:
            arcpy.AddError(text)
        elif level == MESSAGE_WARNING:
            arcpy.AddWarning(text)
        else:
            arcpy.AddMessage(text)
    collector.clear()


class Progress(object):
    """Step progressor that updates at most ~100 times."""

    def __init__(self, label, total):
        self.total = max(int(total), 0)
        self.step = max(1, self.total // 100)
        self.count = 0
        self._shown = 0
        if self.total > 0:
            arcpy.SetProgressor("step", label, 0, self.total, self.step)
        else:
            arcpy.SetProgressor("default", label)

    def tick(self, amount=1):
        self.count += amount
        if self.total and (self.count - self._shown >= self.step or self.count >= self.total):
            self._shown = self.count
            arcpy.SetProgressorPosition(min(self.count, self.total))

    def label(self, text):
        arcpy.SetProgressorLabel(text)

    def close(self):
        arcpy.ResetProgressor()


# Parameter data types that never name a dataset or file (keywords and the display
# names Pro may report); their values are not resolved with Describe.
_ARCIO_NON_DATA_TYPES = frozenset(t.casefold() for t in (
    "GPBoolean", "Boolean", "GPString", "String", "GPLong", "Long", "GPDouble", "Double",
    "Field", "GPSQLExpression", "SQL Expression", "GPLinearUnit", "Linear Unit",
    "GPDate", "Date", "GPValueTable", "Value Table", "GPCoordinateSystem",
    "Coordinate System", "GPSpatialReference", "Spatial Reference", "GPExtent", "Extent"))


def _arcio_is_data_parameter(param):
    kinds = param.datatype if isinstance(param.datatype, (list, tuple)) else [param.datatype]
    return any(str(k).casefold() not in _ARCIO_NON_DATA_TYPES for k in kinds)


def _arcio_parameter_inputs(parameters):
    """``(paths, joined)`` of every Input parameter value naming a dataset or file
    (multivalues split): each value as typed plus its catalog path (a layer -> its
    data source), and the names of the tables joined to each input layer."""
    params = parameters.values() if isinstance(parameters, dict) else parameters
    paths, joined = [], set()
    for param in params:
        if param.direction != "Input" or not _arcio_is_data_parameter(param):
            continue
        text = param.valueAsText
        if not text:
            continue
        for value in split_multivalue(text):
            paths.append(value)
            try:
                if arcpy.Exists(value):
                    desc = arcpy.da.Describe(value)
                    paths.append(desc["catalogPath"])
                    if "fields" in desc:
                        joined.update(joined_table_names([field_info(f) for f in desc["fields"]]))
            except Exception:  # an unreadable value is still compared as typed
                pass
    return paths, joined


def register_parameter_inputs(parameters):
    """Register every Input parameter value naming a dataset or file (multivalues
    split), as typed and resolved to its catalog path (a layer -> its data source),
    so no output or report of the run can replace it (rule 4; review D1/D2).
    The names of the tables joined to each input layer (qualified field names,
    ``paths.joined_table_names``) are registered too: a layer reports only its
    own table's path, so an output or report named like a joined table is
    refused in any workspace (re-review N1)."""
    paths, joined = _arcio_parameter_inputs(parameters)
    register_inputs(paths)
    register_joined_tables(joined)


def _arcio_inside(path, root):
    """True if ``path`` is ``root`` or lies inside it (normalised catalog paths)."""
    key = normalize_catalog_path(root)
    if not key:
        return False
    for candidate in (normalize_catalog_path(path), normalize_catalog_path(split_catalog_path(path)[0])):
        if candidate == key or candidate.startswith(key.rstrip("\\") + "\\"):
            return True
    return False


def refuse_existing_protected_output(param, protected_paths, scanned_workspaces=(),
                                     refuse_inside=False, joined=()):
    """``updateMessages`` check: set an error on an output parameter that would replace
    a protected dataset or file; return True if it did.

    ArcGIS Pro deletes an existing output before ``execute`` runs when overwriting is
    on, so a refusal in ``execute`` comes too late (Pro session 1, S2: a scanned
    dataset was lost). Only an error set during validation stops the run before the
    delete (a warning does not; ``_work/pro_logs/s2_probe.txt``). Refused:

    * the output is the same dataset as any protected path (``paths.same_dataset``);
    * the output lies inside a scanned workspace (``scanned_workspaces``) and already
      exists, or lies inside it at all when ``refuse_inside`` (decision D-015);
    * the output is named like a table joined to an input layer (``joined``).
    """
    out = param.valueAsText
    if not out or not str(out).strip():
        return False
    out = str(out).strip()
    reason = None
    for path in protected_paths or ():
        if path and same_dataset(out, path):
            reason = ("The output '{0}' is the same dataset as the input '{1}'; ArcGIS Pro would "
                      "delete it before the tool runs. Choose a different output name or "
                      "location.".format(out, path))
            break
    if reason is None:
        for root in scanned_workspaces or ():
            if root and _arcio_inside(out, root) and (refuse_inside or _arcio_existing_outputs(out)):
                reason = ("The output '{0}' is inside '{1}', which is being inventoried or "
                          "audited; an existing item of that name could be replaced. Write the "
                          "output outside the scanned workspace.".format(out, root))
                break
    if reason is None and joined:
        try:
            refuse_joined_table_outputs([out], joined)
        except ToolError as err:
            reason = str(err)
    if reason is None:
        return False
    param.setErrorMessage(reason)
    return True


# Keywords and the display names ArcGIS Pro reports in Parameter.datatype ("Table").
_ARCIO_FOLDER_OUTPUT_EXT = {"detable": ".dbf", "table": ".dbf", "defeatureclass": ".shp",
                            "feature class": ".shp"}


def add_folder_output_extensions(parameters):
    """``updateParameters`` helper: give an extension-less table / feature class output in a
    plain folder its ``.dbf`` / ``.shp``. ArcGIS Pro validates the output before the tool
    runs and takes ``folder\name`` for an INFO table (ERROR 000734 when the path has a
    space; Pro session 1, S3, ``_work/pro_logs/dbf_probe.txt``). Outputs that accept both
    kinds are left alone."""
    for param in parameters:
        if param.direction != "Output" or param.parameterType == "Derived":
            continue
        kinds = param.datatype if isinstance(param.datatype, (list, tuple)) else [param.datatype]
        exts = set(_ARCIO_FOLDER_OUTPUT_EXT.get(str(k).casefold()) for k in kinds)
        if len(exts) != 1 or None in exts:
            continue
        text = param.valueAsText
        if not text or not str(text).strip():
            continue
        workspace, name = split_catalog_path(str(text).strip())
        if workspace and "." not in name and is_folder_workspace(workspace):
            param.value = str(text).strip() + exts.pop()


def folder_output_extensions(update_parameters):
    """Decorator for a tool's ``updateParameters``: runs it, then
    ``add_folder_output_extensions``."""
    def wrapper(self, parameters):
        result = update_parameters(self, parameters)
        add_folder_output_extensions(parameters)
        return result
    wrapper.__name__ = update_parameters.__name__
    wrapper.__doc__ = update_parameters.__doc__
    return wrapper


def protected_outputs(scanned=(), refuse_inside=False):
    """Decorator for a tool's ``updateMessages``: after the tool's own checks, every
    Output parameter that is not derived is checked with
    ``refuse_existing_protected_output`` against every Input data parameter (as typed
    and resolved to its data source, plus joined tables). ``scanned`` names Input
    parameters whose workspaces the tool reads in full."""
    scanned = (scanned,) if isinstance(scanned, str) else tuple(scanned)

    def decorate(update_messages):
        def wrapper(self, parameters):
            result = update_messages(self, parameters)
            outputs = [p for p in parameters if p.direction == "Output"
                       and p.parameterType != "Derived" and p.valueAsText]
            if not outputs:
                return result
            paths, joined = _arcio_parameter_inputs(parameters)
            roots = []
            for param in parameters:
                if param.name in scanned and param.valueAsText:
                    roots.extend(split_multivalue(param.valueAsText))
            for param in outputs:
                refuse_existing_protected_output(param, paths, roots, refuse_inside, joined)
            return result
        wrapper.__name__ = update_messages.__name__
        wrapper.__doc__ = update_messages.__doc__
        return wrapper
    return decorate


def guarded_run(execute):
    """Decorator for a tool's ``execute``: for the length of the run every input
    parameter and every dataset the tool reads through this module
    (``describe_dataset``, ``read_*``, ``walk_workspace``, ``read_domains``) is
    registered, and ``create_table`` / ``create_feature_class`` /
    ``copy_for_output`` / ``check_output_path`` / ``safe_delete`` and the report
    checks refuse to replace any of them, even when the tool did not pass it in
    ``inputs`` (quality review D1/D2: a skipped shapefile input and a lookup table
    were overwritten)."""
    def wrapper(self, parameters, messages):
        begin_input_register()
        try:
            register_parameter_inputs(parameters)
            return execute(self, parameters, messages)
        finally:
            end_input_register()
    wrapper.__name__ = execute.__name__
    wrapper.__doc__ = execute.__doc__
    return wrapper


def set_derived_output(parameters, name, value):
    """Set a derived output parameter so the result is added to the map."""
    arcpy.SetParameterAsText(param_index(parameters, name), value)


def product_info():
    """``{"version": "3.3", "licence": "ArcView"}`` for messages and checks."""
    return {"version": arcpy.GetInstallInfo()["Version"], "licence": arcpy.ProductInfo()}


# ==========================================================================
# quality/domain_conformance_core.py
# ==========================================================================
# Pure logic of the Domain Audit tool (no arcpy).
#
# Two parts:
#
# * **Conformance** (``check_table_conformance``): every value of every field that
#   has a domain (at field or subtype level) is checked against the domain that
#   applies to *its row* (subtype-level domains win). Failures are classified so
#   the user knows how to fix them: a description typed instead of the code, a
#   case/space variant of a code, an ambiguous description, a value outside a
#   range, an unknown subtype code.
# * **Hygiene** (``domain_usage_rows`` + ``domain_hygiene_rows``): which domain is
#   used where, unused domains, duplicate or near-duplicate descriptions, coded
#   values that never occur in the data, and field/domain type mismatches.
#
# Domains and subtypes use the plain-dict structures of ``common.domains``;
# fields are ``arcio.field_info`` dicts; rows are ``{"oid", "attrs"}`` dicts.

ISSUE_OUT_OF_DOMAIN = "OUT_OF_DOMAIN"
ISSUE_OUT_OF_RANGE = "OUT_OF_RANGE"
ISSUE_DESCRIPTION_AS_CODE = "DESCRIPTION_AS_CODE"
ISSUE_CASE_OR_SPACE_VARIANT = "CASE_OR_SPACE_VARIANT"
ISSUE_AMBIGUOUS_DESCRIPTION = "AMBIGUOUS_DESCRIPTION"
ISSUE_INVALID_SUBTYPE = "INVALID_SUBTYPE"
ISSUE_NULL_VALUE = "NULL_VALUE"
# Not a violation: the value and the range bounds cannot be compared (e.g. a time of
# day against bounds Pro returns in another form). Counted, never written as a row.
RANGE_UNDETERMINED = "RANGE_UNDETERMINED"
# Not a violation either (review R10-1): a coded domain on a date field whose codes cannot be read
# as dates; its values are counted as not checked, never written as rows.
DOMAIN_CODES_UNREADABLE = "DOMAIN_CODES_UNREADABLE"

HYGIENE_UNUSED_DOMAIN = "UNUSED_DOMAIN"
HYGIENE_TYPE_MISMATCH = "TYPE_MISMATCH"
HYGIENE_DUPLICATE_DESCRIPTION = "DUPLICATE_DESCRIPTION"
HYGIENE_NEAR_DUP_DESCRIPTION = "NEAR_DUP_DESCRIPTION"
HYGIENE_CODE_NEVER_USED = "CODE_NEVER_USED"
HYGIENE_NEAR_DUP_CODE = "NEAR_DUP_CODE"
HYGIENE_RANGE_MIN_ABOVE_MAX = "RANGE_MIN_ABOVE_MAX"

RECORD_USAGE = "USAGE"
RECORD_ISSUE = "ISSUE"

# Field.type / Domain.type spellings -> comparison family. Domain.type strings
# are UNCONFIRMED in the docs (audit gotcha 25), so both the Field.type and
# the AddField keyword spellings are accepted.
_DOMAIN_TYPE_FAMILIES = {
    "string": "text", "text": "text",
    "smallinteger": "number", "short": "number", "integer": "number", "long": "number",
    "biginteger": "number", "single": "number", "float": "number", "double": "number",
    "date": "date", "dateonly": "date", "timeonly": "date", "timestampoffset": "date",
}

# Field types that never carry a domain value worth checking.
_DOMAIN_SKIP_FIELD_TYPES = frozenset(["oid", "geometry", "blob", "raster", "globalid", "guid"])


def domain_type_family(type_name):
    """``"text"``, ``"number"``, ``"date"`` or ``None`` (unknown spelling)."""
    return _DOMAIN_TYPE_FAMILIES.get(str(type_name or "").replace(" ", "").casefold())


# Review R4-F3: further characters that cannot be seen and are dropped in the comparison, the
# same set MultiValueCodeValidator treats as invisible (C0 controls except the blanks and line
# breaks, DEL, Mongolian vowel separator U+180E, invisible operators U+2061-2064), plus the
# combining grapheme joiner U+034F and the variation selectors U+FE00-FE0F.
# Review R6-1: the C1 controls U+0080-U+009F as well (cp1252 mojibake leftovers such as U+009D and
# U+0081), except U+0085 (next line), which str.split() already treats as a blank.
_DOMAIN_EXTRA_INVISIBLE = frozenset(
    [chr(c) for c in range(0x00, 0x20)] + [chr(0x7F), u"\u180e", u"\u034f"]
    + [chr(c) for c in range(0x80, 0xA0) if c != 0x85]
    + [chr(c) for c in range(0x2061, 0x2065)] + [chr(c) for c in range(0xFE00, 0xFE10)]) \
    - frozenset(u" \t\n\r\x0b\x0c")


def _domain_fold(text):
    """Invisible marks removed + Unicode NFC + trim + casefold used for 'same apart from
    case and spaces' comparisons (a decomposed spelling of a code is suggested that code).
    The marks are removed before NFC (review R7-F2), so a mark between a letter and its
    combining accent does not stop the two from composing.

    Invisible format marks (right-to-left / left-to-right marks, zero-width space, BOM,
    soft hyphen: ``common.text.TEXT_INVISIBLE``, plus ``_DOMAIN_EXTRA_INVISIBLE``) are dropped because they are common in
    pasted Arabic text, cannot be seen, and would otherwise make 'الرياض' + RLM look like
    a value that has nothing to do with the code. Zero-width (non-)joiners are kept: they
    change how Arabic and Persian letters are shaped."""
    text = u"".join(ch for ch in remove_invisible(str(text))
                    if ch not in _DOMAIN_EXTRA_INVISIBLE)
    return u" ".join(to_nfc(text).split()).casefold()


def _domain_code_text(code):
    return value_to_text(code)


def domain_fields_to_check(fields, subtypes, wanted=None):
    """Names of the fields that have a domain at field or at subtype level.

    ``wanted`` (a list of field names, already resolved) restricts the result;
    a wanted field without any domain is left out (the caller reports it).
    Order follows the table's field order.
    """
    by_subtype = set()
    for entry in ((subtypes or {}).get("subtypes") or {}).values():
        for name, dom in (entry.get("domains") or {}).items():
            if dom:
                by_subtype.add(name.casefold())
    keep = None if wanted is None else set(w.casefold() for w in wanted)
    out = []
    for f in fields:
        if str(f.get("type") or "").casefold() in _DOMAIN_SKIP_FIELD_TYPES:
            continue
        name = f["name"]
        if keep is not None and name.casefold() not in keep:
            continue
        if f.get("domain") or name.casefold() in by_subtype:
            out.append(name)
    return out


def _domain_comparable(value):
    """Value in a form that can be compared with ``<``: dates -> datetime,
    times of day (TimeOnly) -> ``datetime.time`` without time zone, numbers and
    numeric text -> exact number (``common.numeric.exact_number``), anything
    else -> ``None``. NaN gives ``None`` (it is never inside a range)."""
    if isinstance(value, datetime.datetime):
        return value
    if isinstance(value, datetime.date):
        return datetime.datetime(value.year, value.month, value.day)
    if isinstance(value, datetime.time):
        return value.replace(tzinfo=None)
    if isinstance(value, bool):
        return None
    return exact_number(value)  # integers stay exact (BigInteger above 2**53)


def _domain_time_bound(bound):
    """A range bound as a time of day, for TimeOnly values: a ``time``, the
    time part of a ``datetime``, or text such as ``08:00`` / ``08:00:00``, the
    Windows form ``8:00:00 AM`` (review R14-3: the form the coded path already
    reads) or date-time text whose time part is given (``12/30/1899 8:00:00 AM``,
    ``1899-12-30T08:00:00``: the time part does not depend on the date order).
    ``None`` when it is none of these (date text without a time part included:
    its time of day is not known)."""
    if isinstance(bound, datetime.datetime):
        return bound.time()
    if isinstance(bound, datetime.time):
        return bound.replace(tzinfo=None)
    if isinstance(bound, str):
        text = bound.strip()
        try:
            return datetime.time.fromisoformat(text).replace(tzinfo=None)
        except ValueError:
            pass
        clock = _domain_time_text(text)
        if clock is not None:
            return clock
        if "T" in text or " " in text:
            try:
                return datetime.datetime.fromisoformat(text).time()
            except ValueError:
                pass
        match = _DOMAIN_DATE_RE.match(text)
        if match and match.group(4) is not None:
            clock = _domain_clock(*match.group(4, 5, 6, 7, 8))
            return None if clock is None else datetime.time(*clock)
    return None


def _domain_align(value, bound):
    """``(value, bound)`` made comparable (review D4): a time of day is compared
    with the time of day of its bounds; when only one of two date-times carries
    a UTC offset (TimestampOffset), their clock times are compared. ``bound`` is
    ``None`` when it cannot be compared with a time of day."""
    if isinstance(value, datetime.time):
        return value, _domain_time_bound(bound)
    limit = _domain_comparable(bound)
    if isinstance(value, datetime.datetime) and isinstance(limit, datetime.datetime):
        if (value.tzinfo is None) != (limit.tzinfo is None):
            return value.replace(tzinfo=None), limit.replace(tzinfo=None)
    return value, limit


def _domain_date_bounds(domain, date_order=None):
    """The range bounds of ``domain`` with date text read as ``datetime`` (review R10-1 minor note:
    Pro may return the bounds of a Date range as text such as '1/1/2024'). A text bound that is
    not a number and cannot be read as a date stays text. Returns ``(low, high)``."""
    low, high = domain.get("range") or (None, None)
    texts = [b for b in (low, high) if isinstance(b, str) and exact_number(b) is None]
    if not texts:
        return low, high
    order, _how = domain_date_text_order(texts, date_order)

    def read(bound):
        if isinstance(bound, str) and exact_number(bound) is None:
            moment = _domain_moment(bound, False, order)
            return moment if moment is not None else bound
        return bound
    return read(low), read(high)


def _domain_range_ok(domain, value, date_order=None):
    """Inclusive range test; a ``None`` bound means unbounded on that side.

    Works for numeric and for date range domains (cursors return dates as
    ``datetime``). A value that cannot be compared with the bounds is out of
    range. For a FLOAT (single) domain a value that is a bound in single
    precision is in range (a FLOAT field stores 0.3 as 0.30000001192092896),
    the same rule as ``CodedDomainIndex``.

    Times of day (TimeOnly) are compared with the time of day of the bounds,
    and date-times with and without UTC offset by clock time (review D4).
    Date text bounds are read with ``_domain_date_bounds`` (``date_order``).
    Returns ``None`` (undetermined, not a violation) when a time of day cannot
    be compared with a bound, or a date with a text bound that cannot be read
    as a date (review R10-1).
    """
    number = _domain_comparable(value)
    if number is None:
        return False
    low, high = (_domain_date_bounds(domain, date_order) if isinstance(number, datetime.datetime)
                 else (domain.get("range") or (None, None)))
    if isinstance(number, datetime.datetime) and any(
            isinstance(b, str) and exact_number(b) is None for b in (low, high)):
        return None
    single = str(domain.get("field_type") or "").casefold() in ("single", "float")
    try:
        for bound, outside in ((low, lambda v, b: v < b), (high, lambda v, b: v > b)):
            if bound is None:
                continue
            aligned, limit = _domain_align(number, bound)
            if limit is None and isinstance(number, datetime.time):
                return None
            if outside(aligned, limit) and not (
                    single and isinstance(aligned, float) and float32_equal(aligned, limit)):
                return False
    except TypeError:  # e.g. a date compared with numeric bounds
        return None if isinstance(number, datetime.time) else False
    return True


_DOMAIN_NUMERIC_FIELD_TYPES = frozenset(
    ["short", "long", "smallinteger", "integer", "biginteger", "float", "single", "double"])


# Review R10-1: ArcGIS Pro returns the codes of a coded-value domain on a Date field as text in
# the Windows short date form (for example '3/5/2024' for 5 March 2024 on an en-US machine; the
# cursor returns datetime). Such text is read with an explicit day / month / year order.
DOMAIN_DATE_MDY = "MDY"
DOMAIN_DATE_DMY = "DMY"
DOMAIN_DATE_YMD = "YMD"
DOMAIN_DATE_ORDERS = (DOMAIN_DATE_MDY, DOMAIN_DATE_DMY, DOMAIN_DATE_YMD)
# Hint meaning "do not read non-ISO date text at all" (for example a Windows locale whose
# calendar is not Gregorian): such codes are then reported as unreadable, never guessed.
DOMAIN_DATE_NONE = "NONE"
DOMAIN_DATE_WORDS = {DOMAIN_DATE_MDY: "month/day/year", DOMAIN_DATE_DMY: "day/month/year",
                    DOMAIN_DATE_YMD: "year/month/day"}

# Review R14-3: a time part may end with a UTC offset (``+03:00``, ``-0530``, ``UTC+03:00``), the form a
# TimestampOffset bound or code can take as text; groups 9-11 are its sign, hours and minutes.
_DOMAIN_DATE_RE = re.compile(
    r"^(\d{1,4})[/.\-](\d{1,2})[/.\-](\d{1,4})\.?"
    r"(?:[ T]+(\d{1,2}):(\d{2})(?::(\d{2})(?:[.,](\d{1,6}))?)?\s*([AaPp]\.?[Mm]\.?)?"
    r"(?:\s*(?:UTC|GMT)?\s*([+\-\u2212])(\d{1,2}):?(\d{2}))?)?$")
_DOMAIN_TIME_RE = re.compile(r"^(\d{1,2}):(\d{2})(?::(\d{2})(?:[.,](\d{1,6}))?)?\s*([AaPp]\.?[Mm]\.?)?$")


def _domain_clock(hour, minute, second, fraction, ampm):
    """``(hour, minute, second, microsecond)`` from regex groups; ``None`` when invalid."""
    hour, minute = int(hour), int(minute)
    second = int(second or 0)
    micro = int((fraction or u"").ljust(6, u"0")[:6] or 0)
    if ampm:
        if not 1 <= hour <= 12:
            return None
        pm = ampm[0] in u"Pp"
        hour = (hour % 12) + (12 if pm else 0)
    if hour > 23 or minute > 59 or second > 59:
        return None
    return hour, minute, second, micro


def domain_parse_date_text(text, order):
    """Date text in the given part order (``DOMAIN_DATE_ORDERS``) as a ``datetime``, else ``None``.

    Accepts ``/``, ``-`` or ``.`` between the parts and an optional time ``h:mm[:ss[.ffffff]]``
    with an optional AM / PM and an optional UTC offset after the time (``+03:00``; the result is
    then offset-aware, review R14-3). The year must have four digits (a two-digit year has no safe
    century, and could be a year of another calendar), so ``1/1/24`` is ``None``."""
    if order not in DOMAIN_DATE_ORDERS:
        return None
    match = _DOMAIN_DATE_RE.match(str(text).strip())
    if not match:
        return None
    parts = match.group(1, 2, 3)
    pos = dict((letter, i) for i, letter in enumerate(order))
    year_text = parts[pos["Y"]]
    if len(year_text) != 4 or any(len(parts[pos[k]]) > 2 for k in "MD"):
        return None
    clock = (0, 0, 0, 0)
    zone = None
    if match.group(4) is not None:
        clock = _domain_clock(match.group(4), match.group(5), match.group(6), match.group(7), match.group(8))
        if clock is None:
            return None
        if match.group(9):
            hours, minutes = int(match.group(10)), int(match.group(11))
            if hours > 23 or minutes > 59:
                return None
            delta = datetime.timedelta(hours=hours, minutes=minutes)
            zone = datetime.timezone(-delta if match.group(9) in u"-\u2212" else delta)
    elif match.group(8):
        return None
    try:
        return datetime.datetime(int(year_text), int(parts[pos["M"]]), int(parts[pos["D"]]), *clock,
                                 tzinfo=zone)
    except ValueError:
        return None


def _domain_time_text(text):
    """``h:mm[:ss]`` with an optional AM / PM as a ``time``, else ``None``."""
    match = _DOMAIN_TIME_RE.match(str(text).strip())
    if not match:
        return None
    clock = _domain_clock(*match.groups())
    return None if clock is None else datetime.time(*clock)


def _domain_iso_moment(text):
    text = text.strip()
    try:
        return datetime.datetime.fromisoformat(text)
    except ValueError:
        try:
            return datetime.time.fromisoformat(text)
        except ValueError:
            return None


def domain_date_text_order(texts, hint=None):
    """``(order, how)`` in which every non-ISO date text of ``texts`` is a date.

    ``how`` is ``"hint"`` (the order ``hint`` reads them all), ``"only"`` (the one order that
    reads them all) or ``"same"`` (several orders read them all and give the same dates, as for
    ``1/1/2024``). ``(None, None)`` when no order reads them all, when several orders read them
    all with different dates and the hint is none of them (``3/5/2024`` without a hint), or when
    the hint is ``DOMAIN_DATE_NONE``."""
    texts = [t for t in texts if _domain_iso_moment(t) is None and _domain_time_text(t) is None]
    if not texts:
        return None, None
    if hint == DOMAIN_DATE_NONE:
        return None, None
    fits = [o for o in DOMAIN_DATE_ORDERS if all(domain_parse_date_text(t, o) is not None for t in texts)]
    if not fits:
        return None, None
    if hint in fits:
        return hint, "hint"
    if len(fits) == 1:
        return fits[0], "only"
    first = [domain_parse_date_text(t, fits[0]) for t in texts]
    if all([domain_parse_date_text(t, o) for t in texts] == first for o in fits[1:]):
        return fits[0], "same"
    return None, None


def _domain_moment(value, time_of_day=False, order=None):
    """A date / time code or value as a comparable moment (review R9 N-2): ``datetime`` as it is,
    ``date`` (DateOnly) as midnight, ``time`` (TimeOnly) without time zone, ISO text parsed, and
    other date text parsed in ``order`` (review R10-1, ``domain_parse_date_text``); with ``time_of_day``
    (a TimeOnly domain) everything as its time of day, and ``h:mm:ss AM`` text too. ``None``
    when the value is none of these."""
    if isinstance(value, str):
        text = value.strip()
        parsed = _domain_iso_moment(text)
        if parsed is None and order:
            parsed = domain_parse_date_text(text, order)
        if parsed is None and time_of_day:
            parsed = _domain_time_text(text)
        if parsed is None:
            return None
        value = parsed
    if isinstance(value, datetime.datetime):
        if time_of_day:
            return value.time()
        return value
    if isinstance(value, datetime.date):
        if time_of_day:
            return None
        return datetime.datetime(value.year, value.month, value.day)
    if isinstance(value, datetime.time):
        return value.replace(tzinfo=None)
    return None


def _domain_join(texts):
    """Codes of one hygiene group joined for the CODE column: with ``/`` unless a code contains
    ``/`` (review R9 N-3), then with the first of `` | ``, ``; ``, ``, `` that no code contains."""
    texts = [u"" if t is None else t for t in texts]
    for sep in (u"/", u" | ", u"; ", u", "):
        joined = sep.join(texts)
        # the text must split back into exactly these codes (a code ending in "|" would make
        # " | " appear across a boundary)
        if not any(sep in t for t in texts) and joined.split(sep) == texts:
            return joined
    return u"[" + u", ".join(repr(t) for t in texts) + u"]"


class CodedDomainIndex(object):
    """Dictionary lookups for one coded-value domain, built once.

    Values are compared like ``common.domains.value_in_domain`` (numbers
    numerically for numeric domains, so "1" equals 1; text as text), but in
    constant time per value instead of a scan over all codes. Only for FLOAT
    (single) domains does a value also match through its shortest
    single-precision decimal; integer and DOUBLE domains compare exactly.
    """

    def __init__(self, domain, date_order=None):
        field_type = str(domain.get("field_type") or "").casefold()
        self.numeric = field_type in _DOMAIN_NUMERIC_FIELD_TYPES
        # float32 equivalence only for FLOAT (single) domains: integer and DOUBLE
        # codes compare exactly (float32 cannot hold every integer above 2**24).
        self.single = field_type in ("single", "float")
        # Review R9 N-2: date / time codes and values are compared as moments, not as text, so
        # a DateOnly value (date) equals a code Pro returns as midnight (datetime).
        self.dates = domain_type_family(field_type) == "date"
        self.time_of_day = field_type.replace(" ", "") == "timeonly"
        # Review R10-1: date codes that come back as text (Pro: '3/5/2024') are read in the order
        # domain_date_text_order() finds (``date_order`` is the Windows short date order, when known).
        # Codes that still cannot be read as dates make the domain unreadable: its values are then
        # not checked at all (a warning counts them) instead of all being OUT_OF_DOMAIN.
        self.order, self.order_how, self.unreadable = None, None, []
        if self.dates:
            codes = list((domain.get("codes") or {}).keys())
            self.order, self.order_how = domain_date_text_order(
                [c for c in codes if isinstance(c, str)], date_order)
            self.unreadable = [c for c in codes if c is not None and
                               _domain_moment(c, self.time_of_day, self.order) is None]
        self.by_key = {}
        self.exact_desc, self.fold_code, self.fold_desc = {}, {}, {}
        for code, desc in (domain.get("codes") or {}).items():
            for key in self._code_keys(code):
                self.by_key.setdefault(key, code)
            self.fold_code.setdefault(_domain_fold(_domain_code_text(code)), []).append(code)
            if desc is not None:
                self.exact_desc.setdefault(str(desc), []).append(code)
                self.fold_desc.setdefault(_domain_fold(desc), []).append(code)

    def _code_keys(self, code):
        """Keys a code is stored under (``_keys`` gives the keys a value is looked up by)."""
        if self.dates and code is not None:
            moment = _domain_moment(code, self.time_of_day, self.order)
            if isinstance(moment, datetime.datetime):
                if moment.tzinfo is None:
                    return [("n", moment)]
                # with an offset: exact instant, or clock time against a value without offset
                return [("a", moment), ("ac", moment.replace(tzinfo=None))]
            if isinstance(moment, datetime.time):
                return [("t", moment)]
        return self._keys(code)

    def _keys(self, value):
        if value is None:
            return []
        if self.dates:
            moment = _domain_moment(value, self.time_of_day, self.order)
            if isinstance(moment, datetime.datetime):
                if moment.tzinfo is None:
                    return [("n", moment), ("ac", moment)]
                return [("a", moment), ("n", moment.replace(tzinfo=None))]
            if isinstance(moment, datetime.time):
                return [("t", moment)]
            return [str(value)]
        if self.numeric:
            # exact_number, not float(): BigInteger codes above 2**53 stay distinct.
            number = exact_number(value)
            if number is None:
                return []
            if self.single:
                number = float(number)
                return [number, float32_shortest(number)]
            return [number]
        return [str(value)]

    def find(self, value):
        """The domain's own code that ``value`` stands for, else ``None``."""
        for key in self._keys(value):
            if key in self.by_key:
                return self.by_key[key]
        return None

    def classify(self, value):
        """``(issue, suggested code text)`` for a value that is not a valid code."""
        raw = value_to_text(value)
        folded = _domain_fold(raw)
        if not folded:
            # Review R9-c: a blank value, or one made only of invisible marks, points to no
            # description (a code with an empty description would otherwise attract them all);
            # it can still be a blank variant of a code.
            by_code = self.fold_code.get(folded, [])
            if len(by_code) == 1:
                return ISSUE_CASE_OR_SPACE_VARIANT, _domain_code_text(by_code[0])
            if len(by_code) > 1:
                return ISSUE_AMBIGUOUS_DESCRIPTION, None
            return ISSUE_OUT_OF_DOMAIN, None
        exact = self.exact_desc.get(raw, [])
        if len(exact) == 1:
            return ISSUE_DESCRIPTION_AS_CODE, _domain_code_text(exact[0])
        if len(exact) > 1:
            return ISSUE_AMBIGUOUS_DESCRIPTION, None
        by_code = self.fold_code.get(folded, [])
        by_desc = self.fold_desc.get(folded, [])
        candidates = []
        for c in by_code + by_desc:
            if c not in candidates:
                candidates.append(c)
        if len(candidates) > 1:
            return ISSUE_AMBIGUOUS_DESCRIPTION, None
        if len(candidates) == 1:
            issue = ISSUE_CASE_OR_SPACE_VARIANT if by_code else ISSUE_DESCRIPTION_AS_CODE
            return issue, _domain_code_text(candidates[0])
        return ISSUE_OUT_OF_DOMAIN, None


def classify_coded_value(domain, value):
    """Classify a value that is **not** a valid code of a coded-value domain.

    Returns ``(issue, suggested_code_text)``. Tests, in order:

    1. the value equals a description exactly -> DESCRIPTION_AS_CODE (or
       AMBIGUOUS_DESCRIPTION when several codes share that description);
    2. after Unicode NFC + trim + casefold the value equals a code and/or a
       description:
       one distinct code -> CASE_OR_SPACE_VARIANT (matched a code) or
       DESCRIPTION_AS_CODE (matched a description); several distinct codes
       -> AMBIGUOUS_DESCRIPTION (no suggestion);
    3. otherwise OUT_OF_DOMAIN.

    A value that is blank after folding (spaces or invisible marks only) is never matched to a
    description, so a code with an empty description does not attract every blank value
    (review R9-c); it can still be a variant of a blank code.
    """
    return CodedDomainIndex(domain).classify(value)


def check_domain_value(domain, value, index=None, date_order=None):
    """``None`` if ``value`` conforms to ``domain``, else ``(issue, suggested)``.

    ``index`` (a ``CodedDomainIndex`` of the domain) avoids rebuilding the
    lookups for every value. Nulls are not handled here (see
    ``check_table_conformance``). ``date_order`` is the order of date text
    (``DOMAIN_DATE_ORDERS``, review R10-1). ``(DOMAIN_CODES_UNREADABLE, None)`` for a coded
    domain on a date field whose codes cannot be read as dates.
    """
    if domain.get("domain_type") == "Range":
        ok = _domain_range_ok(domain, value, date_order)
        if ok is None:
            return RANGE_UNDETERMINED, None
        return None if ok else (ISSUE_OUT_OF_RANGE, None)
    index = index or CodedDomainIndex(domain, date_order)
    if index.unreadable:
        return DOMAIN_CODES_UNREADABLE, None
    if index.find(value) is not None:
        return None
    return index.classify(value)


def _domain_subtype_known(subtypes, code):
    table = subtypes.get("subtypes") or {}
    if code in table:
        return True
    for key in table:
        try:
            if float(key) == float(code):
                return True
        except (TypeError, ValueError):
            continue
    return False


def check_table_conformance(table_name, fields, subtypes, rows, domains, check_fields,
                            null_is_violation=False, used_codes=None, suggested_codes=None,
                            applied_domains=None, date_order=None, domain_reach=None):
    """Check every row of one table.

    ``check_fields`` are field names (see ``domain_fields_to_check``);
    ``domains`` is ``{name: domain dict}``; ``used_codes`` (optional dict)
    collects ``{domain name: set of code texts seen as valid values}``;
    ``suggested_codes`` (optional dict) collects ``{domain name: {code text:
    number of violations that suggest it}}``; ``applied_domains`` (optional set)
    collects the names of the domains that applied to at least one row (null
    values included; review R7-F1).

    Returns ``(violations, stats)``. A violation is a dict with the keys
    ``table, oid, field, subtype_code, domain, value, issue, suggested``.
    ``stats`` = ``{"rows", "nulls": {field: n}, "missing_domains": set,
    "checked_values", "undetermined": {(field, domain): n}, "no_subtype": {field: n}}``
    (``undetermined``: values a range domain could not be compared with,
    ``RANGE_UNDETERMINED``; not violations and, review R11-1, not counted in
    ``checked_values``. ``no_subtype``: non-null values left
    unchecked because the row's subtype is NULL or unknown and the field has a
    domain only at subtype level, review R4-F2).
    Review R10-1: ``date_order`` (``DOMAIN_DATE_ORDERS`` or ``DOMAIN_DATE_NONE``) is the order in which
    date codes that come back as text are read; ``stats`` also has ``"unreadable": {(field,
    domain): n}`` (values of a coded date domain whose codes cannot be read as dates: not
    checked, not violations, not counted in ``checked_values``), ``"unreadable_codes": {domain:
    [code text]}`` and ``"date_orders": {domain: (order, how)}`` for domains whose codes were
    read from non-ISO text (``domain_date_text_order``).
    Review R14-2: ``stats`` also has ``"missing_values": {domain: n}`` (non-null values whose domain
    does not exist in the workspace: not checked, not counted in ``checked_values``). A NULL whose
    domain does not exist gives no ``NULL_VALUE`` row (it names no domain that could be fixed); the
    domain is listed in ``missing_domains``.
    Review R14-1: ``domain_reach`` (optional dict) collects, for every domain that can apply to a
    checked field (field or subtype level), ``{"rows": rows read, "no_subtype_rows": rows whose
    subtype code is NULL or unknown and to which the domain therefore did not apply, "subtypes": set
    of the subtype codes for which it applies}``, so ``domain_hygiene_rows`` can say why a domain
    applied to no row.
    Rows are processed in OID order.
    """
    subtypes = subtypes or {"field": "", "subtypes": {}}
    st_field = subtypes.get("field") or ""
    field_domain = dict((f["name"], f.get("domain")) for f in fields)
    out = []
    stats = {"rows": 0, "nulls": dict((f, 0) for f in check_fields),
             "missing_domains": set(), "checked_values": 0, "undetermined": {},
             "no_subtype": {}, "unreadable": {}, "unreadable_codes": {}, "date_orders": {},
             "missing_values": {}}
    if used_codes is None:
        used_codes = {}
    if suggested_codes is None:
        suggested_codes = {}
    field_domain_cf = dict((f["name"].casefold(), f.get("domain")) for f in fields)
    subtype_only = set()
    for entry in (subtypes.get("subtypes") or {}).values():
        for fname, dom in (entry.get("domains") or {}).items():
            if dom and not field_domain_cf.get(fname.casefold()):
                subtype_only.add(fname.casefold())
    candidates = set()
    for name in check_fields:
        if field_domain.get(name):
            candidates.add(field_domain.get(name))
        for entry in (subtypes.get("subtypes") or {}).values():
            for fname, dom in (entry.get("domains") or {}).items():
                if dom and fname.casefold() == name.casefold():
                    candidates.add(dom)
    if domain_reach is not None:
        for dom in candidates:
            reach = domain_reach.setdefault(dom, {"rows": 0, "no_subtype_rows": 0, "subtypes": set()})
            if st_field:
                for code in (subtypes.get("subtypes") or {}):
                    if any(domain_for_field(name, field_domain.get(name), subtypes, code) == dom
                           for name in check_fields):
                        reach["subtypes"].add(code)
    indexes = {}
    for row in sorted(rows, key=lambda r: r["oid"]):
        stats["rows"] += 1
        row_applied = set()
        attrs = row["attrs"]
        st_code = None
        st_valid = True
        if st_field:
            st_code = _domain_attr(attrs, st_field)
            if st_code is not None and not _domain_subtype_known(subtypes, st_code):
                st_valid = False
                out.append({"table": table_name, "oid": row["oid"], "field": st_field,
                            "subtype_code": _domain_int(st_code), "domain": None,
                            "value": value_to_text(st_code), "issue": ISSUE_INVALID_SUBTYPE,
                            "suggested": None})
        for name in check_fields:
            value = _domain_attr(attrs, name)
            dom_name = domain_for_field(name, field_domain.get(name), subtypes,
                                        st_code if st_valid else None)
            if dom_name and applied_domains is not None:
                applied_domains.add(dom_name)
            if dom_name:
                row_applied.add(dom_name)
            if value is None:
                stats["nulls"][name] += 1
                if dom_name and dom_name not in domains:
                    stats["missing_domains"].add(dom_name)
                    continue
                if null_is_violation and dom_name:
                    out.append(_domain_violation(table_name, row, name, st_code, st_field,
                                                 dom_name, None, ISSUE_NULL_VALUE, None))
                continue
            if not dom_name:
                if st_field and (st_code is None or not st_valid) and \
                        name.casefold() in subtype_only:
                    stats["no_subtype"][name] = stats["no_subtype"].get(name, 0) + 1
                continue
            domain = domains.get(dom_name)
            if domain is None:
                stats["missing_domains"].add(dom_name)
                stats["missing_values"][dom_name] = stats["missing_values"].get(dom_name, 0) + 1
                continue
            index = None
            if domain.get("domain_type") != "Range":
                index = indexes.get(dom_name)
                if index is None:
                    index = indexes[dom_name] = CodedDomainIndex(domain, date_order)
                    if index.unreadable:
                        stats["unreadable_codes"][dom_name] = sorted(
                            _domain_code_text(c) for c in index.unreadable)
                    elif index.order:
                        stats["date_orders"][dom_name] = (index.order, index.order_how)
                if index.unreadable:
                    key = (name, dom_name)
                    stats["unreadable"][key] = stats["unreadable"].get(key, 0) + 1
                    continue
            result = check_domain_value(domain, value, index, date_order)
            if result is not None and result[0] == RANGE_UNDETERMINED:
                # Review R11-1: a value that could not be compared with the bounds was not
                # checked, so it is not counted in ``checked_values``.
                key = (name, dom_name)
                stats["undetermined"][key] = stats["undetermined"].get(key, 0) + 1
                continue
            stats["checked_values"] += 1
            if result is None:
                if index is not None:
                    code = index.find(value)
                    if code is not None:
                        used_codes.setdefault(dom_name, set()).add(_domain_code_text(code))
                continue
            if result[1] is not None:
                per = suggested_codes.setdefault(dom_name, {})
                per[result[1]] = per.get(result[1], 0) + 1
            out.append(_domain_violation(table_name, row, name, st_code, st_field, dom_name,
                                         value, result[0], result[1]))
        if domain_reach is not None and st_field and (st_code is None or not st_valid):
            for dom in candidates - row_applied:
                domain_reach[dom]["no_subtype_rows"] += 1
    if domain_reach is not None:
        for dom in candidates:
            domain_reach[dom]["rows"] += stats["rows"]
    return out, stats


def _domain_attr(attrs, name):
    if name in attrs:
        return attrs[name]
    key = name.casefold()
    for k, v in attrs.items():
        if k.casefold() == key:
            return v
    return None


def _domain_int(value):
    try:
        return int(float(value))
    except (TypeError, ValueError):
        return None


def _domain_violation(table, row, field, st_code, st_field, dom_name, value, issue, suggested):
    return {"table": table, "oid": row["oid"], "field": field,
            "subtype_code": _domain_int(st_code) if st_field else None,
            "domain": dom_name, "value": value_to_text(value), "issue": issue,
            "suggested": suggested}


def domain_usage_rows(table_name, fields, subtypes):
    """Schema-level usage of domains in one table.

    One USAGE row per field-level assignment, plus one per subtype whose
    domain for a field **differs** from the field-level domain (a subtype
    that removes the domain gives no row). Keys: ``domain, record_type,
    dataset, field, subtype_code, issue, code, detail, field_type``.
    """
    out = []
    for f in fields:
        if f.get("domain"):
            out.append(_domain_usage(f["domain"], table_name, f["name"], None, f.get("type")))
    st = (subtypes or {}).get("subtypes") or {}
    if (subtypes or {}).get("field"):
        types = dict((f["name"].casefold(), f) for f in fields)
        for code in sorted(st, key=_domain_sort_key):
            for fname, dom in sorted((st[code].get("domains") or {}).items()):
                fdef = types.get(fname.casefold())
                level = fdef.get("domain") if fdef else None
                if dom and dom != level:
                    out.append(_domain_usage(dom, table_name, fdef["name"] if fdef else fname,
                                             _domain_int(code),
                                             fdef.get("type") if fdef else None))
    return out


def _domain_sort_key(value):
    try:
        return (0, float(value), u"")
    except (TypeError, ValueError):
        return (1, 0.0, str(value))


def _domain_usage(domain, dataset, field, subtype_code, field_type):
    return {"domain": domain, "record_type": RECORD_USAGE, "dataset": dataset, "field": field,
            "subtype_code": subtype_code, "issue": None, "code": None, "detail": None,
            "field_type": field_type}


def _domain_issue(domain, issue, dataset=None, field=None, code=None, detail=None,
                  subtype_code=None):
    return {"domain": domain, "record_type": RECORD_ISSUE, "dataset": dataset, "field": field,
            "subtype_code": subtype_code, "issue": issue, "code": code, "detail": detail}


def domain_hygiene_rows(domains, usage, used_codes, check_hygiene=True, scan_unused_codes=True,
                        scanned_domains=None, suggested_codes=None, applied_domains=None,
                        unreadable_domains=None, date_order=None, domain_reach=None):
    """ISSUE rows for the domain table.

    * UNUSED_DOMAIN: no USAGE row in ``usage`` (CODE_NEVER_USED is then not
      reported for that domain);
    * TYPE_MISMATCH: a USAGE row whose field type family differs from the
      domain's field type family;
    * DUPLICATE_DESCRIPTION: two or more codes with exactly the same
      description (one row per group, CODE = codes joined with "/", or with
      " | ", "; " or ", " when a code contains "/"; ``_domain_join``);
    * NEAR_DUP_DESCRIPTION: descriptions that differ but are equal after
      NFC + invisible marks removed + trim + casefold (one row per group);
    * NEAR_DUP_CODE: text codes that differ but are equal after the same
      folding (such codes make variants AMBIGUOUS_DESCRIPTION; one row per group);
    * RANGE_MIN_ABOVE_MAX: a range domain whose minimum is above its maximum
      (every value is then OUT_OF_RANGE; review R5-3);
    * CODE_NEVER_USED (``scan_unused_codes``): codes of a used coded domain
      that never occurred as a valid value; the detail says how many
      violations suggest the code (``suggested_codes``). Only domains in
      ``scanned_domains`` (domains whose values were actually read; default
      all used domains) are considered. When ``applied_domains`` is given and the
      domain is not in it (it applied to no row: the input shows no rows, or every row's
      subtype removes it), the detail says so (review R7-F1, R9-b); with ``domain_reach``
      (``check_table_conformance``) it names the cause that holds (review R14-1): no row read,
      rows whose subtype code is NULL or unknown, or no row of a subtype that uses the domain. Domains in
      ``unreadable_domains`` (a coded date domain whose codes could not be read as dates, so
      no value was compared with them; review R10-1) get no CODE_NEVER_USED row.

    ``date_order`` is the order in which date text range bounds are read for
    RANGE_MIN_ABOVE_MAX (review R10-1: text such as '9/1/2024' and '10/1/2024' must not be
    compared as text).

    Domains are processed in name order (case-insensitive) for stable output.
    """
    out = []
    used = set(u["domain"] for u in usage)
    for name in sorted(domains, key=lambda n: (n.casefold(), n)):
        dom = domains[name]
        coded = dom.get("domain_type") != "Range"
        if check_hygiene:
            if name not in used:
                out.append(_domain_issue(name, HYGIENE_UNUSED_DOMAIN,
                                         detail="No scanned field or subtype uses this domain."))
            for u in usage:
                if u["domain"] != name:
                    continue
                fam_f = domain_type_family(u.get("field_type"))
                fam_d = domain_type_family(dom.get("field_type"))
                if fam_f and fam_d and fam_f != fam_d:
                    out.append(_domain_issue(
                        name, HYGIENE_TYPE_MISMATCH, u["dataset"], u["field"],
                        subtype_code=u["subtype_code"],
                        detail="Field type {0} does not match domain type {1}.".format(
                            u.get("field_type"), dom.get("field_type"))))
            if coded:
                out.extend(_domain_description_groups(name, dom.get("codes") or {}))
                out.extend(_domain_code_groups(name, dom))
            else:
                out.extend(_domain_range_order(name, dom, date_order))
        if scan_unused_codes and coded and name in used and \
                (scanned_domains is None or name in scanned_domains) and \
                name not in (unreadable_domains or ()):
            seen = used_codes.get(name) or set()
            suggested = (suggested_codes or {}).get(name) or {}
            for code in sorted(dom.get("codes") or {}, key=_domain_sort_key):
                text = _domain_code_text(code)
                if text not in seen:
                    detail = u"Code {0} ({1}) never occurs as a valid value in the scanned data".format(
                        text, (dom.get("codes") or {})[code])
                    if applied_domains is not None and name not in applied_domains:
                        # Review R9-b: an input layer or selection that shows no row is a cause too.
                        detail += _domain_not_applied_note(
                            None if domain_reach is None else domain_reach.get(name, {}))
                    elif suggested.get(text):
                        # Review R4-F1: the data does mean this code; do not read it as unused.
                        detail += (u"; {0} violation(s) suggest it, so the data means this code: "
                                   u"fix those values, do not delete the code.").format(suggested[text])
                    else:
                        detail += u"."
                    out.append(_domain_issue(name, HYGIENE_CODE_NEVER_USED, code=text, detail=detail))
    return out


def _domain_not_applied_note(reach):
    """The end of a CODE_NEVER_USED detail for a domain that applied to no row that was read.

    ``reach`` is the domain's entry of ``domain_reach`` (``check_table_conformance``); ``None``
    when unknown, then every possible cause is named. Review R14-1: only the cause that holds is
    named."""
    head = u"; the domain applied to no row that was read"
    if reach is None:
        return (head + u" (the input shows no rows: an empty table, or a layer whose definition "
                u"query shows none; or every row's subtype removes the domain), so this does not "
                u"show that the code is unused.")
    rows = reach.get("rows") or 0
    if not rows:
        return (head + u": the input shows no rows (an empty table, or a layer whose definition "
                u"query shows none), so this does not show that the code is unused.")
    skipped = reach.get("no_subtype_rows") or 0
    codes = sorted(reach.get("subtypes") or (), key=_domain_sort_key)
    named = u", ".join(value_to_text(_domain_int(c) if _domain_int(c) is not None else c) for c in codes)
    if skipped >= rows:
        return (head + u": all {0} row(s) read have a NULL or unknown subtype code, and the domain "
                u"applies only to subtype(s) {1}. Fix the subtype codes and run again; until then "
                u"this does not show that the code is unused.").format(rows, named)
    if skipped:
        return (head + u": {0} of the {1} row(s) read have a NULL or unknown subtype code, and no "
                u"other row has a subtype that uses this domain (subtype(s) {2}). Fix the subtype "
                u"codes and run again; until then this does not show that the code is "
                u"unused.").format(skipped, rows, named)
    if codes:
        return (head + u": none of the {0} row(s) read has a subtype that uses this domain "
                u"(subtype(s) {1}), so no value was compared with this code.").format(rows, named)
    return (head + u": the subtype of each of the {0} row(s) read removes this domain, so no value "
            u"was compared with this code.").format(rows)


def _domain_range_order(name, dom, date_order=None):
    """RANGE_MIN_ABOVE_MAX row for a range domain whose minimum is above its maximum. Date text
    bounds of a date range are read as dates first; bounds that stay text say nothing."""
    bounds = dom.get("range") or (None, None)
    if domain_type_family(dom.get("field_type")) == "date":
        bounds = _domain_date_bounds(dom, date_order)
        if any(isinstance(b, str) for b in bounds):
            return []
    try:
        low, high = bounds[0], bounds[1]
        broken = low is not None and high is not None and low > high
    except (TypeError, IndexError):  # bounds of kinds that cannot be compared: say nothing
        return []
    if not broken:
        return []
    return [_domain_issue(name, HYGIENE_RANGE_MIN_ABOVE_MAX,
                          code=u"{0} > {1}".format(low, high),
                          detail=u"The minimum {0} is above the maximum {1}, so every value is "
                                 u"OUT_OF_RANGE. Correct the range in the Domains view.".format(
                                     low, high))]


def _domain_show(text):
    """Text for a detail message with characters that cannot be seen written as <U+XXXX>."""
    return u"".join(u"<U+{0:04X}>".format(ord(ch)) if unicodedata.category(ch) in ("Cc", "Cf")
                    or ch in _DOMAIN_EXTRA_INVISIBLE else ch for ch in text)


def _domain_code_groups(name, dom):
    """NEAR_DUP_CODE rows: text codes equal after folding (review R4-N5)."""
    if str(dom.get("field_type") or "").casefold() in _DOMAIN_NUMERIC_FIELD_TYPES:
        return []
    groups = {}
    for code in sorted(dom.get("codes") or {}, key=_domain_sort_key):
        groups.setdefault(_domain_fold(_domain_code_text(code)), []).append(code)
    out = []
    for _key, group in sorted(groups.items()):
        if len(group) > 1:
            out.append(_domain_issue(
                name, HYGIENE_NEAR_DUP_CODE,
                code=_domain_join([_domain_code_text(c) for c in group]),
                detail=u"Codes differ only by case, spaces, invisible marks or Unicode form: {0}; "
                       u"a value that matches them apart from that is AMBIGUOUS_DESCRIPTION.".format(
                           u", ".join(u"'{0}'".format(_domain_show(_domain_code_text(c)))
                                      for c in group))))
    return out


def _domain_description_groups(name, codes):
    exact, folded = {}, {}
    for code in sorted(codes, key=_domain_sort_key):
        desc = codes[code]
        if desc is None:
            continue
        exact.setdefault(str(desc), []).append(code)
        folded.setdefault(_domain_fold(desc), []).append(code)
    out = []
    for desc, group in exact.items():
        if len(group) > 1:
            out.append(_domain_issue(name, HYGIENE_DUPLICATE_DESCRIPTION,
                                     code=_domain_join([_domain_code_text(c) for c in group]),
                                     detail=u"Codes share the description '{0}'.".format(desc)))
    for key, group in folded.items():
        variants = sorted(set(str(codes[c]) for c in group))
        if len(group) > 1 and len(variants) > 1:
            out.append(_domain_issue(
                name, HYGIENE_NEAR_DUP_DESCRIPTION,
                code=_domain_join([_domain_code_text(c) for c in group]),
                detail=u"Descriptions differ only by case, spaces, invisible marks or Unicode "
                       u"form: {0}.".format(
                           u", ".join(u"'{0}'".format(_domain_show(v)) for v in variants))))
    return out


def domain_audit_summary(violations, domain_rows, tables_stats):
    """Summary rows ``(item, value)`` for the report and messages.

    ``tables_stats`` is a list of ``(table name, stats)`` from
    ``check_table_conformance``.
    """
    summary = [("Tables scanned", len(tables_stats)),
               ("Rows read", sum(s["rows"] for _t, s in tables_stats)),
               ("Values checked", sum(s["checked_values"] for _t, s in tables_stats)),
               ("Violations", len(violations))]
    for issue in (ISSUE_OUT_OF_DOMAIN, ISSUE_OUT_OF_RANGE, ISSUE_DESCRIPTION_AS_CODE,
                  ISSUE_CASE_OR_SPACE_VARIANT, ISSUE_AMBIGUOUS_DESCRIPTION,
                  ISSUE_INVALID_SUBTYPE, ISSUE_NULL_VALUE):
        summary.append((issue, sum(1 for v in violations if v["issue"] == issue)))
    summary.append(("Domain usage rows", sum(1 for r in domain_rows
                                             if r["record_type"] == RECORD_USAGE)))
    for issue in (HYGIENE_UNUSED_DOMAIN, HYGIENE_TYPE_MISMATCH, HYGIENE_DUPLICATE_DESCRIPTION,
                  HYGIENE_NEAR_DUP_DESCRIPTION, HYGIENE_NEAR_DUP_CODE, HYGIENE_RANGE_MIN_ABOVE_MAX,
                  HYGIENE_CODE_NEVER_USED):
        summary.append((issue, sum(1 for r in domain_rows if r["issue"] == issue)))
    for table, stats in tables_stats:
        for field, count in stats["nulls"].items():
            summary.append(("NULLS {0}.{1}".format(table, field), count))
    return summary


# ==========================================================================
# quality/normalised_keys_core.py
# ==========================================================================
# Pure logic of the Join Key Diagnostics tool (no arcpy).
#
# A key is a tuple of field values (a composite key has several parts). Keys
# are compared after a sequence of normalisation steps applied in a **fixed
# precedence**::
#
#     TRIM -> CASE -> DIGITS -> LEADING_ZEROS -> TYPE -> ARABIC_LETTERS -> TA_MARBUTA
#
# Only the steps the user enabled run, always in this order, so results never
# depend on the order in which options were ticked. Before any step, text parts
# are always put in Unicode canonical composition (NFC, ``common.text.to_nfc``):
# a decomposed spelling ("u" + combining diaeresis, Arabic yeh + combining
# hamza, as exported on macOS or copied from a PDF) is the same key as the
# precomposed one. In a join diagnosis a pair of keys that differs only in this
# way is WOULD_MATCH with ``match_after`` "NFC" (a join compares code points,
# so it does not match them as they are).
#
# * ``TRIM``: strip leading/trailing whitespace (incl. NBSP and other Unicode
#   spaces) and invisible format marks (zero width space, BOM, LRM/RLM, ALM,
#   bidi controls, ZWNJ/ZWJ; ``common.text.TEXT_INVISIBLE`` and
#   ``TEXT_JOINERS``) from text parts, so ``"‎007"`` is ``"007"`` before
#   LEADING_ZEROS (RT-R4 N1). When TRIM is enabled the ends are stripped again
#   after every later step, so a space that a later step exposes (``"كتاب ـ"``:
#   space + tatweel, removed by ARABIC_LETTERS) does not survive; MATCH_AFTER then
#   names TRIM too. Likewise LEADING_ZEROS is applied again after every later step
#   (``"0ـ7"`` -> ``"07"`` -> ``"7"``) (RT-R8 R8-2);
# * ``CASE``: casefold text parts;
# * ``DIGITS``: Arabic-Indic / Persian digits -> ASCII in text parts;
# * ``LEADING_ZEROS``: ``"007"`` -> ``"7"`` for all-digit text parts; invisible
#   format marks inside such a part are ignored and always dropped, with or
#   without a leading zero (``"0​07"`` -> ``"7"``, ``"7​7"`` -> ``"77"``),
#   so the step also works without TRIM (RT-R4 N1, RT-R6 R6-1);
# * ``TYPE``: numbers become text (``1.0`` -> ``"1"``), so a LONG 1 matches a
#   TEXT "1";
# * ``ARABIC_LETTERS``: alef forms, alef maqsura, Persian kaf/yeh, tashkeel,
#   tatweel and invisible marks folded (``common.text.arabic_normalize``,
#   digits and teh marbuta excluded: they are separate steps); a presentation
#   form that is a spacing tashkeel sign (U+FE70-FE7F isolated forms, the shadda
#   ligatures U+FC5E-FC63, whose compatibility form is a space plus marks) is
#   removed whole, without leaving its space (RT-R7 R7-C);
# * ``TA_MARBUTA``: teh marbuta -> heh.
#
# The result of every step is put in NFC again (a step can leave a non-NFC spelling:
# CASE folds ``ß`` + acute to ``ss`` + acute, ARABIC_LETTERS can remove an
# invisible mark between a letter and its accent), so a normalised key is always NFC
# and normalising it again changes nothing; MATCH_AFTER then names NFC (RT-R9 R9-1).
#
# Modes: duplicate groups within one table (``find_duplicate_groups``) and a
# join diagnosis between two tables (``diagnose_join``) that says, for every
# key that does not match exactly, after which steps it *would* match.
# ``None`` in any key part never matches anything (NULL_KEY).

STEP_TRIM = "TRIM"
STEP_CASE = "CASE"
STEP_DIGITS = "DIGITS"
STEP_LEADING_ZEROS = "LEADING_ZEROS"
STEP_TYPE = "TYPE"
STEP_ARABIC_LETTERS = "ARABIC_LETTERS"
STEP_TA_MARBUTA = "TA_MARBUTA"
# Label of the implicit, always-on canonical composition in ``match_after``.
STEP_NFC = "NFC"

KEY_STEPS = (STEP_TRIM, STEP_CASE, STEP_DIGITS, STEP_LEADING_ZEROS, STEP_TYPE,
             STEP_ARABIC_LETTERS, STEP_TA_MARBUTA)
DEFAULT_KEY_STEPS = (STEP_TRIM, STEP_CASE, STEP_DIGITS, STEP_LEADING_ZEROS, STEP_TYPE)

STATUS_MATCHED = "MATCHED"
STATUS_ONE_TO_MANY = "ONE_TO_MANY"
STATUS_WOULD_MATCH = "WOULD_MATCH"
STATUS_UNMATCHED_LEFT = "UNMATCHED_LEFT"
STATUS_UNMATCHED_RIGHT = "UNMATCHED_RIGHT"
STATUS_NULL_KEY = "NULL_KEY"

KEY_PART_SEPARATOR = u" | "

_KEYS_STRIP = u"".join(sorted(TEXT_SPACES | TEXT_LINE_BREAKS | TEXT_INVISIBLE | TEXT_JOINERS))
_KEYS_MARKS = TEXT_INVISIBLE | TEXT_JOINERS
# A text part shown in NORM_KEY / RAW_KEY is put in double quotes (inner quotes doubled)
# when it contains "|", starts with a double quote or is the text "<null>", so that two
# different TEXT keys never print the same (RT-R4 N3). A number and a text can print the
# same (LONG 1 and TEXT "1" both print as 1); in JOIN mode without TYPE the tool says so
# with ``type_step_gain`` (R10-2).
_KEYS_NULL_TEXT = u"<null>"


def _keys_zeros(value):
    """LEADING_ZEROS for one text part: digit-only text (invisible marks ignored).

    When the text is made only of ASCII digits once invisible format marks are
    ignored, the marks are ALWAYS dropped, whether or not there is a leading zero
    to remove: ``"7​7"`` -> ``"77"``, ``"‎7"`` -> ``"7"`` and
    ``"0​07"`` -> ``"7"`` (RT-R6 R6-1). Other text is returned unchanged."""
    if value and any(ch in _KEYS_MARKS for ch in value):
        bare = u"".join(ch for ch in value if ch not in _KEYS_MARKS)
        if bare and bare.isascii() and bare.isdigit():
            return strip_leading_zeros(bare)
        return value
    return strip_leading_zeros(value)


def _keys_spacing_marks(value):
    """Presentation forms that are a tashkeel sign on its own (isolated forms such as
    U+FE70 FATHATAN ISOLATED FORM and the shadda ligatures U+FC5E-FC63) decompose under
    NFKC into a SPACE followed by combining marks. The space is only the carrier of the
    sign, so it is dropped here and the marks are left for ``arabic_normalize`` to
    remove as tashkeel; otherwise ``"\u0643\u062a\u0627\u0628\ufe70"`` would become
    ``"\u0643\u062a\u0627\u0628 "`` with a trailing space (RT-R7 R7-C). Other
    presentation forms (ligatures of words with inner spaces, such as U+FDFA) are left
    to ``arabic_normalize`` unchanged."""
    if not any(0xFB50 <= ord(ch) <= 0xFDFF or 0xFE70 <= ord(ch) <= 0xFEFE for ch in value):
        return value
    out = []
    for ch in value:
        code = ord(ch)
        if 0xFB50 <= code <= 0xFDFF or 0xFE70 <= code <= 0xFEFE:
            comp = unicodedata.normalize("NFKC", ch)
            if len(comp) > 1 and comp[0] == u" " and \
                    all(unicodedata.combining(c) for c in comp[1:]):
                out.append(comp[1:])
                continue
        out.append(ch)
    return u"".join(out)


def ordered_steps(steps):
    """Enabled steps in the fixed precedence; raises ``ValueError`` for unknown names."""
    wanted = [str(s).strip().upper() for s in (steps or []) if str(s).strip()]
    unknown = [s for s in wanted if s not in KEY_STEPS]
    if unknown:
        raise ValueError("unknown normalisation step(s): {0}".format(", ".join(unknown)))
    return [s for s in KEY_STEPS if s in wanted]


def _keys_step_part(step, value):
    """Apply one step to one key part (``None`` stays ``None``)."""
    if value is None:
        return None
    if step == STEP_TYPE:
        return value_to_text(value)
    if not isinstance(value, str):
        return value  # text-only steps leave numbers, dates ... unchanged
    if step == STEP_TRIM:
        return value.strip(_KEYS_STRIP)
    if step == STEP_CASE:
        return value.casefold()
    if step == STEP_DIGITS:
        return fold_digits(value)
    if step == STEP_LEADING_ZEROS:
        return _keys_zeros(value)
    if step == STEP_ARABIC_LETTERS:
        return arabic_normalize(_keys_spacing_marks(value), digits=False, teh_marbuta=False)
    if step == STEP_TA_MARBUTA:
        return value.replace(u"ة", u"ه")
    raise ValueError(step)


def _keys_retrim(key):
    """Text parts of a key tuple stripped of the TRIM characters at both ends."""
    return tuple(part.strip(_KEYS_STRIP) if isinstance(part, str) else part for part in key)


def _keys_rezero(key):
    """LEADING_ZEROS applied again to the text parts of a key tuple."""
    return tuple(_keys_zeros(part) if isinstance(part, str) else part for part in key)


_KEYS_ZEROS_AT = KEY_STEPS.index(STEP_LEADING_ZEROS)


def _keys_cleanups(step, enabled, nfc=True):
    """``[(step name, function)]`` to run again after ``step``: NFC after every step (when
    ``nfc``), TRIM after every later step and LEADING_ZEROS after every step that comes
    after it, each only when enabled. NFC comes first: it never exposes an edge or a zero,
    and stripping ends or zeros never breaks NFC."""
    out = [(STEP_NFC, nfc_key)] if nfc else []
    if STEP_TRIM in enabled and step != STEP_TRIM:
        out.append((STEP_TRIM, _keys_retrim))
    if STEP_LEADING_ZEROS in enabled and KEY_STEPS.index(step) > _KEYS_ZEROS_AT:
        out.append((STEP_LEADING_ZEROS, _keys_rezero))
    return out


def apply_step(step, key, enabled=(), nfc=False):
    """Apply one step to every part of a key tuple.

    ``enabled``: all enabled steps. A later step can undo the work of an earlier one by
    removing characters: ARABIC_LETTERS removes a tatweel or tashkeel mark next to a space
    at the end of the key, so ``"\u0643\u062a\u0627\u0628 \u0640"`` would become
    ``"\u0643\u062a\u0627\u0628 "`` after TRIM had already run, and ``"0\u06407"`` would
    become ``"07"`` after LEADING_ZEROS had already run (RT-R8 R8-2). So when TRIM is
    enabled the ends are stripped again after every later step, and when LEADING_ZEROS is
    enabled it is applied again after every step that follows it. A normalised key is
    therefore a fixed point: normalising it again changes nothing.

    ``nfc``: also put the result in Unicode NFC again (``normalise_key`` always does). A
    step can leave a non-NFC spelling: CASE turns ``\u00df`` + U+0301 into ``ss`` + U+0301,
    which NFC writes as ``s\u015b``, and ARABIC_LETTERS removing a soft hyphen or zero
    width mark between ``S`` and U+0307 leaves ``S`` + U+0307, which NFC writes as
    ``\u1e60``. Without the re-composition normalising twice could give a different key
    and such a pair stayed UNMATCHED (RT-R9 R9-1). When the re-composition changes a key,
    ``explain_steps`` names NFC in MATCH_AFTER, as for the composition before the steps."""
    out = tuple(_keys_step_part(step, part) for part in key)
    for _name, cleanup in _keys_cleanups(step, enabled, nfc):
        out = cleanup(out)
    return out


def nfc_key(key):
    """Text parts of a key tuple in Unicode NFC (other parts unchanged)."""
    return tuple(to_nfc(part) for part in key)


def normalise_key(key, steps):
    """Unicode NFC (always), then the enabled ``steps`` (in the fixed
    precedence), applied to a key tuple."""
    key = nfc_key(key)
    steps = _keys_ordered(steps)
    for step in steps:
        key = apply_step(step, key, steps, nfc=True)
    return key


def _keys_ordered(steps):
    """``ordered_steps`` with a fast path: a list or tuple that is already a valid
    subsequence of ``KEY_STEPS`` (as ``ordered_steps`` returns) is used as is, so the
    per-key loops of the duplicate and join modes do not re-validate the steps for
    every key (RT-R6 scaling note: about 60% of a 100k x 100k join)."""
    if isinstance(steps, (list, tuple)):
        pos = 0
        for s in steps:
            if not isinstance(s, str):
                break
            try:
                pos = KEY_STEPS.index(s, pos) + 1
            except ValueError:
                break
        else:
            return steps
    return ordered_steps(steps)


def key_has_null(key):
    return any(part is None for part in key)


def _keys_hashable(key):
    """Dictionary key that keeps 1 (number) and "1" (text) apart but 1 == 1.0.

    Numbers are kept as they are, not converted with ``float()``: Python's
    ``int`` and ``float`` compare and hash exactly (1 == 1.0), while
    ``float()`` would merge BigInteger keys above 2**53 (RT6-Q-1)."""
    out = []
    for part in key:
        if isinstance(part, bool):
            out.append(("b", part))
        elif isinstance(part, (int, float)):
            out.append(("n", part))
        elif isinstance(part, str):
            out.append(("s", part))
        else:
            out.append(("o", repr(part)))
    return tuple(out)


def _keys_part_text(part):
    if part is None:
        return _KEYS_NULL_TEXT
    text = value_to_text(part)
    if isinstance(part, str) and (u"|" in text or text.startswith(u'"') or text == _KEYS_NULL_TEXT):
        return u'"' + text.replace(u'"', u'""') + u'"'
    return text


def key_text(key):
    """Readable text of a key tuple: parts joined by `` | ``; nulls shown as ``<null>``.

    A text part that contains ``|``, starts with ``"`` or is the text ``<null>`` is shown in
    double quotes with inner quotes doubled, so (``a | b``, ``c``) and (``a``, ``b | c``)
    print differently (RT-R4 N3). Numbers are not marked: the number 1 and the text ``"1"``
    both print as ``1`` (see ``type_step_gain``, R10-2)."""
    if key is None:
        return None
    return KEY_PART_SEPARATOR.join(_keys_part_text(p) for p in key)


# --------------------------------------------------------------------------
# Duplicates
# --------------------------------------------------------------------------

def find_duplicate_groups(rows, steps):
    """Group rows whose normalised keys are equal.

    ``rows`` is a list of ``(oid, key tuple)``. Returns ``(groups, nulls)``:
    ``groups`` is a list of dicts ``{"group", "norm_key", "members": [(oid,
    raw key), ...]}`` for keys shared by two or more rows, numbered 1.. in
    the order of their lowest OID; ``nulls`` lists the OIDs whose key has a
    null part (never grouped).
    """
    steps = ordered_steps(steps)
    buckets, norm_of, nulls = {}, {}, []
    for oid, key in sorted(rows, key=lambda r: r[0]):
        key = tuple(key)
        if key_has_null(key):
            nulls.append(oid)
            continue
        norm = normalise_key(key, steps)
        h = _keys_hashable(norm)
        buckets.setdefault(h, []).append((oid, key))
        norm_of.setdefault(h, norm)
    groups = []
    for h, members in buckets.items():
        if len(members) > 1:
            groups.append({"norm_key": norm_of[h], "members": members})
    groups.sort(key=lambda g: g["members"][0][0])
    for number, g in enumerate(groups, 1):
        g["group"] = number
    return groups, nulls


def group_assignment(groups):
    """``{oid: (group number, member count)}`` for every grouped row."""
    out = {}
    for g in groups:
        for oid, _key in g["members"]:
            out[oid] = (g["group"], len(g["members"]))
    return out


def group_lookup(groups, steps):
    """``{hashable normalised key: (group, count)}`` to label rows of a copy by value."""
    steps = ordered_steps(steps)
    out = {}
    for g in groups:
        out[_keys_hashable(normalise_key(g["members"][0][1], steps))] = (g["group"],
                                                                         len(g["members"]))
    return out


def group_for_key(lookup, key, steps):
    """``(DUP_GROUP, DUP_COUNT)`` for a raw key: ``(None, None)`` for a null key,
    ``(None, 1)`` for a unique key."""
    key = tuple(key)
    if key_has_null(key):
        return None, None
    return lookup.get(_keys_hashable(normalise_key(key, steps)), (None, 1))


def duplicate_detail_rows(groups):
    """Detail rows ``(DUP_GROUP, NORM_KEY, SRC_OID, RAW_KEY, DUP_COUNT)``."""
    out = []
    for g in groups:
        for oid, key in g["members"]:
            out.append((g["group"], key_text(g["norm_key"]), oid, key_text(key),
                        len(g["members"])))
    return out


# --------------------------------------------------------------------------
# Join diagnosis
# --------------------------------------------------------------------------

def _keys_count_distinct(keys):
    """Ordered ``[(raw key, count)]`` of distinct raw keys (first appearance order)."""
    order, counts, first = [], {}, {}
    for key in keys:
        key = tuple(key)
        h = _keys_hashable(key)
        if h not in counts:
            order.append(h)
            first[h] = key
            counts[h] = 0
        counts[h] += 1
    return [(first[h], counts[h]) for h in order]


def _keys_match_with(left, right, subset, with_nfc):
    """True when the keys are equal after the ``subset`` of steps (and NFC, before the steps
    and after each of them, when asked)."""
    a, b = (nfc_key(left), nfc_key(right)) if with_nfc else (tuple(left), tuple(right))
    for step in subset:
        a, b = apply_step(step, a, subset, with_nfc), apply_step(step, b, subset, with_nfc)
    return _keys_hashable(a) == _keys_hashable(b)


def explain_steps(left, right, steps):
    """Names of the steps (of the given prefix) that were needed to make the two keys
    equal; ``STEP_NFC`` first when canonical composition was needed.

    First the steps that changed either key are collected. When the keys do match
    after them, steps are then dropped one at a time (in the fixed order) as long as
    the keys still match without them, so the result is a set from which no step can
    be removed: a composite key (``Ab``, ``007``) against (``Ab``, ``7``) names
    LEADING_ZEROS only, although CASE also changed both sides (RT-R3 F2). Because steps
    are dropped earliest first, where two different steps could each fix the same
    difference the LATER one is kept and named (RT-R4 N4): alef + combining hamza +
    tatweel against precomposed alef-with-hamza names ARABIC_LETTERS, not NFC.

    The result cannot lose a step without the keys no longer matching, but it is not
    always the SMALLEST such set: another, smaller combination of steps can sometimes
    make the pair equal too (RT-R8 R8-1). When TRIM or LEADING_ZEROS is applied again
    after a later step (see ``apply_step``) and changes a key there, it counts as a step
    that changed the key (RT-R8 R8-2); likewise NFC is
    named when the re-composition after a step changed a key (``\u00df`` + acute against
    ``s\u015b`` after CASE gives ``NFC+CASE``) (RT-R9 R9-1)."""
    changed = set()
    a, b = nfc_key(left), nfc_key(right)
    if _keys_hashable(a) != _keys_hashable(tuple(left)) or \
            _keys_hashable(b) != _keys_hashable(tuple(right)):
        changed.add(STEP_NFC)
    for step in steps:
        a2, b2 = apply_step(step, a), apply_step(step, b)
        if _keys_hashable(a2) != _keys_hashable(a) or _keys_hashable(b2) != _keys_hashable(b):
            changed.add(step)
        for name, cleanup in _keys_cleanups(step, steps):
            a3, b3 = cleanup(a2), cleanup(b2)
            if _keys_hashable(a3) != _keys_hashable(a2) or \
                    _keys_hashable(b3) != _keys_hashable(b2):
                changed.add(name)
            a2, b2 = a3, b3
        a, b = a2, b2
    changed = [n for n in (STEP_NFC,) + KEY_STEPS if n in changed]
    if _keys_hashable(a) != _keys_hashable(b):
        return changed  # the keys do not match with these steps: nothing to prune
    needed = list(changed)
    for name in list(changed):
        rest = [n for n in needed if n != name]
        subset = [n for n in rest if n != STEP_NFC]
        if _keys_match_with(left, right, subset, STEP_NFC in rest):
            needed = rest
    return needed


def diagnose_join(left_keys, right_keys, steps):
    """Explain how the keys of two tables match.

    ``left_keys`` / ``right_keys`` are lists of key tuples (one per row).
    Returns a list of dicts ``{"left_key", "left_count", "status",
    "right_key", "right_count", "match_after"}``:

    * exact match -> MATCHED (one right row) or ONE_TO_MANY;
    * otherwise Unicode NFC and then the enabled steps are applied
      cumulatively to both sides and the first prefix at which the keys match
      gives WOULD_MATCH with ``match_after`` = the "+"-joined steps of that
      prefix that were needed (see ``explain_steps``; "NFC" when canonical
      composition was) and ``right_key`` = the first right key that matches at
      that prefix (the pair MATCH_AFTER explains). This is the partner found at the
      EARLIEST step in the fixed order, not the one that needs the fewest steps: left
      ``Ab1`` against `` ab1`` (TRIM+CASE) and ``Ab\u0661`` (DIGITS) shows `` ab1``
      (RT-R8 R8-1). ``right_count`` counts, and the
      row consumes, EVERY right key equal to the left key after ALL enabled steps,
      not only those that already match at that prefix: left ``x`` against right
      `` x`` and ``X`` gives RIGHT_COUNT 2 and neither is UNMATCHED_RIGHT, which is
      what a join of the normalised tables would give (RT-R7 R7-A);
    * no match -> UNMATCHED_LEFT; right keys that no exact or WOULD_MATCH row
      consumed -> UNMATCHED_RIGHT (a right key that equals an exactly MATCHED left
      key only after normalisation, such as ``01`` beside ``1``, stays listed);
    * a null part on either side -> NULL_KEY (never matches).

    Left rows come first in first-appearance order, then unmatched right
    keys, then right null keys.
    """
    steps = ordered_steps(steps)
    left = _keys_count_distinct(left_keys)
    right = _keys_count_distinct(right_keys)
    right_valid = [(k, c) for k, c in right if not key_has_null(k)]
    exact = dict((_keys_hashable(k), (k, c)) for k, c in right_valid)
    prefixes = []
    for n in range(0, len(steps) + 1):  # n = 0: NFC only
        index = {}
        for k, c in right_valid:
            index.setdefault(_keys_hashable(normalise_key(k, steps[:n])), []).append((k, c))
        prefixes.append((steps[:n], index))
    full_index = prefixes[-1][1]

    consumed = set()
    out = []
    for key, count in left:
        row = {"left_key": key, "left_count": count, "status": None, "right_key": None,
               "right_count": None, "match_after": None}
        out.append(row)
        if key_has_null(key):
            row["status"] = STATUS_NULL_KEY
            continue
        hit = exact.get(_keys_hashable(key))
        if hit is not None:
            row["right_key"], row["right_count"] = hit
            row["status"] = STATUS_MATCHED if hit[1] == 1 else STATUS_ONE_TO_MANY
            consumed.add(_keys_hashable(hit[0]))
            continue
        for prefix, index in prefixes:
            matches = index.get(_keys_hashable(normalise_key(key, prefix)))
            if matches:
                row["status"] = STATUS_WOULD_MATCH
                # Equal after a prefix implies equal after all steps, so the full-step
                # partners include ``matches``; the union only guards that invariant.
                partners = list(matches)
                seen = set(_keys_hashable(k) for k, _c in matches)
                for k, c in full_index.get(_keys_hashable(normalise_key(key, steps)), ()):
                    if _keys_hashable(k) not in seen:
                        seen.add(_keys_hashable(k))
                        partners.append((k, c))
                row["right_key"] = matches[0][0]
                row["right_count"] = sum(c for _k, c in partners)
                row["match_after"] = u"+".join(explain_steps(key, matches[0][0], prefix))
                consumed.update(seen)
                break
        if row["status"] is None:
            row["status"] = STATUS_UNMATCHED_LEFT
    for key, count in right_valid:
        if _keys_hashable(key) not in consumed:
            out.append({"left_key": None, "left_count": None, "status": STATUS_UNMATCHED_RIGHT,
                        "right_key": key, "right_count": count, "match_after": None})
    for key, count in right:
        if key_has_null(key):
            out.append({"left_key": None, "left_count": None, "status": STATUS_NULL_KEY,
                        "right_key": key, "right_count": count, "match_after": None})
    return out


def join_status_counts(rows):
    """``[(status, number of distinct keys)]`` in a fixed order for the summary."""
    order = (STATUS_MATCHED, STATUS_ONE_TO_MANY, STATUS_WOULD_MATCH, STATUS_UNMATCHED_LEFT,
             STATUS_UNMATCHED_RIGHT, STATUS_NULL_KEY)
    return [(s, sum(1 for r in rows if r["status"] == s)) for s in order]


def _keys_kind(part):
    """``"number"`` or ``"text"`` for a key part, ``None`` for anything else (null, date ...)."""
    if isinstance(part, bool):
        return None
    if isinstance(part, (int, float)):
        return "number"
    if isinstance(part, str):
        return "text"
    return None


def type_mismatch_positions(left_keys, right_keys):
    """Indexes of the key parts where one side holds numbers and the other side text.

    Without TYPE such a number never matches a text, although both can print the same
    (LONG ``1`` and TEXT ``"1"`` are both shown as ``1``) (R10-2)."""
    left_kinds, right_kinds = {}, {}
    for keys, kinds in ((left_keys, left_kinds), (right_keys, right_kinds)):
        for key in keys:
            for i, part in enumerate(key):
                kind = _keys_kind(part)
                if kind:
                    kinds.setdefault(i, set()).add(kind)
    out = []
    for i in sorted(set(left_kinds) & set(right_kinds)):
        a, b = left_kinds[i], right_kinds[i]
        if ("number" in a and "text" in b) or ("text" in a and "number" in b):
            out.append(i)
    return out


def type_step_gain(left_keys, right_keys, steps, rows=None):
    """``(positions, gain)`` for a join diagnosis run WITHOUT the TYPE step.

    ``positions``: ``type_mismatch_positions`` (empty when TYPE is among ``steps``, or when no
    key part has numbers on one side and text on the other). ``gain``: the number of distinct
    left keys that are UNMATCHED_LEFT with ``steps`` but would match (exactly or WOULD_MATCH)
    with TYPE added; 0 when ``positions`` is empty (the second diagnosis is then not run).
    ``rows``: the result of ``diagnose_join(left_keys, right_keys, steps)`` when already known
    (R10-2)."""
    steps = ordered_steps(steps)
    if STEP_TYPE in steps:
        return [], 0
    positions = type_mismatch_positions(left_keys, right_keys)
    if not positions:
        return [], 0
    if rows is None:
        rows = diagnose_join(left_keys, right_keys, steps)
    unmatched = set(_keys_hashable(r["left_key"]) for r in rows
                    if r["status"] == STATUS_UNMATCHED_LEFT)
    with_type = diagnose_join(left_keys, right_keys, list(steps) + [STEP_TYPE])
    gain = sum(1 for r in with_type if r["left_key"] is not None and
               r["status"] != STATUS_UNMATCHED_LEFT and
               _keys_hashable(r["left_key"]) in unmatched)
    return positions, gain


# ==========================================================================
# quality/geometry_quality_core.py
# ==========================================================================
# Pure logic of the Geometry Quality Checker (no arcpy).
#
# Checks lines and polygons for problems that the built-in Check Geometry tool
# does not look for, and returns one *issue* per problem with a location:
#
# * ``SPIKE``: the angle between the two segments at a vertex is below
#   ``min_angle_deg`` (catches inward and outward spikes; 180 deg = straight);
#   with ``max_tip_width_m`` > 0 also a *blunt* spike whose tip is a segment of
#   at most that length: the tip is collapsed to its middle and the angle at
#   that middle between the vertices before and after the tip is tested
#   (R4-N1: a two-vertex tip has two vertex angles near 90 deg);
# * ``NEAR_DUP_VERTEX``: a segment of length 0 < len <= ``near_dup_tol_m``
#   (exact duplicates, len = 0, are Check Geometry's job and not reported);
# * ``SHORT_SEGMENT``: ``near_dup_tol_m`` < len < ``min_segment_m`` (one
#   test, so a segment is never reported twice);
# * ``SLIVER``: thinness 4*pi*A/P^2 of a polygon part (outer ring and its
#   holes) below ``max_thinness``; each part is measured on its own, so a
#   multipart feature of compact parts is not a sliver;
# * ``TINY_AREA``: polygon area below ``min_area_m2``;
# * ``TINY_PART``: a part of a multipart polygon holding less than
#   ``min_part_share_pct`` percent of the area;
# * ``REMOTE_PART``: a part further than ``max_part_distance_m`` from the
#   largest part (``part_distance``: the distance between the two areas,
#   holes of both parts included).
#
# Geometry must already be in a metric (projected) system; ``meters_per_unit``
# converts coordinate units to metres. Vertex numbers are 0-based within the
# ring or path (the closing vertex of a ring is not counted again); part
# numbers are 1-based (polygon parts in ``group_rings`` order, holes belong to
# their part and are not parts).

CHECK_SPIKE = "SPIKE"
CHECK_NEAR_DUP_VERTEX = "NEAR_DUP_VERTEX"
CHECK_SHORT_SEGMENT = "SHORT_SEGMENT"
CHECK_SLIVER = "SLIVER"
CHECK_TINY_AREA = "TINY_AREA"
CHECK_TINY_PART = "TINY_PART"
CHECK_REMOTE_PART = "REMOTE_PART"
GEOMETRY_CHECKS = (CHECK_SPIKE, CHECK_NEAR_DUP_VERTEX, CHECK_SHORT_SEGMENT, CHECK_SLIVER,
                   CHECK_TINY_AREA, CHECK_TINY_PART, CHECK_REMOTE_PART)

DEFAULT_GEOMETRY_OPTIONS = {"checks": GEOMETRY_CHECKS, "min_angle_deg": 10.0,
                            "max_tip_width_m": 0.0, "near_dup_tol_m": 0.01,
                            "min_segment_m": 0.0, "max_thinness": 0.1,
                            "min_area_m2": 0.0, "min_part_share_pct": 1.0,
                            "max_part_distance_m": 0.0}


def geometry_options(**overrides):
    """Options dict: defaults updated with ``overrides`` (``None`` values ignored)."""
    opts = dict(DEFAULT_GEOMETRY_OPTIONS)
    for key, value in overrides.items():
        if key not in opts:
            raise KeyError(key)
        if value is not None:
            opts[key] = value
    opts["checks"] = tuple(c for c in GEOMETRY_CHECKS if c in set(opts["checks"]))
    return opts


def geometry_number_text(value):
    """``value`` with 4 significant digits and never an exponent: 12345.6 -> '12346',
    0.00005 -> '0.00005' (``'{:.4g}'`` gives '1.235e+04' / '5e-05', which reads badly in
    a DETAIL sentence about an area or a distance)."""
    value = float(value)
    if value == 0.0 or not math.isfinite(value):
        return "{0:g}".format(value)
    digits = max(0, 3 - int(math.floor(math.log10(abs(value)))))
    text = "{0:.{1}f}".format(value, digits)
    if "." in text:
        text = text.rstrip("0").rstrip(".")
    return text


def geometry_thinness(area, perimeter):
    """Isoperimetric ratio 4*pi*A/P^2: 1 for a circle, ~0.785 for a square, ->0 for slivers."""
    if perimeter <= 0:
        return 0.0
    return 4.0 * math.pi * area / (perimeter * perimeter)


def polygon_part_shares(groups):
    """``[(part index, area, share percent)]`` for ``group_rings`` output."""
    areas = [max(abs(ring_signed_area(o)) - sum(abs(ring_signed_area(h)) for h in hs), 0.0)
             for o, hs in groups]
    total = sum(areas)
    return [(i, a, (100.0 * a / total) if total > 0 else 0.0) for i, a in enumerate(areas)]


def segment_gap(a, b, c, d):
    """Shortest distance between segments a-b and c-d (0 if they touch or cross)."""
    if segment_intersection(a, b, c, d) is not None:
        return 0.0
    return min(point_segment_distance(a, c, d)[0], point_segment_distance(b, c, d)[0],
               point_segment_distance(c, a, b)[0], point_segment_distance(d, a, b)[0])


def _gq_bbox(rings):
    xs = [p[0] for r in rings for p in r]
    ys = [p[1] for r in rings for p in r]
    return min(xs), min(ys), max(xs), max(ys)


_GQ_CHUNK = 32  # consecutive segments per block in boundary_distance


def _gq_blocks(rings):
    """Runs of up to ``_GQ_CHUNK`` consecutive segments with their bounding box."""
    blocks = []
    for r in rings:
        for start in range(0, len(r) - 1, _GQ_CHUNK):
            pts = r[start:start + _GQ_CHUNK + 1]
            if len(pts) < 2:
                continue
            xs = [p[0] for p in pts]
            ys = [p[1] for p in pts]
            blocks.append(((min(xs), min(ys), max(xs), max(ys)),
                           [(pts[i], pts[i + 1]) for i in range(len(pts) - 1)]))
    return blocks


def _gq_box_gap(a, b):
    """Distance between two boxes ``(xmin, ymin, xmax, ymax)`` (0 if they overlap)."""
    gx = max(0.0, b[0] - a[2], a[0] - b[2])
    gy = max(0.0, b[1] - a[3], a[1] - b[3])
    return math.hypot(gx, gy)


_GQ_FANOUT = 16  # child nodes per node of a boundary tree


def boundary_tree(rings):
    """Bounding-box tree of the boundary of ``rings`` for ``boundary_distance``.

    Leaves are blocks of consecutive segments (``_gq_blocks``); each level up
    groups ``_GQ_FANOUT`` consecutive nodes, which along a ring are also close
    in space. Returns the top nodes ``(box, segments or None, children or None)``.
    Build it once and pass it to every ``boundary_distance`` call against the
    same rings (e.g. every part of a feature against its largest part).
    """
    nodes = [(box, segs, None) for box, segs in _gq_blocks(rings)]
    while len(nodes) > _GQ_FANOUT:
        level = []
        for start in range(0, len(nodes), _GQ_FANOUT):
            group = nodes[start:start + _GQ_FANOUT]
            box = (min(n[0][0] for n in group), min(n[0][1] for n in group),
                   max(n[0][2] for n in group), max(n[0][3] for n in group))
            level.append((box, None, group))
        nodes = level
    return nodes


def boundary_distance(rings_a, rings_b, tree_b=None):
    """Shortest distance between the boundaries of two sets of rings.

    Best-first branch and bound: ``rings_a`` is cut into blocks of consecutive
    segments, ``rings_b`` into a bounding-box tree (``boundary_tree``, or
    ``tree_b`` when already built). Pairs of an ``a`` block and a tree node
    are visited nearest first (by bounding-box gap, a lower bound of the
    distance), nodes are opened into their children, and the search stops
    as soon as the next gap is not shorter than the best distance found. A
    small part next to a long coastline therefore only visits the few nearby
    blocks, and the coastline is indexed once however many parts are checked.
    """
    blocks_a = _gq_blocks(rings_a)
    nodes_b = boundary_tree(rings_b) if tree_b is None else tree_b
    heap = []
    order = 0
    for ia, ba in enumerate(blocks_a):
        for node in nodes_b:
            heap.append((_gq_box_gap(ba[0], node[0]), order, ia, node))
            order += 1
    heapq.heapify(heap)
    best = None
    while heap:
        gap, _order, ia, node = heapq.heappop(heap)
        if best is not None and gap >= best:
            break
        if node[2] is not None:
            for child in node[2]:
                child_gap = _gq_box_gap(blocks_a[ia][0], child[0])
                if best is None or child_gap < best:
                    heapq.heappush(heap, (child_gap, order, ia, child))
                    order += 1
            continue
        for a, b in blocks_a[ia][1]:
            box_a = (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1]))
            for c, d in node[1]:
                if best is not None:
                    box_c = (min(c[0], d[0]), min(c[1], d[1]), max(c[0], d[0]), max(c[1], d[1]))
                    if _gq_box_gap(box_a, box_c) >= best:
                        continue
                dist = segment_gap(a, b, c, d)
                if best is None or dist < best:
                    best = dist
    return best if best is not None else 0.0


def _gq_inside_part(p, outer, holes):
    """True when ``p`` is strictly inside the part ``outer`` minus ``holes`` (ray casting)."""
    if point_in_ring(p, outer) != "in":
        return False
    return not any(point_in_ring(p, h) != "out" for h in holes)


def _gq_tree_inside(p, tree):
    """Even-odd ray test of ``p`` against every ring of a ``boundary_tree`` (outer and holes), so
    True means inside the part's area. Only nodes whose box straddles the ray are opened, so a
    large part is not scanned vertex by vertex for each small part (RT4 cost)."""
    x, y = p
    inside = False
    stack = list(tree)
    while stack:
        box, segs, children = stack.pop()
        if box[1] > y or box[3] < y or box[2] < x:
            continue
        if children is not None:
            stack.extend(children)
            continue
        for (ax, ay), (bx, by) in ((tuple(a[:2]), tuple(b[:2])) for a, b in segs):
            if (ay > y) != (by > y) and x < ax + (y - ay) * (bx - ax) / (by - ay):
                inside = not inside
    return inside


def part_distance(part_a, part_b, tree_b=None):
    """Shortest distance between two polygon parts ``(outer, holes)``, as the distance between the
    two areas: 0 when they touch, cross or one lies inside the other.

    R8-D2: every ring of BOTH parts counts. A part shaped like a frame (or a moat) around the
    other part is nearest to it along its HOLE ring, not its outer ring, so the holes of the
    checked part are measured too (the holes of ``part_b`` are in ``tree_b``). When the boundaries
    are apart (distance > 0) the parts either are disjoint or one lies wholly inside the other
    (outside its holes; invalid data: overlapping parts); one vertex of each outer ring tells
    which (the larger part ``part_b`` through its tree), and the second case gives 0 like the
    distance between the two areas."""
    outer_a, holes_a = part_a
    outer_b, holes_b = part_b
    tree_b = tree_b if tree_b is not None else boundary_tree([outer_b] + list(holes_b))
    dist = boundary_distance([outer_a] + list(holes_a), None, tree_b)
    if dist > 0 and (_gq_tree_inside(tuple(outer_a[0][:2]), tree_b) or
                     _gq_inside_part(tuple(outer_b[0][:2]), outer_a, holes_a)):
        return 0.0
    return dist


def _gq_distinct_vertices(path, closed):
    """``[(original index, point)]`` without consecutive exact duplicates
    (and without the closing vertex of a ring)."""
    pts = [tuple(p) for p in path]
    if closed and len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    out = []
    for i, p in enumerate(pts):
        if out and out[-1][1] == p:
            continue
        out.append((i, p))
    if closed and len(out) > 1 and out[0][1] == out[-1][1]:
        out.pop()
    return out


def path_spikes(path, closed, min_angle):
    """``[(vertex index, point, angle)]`` with angle < ``min_angle`` degrees."""
    verts = _gq_distinct_vertices(path, closed)
    n = len(verts)
    out = []
    if n < 3:
        return out
    indices = range(n) if closed else range(1, n - 1)
    for k in indices:
        prev, cur, nxt = verts[k - 1][1], verts[k][1], verts[(k + 1) % n][1]
        ang = vertex_angle(prev, cur, nxt)
        if ang is not None and ang < min_angle:
            out.append((verts[k][0], cur, ang))
    return out


def path_blunt_spikes(path, closed, min_angle, max_tip, meters_per_unit=1.0):
    """``[(tip start index, tip end index, tip middle, angle, tip length m)]`` for blunt spikes.

    A tip is a segment B-C of at most ``max_tip`` metres (and more than 0) between the
    vertices A (before B) and D (after C). B and C are replaced by the tip middle M and
    the angle A-M-D is tested against ``min_angle``. A tip whose own vertex B or C is
    already a sharp vertex (angle below ``min_angle``) is left to the vertex test, so a
    spike is not reported twice. Tips of three or more vertices are not looked at."""
    out = []
    if not max_tip or max_tip <= 0:
        return out
    verts = _gq_distinct_vertices(path, closed)
    n = len(verts)
    if n < 4:
        return out
    indices = range(n) if closed else range(1, n - 2)
    for k in indices:
        a, b = verts[k - 1][1], verts[k][1]
        c, d = verts[(k + 1) % n][1], verts[(k + 2) % n][1]
        tip = point_distance(b, c) * meters_per_unit
        if not 0 < tip <= max_tip:
            continue
        sharp_b = vertex_angle(a, b, c)
        sharp_c = vertex_angle(b, c, d)
        if (sharp_b is not None and sharp_b < min_angle) or \
                (sharp_c is not None and sharp_c < min_angle):
            continue
        mid = ((b[0] + c[0]) / 2.0, (b[1] + c[1]) / 2.0)
        ang = vertex_angle(a, mid, d)
        if ang is not None and ang < min_angle:
            out.append((verts[k][0], verts[(k + 1) % n][0], mid, ang, tip))
    return out


def _gq_issue(oid, check, part, vertex, value, unit, detail, point):
    return {"oid": oid, "check": check, "part": part, "vertex": vertex, "value": value,
            "unit": unit, "detail": detail, "point": point}


def _gq_path_checks(oid, path, closed, part, ring_label, opts, mpu):
    """Spike and segment checks of one path or ring."""
    out = []
    checks = opts["checks"]
    if CHECK_SPIKE in checks:
        for idx, pt, ang in path_spikes(path, closed, opts["min_angle_deg"]):
            out.append(_gq_issue(oid, CHECK_SPIKE, part, idx, ang, "deg",
                                 "Angle {0} deg at vertex {1} of {2}.".format(
                                     geometry_number_text(ang), idx, ring_label), pt))
        # R4-N1: a spike whose tip has two vertices (both vertex angles near 90 deg)
        for i, j, mid, ang, tip in path_blunt_spikes(path, closed, opts["min_angle_deg"],
                                                     opts.get("max_tip_width_m", 0.0), mpu):
            out.append(_gq_issue(oid, CHECK_SPIKE, part, i, ang, "deg",
                                 "Blunt spike: tip of {0} m between vertices {1} and {2} of {3}; "
                                 "angle {4} deg at the tip middle.".format(
                                     geometry_number_text(tip), i, j, ring_label,
                                     geometry_number_text(ang)), mid))
    near = CHECK_NEAR_DUP_VERTEX in checks
    short = CHECK_SHORT_SEGMENT in checks and opts["min_segment_m"] > 0
    if near or short:
        tol = opts["near_dup_tol_m"]
        n_vertices = len(path) - 1 if closed else len(path)
        for i in range(len(path) - 1):
            a, b = path[i], path[i + 1]
            length = point_distance(a, b) * mpu
            if length <= 0:
                continue
            if length <= tol:
                if near:
                    out.append(_gq_issue(oid, CHECK_NEAR_DUP_VERTEX, part, i, length, "m",
                                         "Vertices {0} and {1} of {2} are {3} m apart.".format(
                                             i, (i + 1) % n_vertices if closed else i + 1,
                                             ring_label, geometry_number_text(length)), tuple(a)))
            elif short and length < opts["min_segment_m"]:
                mid = ((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0)
                out.append(_gq_issue(oid, CHECK_SHORT_SEGMENT, part, i, length, "m",
                                     "Segment from vertex {0} of {1} is {2} m long.".format(
                                         i, ring_label, geometry_number_text(length)), mid))
    return out


_GQ_ON_EDGE_REL = 1e-9     # an anchor this close to the boundary (x part size) counts as "on it"
_GQ_EDGE_PROBES = 512      # at most this many edges are probed by the last fallback


def _gq_interior_point(outer, holes):
    """Point of the part for SLIVER / TINY_AREA / TINY_PART / REMOTE_PART: the pole of
    inaccessibility, and never a point on the boundary when the part has an interior.

    R7-m1: with the coarse precision (size / 100) the shared search may stop at its first
    guess (centroid or bbox centre) when that guess lies exactly on an edge (signed distance
    ~1e-15, e.g. a comb whose bbox centre is on a tooth edge). For such a result a point just
    inside the boundary is taken instead: edge midpoints moved inwards, the candidate with
    the largest clearance (the shared search has since been fixed the same way)."""
    rings = [outer] + list(holes)
    x0, y0, x1, y1 = _gq_bbox([outer])
    size = max(x1 - x0, y1 - y0)
    anchor = polygon_anchor(rings, precision=max(size / 100.0, 1e-9))
    if not anchor:
        return tuple(outer[0])
    eps = _GQ_ON_EDGE_REL * size
    if anchor["distance"] > eps or size <= 0:
        return anchor["point"]
    probe = _gq_edge_probe_point(rings, size)
    return probe if probe is not None else anchor["point"]


def _gq_edge_probe_point(rings, size):
    """Edge midpoints moved inwards by a fraction of the edge length: the candidate with the
    largest positive signed distance, or ``None`` when no candidate is inside."""
    segs = []
    for ring in rings:
        pts = [tuple(p) for p in ring]
        if len(pts) > 1 and pts[0] == pts[-1]:
            pts = pts[:-1]
        for i in range(len(pts)):
            a, b = pts[i], pts[(i + 1) % len(pts)]
            if a != b:
                segs.append((a, b))
    if not segs:
        return None
    grid = SegmentGrid(segs)
    step = max(1, len(segs) // _GQ_EDGE_PROBES)
    eps = _GQ_ON_EDGE_REL * size
    best, best_d = None, eps
    for a, b in segs[::step]:
        dx, dy = b[0] - a[0], b[1] - a[1]
        length = math.hypot(dx, dy)
        mx, my = (a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0
        for frac in (0.25, 0.05, 1e-3, 1e-6):
            off = length * frac
            for sign in (1.0, -1.0):
                q = (mx - sign * dy / length * off, my + sign * dx / length * off)
                d = grid.signed_distance(q)
                if d > best_d:
                    best, best_d = q, d
    return best


def check_geometry(oid, kind, geom, opts=None, meters_per_unit=1.0):
    """All enabled checks for one feature; returns a list of issue dicts
    ``{"oid", "check", "part", "vertex", "value", "unit", "detail", "point"}``
    (``point`` in the input coordinates). ``geom`` ``None`` gives ``[]``."""
    opts = opts or geometry_options()
    mpu = float(meters_per_unit)
    out = []
    if geom is None:
        return out
    checks = opts["checks"]
    if kind == GEOM_POLYLINE:
        for p_idx, path in enumerate(geom, 1):
            closed = len(path) >= 4 and tuple(path[0]) == tuple(path[-1])
            out.extend(_gq_path_checks(oid, path, closed, p_idx, "path {0}".format(p_idx),
                                       opts, mpu))
        return out
    if kind != GEOM_POLYGON:
        return out
    groups = group_rings(geom)
    for p_idx, (outer, holes) in enumerate(groups, 1):
        for r_idx, ring in enumerate([outer] + list(holes), 1):
            label = "ring {0} of part {1}".format(r_idx, p_idx) if r_idx == 1 else \
                "ring {0} (hole) of part {1}".format(r_idx, p_idx)
            out.extend(_gq_path_checks(oid, ring, True, p_idx, label, opts, mpu))
    shares = polygon_part_shares(groups)
    if not shares:
        return out
    area = sum(a for _i, a, _s in shares) * mpu * mpu
    largest = max(shares, key=lambda s: (s[1], -s[0]))[0]
    if CHECK_SLIVER in checks:
        # Thinness per part (outer ring and its holes): a multipart feature of
        # compact parts is not a sliver (RT6-Q-2); each thin part is reported.
        for idx, part_area, _share in shares:
            outer, holes = groups[idx]
            part_area_m2 = part_area * mpu * mpu
            perimeter = sum(path_length(r) for r in [outer] + list(holes)) * mpu
            ratio = geometry_thinness(part_area_m2, perimeter)
            if ratio < opts["max_thinness"]:
                label = "" if len(groups) == 1 else " of part {0}".format(idx + 1)
                out.append(_gq_issue(oid, CHECK_SLIVER, idx + 1, None, ratio, "ratio",
                                     "Thinness 4*pi*A/P^2{0} = {1} (area {2} m2, "
                                     "perimeter {3} m).".format(label, geometry_number_text(ratio),
                                                                geometry_number_text(part_area_m2),
                                                                geometry_number_text(perimeter)),
                                     _gq_interior_point(outer, holes)))
    if CHECK_TINY_AREA in checks and opts["min_area_m2"] > 0 and area < opts["min_area_m2"]:
        out.append(_gq_issue(oid, CHECK_TINY_AREA, None, None, area, "m2",
                             "Area {0} m2.".format(geometry_number_text(area)), _gq_interior_point(*groups[largest])))
    if len(groups) > 1:
        largest_tree = None  # boundary of the largest part, indexed once per feature
        for idx, part_area, share in shares:
            if idx == largest:
                continue
            outer, holes = groups[idx]
            if CHECK_TINY_PART in checks and share < opts["min_part_share_pct"]:
                out.append(_gq_issue(oid, CHECK_TINY_PART, idx + 1, None, share, "%",
                                     "Part {0} holds {1}% of the area ({2} m2).".format(
                                         idx + 1, geometry_number_text(share),
                                         geometry_number_text(part_area * mpu * mpu)),
                                     _gq_interior_point(outer, holes)))
            if CHECK_REMOTE_PART in checks and opts["max_part_distance_m"] > 0:
                if largest_tree is None:
                    big_outer, big_holes = groups[largest]
                    largest_tree = boundary_tree([big_outer] + list(big_holes))
                # R8-D2: all rings of the part (a frame around the largest part is nearest
                # along its hole), and 0 when one part lies inside the other
                dist = part_distance((outer, holes), groups[largest], largest_tree) * mpu
                if dist > opts["max_part_distance_m"]:
                    out.append(_gq_issue(oid, CHECK_REMOTE_PART, idx + 1, None, dist, "m",
                                         "Part {0} is {1} m from the largest part {2}.".format(
                                             idx + 1, geometry_number_text(dist), largest + 1),
                                         _gq_interior_point(outer, holes)))
    return out


POLYGON_ONLY_CHECKS = (CHECK_SLIVER, CHECK_TINY_AREA, CHECK_TINY_PART, CHECK_REMOTE_PART)


def unused_check_notes(kind, opts):
    """Warning texts for checks the user picked but that cannot find anything.

    Only for an explicit choice (fewer than all seven checks): with the default
    selection a threshold of 0 simply means "off" (documented) and a line layer
    simply has no area checks, so nothing is said. A narrowed selection that ends
    in "0 problems found" for such a reason would read as a clean result."""
    chosen = opts["checks"]
    if set(chosen) == set(GEOMETRY_CHECKS):
        return []
    notes = []
    if kind == GEOM_POLYLINE:
        lines_out = [c for c in chosen if c in POLYGON_ONLY_CHECKS]
        if lines_out:
            notes.append("{0} apply to polygons only and find nothing in a line layer.".format(
                ", ".join(lines_out)))
    else:
        for check, key, label in ((CHECK_TINY_AREA, "min_area_m2", "Minimum area (m2)"),
                                  (CHECK_REMOTE_PART, "max_part_distance_m",
                                   "Maximum part distance (m)")):
            if check in chosen and not opts[key] > 0:
                notes.append("{0} is selected but {1} is 0 (off), so it finds nothing. "
                             "Give a value above 0.".format(check, label))
    if CHECK_SHORT_SEGMENT in chosen and not opts["min_segment_m"] > 0:
        notes.append("SHORT_SEGMENT is selected but Minimum segment length (m) is 0 (off), so "
                     "it finds nothing. Give a value larger than the near-duplicate tolerance.")
    return notes


_GQ_ZERO_MEANS_NOTHING = {CHECK_SPIKE: "min_angle_deg", CHECK_NEAR_DUP_VERTEX: "near_dup_tol_m",
                          CHECK_SLIVER: "max_thinness", CHECK_TINY_PART: "min_part_share_pct"}


def checks_run_summary(kind, opts):
    """One information sentence: which checks run on this layer and which do nothing because their
    threshold is 0 (off) or unusable, or because they apply to polygons only (R3-F3). A first run with
    the defaults gives "0 problems" when only SPIKE, NEAR_DUP_VERTEX, SLIVER and TINY_PART can fire; this
    sentence tells the user so."""
    ran, off, line_only = [], [], []
    for check in GEOMETRY_CHECKS:
        if check not in opts["checks"]:
            continue
        if kind == GEOM_POLYLINE and check in POLYGON_ONLY_CHECKS:
            line_only.append(check)
        elif check == CHECK_TINY_AREA and not opts["min_area_m2"] > 0:
            off.append(check)
        elif check == CHECK_REMOTE_PART and not opts["max_part_distance_m"] > 0:
            off.append(check)
        elif check == CHECK_SHORT_SEGMENT and not opts["min_segment_m"] > opts["near_dup_tol_m"]:
            off.append(check)
        elif check in _GQ_ZERO_MEANS_NOTHING and not opts[_GQ_ZERO_MEANS_NOTHING[check]] > 0:
            # R7-m5: a threshold of 0 (or less) cannot fire: angle < 0, 0 < length <= 0,
            # thinness < 0 and share < 0 are all impossible.
            off.append(check)
        else:
            ran.append(check)
    text = "Checks that ran: {0}.".format(", ".join(ran) if ran else "none")
    if off:
        text += (" Not run because their threshold is 0 (off) or not usable: {0}. Give a value "
                 "above 0 (SHORT_SEGMENT: above the near-duplicate tolerance) to switch "
                 "them on.".format(", ".join(off)))
    if line_only:
        text += " Polygon-only checks, nothing to do on a line layer: {0}.".format(
            ", ".join(line_only))
    if CHECK_SPIKE in ran:
        if opts.get("max_tip_width_m", 0.0) > 0:
            text += (" SPIKE also tests blunt tips (a tip segment up to {0} m).".format(
                geometry_number_text(opts["max_tip_width_m"])))
        else:
            text += (" SPIKE tests single vertices only: a spike with a two-vertex (blunt) tip is "
                     "not found while Maximum spike tip width (m) is 0 (off).")
    return text


THINNESS_FLAGS_ALL_TEXT = ("Maximum sliver thinness is 1 or more, so every polygon part is reported as "
                           "SLIVER: the thinness 4*pi*A/P^2 of a ring never reaches 1 (only a circle has "
                           "1, a square about 0.785). Give a value below 1, such as the default 0.1.")


def thinness_flags_everything(checks, max_thinness):
    """True when SLIVER is selected and ``max_thinness`` >= 1, so every polygon part is a SLIVER.

    The isoperimetric inequality (Banchoff-Pohl for rings that are not simple) gives
    4*pi*|A| <= P^2 for every closed ring, and a part's net area (outer minus holes) is not larger
    than its outer ring's while its perimeter only grows, so ``geometry_thinness`` is below 1 for
    every polygon part (a polygon is never a circle; a part with no perimeter gives 0). One rule for
    the dialog and the run (R11-M2)."""
    return CHECK_SLIVER in checks and max_thinness is not None and float(max_thinness) >= 1.0


def has_nonfinite_coordinate(shape):
    """True when any vertex of ``shape`` (parts of (x, y, ...) points) is NaN or infinite."""
    for part in shape:
        for point in part:
            if not (math.isfinite(point[0]) and math.isfinite(point[1])):
                return True
    return False


def geometry_summary(issues, features, nulls, skipped, nonfinite=()):
    """Summary rows ``(item, value)``.

    R5-D1: features with NaN or infinite coordinates are not checked; they get their own
    count so that read = checked + null + non-finite + true-curve adds up in the report.
    """
    summary = [("Features read", features), ("Null or empty geometries", len(nulls)),
               ("NaN or infinite-coordinate features skipped", len(nonfinite)),
               ("True-curve features skipped", len(skipped)), ("Issues", len(issues))]
    for check in GEOMETRY_CHECKS:
        summary.append((check, sum(1 for i in issues if i["check"] == check)))
    return summary


# ==========================================================================
# quality/bilingual_names_core.py
# ==========================================================================
# Pure logic of the Arabic-English Name Check tool (no arcpy).
#
# Checks pairs of English / Arabic name fields:
#
# * ``MISSING_EN`` / ``MISSING_AR``: null, empty or whitespace-only value; on request
#   (``placeholders_as_missing``) also a placeholder such as "-", "N/A", "0", "...", "؟"
#   (``is_placeholder_name``), which is then left out of every other check;
# * ``WRONG_SCRIPT_EN``: the English value contains Arabic letters;
# * ``WRONG_SCRIPT_AR``: the Arabic value has no Arabic letters but has Latin
#   letters (Latin and fullwidth Latin) (short codes such as "A1" or "M٤" do not count when allowed; a Latin brand
#   name can be accepted: it equals the English value of the row, or it is in
#   the allow-list);
# * ``SWAPPED``: both of the above at once AND the English value has no Latin
#   letters (reported once instead of twice). A mixed English value such as
#   "Al Baik <arabic>" with a Latin Arabic value is not a swap: it is reported
#   as the two wrong-script issues;
# * ``MIXED_DIGITS``: Arabic-Indic or Persian digits in the English value, or two digit
#   systems (ASCII, Arabic-Indic U+0660-0669, Persian U+06F0-06F9) mixed in the Arabic value;
# * ``INCONSISTENT_PAIR``: the same English name (after trim + case folding)
#   appears with different Arabic names, or the reverse; every row of such a
#   group is reported. Without ``placeholders_as_missing`` a placeholder is a name here
#   too: rows that share "-" are one group (``placeholder_pair_values`` names such values).
#
# Punctuation, spaces and digits are script-neutral. Presentation forms and
# Persian letters count as Arabic (``common.text.script_profile``); so do the letters of
# Arabic Extended-B (U+0870-088E), Arabic Extended-C (U+10EC0-10EFF; letters only, never its
# marks U+10EFC-10EFF, on every Python build) and the Arabic mathematical alphabetic symbols (U+1EE00-1EEFF), which the shared profile does not cover
# (``bilingual_script_profile``). English names are compared with typographic apostrophes,
# quotes and dashes folded to their ASCII forms ("King’s" = "King's").

CHECK_MISSING = "MISSING"
CHECK_WRONG_SCRIPT = "WRONG_SCRIPT"
CHECK_SWAPPED = "SWAPPED"
CHECK_MIXED_DIGITS = "MIXED_DIGITS"
CHECK_INCONSISTENT_PAIR = "INCONSISTENT_PAIR"
BILINGUAL_CHECKS = (CHECK_MISSING, CHECK_WRONG_SCRIPT, CHECK_SWAPPED, CHECK_MIXED_DIGITS,
                    CHECK_INCONSISTENT_PAIR)

ISSUE_MISSING_EN = "MISSING_EN"
ISSUE_MISSING_AR = "MISSING_AR"
ISSUE_WRONG_SCRIPT_EN = "WRONG_SCRIPT_EN"
ISSUE_WRONG_SCRIPT_AR = "WRONG_SCRIPT_AR"
ISSUE_SWAPPED = "SWAPPED"
ISSUE_MIXED_DIGITS = "MIXED_DIGITS"
ISSUE_INCONSISTENT_PAIR = "INCONSISTENT_PAIR"
BILINGUAL_ISSUES = (ISSUE_MISSING_EN, ISSUE_MISSING_AR, ISSUE_WRONG_SCRIPT_EN,
                    ISSUE_WRONG_SCRIPT_AR, ISSUE_SWAPPED, ISSUE_MIXED_DIGITS,
                    ISSUE_INCONSISTENT_PAIR)

CODE_TOKEN_MAX = 6

# Arabic-script letters outside the blocks of ``common.text.script_profile``:
# (first, last, fixed letter table). Arabic Extended-B and -C are newer than the Unicode data
# of some Python builds (Python 3.9 has Unicode 13, Python 3.11 in ArcGIS Pro 3.3 has Unicode
# 14), where their letters are still "unassigned". So that the result does not depend on the
# Python build, a fixed table of the LETTERS of these blocks (Unicode 16) is counted on every
# Python; marks and symbols of the blocks (U+0888, U+0890-089F, U+10EFC-10EFF) never count,
# assigned or not. A letter that a newer Python knows (category L) counts too.
_BILINGUAL_EXTRA_LETTERS = frozenset(
    list(range(0x0870, 0x0888)) + list(range(0x0889, 0x088F)) +   # Extended-B, Unicode 14
    list(range(0x10EC2, 0x10EC5)))                                 # Extended-C, Unicode 16
_BILINGUAL_EXTRA_ARABIC = ((0x0870, 0x088E, True), (0x10EC0, 0x10EFF, True),
                           (0x1EE00, 0x1EEFF, False))

# Typographic punctuation folded to ASCII in English comparison keys.
_BILINGUAL_EN_PUNCT = dict(
    [(c, u"'") for c in (0x2018, 0x2019, 0x201A, 0x201B, 0x02BC, 0x02B9, 0x2032, 0x00B4,
                         0x0060, 0xFF07)] +
    [(c, u'"') for c in (0x201C, 0x201D, 0x201E, 0x201F, 0x2033, 0xFF02)] +
    [(c, u"-") for c in (0x2010, 0x2011, 0x2012, 0x2013, 0x2014, 0x2015, 0x2212, 0xFE63,
                         0xFF0D)])

# Placeholders besides ``common.text.TEXT_DEFAULT_PLACEHOLDERS`` (compared after trim,
# whitespace collapse, digit folding and casefold): Arabic spellings of "unknown" / "none".
BILINGUAL_PLACEHOLDERS = frozenset([
    u"؟", u"؟؟", u"غير معروف",
    u"غير محدد", u"لا يوجد",
    u"بدون", u"بدون اسم",
    u"لا يوجد اسم"])
_BILINGUAL_TATWEEL = u"\u0640"


def _bilingual_extra_arabic(ch):
    code = ord(ch)
    for lo, hi, unassigned in _BILINGUAL_EXTRA_ARABIC:
        if lo <= code <= hi:
            if unassigned and code in _BILINGUAL_EXTRA_LETTERS:
                return True
            return unicodedata.category(ch).startswith("L")
    return False


def bilingual_script_profile(text):
    """``common.text.script_profile`` plus the Arabic letters of ``_BILINGUAL_EXTRA_ARABIC``
    (counted as "arabic"), and ``"persian_digits"`` (U+06F0-06F9; still also counted in
    "arabic_digits")."""
    text = text or u""
    prof = script_profile(text)
    extra = [ch for ch in text if _bilingual_extra_arabic(ch)]
    if extra:
        prof["arabic"] += len(extra)
        letters = sum(1 for ch in extra if unicodedata.category(ch).startswith("L"))
        prof["other_letters"] = max(0, prof["other_letters"] - letters)
        prof["other"] = max(0, prof["other"] - (len(extra) - letters))
    prof["persian_digits"] = sum(1 for ch in text if u"\u06f0" <= ch <= u"\u06f9")
    return prof


def _bilingual_digit_systems(prof):
    """Names of the digit systems in a ``bilingual_script_profile``."""
    systems = []
    if prof["ascii_digits"]:
        systems.append("ASCII")
    if prof["arabic_digits"] - prof["persian_digits"] > 0:
        systems.append("Arabic-Indic")
    if prof["persian_digits"]:
        systems.append("Persian")
    return systems


def _bilingual_join(names):
    """``"A"``, ``"A and B"``, ``"A, B and C"``."""
    names = list(names)
    if len(names) < 3:
        return u" and ".join(names)
    return u", ".join(names[:-1]) + u" and " + names[-1]


def bilingual_digit_details(en_prof, ar_prof):
    """MIXED_DIGITS details ``(english or None, arabic or None)`` of two ``bilingual_script_profile``
    results; every sentence names exactly the digit systems found (built from
    ``_bilingual_digit_systems``, never a fixed pair)."""
    en_systems = [s for s in _bilingual_digit_systems(en_prof) if s != "ASCII"]
    en_detail = u"The English name contains {0} digits.".format(_bilingual_join(en_systems)) \
        if en_systems else None
    ar_systems = _bilingual_digit_systems(ar_prof)
    ar_detail = u"The Arabic name mixes {0} digits.".format(_bilingual_join(ar_systems)) \
        if len(ar_systems) > 1 else None
    return en_detail, ar_detail


def is_placeholder_name(value):
    """True for a value that holds no name: a placeholder of ``common.text.is_placeholder``
    ("-", "N/A", "null", "unknown", "000" ...), one of ``BILINGUAL_PLACEHOLDERS`` (Arabic
    question mark, Arabic "unknown" / "none"), only zeros ("0"), or a text without any letter
    or digit (punctuation, symbols or tatweel only: "...", "--", "ــ"). Blank values are
    not placeholders (they are MISSING anyway)."""
    if not isinstance(value, str) or is_blank(value):
        return False
    if is_placeholder(value):
        return True
    text = collapse_whitespace(fold_digits(remove_invisible(value, joiners=True))).casefold()
    if text in BILINGUAL_PLACEHOLDERS or text.strip(u"0") == u"":
        return True
    return not any(unicodedata.category(ch)[0] in "LN" and ch != _BILINGUAL_TATWEEL for ch in text)


# Unicode names of the letters counted as Latin: the Latin letters, and the fullwidth Latin letters
# (U+FF21-FF3A, U+FF41-FF5A, "FULLWIDTH LATIN CAPITAL LETTER K"), which an East Asian input method
# leaves in data ("\uff2b\uff26\uff23"). Mathematical Latin letters (U+1D400 and up, "MATHEMATICAL BOLD
# CAPITAL K") are still not Latin.
_BILINGUAL_LATIN_NAMES = ("LATIN", "FULLWIDTH LATIN")


def _bilingual_is_latin_letter(ch):
    return unicodedata.category(ch).startswith("L") and \
        unicodedata.name(ch, "").startswith(_BILINGUAL_LATIN_NAMES)


def _bilingual_is_code_digit(ch):
    """A digit of a code: ASCII (0-9), Arabic-Indic (U+0660-0669) or Persian (U+06F0-06F9), the
    three digit systems of MIXED_DIGITS (a code typed on an Arabic keyboard, "M\u0664", is a code
    like "M4")."""
    return (u"0" <= ch <= u"9") or (u"\u0660" <= ch <= u"\u0669") or (u"\u06f0" <= ch <= u"\u06f9")


def _bilingual_is_code_char(ch):
    return _bilingual_is_latin_letter(ch) or _bilingual_is_code_digit(ch)


def latin_letters_outside_codes(text, allow_codes=True):
    """Number of Latin letters in ``text`` that are not part of a short code.

    A code is a run of Latin letters and digits (ASCII, Arabic-Indic or Persian) of at most
    ``CODE_TOKEN_MAX`` characters that contains at least one digit ("A1", "B12", "M4",
    "M\u0664"). With ``allow_codes=False`` every Latin letter counts.
    """
    count = 0
    run = []
    for ch in (text or u"") + u" ":
        if _bilingual_is_code_char(ch):
            run.append(ch)
            continue
        if run:
            letters = sum(1 for c in run if _bilingual_is_latin_letter(c))
            is_code = allow_codes and len(run) <= CODE_TOKEN_MAX and \
                any(_bilingual_is_code_digit(c) for c in run)
            if not is_code:
                count += letters
            run = []
    return count


def fold_english(value):
    """Comparison key of an English name: invisible marks removed (LRM, RLM, ZWSP,
    soft hyphen, BOM, ZWNJ/ZWJ: copy-paste leaves them and they are not seen),
    Unicode NFC, typographic apostrophes, quotes and dashes folded to ASCII (so
    "King’s Road" and "King's Road" are one name), trimmed, single-spaced, casefolded."""
    if is_blank(value):
        return None
    text = to_nfc(remove_invisible(str(value), joiners=True)).translate(_BILINGUAL_EN_PUNCT)
    return collapse_whitespace(text).casefold()


def fold_arabic(value, normalise=True):
    """Comparison key of an Arabic name: Unicode NFC (always; canonically
    equivalent spellings are the same name), then Arabic letter folding when
    ``normalise``. Invisible marks (LRM, RLM, ZWSP, soft hyphen, BOM) are always
    removed; a zero-width non-joiner or joiner, which changes how Arabic is
    shaped, is removed only with ``normalise``."""
    if is_blank(value):
        return None
    text = to_nfc(remove_invisible(str(value), joiners=False))
    if normalise:
        text = arabic_normalize(text)
    return collapse_whitespace(text).casefold()


def _bilingual_issue(oid, field, value, issue, detail):
    return {"oid": oid, "field": field, "value": value, "issue": issue, "detail": detail}


def latin_names_set(names):
    """Comparison keys (``fold_english``) of an allow-list of Latin names (brand names that
    stay in Latin in the Arabic field); blank entries are dropped."""
    keys = set()
    for name in names or ():
        key = fold_english(name)
        if key is not None:
            keys.add(key)
    return keys


def check_pair(oid, en, ar, en_field, ar_field, checks=BILINGUAL_CHECKS, allow_codes=True,
               latin_names=frozenset(), same_as_english=False, placeholders_as_missing=False):
    """Row-level issues of one English/Arabic pair (everything but INCONSISTENT_PAIR).

    ``latin_names``: ``latin_names_set`` keys of Latin names accepted as the whole Arabic
    value; ``same_as_english``: an Arabic value equal to the English value of the row
    (after ``fold_english``) is accepted (a brand name kept in Latin);
    ``placeholders_as_missing``: a placeholder (``is_placeholder_name``) is MISSING and is
    left out of the other checks."""
    out = []
    checks = set(checks)
    en_missing, ar_missing = is_blank(en), is_blank(ar)
    en_ph = placeholders_as_missing and not en_missing and is_placeholder_name(en)
    ar_ph = placeholders_as_missing and not ar_missing and is_placeholder_name(ar)
    if CHECK_MISSING in checks:
        if en_missing or en_ph:
            out.append(_bilingual_issue(oid, en_field, en, ISSUE_MISSING_EN,
                                        u"The English name is a placeholder (\"{0}\").".format(en)
                                        if en_ph else "The English name is empty."))
        if ar_missing or ar_ph:
            out.append(_bilingual_issue(oid, ar_field, ar, ISSUE_MISSING_AR,
                                        u"The Arabic name is a placeholder (\"{0}\").".format(ar)
                                        if ar_ph else "The Arabic name is empty."))
    en_missing, ar_missing = en_missing or en_ph, ar_missing or ar_ph
    en_text = u"" if en_missing else str(en)
    ar_text = u"" if ar_missing else str(ar)
    en_prof = bilingual_script_profile(en_text)
    ar_prof = bilingual_script_profile(ar_text)
    wrong_en = not en_missing and en_prof["arabic"] > 0
    wrong_ar = not ar_missing and ar_prof["arabic"] == 0 and \
        latin_letters_outside_codes(ar_text, allow_codes) > 0
    if wrong_ar and (latin_names or same_as_english):
        ar_key = fold_english(ar_text)
        if (ar_key in latin_names) or (same_as_english and ar_key == fold_english(en_text)):
            wrong_ar = False
    # a swap needs a wholly Latin Arabic value AND a wholly Arabic English value
    swapped = wrong_en and wrong_ar and latin_letters_outside_codes(en_text, allow_codes) == 0
    if swapped and CHECK_SWAPPED in checks:
        out.append(_bilingual_issue(oid, u"{0} / {1}".format(en_field, ar_field),
                                    u"{0} / {1}".format(en_text, ar_text), ISSUE_SWAPPED,
                                    "The English and Arabic values look swapped."))
    elif CHECK_WRONG_SCRIPT in checks:
        if wrong_en:
            out.append(_bilingual_issue(oid, en_field, en, ISSUE_WRONG_SCRIPT_EN,
                                        "The English name contains Arabic letters."))
        if wrong_ar:
            out.append(_bilingual_issue(oid, ar_field, ar, ISSUE_WRONG_SCRIPT_AR,
                                        "The Arabic name has Latin letters and no Arabic "
                                        "letters."))
    if CHECK_MIXED_DIGITS in checks:
        # Persian and Arabic-Indic digits in one value are mixed too; the DETAIL names every system
        en_detail, ar_detail = bilingual_digit_details(en_prof, ar_prof)
        if en_detail:
            out.append(_bilingual_issue(oid, en_field, en, ISSUE_MIXED_DIGITS, en_detail))
        if ar_detail:
            out.append(_bilingual_issue(oid, ar_field, ar, ISSUE_MIXED_DIGITS, ar_detail))
    return out


def inconsistent_pairs(rows, en_field, ar_field, normalise_arabic=True, placeholders_as_missing=False):
    """INCONSISTENT_PAIR issues for ``rows`` = ``[(oid, en, ar)]``.

    English -> Arabic: rows whose folded English name maps to more than one
    folded Arabic name are all flagged (FIELD = English field), and the
    reverse direction (FIELD = Arabic field). Rows with a missing value on
    either side (a placeholder too, with ``placeholders_as_missing``) are not grouped.
    """
    by_en, by_ar = {}, {}
    for oid, en, ar in rows:
        if placeholders_as_missing and (is_placeholder_name(en) or is_placeholder_name(ar)):
            continue
        ke, ka = fold_english(en), fold_arabic(ar, normalise_arabic)
        if ke is None or ka is None:
            continue
        by_en.setdefault(ke, []).append((oid, en, ar, ka))
        by_ar.setdefault(ka, []).append((oid, en, ar, ke))
    out = []
    for members in by_en.values():
        variants = set(m[3] for m in members)
        if len(variants) > 1:
            detail = u"The same English name has {0}.".format(
                _bilingual_name_list(((m[2], m[3]) for m in members), u"Arabic"))
            for oid, en, _ar, _k in members:
                out.append(_bilingual_issue(oid, en_field, en, ISSUE_INCONSISTENT_PAIR, detail))
    for members in by_ar.values():
        variants = set(m[3] for m in members)
        if len(variants) > 1:
            detail = u"The same Arabic name has {0}.".format(
                _bilingual_name_list(((m[1], m[3]) for m in members), u"English"))
            for oid, _en, ar, _k in members:
                out.append(_bilingual_issue(oid, ar_field, ar, ISSUE_INCONSISTENT_PAIR, detail))
    return out


# Names listed in an INCONSISTENT_PAIR detail; the rest are counted. Generic names
# ("Mosque", "School") can have thousands of partners, and the same detail is written
# on every row of the group, so a full list would grow with rows x names.
BILINGUAL_MAX_LISTED_NAMES = 10


def _bilingual_name_list(pairs, language):
    """``"N different <language> names[ (M spellings)]: a; b"`` for ``(raw, folded)``
    pairs: the count and the list are both of the different (folded)
    names; each is shown by its first raw spelling (alphabetically), and the number
    of raw spellings is added when it is larger."""
    spellings = {}
    for raw, folded in pairs:
        spellings.setdefault(folded, set()).add(str(raw))
    names = sorted(min(group) for group in spellings.values())
    total = sum(len(group) for group in spellings.values())
    head = u"{0} different {1} names".format(len(names), language)
    if total > len(names):
        head += u" ({0} spellings)".format(total)
    text = u"; ".join(names[:BILINGUAL_MAX_LISTED_NAMES])
    if len(names) > BILINGUAL_MAX_LISTED_NAMES:
        text += u" ... and {0} more".format(len(names) - BILINGUAL_MAX_LISTED_NAMES)
    return head + u": " + text


def check_bilingual(rows, en_field, ar_field, checks=BILINGUAL_CHECKS, allow_codes=True,
                    normalise_arabic=True, latin_names=(), same_as_english=False,
                    placeholders_as_missing=False):
    """All issues for ``rows`` = ``[(oid, en, ar)]``, sorted by OID then issue order.

    ``latin_names``: a list of Latin names accepted as the whole Arabic value (brand names);
    ``same_as_english``: accept an Arabic value equal to the English value of its row;
    ``placeholders_as_missing``: report placeholders ("-", "N/A", "0" ...) as MISSING."""
    checks = tuple(c for c in BILINGUAL_CHECKS if c in set(checks))
    allowed = latin_names_set(latin_names)
    out = []
    for oid, en, ar in rows:
        out.extend(check_pair(oid, en, ar, en_field, ar_field, checks, allow_codes, allowed,
                              same_as_english, placeholders_as_missing))
    if CHECK_INCONSISTENT_PAIR in checks:
        out.extend(inconsistent_pairs(rows, en_field, ar_field, normalise_arabic,
                                      placeholders_as_missing))
    out.sort(key=lambda i: (i["oid"], BILINGUAL_ISSUES.index(i["issue"]), i["field"]))
    return out


def placeholder_pair_values(issues):
    """The placeholder values (``is_placeholder_name``) that hold INCONSISTENT_PAIR groups together:
    without ``placeholders_as_missing`` a placeholder is compared like any name, so "-" as the
    English name of rows with different Arabic names makes them one group. Returns
    ``(sorted distinct values, number of such INCONSISTENT_PAIR issues)``."""
    hits = [i for i in issues if i["issue"] == ISSUE_INCONSISTENT_PAIR and is_placeholder_name(i["value"])]
    return sorted(set(str(i["value"]) for i in hits)), len(hits)


def placeholder_variant_values(issues, rows, en_field, normalise_arabic=True):
    """The placeholder values listed as one of the NAMES of an INCONSISTENT_PAIR group whose own name is
    not a placeholder: without ``placeholders_as_missing``, ``("Park", "-")`` and ``("Park", "<arabic>")``
    are one group, the English name "Park" with the two Arabic names "-" and "<arabic>"
    (``placeholder_pair_values`` does not see it: the grouping value "Park" is no placeholder).
    ``rows`` = ``[(oid, en, ar)]`` as given to ``check_bilingual``; ``en_field``: the FIELD of the
    English issues. Returns ``(sorted distinct placeholder values, number of such INCONSISTENT_PAIR
    issues)``."""
    held_en, held_ar = {}, {}          # group key -> placeholder values among its names
    for _oid, en, ar in rows:
        ke, ka = fold_english(en), fold_arabic(ar, normalise_arabic)
        if ke is None or ka is None:
            continue
        if is_placeholder_name(ar):
            held_en.setdefault(ke, set()).add(str(ar))
        if is_placeholder_name(en):
            held_ar.setdefault(ka, set()).add(str(en))
    values, count = set(), 0
    for issue in issues:
        if issue["issue"] != ISSUE_INCONSISTENT_PAIR or is_placeholder_name(issue["value"]):
            continue
        if issue["field"] == en_field:
            held = held_en.get(fold_english(issue["value"]))
        else:
            held = held_ar.get(fold_arabic(issue["value"], normalise_arabic))
        if held:
            values |= held
            count += 1
    return sorted(values), count


def bilingual_summary(issues, row_count):
    summary = [("Rows checked", row_count), ("Issues", len(issues)),
               ("Rows with an issue", len(set(i["oid"] for i in issues)))]
    for issue in BILINGUAL_ISSUES:
        summary.append((issue, sum(1 for i in issues if i["issue"] == issue)))
    return summary


# SRC_OID field type: ``common.arcio.oid_field_spec`` (one rule for every tool that writes source
# ObjectIDs).


# Excel stores a number as a double and shows at most 15 significant digits, so an id of 16 digits
# or more is written to an Excel report as text, digit for digit.
BILINGUAL_EXCEL_EXACT_DIGITS = 15


def bilingual_report_oid(oid):
    """``oid`` as an Excel report cell: the number itself, or its digits as text when it has more
    than 15 digits (Excel would show it rounded)."""
    if isinstance(oid, int) and not isinstance(oid, bool) and \
            len(str(abs(oid))) > BILINGUAL_EXCEL_EXACT_DIGITS:
        return str(oid)
    return oid


# ==========================================================================
# quality/multivalue_codes_core.py
# ==========================================================================
# Pure logic of the Multi-Value Code Validator (no arcpy).
#
# A multi-value code field stores several codes in one text value, for
# example ``"A;B;C"``. Each value is split on a delimiter and every token is
# checked against a set of valid codes (a coded-value domain, a lookup table
# or a value list). Positions are 1-based over the raw split, so an empty
# token still takes a position.
#
# Token issues, in the order they are tested:
#
# * ``EMPTY_TOKEN``: nothing (or only spaces) between two delimiters;
# * ``MIXED_DELIMITER``: the token contains another candidate delimiter
#   (``; , | /``) and is not itself a valid code, not even ignoring case (a wrong-cased
#   ``hospital/clinic`` for the code ``Hospital/Clinic`` is only a CASE_MISMATCH);
# * ``WHITESPACE``: the raw token has leading/trailing spaces;
# * ``INVISIBLE_MARK``: the raw token has leading/trailing invisible marks (right-to-left
#   mark, zero-width space, BOM ...) that make it look like a valid code when it is not;
# * ``CASE_MISMATCH``: not valid as typed but valid ignoring case (only when
#   the comparison is case-sensitive); the suggestion is the real code;
# * ``UNKNOWN_TOKEN``: not valid;
# * ``DUPLICATE_TOKEN``: a valid token already seen earlier in the value.

# ASCII candidates first (ties in AUTO detection go to the earlier one), then the Arabic
# semicolon (U+061B) and the Arabic comma (U+060C), which Arabic data uses for lists.
DELIMITER_CANDIDATES = (u";", u",", u"|", u"/", u"\u061b", u"\u060c")
DELIMITER_AUTO = "AUTO"

ISSUE_EMPTY_TOKEN = "EMPTY_TOKEN"
ISSUE_WHITESPACE = "WHITESPACE"
ISSUE_INVISIBLE_MARK = "INVISIBLE_MARK"
ISSUE_CASE_MISMATCH = "CASE_MISMATCH"
ISSUE_UNKNOWN_TOKEN = "UNKNOWN_TOKEN"
ISSUE_DUPLICATE_TOKEN = "DUPLICATE_TOKEN"
ISSUE_MIXED_DELIMITER = "MIXED_DELIMITER"
TOKEN_ISSUES = (ISSUE_EMPTY_TOKEN, ISSUE_MIXED_DELIMITER, ISSUE_WHITESPACE,
                ISSUE_INVISIBLE_MARK, ISSUE_CASE_MISMATCH,
                ISSUE_UNKNOWN_TOKEN, ISSUE_DUPLICATE_TOKEN)
STATUS_OK = "OK"

# Explode status = the first of these issues (WHITESPACE is not a status:
# exploded tokens are trimmed; EMPTY tokens are not exploded).
_MV_STATUS_ORDER = (ISSUE_MIXED_DELIMITER, ISSUE_CASE_MISMATCH, ISSUE_UNKNOWN_TOKEN,
                    ISSUE_DUPLICATE_TOKEN)
# Numbers as ArcGIS reads them: ASCII digits only (Python's float() would also
# accept Arabic-Indic digits and "1_0", which are not the stored codes).
_MV_NUMBER = re.compile(r"^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$")
# Characters trimmed from both ends of a token: spaces, line breaks, and invisible marks
# (a token that ends in a right-to-left mark looks like a valid code but is not one).
# Control characters (NUL ... US except tab/line breaks, DEL), the invisible math operators
# U+2061-2064 and the Mongolian vowel separator U+180E are invisible too.
_MV_EXTRA_INVISIBLE = frozenset(
    [chr(c) for c in range(0x00, 0x20)] + [chr(0x7F), u"\u180e"] +
    [chr(c) for c in range(0x2061, 0x2065)]) - TEXT_SPACES - TEXT_LINE_BREAKS
_MV_INVISIBLE = TEXT_INVISIBLE | TEXT_JOINERS | _MV_EXTRA_INVISIBLE
_MV_STRIP = u"".join(sorted(TEXT_SPACES | TEXT_LINE_BREAKS | _MV_INVISIBLE))


# Field types (Domain.type / Field.type spellings, case-folded) of numeric domains and fields.
_MV_INTEGER_TYPES = ("short", "long", "smallinteger", "integer", "biginteger", "oid")
_MV_SINGLE_TYPES = ("single", "float")
_MV_DOUBLE_TYPES = ("double",)
_F32_MAX_EXP = 128   # 2**128 and above round to infinity in single precision
_F32_MIN_EXP = -126  # smallest normal exponent; below it the spacing stays 2**-149


def _exact_fraction(value):
    """``value`` (int, float, Decimal or ASCII number text) as an exact Fraction, or None.

    Text is converted only when ``float()`` of it is finite and not zero, so the exact
    value has a bounded exponent (a token such as ``1e-999999999999999999`` never builds a
    huge Fraction). Zero and infinity are returned as the floats 0.0 and inf."""
    if isinstance(value, bool):
        value = int(value)
    if isinstance(value, str):
        text = value.strip()
        if not _MV_NUMBER.match(text):
            return None
        try:
            approx = float(text)
        except (ValueError, OverflowError):
            return None
        if approx == 0.0 or approx in (float("inf"), float("-inf")):
            return approx
        try:
            return Fraction(Decimal(text))
        except (InvalidOperation, ValueError):
            return None
    if isinstance(value, float):
        if value != value:
            return None
        if value == 0.0 or value in (float("inf"), float("-inf")):
            return value
        return Fraction(value)
    if isinstance(value, (int, Decimal)):
        try:
            return Fraction(value)
        except (ValueError, OverflowError):  # Decimal NaN / Infinity
            return None
    return None


def stored_single(value):
    """``value`` rounded to the nearest 32-bit float (ties to even), as a Python float.

    The rounding is done once, from the exact value (a decimal token is not rounded to a
    double first). Values that round beyond the single range give None (no code can be
    stored there); NaN and non-numbers give None."""
    exact = _exact_fraction(value)
    if exact is None:
        return None
    if isinstance(exact, float):  # 0.0 or +-inf
        return 0.0 if exact == 0.0 else None
    sign = -1 if exact < 0 else 1
    a = abs(exact)
    # exponent e with 2**e <= a < 2**(e+1)
    e = a.numerator.bit_length() - a.denominator.bit_length()
    if Fraction(2) ** e > a:
        e -= 1
    step = Fraction(2) ** (max(e, _F32_MIN_EXP) - 23)
    rounded = round(a / step) * step   # Fraction.__round__ rounds half to even
    if rounded >= Fraction(2) ** _F32_MAX_EXP:
        return None
    return sign * float(rounded)


def stored_double(value):
    """``value`` rounded to the nearest double (ties to even), or None (overflow, NaN)."""
    if isinstance(value, str):
        text = value.strip()
        if not _MV_NUMBER.match(text):
            return None
        number = float(text)  # Python's float() of decimal text is correctly rounded
    else:
        exact = _exact_fraction(value)
        if exact is None:
            return None
        try:
            number = float(exact)
        except OverflowError:
            return None
    if number in (float("inf"), float("-inf")):
        return None
    return number + 0.0  # -0.0 -> 0.0


def is_blank_value(value):
    """True for a text value with nothing in it (empty, spaces, line breaks, invisible
    marks only). It has no tokens, so it is counted as blank, not flagged EMPTY_TOKEN.
    ``None`` is not blank here (it is counted as a null)."""
    return isinstance(value, str) and value.strip(_MV_STRIP) == u""


def choose_delimiter(values, code_texts=(), case_sensitive=True):
    """The AUTO delimiter for ``values``: ``delimiter_choice(...)["delimiter"]``."""
    return delimiter_choice(values, code_texts, case_sensitive)["delimiter"]


# Reasons of an AUTO choice (``delimiter_choice``).
AUTO_MOST_FREQUENT = "MOST_FREQUENT"      # the most frequent candidate outside the codes
AUTO_SINGLE_CODES = "SINGLE_CODES"        # none outside the codes: first candidate in no code
AUTO_ALL_INSIDE = "ALL_INSIDE"            # none outside, and every candidate is inside a code: ";"


def delimiter_choice(values, code_texts=(), case_sensitive=True):
    """AUTO delimiter detection, with the reason of the choice.

    Returns ``{"delimiter", "reason", "plain", "plain_count"}``:

    * the most frequent candidate in ``values`` (ties: list order), counted outside the valid
      codes (reason ``MOST_FREQUENT``). ``code_texts``: the valid codes, when known. Occurrences
      that are part of a valid code (the ``/`` of ``Hospital/Clinic``) are not separators, so every
      valid code that contains a candidate is removed from the values before counting (longest
      code first). A padded code (``"Hospital/Clinic "``) is removed trimmed too, and the codes are
      removed in any case (values and codes are compared case-folded), whatever ``case_sensitive``
      is: in a case-sensitive run ``HOSPITAL/CLINIC`` is a wrong-cased code (CASE_MISMATCH), so its
      ``/`` is not a separator either. ``case_sensitive`` is kept for callers; it does not change
      the choice. The validation itself keeps the exact-case rule;
    * when no candidate occurs outside the codes, the values are single codes: the first
      candidate that occurs in no valid code is used, so no code is split (reason
      ``SINGLE_CODES``; ``;`` when no code holds ``;``, ``,`` when a code such as ``A;B`` does);
    * when every candidate occurs inside some valid code, ``;`` (reason ``ALL_INSIDE``).

    ``plain`` is the most frequent candidate counted without removing the codes, and
    ``plain_count`` its number of occurrences (0: no candidate occurs in the values at all)."""
    raw = dict((d, 0) for d in DELIMITER_CANDIDATES)
    outside = dict((d, 0) for d in DELIMITER_CANDIDATES)
    forms = set()
    in_code = set()
    for t in code_texts:
        if not isinstance(t, str) or not t:
            continue
        for form in (t, t.strip(_MV_STRIP)):
            form = form.casefold()
            hits = [d for d in DELIMITER_CANDIDATES if d in form]
            if form and hits:
                forms.add(form)
                in_code.update(hits)
    texts = sorted(forms, key=lambda t: (-len(t), t))
    for value in values:
        if not isinstance(value, str):
            continue
        rest = value.casefold()   # delimiters are not changed by case folding
        for t in texts:
            if t in rest:
                rest = rest.replace(t, u"\x00")
        for d in DELIMITER_CANDIDATES:
            raw[d] += value.count(d)
            outside[d] += rest.count(d)

    def most(counts):
        return max(DELIMITER_CANDIDATES, key=lambda d: (counts[d], -DELIMITER_CANDIDATES.index(d)))

    plain = most(raw)
    out = {"plain": plain, "plain_count": raw[plain]}
    best = most(outside)
    if outside[best]:
        out.update(delimiter=best, reason=AUTO_MOST_FREQUENT)
        return out
    free = [d for d in DELIMITER_CANDIDATES if d not in in_code]
    if free:
        out.update(delimiter=free[0], reason=AUTO_SINGLE_CODES)
    else:
        out.update(delimiter=DELIMITER_CANDIDATES[0], reason=AUTO_ALL_INSIDE)
    return out


class CodeSet(object):
    """Valid codes from a domain, a lookup table or a value list.

    ``codes`` are compared as text, except for numeric domains, which compare
    numerically ("01" equals 1; only ASCII numbers are accepted). Each token is read
    the way the stored number type reads it:

    * integer domains (Short, Long, BigInteger, and an ObjectID lookup field): the token
      text is an exact decimal number, never rounded. "1.0" and "1e0" equal the code 1,
      but "0.99999999999999999" and "9007199254740993.0" are not rounded to the codes 1
      and 9007199254740992;
    * DOUBLE domains: the token is rounded to the nearest double, integer text and decimal
      text alike ("9007199254740993" and "9007199254740993.0" both equal the code
      9007199254740992.0);
    * FLOAT (single) domains: the token is rounded to the nearest 32-bit float, exactly
      (from the decimal text, not through a double), and so is the code; "0.1",
      "0.1000000001" and "0.10000000149011612" all equal the code 0.1.

    ``descriptions`` maps code texts to domain descriptions
    (empty for tables and lists). Every lookup is a dictionary lookup, so the
    cost does not grow with the number of codes.
    """

    def __init__(self, codes, descriptions=None, domain=None):
        self.domain = domain
        self.padded = 0   # codes with spaces/invisible marks at their ends (trimmed when compared)
        self.blank = 0    # blank lookup codes dropped by ``from_values``
        ftype = str((domain or {}).get("field_type") or "").casefold() if domain is not None else ""
        self._numeric = ftype in _MV_INTEGER_TYPES + _MV_SINGLE_TYPES + _MV_DOUBLE_TYPES
        # Integer domains: token text is compared as an exact Decimal (no float rounding).
        self._integer = ftype in _MV_INTEGER_TYPES
        # FLOAT (single) and DOUBLE domains: tokens and codes are rounded to the stored type.
        self._single = ftype in _MV_SINGLE_TYPES
        self._double = ftype in _MV_DOUBLE_TYPES
        self.codes = [c for c in codes if c is not None]
        self.texts = [value_to_text(c) for c in self.codes]
        self.descriptions = descriptions or {}
        self._by_text = {}
        self._by_number = {}
        self._by_fold = {}
        # Exact codes first, then the trimmed variants of padded codes, so an exact code wins
        # over a padded twin whatever the order of the domain ("A " and "A": the token A is "A").
        for c, text in zip(self.codes, self.texts):
            self._by_text.setdefault(text, text)
            self._fold_add(text.casefold(), text)
            if self._numeric:
                # exact_number, not float(): BigInteger codes above 2**53 stay distinct.
                number = self._stored(c)
                if number is None:
                    continue
                self._by_number.setdefault(number, text)
        exact_folds = set(self._by_fold)
        # Codes that differ only by case ("ab" and "AB"), counted for a warning.
        self.case_twins = sorted(t for k in exact_folds for t in self._by_fold[k]
                                 if len(self._by_fold[k]) > 1) if not self._numeric else []
        if not self._numeric:
            for text in self.texts:
                # A domain code with spaces or invisible marks at its ends ("A ") is matched by
                # the trimmed token ("A"): tokens are trimmed, so it could never match otherwise.
                trimmed = text.strip(_MV_STRIP)
                if trimmed and trimmed != text:
                    self.padded += 1
                    self._by_text.setdefault(trimmed, text)
                    if trimmed.casefold() not in exact_folds:
                        self._fold_add(trimmed.casefold(), text)

    def _fold_add(self, key, text):
        hits = self._by_fold.setdefault(key, [])
        if text not in hits:
            hits.append(text)

    @classmethod
    def from_domain(cls, domain):
        codes = list((domain.get("codes") or {}).keys())
        return cls(codes, dict((value_to_text(c), d) for c, d in
                               (domain.get("codes") or {}).items()), domain)

    @classmethod
    def from_values(cls, values):
        """Codes from a lookup table column or a typed list. Codes are compared without
        leading/trailing spaces or invisible marks (tokens are trimmed too, so a padded
        code could never match); blank codes are dropped. ``padded`` on the result is
        the number of distinct codes that were trimmed, ``blank`` the blank ones dropped."""
        seen, out = set(), []
        padded = blank = 0
        for v in values:
            t = value_to_text(v)
            if t is None:
                continue
            trimmed = t.strip(_MV_STRIP)
            if trimmed == u"":
                blank += 1
                continue
            if trimmed != t:
                padded += 1
            if trimmed not in seen:
                seen.add(trimmed)
                out.append(trimmed)
        result = cls(out)
        result.padded = padded
        result.blank = blank
        return result

    def canonical(self, token):
        """The code text ``token`` stands for, exactly (``None`` if not valid)."""
        if self._numeric:
            if not _MV_NUMBER.match(token):
                return None
            if self._integer:
                # Decimal compares and hashes exactly against int and float codes, so a
                # decimal spelling matches only the integer it really is.
                try:
                    return self._by_number.get(Decimal(token))
                except (InvalidOperation, ValueError):
                    return None
            number = self._stored(token)
            return None if number is None else self._by_number.get(number)
        return self._by_text.get(token)

    def _stored(self, value):
        """``value`` (a code or token text) as the domain's number type stores it, or None."""
        if self._single:
            return stored_single(value)
        if self._double:
            return stored_double(value)
        return exact_number(value)

    def canonical_ignore_case(self, token):
        """Code text matching ``token`` ignoring case: ``(code or None, ambiguous)``.

        When several codes differ only by case (``ab`` and ``AB``) the first one listed is
        returned with ``ambiguous`` True."""
        hits = self._by_fold.get(token.casefold(), [])
        return (hits[0] if hits else None), len(hits) > 1

    def description(self, code_text):
        return self.descriptions.get(code_text)

    def codes_containing(self, delimiter):
        return [t for t in self.texts if delimiter in t]


def check_multivalue(oid, value, delimiter, codes, case_sensitive=True):
    """Check one field value.

    Returns ``(flags, exploded)``: ``flags`` are dicts ``{"oid", "position",
    "token", "issue", "suggested"}``; ``exploded`` are dicts ``{"oid",
    "position", "token" (trimmed), "description", "status"}`` for every
    non-empty token. ``None`` and blank values (nothing but spaces or invisible marks) give
    ``([], [])``: they hold no token, the caller counts them (``is_blank_value``).
    """
    flags, exploded = [], []
    if value is None:
        return flags, exploded
    text = value if isinstance(value, str) else value_to_text(value)
    if is_blank_value(text):
        return flags, exploded
    others = [d for d in DELIMITER_CANDIDATES if d != delimiter]
    seen = set()
    for position, raw in enumerate(text.split(delimiter), 1):
        token = raw.strip(_MV_STRIP)
        issues = []

        def flag(issue, tok, suggested=None):
            flags.append({"oid": oid, "position": position, "token": tok, "issue": issue,
                          "suggested": suggested})
            issues.append(issue)

        if token == u"":
            flag(ISSUE_EMPTY_TOKEN, raw)
            continue
        exact = codes.canonical(token)
        if exact is None and not case_sensitive:
            # Case does not matter in this run: a token that matches codes differing only by
            # case (ab, AB) is valid and stands for the first one listed.
            exact = codes.canonical_ignore_case(token)[0]
        # A token that is a code up to case (hospital/clinic) has no mixed delimiter: its only
        # problem is the case, reported below as CASE_MISMATCH (or UNKNOWN_TOKEN for case twins).
        if exact is None and any(d in token for d in others) and \
                codes.canonical_ignore_case(token)[0] is None:
            flag(ISSUE_MIXED_DELIMITER, raw)
        if raw != token:
            padding = raw[:len(raw) - len(raw.lstrip(_MV_STRIP))] + raw[len(raw.rstrip(_MV_STRIP)):]
            if any(ch not in _MV_INVISIBLE for ch in padding):
                flag(ISSUE_WHITESPACE, raw)
            if any(ch in _MV_INVISIBLE for ch in padding):
                flag(ISSUE_INVISIBLE_MARK, raw)
        if exact is None:
            fixed, ambiguous = codes.canonical_ignore_case(token) if case_sensitive else (None, False)
            if ambiguous:
                fixed = None  # ab and AB both exist: no single suggestion
            if fixed is not None:
                # suggest the code as a token can be typed: a padded code ("Zoo ") is matched
                # trimmed, so the trimmed form is the fix (typing the padding is a WHITESPACE issue)
                flag(ISSUE_CASE_MISMATCH, token, fixed.strip(_MV_STRIP) or fixed)
            else:
                flag(ISSUE_UNKNOWN_TOKEN, token)
        else:
            if exact in seen:
                flag(ISSUE_DUPLICATE_TOKEN, token)
            seen.add(exact)
        status = STATUS_OK
        for issue in _MV_STATUS_ORDER:
            if issue in issues:
                status = issue
                break
        exploded.append({"oid": oid, "position": position, "token": token,
                         "description": codes.description(exact) if status == STATUS_OK else None,
                         "status": status})
    return flags, exploded


def multivalue_summary(flags, exploded, rows, nulls, delimiter, blanks=0, not_checked=0):
    """Summary rows of the report. ``not_checked``: rows read but neither checked nor exploded
    (their subtype has no domain and no Domain Name was given)."""
    summary = [("Delimiter", delimiter), ("Rows read", rows), ("Null values", nulls),
               ("Blank values", blanks), ("Rows not checked (no domain)", not_checked),
               ("Tokens exploded", len(exploded)), ("Issues", len(flags)),
               ("Rows with an issue", len(set(f["oid"] for f in flags)))]
    for issue in TOKEN_ISSUES:
        summary.append((issue, sum(1 for f in flags if f["issue"] == issue)))
    return summary


# ==========================================================================
# quality/near_miss_vocab_core.py
# ==========================================================================
# Pure logic of the Near-Miss Value Checker (no arcpy).
#
# Checks text values against a controlled vocabulary (a list of allowed
# values) and classifies every distinct value that is not exactly in it:
#
# * ``NORMALISATION``: equal to a vocabulary entry once both are normalised
#   (Unicode NFC, trim and collapse spaces, invisible/control characters removed, case
#   ignored, Arabic letter variants and tashkeel folded, Arabic-Indic digits
#   as ASCII). Every invisible format mark (``VOCAB_HIDDEN``, ZWNJ/ZWJ included) is removed
#   whatever the Arabic option. SCORE is 1.0. When the value and the suggestion differ only by
#   invisible marks, Unicode composition, space forms (NBSP and other spaces than U+0020) or
#   look-alike letter forms (Arabic presentation forms, Persian kaf/yeh), they look the same or
#   nearly; DETAIL then says so (``vocab_hidden_detail``, also for a NEAR_MISS).
# * ``NEAR_MISS``: the best similarity of the normalised value to a
#   normalised vocabulary entry is at least the cutoff. SUGGESTION is that
#   entry, SCORE the similarity (rounded to 3 decimals, at most 0.999: 1.0 means NORMALISATION).
# * ``UNKNOWN``: nothing reaches the cutoff. SUGGESTION and SCORE are empty. A value that is
#   not blank but empty once normalised (tatweel or tashkeel only) is UNKNOWN with
#   ``VOCAB_EMPTY_DETAIL`` in DETAIL.
#
# Not folded: hamza on a seat (waw with hamza U+0624, yeh with hamza U+0626) is a letter of its
# own, so "شاطئ" against "شاطي" is only 0.75 similar (UNKNOWN at the default cutoff).
#
# Similarity is ``difflib.SequenceMatcher(None, a, b, autojunk=False).ratio()``
# on the normalised keys with a **canonical argument order** (shorter key
# first; equal length: the key that sorts first by code point first), because
# ``ratio()`` can depend on the argument order and ``autojunk`` changes results
# for strings of 200+ characters.
#
# Numbers: the similarity treats a digit like a letter, so "Block 21" is 0.875 similar to
# "Block 12" although they are two different codes. A NEAR_MISS whose value and suggestion both
# contain numbers that differ ("21" against "12") says so in DETAIL; with ``numbers_must_match``
# such an entry is not a candidate at all (the value is then UNKNOWN unless another entry fits).
# Only runs of digits are compared: letters in a code ("3B" against "3C") are not protected, and
# "1,000" (two runs), "12.0" and "012" count as other numbers than "1000" and "12".
#
# Ties: the highest score wins; among equal scores an entry without a numbers
# conflict (see above) comes first, then they are broken by the normalised key,
# then by the raw vocabulary entry, both in code-point order. The other tied
# entries are listed in ``detail`` (the first ``VOCAB_MAX_LISTED_TIES``, then
# the number of the rest). Several vocabulary entries with the same
# normalised key: each one is an exact match for itself; for other spellings
# the suggestion is the raw entry that sorts first.
#
# Speed: values are deduplicated first (classification depends only on the
# raw value), and only vocabulary keys whose length and character counts make
# the cutoff reachable are scored (``ratio <= 2*min(la, lb)/(la + lb)`` and
# ``ratio <= quick_ratio``), best bound first, stopping as soon as no
# remaining bound can beat the best score found.

VOCAB_NORMALISATION = "NORMALISATION"
VOCAB_NEAR_MISS = "NEAR_MISS"
VOCAB_UNKNOWN = "UNKNOWN"
VOCAB_ISSUES = (VOCAB_NORMALISATION, VOCAB_NEAR_MISS, VOCAB_UNKNOWN)

VOCAB_DEFAULT_CUTOFF = 0.8
VOCAB_SAMPLE_OIDS = 10
# Tied entries named in DETAIL; the rest are counted. Short values against a large
# vocabulary at a low cutoff can tie with thousands of entries, and the same list
# would be written on every row (and must fit a dBASE field and an Excel cell).
VOCAB_MAX_LISTED_TIES = 10
VOCAB_SCORE_DECIMALS = 3
# Highest SCORE of a NEAR_MISS: 1.0 is kept for NORMALISATION, so a ratio such as 0.9996 (a long
# text with one letter changed) is shown as 0.999, not rounded up to 1.0.
VOCAB_NEAR_MISS_MAX_SCORE = 0.999
# DETAIL of a value that is not blank but empty once normalised (for example tatweel or tashkeel
# only): it is UNKNOWN, and not counted as blank, because the cell does hold characters.
VOCAB_EMPTY_DETAIL = (u"Empty once normalised: the value holds only characters the comparison "
                      u"removes (tatweel, tashkeel, invisible or control characters).")

_VOCAB_STRIP = u"".join(sorted(TEXT_SPACES | TEXT_LINE_BREAKS))


# --------------------------------------------------------------------------
# Normalisation and similarity
# --------------------------------------------------------------------------

def vocab_key(value, ignore_case=True, normalise_arabic=True, fold_teh_marbuta=False):
    """Normalised comparison key of a value (``None`` for null/blank values).

    Always: Unicode NFC first (a decomposed spelling such as "u" + combining
    diaeresis, or Arabic yeh + combining hamza, gets the same key as the
    precomposed one), control characters and every invisible format mark
    removed (``VOCAB_HIDDEN``: ZWSP, BOM, LRM, RLM, ALM, bidi controls, and ZWNJ/ZWJ
    too, whatever ``normalise_arabic``), Arabic-Indic digits as ASCII, spaces
    trimmed and collapsed. ``ignore_case``: casefold. ``normalise_arabic``:
    ``common.text.arabic_normalize`` defaults (tashkeel, tatweel, alef forms, alef
    maqsura -> yeh, Persian kaf/yeh, presentation forms). ``fold_teh_marbuta``: also
    teh marbuta -> heh (only with ``normalise_arabic``).

    The steps and their order are those of ``common.text.normalize_text`` (NFC, controls,
    invisible marks, Arabic, digits, whitespace, casefold), with two differences:
    ``remove_invisible`` is asked to remove the joiners as well, so that "Riy<ZWNJ>adh"
    has the key of "Riyadh" also with Arabic folding off, and NFC is applied once more at the end.
    """
    if value is None or is_blank(value):
        return None
    text = value_to_text(value)
    # NFC before any folding: Arabic folding removes a combining hamza (U+0654) as tashkeel,
    # which would otherwise split U+064A U+0654 from its canonical equivalent U+0626.
    text = to_nfc(text)
    text = strip_control_chars(text)
    text = remove_invisible(text, joiners=True)
    if normalise_arabic:
        text = arabic_normalize(text, teh_marbuta=bool(fold_teh_marbuta))
    text = fold_digits(text)
    text = collapse_whitespace(text)
    if ignore_case:
        text = text.casefold()
    # NFC again at the end: removing a mark between a letter and a combining accent ("e", ZWSP,
    # U+0301) leaves a decomposed pair, which must still equal the composed letter, whatever the
    # Arabic option (``arabic_normalize`` applies NFC at its start only).
    return to_nfc(text)


def vocab_numbers(key):
    """The runs of ASCII digits of a normalised key, in order: ``"block 12 b7"`` -> ``("12", "7")``."""
    runs, run = [], []
    for ch in key:
        if u"0" <= ch <= u"9":
            run.append(ch)
        elif run:
            runs.append(u"".join(run))
            run = []
    if run:
        runs.append(u"".join(run))
    return tuple(runs)


def vocab_numbers_conflict(a, b):
    """True when both keys contain numbers and the numbers differ (a different code, not a typo)."""
    na, nb = vocab_numbers(a), vocab_numbers(b)
    return bool(na) and bool(nb) and na != nb


def vocab_pair_order(a, b):
    """The canonical argument order: shorter first, then code-point order."""
    if (len(a), a) <= (len(b), b):
        return a, b
    return b, a


# Invisible format marks (zero width space, BOM, word joiner, soft hyphen, LRM, RLM, ALM, bidi
# embeddings and isolates, ZWNJ, ZWJ): a value or an entry that differs only by them looks the same.
VOCAB_HIDDEN = frozenset(TEXT_INVISIBLE | TEXT_JOINERS)


def vocab_hidden_codes(text):
    """Sorted code points of the invisible format marks (``VOCAB_HIDDEN``) in ``text``."""
    if not isinstance(text, str):
        return []
    return sorted(set(ord(ch) for ch in text if ch in VOCAB_HIDDEN))


def vocab_show_hidden(text, controls=False):
    """``text`` with every invisible format mark written as ``<U+XXXX>`` (for messages); with
    ``controls`` also every control character (``vocab_entry_control_codes``)."""
    if not isinstance(text, str):
        return text
    return u"".join(u"<U+{0:04X}>".format(ord(ch))
                    if ch in VOCAB_HIDDEN or (controls and is_control_char(ch)) else ch
                    for ch in text)


def vocab_entry_control_codes(text):
    """Sorted code points of the control characters in ``text`` that the comparison removes
    (C0 and C1 controls other than tab and line breaks: ``common.text.is_control_char``)."""
    if not isinstance(text, str):
        return []
    return sorted(set(ord(ch) for ch in text if is_control_char(ch)))


# Characters that look like another one in a table cell: every space form other than U+0020 (NBSP,
# thin space ...) and every line break looks like a space; the Arabic presentation forms and the
# Persian kaf and yeh look like (or nearly like) the plain Arabic letters.
_VOCAB_SPACE_FORMS = frozenset((TEXT_SPACES | TEXT_LINE_BREAKS) - set(u" "))


def _vocab_is_presentation(ch):
    c = ord(ch)
    return 0xFB50 <= c <= 0xFDFF or 0xFE70 <= c <= 0xFEFE


def _vocab_letter_form(ch):
    """The plain letter(s) of a presentation form or a Persian kaf/yeh; ``ch`` otherwise."""
    if _vocab_is_presentation(ch):
        comp = unicodedata.normalize("NFKC", ch)
        if len(comp) > 1 and comp[0] == u" " and all(unicodedata.combining(c) for c in comp[1:]):
            comp = comp[1:]
        return comp
    return TEXT_PERSIAN_LETTERS.get(ch, ch)


def _vocab_fold(text, spaces, letters):
    out = []
    for ch in text:
        if spaces and ch in _VOCAB_SPACE_FORMS:
            ch = u" "
        elif letters:
            ch = _vocab_letter_form(ch)
        out.append(ch)
    return to_nfc(u"".join(out))


def _vocab_codes(chars):
    return u", ".join(u"U+{0:04X}".format(c) for c in sorted(set(ord(ch) for ch in chars)))


def _vocab_and(parts):
    if len(parts) == 1:
        return parts[0]
    return u", ".join(parts[:-1]) + u" and " + parts[-1]


def vocab_hidden_detail(value, suggestion):
    """DETAIL hint when ``value`` and ``suggestion`` differ but look the same (or nearly) in a table
    cell, that is when they are equal once these look-alike differences are removed:

    * invisible format marks (``VOCAB_HIDDEN``) -> "invisible characters (U+...)";
    * Unicode composition (a decomposed letter against the composed one, NFC) -> "Unicode composition";
    * space forms: a space other than U+0020 (NBSP, thin space ...) or a line break where the other
      text has U+0020 (one for one: no trimming or collapsing) -> "space forms (U+...)";
    * letter forms: Arabic presentation forms (U+FB50-FDFF, U+FE70-FEFE) and the Persian kaf and yeh
      (U+06A9, U+06CC) against the plain Arabic letters -> "letter forms (U+...)";
    * control characters (``vocab_entry_control_codes``), only when the suggestion holds one (for
      example U+0001 in a vocabulary entry) -> "control characters (U+...)"; a control character in
      the value alone gives no hint (the tool warns about it).

    Visible differences give no hint at all: case, extra, leading or trailing U+0020 spaces,
    tashkeel, tatweel, alef forms, alef maqsura, teh marbuta, digits, and a control character in
    the value only. Empty text otherwise. With one
    kind of difference the sentence is "Differs only in invisible characters (U+200F).", "... in
    Unicode composition (decomposed against composed letters).", "... in space forms (U+00A0)." or
    "... in letter forms (U+FEFB)."; several kinds are joined in the order above
    ("Differs only in space forms (U+00A0) and invisible characters (U+200C)."; Unicode composition
    keeps its note "(decomposed against composed letters)" there too). Control characters come after
    invisible characters ("Differs only in control characters (U+0001).")."""
    if not isinstance(value, str) or not isinstance(suggestion, str) or value == suggestion:
        return u""
    # Control characters give a hint only when the SUGGESTION (a vocabulary entry) holds one: a
    # control character in the value alone is named by the tool's own warning, and applying the
    # suggestion removes it; one in the suggestion would be copied into the data unnoticed.
    ctrl = []
    if vocab_entry_control_codes(suggestion):
        ctrl = sorted(set(vocab_entry_control_codes(value)) |
                      set(vocab_entry_control_codes(suggestion)))
    a = u"".join(ch for ch in value if ch not in VOCAB_HIDDEN and not (ctrl and is_control_char(ch)))
    b = u"".join(ch for ch in suggestion
                 if ch not in VOCAB_HIDDEN and not (ctrl and is_control_char(ch)))
    codes = sorted(set(vocab_hidden_codes(value)) | set(vocab_hidden_codes(suggestion)))
    marks = u", ".join(u"U+{0:04X}".format(c) for c in codes)
    if a == b and not ctrl:
        return u"Differs only in invisible characters ({0}).".format(marks)
    na, nb = to_nfc(a), to_nfc(b)
    if na == nb and not ctrl:
        if codes:
            return (u"Differs only in invisible characters ({0}) and in Unicode composition "
                    u"(decomposed against composed letters).".format(marks))
        return u"Differs only in Unicode composition (decomposed against composed letters)."
    if _vocab_fold(na, True, True) != _vocab_fold(nb, True, True):
        return u""
    parts = []
    diff = set(na) ^ set(nb)
    if _vocab_fold(na, False, True) != _vocab_fold(nb, False, True):
        space = [ch for ch in diff if ch in _VOCAB_SPACE_FORMS] or \
            [ch for ch in set(na) | set(nb) if ch in _VOCAB_SPACE_FORMS]
        parts.append(u"space forms ({0})".format(_vocab_codes(space)))
    if _vocab_fold(na, True, False) != _vocab_fold(nb, True, False):
        letters = [ch for ch in diff if _vocab_letter_form(ch) != ch] or \
            [ch for ch in set(na) | set(nb) if _vocab_letter_form(ch) != ch]
        parts.append(u"letter forms ({0})".format(_vocab_codes(letters)))
    if codes:
        parts.append(u"invisible characters ({0})".format(marks))
    if ctrl:
        parts.append(u"control characters ({0})".format(
            u", ".join(u"U+{0:04X}".format(c) for c in ctrl)))
    if a != na or b != nb:
        parts.append(u"Unicode composition (decomposed against composed letters)")
    if not parts:
        return u""
    return u"Differs only in {0}.".format(_vocab_and(parts))


def vocab_similarity(a, b):
    """``SequenceMatcher(None, x, y, autojunk=False).ratio()`` in canonical order."""
    x, y = vocab_pair_order(a, b)
    if not x and not y:
        return 1.0
    return difflib.SequenceMatcher(None, x, y, autojunk=False).ratio()


def _vocab_counts(text):
    counts = {}
    for ch in text:
        counts[ch] = counts.get(ch, 0) + 1
    return counts


def _vocab_length_ok(la, lb, cutoff):
    total = la + lb
    return total > 0 and 2.0 * min(la, lb) / total >= cutoff


def vocab_tie_text(label, entries):
    """``"Equal score: a; b"`` for the tied ``entries`` (other than the suggestion): the first
    ``VOCAB_MAX_LISTED_TIES`` are listed, then ``... and N more``."""
    text = label + u"; ".join(entries[:VOCAB_MAX_LISTED_TIES])
    if len(entries) > VOCAB_MAX_LISTED_TIES:
        text += u" ... and {0} more".format(len(entries) - VOCAB_MAX_LISTED_TIES)
    return text


# --------------------------------------------------------------------------
# Vocabulary
# --------------------------------------------------------------------------

class Vocabulary(object):
    """A controlled vocabulary prepared for exact, normalised and fuzzy lookup."""

    def __init__(self, entries, ignore_case=True, normalise_arabic=True,
                 fold_teh_marbuta=False, strip=True, name=u"", numbers_must_match=False):
        """``entries``: iterable of allowed values. Nulls and blank values are
        skipped; with ``strip`` (table and file vocabularies) leading and
        trailing spaces are removed from each entry (domain codes are kept
        exactly). Non-text entries are converted with ``str``. ``numbers_must_match``: an
        entry whose numbers differ from the value's numbers is never a NEAR_MISS candidate
        (see the module note on numbers)."""
        self.name = name
        self.numbers_must_match = bool(numbers_must_match)
        self.options = {"ignore_case": ignore_case, "normalise_arabic": normalise_arabic,
                        "fold_teh_marbuta": fold_teh_marbuta}
        self.exact = set()
        by_key = {}
        self.skipped = 0
        for entry in entries:
            if entry is None or is_blank(entry):
                self.skipped += 1
                continue
            text = entry if isinstance(entry, str) else str(entry)
            if strip:
                text = text.strip(_VOCAB_STRIP)
            key = vocab_key(text, **self.options)
            if not key:
                self.skipped += 1
                continue
            self.exact.add(text)
            by_key.setdefault(key, set()).add(text)
        # key -> raw entries in code-point order (the first is the suggestion)
        self.by_key = dict((k, sorted(v)) for k, v in by_key.items())
        # length -> (keys, {character: [(index in keys, count)]})
        self.by_length = {}
        for key in sorted(self.by_key):
            keys, postings = self.by_length.setdefault(len(key), ([], {}))
            for ch, n in _vocab_counts(key).items():
                postings.setdefault(ch, []).append((len(keys), n))
            keys.append(key)
        self.lengths = sorted(self.by_length)
        self._cache = {}

    def __len__(self):
        return len(self.exact)

    def collisions(self):
        """Groups of different raw entries that share one normalised key."""
        return [v for _k, v in sorted(self.by_key.items()) if len(v) > 1]

    def hidden_entries(self):
        """Raw entries that contain invisible format marks (``VOCAB_HIDDEN``), in code-point order.
        Such an entry, used as a suggestion, would carry the mark into the data."""
        return sorted(e for e in self.exact if vocab_hidden_codes(e))

    def control_entries(self):
        """Raw entries that contain control characters (``vocab_entry_control_codes``, for example
        U+0001), in code-point order. Such an entry, used as a suggestion, would carry the control
        character into the data although it looks like the plain text."""
        return sorted(e for e in self.exact if vocab_entry_control_codes(e))

    def best_matches(self, key, cutoff):
        """``(score, [keys])``: the best similarity >= ``cutoff`` and every
        vocabulary key reaching it (code-point order); ``(None, [])`` if none."""
        la = len(key)
        if la == 0:
            return None, []
        counts = list(_vocab_counts(key).items())
        # Length buckets, best length bound first: once the best score found
        # beats the length bound of the next bucket, no later bucket can win.
        buckets = []
        for lb in self.lengths:
            if _vocab_length_ok(la, lb, cutoff):
                buckets.append((-2.0 * min(la, lb) / (la + lb), lb))
        buckets.sort()
        best, ties = None, []
        for neg_len_bound, lb in buckets:
            if -neg_len_bound < (cutoff if best is None else best):
                break
            total = float(la + lb)
            keys, postings = self.by_length[lb]
            common = [0] * len(keys)  # shared characters (multiset) per key
            for ch, n in counts:
                for index, m in postings.get(ch, ()):
                    common[index] += n if n < m else m
            candidates = []
            for index, c in enumerate(common):
                if c:
                    bound = 2.0 * c / total  # = difflib quick_ratio, >= ratio
                    if bound >= cutoff:
                        candidates.append((-bound, keys[index]))
            candidates.sort()
            for neg_bound, other in candidates:
                if -neg_bound < (cutoff if best is None else best):
                    break
                if self.numbers_must_match and vocab_numbers_conflict(key, other):
                    continue
                score = vocab_similarity(key, other)
                if score < cutoff:
                    continue
                if best is None or score > best:
                    best, ties = score, [other]
                elif score == best:
                    ties.append(other)
        return best, sorted(ties)

    def classify(self, value, cutoff=VOCAB_DEFAULT_CUTOFF):
        """``None`` if ``value`` is null/blank or exactly in the vocabulary, else
        ``{"issue", "suggestion", "score", "detail"}``."""
        if value is None or is_blank(value):
            return None
        text = value if isinstance(value, str) else str(value)
        if text in self.exact:
            return None
        key = vocab_key(text, **self.options)
        if key in self.by_key:
            raws = self.by_key[key]
            detail = vocab_hidden_detail(text, raws[0])
            if len(raws) > 1:
                detail = (detail + u" " if detail else u"") + vocab_tie_text(u"Equal match: ",
                                                                             raws[1:])
            return {"issue": VOCAB_NORMALISATION, "suggestion": raws[0], "score": 1.0,
                    "detail": detail}
        if not key:
            # Not blank, but nothing is left once normalised (only tatweel, tashkeel, invisible or
            # control characters): no entry can be close, and DETAIL says why.
            return {"issue": VOCAB_UNKNOWN, "suggestion": None, "score": None,
                    "detail": VOCAB_EMPTY_DETAIL}
        cache_key = (key, cutoff)
        if cache_key not in self._cache:
            self._cache[cache_key] = self.best_matches(key, cutoff)
        score, keys = self._cache[cache_key]
        if score is None:
            return {"issue": VOCAB_UNKNOWN, "suggestion": None, "score": None, "detail": u""}
        # Among equal scores an entry whose numbers do not conflict with the value's comes first
        # ("Streat 37" suggests "Street 37", not "Streat 36"); otherwise code-point order.
        keys = sorted(keys, key=lambda k: vocab_numbers_conflict(key, k))
        raws = []
        for k in keys:
            raws.extend(self.by_key[k])
        # A NEAR_MISS can still look like its suggestion (for example an Arabic presentation form
        # with Normalise Arabic letters off): the same look-alike hint as for a NORMALISATION.
        detail = vocab_hidden_detail(text, raws[0])
        if vocab_numbers_conflict(key, keys[0]):
            detail = (detail + u" " if detail else u"") + (
                u"The numbers differ ({0} against {1}): check before applying.".format(
                    u", ".join(vocab_numbers(key)), u", ".join(vocab_numbers(keys[0]))))
        if len(raws) > 1:
            detail = (detail + u" " if detail else u"") + vocab_tie_text(u"Equal score: ", raws[1:])
        return {"issue": VOCAB_NEAR_MISS, "suggestion": raws[0],
                "score": min(round(score, VOCAB_SCORE_DECIMALS), VOCAB_NEAR_MISS_MAX_SCORE),
                "detail": detail}


# --------------------------------------------------------------------------
# Checking values
# --------------------------------------------------------------------------

def vocab_sample_oids(oids, limit=VOCAB_SAMPLE_OIDS):
    """``"1, 5, 9"``: the ``limit`` smallest OIDs, then ``", ..."`` if more."""
    ordered = sorted(oids)
    text = u", ".join(str(o) for o in ordered[:limit])
    if len(ordered) > limit:
        text += u", ..."
    return text


def check_field_values(pairs, vocabulary, field, cutoff=VOCAB_DEFAULT_CUTOFF, progress=None):
    """Check ``pairs`` = ``[(oid, value)]`` of one field against ``vocabulary``.

    Returns ``(results, stats)``. ``results`` has one dict per distinct
    non-conforming raw value: ``{"field", "value", "count", "issue",
    "suggestion", "score", "sample_oids", "vocab", "detail"}``. ``stats``:
    ``{"rows", "blank", "conforming", "distinct", "nonconforming_rows"}``.
    ``progress(n)`` is called with the number of distinct values done.
    """
    groups = {}
    order = []
    blank = 0
    for oid, value in pairs:
        if value is None or is_blank(value):
            blank += 1
            continue
        text = value if isinstance(value, str) else str(value)
        if text not in groups:
            groups[text] = []
            order.append(text)
        groups[text].append(oid)
    results = []
    conforming = 0
    for i, text in enumerate(order):
        found = vocabulary.classify(text, cutoff)
        oids = groups[text]
        if found is None:
            conforming += len(oids)
        else:
            results.append({"field": field, "value": text, "count": len(oids),
                            "issue": found["issue"], "suggestion": found["suggestion"],
                            "score": found["score"], "sample_oids": vocab_sample_oids(oids),
                            "vocab": vocabulary.name, "detail": found["detail"]})
        if progress is not None:
            progress(i + 1)
    stats = {"rows": len(pairs), "blank": blank, "conforming": conforming,
             "distinct": len(order),
             "nonconforming_rows": sum(r["count"] for r in results)}
    return results, stats


def sort_results(results, field_order):
    """Output order: field (``field_order``), vocabulary, issue (NORMALISATION,
    NEAR_MISS, UNKNOWN), suggestion (empty last), count descending, value."""
    rank = dict((f, i) for i, f in enumerate(field_order))

    def key(r):
        sug = r["suggestion"]
        return (rank.get(r["field"], len(rank)), r["field"], r["vocab"] or u"",
                VOCAB_ISSUES.index(r["issue"]), sug is None, sug or u"", -r["count"],
                r["value"])
    return sorted(results, key=key)


def vocab_summary(results, stats, extra=()):
    """Summary rows ``(item, value)`` for the report."""
    rows = list(extra)
    rows += [("Rows read", stats.get("rows", 0)),
             ("Null or blank values skipped", stats.get("blank", 0)),
             ("Values in the vocabulary", stats.get("conforming", 0)),
             ("Values not in the vocabulary", stats.get("nonconforming_rows", 0)),
             ("Distinct values checked", stats.get("distinct", 0)),
             ("Distinct values not in the vocabulary", len(results))]
    for issue in VOCAB_ISSUES:
        hits = [r for r in results if r["issue"] == issue]
        rows.append(("{0} (distinct values)".format(issue), len(hits)))
        rows.append(("{0} (rows)".format(issue), sum(r["count"] for r in hits)))
    return rows


# Control characters an Excel cell cannot hold (XML 1.0): U+0000-U+0008, U+000B, U+000C,
# U+000E-U+001F. Tab, line feed and carriage return are allowed.
VOCAB_XLSX_ILLEGAL = frozenset(list(range(0, 9)) + [11, 12] + list(range(14, 32)))


def vocab_control_codes(text):
    """Sorted code points of ``text`` that an Excel cell cannot hold (``VOCAB_XLSX_ILLEGAL``)."""
    if not isinstance(text, str):
        return []
    return sorted(set(ord(ch) for ch in text if ord(ch) in VOCAB_XLSX_ILLEGAL))


def vocab_visible_controls(value):
    """``value`` with every character of ``VOCAB_XLSX_ILLEGAL`` written as ``<U+XXXX>``
    (``"Riyadh\\x01"`` -> ``"Riyadh<U+0001>"``); other values unchanged. Used for the Excel
    report, which would otherwise drop such characters without a trace."""
    if not isinstance(value, str) or not vocab_control_codes(value):
        return value
    return u"".join(u"<U+{0:04X}>".format(ord(ch)) if ord(ch) in VOCAB_XLSX_ILLEGAL else ch
                    for ch in value)


# An Excel cell holds at most 32,767 characters, counted in UTF-16 units (a character above U+FFFF
# counts 2). The shared report writer cuts a longer text and marks the cut; the tool warns.
VOCAB_XLSX_MAX_CELL = 32767


def vocab_excel_too_long(value):
    """True when ``value`` is a text longer than an Excel cell holds (``VOCAB_XLSX_MAX_CELL``)."""
    if not isinstance(value, str) or len(value) * 2 <= VOCAB_XLSX_MAX_CELL:
        return False             # even all characters above U+FFFF would fit
    return len(value) + sum(1 for ch in value if ord(ch) > 0xFFFF) > VOCAB_XLSX_MAX_CELL


def merge_stats(total, stats):
    """Add ``stats`` into ``total`` (both dicts of counts)."""
    for k, v in stats.items():
        total[k] = total.get(k, 0) + v
    return total


# --------------------------------------------------------------------------
# Vocabulary files
# --------------------------------------------------------------------------

VOCAB_CSV_DELIMITERS = (",", ";", "\t", "|")
_VOCAB_DELIMITER_NAMES = {",": "comma", ";": "semicolon", "\t": "tab", "|": "vertical bar"}


def vocab_csv_delimiter(data):
    """Delimiter of CSV text ``data`` from its header line: the most frequent
    of ``,`` ``;`` tab ``|`` outside quoted fields (comma on ties or when none
    occurs). Excel writes ";" in locales whose list separator is ";".

    As in ``csv.reader``, only a double quote at the start of a field opens a
    quoted field; the header ends at the first line break outside quotes.
    """
    counts = dict((d, 0) for d in VOCAB_CSV_DELIMITERS)
    quoted, field_start = False, True
    text = data or u""
    i = 0
    while i < len(text):
        ch = text[i]
        if quoted:
            if ch == '"':
                if text[i + 1:i + 2] == '"':
                    i += 2
                    continue
                quoted = False
        elif ch in "\r\n":
            break
        elif ch == '"' and field_start:
            quoted, field_start = True, False
        elif ch in counts:
            counts[ch] += 1
            field_start = True
        else:
            field_start = False
        i += 1
    best = ","
    for d in VOCAB_CSV_DELIMITERS[1:]:
        if counts[d] > counts[best]:
            best = d
    return best


def vocab_delimiter_name(delimiter):
    """``"semicolon"`` etc. for a delimiter of ``VOCAB_CSV_DELIMITERS``."""
    return _VOCAB_DELIMITER_NAMES.get(delimiter, repr(delimiter))


def read_vocabulary_text(data, is_csv, column=None, source=u"file", delimiter=None, info=None):
    """Entries of a vocabulary file given its decoded text ``data``.

    Plain text: one value per line, blank lines skipped, no header. CSV: the
    first row is a header; ``column`` names the column (matched like a field
    name: case, spaces, dashes and underscores ignored), default the first.
    ``delimiter``: ``None`` detects it from the header (``vocab_csv_delimiter``).
    ``info``: an optional dict; for CSV it receives ``delimiter``, ``header``
    (list of names), ``column`` (the header name used), ``long_rows`` (number of
    data rows with more cells than the header) and ``long_example``
    (``(line number, cells)`` of the first such row, or ``None``); when there is such a row also
    ``long_line`` (that row as written in the file, quotes included).

    Plain text lines end only at CR LF, LF or CR: ``str.splitlines`` would also
    split an entry at U+2028, U+2029, U+0085, U+000B, U+000C or U+001C-U+001E.

    CSV rows with more cells than the header usually hold a value with an
    unquoted delimiter (``King Fahd Road, North``). With a one-column header
    such a row is read as ONE value: the whole line as written in the file (quotes included,
    so ``"a,b",c`` stays ``"a,b",c``). With several header columns the extra cells
    are ignored. Either way ``long_rows`` counts them so the caller can warn.
    """
    if not is_csv:
        lines = data.replace(u"\r\n", u"\n").replace(u"\r", u"\n").split(u"\n")
        if lines and lines[-1] == u"":
            lines.pop()          # the line break after the last line
        return lines
    if delimiter is None:
        delimiter = vocab_csv_delimiter(data)
    reader = csv.reader(io.StringIO(data), delimiter=delimiter)
    # physical lines as csv.reader counts them (split after each LF), to give back a row as written
    physical = io.StringIO(data).readlines()
    rows, lines, raws = [], [], []
    for row in reader:
        start = lines[-1] if lines else 0
        rows.append(row)
        lines.append(reader.line_num)
        raws.append(u"".join(physical[start:reader.line_num]).rstrip(u"\r\n"))
    header = rows[0] if rows else []
    index = 0
    if column and rows:
        wanted = normalize_field_name(column)
        hits = [i for i, h in enumerate(header) if normalize_field_name(h) == wanted]
        if len(hits) != 1:
            raise ToolError(
                "The vocabulary column '{0}' was {1} in the header of {2} ({3}-delimited)."
                .format(column, "not found" if not hits else "found more than once", source,
                        vocab_delimiter_name(delimiter)),
                "Use one of the header names: {0}.".format(
                    u", ".join(h for h in header) or "(empty header)"))
        index = hits[0]
    width = max(1, len(header))
    long_index = [i for i in range(1, len(rows)) if len(rows[i]) > width]
    if info is not None:
        info.update({"delimiter": delimiter, "header": list(header),
                     "column": header[index] if index < len(header) else None,
                     "long_rows": len(long_index),
                     "long_example": (lines[long_index[0]], rows[long_index[0]])
                     if long_index else None})
        if long_index:
            info["long_line"] = raws[long_index[0]]
    if width == 1:
        # one column: a row with more cells is a value with an unquoted delimiter; it is read as
        # the whole line as written (quotes included: 'Name\n"a,b",c' gives '"a,b",c', not 'a,b,c')
        return [raws[i] if len(rows[i]) > 1 else (rows[i][0] if rows[i] else None)
                for i in range(1, len(rows))]
    return [r[index] if index < len(r) else None for r in rows[1:]]


def read_vocabulary_file(path, column=None, info=None):
    """Read a .txt or .csv vocabulary file (UTF-8, with or without BOM).

    Text that does not decode as UTF-8, or that contains a NUL character (UTF-16 without a
    byte-order mark decodes as "UTF-8" with a NUL after every ASCII letter), is refused.

    ``info``: an optional dict, filled for a .csv file as in
    ``read_vocabulary_text``.
    """
    is_csv = str(path).casefold().endswith(".csv")
    try:
        with io.open(path, "r", encoding="utf-8-sig", newline="" if is_csv else None) as handle:
            data = handle.read()
    except UnicodeDecodeError:
        raise ToolError("The vocabulary file '{0}' is not UTF-8 text.".format(path),
                        "Save the file as UTF-8 (for example 'CSV UTF-8' in Excel) and run "
                        "the tool again.")
    except (IOError, OSError) as exc:
        raise ToolError("The vocabulary file '{0}' could not be read: {1}".format(path, exc),
                        "Check that the file exists and is not open in another program.")
    if u"\x00" in data:
        # UTF-16 (or UTF-32) without a byte-order mark is valid UTF-8 when the text is ASCII:
        # every letter is followed by a NUL character, so nothing would ever match.
        raise ToolError("The vocabulary file '{0}' contains NUL characters, so it is not UTF-8 "
                        "text (it is probably UTF-16, which Excel and Notepad call 'Unicode' "
                        "or 'Unicode Text').".format(path),
                        "Save the file as UTF-8 (for example 'CSV UTF-8' in Excel, or 'UTF-8' in "
                        "Notepad's Save As) and run the tool again.")
    return read_vocabulary_text(data, is_csv, column, path, info=info)


# ==========================================================================
# quality/atlas_core.py
# ==========================================================================
# QC Scorecard Report: the numbers behind the report (pure Python, no arcpy).
#
# * ``parse_thresholds`` / ``apply_thresholds`` / ``build_scorecard``: severity overrides,
#   per-rule limits, the pass rate and the PASS / FAIL verdict;
# * ``make_transform``: world coordinates -> SVG pixels (uniform scale,
#   Y flipped, 2 % margin);
# * ``AtlasVertexBudget``: thins the context outline until it fits ``max_vertices``
#   (every k-th vertex, first and last kept; extent only when even that is too much);
# * ``hex_bin`` / ``density_classes``: flat-top hexagon density of the issue locations.
#
# Terms used in the report:
#
# * **pass rate** = 100 x (1 - failing features / checked features). A *failing feature* is a
#   checked feature (dataset + object id) with at least one ERROR issue. *Checked features* are
#   the rows of the datasets the user named as checked. Without a checked dataset there is no
#   rate (the report says so); nothing is guessed. Only object ids that exist in the checked
#   dataset count; an ERROR row without an object id counts as one failing feature of its own
#   (a worst case, said in the report); an id that is not in the checked dataset is left out
#   (said in the report). The rate is never below 0 or above 100.
# * **rule share** (what ``MAX_RATE`` is compared with) = checked features hit by the rule's
#   issues / checked features, where every issue that is not on a checked feature (no object id,
#   an id not in the checked dataset, or a SOURCE that is not a checked dataset) counts as one
#   feature of its own. An issue that cannot be matched never lowers the share.
# * **location**: a place where one or more issues sit (the same point, to 1 mm or, in degrees,
#   to 1e-7 degree). "948 errors at 611 locations" means 337 of them share a point with another.
# * **rule limit**: ``MAX_COUNT`` is the largest number of issues of the rule that is accepted;
#   ``MAX_RATE`` the largest accepted percentage of all checked features that the rule may hit.

ATLAS_SVG_WIDTH = 1000.0
ATLAS_MARGIN_FRACTION = 0.02
ATLAS_MIN_HEIGHT = 300.0
ATLAS_MAX_HEIGHT = 1400.0
ATLAS_MAX_VERTICES_DEFAULT = 200000
ATLAS_MIN_VERTICES = 1000
ATLAS_MAX_CIRCLES = 3000       # issue circles drawn in the atlas (the rest is sampled)
ATLAS_DENSITY_UNDER = 600      # above this many located issues the atlas shows the hexagons under the circles
ATLAS_CIRCLE_R_MAX = 7.0
ATLAS_CIRCLE_R_MIN = 2.5
ATLAS_CIRCLE_R_FULL = 300      # up to this many circles the radius stays at its maximum
ATLAS_CSV_MAX = 10000          # issues in the CSV link of the report
ATLAS_HEX_ACROSS = 24          # default hexagon size: longer map side / 24 (many issues)
ATLAS_HEX_ACROSS_MIN = 6       # ... down to longer side / 6 when there are few issues
ATLAS_HEX_MAX_CELLS = 20000
ATLAS_CLASS_COUNT = 5
ATLAS_EVEN_SPREAD = 1.5        # busiest hexagon under 1.5 x the median count: one class (one shade)
ATLAS_CLASS_STEP = 1.2         # a darker class starts at >= 1.2 x the lowest count of the class before
ATLAS_CLUSTER_MIN_LOCATIONS = 30   # fewer located places: no statement about clustering
ATLAS_CLUSTER_MIN_SHARE = 40.0     # "cluster" = one window of 1/9 of the map holds >= 40 % of the locations
ATLAS_GRID = 12                    # the map is cut into 12 x 12 cells; a window is 4 x 4 cells
ATLAS_WINDOW = 4
ATLAS_ISSUE_LIST = 200

ATLAS_SEVERITY_RANK = {UNI_ERROR: 0, UNI_WARNING: 1, UNI_INFO: 2}

# 1 unit in metres. The keywords are those of ArcGIS Pro's linear-unit control (Esri,
# "Geoprocessing considerations for length and area units"): Inches, Feet, Yards, Miles and
# NauticalMiles are US Survey units, InchesInt, FeetInt, YardsInt, MilesInt and
# NauticalMilesInt international ones. A US survey foot is 1200/3937 m; the nautical mile is
# 1852 m in both (the United States adopted the international nautical mile in 1954). Plain
# words (metre, foot, ...) are accepted too; a bare "foot"/"feet" follows Pro's Feet.
_ATLAS_US_FOOT = 1200.0 / 3937.0
ATLAS_UNIT_METRES = {
    "meter": 1.0, "meters": 1.0, "metre": 1.0, "metres": 1.0,
    "kilometer": 1000.0, "kilometers": 1000.0, "kilometre": 1000.0, "kilometres": 1000.0,
    "centimeter": 0.01, "centimeters": 0.01, "centimetre": 0.01, "centimetres": 0.01,
    "millimeter": 0.001, "millimeters": 0.001, "millimetre": 0.001, "millimetres": 0.001,
    "decimeter": 0.1, "decimeters": 0.1, "decimetre": 0.1, "decimetres": 0.1,
    "foot": _ATLAS_US_FOOT, "feet": _ATLAS_US_FOOT,
    "yard": 3.0 * _ATLAS_US_FOOT, "yards": 3.0 * _ATLAS_US_FOOT,
    "mile": 5280.0 * _ATLAS_US_FOOT, "miles": 5280.0 * _ATLAS_US_FOOT,
    "inch": _ATLAS_US_FOOT / 12.0, "inches": _ATLAS_US_FOOT / 12.0,
    "nautical mile": 1852.0, "nautical miles": 1852.0, "nauticalmile": 1852.0,
    "nauticalmiles": 1852.0,
    "footint": 0.3048, "feetint": 0.3048, "yardint": 0.9144, "yardsint": 0.9144,
    "mileint": 1609.344, "milesint": 1609.344, "inchint": 0.0254, "inchesint": 0.0254,
    "nauticalmileint": 1852.0, "nauticalmilesint": 1852.0,
    "points": 0.0254 / 72.0, "point": 0.0254 / 72.0,
}
ATLAS_DEGREE_UNITS = ("decimaldegrees", "decimal degrees", "degrees", "degree")


def atlas_id_text(value):
    """The text of a rule id or a SOURCE cell, the same for every column type, so a rule id
    read from a DOUBLE column (Excel To Table makes numeric columns DOUBLE) is the rule of the
    same number in a LONG or TEXT column:

    * a whole float is its integer text with every digit (``101.0`` -> ``"101"``,
      ``1234567.0`` -> ``"1234567"``; never cut to 6 significant digits);
    * another finite float is its shortest exact text (``101.5`` -> ``"101.5"``); NaN and
      infinities give ``""``;
    * an integer is its digits; text is kept as written (``"101.0"`` stays ``"101.0"``);
    * control characters are removed and tab and line breaks become spaces, as for every
      text the toolkit reads (``uni_clean_text``), and the text is NOT cut to a length.

    ``None`` stays ``None``."""
    if value is None:
        return None
    if isinstance(value, bool):
        text = str(value)
    elif isinstance(value, float):
        if not math.isfinite(value):
            return ""
        text = str(int(value)) if value == math.floor(value) else repr(value)
    elif isinstance(value, int):
        text = str(value)
    else:
        text = str(value)
    return uni_clean_text(text)


# The raw column of each source tool that holds the rule id and the dataset reference.
_ATLAS_RULE_COLUMN = {UNI_TOOL_GEOMETRY: "CHECK", UNI_TOOL_DOMAIN: "ISSUE",
                      UNI_TOOL_NETWORK: "RULE", UNI_TOOL_UNIFIED: "RULE_ID"}
_ATLAS_SOURCE_COLUMN = {UNI_TOOL_DOMAIN: "SRC_TABLE", UNI_TOOL_NETWORK: "LAYER",
                        UNI_TOOL_UNIFIED: "SOURCE"}


def atlas_restore_ids(issues, rows, tool):
    """Give the issues of one table their RULE_ID and SOURCE through ``atlas_id_text``.

    The shared adapters print a float with 6 significant digits (``1234567.0`` ->
    ``"1.23457e+06"``, so two rules merge and ``101.0`` -> ``"101"`` never meets a threshold
    row read another way) and cut text to 254 characters (a deep full path in SRC_TABLE then
    matches no checked dataset). ``issues`` and ``rows`` are parallel (one issue per row, as the
    adapters make them); a row whose cell is empty keeps what the adapter gave (``UNKNOWN`` or
    the checked dataset's name). Returns the number of values changed."""
    rule_column = _ATLAS_RULE_COLUMN.get(tool)
    source_column = _ATLAS_SOURCE_COLUMN.get(tool)
    changed = 0
    for issue, row in zip(issues, rows):
        upper = dict((str(k).upper(), v) for k, v in row.items() if not str(k).startswith("_"))
        if rule_column:
            text = atlas_id_text(upper.get(rule_column))
            if text and text != issue.get("RULE_ID"):
                issue["RULE_ID"] = text
                changed += 1
        if source_column:
            raw = upper.get(source_column)
            if raw not in (None, ""):
                text = atlas_id_text(raw)
                if text != issue.get("SOURCE"):
                    issue["SOURCE"] = text
                    changed += 1
    return changed


def atlas_rule_key(text):
    """The comparison key of a rule id: two ids are one rule when they differ only by the case
    of single letters (``Dangle`` and ``DANGLE``; also ``ς``, ``σ`` and ``Σ``, ``µ`` and
    ``Μ``). Each character goes through upper, lower and upper case again, a step being taken
    only when it gives ONE character, so a mapping to several characters (``ß`` -> ``SS``)
    never merges two ids: ``straße`` and ``STRASSE`` stay two rules, as do ``İ`` and ``I``. For
    every character of Unicode this gives the same classes as joining each character with its
    one-character upper and lower case (checked in the tests). A number is first written as
    ``atlas_id_text`` writes it, so ``101``, ``101.0`` and ``"101"`` are one rule."""
    return "".join(_atlas_char_key(c) for c in (atlas_id_text(text) or ""))


def _atlas_one_char(char, mapping):
    other = mapping(char)
    return other if len(other) == 1 else char


def _atlas_char_key(char):
    return _atlas_one_char(_atlas_one_char(_atlas_one_char(char, str.upper), str.lower),
                           str.upper)


def atlas_source_key(text):
    """A comparison key for a dataset reference (SOURCE, SRC_TABLE, a typed checked dataset or a
    catalog path): surrounding blanks and quotes removed, ``\\`` and ``/`` made one, repeated
    separators and ``.`` segments collapsed, no trailing separator, case folded. Two spellings of
    one path (``C:\\Data\\A.gdb\\roads`` and ``c:/data/a.gdb/roads/``) get one key; a bare
    name stays a bare name. ``None`` or blank text gives ``""``."""
    if text is None:
        return ""
    value = str(text).strip().strip("\"'").strip()
    if not value:
        return ""
    value = value.replace("\\", "/")
    if "/" in value:
        # normpath keeps a leading "//" (a UNC share) and collapses "a//b", "a/./b", "a/b/../c"
        value = posixpath.normpath(value)
        if len(value) > 1:
            value = value.rstrip("/") or "/"
    return value.casefold()


def atlas_match_sources(issues, checked):
    """Give each issue whose SOURCE names a checked dataset that dataset's name.

    ``checked``: ``[(canonical name, [reference texts]), ...]``, the texts being the dataset
    name, what the user typed (a layer name or a path) and the catalog path. A SOURCE matches
    when its ``atlas_source_key`` equals the key of one of the texts, so case, slash style,
    doubled or trailing separators and a full path instead of a name do not matter. A key that
    belongs to more than one checked dataset matches neither; those keys are returned (sorted)
    so the caller can warn. Issues are changed in place."""
    candidates = {}
    for canonical, texts in checked:
        for text in texts:
            key = atlas_source_key(text)
            if key:
                candidates.setdefault(key, set()).add(canonical)
    aliases = dict((k, next(iter(v))) for k, v in candidates.items() if len(v) == 1)
    for issue in issues:
        key = atlas_source_key(issue.get("SOURCE"))
        if key in aliases:
            issue["SOURCE"] = aliases[key]
    return sorted(k for k, v in candidates.items() if len(v) > 1)


def _atlas_number(value, label, rule):
    if value is None or (isinstance(value, str) and not value.strip()):
        return None
    try:
        number = float(value)
    except (TypeError, ValueError):
        raise ToolError("Threshold table: {0} of rule '{1}' is not a number ({2!r}).".format(
            label, rule, value), "Use a number, or leave the cell empty.")
    if math.isnan(number) or number < 0:
        raise ToolError("Threshold table: {0} of rule '{1}' must be zero or more.".format(
            label, rule), "Use a number of 0 or more, or leave the cell empty.")
    return number


def parse_thresholds(rows):
    """Threshold rows -> ``{RULE_ID upper case: {"rule", "severity", "max_count", "max_rate"}}``.

    ``rows`` are dicts with the keys ``RULE_ID``, ``SEVERITY``, ``MAX_COUNT``, ``MAX_RATE``
    (any may be ``None``). Rows without a rule id are ignored; a rule listed twice or an
    unknown severity is an error (a limit that cannot be applied must not be dropped).
    """
    out = {}
    for row in rows:
        rule = atlas_id_text(row.get("RULE_ID")) or ""
        if not rule:
            continue
        key = atlas_rule_key(rule)
        if key in out:
            raise ToolError("Threshold table: rule '{0}' is listed more than once.".format(rule),
                            "Keep one row per rule.")
        severity = row.get("SEVERITY")
        if severity is not None and str(severity).strip():
            severity, recognised = uni_normalise_severity(severity, None)
            if not recognised:
                raise ToolError("Threshold table: severity '{0}' of rule '{1}' is not one of "
                                "ERROR, WARNING, INFO.".format(row.get("SEVERITY"), rule),
                                "Use ERROR, WARNING or INFO, or leave the cell empty.")
        else:
            severity = None
        max_rate = _atlas_number(row.get("MAX_RATE"), "MAX_RATE", rule)
        if max_rate is not None and max_rate > 100.0:
            raise ToolError("Threshold table: MAX_RATE of rule '{0}' is {1}, but it is a "
                            "percentage of the checked features (0 to 100).".format(
                                rule, atlas_format_typed(max_rate)),
                            "Use a number from 0 to 100, or leave the cell empty.")
        out[key] = {"rule": rule, "severity": severity,
                    "max_count": _atlas_number(row.get("MAX_COUNT"), "MAX_COUNT", rule),
                    "max_rate": max_rate}
    return out


def merge_severity_overrides(thresholds, rows):
    """Add severity overrides typed in the tool dialog (``rows``: ``[rule, severity]``) to
    ``thresholds``. An override wins over the threshold table's SEVERITY of the same rule.
    Raises ``ToolError`` for an unknown severity or a rule listed twice."""
    seen = set()
    for row in rows:
        rule = (atlas_id_text(row[0]) or "") if row else ""
        if not rule:
            continue
        key = atlas_rule_key(rule)
        if key in seen:
            raise ToolError("Severity overrides: rule '{0}' is listed more than once.".format(rule),
                            "Keep one row per rule.")
        seen.add(key)
        severity, recognised = uni_normalise_severity(row[1] if len(row) > 1 else None, None)
        if not recognised:
            raise ToolError("Severity overrides: severity '{0}' of rule '{1}' is not one of ERROR, "
                            "WARNING, INFO.".format(row[1] if len(row) > 1 else None, rule),
                            "Use ERROR, WARNING or INFO.")
        entry = thresholds.setdefault(key, {"rule": rule, "severity": None, "max_count": None,
                                            "max_rate": None})
        entry["severity"] = severity
        entry["override"] = True
    return thresholds


def apply_thresholds(issues, thresholds):
    """Set the severity of issues whose rule has a SEVERITY in the threshold table or in the
    overrides, and remember where each severity came from (``_sev_from``: ``default`` for the
    toolkit default, ``threshold``, ``override``). Returns the number of issues changed."""
    changed = 0
    for issue in issues:
        entry = thresholds.get(atlas_rule_key(issue["RULE_ID"]))
        if entry and entry["severity"]:
            issue["_sev_from"] = "override" if entry.get("override") else "threshold"
            if entry["severity"] != issue["SEVERITY"]:
                issue["SEVERITY"] = entry["severity"]
                changed += 1
    return changed


def canonical_rule_ids(issues):
    """Give issues whose rule ids differ only by case the spelling of the first one, so the
    cards, the map and the chart count the same rules. Returns the number changed."""
    first, changed = {}, 0
    for issue in issues:
        text = atlas_id_text(issue["RULE_ID"]) or ""
        name = first.setdefault(atlas_rule_key(text), text)
        if name != text:
            changed += 1
        if issue["RULE_ID"] != name or not isinstance(issue["RULE_ID"], str):
            issue["RULE_ID"] = name
    return changed


def _atlas_percent(part, whole):
    return 100.0 * part / whole if whole else None


def format_percent(value):
    """``93.1`` -> ``"93.1"`` (one decimal; ``100`` stays ``"100"`` only when exact)."""
    if value is None:
        return "-"
    text = "{0:.1f}".format(value)
    if text == "100.0" and value < 100.0:
        text = "99.9"   # never round a failure up to a perfect score
    return text[:-2] if text.endswith(".0") else text


def atlas_format_typed(value):
    """A limit the user typed, as typed: ``99.99`` -> ``"99.99"``, ``0.95`` -> ``"0.95"``,
    ``98.0`` -> ``"98"`` (up to 10 decimals; never rounded to one decimal)."""
    if value is None:
        return "-"
    text = "{0:.10f}".format(float(value)).rstrip("0").rstrip(".")
    return text if text not in ("", "-0") else "0"


def _atlas_relation_holds(shown, limit, relation):
    if relation == "<":
        return shown < limit
    if relation == ">":
        return shown > limit
    return shown == limit


def atlas_format_compared(value, limit):
    """``value`` (a percentage) printed so that it reads correctly next to ``limit``.

    It gets at least as many decimals as the limit as typed (one at least), cut, never rounded
    up, and more until the printed value stands to the limit as the true value does (below,
    equal or above): 2 failing in 10,000 against 99.99 reads ``"99.98"``, not ``"99.9"`` (the
    old badge said "99.9 % (required 99.9 %)") and never ``"100"``. With a whole or
    one-decimal limit the usual one-decimal ``format_percent`` text is kept when it is true."""
    from decimal import Decimal, ROUND_FLOOR
    text = format_percent(value)
    if value is None or limit is None:
        return text
    typed = atlas_format_typed(limit)
    exact_limit = Decimal(typed)
    exact_value = Decimal(repr(float(value)))
    relation = "<" if exact_value < exact_limit else (">" if exact_value > exact_limit else "=")
    least = max(1, len(typed.split(".")[1]) if "." in typed else 0)
    if least == 1 and _atlas_relation_holds(Decimal(text), exact_limit, relation):
        return text
    for digits in range(least, 13):
        shown = exact_value.quantize(Decimal(1).scaleb(-digits), rounding=ROUND_FLOOR)
        if _atlas_relation_holds(shown, exact_limit, relation):
            out = "{0:f}".format(shown)
            out = out.rstrip("0").rstrip(".") if "." in out else out
            return out
    return repr(float(value))


def atlas_escalate_unknown_severities(issues, raw_values):
    """Issues of a unified table whose SEVERITY is a word that is not ERROR, WARNING or INFO
    (for example ``FATAL``, ``High``, ``Blocker``) are counted as ERROR, so an unknown word can
    never turn a verdict green. ``raw_values`` is the table's SEVERITY cell of each issue, in
    the same order. An empty cell keeps the previous rule (WARNING, reported). Returns
    ``{word as written: count}`` of the escalated issues."""
    words = {}
    for issue, raw in zip(issues, raw_values):
        if not issue.get("_severity_guess"):
            continue
        text = str(raw).strip() if raw is not None else ""
        if not text:
            continue
        issue["SEVERITY"] = UNI_ERROR
        issue["_sev_from"] = "unknown"
        issue["_severity_guess"] = False
        words[text] = words.get(text, 0) + 1
    return words


def atlas_fractional_oids(values):
    """``(count, first example)`` of object-id cells that hold a number with a fraction (for
    example ``12.7``); the unified reader cuts such an id to its whole part."""
    count, example = 0, None
    for value in values:
        try:
            if value is None or (isinstance(value, str) and not value.strip()):
                continue
            number = float(value)
        except (TypeError, ValueError):
            continue
        if math.isfinite(number) and number != math.floor(number):
            count += 1
            if example is None:
                example = value
    return count, example


def atlas_is_dbase_table(catalog_path, workspace_is_folder):
    """True for a table stored as dBASE: a ``.dbf`` table or a shapefile (``.shp``, whose
    attributes are a ``.dbf``) in a folder workspace. A CSV or text file is not one."""
    return bool(workspace_is_folder) and str(catalog_path or "").rstrip("\\/").casefold() \
        .endswith((".dbf", ".shp"))


def atlas_dbase_empty_values(issues, rows, xy_columns):
    """Undo what a dBASE table did to empty numbers: it cannot store them, so ArcGIS writes 0
    (the toolkit's own folder output says so). ``issues`` and ``rows`` are parallel (one issue
    per row, as the readers make them); ``xy_columns`` is true when the table has X and Y
    columns (a unified table), whose values the issues' X and Y then came from.

    * ``SRC_OID`` 0 becomes "no object id". A geodatabase, GeoPackage or memory ObjectID is
      never 0. A shapefile FID 0 cannot be told apart from an empty cell, so it is read the same
      way: an ERROR without an id counts as one failing feature of its own, which can only make
      the pass rate lower and a rule share higher, never the other way round, so a FAIL can
      never turn into a PASS by a round trip through a folder table.
    * ``X`` = 0 and ``Y`` = 0 together (from the columns) become "no location", or the point
      of the row's geometry (``_xy``) when it has one.

    Returns ``(ids, places)``: the number of object ids and of locations that were emptied."""
    ids = places = 0
    for issue, row in zip(issues, rows):
        if issue.get("SRC_OID") == 0:
            issue["SRC_OID"] = None
            ids += 1
        if xy_columns and issue.get("X") == 0 and issue.get("Y") == 0:
            point = row.get("_xy")
            if point is not None:
                issue["X"], issue["Y"] = float(point[0]), float(point[1])
            else:
                issue["X"] = issue["Y"] = None
            places += 1
    return ids, places


ATLAS_XY_TOLERANCE_METRES = 1.0     # X/Y columns this close to the row's geometry agree with it
ATLAS_XY_TOLERANCE_DEGREES = 1e-5    # the same in degrees (about 1 m)


def atlas_xy_tolerance(geographic, metres_per_unit):
    """Distance, in map units, within which X/Y columns agree with the row's geometry."""
    if geographic:
        return ATLAS_XY_TOLERANCE_DEGREES
    try:
        mpu = float(metres_per_unit)
    except (TypeError, ValueError):
        mpu = 0.0
    return ATLAS_XY_TOLERANCE_METRES / mpu if mpu > 0 else ATLAS_XY_TOLERANCE_METRES


def atlas_prefer_geometry(issues, rows, kind, projected, tolerance):
    """Make the row's geometry win over stale or foreign X/Y columns.

    ``issues`` and ``rows`` are parallel (one issue per row, as the unified reader makes them).
    Each row may hold ``_xy`` (a point standing for its geometry, already in the run's
    coordinate system) and ``_bbox`` (``(xmin, ymin, xmax, ymax)`` of that geometry). An issue
    whose X/Y came from the X and Y columns and differ from the geometry gets the geometry's
    point when:

    * the geometry was projected while it was read (``projected``): the columns are in the
      table's own coordinate system, which is not the run's; or
    * the columns lie farther than ``tolerance`` from the geometry (a point) or outside its
      box widened by ``tolerance`` (a line or polygon): for example X/Y columns left in degrees
      after the feature class was projected.

    Columns inside a line's or polygon's box are kept: they name the exact place on the
    feature, which a middle point would lose. Issues of rows without geometry keep their
    columns and are marked ``_xy_columns``. Returns ``(projected_count, disagree_count)``.
    """
    projected_count = disagree = 0
    for issue, row in zip(issues, rows):
        x, y = issue.get("X"), issue.get("Y")
        point = row.get("_xy")
        if point is None:
            if x is not None and y is not None:
                issue["_xy_columns"] = True
            continue
        gx, gy = float(point[0]), float(point[1])
        if x is None or y is None or (x == gx and y == gy):
            continue
        if projected:
            issue["X"], issue["Y"] = gx, gy
            projected_count += 1
            continue
        box = row.get("_bbox")
        if kind in (GEOM_POLYLINE, GEOM_POLYGON) and box is not None:
            inside = (box[0] - tolerance <= x <= box[2] + tolerance
                      and box[1] - tolerance <= y <= box[3] + tolerance)
        else:
            inside = math.hypot(x - gx, y - gy) <= tolerance
        if inside:
            if kind not in (GEOM_POLYLINE, GEOM_POLYGON):
                issue["X"], issue["Y"] = gx, gy
            continue
        issue["X"], issue["Y"] = gx, gy
        disagree += 1
    return projected_count, disagree


def atlas_columns_look_like_degrees(issues):
    """True when every issue located from X/Y columns of a table without geometry has
    -180 <= X <= 180 and -90 <= Y <= 90 (and there is at least one with a value off 0, 0)."""
    seen = False
    for issue in issues:
        if not issue.get("_xy_columns"):
            continue
        x, y = issue.get("X"), issue.get("Y")
        if x is None or y is None:
            continue
        if not (-180.0 <= x <= 180.0 and -90.0 <= y <= 90.0):
            return False
        if x != 0 or y != 0:
            seen = True
    return seen


def atlas_limit_text(entry):
    """The limits of a threshold entry in words: ``"at most 50 % of checked features"``."""
    parts = []
    if entry.get("max_count") is not None:
        parts.append("at most {0} issues".format(atlas_format_typed(entry["max_count"])))
    if entry.get("max_rate") is not None:
        parts.append("at most {0} % of checked features".format(atlas_format_typed(entry["max_rate"])))
    return " and ".join(parts)


def _atlas_feature_hits(group, totals, known, worst_case=False):
    """The checked features hit by the issues of ``group``.

    Returns ``(count, no_id, foreign, clamped, outside)``: ``count`` is the number of distinct
    failing checked features (an issue without an object id counts as one feature of its own, a
    worst case), never more than the checked features of its dataset; ``no_id`` the issues
    without an object id; ``foreign`` the issues whose object id is not in the checked dataset
    (``known`` maps a dataset name, any case, to its set of object ids; ``None`` or a missing
    name: not checked); ``outside`` the issues whose SOURCE is not a checked dataset;
    ``clamped`` is true when the count had to be cut to the number of checked features.

    With ``worst_case`` every issue that is not on a checked feature (``foreign`` and
    ``outside``) also counts as one failing feature of its own, and the count is cut to the
    total of checked features. A rule limit uses this count, so an issue that cannot be matched
    to a checked feature can never lower the share a limit is compared with.
    """
    matched, no_id, foreign, outside = {}, {}, 0, 0
    for issue in group:
        src = str(issue.get("SOURCE") or "").casefold()
        if src not in totals:
            outside += 1
            continue
        oid = issue.get("SRC_OID")
        if oid is None:
            no_id[src] = no_id.get(src, 0) + 1
        elif known is not None and src in known and oid not in known[src]:
            foreign += 1
        else:
            matched.setdefault(src, set()).add(oid)
    count, clamped = 0, False
    for src in set(matched) | set(no_id):
        n = len(matched.get(src, ())) + no_id.get(src, 0)
        if n > totals[src]:
            n, clamped = totals[src], True
        count += n
    if worst_case:
        count += foreign + outside
        whole = sum(totals.values())
        if count > whole:
            count, clamped = whole, True
    return count, sum(no_id.values()), foreign, clamped, outside


def build_scorecard(issues, thresholds=None, totals=None, min_pass_rate=None, known_oids=None):
    """Counts, rule cards, pass rate and verdict.

    ``issues``: unified issues (dicts with TOOL, RULE_ID, SOURCE, SRC_OID, SEVERITY, X, Y, ...).
    ``thresholds``: result of ``parse_thresholds``. ``totals``: ``{source name (any case):
    feature count}`` of the checked datasets, or ``None``. ``known_oids``: ``{source name (any
    case): set of object ids}`` of the checked datasets (issues with another id are left out
    of the pass rate and reported), or ``None``. ``min_pass_rate``: percent (0-100) or ``None``.
    Raises ``ToolError`` when a limit needs the checked feature count and there is none.
    """
    thresholds = thresholds or {}
    canonical_rule_ids(issues)
    named = [str(k) for k in (totals or {})]
    totals = dict((str(k).casefold(), int(v)) for k, v in (totals or {}).items())
    known = None if known_oids is None else dict(
        (str(k).casefold(), v) for k, v in known_oids.items())
    checked_total = sum(totals.values()) if totals else None
    needs_total = [e["rule"] for e in thresholds.values() if e["max_rate"] is not None]
    if min_pass_rate is not None or needs_total:
        if not checked_total:
            what = "A minimum pass rate" if min_pass_rate is not None else \
                "MAX_RATE (rule {0})".format(needs_total[0])
            if named:
                raise ToolError(
                    "{0} needs the number of checked features, but the checked dataset(s) {1} "
                    "have 0 features (an empty selection, a definition query that matches "
                    "nothing, or an empty dataset?).".format(what, ", ".join(sorted(named))),
                    "Clear the selection or the definition query, name the dataset that was "
                    "checked, or remove the rate limit.")
            raise ToolError(
                "{0} needs the number of checked features, and none is known.".format(what),
                "Name the dataset each issue table was made from in the 'Checked dataset' "
                "column of the issue tables, or remove the rate limit.")

    by_rule = {}
    for issue in issues:
        by_rule.setdefault(atlas_rule_key(issue["RULE_ID"]), []).append(issue)

    fail_count, no_id_errors, foreign_errors, rate_clamped, outside_errors = _atlas_feature_hits(
        [i for i in issues if i["SEVERITY"] == UNI_ERROR], totals, known)
    errors = sum(1 for i in issues if i["SEVERITY"] == UNI_ERROR)
    warnings = sum(1 for i in issues if i["SEVERITY"] == UNI_WARNING)
    infos = sum(1 for i in issues if i["SEVERITY"] == UNI_INFO)

    rules, reasons, rule_unmatched, limit_warnings = [], [], [], []
    keys = list(by_rule)
    for key in thresholds:
        if key not in by_rule:
            keys.append(key)
    for key in keys:
        group = by_rule.get(key, [])
        entry = thresholds.get(key)
        counts = dict((s, 0) for s in UNI_SEVERITIES)
        for issue in group:
            counts[issue["SEVERITY"]] += 1
        if group:
            severity = min((i["SEVERITY"] for i in group), key=lambda s: ATLAS_SEVERITY_RANK[s])
            name = group[0]["RULE_ID"]
        else:
            severity = (entry or {}).get("severity") or UNI_WARNING
            name = entry["rule"]
        # Worst case for a rule: an issue on an id that is not in the checked dataset, or on a
        # dataset that is not checked, counts as one failing feature of its own, so MAX_RATE
        # can never accept errors only because they could not be matched.
        hits = _atlas_feature_hits(group, totals, known, worst_case=True)
        hit, unmatched_here = hits[0], hits[2] + hits[4]
        rule_rate = _atlas_percent(hit, checked_total) if checked_total else None
        located = sum(1 for i in group if i.get("X") is not None and i.get("Y") is not None)
        record = {"rule": name, "count": len(group), "errors": counts[UNI_ERROR],
                  "warnings": counts[UNI_WARNING], "infos": counts[UNI_INFO],
                  "severity": severity,
                  "tools": sorted(set(i["TOOL"] for i in group if i.get("TOOL"))),
                  "sources": sorted(set(str(i["SOURCE"]) for i in group if i.get("SOURCE"))),
                  "located": located, "unlocated": len(group) - located,
                  "features": len(set((str(i.get("SOURCE")), i.get("SRC_OID")) for i in group
                                      if i.get("SRC_OID") is not None)),
                  "rate": rule_rate, "rate_unmatched": unmatched_here if checked_total else 0,
                  "max_count": None, "max_rate": None,
                  "status": "OK", "reason": "", "accepted": False, "limit_text": "",
                  "sev_from": sorted(set(i.get("_sev_from") or "source" for i in group)),
                  "oids": sorted(set(i["SRC_OID"] for i in group if i.get("SRC_OID") is not None))[:10]}
        limited = entry is not None and (entry["max_count"] is not None
                                         or entry["max_rate"] is not None)
        if limited:
            record["max_count"], record["max_rate"] = entry["max_count"], entry["max_rate"]
            if entry["max_rate"] is not None and record["rate_unmatched"]:
                rule_unmatched.append((name, record["rate_unmatched"]))
        if severity == UNI_INFO and counts[UNI_ERROR] == 0 and counts[UNI_WARNING] == 0:
            record["status"] = "INFO"
            record["reason"] = "Informational; no limit applied." if limited else ""
            if limited and group:
                # an INFO issue never fails a delivery, so its limit is not applied: say so,
                # since a limit was typed for it
                limit_warnings.append(
                    "Rule {0}: all {1} issue(s) are INFO, so its limit ({2}) is not applied "
                    "(an INFO issue never fails a delivery). Give the rule the severity WARNING "
                    "or ERROR (Severity Overrides or the SEVERITY column) to apply it.".format(
                        name, len(group), atlas_limit_text(entry)))
        elif limited:
            why = []
            if entry["max_count"] is not None and len(group) > entry["max_count"]:
                why.append("{0} issues, limit {1}".format(len(group), atlas_format_typed(
                    entry["max_count"])))
            if entry["max_rate"] is not None and rule_rate is not None \
                    and rule_rate > entry["max_rate"]:
                why.append("{0} % of checked features, limit {1} %".format(
                    atlas_format_compared(rule_rate, entry["max_rate"]),
                    atlas_format_typed(entry["max_rate"])))
            if why:
                record["status"] = "FAIL"
                record["reason"] = "; ".join(why)
            else:
                record["reason"] = "Within the limit."
                record["accepted"] = counts[UNI_ERROR] > 0
                record["limit_text"] = atlas_limit_text(entry)
        elif counts[UNI_ERROR] > 0:
            record["status"] = "FAIL"
            record["reason"] = "{0} error{1}; no limit given, so any error fails.".format(
                counts[UNI_ERROR], "" if counts[UNI_ERROR] == 1 else "s")
        if record["status"] == "FAIL":
            reasons.append("{0}: {1}".format(name, record["reason"]))
        rules.append(record)
    rules.sort(key=lambda r: (-r["count"], ATLAS_SEVERITY_RANK[r["severity"]], r["rule"].casefold(),
                              r["rule"]))

    rate = None
    rate_note = ""
    rate_warnings = []
    if checked_total:
        rate = max(0.0, min(100.0, _atlas_percent(checked_total - fail_count, checked_total)))
        if no_id_errors:
            rate_warnings.append(
                "{0} error issue(s) have no object id; each is counted as one failing feature, so "
                "the pass rate is a lower bound.".format(no_id_errors))
        if foreign_errors:
            rate_warnings.append(
                "{0} error issue(s) have an object id that is not in the checked dataset (is it "
                "the right dataset?); they are left out of the pass rate. Their rule still "
                "judges them: without a limit any error fails, MAX_COUNT counts them and "
                "MAX_RATE counts each as one failing feature.".format(foreign_errors))
        if rate_clamped:
            rate_warnings.append(
                "More error issues than checked features: the failing count was limited to the "
                "number of checked features, so the pass rate is a lower bound.")
        if outside_errors:
            names = sorted(set(str(i.get("SOURCE") or "(empty)") for i in issues
                               if i["SEVERITY"] == UNI_ERROR
                               and str(i.get("SOURCE") or "").casefold() not in totals),
                           key=lambda t: (t.casefold(), t))
            rate_warnings.append(
                "{0} error issue(s) name a source that is not a checked dataset ({1}{2}); they "
                "are left out of the pass rate. Their rule still judges them: without a limit "
                "any error fails, MAX_COUNT counts them and MAX_RATE counts each as one failing "
                "feature. If that source was checked, name it as a Checked dataset of the issue "
                "table that holds these issues: in that table's row when its Checked dataset "
                "cell is empty, else in one more row with the same issue table (one row per "
                "checked dataset).".format(outside_errors, ", ".join(names[:5]),
                                 ", ..." if len(names) > 5 else ""))
        for rule_name, n in rule_unmatched:
            rate_warnings.append(
                "Rule {0}: {1} issue(s) are not on a checked feature; MAX_RATE counts each as "
                "one failing feature (worst case).".format(rule_name, n))
        if rate_warnings:
            rate_note = (rate_note + " " + " ".join(rate_warnings)).strip()
    else:
        rate_note = ("No checked dataset was named, so no pass rate is computed. The verdict uses "
                     "the rule limits (default: any ERROR fails).")
    if min_pass_rate is not None and rate is not None and rate < min_pass_rate:
        reasons.append("Pass rate {0} % is below the required {1} %.".format(
            atlas_format_compared(rate, min_pass_rate), atlas_format_typed(min_pass_rate)))
    verdict = "FAIL" if reasons else "PASS"
    accepted = [r for r in rules if r["accepted"]]
    return {"verdict": verdict, "accepted": [{"rule": r["rule"], "errors": r["errors"],
                                              "limit": r["limit_text"]} for r in accepted],
            "accepted_errors": sum(r["errors"] for r in accepted),
            "unmatched": sorted(e["rule"] for k, e in thresholds.items() if k not in by_rule), "rate": rate, "min_pass_rate": min_pass_rate,
            "checked_total": checked_total, "failing_features": fail_count,
            "no_id_errors": no_id_errors, "foreign_errors": foreign_errors,
            "outside_errors": outside_errors if checked_total else 0,
            "rate_clamped": rate_clamped, "rate_warnings": rate_warnings,
            "errors": errors, "warnings": warnings, "infos": infos, "total": len(issues),
            "sev_from": dict((k, sum(1 for i in issues if (i.get("_sev_from") or "source") == k))
                             for k in sorted(set((i.get("_sev_from") or "source") for i in issues))),
            "rules": rules, "reasons": reasons, "rate_note": rate_note,
            "limit_warnings": limit_warnings}


# --------------------------------------------------------------------------
# One point per feature
# --------------------------------------------------------------------------

def representative_point(kind, geom):
    """A point that stands for a feature: the point itself, the first point of a multipoint,
    the middle (by length) of the longest line part, or the pole of inaccessibility of the
    largest polygon part. ``None`` for an empty geometry."""
    if geom is None:
        return None
    if kind == GEOM_POINT:
        return (geom[0], geom[1])
    if kind == GEOM_MULTIPOINT:
        return (geom[0][0], geom[0][1]) if geom else None
    if kind == GEOM_POLYLINE:
        parts = [p for p in geom if p]
        if not parts:
            return None
        longest = max(parts, key=path_length)
        return path_midpoint(longest) if len(longest) > 1 else (longest[0][0], longest[0][1])
    if kind == GEOM_POLYGON:
        box = geometry_bbox(kind, geom)
        if box is None:
            return None
        side = max(box[2] - box[0], box[3] - box[1])
        found = polygon_anchor(geom, precision=side * 1e-3 if side > 0 else 1.0)
        if found is None:
            return ((box[0] + box[2]) / 2.0, (box[1] + box[3]) / 2.0)
        return found["point"]
    return None


# --------------------------------------------------------------------------
# Units
# --------------------------------------------------------------------------

def parse_linear_unit(text):
    """``"500 Meters"`` -> ``(500.0, "meters")``; ``"500"`` -> ``(500.0, None)``.
    Raises ``ToolError`` for text that is not a number with an optional unit."""
    raw = str(text).strip() if text is not None else ""
    if not raw:
        return None, None
    pieces = raw.split(None, 1)
    number_text = pieces[0].replace(",", ".") if pieces[0].count(",") == 1 and "." not in pieces[0] \
        else pieces[0]
    try:
        number = float(number_text)
    except ValueError:
        raise ToolError("The hexagon size '{0}' is not a number with a unit.".format(raw),
                        "Type a size such as '500 Meters', or leave it empty.")
    if math.isnan(number) or math.isinf(number) or number <= 0:
        raise ToolError("The hexagon size must be larger than zero.",
                        "Type a size such as '500 Meters', or leave it empty.")
    unit = pieces[1].strip().casefold() if len(pieces) > 1 else None
    if unit in ("", "unknown"):
        unit = None
    return number, unit


def hex_size_in_map_units(text, geographic, metres_per_unit):
    """Map-unit size for a hexagon-size text, or ``None`` for an empty text.

    A unit is converted with ``metres_per_unit`` (metres of one map unit); the keywords are
    those of ``ATLAS_UNIT_METRES``. In a geographic system a length cannot be converted, which
    is an error (the default size is used when the field is empty), while ``DecimalDegrees``
    is taken as it is; in a projected system degrees are an error. A bare number is taken in
    map units.
    """
    number, unit = parse_linear_unit(text)
    if number is None:
        return None
    if unit is None:
        return number
    if unit in ATLAS_DEGREE_UNITS:
        if geographic:
            return number
        raise ToolError("A hexagon size in degrees cannot be used: the issue coordinates are "
                        "projected.", "Give the size in a length unit such as Meters, or leave "
                        "it empty.")
    if unit not in ATLAS_UNIT_METRES:
        raise ToolError("The hexagon size unit '{0}' is not supported.".format(unit),
                        "Use a linear unit of the dialog (Meters, Kilometers, Decimeters, "
                        "Centimeters, Millimeters, Feet, FeetInt, Yards, YardsInt, Miles, "
                        "MilesInt, Inches, InchesInt, NauticalMiles, NauticalMilesInt, Points), "
                        "or leave the size empty.")
    if geographic or not metres_per_unit:
        raise ToolError("A hexagon size in {0} cannot be used: the issue coordinates are in "
                        "degrees or in an unknown unit.".format(unit),
                        "Leave the size empty (it is then taken from the extent).")
    return number * ATLAS_UNIT_METRES[unit] / float(metres_per_unit)


# --------------------------------------------------------------------------
# World -> SVG pixels
# --------------------------------------------------------------------------

def merge_extents(extents):
    """Union of ``(minx, miny, maxx, maxy)`` boxes (``None`` entries ignored)."""
    boxes = [e for e in extents if e is not None]
    if not boxes:
        return None
    return (min(b[0] for b in boxes), min(b[1] for b in boxes),
            max(b[2] for b in boxes), max(b[3] for b in boxes))


def make_transform(extent, x_scale=1.0, width=ATLAS_SVG_WIDTH):
    """Transform for an extent ``(minx, miny, maxx, maxy)``.

    ``x_scale`` multiplies x before drawing (cos latitude for degrees, else 1) so a
    geographic map is not stretched. The scale is uniform, Y is flipped, the margin is
    ``ATLAS_MARGIN_FRACTION`` of the width, and the content is centred. A zero-size extent is
    padded so a single point still gets a map. Returns a dict with ``W``, ``H``, ``scale``,
    ``x0``, ``y0`` (pixels of the extent's lower-left corner), ``frame`` (the pixel rectangle
    of the extent) and the extent used.
    """
    minx, miny, maxx, maxy = [float(v) for v in extent]
    dx, dy = (maxx - minx) * x_scale, maxy - miny
    if dx <= 0 and dy <= 0:
        pad = 0.5
        minx, maxx, miny, maxy = minx - pad, maxx + pad, miny - pad, maxy + pad
        dx, dy = (maxx - minx) * x_scale, maxy - miny
    elif dx <= 0:
        grow = dy / 2.0 / x_scale
        minx, maxx = minx - grow, maxx + grow
        dx = (maxx - minx) * x_scale
    elif dy <= 0:
        grow = dx / 2.0
        miny, maxy = miny - grow, maxy + grow
        dy = maxy - miny
    margin = width * ATLAS_MARGIN_FRACTION
    scale = (width - 2 * margin) / dx
    height = dy * scale + 2 * margin
    if height > ATLAS_MAX_HEIGHT:
        height = ATLAS_MAX_HEIGHT
        scale = (height - 2 * margin) / dy
    height = max(height, ATLAS_MIN_HEIGHT)
    cw, ch = dx * scale, dy * scale
    left, top = (width - cw) / 2.0, (height - ch) / 2.0
    return {"W": width, "H": height, "scale": scale, "x_scale": float(x_scale),
            "minx": minx, "miny": miny, "maxx": maxx, "maxy": maxy,
            "left": left, "top": top, "bottom": top + ch,
            "frame": (left, top, left + cw, top + ch)}


def to_pixel(t, x, y):
    """Pixel position ``(px, py)`` of a world point."""
    return (t["left"] + (x - t["minx"]) * t["x_scale"] * t["scale"],
            t["bottom"] - (y - t["miny"]) * t["scale"])


def from_pixel(t, px, py):
    """World point of a pixel position (inverse of ``to_pixel``)."""
    return (t["minx"] + (px - t["left"]) / (t["x_scale"] * t["scale"]),
            t["miny"] + (t["bottom"] - py) / t["scale"])


def display_x_scale(extent, geographic):
    """cos(latitude of the extent centre) for degrees; 1 otherwise."""
    if not geographic or extent is None:
        return 1.0
    lat = (extent[1] + extent[3]) / 2.0
    return max(math.cos(math.radians(max(-85.0, min(85.0, lat)))), 0.05)


# --------------------------------------------------------------------------
# Vertex budget for the context outline
# --------------------------------------------------------------------------

def _atlas_thin(part, floor):
    """Every second vertex of ``part``, first and last kept; unchanged at ``floor`` vertices."""
    if len(part) <= floor:
        return part
    thin = part[::2]
    if thin[-1] is not part[-1] and thin[-1] != part[-1]:
        thin.append(part[-1])
    if len(thin) < floor:
        return part
    return thin


class AtlasVertexBudget(object):
    """Collects the outline of the context layers within ``max_vertices`` vertices.

    Parts are added as they are read (streaming). Whenever the stored vertices exceed
    twice the budget, every part is thinned to every second vertex (first and last kept, so
    rings stay closed); at the end it is thinned until it fits. A layer whose parts are
    all at their minimum size and still do not fit is reduced to its extent
    (``extent_only``). The true extent of every layer is kept exactly, thinned or not.
    """

    FLOORS = {"polyline": 2, "polygon": 4}

    def __init__(self, max_vertices=ATLAS_MAX_VERTICES_DEFAULT):
        self.max_vertices = max(int(max_vertices), ATLAS_MIN_VERTICES)
        self.layers = []
        self.stored = 0

    def add_layer(self, name, kind):
        """Start a layer (``kind``: point, polyline or polygon); returns its index."""
        self.layers.append({"name": name, "kind": kind, "parts": [], "bbox": None,
                            "vertices_in": 0, "features": 0, "curves_skipped": 0,
                            "extent_only": False})
        return len(self.layers) - 1

    def add_feature(self, index, parts):
        """Add one feature: a list of vertex lists (points: one list of points)."""
        layer = self.layers[index]
        layer["features"] += 1
        for part in parts:
            if not part:
                continue
            xs = [p[0] for p in part]
            ys = [p[1] for p in part]
            box = (min(xs), min(ys), max(xs), max(ys))
            old = layer["bbox"]
            layer["bbox"] = box if old is None else (min(old[0], box[0]), min(old[1], box[1]),
                                                     max(old[2], box[2]), max(old[3], box[3]))
            layer["vertices_in"] += len(part)
            if layer["extent_only"]:
                continue
            layer["parts"].append(list(part))
            self.stored += len(part)
        if self.stored > 2 * self.max_vertices:
            self._thin_all()

    def skip_curved(self, index):
        self.layers[index]["curves_skipped"] += 1

    def _floor(self, layer):
        return 1 if layer["kind"] == "point" else self.FLOORS[layer["kind"]]

    def _thin_all(self):
        """One thinning pass over every stored part; returns True if anything shrank."""
        shrank = False
        for layer in self.layers:
            if layer["extent_only"]:
                continue
            floor = self._floor(layer)
            if layer["kind"] == "point":
                merged = [p for part in layer["parts"] for p in part]
                if len(merged) > 1:
                    thin = merged[::2]
                    self.stored -= len(merged) - len(thin)
                    layer["parts"] = [thin]
                    shrank = True
                else:
                    layer["parts"] = [merged] if merged else []
                continue
            new_parts = []
            for part in layer["parts"]:
                thin = _atlas_thin(part, floor)
                if len(thin) < len(part):
                    self.stored -= len(part) - len(thin)
                    shrank = True
                new_parts.append(thin)
            layer["parts"] = new_parts
        return shrank

    def finish(self):
        """The layers, each within the budget: ``parts``, ``bbox``, ``vertices_in``,
        ``vertices_out``, ``extent_only``, ``thinned``."""
        while self.stored > self.max_vertices:
            if not self._thin_all():
                break
        if self.stored > self.max_vertices:
            # everything is at its minimum size: keep the extent of the largest layers only
            order = sorted(range(len(self.layers)),
                           key=lambda i: -sum(len(p) for p in self.layers[i]["parts"]))
            for i in order:
                if self.stored <= self.max_vertices:
                    break
                layer = self.layers[i]
                self.stored -= sum(len(p) for p in layer["parts"])
                layer["parts"] = []
                layer["extent_only"] = True
        for layer in self.layers:
            layer["vertices_out"] = sum(len(p) for p in layer["parts"])
            layer["thinned"] = (not layer["extent_only"]
                                and layer["vertices_out"] < layer["vertices_in"])
        return self.layers


# --------------------------------------------------------------------------
# Hexagon density
# --------------------------------------------------------------------------

def hex_center(q, r, radius):
    """Centre ``(u, v)`` of the flat-top hexagon (q, r) with circumradius ``radius``."""
    return (1.5 * radius * q, math.sqrt(3.0) * radius * (r + q / 2.0))


def hex_corners(q, r, radius):
    """The six corners ``[(u, v), ...]`` of a flat-top hexagon (first corner points right)."""
    cu, cv = hex_center(q, r, radius)
    return [(cu + radius * math.cos(math.radians(60 * k)),
             cv + radius * math.sin(math.radians(60 * k))) for k in range(6)]


def _atlas_hex_round(fq, fr):
    fx, fz = fq, fr
    fy = -fx - fz
    rx, ry, rz = round(fx), round(fy), round(fz)
    dx, dy, dz = abs(rx - fx), abs(ry - fy), abs(rz - fz)
    if dx > dy and dx > dz:
        rx = -ry - rz
    elif dy > dz:
        ry = -rx - rz
    else:
        rz = -rx - ry
    return int(rx), int(rz)


def hex_cell_of(u, v, radius):
    """Axial cell ``(q, r)`` of the flat-top hexagon grid containing the point (u, v)."""
    fq = (2.0 / 3.0 * u) / radius
    fr = (-1.0 / 3.0 * u + math.sqrt(3.0) / 3.0 * v) / radius
    return _atlas_hex_round(fq, fr)


def hex_bin(points, size, x_scale=1.0, origin=(0.0, 0.0)):
    """Count points per flat-top hexagon.

    ``points``: world ``(x, y)``; ``size``: distance between two parallel sides, in map
    units of y (x is multiplied by ``x_scale`` first); ``origin``: world point at the
    grid origin (use the extent's lower-left corner). Returns ``{(q, r): count}``.
    The circumradius is ``size / sqrt(3)``.
    """
    radius = size / math.sqrt(3.0)
    ox, oy = origin
    cells = {}
    for x, y in points:
        key = hex_cell_of((x - ox) * x_scale, y - oy, radius)
        cells[key] = cells.get(key, 0) + 1
    return cells


def default_hex_size(extent, x_scale=1.0, count=None):
    """Default hexagon size: the longer side of the extent divided by ``ATLAS_HEX_ACROSS``
    (24); with few located issues (``count``) fewer, larger hexagons, down to the longer side
    divided by ``ATLAS_HEX_ACROSS_MIN`` (about three issues per hexagon on average)."""
    if extent is None:
        return 1.0
    across = ATLAS_HEX_ACROSS
    if count is not None:
        across = max(ATLAS_HEX_ACROSS_MIN, min(ATLAS_HEX_ACROSS, int(round(math.sqrt(count / 3.0)))))
    longer = max((extent[2] - extent[0]) * x_scale, extent[3] - extent[1])
    return longer / float(across) if longer > 0 else 1.0


def hex_density(points, extent, x_scale=1.0, size=None, size_extent=None):
    """Hexagon density of ``points`` over ``extent`` (its lower-left corner is the grid origin).

    The default size (no ``size``) is taken from ``size_extent`` when given and not a single
    point (the area that was checked, ``atlas_focus_extent``), else from ``extent``.

    Returns ``{"size", "radius", "cells": {(q, r): n}, "origin", "coarsened", "requested"}``.
    The size grows by 1.5 x until at most ``ATLAS_HEX_MAX_CELLS`` hexagons are occupied
    (``coarsened`` is then True and ``requested`` holds the size asked for).
    """
    base = extent
    if size_extent is not None and max(size_extent[2] - size_extent[0],
                                       size_extent[3] - size_extent[1]) > 0:
        base = size_extent      # a single place has no size of its own: the map's is used
    requested = size if size else default_hex_size(base, x_scale, len(points))
    used = requested
    origin = (extent[0], extent[1]) if extent else (0.0, 0.0)
    cells = hex_bin(points, used, x_scale, origin) if points else {}
    while len(cells) > ATLAS_HEX_MAX_CELLS:
        used *= 1.5
        cells = hex_bin(points, used, x_scale, origin)
    return {"size": used, "radius": used / math.sqrt(3.0), "cells": cells, "origin": origin,
            "coarsened": used != requested, "requested": requested}


def _atlas_median(values):
    """Median of a sorted, non-empty list."""
    n = len(values)
    mid = n // 2
    return float(values[mid]) if n % 2 else (values[mid - 1] + values[mid]) / 2.0


def _atlas_quantile_bounds(values, classes):
    """Up to ``classes`` ``(low, high)`` bounds of the sorted ``values``: one per distinct value
    when there are at most ``classes`` of them, else cut at quantiles."""
    distinct = sorted(set(values))
    if len(distinct) <= classes:
        return [(v, v) for v in distinct]
    highs = []
    n = len(values)
    for k in range(1, classes + 1):
        index = min(n - 1, int(math.ceil(k * n / float(classes))) - 1)
        high = values[index]
        if not highs or high > highs[-1]:
            highs.append(high)
    if highs[-1] < values[-1]:
        highs[-1] = values[-1]
    bounds, low = [], values[0]
    for high in highs:
        bounds.append((low, high))
        nxt = [v for v in distinct if v > high]
        low = nxt[0] if nxt else high
    return bounds


def density_classes(counts, classes=ATLAS_CLASS_COUNT):
    """Class bounds for hexagon counts: ``[(low, high), ...]`` ascending, integers.

    The ramp is anchored on the typical hexagon, so binning noise is not drawn as patches:

    * the first (lightest) class holds every count below ``ATLAS_EVEN_SPREAD`` (1.5) times the
      median count. When that is every hexagon the spread is even and there is ONE class (one
      shade): on an even grid, a hexagon with 9 locations next to ones with 7 or 8 is not darker;
    * the busier hexagons (at least 1.5 x the median) get up to ``classes - 1`` darker classes:
      one per count when there are that few distinct counts, else cut at quantiles of their
      counts (so a few very dense cells do not flatten the others);
    * a darker class is merged into the one before it unless its lowest count is at least
      ``ATLAS_CLASS_STEP`` (1.2) times the lowest count of that class: one more location is not
      a darker shade.

    Each class holds counts from ``low`` to ``high``; there are 1 to ``classes`` classes."""
    values = sorted(counts)
    if not values:
        return []
    limit = ATLAS_EVEN_SPREAD * _atlas_median(values)
    typical = [v for v in values if v < limit]
    busy = [v for v in values if v >= limit]
    if not busy:
        return [(values[0], values[-1])]
    merged = [(typical[0], typical[-1])]
    for low, high in _atlas_quantile_bounds(busy, max(classes - 1, 1)):
        if low < ATLAS_CLASS_STEP * merged[-1][0] and len(merged) > 1:
            merged[-1] = (merged[-1][0], high)
        else:
            merged.append((low, high))
    return merged


def class_index(bounds, count):
    """Index of the class that holds ``count``."""
    for i, (_low, high) in enumerate(bounds):
        if count <= high:
            return i
    return len(bounds) - 1


# --------------------------------------------------------------------------
# Locations: issues at the same point are one place
# --------------------------------------------------------------------------

def location_key(x, y, geographic=False):
    """Key of the place of a point: coordinates rounded to 1 mm (1e-7 degree for degrees)."""
    digits = 7 if geographic else 3
    return (round(float(x), digits), round(float(y), digits))


def issue_locations(issues, geographic=False):
    """Group the located issues by place: ``[{"x", "y", "issues": [...]}]`` in first-seen order.
    Two issues at the same point (for example a DANGLE and a T_MISS on the same line end) are
    one location."""
    places = {}
    for issue in issues:
        x, y = issue.get("X"), issue.get("Y")
        if x is None or y is None:
            continue
        try:
            if not (math.isfinite(x) and math.isfinite(y)):
                continue
            key = location_key(x, y, geographic)
        except (TypeError, ValueError, OverflowError):
            continue
        place = places.get(key)
        if place is None:
            place = places[key] = {"x": float(x), "y": float(y), "issues": []}
        place["issues"].append(issue)
    return list(places.values())


def build_marks(places, rule_order):
    """The things drawn on the map: one mark per place and severity (so a place with a DANGLE
    and a T_MISS is one mark, not two circles on top of each other).

    ``rule_order``: ``{rule id: index}`` of the report's rule list. A mark is
    ``{"x", "y", "severity", "rule", "also", "n", "issues"}``: ``rule`` is the first rule (in
    report order) of the issues it stands for, ``also`` the indices of the other rules there,
    ``n`` the number of issues. Marks are returned with the least severe first, so errors are
    drawn on top."""
    marks = []
    for place in places:
        by_severity = {}
        for issue in place["issues"]:
            by_severity.setdefault(issue["SEVERITY"], []).append(issue)
        for severity, items in by_severity.items():
            ordered = sorted(items, key=lambda i: (rule_order.get(i["RULE_ID"], 10 ** 9),
                                                   str(i["RULE_ID"])))
            first = ordered[0]["RULE_ID"]
            also = sorted(set(rule_order[i["RULE_ID"]] for i in ordered
                              if i["RULE_ID"] != first and i["RULE_ID"] in rule_order))
            marks.append({"x": place["x"], "y": place["y"], "severity": severity, "rule": first,
                          "also": also, "n": len(items), "issues": ordered})
    marks.sort(key=lambda m: -ATLAS_SEVERITY_RANK[m["severity"]])
    return marks


def atlas_focus_extent(checked_extent, points):
    """The area the summary sentence and the default hexagon size are judged over: the extent
    of the checked datasets (their features as read, a layer's selection honoured) joined with
    the extent of the issue locations. Context layers never count (a city outline around one
    checked district must not turn an even spread into a "cluster"). Without a checked dataset
    with geometry it is the extent of the locations; ``None`` without either."""
    boxes = [checked_extent]
    if points:
        xs = [p[0] for p in points]
        ys = [p[1] for p in points]
        boxes.append((min(xs), min(ys), max(xs), max(ys)))
    return merge_extents(boxes)


def busiest_window(points, extent, grid=ATLAS_GRID, window=ATLAS_WINDOW):
    """How unevenly points lie over the map: the share held by the busiest window.

    The extent is cut into ``grid`` x ``grid`` cells; a window is ``window`` x ``window`` cells
    (default 4 of 12: a third of the map's width and height, one ninth of its area) and may sit
    at any cell position. Returns ``None`` for no points, else ``{"count", "total", "share",
    "even", "factor", "direction", "concentrated"}``: the point count of the busiest window,
    its percentage of all points, the percentage an even spread gives (``100 * window**2 /
    grid**2``, 11.1), their ratio, where the window's centre lies (``north-east`` ... ``central``,
    by thirds of the map) and whether the toolkit's rule for the word "cluster" is met: at least
    ``ATLAS_CLUSTER_MIN_LOCATIONS`` points and ``ATLAS_CLUSTER_MIN_SHARE`` percent of them in
    one window. The rule was set from simulated even spreads: the builder's own run of 20,000
    uniform random layouts per size (kept in the builder's notes only; that script is not in the
    repository) found the busiest window at 40 % or more in about 0.3 % of the layouts of 30
    points (largest share 46.7 %), 0.02 % of 40 points, 0.005 % of 50 points and none of 60
    points or more (largest 35 %); the repository test
    (tests/test_core_quality_atlas.py) re-runs 1,500 layouts per size and agrees. It
    is a plain count with a stated threshold, not a significance test, and real data on a
    network is not uniform, so the sentence always gives the numbers.
    """
    if not points or extent is None:
        return None
    minx, miny, maxx, maxy = extent
    width, height = max(maxx - minx, 1e-12), max(maxy - miny, 1e-12)
    cells = [[0] * grid for _ in range(grid)]
    for x, y in points:
        column = min(grid - 1, max(0, int((x - minx) / width * grid)))
        row = min(grid - 1, max(0, int((y - miny) / height * grid)))
        cells[row][column] += 1
    best, where = -1, (0, 0)
    for row in range(grid - window + 1):
        for column in range(grid - window + 1):
            held = sum(sum(cells[r][column:column + window]) for r in range(row, row + window))
            if held > best:
                best, where = held, (column, row)
    total = len(points)
    even = 100.0 * window * window / (grid * grid)
    share = 100.0 * best / total
    fx = (where[0] + window / 2.0) / grid
    fy = (where[1] + window / 2.0) / grid
    ns = "north" if fy > 2.0 / 3.0 else ("south" if fy < 1.0 / 3.0 else "")
    ew = "east" if fx > 2.0 / 3.0 else ("west" if fx < 1.0 / 3.0 else "")
    return {"count": best, "total": total, "share": share, "even": even, "factor": share / even,
            "direction": "-".join(x for x in (ns, ew) if x) or "central",
            "concentrated": total >= ATLAS_CLUSTER_MIN_LOCATIONS and share >= ATLAS_CLUSTER_MIN_SHARE}


# --------------------------------------------------------------------------
# Drawing sample
# --------------------------------------------------------------------------

def sample_for_drawing(issues, cap=ATLAS_MAX_CIRCLES):
    """Issues to draw as circles: all located ones up to ``cap``; above that every k-th issue
    per rule (at least one per rule). Returns ``(drawn list, total located, sampled flag)``."""
    located = [i for i in issues if i.get("X") is not None and i.get("Y") is not None]
    if len(located) <= cap:
        return located, len(located), False
    step = int(math.ceil(len(located) / float(cap)))
    seen = {}
    drawn = []
    for issue in located:
        key = issue["RULE_ID"]
        n = seen.get(key, 0)
        if n % step == 0:
            drawn.append(issue)
        seen[key] = n + 1
    return drawn, len(located), True


def sample_marks(marks, cap=ATLAS_MAX_CIRCLES):
    """Marks to draw: all up to ``cap``; above that every k-th mark per rule and severity (at
    least one each). Returns ``(drawn list, total marks, sampled flag)``."""
    if len(marks) <= cap:
        return list(marks), len(marks), False
    step = int(math.ceil(len(marks) / float(cap)))
    seen = {}
    drawn = []
    for mark in marks:
        key = (mark["rule"], mark["severity"])
        n = seen.get(key, 0)
        if n % step == 0:
            drawn.append(mark)
        seen[key] = n + 1
    return drawn, len(marks), True


# ==========================================================================
# quality/atlas_html_core.py
# ==========================================================================
# QC Scorecard Report: the HTML page, its inline SVG graphics and the optional PNG.
#
# Pure Python, standard library only (matplotlib is imported lazily and guarded, for the
# PNG only). The page is ONE file: embedded CSS and JavaScript, no network request, so it
# works from ``file://`` and offline. Every piece of text that comes from data (dataset
# names, rule ids, messages, the title) goes through ``atlas_esc`` (``html.escape`` with
# quotes) before it is written, and no data is ever written inside the ``<script>``
# element: the script only toggles classes by index.
#
# ``render_report_html(model)`` takes the model built by ``assemble_model``.

ATLAS_HEX_TITLES_MAX = 2000
ATLAS_TOOL_NAMES = {UNI_TOOL_GEOMETRY: "Geometry Quality Checker",
                    UNI_TOOL_DOMAIN: "Domain Audit",
                    UNI_TOOL_NETWORK: "Line Network Rule Check"}
ATLAS_SEV_SOURCE_TEXT = {"default": "toolkit default severity", "threshold": "severity from the "
                         "threshold table", "override": "severity override", "table": "severity "
                         "from the issue table", "source": "severity from the issue table",
                         "guess": "empty severity, taken as WARNING",
                         "unknown": "unrecognised severity word, counted as ERROR"}
ATLAS_BAR_ROWS = 12
ATLAS_SEV_CLASS = {UNI_ERROR: "sev-error", UNI_WARNING: "sev-warning", UNI_INFO: "sev-info"}


def atlas_esc(value):
    """Text safe in element content and in quoted attribute values."""
    return html.escape("" if value is None else str(value), quote=True)


def _atlas_bdi(value):
    """Escaped user text isolated for mixed right-to-left / left-to-right display."""
    return "<bdi>{0}</bdi>".format(atlas_esc(value))


def _atlas_num(value):
    """Pixel coordinate text (one decimal, no trailing zero)."""
    text = "{0:.1f}".format(value)
    return text[:-2] if text.endswith(".0") else text


def atlas_circle_radius(count):
    """Radius of an issue circle in SVG units: full size for a few circles, smaller (never
    below ``ATLAS_CIRCLE_R_MIN``) as the number grows so a crowded map does not become a blob."""
    if count <= ATLAS_CIRCLE_R_FULL:
        return ATLAS_CIRCLE_R_MAX
    return max(ATLAS_CIRCLE_R_MIN, ATLAS_CIRCLE_R_MAX * math.sqrt(ATLAS_CIRCLE_R_FULL / float(count)))


def _atlas_plural(n, one, many=None):
    return "{0} {1}".format(n, one if n == 1 else (many or one + "s"))


def _atlas_thousands(n):
    return "{0:,}".format(int(n))


def _atlas_count(n, word):
    return "{0} {1}{2}".format(_atlas_thousands(n), word, "" if n == 1 else "s")


def atlas_hotspot(model):
    """The busiest hexagon, stated plainly: ``{"key", "count", "share", "mean", "direction",
    "concentrated"}`` or ``None`` without a density. The counts are locations (places where
    one or more issues sit), not issues. ``concentrated`` is true only when at least 20
    locations are known and the busiest hexagon holds at least 5 and three times the average
    of the occupied hexagons; it decides only whether the hexagon is outlined on the map. The
    sentence under the verdict uses ``block_concentration`` instead. ``direction`` names the
    third of the map (``north-east``, ``central``...) that holds the hexagon's centre."""
    density, t = model.get("hex"), model.get("transform")
    if not density or not density["cells"] or t is None:
        return None
    cells = density["cells"]
    key = max(sorted(cells), key=lambda k: cells[k])
    top, total = cells[key], sum(cells.values())
    mean = total / float(len(cells))
    u, v = hex_center(key[0], key[1], density["radius"])
    wx = density["origin"][0] + u / t["x_scale"]
    wy = density["origin"][1] + v
    fx = (wx - t["minx"]) / max(t["maxx"] - t["minx"], 1e-12)
    fy = (wy - t["miny"]) / max(t["maxy"] - t["miny"], 1e-12)
    ns = "north" if fy > 2.0 / 3.0 else ("south" if fy < 1.0 / 3.0 else "")
    ew = "east" if fx > 2.0 / 3.0 else ("west" if fx < 1.0 / 3.0 else "")
    direction = "-".join(x for x in (ns, ew) if x) or "central"
    return {"key": key, "count": top, "share": 100.0 * top / total, "mean": mean,
            "direction": direction,
            "concentrated": total >= 20 and top >= 5 and top >= 3.0 * mean}


def _atlas_focus_is_smaller(model):
    """True when the area the summary sentence is judged over is smaller than the map (context
    layers reach beyond the checked datasets and the issues)."""
    focus, extent = model.get("focus_extent"), model.get("extent")
    if focus is None or extent is None:
        return False
    return (focus[0] > extent[0] or focus[1] > extent[1] or focus[2] < extent[2]
            or focus[3] < extent[3])


def atlas_summary_text(model):
    """One plain sentence computed from the data (shown under the verdict and on the PNG).

    It counts issues and, when some share a point, distinct locations. It says "cluster" only
    when a window of one ninth of the map's area holds at least 40 % of the locations and there
    are at least 30 locations (``busiest_window``); it always gives the numbers. Otherwise it
    states the busiest window's share without that word."""
    score = model["score"]
    checked = " in {0} checked features".format(_atlas_thousands(score["checked_total"])) \
        if score["checked_total"] else ""
    if not score["total"]:
        return "No issues{0}.".format(checked)
    shared = model["located"] and model["locations"] < model["located"]
    at_issues = ""
    if shared:
        at_issues = " at {0} locations".format(_atlas_thousands(model["locations"])) \
            if model["located"] == score["total"] else \
            " ({0} distinct locations among the {1} located)".format(
                _atlas_thousands(model["locations"]), _atlas_thousands(model["located"]))
    if not score["errors"]:
        errors = "no errors"
    else:
        errors = _atlas_count(score["errors"], "error")
        if shared and model["error_locations"] and model["error_locations"] < model["error_located"]:
            errors += " at {0} locations".format(_atlas_thousands(model["error_locations"]))
    text = "{0}{1}{2}: {3}.".format(_atlas_count(score["total"], "issue"), at_issues, checked,
                                    errors)
    if model["located"] == 0:
        return text + " None has a location, so there is no map."
    conc = model.get("concentration")
    if conc is None or conc["total"] < ATLAS_CLUSTER_MIN_LOCATIONS:
        return text
    if conc["concentrated"]:
        return text + (" Issues cluster in the {0} of the map: {1} of {2} locations ({3} %) lie in "
                       "one ninth of the map area (an even spread gives {4} %).").format(
            conc["direction"] + " part",
            _atlas_thousands(conc["count"]), _atlas_thousands(conc["total"]),
            format_percent(conc["share"]), format_percent(conc["even"]))
    return text + (" No one-ninth part of the map holds more than {0} % of the locations "
                   "({1} % if spread evenly).").format(format_percent(conc["share"]),
                                                       format_percent(conc["even"]))


# --------------------------------------------------------------------------
# Model
# --------------------------------------------------------------------------

def assemble_model(issues, score, sources, layers, crs, title, run_id, created, version,
                   hex_size=None, notes=None, severity_words=None, checked_extent=None):
    """Everything the page needs, computed once.

    ``checked_extent``: ``(xmin, ymin, xmax, ymax)`` of the checked datasets as read (in the
    run's coordinate system) or ``None``. The summary sentence and the default hexagon size are
    judged over it joined with the issue locations (``atlas_focus_extent``), never over the
    context layers; the map itself still shows everything.

    ``severity_words``: ``{word: count}`` of unified-table severities that were not ERROR,
    WARNING or INFO and were counted as ERROR (``atlas_escalate_unknown_severities``).

    ``crs``: ``{"label", "wkid", "geographic", "known"}``. ``layers``: the result of
    ``AtlasVertexBudget.finish()``. ``hex_size``: map units or ``None`` for the default.
    """
    located = [i for i in issues if i.get("X") is not None and i.get("Y") is not None]
    places = issue_locations(located, bool(crs.get("geographic")))
    boxes = [layer["bbox"] for layer in layers]
    if located:
        xs = [i["X"] for i in located]
        ys = [i["Y"] for i in located]
        boxes.append((min(xs), min(ys), max(xs), max(ys)))
    extent = merge_extents(boxes)
    model = {"title": title, "run_id": run_id, "created": created, "version": version,
             "crs": crs, "issues": issues, "score": score, "sources": sources,
             "layers": layers, "notes": list(notes or []), "extent": extent,
             "severity_words": dict(severity_words or {}),
             "located": len(located), "unlocated": len(issues) - len(located),
             "locations": len(places),
             "error_located": sum(1 for i in located if i["SEVERITY"] == UNI_ERROR),
             "error_locations": sum(1 for p in places
                                    if any(i["SEVERITY"] == UNI_ERROR for i in p["issues"])),
             "marks": 0, "concentration": None, "focus_extent": None,
             "transform": None, "drawn": [], "sampled": False, "hex": None, "classes": [],
             "marks_by_severity": {}}
    if extent is None:
        return model
    x_scale = display_x_scale(extent, crs.get("geographic"))
    model["transform"] = make_transform(extent, x_scale)
    rule_order = dict((r["rule"], k) for k, r in enumerate(score["rules"]))
    marks = build_marks(places, rule_order)
    model["marks"] = len(marks)
    # markers per severity BEFORE sampling: the PNG legend gives these, not the drawn number
    model["marks_by_severity"] = {}
    for mark in marks:
        model["marks_by_severity"][mark["severity"]] = \
            model["marks_by_severity"].get(mark["severity"], 0) + 1
    model["drawn"], _total, model["sampled"] = sample_marks(marks)
    if located:
        t = model["transform"]
        points = [(p["x"], p["y"]) for p in places]
        focus = atlas_focus_extent(checked_extent, points)
        model["focus_extent"] = focus
        model["concentration"] = busiest_window(points, focus)
        density = hex_density(points, (t["minx"], t["miny"], t["maxx"], t["maxy"]), x_scale,
                              hex_size, size_extent=focus)
        model["hex"] = density
        model["classes"] = density_classes(density["cells"].values())
    return model


# --------------------------------------------------------------------------
# SVG pieces
# --------------------------------------------------------------------------

def _atlas_context_svg(model):
    """The context outline: one path per layer (or a dashed rectangle for extent-only)."""
    t = model["transform"]
    out = ['<g id="ctx-all" class="ctx">']
    for index, layer in enumerate(model["layers"]):
        name = atlas_esc(layer["name"])
        if layer["extent_only"] and layer["bbox"]:
            x0, y1 = to_pixel(t, layer["bbox"][0], layer["bbox"][1])
            x1, y0 = to_pixel(t, layer["bbox"][2], layer["bbox"][3])
            out.append('<rect class="ctx-extent" data-layer="{0}" x="{1}" y="{2}" width="{3}" '
                       'height="{4}"><title>{5}: extent only ({6} vertices; raise the vertex '
                       'limit to draw it)</title></rect>'.format(
                           index, _atlas_num(x0), _atlas_num(y0), _atlas_num(x1 - x0),
                           _atlas_num(y1 - y0), name, layer["vertices_in"]))
            continue
        if not layer["parts"]:
            continue
        if layer["kind"] == "point":
            marks = []
            for part in layer["parts"]:
                for x, y in part:
                    px, py = to_pixel(t, x, y)
                    marks.append("M{0} {1}h2v2h-2z".format(_atlas_num(px - 1), _atlas_num(py - 1)))
            out.append('<path class="ctx-pt" data-layer="{0}" d="{1}"><title>{2}</title></path>'
                       .format(index, "".join(marks), name))
            continue
        pieces = []
        for part in layer["parts"]:
            pts = [to_pixel(t, x, y) for x, y in part]
            if len(pts) < 2:
                continue
            pieces.append("M" + "L".join("{0} {1}".format(_atlas_num(px), _atlas_num(py))
                                         for px, py in pts) +
                          ("Z" if layer["kind"] == "polygon" else ""))
        out.append('<path class="ctx-{0}" data-layer="{1}" d="{2}"><title>{3}</title></path>'
                   .format("poly" if layer["kind"] == "polygon" else "line", index,
                           "".join(pieces), name))
    out.append("</g>")
    return "".join(out)


def _atlas_frame_svg(model):
    left, top, right, bottom = model["transform"]["frame"]
    return '<rect class="frame" x="{0}" y="{1}" width="{2}" height="{3}"/>'.format(
        _atlas_num(left), _atlas_num(top), _atlas_num(right - left), _atlas_num(bottom - top))


def _atlas_rule_index(model):
    return dict((r["rule"], i) for i, r in enumerate(model["score"]["rules"]))


def _atlas_hex_points(model, q, r):
    """Corner points text and pixel centre of the hexagon (q, r) in the SVG of ``model``."""
    t = model["transform"]
    density = model["hex"]
    ox, oy = density["origin"]
    xs = t["x_scale"]
    points = []
    for u, v in hex_corners(q, r, density["radius"]):
        px, py = to_pixel(t, ox + u / xs, oy + v)
        points.append("{0},{1}".format(_atlas_num(px), _atlas_num(py)))
    cu, cv = hex_center(q, r, density["radius"])
    return " ".join(points), to_pixel(t, ox + cu / xs, oy + cv)


def _atlas_hex_polygons(model, titles=True):
    """The hexagon polygons (one per occupied cell) in SVG pixel coordinates of ``model``."""
    density = model["hex"]
    bounds = model["classes"]
    cells = density["cells"]
    titles = titles and len(cells) <= ATLAS_HEX_TITLES_MAX
    out = []
    for (q, r) in sorted(cells):
        count = cells[(q, r)]
        points, _centre = _atlas_hex_points(model, q, r)
        out.append('<polygon class="h{0}" points="{1}">{2}</polygon>'.format(
            class_index(bounds, count), points,
            "<title>{0}</title>".format(_atlas_plural(count, "location")) if titles else ""))
    return out


def _atlas_hex_labels(model):
    """Count labels in the busiest hexagons (about ten, at least 2 issues) and a heavy outline
    on the busiest one, so the concentration can be read without the legend."""
    density = model["hex"]
    t = model["transform"]
    cells = density["cells"]
    ranked = sorted(cells.values(), reverse=True)
    floor = max(2, ranked[min(9, len(ranked) - 1)])
    size = max(9.0, min(22.0, density["radius"] * t["scale"] * 0.55))
    out = []
    hot = atlas_hotspot(model)
    for (q, r) in sorted(cells):
        if cells[(q, r)] < floor:
            continue
        _points, (cx, cy) = _atlas_hex_points(model, q, r)
        out.append('<text class="hv h{0}" x="{1}" y="{2}" font-size="{3}" text-anchor="middle" '
                   'dominant-baseline="central">{4}</text>'.format(
                       class_index(model["classes"], cells[(q, r)]), _atlas_num(cx), _atlas_num(cy),
                       _atlas_num(size), cells[(q, r)]))
    if hot is not None:
        points, _c = _atlas_hex_points(model, hot["key"][0], hot["key"][1])
        out.insert(0, '<polygon class="hotbg" points="{0}"/><polygon class="hotring" points="{0}">'
                      '<title>Busiest hexagon: {1}</title></polygon>'.format(
                          points, _atlas_plural(hot["count"], "location")))
    return out


def _atlas_deco_svg(model):
    """A north arrow (only for a known coordinate system, in the margin right of the frame, so
    it does not lie over the data) and, for a metric coordinate system, a scale bar."""
    t = model["transform"]
    left, top, right, bottom = t["frame"]
    out = ['<g class="deco" aria-hidden="true">']
    if model["crs"].get("known"):
        ax, ay = right + 10.0, top + 2.0
        out.append('<path class="na" d="M{0} {1}l9 22h-18z"/>'
                   '<text class="nt" x="{0}" y="{2}" text-anchor="middle">N</text>'.format(
                       _atlas_num(ax), _atlas_num(ay), _atlas_num(ay + 38)))
    if model["crs"].get("unit") == "m" and t["scale"] > 0:
        target = (right - left) * 0.2 / t["scale"]
        magnitude = 10 ** math.floor(math.log10(target)) if target > 0 else 1
        nice = magnitude
        for mult in (5, 2, 1):
            if mult * magnitude <= target:
                nice = mult * magnitude
                break
        length = nice * t["scale"]
        label = "{0:g} km".format(nice / 1000.0) if nice >= 1000 else "{0:g} m".format(nice)
        x0, y0 = left + 14.0, bottom - 16.0
        out.append('<path class="sb" d="M{0} {1}v-6h{2}v6"/><text class="nt" x="{0}" y="{3}">{4}</text>'
                   .format(_atlas_num(x0), _atlas_num(y0), _atlas_num(length), _atlas_num(y0 - 10),
                           label))
    out.append("</g>")
    return "".join(out)


def render_atlas_svg(model):
    """The error atlas: frame, context outline, (with many issues) the hexagon density, and one
    ``<g data-rule>`` of circles per rule (errors drawn last, so they lie on top). Each circle
    has a ``<title>`` that the page script shows under the map when a circle is tapped."""
    t = model["transform"]
    if t is None:
        return ""
    index = _atlas_rule_index(model)
    groups = {}
    for mark in model["drawn"]:
        groups.setdefault(mark["rule"], []).append(mark)
    radius = atlas_circle_radius(len(model["drawn"]))
    under = model["hex"] is not None and model["hex"]["cells"] and model["locations"] > ATLAS_DENSITY_UNDER
    # hexagons at the edge reach beyond the data extent: widen the view box so none is cut off
    pad = (model["hex"]["radius"] * t["scale"] + 2.0) if under else 0.0
    out = ['<svg class="map" viewBox="{2} {2} {0} {1}" role="img" aria-labelledby="atlas-t atlas-d" '
           'xmlns="http://www.w3.org/2000/svg">'.format(
               _atlas_num(t["W"] + 2 * pad), _atlas_num(t["H"] + 2 * pad), _atlas_num(-pad if pad else 0.0)),
           '<title id="atlas-t">Error atlas</title>',
           '<desc id="atlas-d">{0} markers for {1} issue locations drawn over a simplified outline '
           'of {2} context layer(s); issues at the same point are drawn once. Use the rule buttons '
           'above the map to show single rules.</desc>'.format(
               len(model["drawn"]), model["locations"], len(model["layers"])),
           _atlas_frame_svg(model), _atlas_context_svg(model)]
    if under:
        out.append('<g class="hexes under" id="hex-under">{0}</g>'.format(
            "".join(_atlas_hex_polygons(model, False))))
    out.append('<g class="issues">')
    order = sorted(model["score"]["rules"], key=lambda r: -ATLAS_SEVERITY_RANK[r["severity"]])
    for rule in order:
        items = groups.get(rule["rule"], [])
        if not items:
            continue
        out.append('<g data-rule="{0}" data-rule-group="{1}">'.format(
            atlas_esc(rule["rule"]), index[rule["rule"]]))
        for mark in items:
            px, py = to_pixel(t, mark["x"], mark["y"])
            cls = ATLAS_SEV_CLASS[mark["severity"]]
            r = radius * (1.25 if mark["severity"] == UNI_ERROR else 1.0)
            if mark["n"] > 1:
                cls += " multi"
                r *= 1.5
            lines = []
            for issue in mark["issues"][:4]:
                lines.append("{0} | {1} #{2}: {3}".format(
                    issue["RULE_ID"], issue.get("SOURCE") or "", issue.get("SRC_OID")
                    if issue.get("SRC_OID") is not None else "", (issue.get("MESSAGE") or "")[:160]))
            if mark["n"] > 1:
                lines.insert(0, "{0} issues at this point:".format(mark["n"]))
            if mark["n"] > 4:
                lines.append("... and {0} more".format(mark["n"] - 4))
            also = ' data-also="{0}"'.format(" ".join(str(k) for k in mark["also"])) \
                if mark["also"] else ""
            out.append('<circle class="{0}" cx="{1}" cy="{2}" r="{3}"{4}><title>{5}</title>'
                       '</circle>'.format(cls, _atlas_num(px), _atlas_num(py),
                                          _atlas_num(r), also, atlas_esc("\n".join(lines))))
        out.append("</g>")
    out.append("</g>")
    hot = atlas_hotspot(model)
    if under and hot is not None and hot["concentrated"]:
        points, _c = _atlas_hex_points(model, hot["key"][0], hot["key"][1])
        out.append('<polygon class="hotbg" points="{0}"/><polygon class="hotring" points="{0}"/>'
                   .format(points))
    out.append(_atlas_deco_svg(model))
    out.append("</svg>")
    return "".join(out)


def atlas_class_label(low, high):
    """``"7"`` or ``"1-6"``: the counts of one hexagon class."""
    return str(low) if low == high else "{0}-{1}".format(low, high)


def atlas_class_phrase(classes):
    """What the shades mean, with the class bounds: ``"one shade: 1-9 locations per hexagon (the
    spread is even)"`` or ``"light to dark: 1-6 / 7-8 / 9 locations per hexagon"``."""
    if not classes:
        return "no hexagon"
    labels = [atlas_class_label(low, high) for low, high in classes]
    if len(classes) == 1:
        return "one shade: {0} locations per hexagon (the spread is even)".format(labels[0])
    return "light to dark: {0} locations per hexagon".format(" / ".join(labels))


ATLAS_CLASS_RULE_TEXT = (
    "Classes: the lightest holds every hexagon with fewer than 1.5 times the median count (when "
    "that is all of them the spread is even and there is one shade); the busier hexagons get up "
    "to four darker classes, one per count when there are that few counts, else cut at quantiles "
    "of their counts, and a darker class starts only at 1.2 times the lowest count of the class "
    "before.")


def render_hex_svg(model):
    """The hexagon density panel: faint context outline, one polygon per occupied hexagon, the
    counts of the busiest ones and a heavy outline on the busiest."""
    t = model["transform"]
    density = model["hex"]
    if t is None or density is None or not density["cells"]:
        return ""
    cells = density["cells"]
    # Hexagons at the edge reach half a hexagon beyond the data extent: widen the view box.
    pad = density["radius"] * t["scale"] + 2.0
    out = ['<svg class="map" viewBox="{0} {0} {1} {2}" role="img" aria-labelledby="hex-t hex-d" '
           'xmlns="http://www.w3.org/2000/svg">'.format(
               _atlas_num(-pad), _atlas_num(t["W"] + 2 * pad), _atlas_num(t["H"] + 2 * pad)),
           '<title id="hex-t">Issue density</title>',
           '<desc id="hex-d">{0} hexagons hold at least one issue location; {1}. '
           'Numbers give the location count of the busiest hexagons.'
           '</desc>'.format(len(cells), atlas_esc(atlas_class_phrase(model["classes"]))),
           _atlas_frame_svg(model), '<use href="#ctx-all" class="faint"/>', '<g class="hexes">']
    out.extend(_atlas_hex_polygons(model))
    out.append("</g>")
    out.extend(_atlas_hex_labels(model))
    out.append("</svg>")
    return "".join(out)


def render_bars_svg(model):
    """Inline SVG bar chart: issues per rule (largest first, bars coloured by severity)."""
    rules = [r for r in model["score"]["rules"] if r["count"] > 0]
    if not rules:
        return ""
    shown = rules[:ATLAS_BAR_ROWS]
    rest = rules[ATLAS_BAR_ROWS:]
    rows = [(r["rule"], r["count"], r["severity"]) for r in shown]
    if rest:
        rows.append(("{0} other rules".format(len(rest)), sum(r["count"] for r in rest), UNI_INFO))
    top = max(count for _n, count, _s in rows)
    width, label_h, bar_h, gap, left, right = 360.0, 18.0, 14.0, 12.0, 4.0, 52.0
    row_h = label_h + bar_h + gap
    height = row_h * len(rows) + 4
    plot = width - left - right
    out = ['<svg class="bars" viewBox="0 0 {0} {1}" role="img" aria-labelledby="bar-t bar-d" '
           'xmlns="http://www.w3.org/2000/svg">'.format(_atlas_num(width), _atlas_num(height)),
           '<title id="bar-t">Issues per rule</title>',
           '<desc id="bar-d">Bar chart of the number of issues for each rule, largest first.'
           '</desc>']
    for k, (name, count, severity) in enumerate(rows):
        y = 2 + k * row_h
        bar = max(plot * count / float(top), 2.0)
        out.append('<g><title>{0}: {1}</title>'.format(atlas_esc(name), _atlas_plural(count, "issue")))
        out.append('<text class="bl" x="{0}" y="{1}">{2}</text>'.format(
            _atlas_num(left), _atlas_num(y + 12), atlas_esc(name)))
        out.append('<rect class="{0}" x="{1}" y="{2}" width="{3}" height="{4}" rx="4"/>'.format(
            ATLAS_SEV_CLASS[severity].replace("sev-", "bar-"), _atlas_num(left),
            _atlas_num(y + label_h), _atlas_num(bar), _atlas_num(bar_h)))
        out.append('<text class="bv" x="{0}" y="{1}">{2}</text></g>'.format(
            _atlas_num(left + bar + 6), _atlas_num(y + label_h + 11), count))
    out.append("</svg>")
    return "".join(out)


# --------------------------------------------------------------------------
# Page parts
# --------------------------------------------------------------------------

_ATLAS_CSS = """
:root{color-scheme:light dark;--bg:#f9f9f7;--surface:#fcfcfb;--ink:#0b0b0b;--ink2:#52514e;
--grid:#e1e0d9;--axis:#c3c2b7;--err:#d03b3b;--warn:#fab219;--info:#2a78d6;--pass:#006300;
--ctx-fill:#ecebe6;--ctx-line:#a9a8a0;--h0:#cde2fb;--h1:#86b6ef;--h2:#3987e5;--h3:#1c5cab;--h4:#0d366b;
--focus:#1c5cab;--pill-i:#1f5fb0;--pill-i-ink:#fff;--t0:#0b0b0b;--t1:#0b0b0b;--t2:#fff;--t3:#fff;--t4:#fff}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d0d0d;--surface:#1a1a19;
--ink:#f0efec;--ink2:#c3c2b7;--grid:#2c2c2a;--axis:#383835;--info:#3987e5;--ctx-fill:#262624;
--ctx-line:#5a5954;--h0:#184f95;--h1:#256abf;--h2:#3987e5;--h3:#6da7ec;--h4:#9ec5f4;--focus:#9ec5f4;--pill-i:#9ec5f4;--pill-i-ink:#0b0b0b;--t0:#fff;--t1:#fff;--t2:#fff;--t3:#0b0b0b;--t4:#0b0b0b}}
:root[data-theme="dark"]{--bg:#0d0d0d;--surface:#1a1a19;--ink:#f0efec;--ink2:#c3c2b7;--grid:#2c2c2a;
--axis:#383835;--info:#3987e5;--ctx-fill:#262624;--ctx-line:#5a5954;--h0:#184f95;--h1:#256abf;
--h2:#3987e5;--h3:#6da7ec;--h4:#9ec5f4;--focus:#9ec5f4;--pill-i:#9ec5f4;--pill-i-ink:#0b0b0b;--t0:#fff;--t1:#fff;--t2:#fff;--t3:#0b0b0b;--t4:#0b0b0b}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:1400px;margin:0 auto;padding:12px 16px}
h1{font-size:1.3rem;line-height:1.25;margin:.1rem 0 .1rem}
h2{font-size:1.1rem;margin:0 0 .5rem}
section{background:var(--surface);border:1px solid var(--grid);border-radius:12px;padding:16px;margin:16px 0}
.meta{color:var(--ink2);font-size:.9rem;margin:0}
.badge{display:flex;flex-wrap:wrap;align-items:center;gap:6px 16px;border-radius:12px;padding:12px 16px;
color:#fff;margin:8px 0}
.badge.fail{background:var(--err)}.badge.pass{background:var(--pass)}
.word{font-size:2.4rem;font-weight:800;letter-spacing:.02em;line-height:1}
.badge .sub{font-size:1rem;font-weight:600}
.badge .accept{font-weight:700;background:rgba(255,255,255,.2);border-radius:6px;padding:2px 8px;margin-top:4px}
.summary{font-size:1.05rem;font-weight:600;margin:8px 0;max-width:62ch}
.badge ul{margin:.3rem 0 0;padding-left:1.1rem;font-size:.92rem}
.tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:6px 0 0}
.tile{border:1px solid var(--grid);border-radius:10px;padding:4px 10px;background:var(--surface)}
.tile b{display:block;font-size:1.3rem;line-height:1.2}
.tile span{color:var(--ink2);font-size:.8rem}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px;margin:8px 0}
.card{font:inherit;color:inherit;text-align:left;background:var(--bg);border:1px solid var(--axis);
border-radius:10px;padding:10px 12px;min-height:44px;cursor:pointer;display:block;width:100%}
.card[aria-pressed="true"]{outline:3px solid var(--focus);outline-offset:1px;background:var(--surface)}
.card:focus-visible,.btn:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.card .row{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:2px 0}
.card .n{font-size:1.5rem;font-weight:700;line-height:1.2}
.card .r{font-weight:600;overflow-wrap:break-word;display:block}
.card .d{color:var(--ink2);font-size:.82rem;display:block}
.pill{display:inline-block;border-radius:999px;padding:0 8px;font-size:.75rem;font-weight:700;margin-right:4px}
.pill.e{background:var(--err);color:#fff}.pill.w{background:var(--warn);color:#0b0b0b}
.pill.i{background:var(--pill-i);color:var(--pill-i-ink)}.pill.f{background:var(--err);color:#fff}
.pill.k{background:var(--grid);color:var(--ink)}
.bar{display:block;height:6px;border-radius:3px;background:var(--grid);margin-top:6px;overflow:hidden}
.bar i{display:block;height:100%}.bar i.e{background:var(--err)}.bar i.w{background:var(--warn)}.bar i.i{background:var(--info)}
.tools{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 8px}
.btn{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--axis);border-radius:8px;
padding:8px 14px;min-height:44px;cursor:pointer}
.status{color:var(--ink2);font-size:.9rem;margin:4px 0}
svg.map{display:block;width:100%;height:auto;background:var(--bg);border:1px solid var(--grid);border-radius:8px}
svg.bars{display:block;width:100%;max-width:560px;height:auto}
.frame{fill:none;stroke:var(--axis);stroke-width:1}
.ctx-poly{fill:var(--ctx-fill);stroke:var(--ctx-line);stroke-width:1;fill-rule:evenodd}
.ctx-line{fill:none;stroke:var(--ctx-line);stroke-width:1.5}
.ctx-pt{fill:var(--ctx-line)}.ctx-extent{fill:none;stroke:var(--ctx-line);stroke-width:1.5;stroke-dasharray:8 6}
.faint{opacity:.55}
.sev-error{fill:var(--err);stroke:#fff;stroke-width:1.2}
.sev-warning{fill:var(--warn);stroke:var(--ink);stroke-width:2}
.sev-info{fill:none;stroke:var(--info);stroke-width:3}
.sev-error.multi,.sev-warning.multi{stroke:var(--ink);stroke-width:2.6}.sev-info.multi{stroke-width:5.5}
.off{display:none}
.h0{fill:var(--h0)}.h1{fill:var(--h1)}.h2{fill:var(--h2)}.h3{fill:var(--h3)}.h4{fill:var(--h4)}
polygon[class^="h"]{stroke:var(--surface);stroke-width:1}
text.hv{font-weight:700;pointer-events:none}text.hv.h0{fill:var(--t0)}text.hv.h1{fill:var(--t1)}text.hv.h2{fill:var(--t2)}
text.hv.h3{fill:var(--t3)}text.hv.h4{fill:var(--t4)}
.hotring{fill:none;stroke:var(--ink);stroke-width:3;stroke-dasharray:7 4;pointer-events:none}
.hotbg{fill:none;stroke:var(--surface);stroke-width:7;pointer-events:none}
.na{fill:var(--ink2)}.nt{fill:var(--ink2);font-size:13px;font-weight:700}.sb{fill:none;stroke:var(--ink2);stroke-width:2}
.bar-error{fill:var(--err)}.bar-warning{fill:var(--warn)}.bar-info{fill:var(--info)}
.bl{fill:var(--ink);font-size:13px}.bv{fill:var(--ink2);font-size:13px}
.legend{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:6px 16px;font-size:.9rem}
.legend li{display:flex;align-items:center;gap:6px}
.sw{display:inline-block;width:18px;height:18px;border-radius:4px;border:1px solid var(--axis)}
.sw.h0{background:var(--h0)}.sw.h1{background:var(--h1)}.sw.h2{background:var(--h2)}.sw.h3{background:var(--h3)}.sw.h4{background:var(--h4)}
.mk{display:inline-block;width:14px;height:14px;border-radius:50%;box-sizing:border-box}
.mk.e{background:var(--err);border:1.5px solid var(--surface)}.mk.w{background:var(--warn);border:2px solid var(--ink)}
.mk.i{border:3px solid var(--info)}.mk.big{width:20px;height:20px;border:2.5px solid var(--ink)}
.note{color:var(--ink2);font-size:.9rem;margin:.4rem 0}
.empty{border:1px dashed var(--axis);border-radius:10px;padding:16px;color:var(--ink2)}
table{border-collapse:collapse;width:100%;font-size:.9rem}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--grid);vertical-align:top;overflow-wrap:break-word}
td:nth-child(2),td:nth-child(3){min-width:8em}
th{color:var(--ink2);font-weight:600}
.scroll{overflow-x:auto}
details{margin:8px 0}summary{cursor:pointer;min-height:32px;font-weight:600}
footer{color:var(--ink2);font-size:.85rem;padding:8px 0 24px}
.fine{font-size:.85rem;font-weight:400;opacity:.95;margin-top:2px;max-width:60ch}
.chips{display:flex;gap:6px;overflow-x:auto;padding:6px 0;margin:0 0 6px;position:sticky;top:0;z-index:2;
background:var(--surface);-webkit-overflow-scrolling:touch}
.chip{flex:0 0 auto;font:inherit;font-size:.9rem;color:var(--ink);background:var(--bg);border:1px solid var(--axis);
border-radius:999px;padding:4px 12px;min-height:44px;cursor:pointer;white-space:nowrap}
.chip b{font-weight:700}
.chip[aria-pressed="true"]{outline:3px solid var(--focus);outline-offset:0;background:var(--surface)}
.chip:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.chip.e{border-left:6px solid var(--err)}.chip.w{border-left:6px solid var(--warn)}.chip.i{border-left:6px solid var(--info)}
.detail{white-space:pre-line;margin:6px 0;min-height:2.6em;padding:8px 12px;border-radius:8px;background:var(--bg);border:1px solid var(--grid);
font-size:.9rem;overflow-wrap:break-word}
.sel{stroke:var(--ink);stroke-width:4}
.under polygon{opacity:.4}
.chip.all{border-style:dashed}.chip.all[aria-pressed="false"]{opacity:.7}
.facts{margin:6px 0}.facts .fine{color:var(--ink2);max-width:none}
.head{display:flex;flex-wrap:wrap;align-items:baseline;gap:0 16px}
.dl{display:inline-block;text-decoration:none;margin:4px 0}
.hero-r section{margin:8px 0}.hero-r h2{position:absolute;left:-9999px}
@media (min-width:960px){.hero{display:grid;grid-template-columns:minmax(320px,400px) minmax(0,1fr);
grid-template-areas:"l r" "f r";grid-template-rows:auto 1fr;gap:0 16px;align-items:start}
.hero-l{grid-area:l}.hero-r{grid-area:r}.hero>.facts{grid-area:f}
.hero-r section{padding:10px 12px;margin:0}
.hero svg.map{max-height:calc(100vh - 150px);min-height:340px}.chips{position:static;flex-wrap:wrap;overflow:visible}}
@media (max-width:600px){main{padding:12px 16px}.word{font-size:2.2rem}.tiles{grid-template-columns:repeat(3,minmax(0,1fr))}
.tile b{font-size:1.15rem}.tile{padding:4px 8px}
table.list thead{display:none}table.list tr{display:block;border-bottom:1px solid var(--axis);padding:6px 0}
table.list td{display:block;border:0;padding:2px 0}table.list td::before{content:attr(data-l) ": ";color:var(--ink2)}}
@media print{.tools,.card{break-inside:avoid}}
"""

_ATLAS_JS = """
(function(){
var cards=[].slice.call(document.querySelectorAll('[data-card]'));
var groups=[].slice.call(document.querySelectorAll('[data-rule-group]'));
var status=document.getElementById('atlas-status');
var detail=document.getElementById('atlas-detail');
var state={};
function apply(){
var n=0,k;for(k in state){if(state[k]){n++;}}
cards.forEach(function(c){c.setAttribute('aria-pressed',state[c.getAttribute('data-card')]?'true':'false');});
groups.forEach(function(g){var own=state[g.getAttribute('data-rule-group')];
[].slice.call(g.querySelectorAll('circle')).forEach(function(c){var show=n===0||own;
if(!show){var also=c.getAttribute('data-also');if(also){also.split(' ').forEach(function(a){if(state[a]){show=true;}});}}
if(show){c.classList.remove('off');}else{c.classList.add('off');}});});
if(status){status.textContent=n===0?'Showing all rules on the map.':'Showing '+n+' selected rule'+(n===1?'':'s')+' on the map.';}
}
cards.forEach(function(c){c.addEventListener('click',function(){
var k=c.getAttribute('data-card');state[k]=!state[k];apply();});});
var map=document.querySelector('svg.map[aria-labelledby="atlas-t atlas-d"]');
var all=document.getElementById('show-all');
if(all){all.addEventListener('click',function(){state={};apply();});}
var hexBtn=document.getElementById('toggle-hex'),hexUnder=document.getElementById('hex-under');
if(hexBtn&&hexUnder){hexBtn.addEventListener('click',function(){
var on=hexBtn.getAttribute('aria-pressed')!=='true';hexBtn.setAttribute('aria-pressed',on?'true':'false');
[].slice.call(map.querySelectorAll('.hexes.under,.hotring,.hotbg')).forEach(function(g){if(on){g.classList.remove('off');}else{g.classList.add('off');}});});}
if(map&&detail){map.addEventListener('click',function(e){
var pt=map.createSVGPoint();pt.x=e.clientX;pt.y=e.clientY;var m=map.getScreenCTM();
if(!m){return;}var q=pt.matrixTransform(m.inverse());var x=q.x,y=q.y;
var best=null,bd=1e9,list=map.querySelectorAll('.issues circle');
for(var i=0;i<list.length;i++){var c=list[i];
if(c.classList.contains('off')){continue;}
var dx=c.cx.baseVal.value-x,dy=c.cy.baseVal.value-y,d=dx*dx+dy*dy;
if(d<bd){bd=d;best=c;}}
var old=map.querySelector('.sel');if(old){old.classList.remove('sel');}
if(best&&bd<=1600){best.classList.add('sel');var t=best.querySelector('title');
detail.textContent=t?t.textContent:'';}
else{detail.textContent='No issue circle near this spot. Tap closer to a circle.';}
});}
apply();
})();
"""


def _atlas_badge_reasons(score):
    """Reasons shown in the badge: rules failing only because they have errors (no limit given)
    are summed up in one line; limit failures and the pass rate keep their own line."""
    default = [r for r in score["rules"] if r["status"] == "FAIL" and "no limit given" in r["reason"]]
    lines = []
    if default:
        errors = sum(r["errors"] for r in default)
        lines.append("{0} in {1}; without a limit any ERROR fails.".format(
            _atlas_plural(errors, "error"), _atlas_plural(len(default), "rule")))
    lines.extend("{0}: {1}".format(r["rule"], r["reason"]) for r in score["rules"]
                 if r["status"] == "FAIL" and "no limit given" not in r["reason"])
    lines.extend(t for t in score["reasons"] if t.startswith("Pass rate"))
    return lines


def _atlas_severity_text(model):
    """One sentence on where the severities come from (the source tools write none)."""
    counts = model["score"].get("sev_from") or {}
    total = sum(counts.values())
    if not total:
        return ""
    default = counts.get("default", 0)
    others = []
    for key, label in (("threshold", "from the threshold table"), ("override", "overridden"),
                       ("table", "from the issue table"), ("source", "from the issue table"),
                       ("guess", "empty, taken as WARNING"),
                       ("unknown", "an unrecognised word, counted as ERROR")):
        if counts.get(key):
            others.append("{0} {1}".format(counts[key], label))
    text = ""
    if default:
        text = ("Severity is the toolkit default for {0} of {1} issues (the source tools write no "
                "severity)".format(default, total))
        if others:
            text += "; " + ", ".join(others)
        text += "."
    elif others:
        text = "Severity: " + ", ".join(others) + "."
    return text


def _atlas_badge_facts(model):
    """Small print under the verdict: which tools' tables were read, where severity comes from."""
    lines = []
    read = []
    for s in model["sources"]:
        name = ATLAS_TOOL_NAMES.get(s["tool"])
        if name and name not in read:
            read.append(name)
    if read:
        missing = [n for n in ATLAS_TOOL_NAMES.values() if n not in read]
        text = "Tables read: " + ", ".join(read) + "."
        if missing and len(read) < len(ATLAS_TOOL_NAMES):
            text += " Not given: " + ", ".join(missing) + " (no verdict on what they check)."
        lines.append(text)
    sev = _atlas_severity_text(model)
    if sev:
        lines.append(sev)
    lines.extend(model["score"].get("input_warnings") or [])
    lines.extend(model["score"].get("rate_warnings") or [])
    lines.extend(model["score"].get("limit_warnings") or [])
    if model["located"] and model["locations"] < model["located"]:
        lines.append("{0} located issues sit at {1} distinct locations: issues at the same point "
                     "(for example a DANGLE and a T_MISS on one line end) are drawn once, as a "
                     "larger ringed circle, and the hexagons count locations.".format(
                         _atlas_thousands(model["located"]), _atlas_thousands(model["locations"])))
    if any(s["tool"] == UNI_TOOL_UNIFIED for s in model["sources"]):
        lines.append("A unified issue table keeps each issue's severity but not the limits of the "
                     "run that made it (maximum count, maximum rate, minimum pass rate): this "
                     "verdict uses only the limits given in this run.")
    if model["score"].get("unmatched"):
        lines.append("No issues were found for the rule(s) named in the limits or overrides: "
                     + ", ".join(model["score"]["unmatched"][:8]) + " (check the spelling).")
    return lines


def _atlas_facts_html(model):
    lines = _atlas_badge_facts(model)
    if not lines:
        return ""
    return '<div class="facts">{0}</div>'.format("".join(
        '<div class="fine">{0}</div>'.format(_atlas_bdi(line)) for line in lines))


def _atlas_accepted_line(score):
    """The badge line that says how many errors were accepted by limits, and which limits."""
    if not score.get("accepted_errors"):
        return ""
    rules = ["{0}: {1}".format(a["rule"], a["limit"]) for a in score["accepted"][:3]]
    more = len(score["accepted"]) - len(rules)
    return "{0} accepted by your limits ({1}{2})".format(
        _atlas_plural(score["accepted_errors"], "error"), "; ".join(rules),
        "; and {0} more rule(s)".format(more) if more > 0 else "")


def atlas_unknown_severity_line(model):
    """Badge line for severity words that are not ERROR, WARNING or INFO (counted as ERROR)."""
    words = model.get("severity_words") or {}
    if not words:
        return ""
    total = sum(words.values())
    shown = sorted(words.items(), key=lambda kv: (-kv[1], kv[0]))[:5]
    listed = ", ".join("{0} x{1}".format(w, n) if n > 1 else w for w, n in shown)
    if len(words) > len(shown):
        listed += ", ..."
    return ("{0} with a severity that is not ERROR, WARNING or INFO ({1}) counted as ERROR; "
            "set the right severity with Severity Overrides if that is wrong.".format(
                _atlas_plural(total, "issue"), listed))


def _atlas_error_phrase(model):
    """``948 errors at 611 locations`` (the locations only when errors share points)."""
    score = model["score"]
    text = _atlas_count(score["errors"], "error")
    if score["errors"] and model["error_locations"] and \
            model["error_locations"] < model["error_located"]:
        text += " at {0} locations".format(_atlas_thousands(model["error_locations"]))
    return text


def _atlas_badge(model):
    score = model["score"]
    ok = score["verdict"] == "PASS"
    lines = []
    if score["rate"] is not None:
        text = "Pass rate {0} %".format(atlas_format_compared(score["rate"], score["min_pass_rate"]))
        if score["min_pass_rate"] is not None:
            text += " (required {0} %)".format(atlas_format_typed(score["min_pass_rate"]))
        lines.append(text)
    elif score["min_pass_rate"] is not None:
        lines.append("Required pass rate {0} %".format(atlas_format_typed(score["min_pass_rate"])))
    else:
        lines.append("Pass rate not computed")
    if score["total"]:
        err = _atlas_error_phrase(model)
        lines.append("{0} - {1} - {2}".format(err,
                                              _atlas_plural(score["warnings"], "warning"),
                                              _atlas_plural(score["infos"], "info note")))
    else:
        lines.append("No issues found")
    out = ['<div class="badge {0}" role="group" aria-label="Delivery verdict: {1}">'.format(
        "pass" if ok else "fail", score["verdict"]),
        '<span class="word">{0}</span><div>'.format(score["verdict"])]
    out.extend('<div class="sub">{0}</div>'.format(atlas_esc(line)) for line in lines)
    accepted = _atlas_accepted_line(score)
    if accepted:
        out.append('<div class="sub accept">{0}</div>'.format(_atlas_bdi(accepted)))
    unknown = atlas_unknown_severity_line(model)
    if unknown:
        out.append('<div class="sub accept">{0}</div>'.format(_atlas_bdi(unknown)))
    reasons = _atlas_badge_reasons(score)
    if reasons:
        out.append("<ul>")
        for reason in reasons[:5]:
            out.append("<li>{0}</li>".format(_atlas_bdi(reason)))
        if len(reasons) > 5:
            out.append("<li>and {0} more</li>".format(len(reasons) - 5))
        out.append("</ul>")
    out.append("</div></div>")
    return "".join(out)


def _atlas_tiles(model):
    score = model["score"]
    items = [(score["total"], "issues"), (score["errors"], "errors"), (score["warnings"], "warnings"),
             (score["infos"], "info notes")]
    if model["located"]:
        items.append((model["locations"], "distinct locations"))
    items.append((len([r for r in score["rules"] if r["count"]]), "rules with issues"))
    if score["checked_total"]:
        items.append((score["checked_total"], "features checked"))
    return '<div class="tiles">{0}</div>'.format("".join(
        '<div class="tile"><b>{0}</b><span>{1}</span></div>'.format(_atlas_thousands(n), atlas_esc(label))
        for n, label in items))


def _atlas_sev_letter(severity):
    return {UNI_ERROR: "e", UNI_WARNING: "w", UNI_INFO: "i"}[severity]


def _atlas_card_body(rule, i, top):
    letter = _atlas_sev_letter(rule["severity"])
    status = ""
    if rule["status"] == "FAIL":
        status = '<span class="pill f">FAILS</span>'
    elif rule.get("accepted"):
        status = '<span class="pill k">ACCEPTED BY LIMIT</span>'
    detail = []
    if rule["unlocated"] and rule["count"]:
        detail.append("{0} without location".format(rule["unlocated"]))
    if rule["max_count"] is not None or rule["max_rate"] is not None:
        limits = []
        if rule["max_count"] is not None:
            limits.append("max {0}".format(atlas_format_typed(rule["max_count"])))
        if rule["max_rate"] is not None:
            limits.append("max {0} %".format(atlas_format_typed(rule["max_rate"])))
        detail.append("limit " + ", ".join(limits))
    sev_from = [ATLAS_SEV_SOURCE_TEXT[k] for k in rule.get("sev_from", []) if k in ATLAS_SEV_SOURCE_TEXT
                and k != "source"]
    tools = ", ".join(rule["tools"])
    return ('<span class="r">{0}</span><span class="row"><span class="n">{1}</span>'
            '<span class="pill {2}">{3}</span>{4}</span><span class="d">{5}</span>'
            '<span class="d">{6}</span><span class="d">{7}</span>'
            '<span class="bar"><i class="{2}" style="width:{8:.1f}%"></i></span>'.format(
                atlas_esc(rule["rule"]), rule["count"], letter, rule["severity"], status,
                atlas_esc("; ".join(x for x in [tools] + detail if x)),
                atlas_esc("; ".join(sev_from)),
                atlas_esc(("Object IDs: " + ", ".join(str(o) for o in rule["oids"]) +
                           (" ..." if rule["features"] > len(rule["oids"]) else ""))
                          if rule.get("oids") else ""),
                100.0 * rule["count"] / top))


def _atlas_cards(model):
    rules = model["score"]["rules"]
    if not rules:
        return '<p class="empty">No rules to show.</p>'
    top = max([r["count"] for r in rules] + [1])
    out = ['<div class="cards">']
    for i, rule in enumerate(rules):
        out.append(
            '<button type="button" class="card" data-card="{0}" aria-pressed="false" '
            'aria-label="{1}: {2}, severity {3}. Press to show only this rule on the map.">{4}'
            '</button>'.format(i, atlas_esc(rule["rule"]), _atlas_plural(rule["count"], "issue"),
                               rule["severity"].lower(), _atlas_card_body(rule, i, top)))
    out.append("</div>")
    return "".join(out)


def _atlas_chips(model, density_button=False):
    """A row of rule buttons directly above the map (the same toggles as the cards), the
    "Show all rules" button and, when hexagons lie under the circles, a density switch."""
    rules = [r for r in model["score"]["rules"] if r["count"]]
    if not rules:
        return ""
    out = ['<div class="chips" role="group" aria-label="Show rules on the map">']
    for i, rule in enumerate(model["score"]["rules"]):
        if not rule["count"]:
            continue
        out.append('<button type="button" class="chip {0}" data-card="{1}" aria-pressed="false" '
                   'aria-label="{2}: {3}. Show only this rule on the map."><bdi>{2}</bdi> '
                   '<b>{4}</b></button>'.format(_atlas_sev_letter(rule["severity"]), i,
                                                atlas_esc(rule["rule"]),
                                                _atlas_plural(rule["count"], "issue"),
                                                _atlas_thousands(rule["count"])))
    out.append('<button type="button" class="chip all" id="show-all">Show all rules</button>')
    if density_button:
        out.append('<button type="button" class="chip all" id="toggle-hex" aria-pressed="true">'
                   'Density hexagons (all rules)</button>')
    out.append("</div>")
    return "".join(out)


def _atlas_legend_markers():
    return ('<ul class="legend"><li><span class="mk e"></span> error</li>'
            '<li><span class="mk w"></span> warning</li><li><span class="mk i"></span> info</li>'
            '<li><span class="mk e big"></span> several issues at one point</li></ul>')


def _atlas_atlas_section(model):
    out = ['<section class="atlas" aria-labelledby="atlas-h"><h2 id="atlas-h">Error atlas</h2>']
    if model["transform"] is None:
        out.append('<p class="empty">{0}</p>'.format(
            "No issue has a location and no context layer was given, so there is nothing to "
            "draw. The rule cards, the chart and the issue list still hold every "
            "issue." if model["score"]["total"] else
            "Nothing to draw: no issues were found."))
        out.append("</section>")
        return "".join(out)
    out.append(_atlas_chips(model, model["locations"] > ATLAS_DENSITY_UNDER and bool(
        model["hex"] and model["hex"]["cells"])))
    if not model["drawn"]:
        out.append('<p class="note">{0}</p>'.format(
            "No issues were found, so the map shows only the outline of the context layers."
            if not model["score"]["total"] else
            "No issue has a location, so nothing is drawn over the outline."))
    out.append(render_atlas_svg(model))
    if model["drawn"]:
        out.append('<p class="detail" id="atlas-detail" role="status" aria-live="polite">Tap or '
                   'hover a circle to read the issue here.</p>'
                   '<p class="status" id="atlas-status" role="status" aria-live="polite">'
                   'Showing all rules on the map.</p>')
    out.append(_atlas_legend_markers())
    notes = []
    if model["unlocated"]:
        notes.append("{0} of {1} issues have no location and are not on the map; they are in the "
                     "cards, the chart and the issue list.".format(model["unlocated"],
                                                                   model["score"]["total"]))
    if model["locations"] > ATLAS_DENSITY_UNDER:
        notes.append("{0} issue locations: the hexagons under the circles (all rules, not only "
                     "the rules selected above) show where they concentrate.".format(
                         model["locations"]))
    if model["sampled"]:
        notes.append("Large result: {0} of {1} markers are drawn (every k-th marker of each rule). "
                     "The density panel and all counts use every issue.".format(
                         len(model["drawn"]), model["marks"]))
    for layer in model["layers"]:
        if layer["extent_only"]:
            notes.append("Layer {0}: too many vertices ({1}), drawn as its extent only.".format(
                layer["name"], layer["vertices_in"]))
        elif layer["thinned"]:
            notes.append("Layer {0}: simplified from {1} to {2} vertices.".format(
                layer["name"], layer["vertices_in"], layer["vertices_out"]))
        if layer["curves_skipped"]:
            notes.append("Layer {0}: {1} feature(s) with true curves are not drawn.".format(
                layer["name"], layer["curves_skipped"]))
    out.extend('<p class="note">{0}</p>'.format(_atlas_bdi(n)) for n in notes)
    out.append("</section>")
    return "".join(out)


def _atlas_hex_section(model):
    out = ['<section aria-labelledby="hex-h"><h2 id="hex-h">Where issues concentrate</h2>']
    density = model["hex"]
    if density is None or not density["cells"]:
        out.append('<p class="empty">{0}</p></section>'.format(
            "No issue has a location, so no density can be computed." if model["score"]["total"]
            else "No issues, so there is nothing to bin."))
        return "".join(out)
    unit = model["crs"].get("unit") or ("degrees" if model["crs"].get("geographic") else "map units")
    out.append(render_hex_svg(model))
    items = []
    for i, (low, high) in enumerate(model["classes"]):
        items.append('<li><span class="sw h{0}"></span> {1}</li>'.format(
            i, atlas_esc(atlas_class_label(low, high))))
    out.append('<ul class="legend" aria-label="Locations per hexagon">{0}</ul>'.format("".join(items)))
    text = ("Hexagons are {0:.6g} {1} from side to side (flat-top grid); only hexagons with at "
            "least one issue location are drawn. Each location counts once, however many issues "
            "sit there, and all rules are counted. {2} Here: {3}."
            .format(density["size"], unit, ATLAS_CLASS_RULE_TEXT, atlas_class_phrase(model["classes"])))
    if model["crs"].get("geographic"):
        text += " The grid is laid out on longitude scaled by cos(latitude), so it looks regular."
    if density["coarsened"]:
        text += " The size was raised from {0:.6g} to keep at most 20,000 hexagons.".format(
            density["requested"])
    hot = atlas_hotspot(model)
    if hot is not None:
        text += " The dashed outline marks the busiest hexagon ({0}); the numbers give the counts of the busiest ones.".format(
            _atlas_plural(hot["count"], "location"))
    out.append('<p class="note">{0}</p></section>'.format(atlas_esc(text)))
    return "".join(out)


def _atlas_bars_section(model):
    svg = render_bars_svg(model)
    return ('<section aria-labelledby="bar-h"><h2 id="bar-h">Issues per rule</h2>{0}</section>'
            .format(svg or '<p class="empty">No issues, so there is nothing to chart.</p>'))


def _atlas_sources_section(model):
    rows = []
    for s in model["sources"]:
        rows.append('<tr><td data-l="Tool">{0}</td><td data-l="Table">{1}</td>'
                    '<td data-l="Rows">{2}</td><td data-l="Checked dataset">{3}</td>'
                    '<td data-l="Located">{4}</td></tr>'.format(
                        _atlas_bdi(s["tool"]), _atlas_bdi(s["table"]), s["rows"],
                        _atlas_bdi(s["checked"]) + (" ({0} features)".format(s["checked_count"])
                                                    if s.get("checked_count") is not None else "")
                        if s.get("checked") else "-",
                        "{0} of {1}".format(s["located"], s["rows"])))
    return ('<section aria-labelledby="src-h"><h2 id="src-h">Sources read</h2><div class="scroll">'
            '<table class="list"><thead><tr><th scope="col">Tool</th><th scope="col">Issue table'
            '</th><th scope="col">Rows</th><th scope="col">Checked dataset</th><th scope="col">'
            'Located</th></tr></thead><tbody>{0}</tbody></table></div></section>'.format("".join(rows)))


_ATLAS_CSV_TEXT = ("TOOL", "RULE_ID", "SOURCE", "MESSAGE", "FIELD", "VALUE")


_ATLAS_NUMBER_WITH_UNIT = re.compile(r"^[+-]?\d+(?:[.,]\d+)*(?: ?[A-Za-z%\u00b0\u00b2\u00b3/]{1,8})?$")


def _atlas_csv_cell(value):
    """Text cell of the CSV. A cell that starts with ``=`` or ``@``, or with ``+`` or ``-`` and
    is not a plain number with an optional short unit (``-5 m``, ``+2.5``), gets one apostrophe
    in front, so a spreadsheet does not run it as a formula. That apostrophe is the only change;
    delete a leading apostrophe to get the original text back. Line breaks become spaces."""
    text = "" if value is None else str(value).replace("\r", " ").replace("\n", " ")
    first = text[:1]
    if first in ("=", "@", "\t"):
        return "'" + text
    if first in ("+", "-") and not _ATLAS_NUMBER_WITH_UNIT.match(text):
        return "'" + text
    return text


def _atlas_sorted_issues(model):
    return sorted(model["issues"], key=lambda i: (
        ATLAS_SEVERITY_RANK[i["SEVERITY"]], str(i["RULE_ID"]).casefold(), str(i.get("SOURCE")),
        i.get("SRC_OID") if i.get("SRC_OID") is not None else -1))


def atlas_csv_text(model, limit=ATLAS_CSV_MAX):
    """The issues as CSV text (UTF-8 with a byte-order mark is added by the caller): the unified
    fields plus SEVERITY_FROM, at most ``limit`` rows (errors first). Returns ``(text, rows)``."""
    import csv
    import io
    buffer = io.StringIO()
    writer = csv.writer(buffer, lineterminator="\r\n")
    writer.writerow(list(UNI_FIELDS) + ["SEVERITY_FROM"])
    rows = _atlas_sorted_issues(model)[:limit]
    for issue in rows:
        values = []
        for name in UNI_FIELDS:
            if name == "RUN_ID":
                values.append(model["run_id"])
            elif name in ("X", "Y"):
                v = issue.get(name)
                values.append("" if v is None else "{0:.10g}".format(v))
            elif name == "SRC_OID":
                values.append("" if issue.get("SRC_OID") is None else issue["SRC_OID"])
            elif name == "SEVERITY":
                values.append(issue["SEVERITY"])
            elif name == "MESSAGE":
                values.append(_atlas_csv_cell(issue.get("MESSAGE") or ""))   # whole, not cut
            else:
                values.append(_atlas_csv_cell(issue.get(name)))
        values.append(issue.get("_sev_from") or "source")
        writer.writerow(values)
    return buffer.getvalue(), len(rows)


def _atlas_csv_link(model):
    """An offline download link (``data:`` URI) with the issues as CSV."""
    if not model["issues"]:
        return ""
    text, rows = atlas_csv_text(model)
    data = base64.b64encode(("\ufeff" + text).encode("utf-8")).decode("ascii")
    note = "" if rows == len(model["issues"]) else " (the first {0} of {1}, errors first; the " \
        "issue table output has all of them)".format(rows, len(model["issues"]))
    return ('<p><a class="btn dl" download="qc_issues.csv" href="data:text/csv;charset=utf-8;'
            'base64,{0}">Download the issues as CSV ({1} rows)</a>{2}</p>'.format(
                data, rows, atlas_esc(note)))


def _atlas_list_section(model):
    issues = _atlas_sorted_issues(model)
    shown = issues[:ATLAS_ISSUE_LIST]
    if not shown:
        return ""
    rows = []
    for i in shown:
        letter = _atlas_sev_letter(i["SEVERITY"])
        rows.append('<tr><td data-l="Severity"><span class="pill {0}">{1}</span></td>'
                    '<td data-l="Rule">{2}</td><td data-l="Source">{3}</td>'
                    '<td data-l="Object ID">{4}</td><td data-l="Message">{5}</td></tr>'.format(
                        letter, i["SEVERITY"], _atlas_bdi(i["RULE_ID"]), _atlas_bdi(i.get("SOURCE")),
                        "" if i.get("SRC_OID") is None else i["SRC_OID"],
                        _atlas_bdi((i.get("MESSAGE") or "")[:300])))
    return ('<section aria-labelledby="list-h"><h2 id="list-h">Issue list</h2>' + _atlas_csv_link(model) +
            '<details><summary>'
            'Show the first {0} of {1} issues</summary><div class="scroll"><table class="list">'
            '<thead><tr><th scope="col">Severity</th><th scope="col">Rule</th><th scope="col">'
            'Source</th><th scope="col">Object ID</th><th scope="col">Message</th></tr></thead>'
            '<tbody>{2}</tbody></table></div></details></section>'.format(
                len(shown), len(issues), "".join(rows)))


def _atlas_method_section(model):
    score = model["score"]
    crs = model["crs"]
    items = ["Coordinates: {0}.".format(crs["label"])]
    if score["rate_note"]:
        items.append(score["rate_note"])
    items.append("Pass rate = 100 x (1 - failing features / checked features); a failing "
                 "feature is a checked feature (found by its object id in the checked dataset) "
                 "with at least one ERROR issue, counted once however many errors it has. The "
                 "rate is between 0 and 100. Without a rule limit any ERROR fails the rule.")
    if model["located"]:
        items.append("Locations: issues at the same point (to 1 mm; 1e-7 degree for degrees) "
                     "are one location. {0} issues are at {1} locations. The \"cluster\" "
                     "sentence is used only when some window of one ninth of the map area (a third "
                     "of its width and height, anywhere on the map) holds at least 40 % of the "
                     "locations and there are at least 30 locations; it is a plain count with a "
                     "stated threshold, not a statistical test.".format(
                         _atlas_thousands(model["located"]), _atlas_thousands(model["locations"])))
        if _atlas_focus_is_smaller(model):
            items.append("For that sentence and the default hexagon size the map is the area of "
                         "the checked datasets and the issue locations; the context layers reach "
                         "beyond it and are not counted, so an outline around the checked area "
                         "cannot make an even spread look like a cluster.")
    sev = _atlas_severity_text(model)
    if sev:
        items.append(sev + " The toolkit's defaults are a choice of the toolkit (for example "
                     "DANGLE and T_MISS are errors), not a standard; the tool's threshold "
                     "table and Severity Overrides replace them per rule.")
    items.extend(model["notes"])
    return ('<section aria-labelledby="how-h"><h2 id="how-h">How to read this report</h2><details>'
            '<summary>Method and notes</summary>{0}</details></section>'.format(
                "".join('<p class="note">{0}</p>'.format(_atlas_bdi(t)) for t in items)))


def render_report_html(model):
    """The complete HTML document (one string)."""
    score = model["score"]
    parts = ['<!DOCTYPE html>\n<html lang="en"><head><meta charset="utf-8">'
             '<meta name="viewport" content="width=device-width, initial-scale=1">'
             '<meta name="color-scheme" content="light dark">'
             '<title>{0} - {1}</title><style>{2}</style></head><body><main>'.format(
                 atlas_esc(model["title"]), score["verdict"], _ATLAS_CSS)]
    parts.append('<header class="head"><h1>{0}</h1><p class="meta">Run {1} - {2} - {3}</p></header>'
                 .format(_atlas_bdi(model["title"]), atlas_esc(model["run_id"]),
                         atlas_esc(model["created"]), _atlas_bdi(model["crs"]["label"])))
    left = '{0}<p class="summary" id="summary">{1}</p>{2}'.format(
        _atlas_badge(model), atlas_esc(atlas_summary_text(model)), _atlas_tiles(model))
    parts.append('<div class="hero"><div class="hero-l">{0}</div><div class="hero-r">{1}</div>{2}</div>'
                 .format(left, _atlas_atlas_section(model), _atlas_facts_html(model)))
    if not score["total"]:
        parts.append('<section><p class="empty">{0}</p></section>'.format(atlas_esc(
            "No issues were found in the {0} issue table(s) that were read, so the verdict is "
            "PASS. This says the given tables are empty; it does not prove that the checks "
            "that made them cover the whole delivery.".format(len(model["sources"])))))
    rules = ('<section aria-labelledby="rules-h"><h2 id="rules-h">Rules</h2>'
             '<p class="note">Sorted by number of issues. Press a rule to show only that rule '
             'on the map (the buttons above the map do the same); press again to undo.</p>{0}'
             '</section>'.format(_atlas_cards(model)))
    parts.append(_atlas_hex_section(model))
    parts.append(rules)
    parts.append(_atlas_bars_section(model))
    parts.append(_atlas_sources_section(model))
    parts.append(_atlas_list_section(model))
    parts.append(_atlas_method_section(model))
    parts.append('<footer>Made by QcScorecardAtlas {0} (ArcGIS Pro QA Toolkit). A report of '
                 'the issue tables it was given; it is not an Esri Data Reviewer product.'
                 '</footer></main><script>{1}</script></body></html>\n'.format(
                     atlas_esc(model["version"]), _ATLAS_JS))
    return "".join(parts)


# --------------------------------------------------------------------------
# Optional PNG (matplotlib, lazy and guarded)
# --------------------------------------------------------------------------

def _atlas_ascii(text, limit=60):
    """Text for the PNG: non-ASCII characters become '?' (Arabic would not shape correctly)."""
    safe = "".join(ch if 32 <= ord(ch) < 127 else "?" for ch in str(text))
    return safe[:limit]


_ATLAS_PNG_RAMP = ("#cde2fb", "#86b6ef", "#3987e5", "#1c5cab", "#0d366b")


ATLAS_PNG_MIN_SHARE = ATLAS_MIN_HEIGHT / ATLAS_SVG_WIDTH   # shorter side >= 30 % of the longer
ATLAS_PNG_EDGE_PAD = 0.03     # share of the longer side added round the view (edge markers whole)


def atlas_png_view(t, drawn_hex=None):
    """``(lo_x, lo_y, hi_x, hi_y)`` of the PNG map view: the data extent (widened to the drawn
    hexagons), with the shorter side grown about its centre to at least ``ATLAS_PNG_MIN_SHARE``
    of the longer one (as the HTML map has a minimum height), then padded on every side by
    ``ATLAS_PNG_EDGE_PAD`` of the longer side so markers on the edge are drawn whole. Sides are
    compared as drawn (x times ``x_scale``)."""
    xs = t["x_scale"]
    lo_x, lo_y, hi_x, hi_y = t["minx"], t["miny"], t["maxx"], t["maxy"]
    if drawn_hex:
        # whole hexagons: widen the view to the outer corners of the drawn ones
        lo_x, hi_x = min(lo_x, drawn_hex[0]), max(hi_x, drawn_hex[2])
        lo_y, hi_y = min(lo_y, drawn_hex[1]), max(hi_y, drawn_hex[3])
    w, h = (hi_x - lo_x) * xs, hi_y - lo_y
    longer = max(w, h)
    if h < longer * ATLAS_PNG_MIN_SHARE:
        grow = (longer * ATLAS_PNG_MIN_SHARE - h) / 2.0
        lo_y, hi_y = lo_y - grow, hi_y + grow
    if w < longer * ATLAS_PNG_MIN_SHARE:
        grow = (longer * ATLAS_PNG_MIN_SHARE - w) / 2.0 / xs
        lo_x, hi_x = lo_x - grow, hi_x + grow
    pad = longer * ATLAS_PNG_EDGE_PAD
    return lo_x - pad / xs, lo_y - pad, hi_x + pad / xs, hi_y + pad


def _atlas_png_shade(classes, index):
    """PNG fill of hexagon class ``index``: the ramp colour of that class; a single class (an
    even spread) takes the second, so its one shade is still visible at alpha 0.3."""
    return _ATLAS_PNG_RAMP[1 if len(classes) == 1 else min(index, len(_ATLAS_PNG_RAMP) - 1)]


def _atlas_png_map(ax, model):
    """Context outline, density hexagons (many issues), circles by severity, hot outline.

    The legend is pinned (in figure coordinates) to the lower-left corner of the space the axes
    had when this was called; ``render_atlas_png`` then lifts the map frame above the legend,
    anchors it at the top of its cell and moves the legend right under the frame as drawn, so
    the legend lies outside the map and never hides a marker. The hexagon line of the legend
    shows one swatch per class and the class bounds. The north arrow is drawn only for
    a known coordinate system, in the margin right of the map frame."""
    try:
        from matplotlib.patches import Patch, Polygon
        from matplotlib.legend_handler import HandlerTuple
    except ImportError:   # the caller reports a missing matplotlib
        raise
    t = model["transform"]
    for layer in model["layers"]:
        if layer["extent_only"] and layer["bbox"]:
            b = layer["bbox"]
            ax.plot([b[0], b[2], b[2], b[0], b[0]], [b[1], b[1], b[3], b[3], b[1]],
                    color="#a9a8a0", linestyle="--", linewidth=1)
            continue
        for part in layer["parts"]:
            if layer["kind"] == "point":
                ax.plot([p[0] for p in part], [p[1] for p in part], ".", color="#a9a8a0",
                        markersize=2)
            else:
                ax.plot([p[0] for p in part], [p[1] for p in part], color="#c3c2b7" if
                        layer["kind"] == "polygon" else "#a9a8a0", linewidth=0.6)
    density = model["hex"]
    hot = atlas_hotspot(model)
    drawn_hex = None
    if density and density["cells"] and model["locations"] > ATLAS_DENSITY_UNDER:
        ox, oy = density["origin"]
        for (q, r), count in sorted(density["cells"].items()):
            pts = [(ox + u / t["x_scale"], oy + v) for u, v in hex_corners(q, r, density["radius"])]
            box = (min(p[0] for p in pts), min(p[1] for p in pts),
                   max(p[0] for p in pts), max(p[1] for p in pts))
            drawn_hex = box if drawn_hex is None else (
                min(drawn_hex[0], box[0]), min(drawn_hex[1], box[1]),
                max(drawn_hex[2], box[2]), max(drawn_hex[3], box[3]))
            ax.add_patch(Polygon(pts, closed=True, facecolor=_atlas_png_shade(
                model["classes"], class_index(model["classes"], count)), edgecolor="none",
                alpha=0.3, zorder=1))
    style = {UNI_ERROR: ("#d03b3b", "#ffffff"), UNI_WARNING: ("#fab219", "#0b0b0b"),
             UNI_INFO: ("none", "#2a78d6")}
    n = max(len(model["drawn"]), 1)
    base = 26.0 if n <= 300 else max(6.0, 26.0 * math.sqrt(300.0 / n))
    for severity in (UNI_INFO, UNI_WARNING, UNI_ERROR):
        pts = [m for m in model["drawn"] if m["severity"] == severity]
        if not pts:
            continue
        face, edge = style[severity]
        single = [m for m in pts if m["n"] == 1]
        multi = [m for m in pts if m["n"] > 1]
        # the count is every marker of this severity (one per location), not only the drawn
        # ones: above the marker cap the legend says how many were drawn
        full = model.get("marks_by_severity", {}).get(severity, len(pts))
        unit = " locations" if model["locations"] != model["located"] else ""
        if model.get("sampled"):
            label = "{0} ({1}{2}; {3} drawn)".format(severity.lower(), _atlas_thousands(full),
                                                     unit, _atlas_thousands(len(pts)))
        else:
            label = "{0} ({1}{2})".format(severity.lower(), full, unit)
        grown = base * (1.7 if severity == UNI_ERROR else 1.0)
        if single:
            ax.scatter([m["x"] for m in single], [m["y"] for m in single], s=grown, marker="o",
                       facecolors=face, edgecolors=edge, linewidths=0.6 if face != "none" else 1.2,
                       label=label, zorder=3)
        if multi:
            ax.scatter([m["x"] for m in multi], [m["y"] for m in multi], s=grown * 2.4, marker="o",
                       facecolors=face, edgecolors="#0b0b0b" if face != "none" else edge,
                       linewidths=1.6, label=None if single else label, zorder=3)
    if any(m["n"] > 1 for m in model["drawn"]):
        ax.scatter([], [], s=base * 2.4, marker="o", facecolors="#ffffff", edgecolors="#0b0b0b",
                   linewidths=1.6, label="dark rim: several issues at one point")
    extra = []    # legend lines that are not markers: sampling and the hexagon shading
    if drawn_hex is not None:
        # one swatch per class, light to dark, and the class bounds in words
        extra.append((tuple(Patch(facecolor=_atlas_png_shade(model["classes"], i), alpha=0.3,
                                  edgecolor="none") for i in range(len(model["classes"]))),
                      "blue hexagons: issue locations per hexagon (all rules); {0}".format(
                          atlas_class_phrase(model["classes"]))))
    if model.get("sampled"):
        extra.append((Patch(facecolor="none", edgecolor="none"),
                      "{0} of {1} markers drawn (every k-th of each rule)".format(
                          _atlas_thousands(len(model["drawn"])), _atlas_thousands(model["marks"]))))
    if hot is not None and hot["concentrated"] and density:
        ox, oy = density["origin"]
        pts = [(ox + u / t["x_scale"], oy + v) for u, v in
               hex_corners(hot["key"][0], hot["key"][1], density["radius"])]
        ax.add_patch(Polygon(pts, closed=True, fill=False, edgecolor="#0b0b0b", linewidth=1.6,
                             linestyle="--", zorder=4))
    lo_x, lo_y, hi_x, hi_y = atlas_png_view(t, drawn_hex)
    ax.set_xlim(lo_x, hi_x)
    ax.set_ylim(lo_y, hi_y)
    ax.set_aspect(1.0 / t["x_scale"])
    ax.set_xticks([])
    ax.set_yticks([])
    for side in ax.spines.values():
        side.set_color("#c3c2b7")
    if model["drawn"]:
        # the legend is drawn OUTSIDE the map frame (below it), so it never hides a marker
        handles, labels = ax.get_legend_handles_labels()
        cell = ax.get_position(original=True)
        ax.legend(handles + [h for h, _t in extra], labels + [t for _h, t in extra],
                  fontsize=9, frameon=False, borderaxespad=0.0, loc="lower left",
                  bbox_to_anchor=(cell.x0, cell.y0), bbox_transform=ax.figure.transFigure,
                  handler_map={tuple: HandlerTuple(ndivide=None, pad=0.0)})
    if model["crs"].get("unit") == "m":
        target = (hi_x - lo_x) * 0.2
        magnitude = 10 ** math.floor(math.log10(target)) if target > 0 else 1
        nice = magnitude
        for mult in (5, 2, 1):
            if mult * magnitude <= target:
                nice = mult * magnitude
                break
        x0 = lo_x + (hi_x - lo_x) * 0.03
        y0 = lo_y + (hi_y - lo_y) * 0.04
        ax.plot([x0, x0 + nice], [y0, y0], color="#52514e", linewidth=2.5, zorder=5)
        ax.text(x0, y0 + (hi_y - lo_y) * 0.012, "{0:g} km".format(nice / 1000.0)
                if nice >= 1000 else "{0:g} m".format(nice), fontsize=9, color="#52514e", zorder=5)
    if model["crs"].get("known"):
        # only when the coordinate system is known (else "north" is not known either), and in
        # the margin right of the map frame, not over the data
        ax.annotate("N", xy=(1.025, 1.0), xytext=(0.0, -34.0), xycoords="axes fraction",
                    textcoords="offset points", ha="center", va="top", fontsize=10, color="#52514e",
                    annotation_clip=False, arrowprops={"arrowstyle": "-|>", "color": "#52514e"})


def render_atlas_png(model, path, dpi=200):
    """Write a presentable picture with matplotlib: the verdict, the one-line summary, the
    atlas (outline, density hexagons, circles, scale bar, and a north arrow when the coordinate
    system is known) at the top of its column, its legend right below the map frame (with the
    hexagon class bounds), and the busiest rules.
    Returns ``(True, "")`` or ``(False, reason)``; a missing or failing matplotlib never raises.
    Only ASCII text is drawn (Arabic would not shape correctly)."""
    t = model["transform"]
    if t is None:
        return False, "there is nothing to draw (no locations and no context layer)"
    try:
        from matplotlib.figure import Figure
        from matplotlib.backends.backend_agg import FigureCanvasAgg
        from matplotlib.patches import Rectangle
    except Exception as exc:  # not installed, or a broken installation
        return False, "matplotlib is not available ({0})".format(type(exc).__name__)
    try:
        import textwrap
        score = model["score"]
        fig = Figure(figsize=(12.0, 7.2), dpi=dpi, facecolor="#f9f9f7")
        FigureCanvasAgg(fig)
        grid = fig.add_gridspec(2, 2, width_ratios=[1.6, 1.0], height_ratios=[1.0, 1.05],
                                left=0.025, right=0.985, top=0.9, bottom=0.05, wspace=0.16,
                                hspace=0.12)
        ax = fig.add_subplot(grid[:, 0])
        ax.set_facecolor("#fcfcfb")
        cell = ax.get_position(original=True)
        _atlas_png_map(ax, model)
        legend = ax.get_legend()
        if legend is not None:
            # lift the map frame above the legend: the two never overlap
            high = legend.get_window_extent(fig.canvas.get_renderer()).height / fig.bbox.height
            gap = 0.015
            ax.set_position([cell.x0, cell.y0 + high + gap, cell.width,
                             max(cell.height - high - gap, 0.2)])
            # the map sits at the TOP of its cell (a wide, short view no longer leaves the upper
            # part empty) and the legend moves with it, right under the map frame as drawn
            ax.set_anchor("N")
            ax.apply_aspect()
            drawn = ax.get_position()
            legend.set_bbox_to_anchor((cell.x0, drawn.y0 - gap - high), transform=fig.transFigure)
        fig.text(0.025, 0.955, _atlas_ascii(model["title"], 70), fontsize=16, fontweight="bold",
                 color="#0b0b0b", va="center")
        fig.text(0.985, 0.955, _atlas_ascii("Run {0} - {1}".format(model["run_id"], model["crs"]["label"]), 80),
                 fontsize=8, color="#52514e", va="center", ha="right")
        panel = fig.add_subplot(grid[0, 1])
        panel.axis("off")
        panel.set_xlim(0, 1)
        panel.set_ylim(0, 1)
        ok = score["verdict"] == "PASS"
        panel.add_patch(Rectangle((0, 0.52), 1, 0.48, facecolor="#006300" if ok else "#d03b3b",
                                  edgecolor="none"))
        panel.text(0.04, 0.82, score["verdict"], fontsize=30, fontweight="bold", color="#ffffff", va="center")
        lines = []
        if score["rate"] is not None:
            lines.append("Pass rate {0} %".format(atlas_format_compared(
                score["rate"], score["min_pass_rate"])) + (
                " (required {0} %)".format(atlas_format_typed(score["min_pass_rate"]))
                if score["min_pass_rate"] is not None else ""))
        lines.append("{0}, {1}{2}".format(
            _atlas_error_phrase(model), _atlas_count(score["warnings"], "warning"),
            ", {0} info".format(_atlas_thousands(score["infos"])) if score["infos"] else ""))
        accepted = _atlas_accepted_line(score)
        if accepted:
            lines.extend(textwrap.wrap(_atlas_ascii(accepted, 160), 46))
        panel.text(0.04, 0.62, "\n".join(lines), fontsize=10.5, color="#ffffff", va="center",
                   linespacing=1.5)
        panel.text(0.0, 0.46, "\n".join(textwrap.wrap(_atlas_ascii(atlas_summary_text(model), 400), 52)),
                   fontsize=10.5, color="#0b0b0b", va="top", linespacing=1.45)
        bars = fig.add_subplot(grid[1, 1])
        bars.set_facecolor("#f9f9f7")
        rules = [r for r in score["rules"] if r["count"]][:8][::-1]
        colours = {UNI_ERROR: "#d03b3b", UNI_WARNING: "#fab219", UNI_INFO: "#2a78d6"}
        if rules:
            bars.barh(range(len(rules)), [r["count"] for r in rules],
                      color=[colours[r["severity"]] for r in rules], height=0.65)
            bars.set_yticks(range(len(rules)))
            bars.set_yticklabels([_atlas_ascii(r["rule"], 22) for r in rules], fontsize=9)
            top = max(r["count"] for r in rules)
            for k, r in enumerate(rules):
                bars.text(r["count"] + top * 0.01, k, _atlas_thousands(r["count"]), va="center",
                          fontsize=9, color="#52514e")
            bars.set_xlim(0, top * 1.15)
        bars.set_xticks([])
        for side in ("top", "right", "bottom"):
            bars.spines[side].set_visible(False)
        bars.set_title("Issues per rule", fontsize=10, loc="left", color="#0b0b0b")
        fig.savefig(path, dpi=dpi, format="png", facecolor=fig.get_facecolor())
    except Exception as exc:
        return False, "the PNG could not be written ({0}: {1})".format(type(exc).__name__, exc)
    return True, ""


# ==========================================================================
# quality/checkpoint_accuracy_core.py
# ==========================================================================
# Positional Accuracy Report (NSSDA/ASPRS): pairing, residuals and accuracy statistics (pure Python, no arcpy).
#
# Residuals are ``feature - check point`` (data minus independent source of higher accuracy),
# the sign used by NSSDA Appendix 3-A ("x data - x check") and by ASPRS Edition 2 (7.12.1).
# Every constant of a standard is declared once in ``CPA_CONSTANTS`` with the place in the
# published text where it was read and its verification status; ``docs/standards.md`` holds
# the full trail (URL, access date, page, CONFIRMED / REPORTED).

CPA_CONFIRMED = "CONFIRMED"
CPA_REPORTED = "REPORTED"

NSSDA_NAME = "FGDC-STD-007.3-1998 (NSSDA), Appendix 3-A"
ASPRS_NAME = "ASPRS Positional Accuracy Standards for Digital Geospatial Data, Edition 2, Version 2 (2024)"

# name -> value, where it was read, status. Values are typed from the opened texts, never from memory.
CPA_CONSTANTS = {
    "NSSDA_K_XY": {
        "value": 2.4477, "status": CPA_CONFIRMED,
        "where": "FGDC-STD-007.3-1998 App. 3-A (normative) 1, Case 1, p. 3-10 (and Case 2, p. 3-11)"},
    "NSSDA_K_R_CASE1": {
        "value": 1.7308, "status": CPA_CONFIRMED,
        "where": "FGDC-STD-007.3-1998 App. 3-A 1, Case 1, p. 3-10: Accuracy_r = 1.7308 * RMSE_r "
                 "(also ASPRS Ed. 2 V2 B.7 Example 5 and the FGDC worksheet HORIZONT.XLS)"},
    "NSSDA_K_Z": {
        "value": 1.9600, "status": CPA_CONFIRMED,
        "where": "FGDC-STD-007.3-1998 App. 3-A 2, p. 3-11: Accuracy_z = 1.9600 * RMSE_z "
                 "(also ASPRS Ed. 2 V2 B.7 Example 6 and the FGDC worksheet VERTICAL.XLS)"},
    "NSSDA_RATIO_MIN": {
        "value": 0.6, "status": CPA_CONFIRMED,
        "where": "FGDC-STD-007.3-1998 App. 3-A 1, Case 2, p. 3-11: RMSEmin/RMSEmax between 0.6 and 1.0"},
    "NSSDA_MIN_POINTS": {
        "value": 20, "status": CPA_CONFIRMED,
        "where": "FGDC-STD-007.3-1998 3.2.2, p. 3-4: a minimum of 20 check points"},
    "ASPRS_MIN_POINTS": {
        "value": 30, "status": CPA_CONFIRMED,
        "where": "ASPRS Ed. 2 V2 (2024) 7.14, p. 28 and 7.16.1, p. 30: no fewer than thirty (30) checkpoints"},
    "ASPRS_MEAN_ERROR_FRACTION": {
        "value": 0.25, "status": CPA_CONFIRMED,
        "where": "ASPRS Ed. 2 V2 (2024) 7.2, p. 17: mean error less than 25% of the target RMSE (recommended)"},
    "ASPRS_BLUNDER_FACTOR": {
        "value": 3.0, "status": CPA_CONFIRMED,
        "where": "ASPRS Ed. 2 V2 (2024) 7.2, p. 17: a discrepancy above 3 times the target RMSE in any "
                 "component (X, Y or Z) is a blunder"},
}


def cpa_constant(name):
    """Value of a declared standards constant."""
    return CPA_CONSTANTS[name]["value"]


def constants_notes():
    """``(info_line, warning_or_None)`` about where the standards constants come from.

    The warning is written when any constant is not CONFIRMED against a published text, so
    a build that ships unverified constants says so in every run instead of staying silent.
    """
    unverified = sorted(n for n, c in CPA_CONSTANTS.items() if c["status"] != CPA_CONFIRMED)
    info = ("Standards constants: NSSDA from {0} and ASPRS from {1}, read from the published "
            "texts (page references in docs/standards.md).".format(NSSDA_NAME, ASPRS_NAME))
    warning = None
    if unverified:
        warning = ("Constants not primary-verified: {0} (status {1}). Check them against the "
                   "official texts before relying on the results; see docs/standards.md.".format(
                       ", ".join(unverified),
                       ", ".join(sorted(set(CPA_CONSTANTS[n]["status"] for n in unverified)))))
    return info, warning


# --------------------------------------------------------------------------
# Options
# --------------------------------------------------------------------------

STANDARD_NSSDA = "NSSDA"
STANDARD_ASPRS = "ASPRS_ED2"
STANDARD_BOTH = "BOTH"
STANDARDS = (STANDARD_NSSDA, STANDARD_ASPRS, STANDARD_BOTH)

PAIR_KEY = "KEY"
PAIR_NEAREST = "NEAREST"
PAIR_METHODS = (PAIR_KEY, PAIR_NEAREST)

SUBSET_ALL = "ALL"
SUBSET_NVA = "NVA"
SUBSET_VVA = "VVA"

# Unpaired / problem reasons
R_NULL_GEOMETRY = "NULL_GEOMETRY"
R_NULL_KEY = "NULL_KEY"
R_DUPLICATE_KEY = "DUPLICATE_KEY"
R_DUP_OTHER_SIDE = "KEY_DUPLICATED_ON_OTHER_SIDE"
R_NO_KEY_MATCH = "NO_KEY_MATCH"
R_COUNTERPART_NO_GEOM = "COUNTERPART_NO_GEOMETRY"
R_NO_FEATURE_IN_TOL = "NO_FEATURE_WITHIN_TOLERANCE"
R_NO_CHECK_IN_TOL = "NO_CHECK_POINT_WITHIN_TOLERANCE"
R_AMBIGUOUS = "AMBIGUOUS"
# Reasons that are a plain absence of a counterpart (not a data problem).
CPA_ABSENCE_REASONS = (R_NO_KEY_MATCH, R_NO_CHECK_IN_TOL)
# A check point listed in the unpaired table for any reason but these was NOT COMPARED: it has a location but
# no residual, so its error is in no statistic. Any such check point holds back every conformance sentence
# (review R12-1: in NEAREST mode the search tolerance otherwise drops exactly the largest errors). A check
# point with no geometry of its own has nothing to compare and is listed only.
CPA_NOT_COMPARED_EXEMPT = (R_NULL_GEOMETRY,)

METHOD_POINT = "POINT"
METHOD_LINE = "LINE_CENTROID"
METHOD_POLYGON = "POLYGON_CENTROID"


def accuracy_options(standard=STANDARD_BOTH, h_class_cm=None, v_class_cm=None,
                     nssda_h_limit_m=None, nssda_v_limit_m=None, h2_cm=None, v2_cm=None,
                     meters_per_unit=1.0, has_class_field=False, z_meters_per_unit=None,
                     z_unit=None, well_defined=False):
    """Validated option dict. ``None`` keeps a threshold or survey error off.

    ``meters_per_unit`` is the horizontal unit of the coordinates; ``z_meters_per_unit`` the
    unit of the elevation fields (default: the horizontal unit). ``h2_cm`` / ``v2_cm`` of ``None``
    mean "survey accuracy not given"; 0 is a legitimate value (check points without error).
    ``well_defined`` is the user's declaration that the compared points are discrete, well-defined
    points (NSSDA 3.2.2, ASPRS 7.13); without it no conformance or "tested" sentence is written.
    """
    if standard not in STANDARDS:
        raise ValueError("standard must be one of {0}".format(", ".join(STANDARDS)))
    for name, value, positive in (("h_class_cm", h_class_cm, True), ("v_class_cm", v_class_cm, True),
                                  ("nssda_h_limit_m", nssda_h_limit_m, True),
                                  ("nssda_v_limit_m", nssda_v_limit_m, True),
                                  ("h2_cm", h2_cm, False), ("v2_cm", v2_cm, False)):
        if value is not None and (value <= 0 if positive else value < 0):
            raise ValueError("{0} must be {1}".format(name, "above zero" if positive else "zero or more"))
    if not meters_per_unit or meters_per_unit <= 0:
        raise ValueError("meters_per_unit must be above zero")
    if z_meters_per_unit is not None and z_meters_per_unit <= 0:
        raise ValueError("z_meters_per_unit must be above zero")
    return {"standard": standard, "h_class_cm": h_class_cm, "v_class_cm": v_class_cm,
            "nssda_h_limit_m": nssda_h_limit_m, "nssda_v_limit_m": nssda_v_limit_m,
            "h2_cm": h2_cm, "v2_cm": v2_cm, "mpu": float(meters_per_unit),
            "zmpu": float(z_meters_per_unit) if z_meters_per_unit else float(meters_per_unit),
            "z_unit": z_unit, "has_class_field": bool(has_class_field),
            "well_defined": bool(well_defined)}


# --------------------------------------------------------------------------
# Coordinate system checks (the tool passes the plain dicts of arcio.sr_info)
# --------------------------------------------------------------------------

CPA_WEB_MERCATOR = frozenset([3857, 102100, 102113, 3395, 54004, 900913])
# Of these, World Mercator (ellipsoidal Mercator, not Web Mercator): named as such in the message (review R14).
CPA_WORLD_MERCATOR = frozenset([3395, 54004])
# World equidistant cylindrical / Plate Carree (standard parallel at the equator): east-west distances are
# stretched by 1/cos(latitude) as in Mercator, so they are refused too (review R14 minor note).
CPA_EQUIRECTANGULAR = frozenset([4087, 4088, 32662, 54001, 54002])


def crs_refusal(sr, label):
    """``(cause, fix)`` when the coordinate system of ``label`` cannot be used, else ``None``.

    Residual statistics are distances on the ground: geographic degrees, an unknown system,
    Web and World Mercator and the world equidistant cylindrical (Plate Carree) systems (whose distances
    are stretched by 1/cos(latitude)) are refused.
    """
    if not sr or str(sr.get("type") or "") == "Unknown" or (not sr.get("wkid") and
                                                          str(sr.get("name") or "").casefold() in ("unknown", "")):
        return ("The {0} have no coordinate system, so the unit of the residuals is unknown.".format(label),
                "Define the coordinate system (Define Projection) of the {0}, then run the tool again.".format(label))
    sr_type = str(sr.get("type") or "")
    wkid = sr.get("wkid")
    name = sr.get("name") or "unknown"
    if sr_type == "Geographic":
        return ("The {0} are in a geographic coordinate system ({1}): residuals would be in "
                "degrees, which are not a ground distance.".format(label, name),
                "Project the {0} to a projected coordinate system in metres or feet (for "
                "example the UTM zone of the area) with the Project tool.".format(label))
    if sr_type != "Projected" or not sr.get("meters_per_unit"):
        return ("The coordinate system of the {0} ({1}) is not a projected system with a known "
                "linear unit.".format(label, name),
                "Define a projected coordinate system for the {0} (Define Projection or Project).".format(label))
    if wkid in CPA_WEB_MERCATOR:
        kind = "World Mercator" if wkid in CPA_WORLD_MERCATOR else "Web Mercator"
        return ("The {0} are in {2} ({1}), which stretches distances by about "
                "1/cos(latitude) (about 10 % at 25 degrees), so residual statistics would be wrong.".format(
                    label, name, kind),
                "Project the {0} to a local projected system (for example UTM) with the Project tool.".format(label))
    if wkid in CPA_EQUIRECTANGULAR:
        return ("The {0} are in a world equidistant cylindrical (Plate Carree) projection ({1}), which "
                "stretches east-west distances by about 1/cos(latitude) (about 10 % at 25 degrees), so residual "
                "statistics would be wrong.".format(label, name),
                "Project the {0} to a local projected system (for example UTM) with the Project tool.".format(label))
    return None


def same_crs(a, b):
    """True when two ``sr_info`` dicts describe the same coordinate system (WKID, else name)."""
    if not a or not b:
        return False
    if a.get("wkid") and b.get("wkid"):
        return a["wkid"] == b["wkid"]
    return bool(a.get("name")) and a.get("name") == b.get("name")


def unit_label(meters_per_unit, linear_unit_name=None):
    """Readable unit of a projected system, e.g. ``"Meter"``, ``"Foot_US"``."""
    if linear_unit_name:
        return str(linear_unit_name)
    mpu = float(meters_per_unit)
    for value, name in ((1.0, "Meter"), (0.3048, "Foot"), (0.3048006096012192, "Foot_US")):
        if abs(mpu - value) < 1e-9:
            return name
    return "{0:g} m per unit".format(mpu)


_UNIT_PLURALS = (("foot", "feet"), ("meter", "meters"), ("metre", "metres"), ("yard", "yards"),
                 ("chain", "chains"), ("link", "links"), ("fathom", "fathoms"), ("mile", "miles"),
                 ("kilometer", "kilometers"), ("centimeter", "centimeters"), ("millimeter", "millimeters"),
                 ("inch", "inches"), ("rod", "rods"))


def unit_words(unit):
    """Unit name for the NSSDA sentence: ``Meter`` -> ``meters``, ``Foot`` / ``Foot_US`` -> ``feet``.

    Any other Esri linear unit name is turned into words with its qualifier: ``Foot_Clarke`` ->
    ``Clarke feet``, ``Foot_Gold_Coast`` -> ``Gold Coast feet``, ``Meter_German`` -> ``German meters``,
    ``Clarke's foot`` -> ``Clarke's feet``. A name that is not a known unit is returned unchanged.
    """
    if not unit:
        return unit
    text = str(unit)
    fixed = {"Meter": "meters", "Foot": "feet", "Foot_US": "feet"}
    if text in fixed:
        return fixed[text]
    parts = [w for w in re.split(r"[_\s]+", text.strip()) if w]
    lower = [w.lower() for w in parts]
    for single, plural in _UNIT_PLURALS:
        if single in lower:
            i = lower.index(single)
            rest = parts[:i] + parts[i + 1:]
            return " ".join(rest + [plural]) if rest else plural
        if lower and lower[-1] == plural:
            return " ".join(parts[:-1] + [plural])
    return text


# --------------------------------------------------------------------------
# Feature representative points
# --------------------------------------------------------------------------

def line_centroid(paths):
    """Length-weighted centroid of a polyline (a zero-length line gives the mean vertex)."""
    points = [p for path in paths or () for p in path]
    if not points:
        return None
    ox, oy = points[0]  # work relative to the first vertex: exact for huge coordinates
    sx = sy = total = 0.0
    for path in paths:
        for (a, b), length in zip(zip(path[:-1], path[1:]), segment_lengths(path)):
            sx += ((a[0] - ox) + (b[0] - ox)) / 2.0 * length
            sy += ((a[1] - oy) + (b[1] - oy)) / 2.0 * length
            total += length
    if total == 0.0:
        return (ox + math.fsum(p[0] - ox for p in points) / len(points),
                oy + math.fsum(p[1] - oy for p in points) / len(points))
    return (ox + sx / total, oy + sy / total)


def feature_point(kind, geom):
    """``((x, y), method)`` representing a feature, or ``(None, None)`` for a null geometry.

    Points are used as they are; a line by its length-weighted centroid; a polygon by its
    area-weighted centroid (which can fall outside a concave polygon: the method is
    written into every output row).
    """
    if geom is None:
        return None, None
    if kind == GEOM_POINT:
        return (float(geom[0]), float(geom[1])), METHOD_POINT
    if kind == GEOM_POLYLINE:
        c = line_centroid(geom)
        return (c, METHOD_LINE) if c else (None, None)
    if kind == GEOM_POLYGON:
        c = polygon_centroid(geom)
        return (c, METHOD_POLYGON) if c else (None, None)
    raise ValueError("unsupported geometry kind: {0}".format(kind))


# --------------------------------------------------------------------------
# Keys
# --------------------------------------------------------------------------

def cpa_normalise_key(value):
    """Exact key text: NFC, trimmed, invisible marks and controls removed; ``None`` when blank.

    Case, inner spaces and leading zeros are kept ("001" is not "1", "a1" is not "A1"):
    the tool never guesses that two different keys mean the same point.
    """
    text = normalize_text(value, trim=True, collapse=False, casefold=False, invisible=True,
                          controls=True, digits=False)
    return text if text else None


def _loose_key(value):
    return normalize_text(value, trim=True, collapse=True, casefold=True, invisible=True,
                          controls=True, digits=False, leading_zeros=True)


def prepare_records(rows, kind, key_field=None, z_field=None, class_field=None):
    """Plain records from ``arcio.read_features`` rows.

    Each record: ``oid``, ``key`` (exact text or ``None``), ``raw_key``, ``xy``, ``method``,
    ``z`` (float or ``None``), ``cls`` (upper case text or ``None``).
    """
    records = []
    for row in rows:
        xy, method = feature_point(kind, row["shape"])
        attrs = row["attrs"]
        raw = attrs.get(key_field) if key_field else None
        z = attrs.get(z_field) if z_field else None
        z_bad = False
        try:
            z = None if z is None else float(z)
            if z is not None and (z != z or z in (float("inf"), float("-inf"))):
                z, z_bad = None, True
        except (TypeError, ValueError):
            z = None
        cls = attrs.get(class_field) if class_field else None
        cls = normalize_text(cls, trim=True, collapse=True, casefold=False) if cls is not None else None
        records.append({"oid": row["oid"], "key": cpa_normalise_key(raw) if key_field else None,
                        "raw_key": raw, "xy": xy, "method": method, "z": z, "z_bad": z_bad,
                        "cls": cls.upper() if cls else None})
    records.sort(key=lambda r: r["oid"])
    return records


# --------------------------------------------------------------------------
# Pairing
# --------------------------------------------------------------------------

def _oid_text(oids, limit=8):
    shown = ", ".join(str(o) for o in oids[:limit])
    return shown + (" ... ({0} more)".format(len(oids) - limit) if len(oids) > limit else "")


def _unpaired(side, rec, reason, detail=""):
    return {"side": side, "oid": rec["oid"], "key": rec.get("key"), "reason": reason, "detail": detail}


SIDE_FEATURE = "FEATURE"
SIDE_CHECK = "CHECK"


def pair_by_key(features, checks):
    """Pair records with equal keys; never guess.

    A key that occurs more than once on either side pairs nothing and every row carrying it
    is listed (DUPLICATE_KEY, and KEY_DUPLICATED_ON_OTHER_SIDE for the single row facing a
    duplicated key). Rows without geometry count as carriers of their key: a key held by one
    row with geometry and one without is a duplicate, so neither copy is chosen silently, and
    the detail names the copies that have no geometry. Null keys, null geometries and keys
    without a counterpart are listed.
    Returns ``(pairs, unpaired)``: pairs are ``(feature, check)`` ordered by check OID.
    """
    pairs, unpaired = [], []
    carriers = {SIDE_FEATURE: {}, SIDE_CHECK: {}}  # key -> every record with that key, geometry or not
    for side, records in ((SIDE_FEATURE, features), (SIDE_CHECK, checks)):
        for rec in records:
            if rec["key"] is not None:
                carriers[side].setdefault(rec["key"], []).append(rec)
    duplicated = {side: set(k for k, v in carriers[side].items() if len(v) > 1)
                  for side in (SIDE_FEATURE, SIDE_CHECK)}
    usable = {SIDE_FEATURE: [], SIDE_CHECK: []}
    no_geometry = {SIDE_FEATURE: {}, SIDE_CHECK: {}}  # key -> records that carry the key but no geometry
    for side, records in ((SIDE_FEATURE, features), (SIDE_CHECK, checks)):
        for rec in records:
            if rec["key"] is not None and rec["key"] in duplicated[side]:
                continue  # listed below as DUPLICATE_KEY, with or without geometry
            if rec["xy"] is None:
                unpaired.append(_unpaired(side, rec, R_NULL_GEOMETRY, "No geometry."))
                if rec["key"] is not None:
                    no_geometry[side].setdefault(rec["key"], []).append(rec)
            elif rec["key"] is None:
                unpaired.append(_unpaired(side, rec, R_NULL_KEY, "The key is empty."))
            else:
                usable[side].append(rec)
    groups = {}
    for side in (SIDE_FEATURE, SIDE_CHECK):
        index = {}
        for rec in usable[side]:
            index.setdefault(rec["key"], []).append(rec)
        for key in duplicated[side]:
            index[key] = carriers[side][key]
        groups[side] = index
    for side in (SIDE_FEATURE, SIDE_CHECK):
        what = "features" if side == SIDE_FEATURE else "check points"
        for key in sorted(duplicated[side]):
            recs = carriers[side][key]
            oids = [r["oid"] for r in recs]
            detail = "Key '{0}' occurs {1} times in the {2} (OID {3}).".format(key, len(recs), what, _oid_text(oids))
            blank = [r["oid"] for r in recs if r["xy"] is None]
            if blank:
                detail += " OID {0} {1} no geometry; no copy was paired.".format(
                    _oid_text(blank), "has" if len(blank) == 1 else "have")
            for rec in recs:
                unpaired.append(_unpaired(side, rec, R_DUPLICATE_KEY, detail))
    for key, frecs in sorted(groups[SIDE_FEATURE].items()):
        crecs = groups[SIDE_CHECK].get(key)
        if crecs is None:
            continue
        if len(frecs) == 1 and len(crecs) == 1:
            pairs.append((frecs[0], crecs[0]))
        else:
            for side, recs, many in ((SIDE_FEATURE, frecs, crecs), (SIDE_CHECK, crecs, frecs)):
                if len(recs) == 1 and len(many) > 1:
                    what = "check points" if side == SIDE_FEATURE else "features"
                    unpaired.append(_unpaired(
                        side, recs[0], R_DUP_OTHER_SIDE,
                        "Key '{0}' occurs {1} times in the {2} (OID {3}); no pair was formed.".format(
                            key, len(many), what, _oid_text([r["oid"] for r in many]))))
    # Rows without a counterpart. A hint names a key that differs only by case, spaces or zeros.
    loose = {}
    for side in (SIDE_FEATURE, SIDE_CHECK):
        for key, recs in groups[side].items():
            loose.setdefault((side, _loose_key(key)), []).append(key)
    for side, other in ((SIDE_FEATURE, SIDE_CHECK), (SIDE_CHECK, SIDE_FEATURE)):
        for key, recs in sorted(groups[side].items()):
            if key in groups[other] or len(recs) > 1:
                continue  # a duplicated key was listed as DUPLICATE_KEY already
            what = "check point" if side == SIDE_FEATURE else "feature"
            blank = no_geometry[other].get(key)
            if blank:
                # The counterpart exists but has no geometry: say that, not "no such key".
                detail = ("The {0} with the key '{1}' (OID {2}) has no geometry, so it cannot be compared; "
                          "it is listed as {3}.".format(what, key, _oid_text([r["oid"] for r in blank]),
                                                        R_NULL_GEOMETRY))
                for rec in recs:
                    unpaired.append(_unpaired(side, rec, R_COUNTERPART_NO_GEOM, detail))
                continue
            hint = [k for k in loose.get((other, _loose_key(key)), []) if k != key]
            detail = "No {0} has the key '{1}'.".format(what, key)
            if hint:
                detail += (" Keys are matched exactly; '{0}' on the other side differs only by "
                           "case, spaces or leading zeros.".format(hint[0]))
            for rec in recs:
                unpaired.append(_unpaired(side, rec, R_NO_KEY_MATCH, detail))
    pairs.sort(key=lambda fc: fc[1]["oid"])
    return pairs, _sort_unpaired(unpaired)


def _sort_unpaired(rows):
    return sorted(rows, key=lambda r: (0 if r["side"] == SIDE_CHECK else 1, r["oid"], r["reason"]))


def tolerance_text(tolerance, unit=None, mpu=None):
    """The search tolerance (coordinate units) as text for an unpaired DETAIL.

    With ``mpu`` (metres per unit) it is given in metres, as the parameter is, followed by the
    coordinate value and unit when the unit is not the metre: ``"0.7 m (2.29659 Foot_US)"``.
    Without it the old wording ``"2.29659 map units"`` is kept.
    """
    if not mpu:
        return "{0:g} {1}".format(tolerance, unit or "map units")
    text = "{0:g} m".format(float(tolerance) * float(mpu))
    if abs(float(mpu) - 1.0) > 1e-12:
        text += " ({0:g} {1})".format(tolerance, unit or "map units")
    return text


def distance_unit_text(unit=None, mpu=None):
    """Unit word for a distance in coordinate units in a DETAIL: ``m`` on a metre system, else the unit name."""
    if mpu and abs(float(mpu) - 1.0) <= 1e-12:
        return "m"
    return unit or "map units"


def pair_nearest(features, checks, tolerance, unit=None, mpu=None):
    """Pair every check point with the one feature within ``tolerance``; report, never guess.

    A pair needs exactly one feature within the tolerance of the check point and exactly
    one check point within the tolerance of that feature. A check point with two or more
    candidate features, or a feature that two or more check points claim, is listed as
    AMBIGUOUS (with every candidate and its distance) and pairs nothing.
    Returns ``(pairs, unpaired)``; distances are in the coordinate units. ``unit`` and ``mpu``
    (metres per unit) only name the tolerance in the details (``tolerance_text``).
    """
    if not tolerance or tolerance <= 0:
        raise ValueError("tolerance must be above zero")
    tol_text = tolerance_text(tolerance, unit, mpu)
    dist_unit = distance_unit_text(unit, mpu)
    pairs, unpaired = [], []
    located = {SIDE_FEATURE: [], SIDE_CHECK: []}
    for side, records in ((SIDE_FEATURE, features), (SIDE_CHECK, checks)):
        for rec in records:
            if rec["xy"] is None:
                unpaired.append(_unpaired(side, rec, R_NULL_GEOMETRY, "No geometry."))
            else:
                located[side].append(rec)
    cell = float(tolerance)
    grid = {}
    for rec in located[SIDE_FEATURE]:
        grid.setdefault((math.floor(rec["xy"][0] / cell), math.floor(rec["xy"][1] / cell)), []).append(rec)
    cand_of_check, cand_of_feat = {}, {}
    for chk in located[SIDE_CHECK]:
        gx, gy = math.floor(chk["xy"][0] / cell), math.floor(chk["xy"][1] / cell)
        found = []
        for ix in (gx - 1, gx, gx + 1):
            for iy in (gy - 1, gy, gy + 1):
                for feat in grid.get((ix, iy), ()):
                    d = math.hypot(feat["xy"][0] - chk["xy"][0], feat["xy"][1] - chk["xy"][1])
                    if d <= tolerance:
                        found.append((d, feat))
        found.sort(key=lambda t: (t[0], t[1]["oid"]))
        cand_of_check[chk["oid"]] = found
        for d, feat in found:
            cand_of_feat.setdefault(feat["oid"], []).append((d, chk))
    ambiguous_features = {}
    for chk in located[SIDE_CHECK]:
        found = cand_of_check[chk["oid"]]
        if not found:
            unpaired.append(_unpaired(SIDE_CHECK, chk, R_NO_FEATURE_IN_TOL,
                                      "No feature within {0}.".format(tol_text)))
            continue
        feat = found[0][1]
        if len(found) > 1:
            text = "; ".join("OID {0} at {1:.6g} {2}".format(f["oid"], d, dist_unit) for d, f in found[:8])
            unpaired.append(_unpaired(SIDE_CHECK, chk, R_AMBIGUOUS,
                                      "{0} features within {1}: {2}. No pair was formed; "
                                      "use a smaller tolerance or pair by key.".format(len(found), tol_text, text)))
            for d, f in found:
                ambiguous_features.setdefault(f["oid"], (f, []))[1].append(chk["oid"])
            continue
        claimants = cand_of_feat[feat["oid"]]
        if len(claimants) > 1:
            unpaired.append(_unpaired(SIDE_CHECK, chk, R_AMBIGUOUS,
                                      "Feature OID {0} is the only feature in range but {1} check points "
                                      "claim it (OID {2}). No pair was formed.".format(
                                          feat["oid"], len(claimants),
                                          _oid_text(sorted(c["oid"] for _d, c in claimants)))))
            ambiguous_features.setdefault(feat["oid"], (feat, []))[1].append(chk["oid"])
            continue
        pairs.append((feat, chk))
    paired_feats = set(f["oid"] for f, _c in pairs)
    for oid, (feat, chk_oids) in sorted(ambiguous_features.items()):
        unpaired.append(_unpaired(SIDE_FEATURE, feat, R_AMBIGUOUS,
                                  "In range of check point(s) OID {0} whose pairing is ambiguous.".format(
                                      _oid_text(sorted(set(chk_oids))))))
    listed = set(ambiguous_features)
    for feat in located[SIDE_FEATURE]:
        if feat["oid"] in paired_feats or feat["oid"] in listed:
            continue
        unpaired.append(_unpaired(SIDE_FEATURE, feat, R_NO_CHECK_IN_TOL,
                                  "No check point within {0}.".format(tol_text)))
    pairs.sort(key=lambda fc: fc[1]["oid"])
    return pairs, _sort_unpaired(unpaired)


# --------------------------------------------------------------------------
# Residuals
# --------------------------------------------------------------------------

# A NEAREST tolerance above this fraction of the extent of the inputs gets a warning (the tool's own rule,
# INFERENCE): the pairing then compares most check points with most features (slow) and pairs almost nothing.
NEAREST_TOL_EXTENT_FRACTION = 0.10


def tolerance_extent_note(features, checks, tolerance, unit="map units", mpu=1.0, ambiguous=None):
    """Warning text when a NEAREST ``tolerance`` (coordinate units) spans much of the extent, else ``None``.

    The extent is the larger side of the bounding box of the check points (of the check points and the
    features together when the check points alone have no extent; the text then says so). Above
    ``NEAREST_TOL_EXTENT_FRACTION`` of it, nearly every check point has several features in range,
    so the run is slow (every check point is compared with most features) and the pairs end up AMBIGUOUS.
    ``ambiguous`` is the number of check points the run listed as AMBIGUOUS (None: not yet paired); with 0
    the text does not claim that any were.
    """
    if not tolerance or tolerance <= 0:
        return None

    def side(recs):
        xy = [r["xy"] for r in recs if r.get("xy") is not None]
        if len(xy) < 2:
            return 0.0
        xs = [p[0] for p in xy]
        ys = [p[1] for p in xy]
        return max(max(xs) - min(xs), max(ys) - min(ys))

    extent = side(checks)
    what = "the check points"
    if extent <= 0:
        extent = side(list(checks) + list(features))
        what = "the check points and the features together"
    if extent <= 0:
        return None
    share = float(tolerance) / extent
    if share <= NEAREST_TOL_EXTENT_FRACTION:
        return None
    if ambiguous is None or ambiguous:
        listed = ("lists those check points as AMBIGUOUS instead of pairing them{0}".format(
            "" if ambiguous is None else " ({0} in this run)".format(ambiguous)))
    else:
        listed = "can list check points as AMBIGUOUS instead of pairing them (none in this run)"
    return ("The search tolerance ({0:g} m) is {1:.0f} % of the extent of {4} ({2:.6g} {3}). "
            "With such a tolerance most check points have several features in range: NEAREST then compares "
            "each check point with most of the features (slow on large layers) and {5}. Use a tolerance "
            "a little larger than the largest error you need to find (at least 3 times the horizontal class, "
            "so that a blunder is still paired), or pair by KEY.".format(
                float(tolerance) * float(mpu), 100.0 * share, extent, unit, what, listed))


def not_compared_checks(unpaired):
    """The unpaired check points that were NOT COMPARED (every check point row whose reason is not in
    ``CPA_NOT_COMPARED_EXEMPT``), in the order of ``unpaired``."""
    return [u for u in unpaired if u["side"] == SIDE_CHECK and u["reason"] not in CPA_NOT_COMPARED_EXEMPT]


def nearest_feature_within(features, point, radius):
    """``(distance, feature)`` of the nearest located feature within ``radius`` of ``point``, else None.

    Ties go to the lower OID. Brute force over the features; called only for the check points that NEAREST
    left with no feature within the tolerance (``nearest_beyond_tolerance``)."""
    best = None
    for feat in features:
        if feat.get("xy") is None:
            continue
        d = math.hypot(feat["xy"][0] - point[0], feat["xy"][1] - point[1])
        if d <= radius and (best is None or (d, feat["oid"]) < (best[0], best[1]["oid"])):
            best = (d, feat)
    return best


def nearest_beyond_tolerance(features, checks, unpaired, radius, grid_cell=None):
    """For each NO_FEATURE_WITHIN_TOLERANCE check point: ``{check oid: (distance, feature) or None}`` for the
    nearest feature within ``radius`` (coordinate units; the tool uses 3 times the horizontal class).

    A grid of cell ``radius`` keeps it fast on large feature layers."""
    wanted = set(u["oid"] for u in unpaired if u["side"] == SIDE_CHECK and u["reason"] == R_NO_FEATURE_IN_TOL)
    out = {}
    if not wanted or not radius or radius <= 0:
        return out
    cell = float(grid_cell or radius)
    grid = {}
    for feat in features:
        if feat.get("xy") is not None:
            grid.setdefault((math.floor(feat["xy"][0] / cell), math.floor(feat["xy"][1] / cell)), []).append(feat)
    reach = int(math.ceil(radius / cell))
    for chk in checks:
        if chk["oid"] not in wanted or chk.get("xy") is None:
            continue
        gx, gy = math.floor(chk["xy"][0] / cell), math.floor(chk["xy"][1] / cell)
        near = []
        for ix in range(gx - reach, gx + reach + 1):
            for iy in range(gy - reach, gy + reach + 1):
                near.extend(grid.get((ix, iy), ()))
        out[chk["oid"]] = nearest_feature_within(near, chk["xy"], radius)
    return out


def not_compared_text(not_compared, method=None, near=None, radius_m=None, h_class_cm=None, declared=False,
                      standard=None):
    """The statement about the check points that were NOT COMPARED, or None when there are none.

    ``near`` is ``nearest_beyond_tolerance`` (NEAREST with a horizontal class), ``radius_m`` its radius in
    metres. ``declared``: the conformance sentences would otherwise be written, so the text says they are
    not. ``standard`` (the Standard parameter; ``None`` = both) names only the sentences that run could
    write (review R14 minor note)."""
    if not not_compared:
        return None
    counts = {}
    for u in not_compared:
        counts[u["reason"]] = counts.get(u["reason"], 0) + 1
    reasons = ", ".join("{0} x {1}".format(r, c) for r, c in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])))
    oids = sorted(u["oid"] for u in not_compared)
    text = ("{0} check point(s) were not compared with a feature ({1}; OID {2}; see the unpaired table). They are "
            "left out of every statistic, so their errors, which may be the largest, are in no RMSE, NSSDA value "
            "or blunder count.".format(len(not_compared), reasons, _oid_text(oids)))
    beyond = counts.get(R_NO_FEATURE_IN_TOL, 0)
    if method == PAIR_NEAREST and beyond:
        if near is not None and radius_m:
            within = sorted(oid for oid, hit in near.items() if hit is not None)
            text += (" Of the {0} with no feature within the search tolerance, {1} {2} a feature within 3 times "
                     "the {3:g}(cm) horizontal class ({4:g} m){5} and {6} no feature that close (an error above "
                     "3 times the class is an ASPRS 7.2 blunder, or the feature is missing). The search tolerance "
                     "is not a blunder filter: use one larger than the largest error to find, or pair by "
                     "KEY.".format(beyond, len(within), "has" if len(within) == 1 else "have", h_class_cm,
                                   radius_m, " (OID {0})".format(_oid_text(within)) if within else "",
                                   beyond - len(within)))
        else:
            text += (" {0} of them have no feature within the search tolerance; the tolerance is not a blunder "
                     "filter: use one larger than the largest error to find, or pair by KEY.".format(beyond))
    if declared:
        if standard == STANDARD_ASPRS:
            text += " No ASPRS 7.16.1 conformance sentence is written while any check point is not compared."
        elif standard == STANDARD_NSSDA:
            text += (" No NSSDA 'Tested ... at 95% confidence level' sentence is written while any check point "
                     "is not compared.")
        else:
            text += (" No ASPRS 7.16.1 conformance sentence and no NSSDA 'Tested ... at 95% confidence level' "
                     "sentence is written while any check point is not compared.")
    return text


def azimuth_deg(dx, dy):
    """Direction of a displacement, degrees clockwise from grid north in [0, 360); ``None`` for none."""
    if dx == 0.0 and dy == 0.0:
        return None
    return math.degrees(math.atan2(dx, dy)) % 360.0


def residual_rows(pairs, opts):
    """One residual per pair: data minus check point, with blunder flags.

    A blunder (ASPRS Ed. 2 7.2, p. 17: "a discrepancy ... that exceeds 3 times the target RMSE threshold in
    any component of the coordinate (X, Y, or Z)") is flagged only when the matching class is given. Edition 2
    sets a horizontal target only as RMSEH (7.3), so the tool compares |DX| and |DY| each with 3 x the RMSEH
    class (INFERENCE: the literal reading; a component target of RMSEH / 1.414 would be stricter) and |DZ|
    with 3 x the RMSEV class (see docs/standards.md).
    """
    mpu = opts["mpu"]
    limit_h = cpa_constant("ASPRS_BLUNDER_FACTOR") * opts["h_class_cm"] / 100.0 / mpu \
        if opts["h_class_cm"] else None
    limit_v = cpa_constant("ASPRS_BLUNDER_FACTOR") * opts["v_class_cm"] / 100.0 / opts["zmpu"] \
        if opts["v_class_cm"] else None
    rows = []
    for number, (feat, chk) in enumerate(pairs, start=1):
        dx = feat["xy"][0] - chk["xy"][0]
        dy = feat["xy"][1] - chk["xy"][1]
        dz = feat["z"] - chk["z"] if feat["z"] is not None and chk["z"] is not None else None
        flags = []
        if limit_h is not None and (abs(dx) > limit_h or abs(dy) > limit_h):
            flags.append("BLUNDER_XY")
        # ASPRS 7.2 measures a blunder against the target RMSE; the VVA has no target (7.4), so it is
        # not applied to check points classed VVA (INFERENCE, docs/standards.md).
        if limit_v is not None and dz is not None and abs(dz) > limit_v and chk["cls"] != SUBSET_VVA:
            flags.append("BLUNDER_Z")
        if feat["key"] is not None and chk["key"] is not None and feat["key"] != chk["key"]:
            flags.append("KEY_DIFFERS")
        rows.append({
            "pair_id": number, "key": feat["key"] if feat["key"] is not None else chk["key"],
            "feat_oid": feat["oid"], "chk_oid": chk["oid"],
            "x_feat": feat["xy"][0], "y_feat": feat["xy"][1], "x_chk": chk["xy"][0], "y_chk": chk["xy"][1],
            "dx": dx, "dy": dy, "dr": math.hypot(dx, dy), "azimuth": azimuth_deg(dx, dy),
            "z_feat": feat["z"], "z_chk": chk["z"], "dz": dz,
            "terrain": chk["cls"], "method": feat["method"], "flags": ";".join(flags)})
    return rows


def key_differs_rows(rows):
    """Residual rows flagged ``KEY_DIFFERS`` (NEAREST pairs whose two keys are not equal).

    The keys are compared exactly as KEY mode compares them (``cpa_normalise_key`` on both sides),
    so a pair flagged here would not have been formed by KEY. The pairs stay in every statistic;
    the tool warns about them and the report counts them.
    """
    return [r for r in rows if "KEY_DIFFERS" in (r.get("flags") or "").split(";")]


def key_differs_text(rows, limit=20):
    """One warning sentence for the ``KEY_DIFFERS`` rows, or ``None`` when there are none."""
    bad = key_differs_rows(rows)
    if not bad:
        return None
    shown = ", ".join("{0} (check point OID {1})".format(r["pair_id"], r["chk_oid"]) for r in bad[:limit])
    if len(bad) > limit:
        shown += " ... ({0} more)".format(len(bad) - limit)
    return ("{0} pair(s) have different keys on the two sides (flag KEY_DIFFERS): pair {1}. They are "
            "paired by distance and counted in every statistic. Check the labels, or pair by KEY to "
            "use only pairs whose keys are equal.".format(len(bad), shown))


# --------------------------------------------------------------------------
# Statistics
# --------------------------------------------------------------------------

def _mean(values):
    return math.fsum(values) / len(values)


def rmse(values):
    """Root mean square of the values (divisor n, as NSSDA and ASPRS define RMSE)."""
    return math.sqrt(math.fsum(v * v for v in values) / len(values))


def median(values):
    ordered = sorted(values)
    n = len(ordered)
    mid = n // 2
    return ordered[mid] if n % 2 else (ordered[mid - 1] + ordered[mid]) / 2.0


def sample_sd(values):
    """Sample standard deviation (divisor n - 1); ``None`` for fewer than two values."""
    n = len(values)
    if n < 2:
        return None
    m = _mean(values)
    return math.sqrt(math.fsum((v - m) ** 2 for v in values) / (n - 1))


# NSSDA ratio boundary: the standard includes 0.6 ("between 0.6 and 1.0"). The ratio is computed from
# differences of large coordinates, whose float error is up to about 1e-9 m at UTM northings; relative to
# centimetre residuals that is up to about 1e-7 of the ratio. A relative margin of 1e-6 (far below the
# printed 0.001) keeps a ratio that is 0.6 in decimal on the defined side (the tool's design, INFERENCE).
NSSDA_RATIO_REL = 1e-6


def ratio_below_min(ratio):
    """True when RMSEmin/RMSEmax is below the NSSDA 0.6 limit beyond the float margin ``NSSDA_RATIO_REL``."""
    limit = cpa_constant("NSSDA_RATIO_MIN")
    return ratio < limit * (1.0 - NSSDA_RATIO_REL)


def ratio_text(ratio):
    """The ratio as printed in a message: 3 decimals, or as many as it takes not to print a ratio that is
    below 0.6 as ``0.600`` (up to 9 decimals)."""
    if ratio is None:
        return "n/a"
    limit = cpa_constant("NSSDA_RATIO_MIN")
    for places in range(3, 10):
        text = "{0:.{1}f}".format(ratio, places)
        if not ratio_below_min(ratio) or float(text) < limit:
            return text
    return "{0:.9f}".format(ratio)


def nssda_horizontal(rmse_x, rmse_y):
    """``(accuracy_95, case1_value, ratio, status)`` of NSSDA Appendix 3-A, section 1.

    ``case1_value`` = 1.7308 * RMSE_r (valid if RMSEx = RMSEy). ``accuracy_95`` is the
    Case 2 approximation 2.4477 * 0.5 * (RMSEx + RMSEy), which equals Case 1 when RMSEx =
    RMSEy, and is defined only for RMSEmin/RMSEmax between 0.6 and 1.0; outside that range
    the standard gives no formula, so ``accuracy_95`` is ``None`` (status ``RATIO_BELOW_0.6``).
    The 0.6 boundary is compared with the margin of ``ratio_below_min``.
    """
    r_min, r_max = min(rmse_x, rmse_y), max(rmse_x, rmse_y)
    case1 = cpa_constant("NSSDA_K_R_CASE1") * math.hypot(rmse_x, rmse_y)
    if r_max == 0.0:
        return 0.0, 0.0, 1.0, "OK"
    ratio = r_min / r_max
    if ratio_below_min(ratio):
        return None, case1, ratio, "RATIO_BELOW_0.6"
    return cpa_constant("NSSDA_K_XY") * 0.5 * (rmse_x + rmse_y), case1, ratio, "OK"


# Self-comparison guard (the tool's design, INFERENCE, not a number of either standard): when every
# residual of a component is below 1 mm the data set was almost certainly compared with itself or with
# a copy of the check points (a projection round trip or a copied layer leaves float noise, not exact
# zeros), so no "tested" or conformance sentence is written for that component.
SELF_COMPARE_M = 0.001

# Pass/fail boundary: a value equal to the limit passes. The margin is far below the printed precision
# (0.01 cm) and above the float error of differences of large coordinates (UTM, about 1e-8 cm).
BOUNDARY_ABS_CM = 1e-6
BOUNDARY_REL = 1e-9


def within_limit(value, limit, abs_tol=BOUNDARY_ABS_CM):
    """``value <= limit`` with a float margin (``abs_tol`` in the unit of the values, plus 1e-9 relative)."""
    return value <= limit + max(abs_tol, abs(limit) * BOUNDARY_REL)


def self_comparison(row, opts):
    """``(horizontal, vertical)``: True when every residual of that component is below ``SELF_COMPARE_M``.

    ``row`` is a summary row; the vertical test uses the largest absolute DZ of the subset.
    """
    if not row or not row.get("N_PAIRS"):
        return False, False
    h = row.get("MAX_DR") is not None and row["MAX_DR"] * opts["mpu"] < SELF_COMPARE_M
    v = (bool(row.get("N_WITH_Z")) and row.get("_MAX_ADZ") is not None
         and row["_MAX_ADZ"] * opts["zmpu"] < SELF_COMPARE_M)
    return h, v


def self_comparison_text(row, opts, component):
    """``"exactly zero"`` or ``"below 1 mm (largest 0.0006 mm)"`` for the component ("horizontal" / "vertical")."""
    if component == "horizontal":
        value, mpu = row.get("MAX_DR"), opts["mpu"]
    else:
        value, mpu = row.get("_MAX_ADZ"), opts["zmpu"]
    if not value:
        return "exactly zero"
    return "below {0:g} mm (largest {1:.4f} mm)".format(SELF_COMPARE_M * 1000.0, value * mpu * 1000.0)


def invalid_z_note(features, checks):
    """Warning text when elevation values were NaN or infinite (treated as missing), else None."""
    parts = []
    for label, recs in (("feature", features), ("check point", checks)):
        oids = sorted(r["oid"] for r in recs if r.get("z_bad"))
        if oids:
            parts.append("{0} {1}(s) (OID {2})".format(len(oids), label, _oid_text(oids)))
    if not parts:
        return None
    return ("Elevation values that are NaN or infinite were treated as missing (no elevation): {0}. "
            "Check the elevation fields.".format("; ".join(parts)))


def _count_flag(n):
    if n is None or n == 0:
        return "NO_DATA"
    if n < cpa_constant("NSSDA_MIN_POINTS"):
        return "N_LT_20"
    if n < cpa_constant("ASPRS_MIN_POINTS"):
        return "N_LT_30"
    return "OK"


def _result(passed, low_n, blunders, fit_only=False):
    """Result word. ``fit_only``: the survey accuracy of the check points was not given, so a pass is
    only a pass of the fit to the check points (FIT_PASS); a FAIL stays FAIL (adding the survey
    accuracy can only make it larger)."""
    text = ("FIT_PASS" if fit_only else "PASS") if passed else "FAIL"
    if low_n:
        text += "_LOW_N"
    if blunders:
        text += "_BLUNDERS"
    return text


SUMMARY_FIELDS = (
    "SUBSET", "N_PAIRS", "N_WITH_Z", "N_NO_CHK", "MEAN_DX", "MEAN_DY", "MEAN_DZ", "SD_DX", "SD_DY", "SD_DZ",
    "MIN_DR", "MAX_DR", "MED_DR", "RMSE_X", "RMSE_Y", "RMSE_R", "RMSE_Z", "XY_RATIO",
    "NSSDA_H95", "NSSDA_H_C1", "NSSDA_V95", "NSSDA_HRES", "NSSDA_VRES",
    "RMSEH_CM", "RMSEV_CM", "RMSE3D_CM", "H_CLASS_CM", "V_CLASS_CM", "H_RESULT", "V_RESULT",
    "N_FLAG", "NZ_FLAG", "BLUNDERS", "BIAS_FLAG", "UNIT", "MPU", "Z_UNIT", "CRS_NAME", "CRS_WKID", "NOTES")


def bias_components(subset, opts):
    """``(horizontal, vertical)``: whether the mean-error test (ASPRS 7.2) applies to that component of
    the row ``subset``. Only the row that carries a component's verdict is tested: horizontal on ALL;
    vertical on NVA with a terrain class field, on ALL without one; never on VVA."""
    horizontal = subset == SUBSET_ALL
    if opts["has_class_field"]:
        vertical = subset == SUBSET_NVA
    else:
        vertical = subset == SUBSET_ALL
    return horizontal, vertical


def subset_statistics(subset, rows, opts, crs, extra_notes=(), no_check=None):
    """One summary row (a dict keyed by ``SUMMARY_FIELDS``) for the residual rows of a subset.

    ``no_check`` (ALL row only) is the number of features that have no check point (a plain
    absence, not a data problem); it is written to ``N_NO_CHK`` whether or not those features are
    listed in the unpaired table. ``crs`` is ``{"name", "wkid", "unit", "mpu"}``. Distances are in the coordinate units
    of the data (NSSDA 3.2.3: report in ground units of the dataset); the ASPRS columns
    are in centimetres. Values the standard does not define for the data are ``None``.
    """
    mpu, zmpu = opts["mpu"], opts["zmpu"]
    want_nssda = opts["standard"] in (STANDARD_NSSDA, STANDARD_BOTH)
    want_asprs = opts["standard"] in (STANDARD_ASPRS, STANDARD_BOTH)
    out = dict((name, None) for name in SUMMARY_FIELDS)
    out.update({"SUBSET": subset, "UNIT": crs["unit"], "MPU": crs["mpu"],
                "Z_UNIT": opts["z_unit"] or crs["unit"], "CRS_NAME": crs["name"], "CRS_WKID": crs["wkid"]})
    notes = []
    n = len(rows)
    zs = [r["dz"] for r in rows if r["dz"] is not None]
    out["N_PAIRS"], out["N_WITH_Z"] = n, len(zs)
    if subset == SUBSET_ALL:
        out["N_NO_CHK"] = no_check
    out["N_FLAG"] = _count_flag(n)
    out["NZ_FLAG"] = _count_flag(len(zs)) if zs else "NO_DATA"
    blunders = sum(1 for r in rows if "BLUNDER" in r["flags"])
    out["BLUNDERS"] = blunders
    if n == 0:
        out["H_RESULT"] = out["V_RESULT"] = out["NSSDA_HRES"] = out["NSSDA_VRES"] = "NO_DATA"
        out["BIAS_FLAG"] = "NO_DATA"
        if extra_notes:
            out["NOTES"] = " ".join(extra_notes)
        return out
    dxs = [r["dx"] for r in rows]
    dys = [r["dy"] for r in rows]
    drs = [r["dr"] for r in rows]
    out["MEAN_DX"], out["MEAN_DY"] = _mean(dxs), _mean(dys)
    out["SD_DX"], out["SD_DY"] = sample_sd(dxs), sample_sd(dys)
    out["MIN_DR"], out["MAX_DR"], out["MED_DR"] = min(drs), max(drs), median(drs)
    out["RMSE_X"], out["RMSE_Y"] = rmse(dxs), rmse(dys)
    out["RMSE_R"] = math.hypot(out["RMSE_X"], out["RMSE_Y"])
    if zs:
        out["MEAN_DZ"], out["SD_DZ"], out["RMSE_Z"] = _mean(zs), sample_sd(zs), rmse(zs)
        out["_MAX_ADZ"] = max(abs(v) for v in zs)   # not a table field: used by self_comparison()
    h_acc, case1, ratio, h_status = nssda_horizontal(out["RMSE_X"], out["RMSE_Y"])
    out["XY_RATIO"] = ratio
    if want_nssda:
        out["NSSDA_H95"], out["NSSDA_H_C1"] = h_acc, case1
        if h_status != "OK":
            notes.append("NSSDA horizontal 95 % not defined: RMSEmin/RMSEmax = {0} is below {1} "
                         "(Case 2 of Appendix 3-A needs 0.6 to 1.0); NSSDA_H_C1 is Case 1 (RMSEx = "
                         "RMSEy assumed) for reference only.".format(ratio_text(ratio), cpa_constant("NSSDA_RATIO_MIN")))
        if zs:
            out["NSSDA_V95"] = cpa_constant("NSSDA_K_Z") * out["RMSE_Z"]
        if subset != SUBSET_ALL:
            # NSSDA tests the whole set of check points; the NVA / VVA split is an ASPRS notion (the VVA has
            # no pass/fail there), so the claimed-accuracy words are given for the ALL row only.
            out["NSSDA_HRES"] = out["NSSDA_VRES"] = "NOT_ASSESSED"
        elif opts["nssda_h_limit_m"] is None:
            out["NSSDA_HRES"] = "NO_LIMIT_GIVEN"
        elif h_acc is None:
            out["NSSDA_HRES"] = "NOT_DEFINED"
        else:
            out["NSSDA_HRES"] = _result(within_limit(h_acc * mpu, opts["nssda_h_limit_m"], 1e-8),
                                        n < cpa_constant("NSSDA_MIN_POINTS"), 0)
        if subset != SUBSET_ALL:
            pass
        elif not zs:
            out["NSSDA_VRES"] = "NO_Z_DATA"
        elif opts["nssda_v_limit_m"] is None:
            out["NSSDA_VRES"] = "NO_LIMIT_GIVEN"
        else:
            out["NSSDA_VRES"] = _result(within_limit(out["NSSDA_V95"] * zmpu, opts["nssda_v_limit_m"], 1e-8),
                                        len(zs) < cpa_constant("NSSDA_MIN_POINTS"), 0)
    else:
        out["NSSDA_HRES"] = out["NSSDA_VRES"] = "NOT_REQUESTED"
    h2 = (opts["h2_cm"] / 100.0 / mpu) if opts["h2_cm"] is not None else 0.0
    v2 = (opts["v2_cm"] / 100.0 / zmpu) if opts["v2_cm"] is not None else 0.0
    rmse_h = math.hypot(out["RMSE_R"], h2)
    rmse_v = math.hypot(out["RMSE_Z"], v2) if zs else None
    if want_asprs:
        out["RMSEH_CM"] = rmse_h * mpu * 100.0
        if zs:
            out["RMSEV_CM"] = rmse_v * zmpu * 100.0
            if len(zs) == n:
                out["RMSE3D_CM"] = math.hypot(rmse_h * mpu, rmse_v * zmpu) * 100.0
            else:
                notes.append("RMSE3D not computed: {0} of {1} pairs have no Z.".format(n - len(zs), n))
        out["H_CLASS_CM"], out["V_CLASS_CM"] = opts["h_class_cm"], opts["v_class_cm"]
        if opts["h2_cm"] is None:
            notes.append("RMSEH is the fit to the check points only (RMSEH1): the survey accuracy of the "
                         "check points (RMSEH2) was not given, and ASPRS Ed. 2 7.12.2 adds it. A pass is "
                         "reported as FIT_PASS, not PASS.")
        if zs and opts["v2_cm"] is None:
            notes.append("RMSEV is the fit to the check points only (RMSEV1): RMSEV2 was not given. A pass "
                         "is reported as FIT_PASS, not PASS.")
        low_h = n < cpa_constant("ASPRS_MIN_POINTS")
        low_v = len(zs) < cpa_constant("ASPRS_MIN_POINTS")
        if subset == SUBSET_ALL:
            if opts["h_class_cm"] is None:
                out["H_RESULT"] = "NO_CLASS_GIVEN"
            else:
                out["H_RESULT"] = _result(within_limit(out["RMSEH_CM"], opts["h_class_cm"]), low_h,
                                          any("BLUNDER_XY" in r["flags"] for r in rows),
                                          fit_only=opts["h2_cm"] is None)
        else:
            out["H_RESULT"] = "NOT_ASSESSED"
        if not zs:
            out["V_RESULT"] = "NO_Z_DATA"
        elif subset == SUBSET_VVA:
            out["V_RESULT"] = "REPORT_ONLY"
            notes.append("VVA has no pass/fail threshold in ASPRS Ed. 2 (7.4): reported as found.")
        elif subset == SUBSET_ALL and opts["has_class_field"]:
            if any(r["terrain"] == SUBSET_NVA and r["dz"] is not None for r in rows):
                out["V_RESULT"] = "SEE_NVA_AND_VVA"
            else:
                out["V_RESULT"] = "NO_NVA_POINTS"
                notes.append("No pair with an elevation is classed NVA, so there is no vertical verdict: "
                             "ASPRS Ed. 2 holds the NVA to the class.")
        elif opts["v_class_cm"] is None:
            out["V_RESULT"] = "NO_CLASS_GIVEN"
        else:
            out["V_RESULT"] = _result(within_limit(out["RMSEV_CM"], opts["v_class_cm"]), low_v,
                                      any("BLUNDER_Z" in r["flags"] for r in rows),
                                      fit_only=opts["v2_cm"] is None)
            if subset == SUBSET_ALL:
                notes.append("No terrain class field: RMSEV is computed over all check points and compared "
                             "with the class; no NVA / VVA split was made.")
    else:
        out["H_RESULT"] = out["V_RESULT"] = "NOT_REQUESTED"
    # Mean error versus the target (ASPRS 7.2: recommended below 25 % of the target RMSE). Horizontal: the
    # length of the mean displacement, hypot(MEAN_DX, MEAN_DY), against 25 % of the RMSEH class (INFERENCE: the
    # glossary defines mean error per dimension; Edition 2 has only the RMSEH target, see docs/standards.md). A row is
    # tested only for the component it carries the verdict of (bias_components): the horizontal one on the
    # ALL row; the vertical one on the NVA row with a terrain class field (the VVA has no target, 7.4) and
    # on the ALL row without one. So every bias flag the tool reports is one the run-level hold acts on.
    bias = []
    frac = cpa_constant("ASPRS_MEAN_ERROR_FRACTION")
    h_tested, v_tested = bias_components(subset, opts)
    if opts["h_class_cm"] and h_tested:
        if math.hypot(out["MEAN_DX"], out["MEAN_DY"]) * mpu > frac * opts["h_class_cm"] / 100.0:
            bias.append("MEAN_H_GT_25PCT")
    if opts["v_class_cm"] and zs and v_tested:
        if abs(out["MEAN_DZ"]) * zmpu > frac * opts["v_class_cm"] / 100.0:
            bias.append("MEAN_Z_GT_25PCT")
    if not opts["h_class_cm"] and not opts["v_class_cm"]:
        out["BIAS_FLAG"] = "NO_CLASS_GIVEN"
    elif not ((opts["h_class_cm"] and h_tested) or (opts["v_class_cm"] and zs and v_tested)):
        # review R14-1: a vertical class was given, this row would carry its test, but no pair has an
        # elevation (and no horizontal test is made here): say so instead of "no class given".
        if opts["v_class_cm"] and v_tested and not zs and not (opts["h_class_cm"] and h_tested):
            out["BIAS_FLAG"] = "NO_Z_DATA"
        else:
            out["BIAS_FLAG"] = "NOT_ASSESSED"
    else:
        out["BIAS_FLAG"] = ";".join(bias) if bias else "OK"
    if subset == SUBSET_ALL and opts["has_class_field"] and opts["v_class_cm"] and zs:
        notes.append("The vertical mean error is tested against the class on the NVA row only (the VVA has no "
                     "class, ASPRS 7.4); MEAN_DZ here is over all pairs with elevations.")
    if blunders:
        notes.append("{0} pair(s) exceed 3 times the class in a component (ASPRS 7.2 blunder; the rule is "
                     "the tool's reading, see docs/standards.md): investigate before using the "
                     "result.".format(blunders))
    self_h, self_v = self_comparison(out, opts)
    if self_h:
        notes.append("Every horizontal residual is {0}: the data set was probably tested against "
                     "itself or a copy of the check points. No conformance sentence is written.".format(
                         self_comparison_text(out, opts, "horizontal")))
    if self_v:
        notes.append("Every vertical residual is {0}: check that the elevations do not come from "
                     "the same source. No vertical conformance sentence is written.".format(
                         self_comparison_text(out, opts, "vertical")))
    if extra_notes:
        notes.extend(extra_notes)
    out["NOTES"] = " ".join(notes)
    return out


def summarise(rows, opts, crs, no_check=None, all_notes=()):
    """Summary rows: ALL, plus NVA and VVA when a terrain class field was given.

    Pairs whose class is neither NVA nor VVA stay in ALL only; the count is returned. ``all_notes`` are
    added to the NOTES of the ALL row (the check points that were not compared).
    Returns ``(summary_rows, unclassified_count)``.
    """
    extra = ()
    unclassified = 0
    if opts["has_class_field"]:
        values = unrecognised_terrain(rows)
        unclassified = sum(c for _v, c in values)
        if values:
            extra = ("{0} pair(s) have a terrain class that is not NVA or VVA ({1}); they are in ALL only. "
                     "Recognised values are NVA and VVA (any letter case, spaces at the ends trimmed)."
                     .format(unclassified, terrain_values_text(values)),)
    summary = [subset_statistics(SUBSET_ALL, rows, opts, crs, tuple(extra) + tuple(all_notes), no_check=no_check)]
    if opts["has_class_field"]:
        for subset in (SUBSET_NVA, SUBSET_VVA):
            summary.append(subset_statistics(subset, [r for r in rows if r["terrain"] == subset], opts, crs))
    return summary, unclassified


def unrecognised_terrain(rows):
    """``[(value, count)]`` of the terrain values that are neither NVA nor VVA, most frequent first.

    An empty class is shown as ``<empty>``.
    """
    counts = {}
    for r in rows:
        if r["terrain"] not in (SUBSET_NVA, SUBSET_VVA):
            key = r["terrain"] if r["terrain"] else "<empty>"
            counts[key] = counts.get(key, 0) + 1
    return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))


def terrain_values_text(values, limit=5):
    """Readable list of the first ``limit`` unrecognised terrain values with their counts."""
    shown = ", ".join("'{0}' x {1}".format(v, c) for v, c in values[:limit])
    return shown + (", ... ({0} more values)".format(len(values) - limit) if len(values) > limit else "")


# --------------------------------------------------------------------------
# Text for messages and the report
# --------------------------------------------------------------------------

def _fmt(value, places=4):
    return "n/a" if value is None else "{0:.{1}f}".format(value, places)


_ASPRS_FULL = ("This data set was tested to meet ASPRS Positional Accuracy Standards for Digital "
               "Geospatial Data, Edition 2, Version 2 (2024) for a {cls:g}(cm) {name} Accuracy Class. "
               "{finding}")
_ASPRS_REDUCED = ("This data set was tested as required by ASPRS Positional Accuracy Standards for Digital "
                  "Geospatial Data, Edition 2, Version 2 (2024). Although the Standards call for a minimum "
                  "of thirty (30) checkpoints, this test was performed using ONLY {n} checkpoints. This data "
                  "set was produced to meet a {cls:g}(cm) {name} Accuracy Class. {finding}")


def _asprs_claim(word, n, klass, class_name, full_name, finding, reduced_finding, rmse_name, rmse_value,
                 blunders, zero, area="", bias=None, hold=None):
    """The ASPRS 7.16.1 sentence, but only for a result that earned it.

    The published wording ("tested to meet ... Class") states conformance, so it is written only for
    PASS / PASS_LOW_N with no bias. Any other result gets a plain finding that says what was tested
    and why no conformance is claimed (FAIL, blunders, a mean error above 25 % of the class, survey
    accuracy not given, residuals all zero). ``bias`` is the text of the mean-error finding or None.
    ``hold`` is the run-level reason (see ``_run_hold``): a conformance sentence is a statement about
    the whole data set, so a bias, a blunder, a missing survey accuracy or all-zero residuals in ANY
    assessed component withholds it for every component, and the finding is written instead.
    """
    where = " in the {0} tested area".format(area) if area else ""
    if zero:
        return ("ASPRS Ed. 2: every residual is {0}, so the data set was probably tested against "
                "itself or a copy of the check points. No conformance sentence is written.".format(
                    zero if isinstance(zero, str) else "exactly zero"))
    if word.startswith("FAIL"):
        return ("ASPRS Ed. 2: the {0:g}(cm) {1} Accuracy Class was NOT met{2}: {3} = {4:.2f}(cm).{5}{6} No "
                "conformance sentence is written.".format(
                    klass, class_name, where, rmse_name, rmse_value,
                    " {0} blunder(s) were also found.".format(blunders) if "BLUNDERS" in word else "",
                    " Also {0}.".format(bias) if bias else ""))
    if "BLUNDERS" in word:
        return ("ASPRS Ed. 2: {0} = {1:.2f}(cm) is within the {2:g}(cm) {3} Accuracy Class{4}, but {5} "
                "blunder(s) (a discrepancy above 3 times the class, ASPRS 7.2) were found.{6} No conformance "
                "sentence is written until they are investigated.".format(
                    rmse_name, rmse_value, klass, class_name, where, blunders,
                    " Also {0}.".format(bias) if bias else ""))
    if bias:
        return ("ASPRS Ed. 2: {0} = {1:.2f}(cm) is within the {2:g}(cm) {3} Accuracy Class{4}{5}, but {6}: the "
                "errors are systematic, not only random (ASPRS 7.2 recommends a mean error below 25 % of the "
                "class). No conformance sentence is written until the bias is investigated or removed.".format(
                    rmse_name, rmse_value, klass, class_name, where,
                    " (the fit to the check points only: their survey accuracy was not given)"
                    if word.startswith("FIT_PASS") else "", bias))
    if word.startswith("FIT_PASS"):
        return ("ASPRS Ed. 2: the fit to the check points, {0}1 = {1:.2f}(cm), is within the {2:g}(cm) {3} "
                "Accuracy Class{4}, but the survey accuracy of the check points ({0}2, ASPRS 7.12.2) was "
                "not given, so {0} is not complete. This is NOT a conformance statement; no conformance "
                "sentence is written.".format(rmse_name, rmse_value, klass, class_name, where))
    if hold:
        return ("ASPRS Ed. 2: {0} = {1:.2f}(cm) is within the {2:g}(cm) {3} Accuracy Class{4}, but no conformance "
                "sentence is written for this data set while {5}.".format(
                    rmse_name, rmse_value, klass, class_name, where, hold))
    if n >= cpa_constant("ASPRS_MIN_POINTS"):
        return _ASPRS_FULL.format(cls=klass, name=full_name, finding=finding)
    return (_ASPRS_REDUCED.format(n=n, cls=klass, name=class_name, finding=reduced_finding)
            + " The accuracy class is the target given to the tool for the product; the tool only tested it.")


def _bias_text(subset_row, klass, unit_per_m, vertical=False):
    """Text of the mean-error finding when the 25 % recommendation (ASPRS 7.2) is not met, else None."""
    flag = subset_row.get("BIAS_FLAG") or ""
    if vertical:
        if "MEAN_Z_GT_25PCT" not in flag or subset_row.get("MEAN_DZ") is None:
            return None
        mean_cm = abs(subset_row["MEAN_DZ"]) * unit_per_m * 100.0
        what = "the mean vertical error is {0:.2f}(cm)".format(mean_cm)
    else:
        if "MEAN_H_GT_25PCT" not in flag:
            return None
        mean_cm = math.hypot(subset_row["MEAN_DX"], subset_row["MEAN_DY"]) * unit_per_m * 100.0
        what = "the mean horizontal error is {0:.2f}(cm)".format(mean_cm)
    return "{0}, {1:.0f} % of the {2:g}(cm) class, above 25 %".format(what, 100.0 * mean_cm / klass, klass)


def _run_hold(by, opts, declared, not_compared=0):
    """Run-level reasons that withhold every ASPRS conformance sentence, as text, or None.

    One rule for every sentence (horizontal, NVA vertical): a bias (mean error above 25 % of a given
    class, ASPRS 7.2), a blunder, a class whose check point survey accuracy was not given (FIT_PASS)
    or residuals that are all below 1 mm (a self-comparison) in any assessed component hold back all
    of them. The vertical component is assessed on the NVA row when a terrain class field split the
    check points, else on the ALL row (RMSEV over all check points against the vertical class).
    ``not_compared`` check points (``not_compared_checks``) hold them back too: their errors are in no statistic.
    """
    a = by.get(SUBSET_ALL)
    nva = by.get(SUBSET_NVA)
    reasons = []
    if not_compared:
        reasons.append("{0} check point(s) were not compared (see the unpaired table)".format(not_compared))
    if opts["h_class_cm"]:
        bias = _bias_text(a, opts["h_class_cm"], opts["mpu"])
        if bias:
            reasons.append("the errors are systematic, not only random ({0}; ASPRS 7.2 recommends a mean "
                           "error below 25 % of the class)".format(bias))
    # the row that carries the vertical verdict: NVA with a terrain field, ALL without one
    vrow, vname = (nva, "NVA") if opts["has_class_field"] else (a, "vertical")
    v_assessed = bool(opts["v_class_cm"] and vrow and vrow["N_WITH_Z"])
    if v_assessed:
        bias = _bias_text(vrow, opts["v_class_cm"], opts["zmpu"], vertical=True)
        if bias:
            reasons.append("the {0} errors are systematic, not only random ({1})".format(vname, bias))
    blunders = max([r["BLUNDERS"] or 0 for r in by.values()] or [0])
    if blunders:
        reasons.append("{0} blunder(s) (a discrepancy above 3 times the class, ASPRS 7.2) were found and are "
                       "not yet investigated".format(blunders))
    fit = []
    if opts["h_class_cm"] and str(a["H_RESULT"]).startswith("FIT_PASS"):
        fit.append("horizontal")
    if v_assessed and str(vrow["V_RESULT"]).startswith("FIT_PASS"):
        fit.append("vertical")
    if fit:
        reasons.append("the survey accuracy of the check points was not given for the {0} class".format(
            " and ".join(fit)))
    if self_comparison(a, opts)[0]:
        reasons.append("every horizontal residual is {0}".format(self_comparison_text(a, opts, "horizontal")))
    if opts["v_class_cm"]:
        for row in (a, nva):
            if row and self_comparison(row, opts)[1]:
                reasons.append("every vertical residual{0} is {1}".format(
                    " of the NVA" if row is nva else "", self_comparison_text(row, opts, "vertical")))
                break
    return "; ".join(reasons) if reasons else None


def reporting_statements(summary, opts, unit, methods=(), not_compared=None):
    """Conformance / reporting sentences built from the published templates.

    ASPRS Ed. 2 V2 7.16.1 (standard wording, and the wording for fewer than 30 check
    points) and NSSDA 3.2.3 / Appendix 3-A. Rules (the tool's design, see docs/standards.md):

    * The "tested to meet" wording is a statement of conformance, so it is written only after a
      PASS with no blunders and no mean error above 25 % of the class (see ``_asprs_claim``).
    * Neither it nor the NSSDA "Tested ... at 95% confidence level" sentence is written unless the
      user declared the compared points as discrete, well-defined points (``opts["well_defined"]``):
      both standards test horizontal accuracy at such points, and the tool cannot know it (centroids never
      are). Neither standard asks this of vertical check points (NSSDA 3.2.2, ASPRS 7.13); the tool applies
      the same declaration to its vertical sentences as its own stricter rule (INFERENCE, docs/standards.md).
    * A sentence is written only for what was computed and, for ASPRS, only when the matching class
      was given; the NVA and VVA sentences only when a terrain class field split the check points.
    * The NSSDA "Tested" sentence is not written for a component tested on fewer than 20 check points
      (NSSDA 3.2.2 "shall"; 3.2.3 keeps "Tested" for tests that follow 3.2.2); the value is given as a
      measurement instead.
    * ``not_compared`` is ``(count, text)`` for the check points that were NOT COMPARED
      (``not_compared_checks``). With any, the text is the first statement, and neither an ASPRS
      conformance sentence nor an NSSDA "Tested" sentence is written (review R12-1: the tolerance or a missing
      feature would otherwise hide the largest errors); the values are given as computed.
    """
    out = []
    by = dict((s["SUBSET"], s) for s in summary)
    a = by.get(SUBSET_ALL)
    n_missing, missing_text = not_compared or (0, None)
    if missing_text:
        out.append(missing_text)
    if a is None or not a["N_PAIRS"]:
        return out
    declared = bool(opts.get("well_defined"))
    mpu, zmpu = opts["mpu"], opts["zmpu"]
    hold = _run_hold(by, opts, declared, n_missing) if declared else None
    if not declared:
        measured = []
        if a["RMSEH_CM"] is not None:
            measured.append("RMSEH = {0:.2f}(cm)".format(a["RMSEH_CM"]))
        if a["RMSEV_CM"] is not None:
            measured.append("RMSEV = {0:.2f}(cm)".format(a["RMSEV_CM"]))
        if a["NSSDA_H95"] is not None:
            measured.append("NSSDA horizontal 95 % = {0} ({1})".format(_fmt(a["NSSDA_H95"]), unit_words(unit)))
        out.append("No conformance or 'tested' sentence is written: the compared points were not declared as "
                   "discrete, well-defined points (NSSDA 3.2.2 and ASPRS 7.13 test horizontal accuracy at such "
                   "points; centroids of lines and polygons never are; the tool applies the same declaration to "
                   "the vertical sentences, its own stricter rule). Measured, not a statement of conformance: {0}. Tick "
                   "'Points Are Well-Defined' if they are, for example surveyed corners or marked "
                   "targets.".format("; ".join(measured) if measured else "see the summary table"))
    elif any(m != METHOD_POINT for m in methods):
        out.append("The compared points are line or polygon centroids that the user declared as well-defined "
                   "points; a centroid is not a surveyed discrete point, so read the sentences below with "
                   "that in mind.")
    if opts["standard"] in (STANDARD_ASPRS, STANDARD_BOTH):
        if opts["h_class_cm"]:
            v = a["RMSEH_CM"]
            if declared:
                out.append(_asprs_claim(
                    a["H_RESULT"], a["N_PAIRS"], opts["h_class_cm"], "RMSEH Horizontal Positional",
                    "RMSEH Horizontal Positional",
                    "The tested horizontal positional accuracy was found to be RMSEH = {0:.2f}(cm).".format(v),
                    "The tested horizontal positional accuracy was found to be RMSEH = {0:.2f}(cm) using the "
                    "reduced number of checkpoints.".format(v), "RMSEH", v, a["BLUNDERS"],
                    self_comparison_text(a, opts, "horizontal") if self_comparison(a, opts)[0] else False,
                    bias=_bias_text(a, opts["h_class_cm"], mpu), hold=hold))
        else:
            out.append("ASPRS Ed. 2: no horizontal accuracy class was given, so no conformance sentence is "
                       "written. RMSEH = {0} cm.".format(_fmt(a["RMSEH_CM"], 2)))
        if a["N_WITH_Z"]:
            if opts["has_class_field"]:
                for label, subset in (("Non-Vegetated Vertical Accuracy (NVA)", SUBSET_NVA),
                                      ("Vegetated Vertical Accuracy (VVA)", SUBSET_VVA)):
                    sub = by.get(subset)
                    if not (sub and sub["N_WITH_Z"]):
                        continue
                    v = sub["RMSEV_CM"]
                    area = "NVA" if subset == SUBSET_NVA else "VVA"
                    if subset == SUBSET_VVA:
                        # No class and no pass/fail for the VVA (7.4): reported as found.
                        if not declared:
                            # Review R13/R14 minor note: no "tested" wording right after the sentence that
                            # says no 'tested' sentence is written; the value is given as measured.
                            out.append("Measured, not a statement of conformance: the {0} RMSEV = {1:.2f}(cm) "
                                       "over {2} check point(s) with elevations. ASPRS Ed. 2 sets no pass/fail "
                                       "criterion for the VVA; it is reported as found.".format(
                                           label, v, sub["N_WITH_Z"]))
                        elif sub["N_WITH_Z"] >= cpa_constant("ASPRS_MIN_POINTS"):
                            out.append("The {0} was found to be RMSEV = {1:.2f}(cm). ASPRS Ed. 2 sets no "
                                       "pass/fail criterion for the VVA; it is reported as found.".format(label, v))
                        else:
                            out.append("The tested vertical positional accuracy was found to be RMSEV = "
                                       "{0:.2f}(cm) using the reduced number of checkpoints in the VVA "
                                       "tested area. ASPRS Ed. 2 sets no pass/fail criterion for the VVA; "
                                       "it is reported as found.".format(v))
                        continue
                    if not opts["v_class_cm"] or not declared:
                        continue
                    out.append(_asprs_claim(
                        sub["V_RESULT"], sub["N_WITH_Z"], opts["v_class_cm"], "RMSEV Vertical Positional",
                        "RMSEV Vertical",
                        "The {0} was found to be RMSEV = {1:.2f}(cm).".format(label, v),
                        "The tested vertical positional accuracy was found to be RMSEV = {0:.2f}(cm) using "
                        "the reduced number of checkpoints in the {1} tested area.".format(v, area),
                        "RMSEV", v, sub["BLUNDERS"],
                        self_comparison_text(sub, opts, "vertical") if self_comparison(sub, opts)[1] else False,
                        area=area,
                        bias=_bias_text(sub, opts["v_class_cm"], zmpu, vertical=True), hold=hold))
            elif opts["v_class_cm"]:
                # No terrain field: the vertical verdict is on the ALL row; its findings are said here, since
                # no NVA sentence carries them.
                found = []
                vbias = _bias_text(a, opts["v_class_cm"], zmpu, vertical=True)
                if vbias:
                    found.append(" Also {0}: the errors are systematic, not only random (ASPRS 7.2).".format(vbias))
                if str(a["V_RESULT"]).startswith("FIT_PASS"):
                    found.append(" The survey accuracy of the check points (RMSEV2, ASPRS 7.12.2) was not given, "
                                 "so this is the fit to the check points only.")
                if self_comparison(a, opts)[1]:
                    found.append(" Every vertical residual is {0}: check that the elevations do not come from "
                                 "the same source.".format(self_comparison_text(a, opts, "vertical")))
                out.append("ASPRS Ed. 2: RMSEV = {0:.2f}(cm) over all {1} check points with elevations "
                           "against the {2:g}(cm) class (result {3}).{4} No NVA / VVA class field was given, so "
                           "the NVA and VVA sentences of 7.16.1 are not written.".format(
                               a["RMSEV_CM"], a["N_WITH_Z"], opts["v_class_cm"], a["V_RESULT"], "".join(found)))
        if a["RMSE3D_CM"] is not None:
            out.append("RMSE3D = {0:.2f}(cm) is in the summary table; the three-dimensional statement of ASPRS "
                       "7.16.1 is not written by this tool.".format(a["RMSE3D_CM"]))
    if opts["standard"] in (STANDARD_NSSDA, STANDARD_BOTH):
        unit_word = unit_words(unit)
        zunit = a.get("Z_UNIT") or unit
        z_word = unit_words(zunit)
        parts = []
        withheld = []
        # A value computed from residuals that are all below 1 mm (exact zero included) is a self-comparison,
        # not a test: the "Tested ..." sentence is not written for that component (INFERENCE; the same reason
        # as for the ASPRS sentences, see _asprs_claim and SELF_COMPARE_M).
        zero_h, zero_v = self_comparison(a, opts)
        # NSSDA 3.2.2 (p. 3-4): "A minimum of 20 check points shall be tested"; with fewer the standard asks for
        # an alternative means of evaluation and, in 3.2.3 (p. 3-6), the "Compiled to meet" wording instead of
        # "Tested". So a component tested on fewer than 20 check points gets no "Tested" sentence; its value is
        # given as a measurement (NSSDA_MIN_POINTS; horizontal counts the pairs, vertical the pairs with Z).
        min_n = cpa_constant("NSSDA_MIN_POINTS")
        few = []
        uncompared = []   # computed but not "Tested": check points were not compared (review R12-1)
        if a["NSSDA_H95"] is not None:
            if declared and zero_h:
                withheld.append("horizontal")
            elif declared and a["N_PAIRS"] < min_n:
                few.append(("horizontal", a["N_PAIRS"], "{0} ({1})".format(_fmt(a["NSSDA_H95"]), unit_word), ""))
            elif declared and n_missing:
                uncompared.append("horizontal accuracy at 95% = {0} ({1})".format(_fmt(a["NSSDA_H95"]), unit_word))
            else:
                parts.append("{0} ({1}) horizontal accuracy at 95% confidence level".format(
                    _fmt(a["NSSDA_H95"]), unit_word))
        if a["NSSDA_V95"] is not None:
            if declared and zero_v:
                withheld.append("vertical")
            elif declared and a["N_WITH_Z"] < min_n:
                few.append(("vertical", a["N_WITH_Z"], "{0} ({1})".format(_fmt(a["NSSDA_V95"]), z_word),
                            " with elevations"))
            elif declared and n_missing:
                uncompared.append("vertical accuracy at 95% = {0} ({1})".format(_fmt(a["NSSDA_V95"]), z_word))
            else:
                parts.append("{0} ({1}) vertical accuracy at 95% confidence level".format(
                    _fmt(a["NSSDA_V95"]), z_word))
        if withheld:
            out.append("NSSDA: the 'Tested ... at 95% confidence level' sentence is not written for the {0} "
                       "accuracy: every {1}, so the data set was probably tested "
                       "against itself or a copy of the check points.".format(
                           " and ".join(withheld), " and every ".join(
                               "{0} residual is {1}".format(c, self_comparison_text(a, opts, c)) for c in withheld)))
        for component, count, value, what in few:
            out.append("NSSDA: the 'Tested ... at 95% confidence level' sentence is not written for the {0} "
                       "accuracy: only {1} check point(s){2} were used and NSSDA 3.2.2 requires a minimum of {3} "
                       "(with fewer it asks for another means of evaluation and the 'Compiled to meet' wording, "
                       "which this tool does not write). Computed, not a statement of conformance: {0} accuracy "
                       "at 95% = {4}.".format(component, count, what, min_n, value))
        if uncompared:
            out.append("NSSDA: the 'Tested ... at 95% confidence level' sentence is not written: {0} check point(s) "
                       "were not compared (see the unpaired table), so the test does not cover every check point. "
                       "Computed over the {1} compared check point(s), not a statement of conformance: {2}.".format(
                           n_missing, a["N_PAIRS"], "; ".join(uncompared)))
        if parts and declared:
            out.append("Tested " + ", ".join(parts) + ".")
        if (parts or few or uncompared) and declared:
            if a["NSSDA_V95"] is not None and opts["has_class_field"]:
                nva = by.get(SUBSET_NVA)
                text = ("The NSSDA vertical value is computed over all {0} check points with elevations (NVA "
                        "and VVA together)".format(a["N_WITH_Z"]))
                if nva and nva["NSSDA_V95"] is not None:
                    text += "; NVA alone: {0} ({1})".format(_fmt(nva["NSSDA_V95"]), z_word)
                out.append(text + ".")
            if "MEAN_H_GT_25PCT" in (a["BIAS_FLAG"] or ""):
                out.append("NSSDA Appendix 3-A assumes systematic errors were removed; here the mean horizontal "
                           "error is {0} ({1}), above 25 % of the ASPRS class given.".format(
                               _fmt(math.hypot(a["MEAN_DX"], a["MEAN_DY"])), unit_word))
        if a["NSSDA_H95"] is None:
            out.append("NSSDA horizontal accuracy at 95% confidence is not stated: the ratio RMSEmin/RMSEmax "
                       "= {0} is below 0.6, outside the range for which Appendix 3-A gives a "
                       "formula.".format(ratio_text(a["XY_RATIO"])))
        if a["N_PAIRS"] < cpa_constant("NSSDA_MIN_POINTS"):
            out.append("NSSDA 3.2.2 asks for a minimum of 20 check points; {0} were used, so the result is "
                       "indicative only.".format(a["N_PAIRS"]))
    return out


def summary_report_rows(summary, counts, crs, opts, method, statements, notes):
    """``(item, value)`` rows for the Summary sheet of the Excel / CSV report."""
    rows = [("Pairing method", method),
            ("Features read", counts["features"]), ("Check points read", counts["checks"]),
            ("Pairs formed", counts["pairs"]),
            ("Check points not paired", counts["unpaired_checks"]),
            ("Features not paired (problems + no counterpart)", counts["unpaired_features"]),
            ("   of which have no check point{0}".format(
                "" if counts.get("absent_listed", True) else " (counted, not listed)"), counts.get("features_absent", 0)),
            ] + ([("Pairs whose keys differ (KEY_DIFFERS, counted in the statistics)", counts.get("key_differs", 0))]
                 if counts.get("keys_compared") else []) + [
            ("Coordinate system", "{0} (WKID {1})".format(crs["name"], crs["wkid"])),
            ("Unit of distances (except *_CM columns)", "{0} (1 unit = {1:.10g} m)".format(crs["unit"], crs["mpu"])),
            ("Residual sign", "feature minus check point")]
    for item in notes:
        rows.append(("Note", item))
    for s in summary:
        for name in SUMMARY_FIELDS:
            if name in ("SUBSET", "UNIT", "MPU", "CRS_NAME", "CRS_WKID") or s[name] in (None, ""):
                continue
            rows.append(("{0}: {1}".format(s["SUBSET"], name), s[name]))
    for text in statements:
        rows.append(("Statement", text))
    return rows


# --------------------------------------------------------------------------
# Vectors
# --------------------------------------------------------------------------

# Automatic exaggeration (display lines and plot arrows): the tool's own rule, documented in the tool page.
AUTO_MEDIAN_FRACTION = 0.03   # the median error line is drawn at most about 3 % of the extent long ...
AUTO_MAX_FRACTION = 0.15      # ... but no line is longer than 15 % of the extent
_NICE_FACTORS = (1, 2, 5)


def _nice_floor(value):
    """Largest of 1, 2, 5, 10, 20, 50, 100 ... that is not above ``value`` (1 for anything below 1)."""
    if not value or value < 1.0:
        return 1.0
    exponent = int(math.floor(math.log10(value)))
    best = 1.0
    for e in (exponent - 1, exponent):
        for m in _NICE_FACTORS:
            candidate = m * 10.0 ** e
            if candidate <= value * (1 + 1e-12) and candidate > best:
                best = candidate
    return float(best)


def auto_exaggeration(rows):
    """Exaggeration factor for the display lines and the plot arrows when the user gives none.

    Rule: the largest of 1, 2, 5, 10, 20, 50 ... that draws the median error line at most about 3 % of the
    extent of the check points long and no line longer than 15 % of it; never below 1 (a line is never
    drawn shorter than the true displacement). ``extent`` is the larger side of the bounding box of the
    check points. Returns 1.0 when there is no extent or no displacement.
    """
    drs = [r["dr"] for r in rows if r["dr"]]
    if not drs:
        return 1.0
    xs = [r["x_chk"] for r in rows]
    ys = [r["y_chk"] for r in rows]
    extent = max(max(xs) - min(xs), max(ys) - min(ys))
    if extent <= 0.0:
        return 1.0
    return min(_nice_floor(AUTO_MEDIAN_FRACTION * extent / median(drs)),
               _nice_floor(AUTO_MAX_FRACTION * extent / max(drs)))


def displacement_lines(rows, exaggeration=1.0):
    """Two-vertex lines from each check point towards its feature point.

    ``exaggeration`` 1 gives the true displacement; a larger factor stretches the line from
    the check point (display only). Pairs with no displacement have no line and are counted.
    Returns ``(lines, zero_count)``: ``lines`` are ``(row, [[(x0, y0), (x1, y1)]])``.
    """
    lines, zero = [], 0
    for row in rows:
        if row["dr"] == 0.0:
            zero += 1
            continue
        end = (row["x_chk"] + row["dx"] * exaggeration, row["y_chk"] + row["dy"] * exaggeration)
        lines.append((row, [[(row["x_chk"], row["y_chk"]), end]]))
    return lines, zero


# --------------------------------------------------------------------------
# Optional PNG plot (matplotlib, lazy and guarded)
# --------------------------------------------------------------------------

# Colour scale and histogram range of the plot (the tool's own display rule, not a number of either
# standard): a spread of the horizontal errors below 1 cm on the ground is not stretched over the whole colour
# scale, so a constant shift (a datum or a copy offset) is drawn in one colour, not as a range of errors.
PLOT_MIN_SPAN_M = 0.01
PLOT_MAX_TICKS = 6


def plot_error_range(drs, mpu=1.0):
    """``(low, high, flat)``: the colour and histogram range of the horizontal errors ``drs`` (coordinate units).

    ``flat`` is True when the spread ``max - min`` is below ``PLOT_MIN_SPAN_M`` (ground metres, converted with
    ``mpu``); the range is then ``PLOT_MIN_SPAN_M`` wide, centred on the errors and never below 0. Otherwise
    the range is ``(min, max)`` of the errors.
    """
    low, high = min(drs), max(drs)
    floor = PLOT_MIN_SPAN_M / float(mpu)
    if high - low >= floor:
        return low, high, False
    start = max(0.0, (low + high) / 2.0 - floor / 2.0)
    return start, start + floor, True


def flat_plot_text(drs, unit, mpu=1.0):
    """Title text for a flat plot: ``"all errors 0.7211 Meter +/- 0.05 mm"``."""
    low, high = min(drs), max(drs)
    return "all errors {0:.4f} {1} ± {2:.2f} mm".format((low + high) / 2.0, unit,
                                                             (high - low) / 2.0 * float(mpu) * 1000.0)


def axis_ticks(low, high, count=PLOT_MAX_TICKS):
    """``(ticks, labels)`` for an axis from ``low`` to ``high``: at most ``count + 1`` ticks on a 1-2-5
    step, labels with just as many decimals as the step needs and no offset or exponent, so that they stay
    short and do not run into each other (review R10-3: ``0.721040.721060.72108``)."""
    if not (high > low):
        return [low], ["{0:g}".format(low)]
    raw = (high - low) / float(count)
    mag = 10.0 ** math.floor(math.log10(raw))
    step = next(m * mag for m in (1.0, 2.0, 5.0, 10.0) if m * mag >= raw * (1 - 1e-9))
    decimals = max(0, -int(math.floor(math.log10(step) + 1e-9)))
    first = math.ceil(low / step - 1e-9)
    ticks = []
    i = first
    while i * step <= high + step * 1e-9:
        ticks.append(round(i * step, decimals + 2))
        i += 1
    return ticks, ["{0:.{1}f}".format(t, decimals) for t in ticks]


def _build_plot(pyplot, rows, summary_all, unit, exaggeration=1.0, h_class_cm=None, mpu=1.0):
    """The figure of ``render_plot`` (built, not saved and not closed): ``(figure, ax_vectors, ax_histogram,
    colorbar)``. The colour scale and the histogram use ``plot_error_range`` (no stretch below 1 cm of spread)
    and the histogram and colour bar ticks use ``axis_ticks`` (no overlapping labels, no offset)."""
    figure, (ax1, ax2) = pyplot.subplots(1, 2, figsize=(12, 5.2), gridspec_kw={"width_ratios": [1.25, 1]})
    x0 = min(r["x_chk"] for r in rows)
    y0 = min(r["y_chk"] for r in rows)
    xs = [r["x_chk"] - x0 for r in rows]
    ys = [r["y_chk"] - y0 for r in rows]
    drs = [r["dr"] for r in rows]
    many = len(rows) > 200
    low, high, flat = plot_error_range(drs, mpu)
    quiver = ax1.quiver(xs, ys, [r["dx"] for r in rows], [r["dy"] for r in rows], drs,
                        angles="xy", scale_units="xy", scale=1.0 / float(exaggeration), cmap="viridis",
                        width=0.0025 if many else 0.004, headwidth=3, headlength=3.5, headaxislength=3,
                        clim=(low, high), zorder=2)
    # the check points, coloured by their horizontal error like the arrows
    ax1.scatter(xs, ys, c=drs, cmap="viridis", s=7 if many else 16, vmin=low, vmax=high,
                edgecolors="black", linewidths=0.3, zorder=3)
    # keep the arrow tips inside the axes (the autoscale only sees the arrow tails)
    ax1.plot([x + r["dx"] * exaggeration for x, r in zip(xs, rows)],
             [y + r["dy"] * exaggeration for y, r in zip(ys, rows)], linestyle="none", marker="", alpha=0)
    ax1.set_aspect("equal", adjustable="datalim")
    ax1.set_xlabel("Easting offset from the lowest check point ({0})".format(unit))
    ax1.set_ylabel("Northing offset ({0})".format(unit))
    ax1.set_title("Residuals (feature minus check point)\nARROW LENGTHS ARE EXAGGERATED x{0:g}".format(exaggeration),
                  fontsize=10, pad=24)
    key_value = summary_all["RMSE_R"] or min(drs)
    if key_value:
        # scale key: an arrow that stands for an error of RMSEr, drawn with the same exaggeration
        ax1.quiverkey(quiver, 0.12, 1.02, key_value, "= RMSEr {0:.3g} {1}".format(key_value, unit),
                      labelpos="E", coordinates="axes", fontproperties={"size": 8})
    colorbar = figure.colorbar(quiver, ax=ax1, label="horizontal error ({0}), true size".format(unit))
    ticks, labels = axis_ticks(low, high)
    colorbar.set_ticks(ticks)
    colorbar.set_ticklabels(labels)
    bins = min(20, max(5, int(math.sqrt(len(rows))) + 1))
    ax2.hist(drs, bins=bins, range=(low, high), color="#4c78a8", edgecolor="white")
    ax2.axvline(summary_all["RMSE_R"], color="#e45756", linestyle="--", label="RMSE_r = {0:.4g}".format(summary_all["RMSE_R"]))
    left, right = low, high
    if h_class_cm:
        limit = h_class_cm / 100.0 / mpu
        if flat and not low <= limit <= high:
            # a flat plot keeps its 1 cm range readable: the class line is named, not drawn far off
            ax2.plot([], [], color="#54a24b", linestyle=":", label="ASPRS class {0:g} cm ({1} this axis)".format(
                h_class_cm, "right of" if limit > high else "left of"))
        else:
            ax2.axvline(limit, color="#54a24b", linestyle=":", label="ASPRS class {0:g} cm".format(h_class_cm))
            left, right = min(left, limit), max(right, limit)
    pad = (right - left) * 0.04
    limits = (max(0.0, left - pad), right + pad)
    ticks, labels = axis_ticks(*limits)
    ax2.set_xticks(ticks)
    ax2.set_xticklabels(labels)
    ax2.set_xlim(*limits)
    ax2.set_xlabel("horizontal error ({0})".format(unit))
    ax2.set_ylabel("pairs")
    title = "Distribution of the horizontal error, n = {0}".format(len(rows))
    if flat:
        title += "\n{0} (spread < {1:g} cm, not stretched)".format(
            flat_plot_text(drs, unit, mpu), PLOT_MIN_SPAN_M * 100.0)
    ax2.set_title(title, fontsize=10)
    ax2.legend()
    figure.tight_layout()
    return figure, ax1, ax2, colorbar


def render_plot(path, rows, summary_all, unit, exaggeration=1.0, h_class_cm=None, mpu=1.0):
    """Write a PNG with the residual vectors (quiver) and a histogram of the horizontal error.

    When the horizontal errors spread over less than 1 cm (``PLOT_MIN_SPAN_M``) the colour scale and the
    histogram are not stretched to that spread, and the histogram title says ``all errors <value> +/- <mm>``.
    Returns ``(True, None)`` or ``(False, reason)`` (matplotlib not available, or the file
    could not be written); never raises for a missing library.
    """
    try:
        import matplotlib
        matplotlib.use("Agg")
        from matplotlib import pyplot
    except Exception as exc:  # any import problem: the PNG is optional
        return False, "matplotlib is not available ({0})".format(exc)
    if not rows:
        return False, "there are no pairs to plot"
    figure = None
    try:
        figure = _build_plot(pyplot, rows, summary_all, unit, exaggeration, h_class_cm, mpu)[0]
        figure.savefig(path, dpi=110)
    except Exception as exc:
        return False, "the plot could not be written ({0})".format(exc)
    finally:
        if figure is not None:
            pyplot.close(figure)
    return True, None


# --------------------------------------------------------------------------
# One call for the whole computation
# --------------------------------------------------------------------------

def run_accuracy(features, checks, method, tolerance, opts, crs, exaggeration=1.0, list_absent_features=True):
    """Pair, compute residuals and statistics. ``features`` / ``checks`` are ``prepare_records`` lists.

    ``list_absent_features`` False leaves the features that merely have no check point (NO_KEY_MATCH,
    NO_CHECK_POINT_WITHIN_TOLERANCE) out of ``unpaired``: with a large layer and a few hundred check
    points they would bury the rows that matter. They are counted (``counts["features_absent"]``, the
    ``N_NO_CHK`` column of the ALL row); every other reason, and every check point, is always listed.
    Returns a dict: ``pairs``, ``unpaired``, ``rows`` (residuals), ``summary``,
    ``unclassified``, ``counts``, ``statements``.
    """
    if method == PAIR_KEY:
        pairs, unpaired = pair_by_key(features, checks)
    elif method == PAIR_NEAREST:
        pairs, unpaired = pair_nearest(features, checks, tolerance, crs.get("unit"), opts.get("mpu"))
    else:
        raise ValueError("unknown pairing method: {0}".format(method))
    rows = residual_rows(pairs, opts)
    absent = sum(1 for u in unpaired if u["side"] == SIDE_FEATURE and u["reason"] in CPA_ABSENCE_REASONS)
    missing = not_compared_checks(unpaired)
    near, radius_m = None, None
    if method == PAIR_NEAREST and opts.get("h_class_cm") and missing:
        radius_m = 3.0 * opts["h_class_cm"] / 100.0
        near = nearest_beyond_tolerance(features, checks, unpaired, radius_m / opts["mpu"])
        dist_unit = distance_unit_text(crs.get("unit"), opts.get("mpu"))
        for u in unpaired:
            if u["side"] == SIDE_CHECK and u["oid"] in near:
                hit = near[u["oid"]]
                u["detail"] = (u["detail"] + (" Nearest feature OID {0} at {1:.6g} {2}, within 3 times the "
                                              "horizontal class ({3:g} m): not compared.".format(
                                                  hit[1]["oid"], hit[0], dist_unit, radius_m) if hit else
                                              " No feature within 3 times the horizontal class ({0:g} m) "
                                              "either.".format(radius_m)))
    missing_text = not_compared_text(missing, method, near, radius_m, opts.get("h_class_cm"),
                                     declared=bool(opts.get("well_defined")), standard=opts.get("standard"))
    extra_all = (missing_text,) if missing_text else ()
    summary, unclassified = summarise(rows, opts, crs, no_check=absent, all_notes=extra_all)
    counts = {"features": len(features), "checks": len(checks), "pairs": len(pairs),
              "unpaired_checks": sum(1 for u in unpaired if u["side"] == SIDE_CHECK),
              "unpaired_features": sum(1 for u in unpaired if u["side"] == SIDE_FEATURE),
              "features_absent": absent, "absent_listed": bool(list_absent_features),
              "not_compared_checks": len(missing)}
    if not list_absent_features:
        unpaired = [u for u in unpaired if not (u["side"] == SIDE_FEATURE and u["reason"] in CPA_ABSENCE_REASONS)]
    counts["unpaired_rows"] = len(unpaired)
    differs = key_differs_rows(rows)
    counts["keys_compared"] = method == PAIR_NEAREST and any(
        f["key"] is not None and c["key"] is not None for f, c in pairs)
    counts["key_differs"] = len(differs)
    statements = reporting_statements(summary, opts, crs["unit"], set(r["method"] for r in rows),
                                      not_compared=(len(missing), missing_text))
    return {"pairs": pairs, "unpaired": unpaired, "rows": rows, "summary": summary,
            "unclassified": unclassified, "not_compared": missing, "not_compared_text": missing_text,
            "unclassified_values": unrecognised_terrain(rows) if opts["has_class_field"] else [],
            "counts": counts, "statements": statements}


# ==========================================================================
# quality/checkpoint_report_core.py
# ==========================================================================
# Positional Accuracy Report (NSSDA/ASPRS): the formatted Excel workbook (no arcpy; openpyxl is passed in).
#
# ``build_workbook(openpyxl, ctx)`` returns an unsaved workbook with three sheets:
#
# * ``Summary``: title, the standard's sentences first, the result against the chosen standard(s)
#   (value, class or claimed limit, result word, how it was computed), the counts, the statistics in
#   three columns (ALL / NVA / VVA), the notes. Laid out like the FGDC accuracy worksheets: one
#   quantity per row, the formula named beside it.
# * ``Detail``: one row per pair, frozen header, filter, number formats.
# * ``Unpaired``: every feature and check point that was not paired, with the reason.
#
# The caller (``common.report.write_report`` with ``xlsx_builder``) imports openpyxl lazily and saves the
# workbook. Nothing here is Excel-version specific; only plain styles and number formats are used.

XLSX_MAX_ROWS = 1048576
# Excel rejects these control characters in cell text.
_ILLEGAL = dict.fromkeys(list(range(0, 9)) + [11, 12] + list(range(14, 32)))

GREEN, AMBER, RED, HEADER_FILL, SECTION_FILL = "C6EFCE", "FFEB9C", "FFC7CE", "D9E1F2", "EDEDED"

# (label, summary field, kind, basis). kind: int, len (coordinate units), cm, ratio, text
_STAT_ROWS = (
    ("Pairs", "N_PAIRS", "int", "Residual rows used"),
    ("Pairs with an elevation", "N_WITH_Z", "int", ""),
    ("Mean DX (feature minus check point)", "MEAN_DX", "len", "Signed mean: a systematic shift shows here"),
    ("Mean DY", "MEAN_DY", "len", ""),
    ("Mean DZ", "MEAN_DZ", "zlen", ""),
    ("Standard deviation DX", "SD_DX", "len", "Divisor n - 1"),
    ("Standard deviation DY", "SD_DY", "len", ""),
    ("Standard deviation DZ", "SD_DZ", "zlen", ""),
    ("Smallest horizontal error", "MIN_DR", "len", "DR = sqrt(DX^2 + DY^2)"),
    ("Median horizontal error", "MED_DR", "len", ""),
    ("Largest horizontal error", "MAX_DR", "len", ""),
    ("RMSEx", "RMSE_X", "len", "sqrt(sum(DX^2) / n)"),
    ("RMSEy", "RMSE_Y", "len", "sqrt(sum(DY^2) / n)"),
    ("RMSEr", "RMSE_R", "len", "sqrt(RMSEx^2 + RMSEy^2)"),
    ("RMSEz", "RMSE_Z", "zlen", "sqrt(sum(DZ^2) / n)"),
    ("RMSEmin / RMSEmax", "XY_RATIO", "ratio", "NSSDA Case 2 needs 0.6 to 1.0"),
    ("NSSDA horizontal accuracy, 95 %", "NSSDA_H95", "len", "2.4477 x 0.5 x (RMSEx + RMSEy), Case 2"),
    ("NSSDA horizontal, Case 1 (reference)", "NSSDA_H_C1", "len", "1.7308 x RMSEr, valid if RMSEx = RMSEy"),
    ("NSSDA vertical accuracy, 95 %", "NSSDA_V95", "zlen", "1.9600 x RMSEz"),
    ("ASPRS RMSEH", "RMSEH_CM", "cm", "RMSEr combined with RMSEH2 when given"),
    ("ASPRS RMSEV", "RMSEV_CM", "cm", "RMSEz combined with RMSEV2 when given"),
    ("ASPRS RMSE3D", "RMSE3D_CM", "cm", "sqrt(RMSEH^2 + RMSEV^2)"),
    ("Blunders", "BLUNDERS", "int", "Discrepancy above 3 x the class in a component (ASPRS 7.2)"),
    ("Check count flag (horizontal)", "N_FLAG", "text", "NSSDA asks for 20, ASPRS for 30"),
    ("Check count flag (vertical)", "NZ_FLAG", "text", ""),
    ("Mean error versus 25 % of the class", "BIAS_FLAG", "text", "ASPRS 7.2"),
    ("ASPRS horizontal result", "H_RESULT", "text", "RMSEH against the class"),
    ("ASPRS vertical result", "V_RESULT", "text", "RMSEV (NVA) against the class; the VVA has none"),
    ("NSSDA claimed horizontal accuracy", "NSSDA_HRES", "text", "Tested accuracy against the claimed value; ALL only"),
    ("NSSDA claimed vertical accuracy", "NSSDA_VRES", "text", "ALL only"),
)


def _clean(value):
    if isinstance(value, str):
        return value.translate(_ILLEGAL)
    if value is None or isinstance(value, (bool, int, float)):
        return value
    return str(value)


def _result_fill(word, held=False):
    """Fill colour for a result word, or ``None``.

    ``held``: some check points were not compared, so every conformance sentence is held back; a PASS
    word is then filled amber, not green (review R14 minor note: a green PASS beside a hold invites
    misreading). The word itself stays that of the pairs."""
    text = str(word or "")
    if text.startswith("FAIL"):
        return RED
    if text.startswith("FIT_PASS") or "LOW_N" in text or "BLUNDERS" in text:
        return AMBER
    if text.startswith("PASS"):
        return AMBER if held else GREEN
    return None


def _round(value, kind):
    if isinstance(value, bool) or not isinstance(value, float):
        return value
    if math.isnan(value) or math.isinf(value):
        return None
    return round(value, 4 if kind == "cm" else 3 if kind == "ratio" else 6)


def _number_format(kind, places):
    if kind == "int":
        return "0"
    if kind == "cm":
        return "0.00"
    if kind == "ratio":
        return "0.000"
    return "0." + "0" * places


class _Sheet(object):
    """Small writer around an openpyxl worksheet: tracks the row, never lets text become a formula."""

    def __init__(self, openpyxl, ws):
        self.ox = openpyxl
        self.ws = ws
        self.row = 0
        self.styles = openpyxl.styles
        self.bold = self.styles.Font(bold=True)
        self.wrap = self.styles.Alignment(wrap_text=True, vertical="top")
        self.top = self.styles.Alignment(vertical="top")
        self.indent = self.styles.Alignment(vertical="top", indent=1)

    def fill(self, color):
        return self.styles.PatternFill("solid", start_color=color, end_color=color)

    def put(self, row, col, value, bold=False, fmt=None, fill=None, wrap=False, size=None, italic=False, indent=False):
        cell = self.ws.cell(row=row, column=col)
        cell.value = _clean(value)
        if isinstance(cell.value, str):
            cell.data_type = "s"   # never a formula
        if bold or size or italic:
            cell.font = self.styles.Font(bold=bold, size=size, italic=italic)
        if fmt:
            cell.number_format = fmt
        if fill:
            cell.fill = self.fill(fill)
        cell.alignment = self.wrap if wrap else self.indent if indent else self.top
        return cell

    def next(self, n=1):
        self.row += n
        return self.row

    def line(self, values, **kw):
        row = self.next()
        for col, value in enumerate(values, start=1):
            if value is not None:
                self.put(row, col, value, **kw)
        return row

    def header(self, values):
        row = self.next()
        for col, value in enumerate(values, start=1):
            self.put(row, col, value, bold=True, fill=HEADER_FILL, wrap=True)
        return row

    def section(self, title, columns=6):
        row = self.next(2)
        for col in range(1, columns + 1):
            self.put(row, col, title if col == 1 else None, bold=col == 1, fill=SECTION_FILL, size=11)
        return row

    def paragraph(self, text, columns=6, chars=150, italic=False, bold=False):
        """Text across the first ``columns`` columns, wrapped; the row height follows the length."""
        row = self.next()
        self.put(row, 1, text, wrap=True, italic=italic, bold=bold)
        self.ws.merge_cells(start_row=row, start_column=1, end_row=row, end_column=columns)
        lines = max(1, int(math.ceil(len(str(text)) / float(chars))))
        self.ws.row_dimensions[row].height = 15.0 * lines + 2
        return row


def _fit_rows(rows):
    """Rows that fit an Excel sheet, plus a closing line when some were dropped."""
    room = XLSX_MAX_ROWS - 2
    if len(rows) <= room:
        return rows
    dropped = len(rows) - room + 1
    rows = rows[:room - 1]
    rows.append(["{0} more rows not shown: an Excel sheet holds at most {1} rows. Choose a .csv report path "
                 "to get every row.".format(dropped, XLSX_MAX_ROWS)])
    return rows


def _widths(ws, header, rows, cap=60, minimum=8):
    widths = [max(minimum, len(str(h)) + 2) for h in header]
    for row in rows[:2000]:
        for i, value in enumerate(row[:len(widths)]):
            if value is None:
                continue
            size = len(str(value)) if not isinstance(value, float) else 12
            widths[i] = max(widths[i], min(size + 2, cap))
    return widths


_DETAIL_FORMATS = {
    "PAIR_ID": "0", "FEAT_OID": "0", "CHK_OID": "0",
    "X_FEAT": "0.000", "Y_FEAT": "0.000", "X_CHK": "0.000", "Y_CHK": "0.000",
    "DX": "0.0000", "DY": "0.0000", "DR": "0.0000", "AZIMUTH": "0.0",
    "Z_FEAT": "0.000", "Z_CHK": "0.000", "DZ": "0.0000"}


def _table_sheet(sheet, header, rows, formats):
    """Header row, frozen, filtered, widths, number formats; rows written with ``append``-like speed."""
    ws = sheet.ws
    rows = _fit_rows([list(r) for r in rows])
    for col, name in enumerate(header, start=1):
        sheet.put(1, col, name, bold=True, fill=HEADER_FILL, wrap=True)
    row_index = 1
    formats = [formats.get(name) for name in header]
    for row in rows:
        row_index += 1
        for col, value in enumerate(row, start=1):
            value = _clean(value)
            if value is None:
                continue
            cell = ws.cell(row=row_index, column=col)
            cell.value = value
            if isinstance(value, str):
                cell.data_type = "s"
            elif formats[col - 1] and isinstance(value, float):
                cell.number_format = formats[col - 1]
    ws.freeze_panes = "A2"
    if rows:
        ws.auto_filter.ref = "A1:{0}{1}".format(sheet.ox.utils.get_column_letter(len(header)), row_index)
    for i, width in enumerate(_widths(ws, header, rows)):
        ws.column_dimensions[sheet.ox.utils.get_column_letter(i + 1)].width = width


def _page_setup(ws, openpyxl):
    """Landscape, one page wide. Cosmetic: a failure here never stops the report."""
    try:
        ws.page_setup.orientation = "landscape"
        ws.page_setup.fitToWidth = 1
        ws.page_setup.fitToHeight = 0
        ws.sheet_properties.pageSetUpPr = openpyxl.worksheet.properties.PageSetupProperties(fitToPage=True)
    except Exception:
        pass


def _limit_text(value, unit):
    return "-" if value is None else "{0:g} {1}".format(value, unit)


def _result_rows(by, opts, crs, z_unit):
    """Rows of the result table: (measure, value, unit, compared with, result, basis, number kind)."""
    a = by[SUBSET_ALL]
    unit = crs["unit"]
    out = []
    standard = opts["standard"]
    if standard in (STANDARD_NSSDA, STANDARD_BOTH):
        if a["NSSDA_H95"] is not None:
            basis = "2.4477 x 0.5 x (RMSEx + RMSEy) (Appendix 3-A, Case 2); RMSEmin/RMSEmax = {0:.3f}".format(a["XY_RATIO"])
            value = a["NSSDA_H95"]
        else:
            basis = ("Not defined: RMSEmin/RMSEmax = {0} is below 0.6, outside Case 2 of Appendix 3-A. "
                     "Case 1 reference (1.7308 x RMSEr): {1:.4f} {2}".format(
                         ratio_text(a["XY_RATIO"]),
                         a["NSSDA_H_C1"] if a["NSSDA_H_C1"] is not None else float("nan"), unit))
            value = "not defined"
        limit = opts["nssda_h_limit_m"]
        out.append(("NSSDA horizontal accuracy at the 95 % confidence level", value, unit,
                    "claimed " + _limit_text(limit, "m") if limit is not None else "no claim given",
                    a["NSSDA_HRES"], basis, "len"))
        if a["NSSDA_V95"] is not None:
            limit = opts["nssda_v_limit_m"]
            out.append(("NSSDA vertical accuracy at the 95 % confidence level", a["NSSDA_V95"], z_unit,
                        "claimed " + _limit_text(limit, "m") if limit is not None else "no claim given",
                        a["NSSDA_VRES"], "1.9600 x RMSEz, over all check points with an elevation", "zlen"))
    if standard in (STANDARD_ASPRS, STANDARD_BOTH):
        if a["RMSEH_CM"] is not None:
            cls = opts["h_class_cm"]
            out.append(("ASPRS Ed. 2 horizontal accuracy, RMSEH", a["RMSEH_CM"], "cm",
                        "class " + _limit_text(cls, "cm") if cls else "no class given", a["H_RESULT"],
                        "sqrt(RMSEx^2 + RMSEy^2), combined with the check point survey accuracy RMSEH2 "
                        "when given", "cm"))
        nva, vva = by.get(SUBSET_NVA), by.get(SUBSET_VVA)
        cls = opts["v_class_cm"]
        if nva is not None and nva["RMSEV_CM"] is not None:
            out.append(("ASPRS Ed. 2 vertical accuracy, RMSEV (NVA)", nva["RMSEV_CM"], "cm",
                        "class " + _limit_text(cls, "cm") if cls else "no class given", nva["V_RESULT"],
                        "RMSEz of the non-vegetated check points, combined with RMSEV2 when given", "cm"))
        elif nva is None and a["RMSEV_CM"] is not None:
            out.append(("ASPRS Ed. 2 vertical accuracy, RMSEV (all check points)", a["RMSEV_CM"], "cm",
                        "class " + _limit_text(cls, "cm") if cls else "no class given", a["V_RESULT"],
                        "No terrain class field: all check points together, no NVA / VVA split", "cm"))
        if vva is not None and vva["RMSEV_CM"] is not None:
            out.append(("ASPRS Ed. 2 vertical accuracy, RMSEV (VVA)", vva["RMSEV_CM"], "cm",
                        "no threshold in the standard", vva["V_RESULT"], "Reported as found (ASPRS 7.4)", "cm"))
        if a["RMSE3D_CM"] is not None:
            out.append(("ASPRS Ed. 2 three-dimensional accuracy, RMSE3D", a["RMSE3D_CM"], "cm", "-", "-",
                        "sqrt(RMSEH^2 + RMSEV^2)", "cm"))
    return out


def _summary_sheet(sheet, ctx):
    ws = sheet.ws
    crs, opts, counts = ctx["crs"], ctx["opts"], ctx["counts"]
    summary = ctx["summary"]
    held = bool(counts.get("not_compared_checks"))
    by = dict((s["SUBSET"], s) for s in summary)
    a = by[SUBSET_ALL]
    unit = crs["unit"]
    z_unit = a.get("Z_UNIT") or unit
    for col, width in zip("ABCDEF", (50, 20, 20, 20, 26, 70)):
        ws.column_dimensions[col].width = width

    row = sheet.next()
    sheet.put(row, 1, "Positional Accuracy Report (NSSDA/ASPRS)", bold=True, size=14)
    row = sheet.next()
    sheet.put(row, 1, "Residual = feature minus check point. Distances in {0} (1 unit = {1:.10g} m) unless "
                      "a unit is written beside the value. Coordinate system: {2} (WKID {3}).".format(
                          unit, crs["mpu"], crs["name"], crs["wkid"]), italic=True)
    ws.freeze_panes = "A3"

    sheet.section("Inputs and method")
    for label, value in (("Features tested", ctx["features_path"]), ("Check points", ctx["checks_path"]),
                         ("Pairing", ctx["method_text"])):
        r = sheet.line((label, value))
        sheet.put(r, 1, label, bold=True)
    if ctx.get("tool_version"):
        r = sheet.line(("Tool", "Positional Accuracy Report (NSSDA/ASPRS) v" + str(ctx["tool_version"])))
        sheet.put(r, 1, "Tool", bold=True)

    sheet.section("Statements (the standards' sentences are written only when earned)")
    statements = ctx["statements"]
    if statements:
        for text in statements:
            sheet.paragraph(text)
    else:
        sheet.paragraph("No statement was written: there are no pairs.", italic=True)

    sheet.section("Result against the chosen standard(s)")
    sheet.header(("Measure", "Value", "Unit", "Compared with", "Result", "How it is computed"))
    if a["N_PAIRS"]:
        for measure, value, unit_text, compared, result, basis, kind in _result_rows(by, opts, crs, z_unit):
            r = sheet.next()
            sheet.put(r, 1, measure, wrap=True)
            if isinstance(value, float):
                sheet.put(r, 2, _round(value, kind), fmt=_number_format(kind, 4))
            else:
                sheet.put(r, 2, value)
            sheet.put(r, 3, unit_text, indent=True)
            sheet.put(r, 4, compared, wrap=True)
            sheet.put(r, 5, result, bold=True, fill=_result_fill(result, held))
            sheet.put(r, 6, basis, wrap=True)
            ws.row_dimensions[r].height = 15.0 * max(1, int(math.ceil(len(str(basis)) / 70.0)), int(math.ceil(len(str(measure)) / 48.0)))
    else:
        sheet.paragraph("No pairs were formed, so no accuracy statistics were computed.", italic=True)

    sheet.section("Counts")
    sheet.header(("Item", "Number", "", "", "", "Remark"))
    if not counts.get("features_absent", 0):
        unlisted = ""
    elif counts.get("absent_listed", True):
        unlisted = "listed in the Unpaired sheet"
    else:
        unlisted = "not listed in the Unpaired sheet; tick 'List Features Without a Check Point' to list them"
    count_rows = [
        ("Features read", counts["features"], ""),
        ("Check points read", counts["checks"], ""),
        ("Pairs formed", counts["pairs"], ""),
        ("Check points not paired", counts["unpaired_checks"], "always listed in the Unpaired sheet"),
        ("Features not paired", counts["unpaired_features"], "problems and plain absence together"),
        ("   of which have no check point", counts.get("features_absent", 0), unlisted)]
    if counts.get("keys_compared"):
        count_rows.append(("Pairs whose keys differ (KEY_DIFFERS)", counts.get("key_differs", 0),
                           "paired by distance and counted in every statistic; see FLAGS in the Detail sheet"))
    for label, value, remark in count_rows:
        r = sheet.next()
        sheet.put(r, 1, label)
        sheet.put(r, 2, value, fmt="0")
        sheet.put(r, 6, remark, wrap=True)

    if a["N_PAIRS"]:
        subsets = [s["SUBSET"] for s in summary]
        sheet.section("Statistics by subset")
        sheet.header(["Quantity"] + subsets + [""] * (3 - len(subsets)) + ["Unit", "Basis"])
        # one header: Quantity | ALL | NVA | VVA | Unit | Basis
        for label, field, kind, basis in _STAT_ROWS:
            values = [by[sub].get(field) for sub in subsets]
            if all(v is None or v == "" for v in values):
                continue
            r = sheet.next()
            sheet.put(r, 1, label)
            for i, (sub, v) in enumerate(zip(subsets, values)):
                if isinstance(v, float):
                    sheet.put(r, 2 + i, _round(v, kind), fmt=_number_format(kind, 4))
                elif isinstance(v, int) and not isinstance(v, bool):
                    sheet.put(r, 2 + i, v, fmt="0")
                else:
                    sheet.put(r, 2 + i, v, fill=_result_fill(v, held) if field.endswith("RESULT") or field.endswith("RES") else None)
            unit_text = {"len": unit, "zlen": z_unit, "cm": "cm"}.get(kind, "")
            sheet.put(r, 5, unit_text, indent=True)
            sheet.put(r, 6, basis, wrap=True)

    notes = list(ctx["notes"])
    for s in summary:
        if s.get("NOTES"):
            notes.append("{0}: {1}".format(s["SUBSET"], s["NOTES"]))
    if notes:
        sheet.section("Notes")
        for text in notes:
            sheet.paragraph(text)

    sheet.section("Constants and sources")
    sheet.paragraph("NSSDA: FGDC-STD-007.3-1998, Appendix 3-A (2.4477, 1.7308, 1.9600, ratio 0.6 to 1.0, at least "
                    "20 check points). ASPRS Positional Accuracy Standards for Digital Geospatial Data, Edition 2, "
                    "Version 2 (2024) (RMSEH, RMSEV, RMSE3D, at least 30 check points, mean error below 25 % of "
                    "the class, blunder above 3 x the class). Page references: docs/standards.md of the toolkit.",
                    italic=True)
    _page_setup(ws, sheet.ox)


def build_workbook(openpyxl, ctx):
    """Unsaved workbook (Summary, Detail, Unpaired). ``ctx`` keys: ``summary`` (summary rows), ``counts``,
    ``crs``, ``opts``, ``statements``, ``notes``, ``method_text``, ``features_path``, ``checks_path``,
    ``detail_header``, ``detail_rows``, ``unpaired_header``, ``unpaired_rows``, optional ``tool_version``."""
    workbook = openpyxl.Workbook()
    summary_ws = workbook.active
    summary_ws.title = "Summary"
    _summary_sheet(_Sheet(openpyxl, summary_ws), ctx)
    detail = _Sheet(openpyxl, workbook.create_sheet("Detail"))
    _table_sheet(detail, ctx["detail_header"], ctx["detail_rows"], _DETAIL_FORMATS)
    _page_setup(detail.ws, openpyxl)
    unpaired = _Sheet(openpyxl, workbook.create_sheet("Unpaired"))
    _table_sheet(unpaired, ctx["unpaired_header"], ctx["unpaired_rows"], {})
    _page_setup(unpaired.ws, openpyxl)
    return workbook


# ==========================================================================
# quality/tile_edge_core.py
# ==========================================================================
# Tile / sheet edge consistency check: pure-Python core (no arcpy).
#
# A tile index (map sheets, grid cells, work units) is a set of polygons. Two tiles
# share an **edge** where parts of their boundaries run along each other (within the
# *adjacency tolerance*) for a length above that tolerance. Tiles that only touch at a
# corner do not share an edge. The shared pieces are found from the boundary
# segments alone (no overlay), so a regular grid and an irregular sheet index with
# T-junctions are handled the same way. Tiles whose interiors overlap are reported
# (``TILE_OVERLAP``) and never stop the run.
#
# Features are checked on their own tile's side of each edge:
#
# * **Line ends.** The end point of every line part (closed parts have none) is
#   assigned to the tile that contains it; an end within the *snap distance* of a tile
#   boundary (the adjacency tolerance, never less than twice the coordinate
#   resolution) is on it and is assigned by looking back along the line, further than
#   the snap distance. An end within *edge distance* of a shared
#   edge of its tile is an **edge end**. Ends of the same layer in different,
#   touching tiles are paired one to one, nearest pairs first (ties: lower
#   ObjectID), when they are within *search distance* and at least one of the two
#   is an edge end. A pair within *tolerance* is **matched**; a pair farther apart
#   is ``END_OFFSET`` with the measured distance; an edge end without a partner is
#   ``DANGLING_END``. Paired ends are compared on the chosen fields
#   (``ATTRIBUTE_MISMATCH``).
# * **Points.** Two points of one layer in different touching tiles within
#   *tolerance* are ``POINT_DUPLICATE`` (and compared on the chosen fields). A point
#   within the snap distance of a tile boundary belongs to every tile whose boundary
#   it is on; it pairs with points of the neighbouring tile and with other points on
#   the same boundary; every point on a boundary, paired or not, is counted in the
#   statistics (``points_on_edge``). Points are
#   paired one to one, nearest first; a copy left over (a point stored in three tiles at
#   a corner) is reported with its nearest copy, so every copy is named in a row.
# * **Polygons.** A polygon *run* is a stretch of a polygon boundary that lies along
#   a shared edge (within edge distance), with the polygon on one side. Runs of
#   polygons on the two sides that overlap along the edge are pieces of one cut
#   feature: their attributes are compared, and where their facing boundaries are farther
#   apart than the *tolerance* (a gap between the halves, or one half passing the edge into
#   the other) the pair is ``POLYGON_GAP`` with the largest distance measured. A run with no
#   overlapping run on the other side is ``POLYGON_UNMATCHED``; a polygon with a run whose
#   area is below the *sliver area* is ``POLYGON_SLIVER``.
# * **Crossings** (optional). A line or polygon boundary that passes from one side of
#   a shared edge to the other inside the edge is ``EDGE_CROSSING``.
#
# Everything is planar, in the units of the coordinates (project to a metric system
# first, see ``common.projection``); ``unit_m`` (metres per unit) is only used to
# write distances in metres in the messages. Z and M values are ignored.
#
# All top-level names start with ``tile_`` / ``TILE_`` (a built toolbox is one module).

TILE_CHECKS = ("DANGLING_END", "END_OFFSET", "ATTRIBUTE_MISMATCH", "POLYGON_PIECE",
               "POINT_DUPLICATE", "EDGE_CROSSING")
TILE_DEFAULT_CHECKS = ("DANGLING_END", "END_OFFSET", "ATTRIBUTE_MISMATCH", "POLYGON_PIECE",
                       "POINT_DUPLICATE")
TILE_RULES = ("TILE_OVERLAP", "DANGLING_END", "END_OFFSET", "OVERSHOOT", "ATTRIBUTE_MISMATCH",
              "POLYGON_UNMATCHED", "POLYGON_GAP", "POLYGON_SLIVER", "POINT_DUPLICATE",
              "EDGE_CROSSING")

TILE_EPS = 1e-7        # slack added to every distance comparison (0.1 micrometre in metres)
TILE_ON = 1e-6         # smallest snap distance: a point this close to a boundary is "on" it
TILE_PROBE = 1e-3      # smallest offset used to find the side of a boundary segment
TILE_DETAIL_MAX_FIELDS = 6
TILE_DISTANCE_REFUSE = 0.25   # Search or Edge Distance above this share of the typical tile size: refused
TILE_DISTANCE_WARN = 0.10     # ... above this share: warned
TILE_MANY_ON_BOUNDARY = 5     # unpaired ends exactly on a tile boundary that are "many" (with a quarter of them)

TILE_STATUS_OK = "OK"
TILE_STATUS_ISSUES = "ISSUES"
TILE_STATUS_NO_DATA = "NO_DATA"
TILE_STATUS_OVERLAP = "TILES_OVERLAP"

_TILE_POINT_KINDS = ("point", "multipoint")


# --------------------------------------------------------------------------
# Small helpers
# --------------------------------------------------------------------------

def _tile_xy(p):
    """``(x, y)`` as floats, or ``None`` when a coordinate is missing or not finite."""
    try:
        x, y = float(p[0]), float(p[1])
    except (TypeError, ValueError, IndexError):
        return None
    return (x, y) if math.isfinite(x) and math.isfinite(y) else None


def _tile_clean(path):
    """The vertices of ``path`` as ``(x, y)`` tuples, or ``None`` if any vertex has a
    missing or non-finite coordinate."""
    out = []
    for p in path:
        q = _tile_xy(p)
        if q is None:
            return None
        out.append(q)
    return out


def _tile_dist(a, b):
    return math.hypot(b[0] - a[0], b[1] - a[1])


def tile_typical_size(tiles):
    """Typical size of the tiles: the median of the longer side of their bounding boxes (units of
    the coordinates), 0 when no tile has a usable coordinate. ``tiles``: ``[{"rings": ...}]``."""
    sizes = []
    for t in tiles:
        xs, ys = [], []
        for ring in t.get("rings") or ():
            for p in ring:
                q = _tile_xy(p)
                if q is not None:
                    xs.append(q[0])
                    ys.append(q[1])
        if xs:
            sizes.append(max(max(xs) - min(xs), max(ys) - min(ys)))
    return _tile_median(sizes, 0.0)


def tile_distance_check(typical, search, edge):
    """Is the Search or Edge Distance sensible for tiles of the typical size ``typical``?
    Returns ``(level, limit, share)``: ``level`` is ``"refuse"`` above a quarter of the typical
    size (nearly every line end would be an edge end and the pairing would compare every end
    with every other: the run time grows with the square of the number of ends), ``"warn"``
    above a tenth, else ``None``; ``limit`` is the largest distance that is not refused and
    ``share`` the larger of the two distances as a share of the typical size."""
    if not typical or typical <= 0:
        return None, 0.0, 0.0
    share = max(search, edge) / typical
    limit = TILE_DISTANCE_REFUSE * typical
    if share > TILE_DISTANCE_REFUSE:
        return "refuse", limit, share
    if share > TILE_DISTANCE_WARN:
        return "warn", limit, share
    return None, limit, share


def tile_options(options):
    """Validated copy of the options (distances in coordinate units).

    Keys: ``tolerance``, ``search``, ``edge``, ``adjacency``, ``sliver_area``,
    ``checks``, ``unit_m``, ``resolution`` (coordinate resolution, default 0),
    ``skip_connected`` (default true: a line end that touches another line is a node, not a
    dangling end, and is not paired as an offset), ``combine_layers`` (default false: all
    line layers are one dataset) and ``progress`` (optional callable taking a text).
    Raises ``ValueError`` with a plain message.

    Two values are derived. Coordinates are stored on a grid of ``resolution``, so two
    stored copies of one point can differ by that much: the *adjacency*
    and the *tolerance* are never less than ``2 * resolution``. The *snap distance*
    (``snap``) is the adjacency (at least ``TILE_ON``): a point that close to a tile
    boundary is on it. The *edge distance* is never less than the snap distance, and
    ``probe`` (how far back along a line its owner tile is looked up) is more than
    three snap distances.
    """
    o = dict(options or {})
    out = {}
    for key, default in (("tolerance", 0.0), ("search", None), ("edge", 0.0),
                         ("adjacency", 0.0), ("sliver_area", 0.0), ("resolution", 0.0)):
        value = o.get(key, default)
        if value is None:
            value = out.get("tolerance", 0.0)
        value = float(value)
        if not math.isfinite(value) or value < 0:
            raise ValueError("{0} must be zero or more".format(key))
        out[key] = value
    if out["search"] < out["tolerance"]:
        raise ValueError("search must be at least the tolerance")
    checks = o.get("checks")
    checks = set(c.upper() for c in (checks if checks else TILE_DEFAULT_CHECKS))
    unknown = sorted(checks - set(TILE_CHECKS))
    if unknown:
        raise ValueError("unknown check(s): {0}".format(", ".join(unknown)))
    out["checks"] = checks
    out["skip_connected"] = bool(o.get("skip_connected", True))
    out["combine_layers"] = bool(o.get("combine_layers", False))
    unit = float(o.get("unit_m") or 1.0)
    out["unit_m"] = unit if unit > 0 and math.isfinite(unit) else 1.0
    floor = 2.0 * out["resolution"]
    out["tolerance"] = max(out["tolerance"], floor)
    out["search"] = max(out["search"], out["tolerance"])
    out["adjacency"] = max(out["adjacency"], floor)
    out["snap"] = max(out["adjacency"], TILE_ON)
    out["edge"] = max(out["edge"], out["snap"])
    out["probe"] = max(TILE_PROBE, 3.0 * out["snap"])
    progress = o.get("progress")
    out["progress"] = progress if callable(progress) else None
    return out


def _tile_say(opts, text):
    if opts.get("progress") is not None:
        opts["progress"](text)


def _tile_fold_text(text):
    """NFC plus Arabic presentation forms to their letters (NFKC on those code points only);
    every other option of ``arabic_normalize`` is off."""
    return arabic_normalize(text, tashkeel=False, tatweel=False, alef=False, alef_maqsura=False,
                            teh_marbuta=False, persian=False, digits=False, presentation=True,
                            marks=False)


def tile_norm_value(value):
    """Comparable form of an attribute value: text is put in canonical Unicode form
    (NFC), Arabic presentation forms (U+FB50-FDFF, U+FE70-FEFE, for example the
    lam-alef ligature) are replaced by the letters they stand for, invisible marks
    (bidirectional marks, zero-width space, soft hyphen) are removed, it is trimmed, its
    white space collapsed and case folded; empty text and NaN are None. Other letter
    variants (Arabic and Persian yeh or kaf, alef forms, diacritics, Arabic-Indic digits
    against Latin digits) are NOT folded: they are different stored values."""
    if value is None:
        return None
    if isinstance(value, str):
        text = " ".join(remove_invisible(_tile_fold_text(value)).split()).casefold()
        return text or None
    if isinstance(value, float) and math.isnan(value):
        return None
    return value


def _tile_same_value(a, b):
    """Equal after normalising. Two integers are equal only when they are the same
    integer; floats are equal within a relative 1e-9 (absolute 1e-12), except that two
    whole-number floats (codes stored in a DOUBLE field) must be the same number. A boolean
    equals only the same boolean (True is not the integer 1)."""
    a, b = tile_norm_value(a), tile_norm_value(b)
    if a is None or b is None:
        return a is None and b is None
    if isinstance(a, bool) or isinstance(b, bool):
        return type(a) is type(b) and a == b
    da, db = isinstance(a, datetime.datetime), isinstance(b, datetime.datetime)
    if da != db and isinstance(a, datetime.date) and isinstance(b, datetime.date):
        # a date-only value (Pro DateOnly field) and a date with time (Date field): equal when
        # the time is midnight and the days are the same
        stamp, day = (a, b) if da else (b, a)
        return stamp.time() == datetime.time(0, 0) and stamp.date() == day
    num = (int, float)
    if isinstance(a, num) and isinstance(b, num) and not isinstance(a, bool) \
            and not isinstance(b, bool):
        if a == b:
            return True
        if isinstance(a, int) and isinstance(b, int):
            return False
        fa, fb = float(a), float(b)
        if fa.is_integer() and fb.is_integer():
            return False
        return math.isclose(fa, fb, rel_tol=1e-9, abs_tol=1e-12)
    return a == b


TILE_SHOW_MAX = 40


def _tile_show(value):
    text = "<empty>" if value is None else str(value)
    return text if len(text) <= TILE_SHOW_MAX else text[:TILE_SHOW_MAX - 3] + "..."


def _tile_show_window(text, start):
    """At most about ``TILE_SHOW_MAX`` characters of ``text`` from ``start``, with "..."
    where text is left out at either end."""
    body = TILE_SHOW_MAX - 6
    head = "..." if start > 0 else ""
    piece = text[start:start + body]
    tail = "..." if start + body < len(text) else ""
    return head + piece + tail


def _tile_show_differing(ta, tb):
    """Two long texts whose shortened forms are equal: show both from a little before
    the first character where they differ, so the reader sees the difference."""
    i = 0
    n = min(len(ta), len(tb))
    while i < n and ta[i] == tb[i]:
        i += 1
    start = max(0, i - 12)
    return _tile_show_window(ta, start), _tile_show_window(tb, start)


def _tile_kind(value):
    """Plain name of the stored type of an attribute value, for messages."""
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, int):
        return "integer"
    if isinstance(value, float):
        return "double"
    if isinstance(value, str):
        return "text"
    return type(value).__name__


def _tile_show_pair(a, b):
    """The two values of a difference as ``"a / b"``. When they print the same but are of
    different stored types (integer 1 and text '1'), the types are shown, so the reader can
    see why the row exists: ``1 (integer) / '1' (text)``."""
    sa, sb = _tile_show(a), _tile_show(b)
    if sa == sb and a is not None and b is not None:
        ta, tb = str(a), str(b)
        if ta != tb:
            sa, sb = _tile_show_differing(ta, tb)
    if sa == sb and a is not None and b is not None and _tile_kind(a) != _tile_kind(b):
        def typed(v, text):
            return "{0}{1}{0} ({2})".format("'" if isinstance(v, str) else "", text, _tile_kind(v))
        return "{0} / {1}".format(typed(a, sa), typed(b, sb))
    return "{0} / {1}".format(sa, sb)


def tile_attribute_differences(attrs_a, attrs_b, fields, fields_b=None):
    """``[(field, value_a, value_b), ...]`` for the fields on which two features differ.

    ``fields_b`` (same length as ``fields``) gives the stored names in the second feature when
    they differ from those of the first (two combined layers that store one listed field under
    different names, round 14 review, R14-1); the field is then shown as ``NAME_A/NAME_B``."""
    out = []
    for k, name in enumerate(fields):
        other = name if fields_b is None else fields_b[k]
        a, b = (attrs_a or {}).get(name), (attrs_b or {}).get(other)
        if not _tile_same_value(a, b):
            out.append((name if other == name else "{0}/{1}".format(name, other), a, b))
    return out


def _tile_compare_keys(layer):
    """``[(key, stored name)]`` of the fields a layer is compared on. ``key`` is what the user
    listed (normalised by the tool); a layer without ``compare_keys`` uses its stored names."""
    keys = layer.get("compare_keys")
    if keys is None:
        return [(name, name) for name in layer.get("compare") or []]
    return [(k, n) for k, n in keys]


def tile_compare_pairs(layer_a, layer_b):
    """``(fields_a, fields_b)``: the stored names on which a feature of ``layer_a`` and one of
    ``layer_b`` are compared, in the order of ``layer_a``. Two combined line layers are compared on
    every listed field that BOTH resolved, matched by the name the user listed and not by the stored
    name, so ``CLASS`` in one layer and ``Class`` or ``RD_CLASS`` (alias CLASS) in the other are
    compared (round 14 review, R14-1: they were silently not compared)."""
    if layer_a is layer_b:
        names = list(layer_a.get("compare") or [])
        return names, names
    in_b = {}
    for key, name in _tile_compare_keys(layer_b):
        in_b.setdefault(key, name)
    fields_a, fields_b, seen = [], [], set()
    for key, name in _tile_compare_keys(layer_a):
        if key in in_b and (name, in_b[key]) not in seen:
            seen.add((name, in_b[key]))
            fields_a.append(name)
            fields_b.append(in_b[key])
    return fields_a, fields_b


def _tile_merge(intervals):
    """Union of ``(lo, hi)`` intervals as a sorted list of disjoint intervals."""
    out = []
    for lo, hi in sorted(intervals):
        if out and lo <= out[-1][1] + TILE_EPS:
            if hi > out[-1][1]:
                out[-1] = (out[-1][0], hi)
        else:
            out.append((lo, hi))
    return out


def _tile_overlap_length(a, b):
    total = 0.0
    for lo1, hi1 in a:
        for lo2, hi2 in b:
            lo, hi = max(lo1, lo2), min(hi1, hi2)
            if hi > lo:
                total += hi - lo
    return total


def _tile_subtract(a, b):
    """Parts of the disjoint intervals ``a`` not covered by the disjoint intervals ``b``."""
    out = []
    for lo, hi in a:
        cur = lo
        for blo, bhi in b:
            if bhi <= cur or blo >= hi:
                continue
            if blo > cur:
                out.append((cur, blo))
            cur = max(cur, bhi)
        if cur < hi:
            out.append((cur, hi))
    return out


def _tile_median(values, default):
    values = sorted(v for v in values if v > 0 and math.isfinite(v))
    return values[len(values) // 2] if values else default


def _tile_seg_distance(a, b, c, d):
    """Smallest distance between segments ``a``-``b`` and ``c``-``d``."""
    hit = segment_intersection(a, b, c, d)
    if hit is not None:
        return 0.0
    return min(point_segment_distance(a, c, d)[0], point_segment_distance(b, c, d)[0],
               point_segment_distance(c, a, b)[0], point_segment_distance(d, a, b)[0])


def _tile_cross_properly(a, b, c, d):
    """True if segments ``a``-``b`` and ``c``-``d`` cross at a point inside both."""
    o1 = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
    o2 = (b[0] - a[0]) * (d[1] - a[1]) - (b[1] - a[1]) * (d[0] - a[0])
    if (o1 > 0) == (o2 > 0) or o1 == 0 or o2 == 0:
        return False
    o3 = (d[0] - c[0]) * (a[1] - c[1]) - (d[1] - c[1]) * (a[0] - c[0])
    o4 = (d[0] - c[0]) * (b[1] - c[1]) - (d[1] - c[1]) * (b[0] - c[0])
    return not ((o3 > 0) == (o4 > 0) or o3 == 0 or o4 == 0)


def _tile_inside_rings(rings, pt):
    """True if ``pt`` is strictly inside the (multi-ring) polygon by even-odd parity.

    The caller has already excluded points on the boundary. Scans every ring segment
    (used for feature polygons; tiles use ``_TileSegs.inside``)."""
    count = 0
    for ring in rings:
        state = point_in_ring(pt, ring)
        if state == "boundary":
            return False
        if state == "in":
            count += 1
    return count % 2 == 1


class _TileSegs(object):
    """The boundary segments of one tile, in a grid index when there are many, so that
    "is a point near the boundary" and "is a point inside" look at the segments around
    the point instead of at all of them (a tile boundary can have thousands of
    vertices)."""

    SMALL = 24      # up to this many segments they are simply scanned

    def __init__(self, segs, bbox, cell=None):
        self.segs = segs
        self.bbox = bbox
        self.index = None
        if len(segs) > self.SMALL:
            extent = max(bbox[2] - bbox[0], bbox[3] - bbox[1], 1e-6)
            lengths = [max(abs(b[0] - a[0]), abs(b[1] - a[1])) for a, b in segs]
            self.index = GridIndex(cell if cell else
                                   max(_tile_median(lengths, extent), extent / 128.0))
            for k, (a, b) in enumerate(segs):
                self.index.insert(k, (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]),
                                      max(a[1], b[1])))

    def _candidates(self, box, pad=0.0):
        if self.index is None:
            return range(len(self.segs))
        return self.index.query(box, pad)

    def near(self, box, pad):
        """Indexes of the segments whose bbox is within ``pad`` of ``box``."""
        return self._candidates(box, pad)

    def within(self, pt, radius):
        """True if some boundary segment is within ``radius`` of ``pt``."""
        for k in self._candidates((pt[0], pt[1], pt[0], pt[1]), radius):
            a, b = self.segs[k]
            if point_segment_distance(pt, a, b)[0] <= radius:
                return True
        return False

    def inside(self, pt):
        """True if ``pt`` is strictly inside (even-odd over all rings); a point within
        1e-9 of the boundary is not."""
        x, y = pt
        bb = self.bbox
        if x < bb[0] or x > bb[2] or y < bb[1] or y > bb[3]:
            return False
        if self.within(pt, 1e-9):
            return False
        leftwards = x - bb[0] < bb[2] - x           # cast the ray to the nearer side
        box = (bb[0], y, x, y) if leftwards else (x, y, bb[2], y)
        inside = False
        for k in self._candidates(box):
            a, b = self.segs[k]
            if (a[1] > y) != (b[1] > y):
                cross = a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
                if (cross < x) if leftwards else (x < cross):
                    inside = not inside
        return inside


# --------------------------------------------------------------------------
# Tiles: preparation, shared edges, overlaps
# --------------------------------------------------------------------------

def tile_prepare(tiles, skipped=None):
    """Tiles ``[{"oid", "label", "rings"}]`` -> list of prepared dicts (same order).

    Rings with fewer than three vertices or zero area are dropped; a ring with a
    missing or non-finite coordinate is dropped and appended to ``skipped`` (a list,
    when given). A tile with no ring left is ``empty`` and takes no part in the
    check."""
    out = []
    for pos, tile in enumerate(tiles):
        rings = []
        for ring in (tile.get("rings") or []):
            clean = _tile_clean(ring)
            if clean is None:
                if skipped is not None:
                    skipped.append(tile.get("label") if tile.get("label") is not None
                                   else tile.get("oid"))
                continue
            pts = close_ring(clean)
            if len(pts) >= 4 and abs(ring_signed_area(pts)) > 0:
                rings.append(pts)
        segs = []
        for ring in rings:
            for k in range(len(ring) - 1):
                if ring[k] != ring[k + 1]:
                    segs.append((ring[k], ring[k + 1]))
        bbox = None
        if rings:
            xs = [p[0] for r in rings for p in r]
            ys = [p[1] for r in rings for p in r]
            bbox = (min(xs), min(ys), max(xs), max(ys))
        out.append({"pos": pos, "oid": tile.get("oid"), "label": tile.get("label"),
                    "rings": rings, "segs": segs, "bbox": bbox, "empty": not rings,
                    "sindex": _TileSegs(segs, bbox) if rings else None})
    taken = set(str(t["label"]) for t in out if t["label"] is not None)
    for t in out:
        if t["label"] is None:
            t["label"] = tile_fallback_label(t["oid"], taken)
    return out


def tile_fallback_label(oid, taken):
    """Label of a tile without an ID: ``"OID n"``, or ``"OID n (no tile ID)"`` when a real
    tile ID is already the text ``"OID n"`` (``taken``: the set of real IDs as text), so the
    two tiles are not named alike in the outputs."""
    label = "OID {0}".format(oid)
    return label if label not in taken else "OID {0} (no tile ID)".format(oid)


def _tile_pair_analysis(ti, tj, band, min_len=None, use="a"):
    """Shared pieces of the boundaries of two tiles.

    Returns ``{"pieces": [(p, q), ...], "touch": bool, "cross": point or None}``.
    A stretch of a boundary segment ``a``-``b`` of one tile is shared where a segment
    ``c``-``d`` of the other tile runs along it: where the projection of ``c``-``d`` on
    ``a``-``b`` overlaps it, the points of ``a``-``b`` at both ends of that overlap are within
    ``band`` of the line through ``c``-``d`` (``_tile_side_stretches``). The stretches are
    found from both tiles. Stretches that follow each other along a boundary (a side drawn
    with many short segments) are one chain, and a chain is kept when it is longer than
    ``min_len`` (``band`` when not given), or when the chain found from the other tile along
    the same place is: the length is never judged one segment at a time, so a densely drawn
    side is not lost and the result does not depend on which tile comes first. The pieces
    are on the boundary of ``ti``; a long stretch found only from ``tj`` is added as it lies on
    ``tj`` (within ``band`` of ``ti``). A chain of collinear stretches is returned as one piece
    (vertices within half the band of the line are dropped). (Two segments that only cross,
    or that sit on a curve sampled with different vertices and differ by more than ``band``,
    form no piece.) ``touch``: the boundaries come within ``band`` of each other anywhere
    (an edge or a corner). ``cross``: a point where two boundary segments cross each other
    inside both (tiles overlapping)."""
    min_len = band if min_len is None else min_len
    side_a, touch_a, cross_a = _tile_side_stretches(ti, tj, band, use)
    side_b, touch_b, cross_b = _tile_side_stretches(tj, ti, band, use)
    chains_a, chains_b = _tile_chain_stretches(side_a), _tile_chain_stretches(side_b)
    long_b = [c for c in chains_b if _tile_chain_length(c) > min_len]
    near_b = _TileStretchIndex([s for c in long_b for s in c], band)
    kept = [c for c in chains_a if _tile_chain_length(c) > min_len
            or any(near_b.near(s, 2.0 * band) for s in c)]
    near_a = _TileStretchIndex([s for c in kept for s in c], band)
    for chain in long_b:
        run = []
        for s in chain + [None]:
            if s is not None and not near_a.near(s, 2.0 * band):
                run.append(s)
                continue
            if run and _tile_chain_length(run) > min_len:
                kept.append(run)
            run = []
    pieces = []
    for chain in kept:
        pts = _tile_simplify([chain[0][0]] + [s[1] for s in chain], 0.5 * band)
        pieces.extend((pts[k], pts[k + 1]) for k in range(len(pts) - 1))
    return {"pieces": pieces, "touch": touch_a or touch_b,
            "cross": cross_a if cross_a is not None else cross_b}


def _tile_chain_length(chain):
    return sum(_tile_dist(p, q) for p, q in chain)


def _tile_chain_stretches(stretches):
    """Stretches ``(p, q)`` in boundary order -> chains (lists of stretches) of stretches
    that follow each other (the end of one is the start of the next); the last chain of a
    ring joins the first when they meet."""
    chains = []
    for s in stretches:
        if chains and _tile_dist(chains[-1][-1][1], s[0]) <= 10.0 * TILE_EPS:
            chains[-1].append(s)
        else:
            chains.append([s])
    if len(chains) > 1 and _tile_dist(chains[-1][-1][1], chains[0][0][0]) <= 10.0 * TILE_EPS:
        chains[0] = chains.pop() + chains[0]
    return chains


def _tile_simplify(pts, tol):
    """Douglas-Peucker: the vertices of the path ``pts`` that are needed to keep every
    dropped vertex within ``tol`` of the simplified path (the ends are always kept)."""
    if len(pts) <= 2:
        return list(pts)
    keep = [False] * len(pts)
    keep[0] = keep[-1] = True
    tol2 = tol * tol
    stack = [(0, len(pts) - 1)]
    while stack:
        s, e = stack.pop()
        if e - s < 2:
            continue
        ax, ay = pts[s]
        dx, dy = pts[e][0] - ax, pts[e][1] - ay
        dd = dx * dx + dy * dy
        best, at = -1.0, None
        for k in range(s + 1, e):
            px, py = pts[k][0] - ax, pts[k][1] - ay
            t = (px * dx + py * dy) / dd if dd > 0 else 0.0
            if t < 0.0:
                t = 0.0
            elif t > 1.0:
                t = 1.0
            qx, qy = px - t * dx, py - t * dy
            d2 = qx * qx + qy * qy
            if d2 > best:
                best, at = d2, k
        if at is not None and best > tol2:
            keep[at] = True
            stack.append((s, at))
            stack.append((at, e))
    return [p for p, k in zip(pts, keep) if k]


class _TileStretchIndex(object):
    """Grid index of stretches ``(p, q)``: is a stretch within a distance of any of them?"""

    def __init__(self, stretches, band):
        self.items = stretches
        self.index = None
        if stretches:
            lengths = [_tile_dist(p, q) for p, q in stretches]
            cell = max(_tile_median(lengths, 1.0), max(lengths) / 64.0, 4.0 * band, 1e-6)
            self.index = GridIndex(cell)
            for k, (p, q) in enumerate(stretches):
                self.index.insert(k, (min(p[0], q[0]), min(p[1], q[1]), max(p[0], q[0]),
                                      max(p[1], q[1])))

    def near(self, s, radius):
        if self.index is None:
            return False
        p, q = s
        box = (min(p[0], q[0]), min(p[1], q[1]), max(p[0], q[0]), max(p[1], q[1]))
        for k in self.index.query(box, radius):
            c, d = self.items[k]
            if _tile_seg_distance(p, q, c, d) <= radius:
                return True
        return False


def _tile_side_stretches(ti, tj, band, use="a"):
    """Stretches of the boundary segments of ``ti`` along which a segment of ``tj`` runs
    (see ``_tile_pair_analysis``), in boundary order, the stretches of one segment merged,
    with no length limit. ``use``: which analysis segments of the tiles (see
    ``_tile_analysis_segments``; the stored segments when the tile has none). Returns
    ``(stretches, touch, cross)``."""
    pieces, touch, cross = [], False, None
    bj = tj["bbox"]
    sj = (tj.get("analysis") or {}).get(use, (None, tj["sindex"]))[1]
    for a, b in (ti.get("analysis") or {}).get(use, (ti["segs"], None))[0]:
        if max(a[0], b[0]) < bj[0] - band or min(a[0], b[0]) > bj[2] + band \
                or max(a[1], b[1]) < bj[1] - band or min(a[1], b[1]) > bj[3] + band:
            continue
        length = _tile_dist(a, b)
        ux, uy = (b[0] - a[0]) / length, (b[1] - a[1]) / length
        box = (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1]))
        intervals = []
        for k in sj.near(box, band):
            c, d = sj.segs[k]
            tc = (c[0] - a[0]) * ux + (c[1] - a[1]) * uy
            td = (d[0] - a[0]) * ux + (d[1] - a[1]) * uy
            lo, hi = max(0.0, min(tc, td)), min(length, max(tc, td))
            if hi - lo > TILE_EPS:
                cl = _tile_dist(c, d)
                vx, vy = (d[0] - c[0]) / cl, (d[1] - c[1]) / cl
                w_lo = vx * (a[1] + uy * lo - c[1]) - vy * (a[0] + ux * lo - c[0])
                w_hi = vx * (a[1] + uy * hi - c[1]) - vy * (a[0] + ux * hi - c[0])
                if abs(w_lo) <= band and abs(w_hi) <= band:
                    touch = True            # inside the span of c-d and within band of its line
                    intervals.append((lo, hi))
                    continue
            if not touch and _tile_seg_distance(a, b, c, d) <= band:
                touch = True
            if cross is None and _tile_cross_properly(a, b, c, d):
                hit = segment_intersection(a, b, c, d)
                if hit is not None and hit[0] == "point":
                    pt = hit[1]
                    if min(_tile_dist(pt, a), _tile_dist(pt, b), _tile_dist(pt, c),
                           _tile_dist(pt, d)) > band + TILE_EPS:
                        cross = pt
        for lo, hi in _tile_merge(intervals):
            if hi - lo > TILE_EPS:
                pieces.append((a if lo <= 0.0 else (a[0] + ux * lo, a[1] + uy * lo),
                               b if hi >= length else (a[0] + ux * hi, a[1] + uy * hi)))
    return pieces, touch, cross


def _tile_strictly_inside(tile, pt, margin):
    if tile["bbox"] is None:
        return False
    sx = tile["sindex"]
    return not sx.within(pt, margin) and sx.inside(pt)


def _tile_bboxes_overlap(a, b, margin):
    """True if the two bboxes overlap by more than ``margin`` in both directions (tiles whose
    bboxes only touch or overlap in a thin strip cannot share thick area)."""
    return min(a[2], b[2]) - max(a[0], b[0]) > margin and min(a[3], b[3]) - max(a[1], b[1]) > margin


def _tile_overlap_probe(ti, tj, band):
    """A point inside ``tj`` that lies just inside ``ti`` (so the two interiors share
    area thicker than about twice the tolerance), found by stepping from the
    boundary of ``ti`` into ``ti`` at a few places of every segment near ``tj``;
    ``None`` when there is none."""
    bj = tj["bbox"]
    delta = 2.0 * band + TILE_PROBE
    si = ti["sindex"]
    for a, b in ti["segs"]:
        if max(a[0], b[0]) < bj[0] - delta or min(a[0], b[0]) > bj[2] + delta \
                or max(a[1], b[1]) < bj[1] - delta or min(a[1], b[1]) > bj[3] + delta:
            continue
        length = _tile_dist(a, b)
        ux, uy = (b[0] - a[0]) / length, (b[1] - a[1]) / length
        nx, ny = -uy, ux
        for frac in (0.5, 0.25, 0.75):
            mx, my = a[0] + (b[0] - a[0]) * frac, a[1] + (b[1] - a[1]) * frac
            step = min(TILE_PROBE, length / 4.0)
            left = si.inside((mx + nx * step, my + ny * step))
            right = si.inside((mx - nx * step, my - ny * step))
            if left == right:
                continue
            sign = 1.0 if left else -1.0
            q = (mx + sign * nx * delta, my + sign * ny * delta)
            if _tile_strictly_inside(tj, q, band):
                return q
    return None


def _tile_piece_frame(tile, p, q, band):
    """Local frame of a shared piece: start ``p``, unit direction ``u``, unit
    normal ``n`` pointing into ``tile`` (the lower tile of the edge) and length."""
    length = _tile_dist(p, q)
    ux, uy = (q[0] - p[0]) / length, (q[1] - p[1]) / length
    mx, my = (p[0] + q[0]) / 2.0, (p[1] + q[1]) / 2.0
    step = min(max(TILE_PROBE, 3.0 * band), length / 4.0)
    nx, ny = -uy, ux
    sx = tile["sindex"]
    left = sx.inside((mx + nx * step, my + ny * step))
    right = sx.inside((mx - nx * step, my - ny * step))
    if right and not left:
        nx, ny = -nx, -ny
    elif left == right:
        nx, ny = uy, -ux           # Esri rings run clockwise: the interior is on the right
    return {"p": p, "q": q, "u": (ux, uy), "n": (nx, ny), "len": length}


def _tile_analysis_segments(tile, tol, use, reach):
    """Give a prepared tile ``analysis[use] = (segments, index)``: its boundary segments with
    the vertices that lie within ``tol`` of a straight run between their neighbours left out
    (a side densified with thousands of vertices on one line is one segment), in an index
    whose cells suit queries within ``reach``. Used only to find the shared stretches;
    everything else uses the stored segments."""
    segs = []
    for ring in tile["rings"]:
        pts = [ring[0]]
        for q in ring[1:]:
            if q != pts[-1]:
                pts.append(q)
        if tol > 0 and len(pts) > 4:
            pts = _tile_simplify(pts, tol)
            if len(pts) < 4:
                pts = [ring[0]] + [q for q in ring[1:]]
        segs.extend((pts[k], pts[k + 1]) for k in range(len(pts) - 1) if pts[k] != pts[k + 1])
    bb = tile["bbox"]
    extent = max(bb[2] - bb[0], bb[3] - bb[1], 1e-6)
    lengths = [max(abs(b[0] - a[0]), abs(b[1] - a[1])) for a, b in segs]
    cell = max(_tile_median(lengths, extent), 2.0 * reach, extent / 64.0, 1e-6)
    tile.setdefault("analysis", {})[use] = (segs, _TileSegs(segs, bb, cell))


def tile_edges(prep, adjacency, wide=0.0):
    """Shared edges, touching pairs and overlapping pairs of the prepared tiles.

    Returns ``{"edges": [edge, ...], "touch": set of (i, j), "overlaps": [...],
    "unshared": [...]}``.
    An edge is ``{"i", "j", "pieces": [frame, ...], "length", "overlap"}`` with
    ``i < j``; overlap-only pairs have no pieces. Every piece frame has its normal
    pointing into tile ``i``. ``unshared``: with ``wide`` above the adjacency, pairs of
    tiles whose boundaries run within ``wide`` of each other for more than ``wide``
    longer than the shared edge found (``{"i", "j", "close", "shared"}``): a gap, or a
    curved boundary sampled with different vertices."""
    band = adjacency + TILE_EPS
    live = [t for t in prep if not t["empty"]]
    edges, touch, overlaps, unshared = [], set(), [], []
    if len(live) < 2:
        return {"edges": edges, "touch": touch, "overlaps": overlaps, "unshared": unshared}
    for t in live:
        _tile_analysis_segments(t, 0.1 * adjacency, "a", band)
        if wide > band:
            _tile_analysis_segments(t, 0.05 * wide, "w", wide)
    sizes = [max(t["bbox"][2] - t["bbox"][0], t["bbox"][3] - t["bbox"][1]) for t in live]
    index = GridIndex(max(_tile_median(sizes, 1.0), 1e-6))
    for t in live:
        index.insert(t["pos"], t["bbox"])
    for i, j in index.candidate_pairs(band):
        ti, tj = prep[i], prep[j]
        found = _tile_pair_analysis(ti, tj, band)
        overlap_point = found["cross"]
        if overlap_point is None and _tile_bboxes_overlap(ti["bbox"], tj["bbox"], 2.0 * band + TILE_PROBE):
            overlap_point = _tile_overlap_probe(ti, tj, band) or _tile_overlap_probe(tj, ti, band)
        if found["touch"]:
            touch.add((i, j))
        frames = []
        for p, q in found["pieces"]:
            frame = _tile_piece_frame(ti, p, q, band)
            # A piece is a shared edge only when the other tile lies on the other
            # side of it; boundaries that run along each other with both tiles on
            # the same side belong to overlapping tiles.
            mx, my = (p[0] + q[0]) / 2.0, (p[1] + q[1]) / 2.0
            depth = 2.0 * band + TILE_PROBE
            same_side = _tile_strictly_inside(
                tj, (mx + frame["n"][0] * depth, my + frame["n"][1] * depth), band)
            if same_side:
                if overlap_point is None:
                    overlap_point = (mx, my)
                continue
            frames.append(frame)
        if overlap_point is not None:
            overlaps.append({"i": i, "j": j, "point": overlap_point})
        if frames or overlap_point is not None:
            edges.append({"i": i, "j": j, "pieces": frames,
                          "length": sum(f["len"] for f in frames),
                          "overlap": overlap_point is not None})
    if wide > band:
        shared = dict(((e["i"], e["j"]), e["length"]) for e in edges)
        overlapped = set((e["i"], e["j"]) for e in overlaps)
        for i, j in index.candidate_pairs(wide):
            if (i, j) in overlapped:
                continue
            close = sum(_tile_dist(p, q) for p, q in
                        _tile_pair_analysis(prep[i], prep[j], wide, band, "w")["pieces"])
            have = shared.get((i, j), 0.0)
            if close - have > wide:
                unshared.append({"i": i, "j": j, "close": close, "shared": have})
    return {"edges": edges, "touch": touch, "overlaps": overlaps, "unshared": unshared}


def tile_chain_pieces(frames):
    """Frames -> paths (lists of points), consecutive pieces that meet joined."""
    paths = []
    for f in frames:
        if paths and _tile_dist(paths[-1][-1], f["p"]) <= TILE_EPS * 10:
            paths[-1].append(f["q"])
        else:
            paths.append([f["p"], f["q"]])
    return paths


# --------------------------------------------------------------------------
# Locating points in tiles
# --------------------------------------------------------------------------

class _TileLocator(object):
    """Which tile holds a point: ``("in", pos)``, ``("on", [pos, ...])`` (within the
    snap distance of a boundary) or ``("out", None)``."""

    def __init__(self, prep, snap, probe):
        self.prep = prep
        self.snap = snap
        self.probe = probe
        live = [t for t in prep if not t["empty"]]
        sizes = [max(t["bbox"][2] - t["bbox"][0], t["bbox"][3] - t["bbox"][1]) for t in live]
        self.index = GridIndex(max(_tile_median(sizes, 1.0), 1e-6))
        for t in live:
            self.index.insert(t["pos"], t["bbox"])

    def locate(self, pt):
        ins, ons = [], []
        for pos in self.index.query((pt[0], pt[1], pt[0], pt[1]), self.snap):
            sx = self.prep[pos]["sindex"]
            if sx.within(pt, self.snap):
                ons.append(pos)
            elif sx.inside(pt):
                ins.append(pos)
        if ins:
            return "in", ins[0]
        if ons:
            return "on", ons
        return "out", None

    def owner_of_end(self, pt, toward):
        """Tile holding a line end. An end within the snap distance of a boundary is
        assigned by looking back along the line: ``toward`` is ``(vertices, from_end)``
        of the line part. It is probed at ``probe``, then three times as far, and so
        on along the line, then at its vertices, until a point is clear of the
        boundaries; the tile holding that point is the owner. ``None``
        when that point is in no tile, or when the line stays within the snap distance
        of the boundaries along its whole length (it runs along the boundary)."""
        state, value = self.locate(pt)
        if state == "in":
            return value
        if state == "out" or toward is None:
            return None
        pts, from_end = toward
        for q in _tile_probe_points(pts, from_end, self.probe):
            state2, value2 = self.locate(q)
            if state2 == "in":
                return value2
            if state2 == "out":
                return None
        return None


class _TilePieces(object):
    """Index of the shared pieces: nearest piece of given tile edges to a point."""

    def __init__(self, edges, reach):
        self.edges = edges
        self.reach = reach
        lengths = [f["len"] for e in edges for f in e["pieces"]]
        self.index = GridIndex(max(_tile_median(lengths, 1.0), 2.0 * reach, 1e-6))
        self.items = {}
        for ei, edge in enumerate(edges):
            for pi, f in enumerate(edge["pieces"]):
                p, q = f["p"], f["q"]
                key = (ei, pi)
                self.items[key] = f
                self.index.insert(key, (min(p[0], q[0]), min(p[1], q[1]),
                                        max(p[0], q[0]), max(p[1], q[1])))

    def near(self, pt, radius):
        """``[(distance, edge index, piece index)]`` within ``radius``, nearest first."""
        out = []
        for key in self.index.query((pt[0], pt[1], pt[0], pt[1]), radius):
            f = self.items[key]
            d = point_segment_distance(pt, f["p"], f["q"])[0]
            if d <= radius:
                out.append((d, key[0], key[1]))
        out.sort()
        return out


# --------------------------------------------------------------------------
# The check
# --------------------------------------------------------------------------

def _tile_label(prep, pos):
    tile = prep[pos]
    return tile["label"] if tile["label"] is not None else "OID {0}".format(tile["oid"])


class _TileRows(object):
    """Collects error rows and per-edge counters."""

    def __init__(self, prep, edges, unit_m):
        self.prep = prep
        self.edges = edges
        self.unit = unit_m
        self.errors = []
        self.counts = [dict((k, 0) for k in ("ends", "crossing", "matched", "offset",
                                              "dangling", "attr", "other"))
                       for _e in edges]
        self.by_pair = dict(((e["i"], e["j"]), n) for n, e in enumerate(edges))

    def metres(self, value):
        return value * self.unit

    def add(self, rule, layer, pos_a, pos_b, oid_a, oid_b, offset, fields, detail, point,
            edge_index, counter):
        self.errors.append({
            "rule": rule, "layer": layer,
            "tile_a": _tile_label(self.prep, pos_a) if pos_a is not None else None,
            "tile_b": _tile_label(self.prep, pos_b) if pos_b is not None else None,
            "oid_a": oid_a, "oid_b": oid_b,
            "offset": offset, "fields": ";".join(fields) if fields else None,
            "detail": detail, "point": point, "edge": edge_index})
        if edge_index is not None and counter:
            self.counts[edge_index][counter] += 1

    def attribute_rows(self, layer, pos_a, pos_b, oid_a, oid_b, attrs_a, attrs_b, fields,
                       offset, point, edge_index, what, fields_b=None):
        diffs = tile_attribute_differences(attrs_a, attrs_b, fields, fields_b)
        if not diffs:
            return
        shown = ["{0}: {1}".format(n, _tile_show_pair(a, b))
                 for n, a, b in diffs[:TILE_DETAIL_MAX_FIELDS]]
        if len(diffs) > TILE_DETAIL_MAX_FIELDS:
            shown.append("... {0} more".format(len(diffs) - TILE_DETAIL_MAX_FIELDS))
        self.add("ATTRIBUTE_MISMATCH", layer, pos_a, pos_b, oid_a, oid_b, offset,
                 [d[0] for d in diffs],
                 "{0} differ across the edge (tile {1} / tile {2}): {3}.".format(
                     what, _tile_label(self.prep, pos_a), _tile_label(self.prep, pos_b),
                     "; ".join(shown)),
                 point, edge_index, "attr")


def _tile_walk_back(pts, from_end, distance):
    """The point ``distance`` along the vertex path ``pts`` from its start (or from
    its end when ``from_end``); the far end of the path when it is shorter."""
    seq = pts[::-1] if from_end else pts
    rest = distance
    for k in range(len(seq) - 1):
        a, b = seq[k], seq[k + 1]
        seg = _tile_dist(a, b)
        if seg >= rest:
            f = rest / seg
            return (a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f)
        rest -= seg
    return seq[-1]


def _tile_probe_points(pts, from_end, start):
    """Points along the vertex path ``pts`` seen from one end: at ``start`` from it, then
    at three times as far and so on while inside the path, then the vertices (the
    far end last)."""
    seq = pts[::-1] if from_end else pts
    total = sum(_tile_dist(seq[k], seq[k + 1]) for k in range(len(seq) - 1))
    dist = start
    while dist < total:
        yield _tile_walk_back(pts, from_end, dist)
        dist *= 3.0
    for k in range(1, len(seq)):
        yield seq[k]


def _tile_layer_end_records(layer, li=0):
    """End records of the line parts of a layer, the parts themselves, and counts of what was
    skipped.

    ``toward`` of a record is ``(vertices, from_end)`` of its line part, used to find
    the tile an end on a boundary belongs to (``_TileLocator.owner_of_end``). ``li`` is the
    position of the layer in its group (several layers are one group when they are
    combined). ``parts`` lists ``(part id, vertices)`` of every part with a length,
    closed parts included, for the test whether an end touches another line."""
    ends, parts, skipped = [], [], {"null": [], "zero": 0, "closed": 0, "bad": 0}
    for row in layer["rows"]:
        shape = row.get("shape")
        if not shape:
            skipped["null"].append(row["oid"])
            continue
        for part_no, path in enumerate(shape, 1):
            clean = _tile_clean(path)
            if clean is None:
                skipped["bad"] += 1
                continue
            pts = []
            for q in clean:
                if not pts or q != pts[-1]:
                    pts.append(q)
            if len(pts) < 2:
                skipped["zero"] += 1
                continue
            parts.append(((li, row["oid"], part_no), pts))
            if _tile_dist(pts[0], pts[-1]) <= TILE_EPS:
                skipped["closed"] += 1
                continue
            for which, pt in ((0, pts[0]), (1, pts[-1])):
                ends.append({"oid": row["oid"], "part": part_no, "which": which, "pt": pt,
                             "li": li, "pid": (li, row["oid"], part_no),
                             "toward": (pts, which == 1),
                             "attrs": row.get("attrs") or {},
                             "key": (li, row["oid"], part_no, which)})
    return ends, parts, skipped


def _tile_point_records(layer):
    pts, null, bad = [], [], 0
    for row in layer["rows"]:
        shape = row.get("shape")
        if not shape:
            null.append(row["oid"])
            continue
        coords = [shape] if layer["kind"] == "point" else list(shape)
        for n, p in enumerate(coords):
            pt = _tile_xy(p)
            if pt is None:
                bad += 1
                continue
            pts.append({"oid": row["oid"], "part": n, "which": 0, "pt": pt, "toward": None,
                        "attrs": row.get("attrs") or {}, "key": (row["oid"], n, 0)})
    return pts, null, bad


def _tile_prepare_items(items, locator, pieces, reach, point_mode):
    """Keep the items near a shared piece, give each its owner tile(s) and its nearest
    edge of those tiles. A line end has one owner. A point within the snap distance of a
    boundary is on it and has every tile whose boundary it is on as owner. Returns the
    kept items and the number of points on a boundary."""
    kept, on_boundary = [], 0
    for item in items:
        near = pieces.near(item["pt"], reach)
        if not near:
            continue
        if point_mode:
            state, value = locator.locate(item["pt"])
            owners = [value] if state == "in" else (list(value) if state == "on" else [])
            if state == "on":
                on_boundary += 1
        else:
            owner = locator.owner_of_end(item["pt"], item["toward"])
            owners = [] if owner is None else [owner]
        if not owners:
            continue
        item["owner"], item["owners"] = owners[0], owners
        item["near"] = [(d, ei, pi) for d, ei, pi in near
                        if pieces.edges[ei]["i"] in owners or pieces.edges[ei]["j"] in owners]
        if item["near"]:
            item["edge_dist"], item["edge"] = item["near"][0][0], item["near"][0][1]
        else:
            item["edge_dist"], item["edge"] = None, None
        kept.append(item)
    return kept, on_boundary


def _tile_owner_pair(ia, ib, touch):
    """Owners ``(oa, ob)`` of two items that are different, touching tiles (the lowest
    such combination), or ``None``."""
    for oa in ia["owners"]:
        for ob in ib["owners"]:
            if oa != ob and (min(oa, ob), max(oa, ob)) in touch:
                return oa, ob
    return None


def _tile_pair_items(items, touch, max_dist, need_edge_end, edge_dist, join_tol=None, mark=None,
                     hidden=None, taken=None):
    """One-to-one pairs of items in different touching tiles within ``max_dist``,
    nearest first (ties: item keys). ``need_edge_end``: at least one of a pair must
    be within ``edge_dist`` of a shared edge of its tile. The owners of a paired item
    are set to the tiles the pair is in. ``join_tol``: when given, an item marked
    ``joined`` (its end touches another line) is only paired with an item within
    that distance: a node is not an offset end. The pairs within ``join_tol`` come
    first (nearest first), so ``mark(items)`` is called once with the items still
    unpaired, to set their ``joined`` flag, before the longer pairs are made: a pair
    within the tolerance never needs the flag. ``hidden``: a list that receives the
    pairs (item a, item b, distance) that were left out only because one of the two is
    joined, when both ends are still unpaired at the end: a junction end and an end
    within the Search Distance on the other side that did not meet. ``taken``: a list that
    receives, nearest first, ``(item, other, distance)`` for every possible pair left out only
    because ``other`` was already paired with a nearer item, when ``item`` is still unpaired at the
    end (round 13 review, R13-1: two ends on one side compete for one end on the other side)."""
    if not items:
        return []
    cell = max(max_dist, 1.0)
    grid, edge_grid = {}, {}
    is_edge = []
    for n, it in enumerate(items):
        cx, cy = int(math.floor(it["pt"][0] / cell)), int(math.floor(it["pt"][1] / cell))
        grid.setdefault((cx, cy), []).append(n)
        edge_item = _tile_is_edge_item(it, edge_dist)
        is_edge.append(edge_item)
        if need_edge_end and edge_item:
            edge_grid.setdefault((cx, cy), []).append(n)
    cands = []
    for a, ia in enumerate(items):
        gx, gy = int(math.floor(ia["pt"][0] / cell)), int(math.floor(ia["pt"][1] / cell))
        # a pair needs an edge item: an item that is not one only looks at edge items
        source = edge_grid if (need_edge_end and not is_edge[a]) else grid
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                for b in source.get((gx + dx, gy + dy), ()):
                    if b <= a and source is grid:
                        continue
                    if b == a:
                        continue
                    ib = items[b]
                    d = _tile_dist(ia["pt"], ib["pt"])
                    if d > max_dist + TILE_EPS:
                        continue
                    owners = _tile_owner_pair(ia, ib, touch)
                    if owners is None:
                        continue
                    if source is edge_grid and b < a and is_edge[b]:
                        continue            # that pair was found from the edge item b
                    cands.append((d, ia["key"], ib["key"], a, b, owners))
    cands.sort(key=lambda c: (c[0], c[1], c[2]))
    used, pairs, skipped, lost = set(), [], [], []
    restricted = False
    for d, _ka, _kb, a, b, owners in cands:
        if join_tol is not None and not restricted and d > join_tol + TILE_EPS:
            restricted = True                   # from here on a node is not a partner
            if mark is not None:
                mark([it for n, it in enumerate(items) if n not in used])
        if a in used or b in used:
            lost.append((a, b, d))
            continue
        if restricted and (items[a].get("joined") or items[b].get("joined")):
            skipped.append((a, b, d))
            continue
        used.add(a)
        used.add(b)
        items[a]["owner"], items[b]["owner"] = owners
        pairs.append((items[a], items[b], d))
    if join_tol is not None and not restricted and mark is not None:
        mark([it for n, it in enumerate(items) if n not in used])
    if hidden is not None:
        hidden.extend((items[a], items[b], d) for a, b, d in skipped
                      if a not in used and b not in used)
    if taken is not None:
        for a, b, d in lost:
            if (a in used) != (b in used):
                free, other = (b, a) if a in used else (a, b)
                taken.append((items[free], items[other], d))
    return pairs


def _tile_is_edge_item(item, edge_dist):
    return item["edge_dist"] is not None and item["edge_dist"] <= edge_dist + TILE_EPS


def _tile_pair_edge(rows, a, b):
    """Edge index a pair of items is counted on: the edge between their tiles when
    they share one, else the nearer of the two items' nearest edges."""
    i, j = min(a["owner"], b["owner"]), max(a["owner"], b["owner"])
    if (i, j) in rows.by_pair:
        return rows.by_pair[(i, j)]
    options = [(it["edge_dist"], it["edge"]) for it in (a, b) if it["edge"] is not None]
    return min(options)[1] if options else None


def _tile_overshoot(item, pieces, locator, opts, touch=None):
    """Does the line of an end that lies inside its tile come from the neighbouring tile?

    That is an **overshoot**: the line crosses a shared edge of the end's tile and stops
    no more than the edge distance beyond it (and more than the snap distance: nearer
    ends are on the edge). The line part is followed back from the end to its first
    crossing with a shared-edge piece; the end must lie within the edge distance of that
    edge (measured square to the edge, whatever the angle of the line), the length of
    line from the end back to the crossing must not exceed the search distance, and the
    first point beyond the crossing that is clear of all boundaries (found as for
    ``_TileLocator.owner_of_end``) must be in the tile on the other side of that edge.
    When the crossing is within the snap distance of a corner shared by three or more tiles,
    that point may instead be in any of those tiles that touches the end's tile (``touch``):
    the line came through the corner from a diagonal tile, and the depth is the distance
    from the end to the nearest edge of its tile with a tile of that corner.
    Returns ``None`` or ``{"origin": position of that tile, "depth": distance from the
    end to the edge it crossed, "along": length of line from the end to the crossing,
    "cross": the crossing point, "corner": true when the line came through a corner}``."""
    pts, from_end = item["toward"]
    seq = pts[::-1] if from_end else pts
    end = item["pt"]
    cands = [(ei, pi) for d, ei, pi in item["near"] if d <= opts["edge"] + TILE_EPS]
    if not cands:
        return None
    for k in range(len(seq) - 1):
        a, b = seq[k], seq[k + 1]
        best = None
        for ei, pi in cands:
            f = pieces.items[(ei, pi)]
            hit = segment_intersection(a, b, f["p"], f["q"])
            if hit is None:
                continue
            if hit[0] != "point":
                return None                      # the line runs along the edge
            t = _tile_dist(a, hit[1])
            if best is None or t < best[0]:
                best = (t, hit[1], ei)
        if best is None:
            continue
        cross, ei = best[1], best[2]
        along = _tile_dist(end, cross)
        edge = pieces.edges[ei]
        origin = edge["j"] if item["owner"] == edge["i"] else edge["i"]
        # The tiles whose boundary passes within the snap distance of the crossing. At a corner
        # shared by three or four tiles the line can come from a tile that only touches the
        # end's tile at that corner (round 9 review, R9-3): the crossing is then on the pieces
        # of both edges of the end's tile, and the line comes from the diagonal tile.
        state, meet = locator.locate(cross)
        meet = set(meet) if state == "on" else set()
        rest = [cross] + [q for q in seq[k + 1:] if q != cross]
        if len(rest) < 2:
            return None
        came = None
        for q in _tile_probe_points(rest, False, opts["probe"]):
            state, value = locator.locate(q)
            if state == "in":
                came = value
                break
            if state == "out":
                return None
        if came is None or came == item["owner"]:
            return None
        corner = False
        if came != origin:
            if came not in meet or len(meet) < 3 or (touch is not None and
                                                    (min(came, item["owner"]),
                                                     max(came, item["owner"])) not in touch):
                return None
            origin, corner = came, True
        # how far the end is beyond the edge: its distance to the crossed edge (its nearest
        # piece), not the length of line back to the crossing (longer for a slanted line).
        # Past a corner: its distance to the nearest edge of its tile with a tile of the corner.
        if corner:
            depth = min(d for d, ej, _pj in item["near"]
                        if (pieces.edges[ej]["i"] in meet and pieces.edges[ej]["j"] in meet))
        else:
            depth = min(d for d, ej, _pj in item["near"] if ej == ei)
        if depth <= opts["snap"] + TILE_EPS or depth > opts["edge"] + TILE_EPS \
                or along > opts["search"] + TILE_EPS:
            return None
        return {"origin": origin, "depth": depth, "along": along, "cross": cross,
                "corner": corner}
    return None


def _tile_part_reaches(pts, k, tpt, owner, locator):
    """Does the line part ``pts``, touched at ``tpt`` on its segment ``k``, lie in the tile
    ``owner`` there? Inside a tile that is the tile of the point; on a tile boundary it is
    the tile the part runs into on either side of ``tpt`` (the part is followed away from
    ``tpt`` as for ``_TileLocator.owner_of_end``). A part that only runs into the neighbour
    tile, such as the other half of a line cut at the edge, does not."""
    state, value = locator.locate(tpt)
    if state == "in":
        return value == owner
    if state == "out":
        return False
    for path in ([tpt] + pts[k::-1], [tpt] + pts[k + 1:]):
        seq = [path[0]]
        for q in path[1:]:
            if q != seq[-1]:
                seq.append(q)
        if len(seq) < 2:
            continue
        for q in _tile_probe_points(seq, False, locator.probe):
            state2, value2 = locator.locate(q)
            if state2 == "in":
                if value2 == owner:
                    return True
                break
            if state2 == "out":
                break
    return False


def _tile_overshoot_partners(items, opts):
    """For every end whose line passes the edge (``item["over"]``): the parts that start at an
    edge within the search distance of it in its own tile, and the other way round. They run
    along the overshooting line, so touching each other does not make an end a node.
    ``{item key: {part id}}``."""
    cell = max(opts["search"], 1.0)
    grid = {}
    for n, it in enumerate(items):
        if it.get("edge") is not None and it["edge_dist"] is not None \
                and it["edge_dist"] <= opts["edge"] + TILE_EPS:
            grid.setdefault((int(math.floor(it["pt"][0] / cell)),
                             int(math.floor(it["pt"][1] / cell))), []).append(n)
    out = {}
    for n, it in enumerate(items):
        if it.get("over") is None:
            continue
        gx, gy = int(math.floor(it["pt"][0] / cell)), int(math.floor(it["pt"][1] / cell))
        pids = set()
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                for m in grid.get((gx + dx, gy + dy), ()):
                    other = items[m]
                    if m != n and _tile_dist(it["pt"], other["pt"]) <= opts["search"] + TILE_EPS:
                        pids.add(other["pid"])
                        out.setdefault(other["key"], set()).add(it["pid"])
        out.setdefault(it["key"], set()).update(pids)
    return out


def _tile_mark_joined(items, parts, locator, opts, skip=None):
    """Set ``item["joined"]`` for every line end that touches another line part: a vertex
    or segment of a part other than the end's own (and not one of the parts in ``skip`` for
    that end), within the match tolerance, that lies in the tile of the end (see
    ``_tile_part_reaches``). Such an end is a node where lines meet, not the end of a line.
    Returns the number of joined items."""
    skip = skip or {}
    for it in items:
        it["joined"] = False
    if not items or not parts:
        return 0
    join = opts["tolerance"] + TILE_EPS
    cell = max(4.0 * opts["tolerance"], 8.0 * opts["snap"], 0.1 * opts["search"], 0.01)
    grid = {}
    for n, it in enumerate(items):
        grid.setdefault((int(math.floor(it["pt"][0] / cell)),
                         int(math.floor(it["pt"][1] / cell))), []).append(n)
    big = cell * 16.0                   # coarse cells: where there is an end at all
    coarse = set()
    for (gx, gy) in grid:
        coarse.add((int(math.floor(gx * cell / big)), int(math.floor(gy * cell / big))))
    floor = math.floor
    count = 0

    def occupied(x0, y0, x1, y1):
        """Is some coarse cell with an end touched by the box (padded by the tolerance)?"""
        for cx in range(int(floor((x0 - join) / big)), int(floor((x1 + join) / big)) + 1):
            for cy in range(int(floor((y0 - join) / big)), int(floor((y1 + join) / big)) + 1):
                if (cx, cy) in coarse:
                    return True
        return False

    for pid, pts in parts:
        xs = [q[0] for q in pts]
        ys = [q[1] for q in pts]
        if not occupied(min(xs), min(ys), max(xs), max(ys)):
            continue
        for k in range(len(pts) - 1):
            a, b = pts[k], pts[k + 1]
            if not occupied(min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1])):
                continue
            length = _tile_dist(a, b)
            steps = min(512, max(1, int(math.ceil(length / (4.0 * cell)))))
            seen = set()
            for st in range(steps):
                f0, f1 = st / float(steps), (st + 1) / float(steps)
                ax, ay = a[0] + (b[0] - a[0]) * f0, a[1] + (b[1] - a[1]) * f0
                bx, by = a[0] + (b[0] - a[0]) * f1, a[1] + (b[1] - a[1]) * f1
                if steps > 1 and not occupied(min(ax, bx), min(ay, by), max(ax, bx), max(ay, by)):
                    continue
                for gx in range(int(floor((min(ax, bx) - join) / cell)),
                                int(floor((max(ax, bx) + join) / cell)) + 1):
                    for gy in range(int(floor((min(ay, by) - join) / cell)),
                                    int(floor((max(ay, by) + join) / cell)) + 1):
                        for n in grid.get((gx, gy), ()):
                            if n in seen:
                                continue
                            seen.add(n)
                            it = items[n]
                            if it["joined"] or it["pid"] == pid or pid in skip.get(it["key"], ()):
                                continue
                            d, tpt, _t = point_segment_distance(it["pt"], a, b)
                            if d > join:
                                continue
                            if _tile_part_reaches(pts, k, tpt, it["owner"], locator):
                                it["joined"] = True
                                count += 1
    return count


def _tile_drop_connected(hidden, pairs, parts, opts):
    """The pairs of ``hidden`` (junction pairs left out by the filter) whose two ends are NOT
    already joined across the edge by a matched cut. An end x and an end y are joined when a
    pair of cut ends matched within the Match Tolerance has one end on a line part that
    touches x (within the tolerance) in the tile of x, and the other end on a line part that
    touches y in the tile of y: the network is connected there, so the two nodes are not a gap
    (round 4 review, R4-1). A connection through more than one line on a side is not followed."""
    if not hidden:
        return hidden
    tol = opts["tolerance"] + TILE_EPS
    shape = dict(parts)
    sides = []                              # (link number, owner, pid, bbox)
    for n, (a, b, d) in enumerate(pairs):
        if d > tol:
            continue
        for it in (a, b):
            pts = shape.get(it.get("pid"))
            if pts is None:
                continue
            xs = [q[0] for q in pts]
            ys = [q[1] for q in pts]
            sides.append((n, it["owner"], pts, (min(xs) - tol, min(ys) - tol,
                                                max(xs) + tol, max(ys) + tol)))
    if not sides:
        return hidden
    cell = 4.0 * max(opts["search"], 1.0)
    grid, big = {}, []                      # parts by cell of their box; very long parts apart
    for side in sides:
        x0, y0, x1, y1 = side[3]
        c0, c1 = int(math.floor(x0 / cell)), int(math.floor(x1 / cell))
        r0, r1 = int(math.floor(y0 / cell)), int(math.floor(y1 / cell))
        if (c1 - c0 + 1) * (r1 - r0 + 1) > 64:
            big.append(side)
            continue
        for cx in range(c0, c1 + 1):
            for cy in range(r0, r1 + 1):
                grid.setdefault((cx, cy), []).append(side)
    touched = {}

    def links_of(it):
        key = it["key"]
        if key not in touched:
            x, y = it["pt"]
            found = set()
            near = grid.get((int(math.floor(x / cell)), int(math.floor(y / cell))), [])
            for n, owner, pts, (x0, y0, x1, y1) in near + big:
                if owner != it["owner"] or x < x0 or x > x1 or y < y0 or y > y1:
                    continue
                for k in range(len(pts) - 1):
                    if point_segment_distance(it["pt"], pts[k], pts[k + 1])[0] <= tol:
                        found.add(n)
                        break
            touched[key] = found
        return touched[key]

    return [(x, y, d) for x, y, d in hidden
            if x["owner"] == y["owner"] or not (links_of(x) & links_of(y))]


def _tile_check_lines(group, combined, locator, pieces, rows, prep, touch, opts, stats):
    """Check the line ends of one layer, or of several layers taken as one dataset
    (``combined``). Returns the unpaired edge ends that were reported as ``DANGLING_END``
    (for the statistics)."""
    ends, parts = [], []
    for li, layer in enumerate(group):
        layer_ends, layer_parts, skipped = _tile_layer_end_records(layer, li)
        ends.extend(layer_ends)
        parts.extend(layer_parts)
        stats["null_geometry"].extend((layer["name"], o) for o in skipped["null"])
        stats["zero_length_parts"] += skipped["zero"]
        stats["closed_parts"] += skipped["closed"]
        stats["bad_coordinates"] += skipped["bad"]
    names = [layer["name"] for layer in group]
    where = "'{0}'".format(names[0]) if len(group) == 1 else \
        "the {0} combined layers".format(len(group))
    reach = opts["edge"] + opts["search"] + TILE_EPS
    kept, _on = _tile_prepare_items(ends, locator, pieces, reach, False)
    stats["ends"] += len(ends)
    stats["ends_near_edges"] += sum(1 for k in kept if _tile_is_edge_item(k, opts["edge"]))
    checks, unit = opts["checks"], opts["unit_m"]
    # The junction filter applies whenever line ends are paired, so an attribute-only run pairs the same
    # ends as the default run (round 11 review, R11-2: with ATTRIBUTE_MISMATCH alone the filter was off and
    # a free end was paired with, and compared against, a junction end of another road across the seam).
    use_join = opts["skip_connected"] and bool(
        set(("DANGLING_END", "END_OFFSET", "ATTRIBUTE_MISMATCH")) & set(checks))
    for it in kept:
        if _tile_is_edge_item(it, opts["edge"]) and it["edge"] is not None:
            rows.counts[it["edge"]]["ends"] += 1
            # an end that passed the edge may pair as an end of the tile its line comes from
            over = _tile_overshoot(it, pieces, locator, opts, touch)
            if over is not None:
                it["over"] = over
                it["owners"] = it["owners"] + [over["origin"]]
    for it in kept:
        it["joined"] = False
    partners = _tile_overshoot_partners(kept, opts) if use_join else {}

    def mark(free):
        _tile_mark_joined(free, parts, locator, opts, partners)

    hidden, taken = [], []
    pairs = _tile_pair_items(kept, touch, opts["search"], True, opts["edge"],
                             opts["tolerance"] if use_join else None, mark if use_join else None,
                             hidden, taken)
    # a pair whose two nodes are already joined across the edge by a correctly cut line is not a gap
    hidden = _tile_drop_connected(hidden, pairs, parts, opts)
    # a free edge end whose nearest partner on the other side is a junction end: the DANGLING_END
    # row names that end (round 10 review, R10-1), and the pair is not counted again below
    junction_partner = {}
    for x, y, d in hidden:          # nearest first
        for free, node in ((x, y), (y, x)):
            if not free.get("joined") and node.get("joined") \
                    and free["key"] not in junction_partner:
                junction_partner[free["key"]] = (node, d)
    # a free edge end whose nearest end on the other side was paired with a nearer end: the
    # DANGLING_END row names that end and the end it is paired with (round 13 review, R13-1)
    partner_of = {}
    for a, b, d in pairs:
        partner_of[a["key"]] = (b, d)
        partner_of[b["key"]] = (a, d)
    taken_by = {}
    for free, other, d in taken:        # nearest first
        if free["key"] not in taken_by and other["key"] in partner_of:
            taken_by[free["key"]] = (other, d)
    paired = set()
    for a, b, d in pairs:
        paired.add(a["key"])
        paired.add(b["key"])
        if b["owner"] < a["owner"]:
            a, b = b, a
        edge = _tile_pair_edge(rows, a, b)
        mid = ((a["pt"][0] + b["pt"][0]) / 2.0, (a["pt"][1] + b["pt"][1]) / 2.0)
        passed = [x for x in (a, b) if x.get("over") is not None and x["owner"] == x["over"]["origin"]]
        name_a = names[a["li"]]
        other_layer = "" if a["li"] == b["li"] else " (OID {0} is in layer '{1}')".format(
            b["oid"], names[b["li"]])
        if d <= opts["tolerance"] + TILE_EPS:
            if edge is not None:
                rows.counts[edge]["matched"] += 1
        elif passed and "END_OFFSET" in checks:
            # an end passed the edge (the other end is in the tile it passed into): the line was not
            # cut at the edge. Two items of different tiles keep their own tiles, so at most one
            # end of a pair can have passed.
            far = passed[0]
            near_end = b if far is a else a
            how = ("The line of OID {0} (tile {1}) passes {2} tile {3} and ends "
                   "{4:.3f} m beyond {5}{6}".format(
                       far["oid"], _tile_label(prep, far["owner"]),
                       "the corner it shares with" if far["over"].get("corner") else "the edge to",
                       _tile_label(prep, near_end["owner"]),
                       far["over"]["depth"] * unit,
                       "the nearest edge of that tile" if far["over"].get("corner") else "it",
                       " ({0:.3f} m along the line)".format(far["over"]["along"] * unit)
                       if (far["over"]["along"] - far["over"]["depth"]) * unit >= 0.0005 else ""))
            rows.add("OVERSHOOT", names[far["li"]], far["owner"], near_end["owner"], far["oid"],
                     near_end["oid"], far["over"]["depth"], None,
                     "{0}; the line end of OID {1} (tile {2}) is {3:.3f} m from it, more than "
                     "the tolerance {4:.3f} m. The line was probably not cut at the edge.{5}"
                     .format(how, near_end["oid"], _tile_label(prep, near_end["owner"]),
                             d * unit, opts["tolerance"] * unit,
                             "" if far["li"] == near_end["li"] else
                             " (OID {0} is in layer '{1}')".format(near_end["oid"],
                                                                   names[near_end["li"]])),
                     far["pt"], edge, "offset")
        elif "END_OFFSET" in checks:
            rows.add("END_OFFSET", name_a, a["owner"], b["owner"], a["oid"], b["oid"], d,
                     None,
                     "Line ends of OID {0} (tile {1}) and OID {2} (tile {3}) are {4:.3f} m "
                     "apart; the tolerance is {5:.3f} m.{6}".format(
                         a["oid"], _tile_label(prep, a["owner"]), b["oid"],
                         _tile_label(prep, b["owner"]), d * unit, opts["tolerance"] * unit,
                         other_layer),
                     mid, edge, "offset")
        if "ATTRIBUTE_MISMATCH" in checks:
            fields, fields_b = tile_compare_pairs(group[a["li"]], group[b["li"]])
            if fields:
                rows.attribute_rows(name_a, a["owner"], b["owner"], a["oid"], b["oid"],
                                    a["attrs"], b["attrs"], fields, d, mid, edge,
                                    "Attributes of OID {0} and OID {1}{2}".format(
                                        a["oid"], b["oid"], other_layer), fields_b)
    dangling, done = [], set()
    for it in kept:
        if it["key"] in paired or not _tile_is_edge_item(it, opts["edge"]):
            continue
        if it["joined"]:
            stats["ends_connected"] += 1          # an edge end without a partner that is a junction
            continue
        if "DANGLING_END" not in checks:
            continue
        ei = it["edge"]
        edge = pieces.edges[ei]
        other = edge["j"] if it["owner"] == edge["i"] else edge["i"]
        node = junction_partner.get(it["key"])
        lost = taken_by.get(it["key"])
        if lost is not None and (node is None or lost[1] < node[1]):
            ob, od = lost
            mate, md = partner_of[ob["key"]]
            rows.add("DANGLING_END", names[it["li"]], it["owner"], other, it["oid"], ob["oid"], od,
                     None,
                     "Line end of OID {0} (part {1}) lies {2:.3f} m from the edge shared with "
                     "tile {3}. The nearest line end on the other side, of OID {4} (tile {5}){6}, "
                     "is {7:.3f} m away but is already paired with the line end of OID {8} (tile {9}"
                     "{10}), {11:.3f} m from it; a line end is paired with one other end only. If both "
                     "lines should continue across the edge, one continuation is missing."
                     .format(it["oid"], it["part"], it["edge_dist"] * unit, _tile_label(prep, other),
                             ob["oid"], _tile_label(prep, ob["owner"]),
                             "" if ob["li"] == it["li"] else " in layer '{0}'".format(names[ob["li"]]),
                             od * unit, mate["oid"], _tile_label(prep, mate["owner"]),
                             "" if mate["li"] == it["li"] else ", layer '{0}'".format(names[mate["li"]]),
                             md * unit),
                     it["pt"], ei, "dangling")
        elif node is None:
            rows.add("DANGLING_END", names[it["li"]], it["owner"], other, it["oid"], None, None,
                     None,
                     "Line end of OID {0} (part {1}) lies {2:.3f} m from the edge shared with "
                     "tile {3}; no line end of {4} within {5:.3f} m on the other side."
                     .format(it["oid"], it["part"], it["edge_dist"] * unit,
                             _tile_label(prep, other), where, opts["search"] * unit),
                     it["pt"], ei, "dangling")
        else:
            nb, nd = node
            rows.add("DANGLING_END", names[it["li"]], it["owner"], other, it["oid"], nb["oid"], nd,
                     None,
                     "Line end of OID {0} (part {1}) lies {2:.3f} m from the edge shared with "
                     "tile {3}. The nearest line end on the other side, of OID {4} (tile {5}){6}, "
                     "is {7:.3f} m away, more than the tolerance {8:.3f} m, and touches another "
                     "line there (a junction), so the two were not paired. If the lines should "
                     "meet, connect them.".format(
                         it["oid"], it["part"], it["edge_dist"] * unit, _tile_label(prep, other),
                         nb["oid"], _tile_label(prep, nb["owner"]),
                         "" if nb["li"] == it["li"] else " in layer '{0}'".format(names[nb["li"]]),
                         nd * unit, opts["tolerance"] * unit),
                     it["pt"], ei, "dangling")
            done.add(it["key"])
        dangling.append(it)
    # several line ends meet at one junction: count the places, not the combinations of ends. A
    # place already reported as a DANGLING_END row with its junction partner is not counted.

    def place(x, y):
        return tuple(sorted((tuple(round(v, 3) for v in x["pt"]), tuple(round(v, 3) for v in y["pt"]))))

    shown = set(place(it, junction_partner[it["key"]][0])
                for it in kept if it["key"] in done)
    stats["junction_pairs_not_reported"] += len(set(place(x, y) for x, y, _d in hidden) - shown)
    stats["boundary_ends"] += sum(1 for k in kept if not k["joined"]
                                  and k["edge_dist"] is not None
                                  and k["edge_dist"] <= opts["snap"] + TILE_EPS)
    return dangling


def _tile_check_points(layer, locator, pieces, rows, prep, touch, opts, stats):
    points, null, bad = _tile_point_records(layer)
    stats["null_geometry"].extend((layer["name"], o) for o in null)
    stats["bad_coordinates"] += bad
    reach = opts["tolerance"] + opts["adjacency"] + TILE_EPS
    kept, on_boundary = _tile_prepare_items(points, locator, pieces, reach, True)
    stats["points_on_edge"] += on_boundary
    checks = opts["checks"]
    pairs = _tile_pair_items(kept, touch, opts["tolerance"], False, 0.0)
    found = [(a, b, d, "twice") for a, b, d in pairs]
    found.extend((a, b, d, "more") for a, b, d in
                 _tile_extra_copies(kept, pairs, touch, opts["tolerance"]))
    for a, b, d, how in found:
        if b["owner"] < a["owner"]:
            a, b = b, a
        edge = _tile_pair_edge(rows, a, b)
        if "POINT_DUPLICATE" in checks:
            if a["oid"] == b["oid"]:
                # two points of one multipoint feature (round 11 review, minor note)
                who = "Two points of the same multipoint OID {0}, one in tile {1} and one in tile {2},".format(
                    a["oid"], _tile_label(prep, a["owner"]), _tile_label(prep, b["owner"]))
            else:
                who = "Points of OID {0} (tile {1}) and OID {2} (tile {3})".format(
                    a["oid"], _tile_label(prep, a["owner"]), b["oid"], _tile_label(prep, b["owner"]))
            rows.add("POINT_DUPLICATE", layer["name"], a["owner"], b["owner"], a["oid"], b["oid"],
                     d, None,
                     "{0} are {1:.3f} m apart on both sides of an edge: the point exists {2}.".format(
                         who, d * opts["unit_m"],
                         "twice" if how == "twice" else "more than twice (a third copy)"),
                     a["pt"], edge, "other")
        if "ATTRIBUTE_MISMATCH" in checks and layer["compare"]:
            rows.attribute_rows(layer["name"], a["owner"], b["owner"], a["oid"], b["oid"],
                                a["attrs"], b["attrs"], layer["compare"], d, a["pt"], edge,
                                "Attributes of the points OID {0} and OID {1}".format(
                                    a["oid"], b["oid"]))


def _tile_extra_copies(items, pairs, touch, max_dist):
    """Points left over by the one-to-one pairing that still have a copy in a different,
    touching tile within ``max_dist`` (a point stored in three tiles at a corner): each
    is returned with its nearest such copy (ties: item keys) as ``(item, copy, distance)``.
    The returned items are shallow copies whose ``owner`` is the tile of that pair, so the
    owners of the pairs already made are not changed."""
    paired = set()
    for a, b, _d in pairs:
        paired.add(id(a))
        paired.add(id(b))
    left = [it for it in items if id(it) not in paired]
    if not left:
        return []
    cell = max(max_dist, 1.0)
    grid = {}
    for n, it in enumerate(items):
        grid.setdefault((int(math.floor(it["pt"][0] / cell)),
                         int(math.floor(it["pt"][1] / cell))), []).append(n)
    out = []
    for ia in left:
        gx, gy = int(math.floor(ia["pt"][0] / cell)), int(math.floor(ia["pt"][1] / cell))
        best = None
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                for b in grid.get((gx + dx, gy + dy), ()):
                    ib = items[b]
                    if ib is ia:
                        continue
                    d = _tile_dist(ia["pt"], ib["pt"])
                    if d > max_dist + TILE_EPS:
                        continue
                    owners = _tile_owner_pair(ia, ib, touch)
                    if owners is None:
                        continue
                    cand = (d, ib["key"], b, owners)
                    if best is None or cand[:2] < best[:2]:
                        best = cand
        if best is not None:
            d, _k, b, (oa, ob) = best
            out.append((dict(ia, owner=oa), dict(items[b], owner=ob), d))
    return out


def _tile_polygon_features(layer):
    """Polygon features as closed rings. Returns the features, the OIDs without usable
    geometry and the number of rings skipped for a missing or non-finite coordinate."""
    feats, null, bad = [], [], 0
    for row in layer["rows"]:
        shape = row.get("shape")
        if not shape:
            null.append(row["oid"])
            continue
        rings = []
        for r in shape:
            clean = _tile_clean(r)
            if clean is None:
                bad += 1
                continue
            ring = close_ring(clean)
            if len(ring) >= 4:
                rings.append(ring)
        if not rings:
            if not any(_tile_clean(r) is None for r in shape):
                null.append(row["oid"])
            continue
        xs = [p[0] for r in rings for p in r]
        ys = [p[1] for r in rings for p in r]
        feats.append({"oid": row["oid"], "rings": rings, "attrs": row.get("attrs") or {},
                      "bbox": (min(xs), min(ys), max(xs), max(ys))})
    return feats, null, bad


def _tile_feature_index(feats):
    if not feats:
        return None
    sizes = [max(f["bbox"][2] - f["bbox"][0], f["bbox"][3] - f["bbox"][1]) for f in feats]
    xs = [f["bbox"][0] for f in feats] + [f["bbox"][2] for f in feats]
    ys = [f["bbox"][1] for f in feats] + [f["bbox"][3] for f in feats]
    extent = max(max(xs) - min(xs), max(ys) - min(ys), 1.0)
    index = GridIndex(max(_tile_median(sizes, 1.0), extent / 200.0, 1e-6))
    for n, f in enumerate(feats):
        index.insert(n, f["bbox"])
    return index


def _tile_band_cut(c, d, frame, limit):
    """The part of the segment ``c``-``d`` that lies within ``limit`` of the line of the piece
    ``frame``, as ``(tc, sc, td, sd)`` (``t`` along the piece from its start, ``s`` from its line
    along the normal), or ``None`` when no part of it does."""
    p, (ux, uy), (nx, ny) = frame["p"], frame["u"], frame["n"]
    sc = (c[0] - p[0]) * nx + (c[1] - p[1]) * ny
    sd = (d[0] - p[0]) * nx + (d[1] - p[1]) * ny
    tc = (c[0] - p[0]) * ux + (c[1] - p[1]) * uy
    td = (d[0] - p[0]) * ux + (d[1] - p[1]) * uy
    if abs(sc) <= limit and abs(sd) <= limit:
        return tc, sc, td, sd
    if sc == sd:
        return None                              # parallel to the line and outside the band
    f0, f1 = sorted(((-limit - sc) / (sd - sc), (limit - sc) / (sd - sc)))
    f0, f1 = max(f0, 0.0), min(f1, 1.0)
    if f1 <= f0:
        return None
    return (tc + (td - tc) * f0, sc + (sd - sc) * f0 if f0 > 0.0 else sc,
            tc + (td - tc) * f1, sc + (sd - sc) * f1 if f1 < 1.0 else sd)


def _tile_reach(near, tm, sm, cap):
    """Distances from ``(tm, sm)`` (piece coordinates) to the nearest boundary segment of
    ``near`` (``(tc, sc, td, sd)`` tuples) straight across the edge line, on the side the normal
    points to and on the other side; ``cap`` when there is none that near. The segment the point
    lies on (distance 0) does not count."""
    plus = minus = cap
    for tc, sc, td, sd in near:
        if tc > td:
            tc, sc, td, sd = td, sd, tc, sc
        if tm < tc - TILE_EPS or tm > td + TILE_EPS:
            continue
        if td - tc <= TILE_EPS:
            values = (sc, sd)                    # square to the edge: its nearer end
        else:
            f = min(max((tm - tc) / (td - tc), 0.0), 1.0)
            values = (sc + (sd - sc) * f,)
        for v in values:
            dv = v - sm
            if dv > TILE_EPS:
                plus = min(plus, dv)
            elif dv < -TILE_EPS:
                minus = min(minus, -dv)
    return plus, minus


def _tile_covering(feats, findex, skip, t, side, frame, snap):
    """ObjectID of the first polygon (in layer order) other than ``feats[skip]`` that covers the point
    at ``t`` along the piece ``frame``, just across the edge line on ``side`` (more than the snap
    distance from it), or ``None``."""
    p, (ux, uy), (nx, ny) = frame["p"], frame["u"], frame["n"]
    d = side * (snap + TILE_PROBE)
    pt = (p[0] + ux * t + nx * d, p[1] + uy * t + ny * d)
    found = []
    for m in findex.query((pt[0], pt[1], pt[0], pt[1]), 0.0):
        if m != skip and _tile_inside_rings(feats[m]["rings"], pt):
            found.append(feats[m]["oid"])
    return found[0] if found else None


def _tile_check_polygons(layer, pieces, rows, prep, opts, stats, feats, findex, sliver_seen):
    """Polygon runs along every shared piece: matched halves, unmatched runs, slivers."""
    checks = opts["checks"]
    band = opts["edge"] + TILE_EPS
    snap = opts["snap"]
    reach = 4.0 * band + TILE_PROBE
    run_min = max(opts["tolerance"], opts["adjacency"], 1e-6)
    seen_pairs, seen_unmatched = set(), set()
    for ei, edge in enumerate(pieces.edges):
        for pi, frame in enumerate(edge["pieces"]):
            p, (ux, uy), (nx, ny), length = frame["p"], frame["u"], frame["n"], frame["len"]
            box = (min(p[0], frame["q"][0]), min(p[1], frame["q"][1]),
                   max(p[0], frame["q"][0]), max(p[1], frame["q"][1]))
            runs = {1: {}, -1: {}}
            over = {1: {}, -1: {}}              # runs of halves that pass the edge line
            recs = {1: {}, -1: {}}              # (lo, hi, tc, sc, td, sd) of every run segment
            ring_ids = {1: {}, -1: {}}          # rings of the feature that have a run on each side
            for n in findex.query(box, band):
                f = feats[n]
                # Every boundary segment of the feature near the piece, cut to the band in which a
                # boundary across a run is looked for (``reach``): used to measure how far the
                # polygon reaches from a run segment across the edge line.
                near = []
                for ring in f["rings"]:
                    for k in range(len(ring) - 1):
                        cut = _tile_band_cut(ring[k], ring[k + 1], frame, reach)
                        if cut is not None:
                            near.append(cut)
                for r_id, ring in enumerate(f["rings"]):
                    for k in range(len(ring) - 1):
                        # The part of the segment within the Edge Distance of the edge line: a
                        # segment that leaves the band is cut there, not dropped, so the result
                        # does not depend on how many vertices a boundary is drawn with.
                        cut = _tile_band_cut(ring[k], ring[k + 1], frame, band)
                        if cut is None:
                            continue
                        tc, sc, td, sd = cut
                        lo, hi = max(0.0, min(tc, td)), min(length, max(tc, td))
                        if hi - lo <= TILE_EPS:
                            continue
                        tm = (lo + hi) / 2.0
                        sm = sc + (sd - sc) * (tm - tc) / (td - tc)
                        mx, my = p[0] + ux * tm + nx * sm, p[1] + uy * tm + ny * sm
                        # How far the polygon boundary is from this segment across the edge line
                        # (along the normal, at the middle of the segment's stretch): the probes
                        # that find the polygon's side are never farther than half of that, so a
                        # polygon thinner than the probe distance still has a side.
                        reach_plus, reach_minus = _tile_reach(near, tm, sm, reach)
                        step_p = min(TILE_PROBE, reach_plus / 2.0)
                        step_m = min(TILE_PROBE, reach_minus / 2.0)
                        q_plus = (mx + nx * step_p, my + ny * step_p)
                        q_minus = (mx - nx * step_m, my - ny * step_m)
                        plus = _tile_inside_rings(f["rings"], q_plus)
                        minus = _tile_inside_rings(f["rings"], q_minus)
                        if plus and minus and len(f["rings"]) > 1:
                            # Two rings of the feature meet along this segment (a multipart
                            # polygon with one part in each tile): this segment bounds the part
                            # of its own ring, on the side inside that ring.
                            plus = point_in_ring(q_plus, ring) == "in"
                            minus = point_in_ring(q_minus, ring) == "in"
                        if plus == minus:
                            continue
                        side = 1 if plus else -1
                        # The polygon fills the stretch from ``sm`` to ``far`` across the edge
                        # line (distances from the line along the normal).
                        far = sm + side * (reach_plus if plus else reach_minus)
                        target = runs
                        if side * sm >= -snap:
                            # On its own side of the edge line, or on it: a run of the tile on
                            # that side only when the polygon lies mostly on that side there. A
                            # polygon thinner than the snap distance that lies on the other side
                            # (a thin strip along the seam in the neighbouring tile) is not a
                            # run of this tile; one centred on the line belongs to tile i.
                            middle = (sm + far) / 2.0
                            if not (side * middle > TILE_EPS or (abs(middle) <= TILE_EPS and side == 1)):
                                continue
                        else:
                            # The polygon is on the far side of this boundary segment as seen
                            # from the edge line: the far side of a polygon that ends at the
                            # edge, which is not a run, unless the polygon covers the edge line
                            # there (a half that passes the edge into the other tile): then it is
                            # a run that overlaps the other half, used to measure that overlap.
                            if not side * far > max(snap, TILE_PROBE):
                                continue
                            target = over
                        target[side].setdefault(n, []).append((lo, hi))
                        recs[side].setdefault(n, []).append((lo, hi, tc, sc, td, sd))
                        ring_ids[side].setdefault(n, set()).add(r_id)
            # A run is the merged stretch along the edge: a boundary drawn with many short
            # segments is one run; stretches not longer than run_min are no run.
            union = {}
            for side in (1, -1):
                union[side] = {}
                for n, v in runs[side].items():
                    merged = [iv for iv in _tile_merge(v) if iv[1] - iv[0] > run_min]
                    if merged:
                        union[side][n] = merged
            passing = {}
            for side in (1, -1):
                passing[side] = {}
                for n, v in over[side].items():
                    merged = [iv for iv in _tile_merge(v + runs[side].get(n, [])) if iv[1] - iv[0] > run_min]
                    if merged:
                        passing[side][n] = merged
            if not union[1] and not union[-1] and not (passing[1] and passing[-1]):
                continue
            cover = dict((s, _tile_merge([iv for v in list(union[s].values()) + list(passing[s].values())
                                          for iv in v]))
                         for s in (1, -1))
            def at(side, edge=edge):
                return edge["i"] if side == 1 else edge["j"]

            def point_at(t, p=p, ux=ux, uy=uy):
                return (p[0] + ux * t, p[1] + uy * t)

            for sign in (1, -1):
                for n, ivs in sorted(union[sign].items()):
                    f = feats[n]
                    stats["polygon_runs"] += 1
                    if "POLYGON_PIECE" in checks and opts["sliver_area"] > 0 \
                            and (layer["name"], f["oid"]) not in sliver_seen:
                        area = polygon_area(f["rings"])
                        if area < opts["sliver_area"]:
                            sliver_seen.add((layer["name"], f["oid"]))
                            rows.add("POLYGON_SLIVER", layer["name"], at(sign), at(-sign),
                                     f["oid"], None, None, None,
                                     "Polygon OID {0} touches the edge of tile {1} / tile {2} and "
                                     "its area is {3:.4f} m2 (below {4:.4f} m2).".format(
                                         f["oid"], _tile_label(prep, edge["i"]),
                                         _tile_label(prep, edge["j"]),
                                         area * opts["unit_m"] ** 2,
                                         opts["sliver_area"] * opts["unit_m"] ** 2),
                                     point_at((ivs[0][0] + ivs[0][1]) / 2.0), ei, "other")
                    if "POLYGON_PIECE" in checks and (layer["name"], f["oid"], ei, sign) not in seen_unmatched:
                        gaps = [g for g in _tile_subtract(ivs, cover[-sign]) if g[1] - g[0] > run_min]
                        if gaps:
                            seen_unmatched.add((layer["name"], f["oid"], ei, sign))
                            missing = sum(g[1] - g[0] for g in gaps)
                            where = "where no polygon of '{0}' continues on the other side".format(
                                layer["name"])
                            across = _tile_covering(feats, findex, n, (gaps[0][0] + gaps[0][1]) / 2.0,
                                                    -sign, frame, snap)
                            if across is not None:
                                # A polygon covers the other side there, but its boundary is not
                                # within the Edge Distance of the edge (it passes the edge deeper
                                # than that): there is no boundary on that side to compare.
                                where = ("where polygon OID {0} of '{1}' covers the other side but has "
                                         "no boundary within the Edge Distance ({2:.3f} m) of the edge "
                                         "(it runs across the edge deeper than that), so the two are not "
                                         "compared".format(across, layer["name"],
                                                           opts["edge"] * opts["unit_m"]))
                            rows.add("POLYGON_UNMATCHED", layer["name"], at(sign), at(-sign),
                                     f["oid"], None, None, None,
                                     "Polygon OID {0} runs along the edge with tile {1} for {2:.3f} m "
                                     "{3}."
                                     .format(f["oid"], _tile_label(prep, at(-sign)),
                                             missing * opts["unit_m"], where),
                                     point_at((gaps[0][0] + gaps[0][1]) / 2.0), ei, "other")
            # The halves of each side: their runs, with the runs that pass the edge line.
            halves = {}
            for side in (1, -1):
                halves[side] = dict(union[side])
                for n, v in passing[side].items():
                    halves[side][n] = _tile_merge(halves[side].get(n, []) + v)
            for na, ia in sorted(halves[1].items()):
                for nb, ib in sorted(halves[-1].items()):
                    pass_a, pass_b = na not in union[1], nb not in union[-1]
                    if na == nb and ((pass_a or pass_b)
                                     or len(ring_ids[1].get(na, set()) | ring_ids[-1].get(na, set())) < 2):
                        # One polygon across the edge, not two halves; a feature is paired with
                        # itself only when different rings (parts) have the runs on the two sides.
                        continue
                    ov = _tile_overlap_length(ia, ib)
                    if ov <= run_min:
                        continue
                    key = (layer["name"], feats[na]["oid"], feats[nb]["oid"], ei)
                    if key in seen_pairs:
                        continue
                    seen_pairs.add(key)
                    rows.counts[ei]["matched"] += 1
                    gap = _tile_polygon_gap(recs[1][na], recs[-1][nb], ia, ib)
                    if gap is not None and abs(gap[0]) > opts["tolerance"] + TILE_EPS \
                            and "POLYGON_PIECE" in checks:
                        g, tg, sa, sb = gap
                        rows.add("POLYGON_GAP", layer["name"], edge["i"], edge["j"],
                                 feats[na]["oid"], feats[nb]["oid"], abs(g), None,
                                 "Polygon pieces OID {0} (tile {1}) and OID {2} (tile {3}) do not "
                                 "meet at the edge: {4} {5:.3f} m (the tolerance is {6:.3f} m)."
                                 .format(feats[na]["oid"], _tile_label(prep, edge["i"]),
                                         feats[nb]["oid"], _tile_label(prep, edge["j"]),
                                         "there is a gap between them of" if g > 0 else
                                         "they overlap across the edge by",
                                         abs(g) * opts["unit_m"], opts["tolerance"] * opts["unit_m"]),
                                 (p[0] + ux * tg + nx * (sa + sb) / 2.0,
                                  p[1] + uy * tg + ny * (sa + sb) / 2.0), ei, "other")
                    if "ATTRIBUTE_MISMATCH" in checks and layer["compare"]:
                        first = [iv for iv in _tile_merge([(max(a0, b0), min(a1, b1))
                                                           for a0, a1 in ia for b0, b1 in ib
                                                           if min(a1, b1) > max(a0, b0)])][0]
                        rows.attribute_rows(layer["name"], edge["i"], edge["j"], feats[na]["oid"],
                                            feats[nb]["oid"], feats[na]["attrs"], feats[nb]["attrs"],
                                            layer["compare"], None,
                                            point_at((first[0] + first[1]) / 2.0), ei,
                                            "Attributes of the polygon pieces OID {0} and OID {1}"
                                            .format(feats[na]["oid"], feats[nb]["oid"]))


def _tile_polygon_gap(recs_a, recs_b, ivs_a, ivs_b):
    """Largest distance between the facing boundaries of two polygon halves along the stretch
    where their runs overlap. ``recs_a``: segments ``(lo, hi, tc, sc, td, sd)`` of the half on
    the side the piece normal points to (``s`` is the distance from the edge line along the
    normal), ``recs_b`` of the half on the other side. At every place the facing boundary of a
    half is its boundary nearest the other half. Returns ``(gap, t, s_a, s_b)`` with ``gap``
    positive for a gap between the halves and negative for an overlap, or ``None``.

    The stations (ends of the stretches and of every run segment) cut the stretch into
    intervals; inside one interval every run segment is either present over all of it or
    absent, and is a straight line. The facing boundary of each half is measured over each
    interval with only the segments present there (the one-sided values at both stations,
    so a step in the boundary, such as a rectangular notch, is not read as the boundary next
    to it), and also where two of those segments cross inside the interval (the nearest
    boundary can be farthest from the edge line there). Segments perpendicular to the edge
    have no length along it and carry no value: the distance at a step is the largest of the
    two sides of the step."""
    stretches = _tile_merge([(max(a0, b0), min(a1, b1)) for a0, a1 in ivs_a for b0, b1 in ivs_b
                             if min(a1, b1) > max(a0, b0)])
    if not stretches:
        return None

    def line(r):
        lo, hi, tc, sc, td, sd = r
        slope = 0.0 if td == tc else (sd - sc) / (td - tc)
        return lo, hi, slope, sc - slope * tc          # s = slope * t + base

    lines_a, lines_b = [line(r) for r in recs_a], [line(r) for r in recs_b]

    def present(lines, t0, t1):
        return [(m, c) for lo, hi, m, c in lines if lo <= t0 + TILE_EPS and hi >= t1 - TILE_EPS]

    def crossings(act, t0, t1):
        out = []
        for k in range(len(act)):
            for k2 in range(k + 1, len(act)):
                (m1, c1), (m2, c2) = act[k], act[k2]
                if m1 != m2:
                    t = (c2 - c1) / (m1 - m2)
                    if t0 < t < t1:
                        out.append(t)
        return out

    best = None
    for lo, hi in stretches:
        ts = set([lo, hi])
        for r in lines_a + lines_b:
            for t in (r[0], r[1]):
                if lo < t < hi:
                    ts.add(t)
        ts = sorted(ts)
        for t0, t1 in zip(ts, ts[1:]):
            if t1 - t0 <= TILE_EPS:
                continue
            act_a, act_b = present(lines_a, t0, t1), present(lines_b, t0, t1)
            if not act_a or not act_b:
                continue
            for t in [t0, t1] + crossings(act_a, t0, t1) + crossings(act_b, t0, t1):
                sa = min(m * t + c for m, c in act_a)
                sb = max(m * t + c for m, c in act_b)
                if best is None or abs(sa - sb) > abs(best[0]) + TILE_EPS:
                    best = (sa - sb, t, sa, sb)
    return best


def _tile_path_crossing(pts, closed, frame, band, snap):
    """First point where a vertex path passes from one side of the piece line to the
    other, within the piece (+/- ``band`` along it); ``None`` if it does not. A vertex
    within ``snap`` of the piece line is on it and is not on either side."""
    p, (ux, uy), (nx, ny), length = frame["p"], frame["u"], frame["n"], frame["len"]
    n = len(pts)
    if n < 2:
        return None
    dist = [(x - p[0]) * nx + (y - p[1]) * ny for x, y in pts]
    sign = [0 if abs(v) <= snap else (1 if v > 0 else -1) for v in dist]
    idx = [k for k in range(n) if sign[k] != 0]
    if len(idx) < 2:
        return None
    pairs = list(zip(idx, idx[1:]))
    if closed:
        pairs.append((idx[-1], idx[0]))
    for k, k2 in pairs:
        if sign[k] == sign[k2]:
            continue
        nxt = (k + 1) % n
        if nxt == k2:
            t = dist[k] / (dist[k] - dist[k2])
            a, b = pts[k], pts[k2]
            hit = (a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t)
        else:
            hit = pts[nxt]
        s = (hit[0] - p[0]) * ux + (hit[1] - p[1]) * uy
        if -band <= s <= length + band:
            return hit
    return None


def _tile_check_crossings(layer, feats, findex, pieces, rows, prep, opts, seen):
    """Lines (paths) and polygons (rings) that cross a shared edge."""
    band = opts["adjacency"] + TILE_EPS
    for ei, edge in enumerate(pieces.edges):
        for frame in edge["pieces"]:
            box = (min(frame["p"][0], frame["q"][0]), min(frame["p"][1], frame["q"][1]),
                   max(frame["p"][0], frame["q"][0]), max(frame["p"][1], frame["q"][1]))
            for n in findex.query(box, band):
                f = feats[n]
                key = (layer["name"], f["oid"], ei)
                if key in seen:
                    continue
                for path in f["paths"]:
                    hit = _tile_path_crossing(path, f["closed"], frame, band, opts["snap"])
                    if hit is not None:
                        seen.add(key)
                        rows.counts[ei]["crossing"] += 1
                        if "EDGE_CROSSING" in opts["checks"]:
                            rows.add("EDGE_CROSSING", layer["name"], edge["i"], edge["j"], f["oid"],
                                     None, None, None,
                                     "Feature OID {0} of '{1}' crosses the edge between tile {2} and "
                                     "tile {3} without being cut there.".format(
                                         f["oid"], layer["name"], _tile_label(prep, edge["i"]),
                                         _tile_label(prep, edge["j"])),
                                     hit, ei, None)
                        break


def _tile_crossing_features(layer):
    """Features of a line or polygon layer as vertex paths for the crossing test (parts
    with a missing or non-finite coordinate are left out; they are counted by the
    line and polygon readers)."""
    feats = []
    for row in layer["rows"]:
        shape = row.get("shape")
        if not shape:
            continue
        closed = layer["kind"] == "polygon"
        paths = []
        for part in shape:
            clean = _tile_clean(part)
            if clean is None:
                continue
            pts = []
            for q in clean:
                if not pts or q != pts[-1]:
                    pts.append(q)
            if closed and len(pts) > 1 and pts[0] == pts[-1]:
                pts.pop()
            if len(pts) >= 2:
                paths.append(pts)
        if not paths:
            continue
        xs = [p[0] for pts in paths for p in pts]
        ys = [p[1] for pts in paths for p in pts]
        feats.append({"oid": row["oid"], "paths": paths, "closed": closed,
                      "bbox": (min(xs), min(ys), max(xs), max(ys))})
    return feats


def _tile_seam_statistics(dangling, rows, opts, stats):
    """Statistics that tell a missing neighbour from real gaps, from the reported
    ``DANGLING_END`` ends (``dangling``): how many sit on the tile boundary itself, the edges
    that have such ends and no matched pair at all, and the pairs of ends of two different
    layers that coincide across an edge (data delivered as one layer per tile)."""
    snap = opts["snap"] + TILE_EPS
    on_boundary = [it for it in dangling if it["edge_dist"] is not None and it["edge_dist"] <= snap]
    stats["dangling_on_boundary"] = len(on_boundary)
    stats["many_dangling_on_boundary"] = (len(on_boundary) >= TILE_MANY_ON_BOUNDARY
                                          and 4 * len(on_boundary) >= stats["boundary_ends"])
    per_edge = {}
    for it in on_boundary:
        per_edge[it["edge"]] = per_edge.get(it["edge"], 0) + 1
    for ei in sorted(per_edge):
        if per_edge[ei] >= 3 and rows.counts[ei]["matched"] == 0:
            edge = rows.edges[ei]
            stats["unmatched_edges"].append({"tile_a": _tile_label(rows.prep, edge["i"]),
                                             "tile_b": _tile_label(rows.prep, edge["j"]),
                                             "ends": per_edge[ei]})
    if opts["combine_layers"] or len(set(it["layer_no"] for it in dangling)) < 2:
        return
    cell = max(opts["tolerance"], 1e-6)
    grid = {}
    for n, it in enumerate(dangling):
        grid.setdefault((int(math.floor(it["pt"][0] / cell)), int(math.floor(it["pt"][1] / cell))),
                        []).append(n)
    pairs = 0
    for n, it in enumerate(dangling):
        gx, gy = int(math.floor(it["pt"][0] / cell)), int(math.floor(it["pt"][1] / cell))
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                for m in grid.get((gx + dx, gy + dy), ()):
                    other = dangling[m]
                    if m > n and other["layer_no"] != it["layer_no"] and other["owner"] != it["owner"] \
                            and _tile_dist(it["pt"], other["pt"]) <= opts["tolerance"] + TILE_EPS:
                        pairs += 1
    stats["split_layer_pairs"] = pairs


def tile_edge_check(tiles, layers, options):
    """Check the edges of a tile index.

    ``tiles``: ``[{"oid", "label", "rings"}]`` (rings in the core representation).
    ``layers``: ``[{"name", "kind" ("polyline" / "polygon" / "point" / "multipoint"),
    "rows": [{"oid", "shape", "attrs"}], "compare": [field names]}]``, optionally with
    ``"compare_keys": [(key, field name)]`` (the listed field each stored name was resolved from;
    combined line layers are compared on the keys both resolved, see ``tile_compare_pairs``).
    ``options``: see ``tile_options`` (distances in coordinate units).

    Returns ``{"errors": [row, ...], "edges": [edge row, ...], "stats": {...}}``.
    An error row is ``{"rule", "layer", "tile_a", "tile_b", "oid_a", "oid_b",
    "offset" (coordinate units or None), "fields", "detail", "point", "edge"}``; an
    edge row ``{"tile_a", "tile_b", "length", "paths", "ends", "crossing", "matched",
    "offset", "dangling", "attr", "other", "status"}`` (``tile_a`` before ``tile_b``
    in the order of ``tiles``)."""
    opts = tile_options(options)
    _tile_say(opts, "Finding the shared tile edges")
    bad_tiles = []
    prep = tile_prepare(tiles, bad_tiles)
    sizes = [max(t["bbox"][2] - t["bbox"][0], t["bbox"][3] - t["bbox"][1])
             for t in prep if not t["empty"]]
    wide = min(max(opts["search"], 10.0 * opts["adjacency"]), 0.25 * _tile_median(sizes, 0.0))
    found = tile_edges(prep, opts["adjacency"], wide)
    edges = found["edges"]
    stats = {"tiles": len(prep), "empty_tiles": [t["label"] for t in prep if t["empty"]],
             "edges": sum(1 for e in edges if e["pieces"]), "touching_pairs": len(found["touch"]),
             "corner_only_pairs": len(found["touch"] - set((e["i"], e["j"]) for e in edges
                                                           if e["pieces"])),
             "overlapping_pairs": len(found["overlaps"]), "ends": 0, "ends_near_edges": 0,
             "closed_parts": 0, "zero_length_parts": 0, "points_on_edge": 0, "polygon_runs": 0,
             "ends_connected": 0, "junction_pairs_not_reported": 0, "boundary_ends": 0, "dangling_on_boundary": 0,
             "split_layer_pairs": 0, "unmatched_edges": [], "median_tile": _tile_median(sizes, 0.0),
             "many_dangling_on_boundary": False,
             "null_geometry": [], "bad_coordinates": len(bad_tiles), "bad_tiles": bad_tiles,
             "snap": opts["snap"], "tolerance_used": opts["tolerance"],
             "search_used": opts["search"], "adjacency_used": opts["adjacency"],
             "edge_used": opts["edge"], "unshared": [
                 {"tile_a": _tile_label(prep, u["i"]), "tile_b": _tile_label(prep, u["j"]),
                  "close": u["close"], "shared": u["shared"]} for u in found["unshared"]]}
    rows = _TileRows(prep, edges, opts["unit_m"])
    for ov in found["overlaps"]:
        ei = rows.by_pair[(ov["i"], ov["j"])]
        rows.add("TILE_OVERLAP", None, ov["i"], ov["j"], prep[ov["i"]]["oid"], prep[ov["j"]]["oid"],
                 None, None,
                 "Tiles {0} and {1} overlap: their interiors share area, so their shared "
                 "edge is not well defined.".format(_tile_label(prep, ov["i"]),
                                                    _tile_label(prep, ov["j"])),
                 ov["point"], ei, None)
    reach = max(opts["edge"] + opts["search"], opts["tolerance"] + opts["adjacency"]) + TILE_EPS
    pieces = _TilePieces(edges, reach)
    locator = _TileLocator(prep, opts["snap"], opts["probe"])
    crossing_seen, sliver_seen = set(), set()
    layers = [dict(layer, compare=list(layer.get("compare") or [])) for layer in layers]
    line_layers = [layer for layer in layers if layer["kind"] == "polyline"]
    all_dangling, lines_done = [], False
    for layer_no, layer in enumerate(layers):
        kind = layer["kind"]
        _tile_say(opts, "Checking " + str(layer["name"]))
        if not pieces.items:
            for row in layer["rows"]:
                if not row.get("shape"):
                    stats["null_geometry"].append((layer["name"], row["oid"]))
            continue
        if kind == "polyline":
            if opts["combine_layers"]:
                if not lines_done:
                    lines_done = True
                    for it in _tile_check_lines(line_layers, True, locator, pieces, rows, prep,
                                                found["touch"], opts, stats):
                        it["layer_no"] = 0
                        all_dangling.append(it)
            else:
                for it in _tile_check_lines([layer], False, locator, pieces, rows, prep,
                                            found["touch"], opts, stats):
                    it["layer_no"] = layer_no
                    all_dangling.append(it)
        elif kind in _TILE_POINT_KINDS:
            _tile_check_points(layer, locator, pieces, rows, prep, found["touch"], opts, stats)
        elif kind == "polygon":
            feats, null, bad = _tile_polygon_features(layer)
            stats["null_geometry"].extend((layer["name"], o) for o in null)
            stats["bad_coordinates"] += bad
            findex = _tile_feature_index(feats)
            if findex is not None:
                _tile_check_polygons(layer, pieces, rows, prep, opts, stats, feats, findex,
                                     sliver_seen)
        if kind in ("polyline", "polygon"):
            # Crossings are always counted (N_CROSSING); rows only when EDGE_CROSSING is checked.
            cfeats = _tile_crossing_features(layer)
            cindex = _tile_feature_index(cfeats)
            if cindex is not None:
                _tile_check_crossings(layer, cfeats, cindex, pieces, rows, prep, opts, crossing_seen)
    _tile_seam_statistics(all_dangling, rows, opts, stats)
    order = dict((r, n) for n, r in enumerate(TILE_RULES))
    errors = sorted(rows.errors, key=lambda e: (order[e["rule"]], e["layer"] or "",
                                                 e["oid_a"] if e["oid_a"] is not None else -1,
                                                 e["oid_b"] if e["oid_b"] is not None else -1,
                                                 e["point"] or (0, 0)))
    overlap_edges = set((ov["i"], ov["j"]) for ov in found["overlaps"])
    edge_rows = []
    for ei, edge in enumerate(edges):
        c = rows.counts[ei]
        issues = c["offset"] + c["dangling"] + c["attr"] + c["other"]
        if "EDGE_CROSSING" in opts["checks"]:
            issues += c["crossing"]
        if (edge["i"], edge["j"]) in overlap_edges:
            status = TILE_STATUS_OVERLAP
        elif issues:
            status = TILE_STATUS_ISSUES
        elif c["ends"] + c["crossing"] + c["matched"] == 0:
            status = TILE_STATUS_NO_DATA
        else:
            status = TILE_STATUS_OK
        edge_rows.append({"tile_a": _tile_label(prep, edge["i"]), "tile_b": _tile_label(prep, edge["j"]),
                          "pos_a": edge["i"], "pos_b": edge["j"], "length": edge["length"],
                          "paths": tile_chain_pieces(edge["pieces"]), "ends": c["ends"],
                          "crossing": c["crossing"], "matched": c["matched"], "offset": c["offset"],
                          "dangling": c["dangling"], "attr": c["attr"], "other": c["other"],
                          "status": status})
    return {"errors": errors, "edges": edge_rows, "stats": stats}


# ==========================================================================
# quality/topology_lite_core.py
# ==========================================================================
# Pure logic of the Topology Check (Lite) checker (no arcpy).
#
# Topology rules for polygons (and optionally lines) on a Basic licence, without a
# geodatabase topology. One polygon layer ("input"), an optional second polygon
# layer ("other": a second layer or a boundary / must-cover layer) and an optional
# line layer:
#
# * ``OVERLAP``               two input polygons overlap (one error per pair of features);
# * ``GAP``                   a void inside the input coverage: an area surrounded by
#                             input polygons (or the hole of one polygon) that no input
#                             polygon covers;
# * ``SLIVER``                an input polygon smaller than an area (and optionally
#                             narrower than a width);
# * ``NOT_COVERED_BY_OTHER``  a part of an input polygon that no "other" polygon covers
#                             (input must be covered by other, e.g. inside a boundary);
# * ``OVERLAPS_OTHER``        a part of an input polygon that overlaps an "other" polygon
#                             (must not overlap with);
# * ``OTHER_NOT_COVERED``     a part of an "other" polygon that no input polygon covers
#                             (other, e.g. a boundary or must-cover layer, must be
#                             covered by the input: gaps against a boundary);
# * ``LINE_SELF_OVERLAP``     a line runs along itself;
# * ``LINE_INTERSECT``        two lines overlap along a length, or cross at a point that is
#                             not within the tolerance of an end of either line (lines that
#                             only touch, T junctions and end-to-end touches are not errors;
#                             two paths of one multipart line are not compared with each
#                             other);
# * ``LINE_OUTSIDE``          a part of a line lies outside the polygons (the "other"
#                             layer when given, else the input layer).
#
# Algorithm (all of it pure Python on integers)
# ---------------------------------------------
# Coordinates are rounded once to a lattice of ``TOPO_GRID_M`` (0.0001 m, the default XY
# resolution of an Esri projected system) and everything after that is exact integer
# arithmetic, so there is no floating-point inconsistency: the lattice is also why
# features that were snapped to a coordinate resolution do not produce false results.
#
# 1. Vertex clustering (greedy, radius = tolerance) and insertion of vertices into nearby
#    unmatched edges (T-junctions within the tolerance) make shared boundaries identical.
# 2. Edge matching: every ring edge is a directed edge with the polygon interior on its
#    right. An edge and its reverse cancel. What is left (the "net chain") is exactly where
#    the number of polygons covering a point changes: the outer boundary of the coverage,
#    the boundary of every gap and of every overlap. In clean data it is the outline only,
#    so the work is proportional to the problems, not to the 50,000 polygons.
# 3. The net chain is noded (exact crossings rounded to the lattice, hot-pixel style
#    iteration until no crossing is left), and its faces are traced. A face wider than the
#    tolerance is classified by counting the polygons that cover a sample point.
# 4. Overlaps and the two-layer rules are attributed to features by an exact local overlay
#    of the polygons near each suspect face (all edges noded, atomic faces labelled).
#
# Tolerance. Regions narrower than the tolerance (``2 * area / perimeter``) are noise and
# are never reported; the tolerance is also the radius of vertex clustering and edge
# snapping. It is never smaller than two lattice steps.
#
# Geometry must already be in a projected system; ``unit_m`` converts layer units to
# metres. Z and M are ignored.

TOPO_RULE_OVERLAP = "OVERLAP"
TOPO_RULE_GAP = "GAP"
TOPO_RULE_SLIVER = "SLIVER"
TOPO_RULE_NOT_COVERED = "NOT_COVERED_BY_OTHER"
TOPO_RULE_OVERLAPS_OTHER = "OVERLAPS_OTHER"
TOPO_RULE_OTHER_NOT_COVERED = "OTHER_NOT_COVERED"
TOPO_RULE_LINE_SELF = "LINE_SELF_OVERLAP"
TOPO_RULE_LINE_INTERSECT = "LINE_INTERSECT"
TOPO_RULE_LINE_OUTSIDE = "LINE_OUTSIDE"
TOPO_RULES = (TOPO_RULE_OVERLAP, TOPO_RULE_GAP, TOPO_RULE_SLIVER, TOPO_RULE_NOT_COVERED,
              TOPO_RULE_OVERLAPS_OTHER, TOPO_RULE_OTHER_NOT_COVERED, TOPO_RULE_LINE_SELF,
              TOPO_RULE_LINE_INTERSECT, TOPO_RULE_LINE_OUTSIDE)
TOPO_DEFAULT_RULES = (TOPO_RULE_OVERLAP, TOPO_RULE_GAP)
# rules whose errors are regions with an area (the SMALL / NORMAL severity applies to them)
TOPO_REGION_RULES = (TOPO_RULE_OVERLAP, TOPO_RULE_GAP, TOPO_RULE_NOT_COVERED,
                     TOPO_RULE_OVERLAPS_OTHER, TOPO_RULE_OTHER_NOT_COVERED)
TOPO_SEVERITY_SMALL = "SMALL"
TOPO_SEVERITY_NORMAL = "NORMAL"
TOPO_OTHER_RULES = (TOPO_RULE_NOT_COVERED, TOPO_RULE_OVERLAPS_OTHER, TOPO_RULE_OTHER_NOT_COVERED)
TOPO_LINE_RULES = (TOPO_RULE_LINE_SELF, TOPO_RULE_LINE_INTERSECT, TOPO_RULE_LINE_OUTSIDE)

# Lattice step in metres: the default XY resolution of an Esri projected coordinate system
# (Esri ArcGIS Blog, "Geoprocessing, resolution, tolerance and hair": 0.0001 m).
TOPO_GRID_M = 0.0001
TOPO_DEFAULT_TOLERANCE_M = 0.001  # the default XY tolerance, 10 x the resolution (same source)

TOPO_DEFAULT_OPTIONS = {
    "rules": TOPO_DEFAULT_RULES,
    "tolerance_m": TOPO_DEFAULT_TOLERANCE_M,
    "min_area_m2": 0.0,       # regions smaller than this are not reported (0 = off)
    "small_area_m2": 0.1,     # overlap / gap / uncovered regions below this area get severity SMALL (0 = off)
    "max_gap_m2": 0.0,        # gaps larger than this are not reported (0 = no limit)
    "sliver_area_m2": 0.0,    # SLIVER: polygons smaller than this (0 = no area test)
    "sliver_width_m": 0.0,    # SLIVER: polygons narrower than this, 2 x area / perimeter (0 = no width test)
    "max_regions": 50000,     # stop when more overlap / gap / uncovered regions than this are found (0 = no limit)
    "unit_m": 1.0,            # metres per layer unit
    "resolution_m": 0.0,      # XY resolution of the data in metres (0 = unknown)
    "progress": None,         # optional callable(text)
}

TOPO_MAX_NODE_PASSES = 8
TOPO_NODE_RECORDS_PER_REGION = 8     # edge pieces allowed per region of the limit
TOPO_FACES_PER_REGION = 4            # faces allowed per region of the limit
TOPO_MIN_PIECES = 20000              # edge pieces / faces always allowed, whatever the limit


class TopoLimitError(ValueError):
    """The layers overlap or cross so much that the work (and the memory) would be far
    beyond a normal run. ``what`` is "edge pieces", "faces" or "regions"."""

    def __init__(self, what, count, limit):
        ValueError.__init__(self, "{0} {1} found, more than the limit {2}".format(
            count, what, limit))
        self.what = what
        self.count = count
        self.limit = limit
TOPO_BIG_SEGMENT_CELLS = 400
TOPO_SMALL_BOX_CELLS = 16            # a segment box of at most this many grid cells is scanned whole
TOPO_VERTICES_PER_CELL = 4.0         # target vertices per cell of the snapping grid in dense data


class _TopoBoxIndex(object):
    """Size-tiered grid of bounding boxes (``insert(key, box)``, ``query(box)``).

    A box goes to the level whose cell is the smallest ``base * 2**k`` not smaller than its
    span, so it is stored in at most 2 x 2 cells of that level: the memory is linear in the
    number of boxes, whatever their sizes (one uniform grid sized from the median box puts
    a 5 km box into 25 million cells of 1 m). A query visits, per level, the cells under the
    query box, or the level's boxes themselves when there are fewer of them than cells, so
    a large query box on a fine level costs no more than a scan of that level.
    """

    def __init__(self, base):
        self.base = max(float(base), 1.0)
        self.levels = {}   # k -> [cell size, {(gx, gy): [keys]}, [keys]]
        self.boxes = {}

    def cell_count(self):
        """Number of grid cells holding keys (for tests and limits)."""
        return sum(len(lvl[1]) for lvl in self.levels.values())

    def insert(self, key, box):
        if box is None or box[2] < box[0] or box[3] < box[1]:
            return
        span = max(box[2] - box[0], box[3] - box[1])
        k, cell = 0, self.base
        while span > cell:
            k += 1
            cell = self.base * (2 ** k)
        lvl = self.levels.get(k)
        if lvl is None:
            lvl = self.levels[k] = [cell, {}, []]
        self.boxes[key] = box
        lvl[2].append(key)
        grid = lvl[1]
        for gx in range(int(math.floor(box[0] / cell)), int(math.floor(box[2] / cell)) + 1):
            for gy in range(int(math.floor(box[1] / cell)), int(math.floor(box[3] / cell)) + 1):
                grid.setdefault((gx, gy), []).append(key)

    def query(self, box, tolerance=0.0):
        found = set()
        boxes = self.boxes
        for cell, grid, keys in self.levels.values():
            gx0 = int(math.floor((box[0] - tolerance) / cell))
            gx1 = int(math.floor((box[2] + tolerance) / cell))
            gy0 = int(math.floor((box[1] - tolerance) / cell))
            gy1 = int(math.floor((box[3] + tolerance) / cell))
            if (gx1 - gx0 + 1) * (gy1 - gy0 + 1) > len(keys):
                for key in keys:
                    if key not in found and bbox_intersects(boxes[key], box, tolerance):
                        found.add(key)
                continue
            for gx in range(gx0, gx1 + 1):
                for gy in range(gy0, gy1 + 1):
                    for key in grid.get((gx, gy), ()):
                        if key not in found and bbox_intersects(boxes[key], box, tolerance):
                            found.add(key)
        return sorted(found)


def topo_options(**overrides):
    """Options dict: defaults updated with ``overrides`` (``None`` values ignored)."""
    opts = dict(TOPO_DEFAULT_OPTIONS)
    for key, value in overrides.items():
        if key not in opts:
            raise KeyError(key)
        if value is not None:
            opts[key] = value
    opts["rules"] = tuple(r for r in TOPO_RULES if r in set(opts["rules"]))
    return opts


# --------------------------------------------------------------------------
# Lattice
# --------------------------------------------------------------------------

class _TopoLattice(object):
    """Integer lattice: ``(ix, iy) -> (ox + ix * g, oy + iy * g)`` in layer units."""

    __slots__ = ("ox", "oy", "g")

    def __init__(self, ox, oy, g):
        self.ox, self.oy, self.g = ox, oy, g

    def to_int(self, x, y):
        return (int(math.floor((x - self.ox) / self.g + 0.5)),
                int(math.floor((y - self.oy) / self.g + 0.5)))

    def to_xy(self, p):
        return (self.ox + p[0] * self.g, self.oy + p[1] * self.g)

    def ring_xy(self, ring):
        """Closed float ring (layer units) from an open lattice ring."""
        out = [self.to_xy(p) for p in ring]
        out.append(out[0])
        return out


def _topo_make_lattice(layers, g_units):
    """Lattice whose origin is a multiple of 1e6 steps below the data (so data that already
    sit on a lattice of the same step keep their integer coordinates exactly)."""
    xs, ys = [], []
    for rows in layers:
        for row in rows:
            shape = row["shape"]
            if not shape:
                continue
            for part in shape:
                for p in part:
                    xs.append(p[0])
                    ys.append(p[1])
    if not xs:
        return _TopoLattice(0.0, 0.0, g_units)
    big = g_units * 1000000.0
    return _TopoLattice(math.floor(min(xs) / big) * big, math.floor(min(ys) / big) * big, g_units)


def _topo_area2(ring):
    """Twice the signed area of an open lattice ring (exact integer; > 0 counter-clockwise)."""
    x0, y0 = ring[0]
    total = 0
    px, py = 0, 0
    for i in range(1, len(ring)):
        x, y = ring[i][0] - x0, ring[i][1] - y0
        total += px * y - x * py
        px, py = x, y
    return total


def _topo_clean_ring(points):
    """Open ring without consecutive duplicates and without a repeated closing vertex."""
    out = []
    prev = None
    for p in points:
        if p != prev:
            out.append(p)
            prev = p
    while len(out) > 1 and out[0] == out[-1]:
        out.pop()
    return out


def _topo_int_ring(ring, lat, clockwise):
    """Open lattice ring with the wanted orientation, or ``None`` when it has no area."""
    pts = _topo_clean_ring([lat.to_int(x, y) for x, y in ring])
    if len(pts) < 3:
        return None
    a2 = _topo_area2(pts)
    if a2 == 0:
        return None
    if (a2 < 0) != clockwise:
        pts.reverse()
    return pts


def _topo_prepare_layer(rows, lat, kind_label):
    """Features of a polygon layer as ``{"oid", "parts": [[outer, [holes]]], "shape"}``.

    Outer rings are clockwise and holes counter-clockwise (the polygon interior is on the
    right of every directed edge). Returns ``(features, null_oids)``; a feature whose rings
    all vanish on the lattice keeps an empty ``parts`` list.
    """
    feats, nulls = [], []
    for row in rows:
        shape = row["shape"]
        if not shape:
            nulls.append(row["oid"])
            continue
        parts = []
        groups, note = _topo_group_rings(shape)
        for outer, holes in groups:
            o = _topo_int_ring(outer[:-1] if outer[0] == outer[-1] else outer, lat, True)
            if o is None:
                continue
            hs = []
            for h in holes:
                r = _topo_int_ring(h[:-1] if h[0] == h[-1] else h, lat, False)
                if r is not None:
                    hs.append(r)
            parts.append([o, hs])
        feat = {"oid": row["oid"], "parts": parts, "shape": shape}
        if note:
            feat["ring_note"] = note
        feats.append(feat)
    return feats, nulls


TOPO_RING_REORDERED = "reordered"
TOPO_RING_NESTED = "nested"


def _topo_ring_within(inner, outer):
    """True / False: ``inner`` lies inside / outside ``outer`` (judged at its first vertex not
    on the boundary of ``outer``); ``None`` when every vertex is on that boundary (the same
    ring)."""
    for p in inner:
        state = point_in_ring(p, outer)
        if state != "boundary":
            return state == "in"
    return None


def _topo_ring_box(ring):
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    return (min(xs), min(ys), max(xs), max(ys))


def _topo_ring_containers(rings, areas, candidates=None):
    """``[[j, ...]]``: for every ring the rings that contain it. Rings with no area contain
    nothing; of two identical rings the one listed first contains the other. ``candidates``
    restricts the containers to those indices."""
    boxes = [_topo_ring_box(r) for r in rings]
    spans = sorted(max(b[2] - b[0], b[3] - b[1]) for b in boxes)
    index = _TopoBoxIndex(spans[len(spans) // 2] if spans else 1.0)
    for j, b in enumerate(boxes):
        if areas[j] != 0 and (candidates is None or j in candidates):
            index.insert(j, b)
    out = []
    for i, r in enumerate(rings):
        bi = boxes[i]
        cont = []
        for j in index.query(bi):
            if j == i:
                continue
            bj = boxes[j]
            if bi[0] < bj[0] or bi[1] < bj[1] or bi[2] > bj[2] or bi[3] > bj[3]:
                continue
            inside = _topo_ring_within(r, rings[j])
            if inside or (inside is None and j < i):
                cont.append(j)
        out.append(cont)
    return out


def _topo_group_rings(shape):
    """``(groups, note)``: the rings of one feature as ``[(outer, [holes])]``.

    Normally this is ``common.geom.group_rings`` (Esri ring order: outer rings clockwise,
    holes counter-clockwise). When a counter-clockwise ring was left as an outer because no
    clockwise ring contains it, the ring order of the feature is not Esri's (for example OGC
    order: outer counter-clockwise, holes clockwise; Esri Check Geometry calls this
    "incorrect ring ordering"). The rings are then read by nesting instead: a ring inside an
    even number of the feature's rings is an outer, inside an odd number a hole of the
    smallest ring around it. ``note`` is ``TOPO_RING_REORDERED`` when that changes the
    reading. ``TOPO_RING_NESTED`` flags a feature in Esri order with an outer ring inside
    another outer ring and no hole between them (overlapping parts, or a hole written
    clockwise): it is read as Esri order says, and only flagged. ``note`` is ``None`` else.
    """
    groups = group_rings(shape)
    orphan = any(ring_signed_area(o) > 0 for o, _h in groups)
    if not orphan:
        if len(groups) < 2:
            return groups, None
        # in Esri order an outer lies inside an even number of the feature's rings (an island
        # in a lake: outer, hole, outer); an odd number means an outer directly inside an outer
        outers = [o for o, _h in groups]
        rings = outers + [h for _o, hs in groups for h in hs]
        areas = [ring_signed_area(r) for r in rings]
        cont = _topo_ring_containers(rings, areas)
        if any(len(cont[i]) % 2 == 1 for i in range(len(outers)) if areas[i] != 0):
            return groups, TOPO_RING_NESTED
        return groups, None
    rings = [close_ring(r) for r in (shape or []) if len(r) >= 3]
    areas = [ring_signed_area(r) for r in rings]
    cont = _topo_ring_containers(rings, areas)
    depth = [len(c) for c in cont]
    outer_of = {}
    order = []
    for i, r in enumerate(rings):
        if depth[i] % 2 == 0:
            outer_of[i] = len(order)
            order.append((r, []))
    for i, r in enumerate(rings):
        if depth[i] % 2 == 1:
            parents = [j for j in cont[i] if depth[j] == depth[i] - 1]
            if not parents:
                # an inconsistent nesting (crossing rings): keep the ring as an outer
                order.append((r, []))
                continue
            parent = min(parents, key=lambda j: abs(areas[j]))
            order[outer_of[parent]][1].append(r)
    same = (len(order) == len(groups) and
            all(o1 == o2 and sorted(h1) == sorted(h2)
                for (o1, h1), (o2, h2) in zip(sorted(order, key=lambda g: g[0]),
                                              sorted(groups, key=lambda g: g[0]))))
    return order, (None if same else TOPO_RING_REORDERED)


def _topo_flat_rings(feats):
    """``(rings, oids)``: every ring (list object, modified in place) of the features."""
    rings, oids = [], []
    for f in feats:
        for part in f["parts"]:
            rings.append(part[0])
            oids.append(f["oid"])
            for h in part[1]:
                rings.append(h)
                oids.append(f["oid"])
    return rings, oids


def _topo_drop_empty_rings(feats):
    """Remove rings emptied by snapping (an emptied outer ring takes its holes with it)."""
    for f in feats:
        parts = []
        for part in f["parts"]:
            if not part[0]:
                continue
            part[1] = [h for h in part[1] if h]
            parts.append(part)
        f["parts"] = parts


# --------------------------------------------------------------------------
# Snapping: clustering, edge matching, vertices into nearby edges
# --------------------------------------------------------------------------

def _topo_cluster_map(rings, radius):
    """Greedy leader clustering of all vertices: ``{vertex: leader}`` for moved vertices.

    Vertices are visited in sorted order and join the nearest earlier leader within
    ``radius`` lattice steps, so the result does not depend on feature order and is not
    transitive (a chain of closely spaced vertices does not collapse to one point).
    """
    if radius <= 0:
        return {}
    uniq = set()
    for ring in rings:
        uniq.update(ring)
    cell = max(int(radius), 1)
    r2 = radius * radius
    grid = {}
    moved = {}
    for p in sorted(uniq):
        cx, cy = p[0] // cell, p[1] // cell
        best, bd = None, r2 + 1
        for gx in (cx - 1, cx, cx + 1):
            for gy in (cy - 1, cy, cy + 1):
                lst = grid.get((gx, gy))
                if lst:
                    for q in lst:
                        d = (q[0] - p[0]) ** 2 + (q[1] - p[1]) ** 2
                        if d <= r2 and d < bd:
                            best, bd = q, d
        if best is None:
            grid.setdefault((cx, cy), []).append(p)
        else:
            moved[p] = best
    return moved


def _topo_apply_map(rings, moved):
    """Replace vertices by their leaders; rings that collapse are emptied. Returns the
    number of rings changed."""
    changed = 0
    for ring in rings:
        if not ring:
            continue
        if any(p in moved for p in ring):
            new = _topo_clean_ring([moved.get(p, p) for p in ring])
            if len(new) < 3 or _topo_area2(new) == 0:
                new = []
            ring[:] = new
            changed += 1
    return changed


def _topo_net_weights(rings):
    """``{(u, v): weight}`` for undirected lattice edges (u < v) whose directed copies do
    not cancel. Weight > 0 means the net interior lies on the right of u -> v."""
    counts = {}
    for ring in rings:
        if not ring:
            continue
        prev = ring[-1]
        for p in ring:
            if p != prev:
                if prev < p:
                    k = (prev, p)
                    counts[k] = counts.get(k, 0) + 1
                else:
                    k = (p, prev)
                    counts[k] = counts.get(k, 0) - 1
            prev = p
    return dict((k, w) for k, w in counts.items() if w)


def _topo_segment_cells(u, v, pad, cell):
    """Grid cells ``(gx, gy)`` that can hold a point within ``pad`` of the segment u-v (a
    superset of the cells that really do). A short or axis-parallel segment gets the
    cells of its padded box; a long slanted one gets, per grid column, only the cells in
    the band the segment crosses in that column (so the work follows the length of the
    segment, not the area of its box)."""
    x0, x1 = (u[0], v[0]) if u[0] <= v[0] else (v[0], u[0])
    y0, y1 = (u[1], v[1]) if u[1] <= v[1] else (v[1], u[1])
    gx0, gx1 = (x0 - pad) // cell, (x1 + pad) // cell
    gy0, gy1 = (y0 - pad) // cell, (y1 + pad) // cell
    if (gx1 - gx0 + 1) * (gy1 - gy0 + 1) <= TOPO_SMALL_BOX_CELLS or x0 == x1 or y0 == y1:
        return [(gx, gy) for gx in range(gx0, gx1 + 1) for gy in range(gy0, gy1 + 1)]
    ux, uy = u
    slope = (v[1] - uy) / float(v[0] - ux)
    out = []
    for gx in range(gx0, gx1 + 1):
        # a point of the column lies within pad of a segment point whose x is in this range
        a = max(gx * cell - pad, x0)
        b = min((gx + 1) * cell - 1 + pad, x1)
        if a > b:
            continue
        ya = uy + (a - ux) * slope
        yb = uy + (b - ux) * slope
        lo = int(math.floor(min(ya, yb))) - pad - 1
        hi = int(math.floor(max(ya, yb))) + pad + 1
        lo = max(lo, y0 - pad)
        hi = min(hi, y1 + pad)
        for gy in range(lo // cell, hi // cell + 1):
            out.append((gx, gy))
    return out


def _topo_insert_near_vertices(rings, residual, vertices, radius):
    """Insert vertices of ``vertices`` that lie within ``radius`` of the interior of a
    residual (unmatched) edge into the ring edges at that place. Returns the number of
    insertions."""
    if radius <= 0 or not residual or not vertices:
        return 0
    lens = sorted(max(abs(v[0] - u[0]), abs(v[1] - u[1])) for u, v in residual)
    cell = max(2 * int(radius), int(lens[len(lens) // 2]), 1)
    # many vertices in a small area (heavily stacked layers): a finer grid keeps the
    # number of vertices per cell small; the cell size changes the work, not the result
    xs = [z[0] for z in vertices]
    ys = [z[1] for z in vertices]
    box_area = float(max(max(xs) - min(xs), 1)) * float(max(max(ys) - min(ys), 1))
    dense = int(math.sqrt(box_area * TOPO_VERTICES_PER_CELL / len(vertices))) + 1
    cell = max(2 * int(radius), 1, min(cell, dense))
    vgrid = {}
    for z in vertices:
        vgrid.setdefault((z[0] // cell, z[1] // cell), []).append(z)
    r2 = radius * radius
    inserts = {}
    total = 0
    for key in residual:
        u, v = key
        dx, dy = v[0] - u[0], v[1] - u[1]
        len2 = dx * dx + dy * dy
        found = None
        for cell_key in _topo_segment_cells(u, v, radius, cell):
            lst = vgrid.get(cell_key)
            if not lst:
                continue
            for z in lst:
                px, py = z[0] - u[0], z[1] - u[1]
                dot = px * dx + py * dy
                if dot <= 0 or dot >= len2:
                    continue
                cr = px * dy - py * dx
                if cr * cr > r2 * len2:
                    continue
                if px * px + py * py <= r2:
                    continue
                qx, qy = z[0] - v[0], z[1] - v[1]
                if qx * qx + qy * qy <= r2:
                    continue
                if found is None:
                    found = []
                found.append((dot, z))
        if found:
            found.sort()
            inserts[key] = [z for _d, z in found]
            total += len(found)
    if not inserts:
        return 0
    for ring in rings:
        if not ring:
            continue
        n = len(ring)
        changed = False
        out = []
        for i in range(n):
            a = ring[i]
            b = ring[(i + 1) % n]
            out.append(a)
            if a == b:
                continue
            if a < b:
                ins = inserts.get((a, b))
                if ins:
                    out.extend(ins)
                    changed = True
            else:
                ins = inserts.get((b, a))
                if ins:
                    out.extend(reversed(ins))
                    changed = True
        if changed:
            ring[:] = _topo_clean_ring(out)
    return total


def _topo_snap_layers(layers, radius):
    """Snap the rings of one or more layers jointly (see the module docstring).

    ``layers``: list of feature lists (``_topo_prepare_layer``). Returns a stats dict.
    """
    all_rings = []
    for feats in layers:
        all_rings.extend(_topo_flat_rings(feats)[0])
    stats = {"clustered_vertices": 0, "inserted_vertices": 0, "vanished_rings": 0}
    before = sum(1 for r in all_rings if r)
    moved = _topo_cluster_map(all_rings, radius)
    stats["clustered_vertices"] = len(moved)
    if moved:
        _topo_apply_map(all_rings, moved)
    if radius > 0:
        residuals = [_topo_net_weights(_topo_flat_rings(f)[0]) for f in layers]
        vertices = set()
        for res in residuals:
            for u, v in res:
                vertices.add(u)
                vertices.add(v)
        for feats, res in zip(layers, residuals):
            stats["inserted_vertices"] += _topo_insert_near_vertices(
                _topo_flat_rings(feats)[0], res, vertices, radius)
    for feats in layers:
        _topo_drop_empty_rings(feats)
    stats["vanished_rings"] = before - sum(1 for r in all_rings if r)
    return stats


def _topo_net_edges(feats):
    """``{(u, v): [weight, owners]}`` for the unmatched edges of a layer (see
    ``_topo_net_weights``); ``owners`` is the set of ObjectIDs whose ring edge points the
    same way as the surviving weight."""
    rings, oids = _topo_flat_rings(feats)
    net = _topo_net_weights(rings)
    out = dict((k, [w, set()]) for k, w in net.items())
    if not out:
        return out
    for ring, oid in zip(rings, oids):
        prev = ring[-1]
        for p in ring:
            if p != prev:
                if prev < p:
                    rec = out.get((prev, p))
                    if rec is not None and rec[0] > 0:
                        rec[1].add(oid)
                else:
                    rec = out.get((p, prev))
                    if rec is not None and rec[0] < 0:
                        rec[1].add(oid)
            prev = p
    return out


# --------------------------------------------------------------------------
# Noding (exact integer predicates; crossings rounded to the lattice)
# --------------------------------------------------------------------------

def _topo_round_div(num, den):
    if den < 0:
        num, den = -num, -den
    return (2 * num + den) // (2 * den)


def _topo_hit(a, b, c, d):
    """Split points needed where segments a-b and c-d meet: ``None`` or ``(pts1, pts2)``.

    ``pts1`` are lattice points to insert into a-b, ``pts2`` into c-d (endpoints are
    filtered out). A proper crossing gives its intersection rounded to the lattice.
    """
    ax, ay = a
    bx, by = b
    cx, cy = c
    dx, dy = d
    d1 = (dx - cx) * (ay - cy) - (dy - cy) * (ax - cx)
    d2 = (dx - cx) * (by - cy) - (dy - cy) * (bx - cx)
    if (d1 > 0 and d2 > 0) or (d1 < 0 and d2 < 0):
        return None
    d3 = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)
    d4 = (bx - ax) * (dy - ay) - (by - ay) * (dx - ax)
    if (d3 > 0 and d4 > 0) or (d3 < 0 and d4 < 0):
        return None
    if d1 == 0 and d2 == 0:  # collinear (d3 = d4 = 0 too)
        pts1, pts2 = [], []
        if abs(bx - ax) >= abs(by - ay):
            lo1, hi1 = (ax, bx) if ax <= bx else (bx, ax)
            lo2, hi2 = (cx, dx) if cx <= dx else (dx, cx)
            key = 0
        else:
            lo1, hi1 = (ay, by) if ay <= by else (by, ay)
            lo2, hi2 = (cy, dy) if cy <= dy else (dy, cy)
            key = 1
        if hi1 < lo2 or hi2 < lo1:
            return None
        for p in (c, d):
            if lo1 < p[key] < hi1:
                pts1.append(p)
        for p in (a, b):
            if lo2 < p[key] < hi2:
                pts2.append(p)
        if not pts1 and not pts2:
            return None
        return pts1, pts2
    pts1, pts2 = [], []
    if d1 * d2 < 0 and d3 * d4 < 0:
        den = d3 - d4
        x = cx + _topo_round_div((dx - cx) * d3, den)
        y = cy + _topo_round_div((dy - cy) * d3, den)
        p = (x, y)
        if p != a and p != b:
            pts1.append(p)
        if p != c and p != d:
            pts2.append(p)
    else:
        if d1 == 0 and min(cx, dx) <= ax <= max(cx, dx) and min(cy, dy) <= ay <= max(cy, dy):
            if a != c and a != d:
                pts2.append(a)
        if d2 == 0 and min(cx, dx) <= bx <= max(cx, dx) and min(cy, dy) <= by <= max(cy, dy):
            if b != c and b != d:
                pts2.append(b)
        if d3 == 0 and min(ax, bx) <= cx <= max(ax, bx) and min(ay, by) <= cy <= max(ay, by):
            if c != a and c != b:
                pts1.append(c)
        if d4 == 0 and min(ax, bx) <= dx <= max(ax, bx) and min(ay, by) <= dy <= max(ay, by):
            if d != a and d != b:
                pts1.append(d)
    if not pts1 and not pts2:
        return None
    return pts1, pts2


def _topo_find_splits(keys, max_points=0):
    """``{index: set(points)}``: lattice points to insert into each segment. With
    ``max_points`` the search stops with ``TopoLimitError`` once that many split points
    were found (the pieces would outgrow the limit)."""
    n = len(keys)
    splits = {}
    if n < 2:
        return splits
    xmin = [0] * n
    xmax = [0] * n
    ymin = [0] * n
    ymax = [0] * n
    sizes = []
    for i, (u, v) in enumerate(keys):
        if u[0] <= v[0]:
            xmin[i], xmax[i] = u[0], v[0]
        else:
            xmin[i], xmax[i] = v[0], u[0]
        if u[1] <= v[1]:
            ymin[i], ymax[i] = u[1], v[1]
        else:
            ymin[i], ymax[i] = v[1], u[1]
        sizes.append(max(xmax[i] - xmin[i], ymax[i] - ymin[i]))
    srt = sorted(sizes)
    cell = max(2 * srt[n // 2], 1)
    grid = {}
    big = []
    for i in range(n):
        gx0, gx1 = xmin[i] // cell, xmax[i] // cell
        gy0, gy1 = ymin[i] // cell, ymax[i] // cell
        if (gx1 - gx0 + 1) * (gy1 - gy0 + 1) > TOPO_BIG_SEGMENT_CELLS:
            big.append(i)
            continue
        for gx in range(gx0, gx1 + 1):
            for gy in range(gy0, gy1 + 1):
                lst = grid.get((gx, gy))
                if lst is None:
                    grid[(gx, gy)] = [i]
                else:
                    lst.append(i)

    found = [0]

    def test(i, j):
        res = _topo_hit(keys[i][0], keys[i][1], keys[j][0], keys[j][1])
        if res is not None:
            found[0] += len(res[0]) + len(res[1])
            if max_points and found[0] > max_points:
                raise TopoLimitError("edge pieces", n + found[0], n + max_points)
            if res[0]:
                s = splits.get(i)
                if s is None:
                    splits[i] = s = set()
                s.update(res[0])
            if res[1]:
                s = splits.get(j)
                if s is None:
                    splits[j] = s = set()
                s.update(res[1])

    for (gx, gy), lst in grid.items():
        m = len(lst)
        if m < 2:
            continue
        for ii in range(m):
            i = lst[ii]
            xi0, xi1, yi0, yi1 = xmin[i], xmax[i], ymin[i], ymax[i]
            for jj in range(ii + 1, m):
                j = lst[jj]
                if xmin[j] > xi1 or xmax[j] < xi0 or ymin[j] > yi1 or ymax[j] < yi0:
                    continue
                # test the pair only in the cell holding the lower-left corner of the
                # intersection of the two boxes, so that it is tested once
                if max(xi0, xmin[j]) // cell != gx or max(yi0, ymin[j]) // cell != gy:
                    continue
                test(i, j)
    for bi in big:
        seen = set()
        gx0, gx1 = xmin[bi] // cell, xmax[bi] // cell
        gy0, gy1 = ymin[bi] // cell, ymax[bi] // cell
        for gx in range(gx0, gx1 + 1):
            for gy in range(gy0, gy1 + 1):
                for j in grid.get((gx, gy), ()):
                    if j not in seen:
                        seen.add(j)
                        if not (xmin[j] > xmax[bi] or xmax[j] < xmin[bi]
                                or ymin[j] > ymax[bi] or ymax[j] < ymin[bi]):
                            test(bi, j)
        for bj in big:
            if bj > bi and not (xmin[bj] > xmax[bi] or xmax[bj] < xmin[bi]
                                or ymin[bj] > ymax[bi] or ymax[bj] < ymin[bi]):
                test(bi, bj)
    return splits


def _topo_merge_piece(recs, a, b, w, owners, cancel):
    """Add the piece a -> b with weight ``w`` (along a -> b) to ``recs`` under its canonical
    key (smaller point first)."""
    if a == b:
        return
    if a > b:
        a, b = b, a
        w = -w
    rec = recs.get((a, b))
    if rec is None:
        recs[(a, b)] = [w, set(owners) if owners else set()]
    else:
        rec[0] += w
        if owners:
            rec[1].update(owners)


def _topo_node(recs, cancel=True, max_passes=TOPO_MAX_NODE_PASSES, max_records=0):
    """Node a set of segments: ``recs`` maps canonical ``(u, v)`` to ``[weight, owners]``.

    Repeats until no two segments cross, touch inside one another or overlap partly.
    With ``cancel`` pieces whose summed weight is zero disappear (net chain); without it
    every piece stays (overlay). With ``max_records`` the run stops with ``TopoLimitError``
    when the pieces outgrow it. Returns ``(recs, stable)``.
    """
    stable = False
    for _ in range(max_passes):
        keys = list(recs)
        if max_records and len(keys) >= max_records:
            raise TopoLimitError("edge pieces", len(keys), max_records)
        splits = _topo_find_splits(keys, max_records - len(keys) if max_records else 0)
        if not splits:
            stable = True
            break
        new = {}
        for i, key in enumerate(keys):
            w, owners = recs[key]
            pts = splits.get(i)
            if not pts:
                rec = new.get(key)
                if rec is None:
                    new[key] = [w, set(owners)]
                else:
                    rec[0] += w
                    rec[1].update(owners)
                continue
            u, v = key
            ux, uy = u
            dx, dy = v[0] - ux, v[1] - uy
            chain = [u] + sorted(pts, key=lambda p: (p[0] - ux) * dx + (p[1] - uy) * dy) + [v]
            for a, b in zip(chain, chain[1:]):
                _topo_merge_piece(new, a, b, w, owners, cancel)
        if cancel:
            new = dict((k, r) for k, r in new.items() if r[0] != 0)
        recs = new
        if max_records and len(recs) > max_records:
            raise TopoLimitError("edge pieces", len(recs), max_records)
    return recs, stable


# --------------------------------------------------------------------------
# Faces of a noded edge set
# --------------------------------------------------------------------------

def _topo_ang_cmp(centre, a, b):
    ax, ay = a[0] - centre[0], a[1] - centre[1]
    bx, by = b[0] - centre[0], b[1] - centre[1]
    ha = 0 if (ay > 0 or (ay == 0 and ax > 0)) else 1
    hb = 0 if (by > 0 or (by == 0 and bx > 0)) else 1
    if ha != hb:
        return ha - hb
    cr = ax * by - ay * bx
    if cr > 0:
        return -1
    if cr < 0:
        return 1
    la, lb = ax * ax + ay * ay, bx * bx + by * by
    return -1 if la < lb else (1 if la > lb else 0)


def _topo_in_ring_int(px, py, ring):
    """Exact even-odd test of a lattice point against an open lattice ring (the point must
    not lie on the ring)."""
    inside = False
    x1, y1 = ring[-1]
    for x2, y2 in ring:
        if (y1 > py) != (y2 > py):
            lhs = (x2 - x1) * (py - y1)
            rhs = (px - x1) * (y2 - y1)
            if (y2 > y1 and lhs > rhs) or (y2 < y1 and lhs < rhs):
                inside = not inside
        x1, y1 = x2, y2
    return inside


def _topo_faces(keys):
    """Bounded faces of a noded planar edge set.

    Returns a list of ``{"shell", "holes", "area2", "perimeter", "bbox"}``: ``shell`` is a
    counter-clockwise open lattice ring (the face is on the left of its edges), ``holes``
    are clockwise rings of other components inside it, ``area2`` is twice the area of the
    face (shell minus holes), ``perimeter`` the total ring length (lattice steps).
    """
    adj = {}
    for u, v in keys:
        adj.setdefault(u, []).append(v)
        adj.setdefault(v, []).append(u)
    nb = {}
    pos = {}
    for v, lst in adj.items():
        if len(lst) > 2:
            lst.sort(key=cmp_to_key(lambda a, b, c=v: _topo_ang_cmp(c, a, b)))
        nb[v] = lst
        for i, w in enumerate(lst):
            pos[(v, w)] = i
    comp = {}
    ncomp = 0
    for start in nb:
        if start in comp:
            continue
        stack = [start]
        comp[start] = ncomp
        while stack:
            x = stack.pop()
            for y in nb[x]:
                if y not in comp:
                    comp[y] = ncomp
                    stack.append(y)
        ncomp += 1
    visited = set()
    shells, holes = [], []
    for u in nb:
        for v in nb[u]:
            if (u, v) in visited:
                continue
            cyc = []
            a, b = u, v
            while (a, b) not in visited:
                visited.add((a, b))
                cyc.append(a)
                lst = nb[b]
                c = lst[(pos[(b, a)] - 1) % len(lst)]
                a, b = b, c
            a2 = _topo_area2(cyc)
            if a2 > 0:
                shells.append((cyc, a2, comp[cyc[0]]))
            elif a2 < 0:
                holes.append((cyc, a2, comp[cyc[0]]))
    faces = []
    for cyc, a2, c in shells:
        xs = [p[0] for p in cyc]
        ys = [p[1] for p in cyc]
        faces.append({"shell": cyc, "holes": [], "area2": a2, "shell2": a2, "comp": c,
                      "bbox": (min(xs), min(ys), max(xs), max(ys))})
    if holes and faces:
        spans = sorted(max(f["bbox"][2] - f["bbox"][0], f["bbox"][3] - f["bbox"][1])
                       for f in faces)
        index = _TopoBoxIndex(max(spans[len(spans) // 2] * 2, 1))
        for i, f in enumerate(faces):
            index.insert(i, f["bbox"])
        for cyc, a2, c in holes:
            px, py = cyc[0]
            best = None
            for i in index.query((px, py, px, py)):
                f = faces[i]
                if f["comp"] == c:
                    continue
                if best is not None and f["shell2"] >= faces[best]["shell2"]:
                    continue
                if _topo_in_ring_int(px, py, f["shell"]):
                    best = i
            if best is not None:
                faces[best]["holes"].append(cyc)
                faces[best]["area2"] += a2
    for f in faces:
        per = 0.0
        for ring in [f["shell"]] + f["holes"]:
            x0, y0 = ring[-1]
            for x1, y1 in ring:
                per += math.hypot(x1 - x0, y1 - y0)
                x0, y0 = x1, y1
        f["perimeter"] = per
    return faces


# --------------------------------------------------------------------------
# Locating points, sampling faces
# --------------------------------------------------------------------------

TOPO_EPS = 1e-7  # lattice steps: a point this close to an edge is "on" it


def _topo_locate(px, py, ring, eps=TOPO_EPS):
    """1 inside, 0 outside, -1 on the boundary (within ``eps``) of an open ring."""
    inside = False
    x1, y1 = ring[-1]
    e2 = eps * eps
    for x2, y2 in ring:
        dx, dy = x2 - x1, y2 - y1
        if (min(x1, x2) - eps <= px <= max(x1, x2) + eps
                and min(y1, y2) - eps <= py <= max(y1, y2) + eps):
            cr = dx * (py - y1) - dy * (px - x1)
            if cr * cr <= e2 * (dx * dx + dy * dy):
                return -1
        if (y1 > py) != (y2 > py):
            if px < x1 + (py - y1) * dx / dy:
                inside = not inside
        x1, y1 = x2, y2
    return 1 if inside else 0


def _topo_part_locate(part, px, py):
    outer, holes = part
    state = _topo_locate(px, py, outer)
    if state != 1:
        return state
    for h in holes:
        hs = _topo_locate(px, py, h)
        if hs == -1:
            return -1
        if hs == 1:
            return 0
    return 1


def _topo_feature_locate(feat, px, py):
    """1 if the point is inside the feature, 0 outside, -1 if on its boundary."""
    bx0, by0, bx1, by1 = feat["bbox"]
    if px < bx0 - 1 or px > bx1 + 1 or py < by0 - 1 or py > by1 + 1:
        return 0
    result = 0
    for part in feat["parts"]:
        s = _topo_part_locate(part, px, py)
        if s == -1:
            return -1
        if s == 1:
            result = 1
    return result


def _topo_index_features(feats):
    """Add ``bbox`` to every feature and return a box index over the feature indexes."""
    sizes = []
    for f in feats:
        xs = [p[0] for part in f["parts"] for p in part[0]]
        ys = [p[1] for part in f["parts"] for p in part[0]]
        if xs:
            f["bbox"] = (min(xs), min(ys), max(xs), max(ys))
            sizes.append(max(f["bbox"][2] - f["bbox"][0], f["bbox"][3] - f["bbox"][1]))
        else:
            f["bbox"] = (0, 0, -1, -1)
    sizes.sort()
    index = _TopoBoxIndex(max(sizes[len(sizes) // 2] * 2, 4) if sizes else 4)
    for i, f in enumerate(feats):
        if f["parts"]:
            index.insert(i, f["bbox"])
    return index


def _topo_face_contains(face, px, py):
    if _topo_locate(px, py, face["shell"]) != 1:
        return False
    for h in face["holes"]:
        if _topo_locate(px, py, h) != 0:
            return False
    return True


def _topo_face_samples(face):
    """Candidate interior points of a face: just inside the longer edges of its shell."""
    shell = face["shell"]
    width = max(face["area2"] / face["perimeter"], 1.0) if face["perimeter"] else 1.0
    edges = []
    x0, y0 = shell[-1]
    for x1, y1 in shell:
        edges.append((math.hypot(x1 - x0, y1 - y0), x0, y0, x1, y1))
        x0, y0 = x1, y1
    edges.sort(reverse=True)
    for length, ax, ay, bx, by in edges[:8]:
        if length <= 0:
            continue
        nx, ny = -(by - ay) / length, (bx - ax) / length  # left normal = into the face
        mx, my = (ax + bx) / 2.0, (ay + by) / 2.0
        for factor in (0.25, 0.5, 0.1, 0.75):
            d = width * factor
            p = (mx + nx * d, my + ny * d)
            if _topo_face_contains(face, p[0], p[1]):
                yield p


def _topo_cover(layers, px, py):
    """``(counts, ambiguous)``: number of features of each layer covering the point."""
    counts = []
    for feats, index in layers:
        n = 0
        for i in index.query((px, py, px, py)):
            s = _topo_feature_locate(feats[i], px, py)
            if s == -1:
                return None, True
            n += s
        counts.append(n)
    return counts, False


def _topo_classify_face(face, layers):
    """``(counts, sample)`` for a face, or ``(None, None)`` when no clean sample is found."""
    for p in _topo_face_samples(face):
        counts, ambiguous = _topo_cover(layers, p[0], p[1])
        if not ambiguous:
            return counts, p
    return None, None


# --------------------------------------------------------------------------
# Measures of a face
# --------------------------------------------------------------------------

class _TopoCtx(object):
    """Run constants shared by the helpers."""

    def __init__(self, lat, unit_m, tol_m, opts):
        self.lat = lat
        self.unit_m = unit_m
        self.g_m = lat.g * unit_m          # metres per lattice step
        self.tol_m = tol_m
        self.radius = int(math.ceil(tol_m / self.g_m - 1e-9))   # tolerance in lattice steps
        self.min_area_m2 = float(opts["min_area_m2"])
        self.max_gap_m2 = float(opts["max_gap_m2"])
        self.progress = opts.get("progress")
        limit = int(opts.get("max_regions") or 0)
        self.max_regions = limit
        self.max_faces = max(limit * TOPO_FACES_PER_REGION, TOPO_MIN_PIECES) if limit else 0
        self.max_pieces = max(limit * TOPO_NODE_RECORDS_PER_REGION, TOPO_MIN_PIECES) if limit else 0

    @staticmethod
    def check_limit(what, count, limit):
        if limit and count > limit:
            raise TopoLimitError(what, count, limit)

    def area_m2(self, face):
        return face["area2"] / 2.0 * self.g_m * self.g_m

    def width_m(self, face):
        return face["area2"] / face["perimeter"] * self.g_m if face["perimeter"] else 0.0

    def thick(self, face):
        """True for a face wider than the tolerance (narrower ones are noise)."""
        return face["area2"] > 0 and self.width_m(face) > self.tol_m

    def say(self, text):
        if self.progress:
            self.progress(text)


def _topo_face_rings_xy(face, lat):
    """Output rings of a face in layer units: outer clockwise, holes counter-clockwise."""
    rings = [lat.ring_xy(list(reversed(face["shell"])))]
    for h in face["holes"]:
        rings.append(lat.ring_xy(list(reversed(h))))
    return rings


def _topo_scan_point(rings):
    """A point inside the region (even-odd rule over all rings): the middle of the widest
    stretch of a horizontal line through the region, tried at several heights. Used for
    regions too thin for the pole-of-inaccessibility search."""
    ys = sorted(set(p[1] for ring in rings for p in ring))
    if len(ys) < 2:
        return rings[0][0]
    count = min(len(ys) - 1, 25)
    picks = sorted(set(int(k * (len(ys) - 1) / float(count + 1)) for k in range(1, count + 1))
                   | set([len(ys) // 2 - 1 if len(ys) > 2 else 0]))
    best_width, best = -1.0, None
    for k in picks:
        y = (ys[k] + ys[k + 1]) / 2.0
        xs = []
        for ring in rings:
            x1, y1 = ring[-1]
            for x2, y2 in ring:
                if (y1 > y) != (y2 > y):
                    xs.append(x1 + (y - y1) * (x2 - x1) / (y2 - y1))
                x1, y1 = x2, y2
        xs.sort()
        for i in range(0, len(xs) - 1, 2):
            if xs[i + 1] - xs[i] > best_width:
                best_width, best = xs[i + 1] - xs[i], ((xs[i] + xs[i + 1]) / 2.0, y)
    return best if best is not None else rings[0][0]


def _topo_inside_clearance(rings, px, py):
    """``(inside, distance)``: even-odd inside test of a point over all rings and its
    distance to the nearest ring segment."""
    inside = False
    best = float("inf")
    for ring in rings:
        x1, y1 = ring[-1]
        for x2, y2 in ring:
            if (y1 > py) != (y2 > py) and px < x1 + (py - y1) * (x2 - x1) / (y2 - y1):
                inside = not inside
            dx, dy = x2 - x1, y2 - y1
            len2 = dx * dx + dy * dy
            t = ((px - x1) * dx + (py - y1) * dy) / len2 if len2 else 0.0
            t = 0.0 if t < 0.0 else (1.0 if t > 1.0 else t)
            d = math.hypot(x1 + t * dx - px, y1 + t * dy - py)
            if d < best:
                best = d
            x1, y1 = x2, y2
    return inside, best


def _topo_anchor(rings, ctx, width_m=0.0):
    """A point inside a region given as output rings.

    The centroid of the first ring when it lies inside with a clearance of at least 30 % of
    the mean width; else the pole of inaccessibility of the largest part (found down to
    5 % of the mean width, but not finer than 0.5 % of the extent); for a long thin region
    (mean width under 2 % of its extent), or when that search finds no inside point, the
    middle of the widest horizontal stretch through the region.
    """
    xs = [p[0] for ring in rings for p in ring]
    ys = [p[1] for ring in rings for p in ring]
    extent = max(max(xs) - min(xs), max(ys) - min(ys))
    width = width_m / ctx.unit_m
    ring = rings[0]
    ox, oy = ring[0]           # local origin: no loss of digits at large coordinates
    a2 = cx = cy = 0.0
    x1, y1 = ring[-1][0] - ox, ring[-1][1] - oy
    for x2, y2 in ring:
        x2, y2 = x2 - ox, y2 - oy
        cr = x1 * y2 - x2 * y1
        a2 += cr
        cx += (x1 + x2) * cr
        cy += (y1 + y2) * cr
        x1, y1 = x2, y2
    if a2:
        cx, cy = ox + cx / (3.0 * a2), oy + cy / (3.0 * a2)
        inside, clearance = _topo_inside_clearance(rings, cx, cy)
        if inside and clearance >= 0.3 * width:
            return (cx, cy)
    if width < extent * 0.02:        # long and thin: the pole search would take very long
        return _topo_scan_point(rings)
    precision = max(ctx.lat.g * 4.0, width * 0.05, extent * 0.005)
    res = polygon_anchor(rings, precision)
    if res and res["distance"] > 0:
        return res["point"]
    return _topo_scan_point(rings)


def _topo_fmt(value):
    text = "{0:.6f}".format(value).rstrip("0").rstrip(".")
    return text if text not in ("", "-0") else "0"


def _topo_oid_text(oids, limit=8):
    oids = sorted(oids)
    text = ", ".join(str(o) for o in oids[:limit])
    if len(oids) > limit:
        text += " (+{0} more)".format(len(oids) - limit)
    return text


# --------------------------------------------------------------------------
# Local overlay (atomic faces of a few polygons, labelled by covering polygon)
# --------------------------------------------------------------------------

def _topo_overlay(items, ctx, stats):
    """Atomic faces of the polygons in ``items`` (``[(label, feature)]``).

    Returns ``[(face, labels, sample)]`` for every face wider than the tolerance, where
    ``labels`` is the frozenset of the labels of the polygons that cover the face.
    """
    recs = {}
    for _label, feat in items:
        for outer, holes in feat["parts"]:
            for ring in [outer] + holes:
                prev = ring[-1]
                for p in ring:
                    if p != prev:
                        key = (prev, p) if prev < p else (p, prev)
                        if key not in recs:
                            recs[key] = [1, set()]
                    prev = p
    recs, stable = _topo_node(recs, cancel=False)
    if not stable:
        stats["noding_unstable"] += 1
    index = None
    if len(items) > 6:
        sizes = sorted(max(f["bbox"][2] - f["bbox"][0], f["bbox"][3] - f["bbox"][1])
                       for _l, f in items)
        index = _TopoBoxIndex(max(sizes[len(sizes) // 2] * 2, 4))
        for k, (_l, f) in enumerate(items):
            index.insert(k, f["bbox"])
    out = []
    for face in _topo_faces(list(recs)):
        if not ctx.thick(face):
            continue
        for p in _topo_face_samples(face):
            labels = set()
            ambiguous = False
            if index is None:
                near = range(len(items))
            else:
                near = index.query((p[0], p[1], p[0], p[1]))
            for k in near:
                label, feat = items[k]
                s = _topo_feature_locate(feat, p[0], p[1])
                if s == -1:
                    ambiguous = True
                    break
                if s == 1:
                    labels.add(label)
            if not ambiguous:
                out.append((face, frozenset(labels), p))
                break
        else:
            stats["unresolved_faces"] += 1
    return out


def _topo_components(groups):
    """Connected components (sets) of the elements of ``groups`` (sets that share an
    element are merged)."""
    parent = {}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    for g in groups:
        first = None
        for e in g:
            if e not in parent:
                parent[e] = e
            if first is None:
                first = e
            else:
                a, b = find(first), find(e)
                if a != b:
                    parent[b] = a
    comps = {}
    for e in parent:
        comps.setdefault(find(e), set()).add(e)
    return list(comps.values())


_TOPO_ALL_CANDIDATES = 60


class _TopoSegIndex(object):
    """Uniform grid over the boundary segments of a face; ``meets(a, b)`` tells whether the
    segment a-b crosses, touches inside or overlaps partly a boundary segment."""

    def __init__(self, rings=None, segs=None):
        self.segs = list(segs) if segs is not None else []
        for ring in rings or ():
            prev = ring[-1]
            for p in ring:
                if p != prev:
                    self.segs.append((prev, p))
                prev = p
        ext = sorted(max(abs(b[0] - a[0]), abs(b[1] - a[1])) for a, b in self.segs)
        self.cell = max(2 * ext[len(ext) // 2], 1) if ext else 1
        self.grid = {}
        self.big = []
        for k, (a, b) in enumerate(self.segs):
            gx0, gx1 = min(a[0], b[0]) // self.cell, max(a[0], b[0]) // self.cell
            gy0, gy1 = min(a[1], b[1]) // self.cell, max(a[1], b[1]) // self.cell
            if (gx1 - gx0 + 1) * (gy1 - gy0 + 1) > TOPO_BIG_SEGMENT_CELLS:
                self.big.append(k)
                continue
            for gx in range(gx0, gx1 + 1):
                for gy in range(gy0, gy1 + 1):
                    self.grid.setdefault((gx, gy), []).append(k)

    def candidates(self, a, b, pad=0):
        """Indexes of the boundary segments whose cells meet the box of a-b (grown by pad)."""
        cell = self.cell
        gx0, gx1 = int((min(a[0], b[0]) - pad) // cell), int((max(a[0], b[0]) + pad) // cell)
        gy0, gy1 = int((min(a[1], b[1]) - pad) // cell), int((max(a[1], b[1]) + pad) // cell)
        if (gx1 - gx0 + 1) * (gy1 - gy0 + 1) > TOPO_BIG_SEGMENT_CELLS:
            return range(len(self.segs))
        found = set(self.big)
        for gx in range(gx0, gx1 + 1):
            for gy in range(gy0, gy1 + 1):
                found.update(self.grid.get((gx, gy), ()))
        return found

    def meets(self, a, b):
        for k in self.candidates(a, b):
            c, d = self.segs[k]
            if _topo_hit(a, b, c, d) is not None:
                return True
        return False

    def near(self, p, radius):
        """True when the point is within ``radius`` of a boundary segment."""
        r2 = radius * radius
        for k in self.candidates(p, p, int(radius) + 1):
            (ax, ay), (bx, by) = self.segs[k]
            dx, dy = bx - ax, by - ay
            len2 = dx * dx + dy * dy
            t = ((p[0] - ax) * dx + (p[1] - ay) * dy) / len2 if len2 else 0.0
            t = 0.0 if t < 0.0 else (1.0 if t > 1.0 else t)
            ex, ey = ax + t * dx - p[0], ay + t * dy - p[1]
            if ex * ex + ey * ey <= r2:
                return True
        return False


def _topo_face_state(face, px, py):
    """1 inside the face, 0 outside, -1 on its boundary."""
    s = _topo_locate(px, py, face["shell"])
    if s != 1:
        return s
    for h in face["holes"]:
        hs = _topo_locate(px, py, h)
        if hs == -1:
            return -1
        if hs == 1:
            return 0
    return 1


def _topo_feature_meets(face, feat, probe):
    """True when the feature has a boundary that meets the face boundary or lies inside the
    face (so the feature may cover part of the face)."""
    for part in feat["parts"]:
        for ring in [part[0]] + part[1]:
            prev = ring[-1]
            for p in ring:
                if probe.meets(prev, p):
                    return True
                prev = p
            tries = 0
            n = len(ring)
            for i in range(n):
                a, b = ring[i - 1], ring[i]
                for q in (b, ((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0)):
                    st = _topo_face_state(face, q[0], q[1])
                    if st == 1:
                        return True
                    if st == 0:
                        tries = 99
                        break
                if tries == 99 or i >= 3:
                    break
    return False


def _topo_candidates(face, feats, index, sample):
    """Indexes of the features that may cover part of the face: every feature whose box
    meets the face box when there are few; else those that cover the sample point, whose
    boundary meets the face boundary or whose boundary lies inside the face."""
    cands = index.query(face["bbox"])
    if len(cands) <= _TOPO_ALL_CANDIDATES:
        return cands
    keep = []
    probe = None
    for i in cands:
        f = feats[i]
        if sample is not None and _topo_feature_locate(f, sample[0], sample[1]) != 0:
            keep.append(i)
            continue
        if probe is None:
            probe = _TopoSegIndex([face["shell"]] + face["holes"])
        if _topo_feature_meets(face, f, probe):
            keep.append(i)
    return keep


def _topo_next_out(b, a, outs):
    """Of the edges leaving ``b`` (their ends ``outs``), the first one met turning clockwise
    from the direction b -> a: the sharpest left turn after arriving along a -> b, so the
    traced ring keeps the region on its left and splits at a vertex where it pinches."""
    if len(outs) == 1:
        return outs[0]
    order = sorted(set(outs) | set([a]), key=cmp_to_key(lambda p, q: _topo_ang_cmp(b, p, q)))
    k = order.index(a)
    for step in range(1, len(order) + 1):
        c = order[(k - step) % len(order)]
        if c != a or c in outs:
            return c
    return outs[0]


def _topo_merge_faces(faces):
    """Merge the atomic faces of one error row into its regions.

    The faces of a row may share edges (the edges of a third feature cut a pair's overlap
    into several faces). Every face ring has its face on the left, so an edge shared by two
    faces of the row appears once in each direction: those cancel, and what is left is the
    boundary of the union. Returns ``[(area2, perimeter, rings)]``, one entry per region
    (faces joined through shared edges; regions that touch only at a vertex are separate,
    as in a simple-features polygon), largest first. ``rings`` are open lattice rings with
    the region on the left (outer counter-clockwise, holes clockwise), the outer ring first.
    """
    parent = list(range(len(faces)))

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    owner = {}           # canonical edge -> first face index
    net = {}             # canonical edge -> net weight (+1 along u -> v)
    for k, f in enumerate(faces):
        for ring in [f["shell"]] + f["holes"]:
            prev = ring[-1]
            for p in ring:
                if p != prev:
                    if prev < p:
                        key, w = (prev, p), 1
                    else:
                        key, w = (p, prev), -1
                    net[key] = net.get(key, 0) + w
                    other = owner.get(key)
                    if other is None:
                        owner[key] = k
                    else:
                        ra, rb = find(other), find(k)
                        if ra != rb:
                            parent[rb] = ra
                prev = p
    outs = {}
    for (u, v), w in net.items():
        if w == 0:
            continue
        a, b = (u, v) if w > 0 else (v, u)
        for _ in range(abs(w)):
            outs.setdefault(a, []).append(b)
    used = {}
    regions = {}
    for start in list(outs):
        for v0 in outs[start]:
            if used.get((start, v0), 0) >= outs[start].count(v0):
                continue
            ring = []
            a, b = start, v0
            for _guard in range(len(net) * 2 + 4):
                used[(a, b)] = used.get((a, b), 0) + 1
                ring.append(a)
                c = _topo_next_out(b, a, outs[b])
                a, b = b, c
                if used.get((a, b), 0) >= outs[a].count(b):
                    break
            if len(ring) < 3:
                continue
            key = (min(ring[0], ring[1]), max(ring[0], ring[1]))
            root = find(owner[key])
            regions.setdefault(root, []).append(ring)
    out = []
    for root, rings in regions.items():
        area2 = 0
        per = 0.0
        signed = []
        for ring in rings:
            a2 = _topo_area2(ring)
            area2 += a2
            signed.append(a2)
            x0, y0 = ring[-1]
            for x1, y1 in ring:
                per += math.hypot(x1 - x0, y1 - y0)
                x0, y0 = x1, y1
        order = sorted(range(len(rings)), key=lambda i: -signed[i])
        out.append((area2, per, [rings[i] for i in order]))
    out.sort(key=lambda r: -r[0])
    return out


def _topo_region_row(rule, layer, oid_a, oid_b, faces, ctx, unit_label="m2"):
    """One error row for a set of faces (the same pair of features / the same gap).

    The faces are merged first (``_topo_merge_faces``): PIECES counts the separate regions,
    the rings are those of the merged regions (no edge shared between two parts), and the
    width is 2 x area / perimeter of the whole error, all measured on the merged rings.
    """
    area = sum(ctx.area_m2(f) for f in faces)
    regions = _topo_merge_faces(faces)
    rings = []
    total2 = 0
    per = 0.0
    for a2, p, rs in regions:
        total2 += a2
        per += p
        for r in rs:
            rings.append(ctx.lat.ring_xy(list(reversed(r))))
    width = total2 / per * ctx.g_m if per else 0.0
    if regions:
        a2, p, rs = regions[0]
        anchor_rings = [ctx.lat.ring_xy(list(reversed(r))) for r in rs]
        anchor = _topo_anchor(anchor_rings, ctx, a2 / p * ctx.g_m if p else 0.0)
    else:      # cannot happen for faces of positive area; kept as a safe fallback
        best = max(faces, key=lambda f: f["area2"])
        anchor = _topo_anchor(_topo_face_rings_xy(best, ctx.lat), ctx, ctx.width_m(best))
    return {"rule": rule, "layer": layer, "oid_a": oid_a, "oid_b": oid_b, "value": area,
            "unit": unit_label, "width": width,
            "pieces": len(regions) if regions else len(faces),
            "point": anchor, "rings": rings, "detail": ""}


def _topo_overlap_rows(face_info, feats, index, ctx, stats):
    """OVERLAP rows (one per pair of features) for the faces covered by >= 2 polygons."""
    groups = []
    for face, sample in face_info:
        groups.append(frozenset(_topo_candidates(face, feats, index, sample)))
    pairs = {}
    for comp in _topo_components([g for g in groups if len(g) >= 2]):
        items = [(feats[i]["oid"], feats[i]) for i in sorted(comp)]
        for face, labels, _p in _topo_overlay(items, ctx, stats):
            if len(labels) >= 2:
                lab = sorted(labels)
                for x in range(len(lab)):
                    for y in range(x + 1, len(lab)):
                        pairs.setdefault((lab[x], lab[y]), []).append(face)
    rows = []
    for (a, b), faces in pairs.items():
        if sum(ctx.area_m2(f) for f in faces) < ctx.min_area_m2:
            stats["below_min_area"] += 1      # too small to report: no row is built
            continue
        row = _topo_region_row(TOPO_RULE_OVERLAP, "INPUT", a, b, faces, ctx)
        row["detail"] = "Features {0} and {1} overlap by {2} m2 (mean width {3} m).".format(
            a, b, _topo_fmt(row["value"]), _topo_fmt(row["width"]))
        rows.append(row)
    return rows


def _topo_other_rows(suspects, feats_a, index_a, feats_b, index_b, rules, ctx, stats):
    """Rows of the rules between the input and the other layer.

    ``suspects``: ``[(face, sample, count_input, count_other)]``.
    """
    groups, prim_a, prim_b = [], set(), set()
    for face, sample, na, nb in suspects:
        ca = _topo_candidates(face, feats_a, index_a, sample) if na else []
        cb = _topo_candidates(face, feats_b, index_b, sample) if nb else []
        g = set(("A", i) for i in ca) | set(("B", j) for j in cb)
        if g:
            groups.append(g)
        # the neighbours of a candidate are added once per candidate (not once per suspect
        # face): the components are the same and a large polygon is queried only once
        for i in ca:
            if i not in prim_a:
                prim_a.add(i)
                groups.append(set([("A", i)]) | set(
                    ("B", j) for j in index_b.query(feats_a[i]["bbox"])))
        for j in cb:
            if j not in prim_b:
                prim_b.add(j)
                groups.append(set([("B", j)]) | set(
                    ("A", i) for i in index_a.query(feats_b[j]["bbox"])))
    primary_a = set(feats_a[i]["oid"] for i in prim_a)
    primary_b = set(feats_b[j]["oid"] for j in prim_b)
    acc = {}
    for comp in _topo_components(groups):
        items = []
        for side, i in sorted(comp):
            feat = feats_a[i] if side == "A" else feats_b[i]
            items.append(((side, feat["oid"]), feat))
        for face, labels, _p in _topo_overlay(items, ctx, stats):
            la = sorted(o for s, o in labels if s == "A")
            lb = sorted(o for s, o in labels if s == "B")
            if la and not lb and TOPO_RULE_NOT_COVERED in rules:
                for a in la:
                    if a in primary_a:
                        acc.setdefault((TOPO_RULE_NOT_COVERED, a, None), []).append(face)
            if la and lb and TOPO_RULE_OVERLAPS_OTHER in rules:
                for a in la:
                    for b in lb:
                        acc.setdefault((TOPO_RULE_OVERLAPS_OTHER, a, b), []).append(face)
            if lb and not la and TOPO_RULE_OTHER_NOT_COVERED in rules:
                for b in lb:
                    if b in primary_b:
                        acc.setdefault((TOPO_RULE_OTHER_NOT_COVERED, None, b), []).append(face)
    rows = []
    for (rule, a, b), faces in acc.items():
        layer = "OTHER" if rule == TOPO_RULE_OTHER_NOT_COVERED else "INPUT"
        row = _topo_region_row(rule, layer, a, b, faces, ctx)
        if rule == TOPO_RULE_NOT_COVERED:
            row["detail"] = ("{0} m2 of input feature {1} is not covered by the other "
                             "layer.").format(_topo_fmt(row["value"]), a)
        elif rule == TOPO_RULE_OVERLAPS_OTHER:
            row["detail"] = ("Input feature {0} overlaps other feature {1} by {2} "
                             "m2.").format(a, b, _topo_fmt(row["value"]))
        else:
            row["detail"] = ("{0} m2 of other feature {1} is not covered by the input "
                             "layer.").format(_topo_fmt(row["value"]), b)
        rows.append(row)
    return rows


def _topo_gap_row(face, owners_map, feats_oids, ctx):
    owners = set()
    for ring in [face["shell"]] + face["holes"]:
        prev = ring[-1]
        for p in ring:
            key = (prev, p) if prev < p else (p, prev)
            rec = owners_map.get(key)
            if rec:
                owners.update(rec[1])
            prev = p
    row = _topo_region_row(TOPO_RULE_GAP, "INPUT", None, None, [face], ctx)
    oids = sorted(owners)
    row["oid_a"] = oids[0] if oids else None
    row["oid_b"] = oids[1] if len(oids) > 1 else None
    if len(oids) == 1 and not face["holes"]:
        who = "inside feature {0} (a hole in that polygon)".format(oids[0])
    elif oids:
        who = "surrounded by {0} feature(s): OID {1}".format(len(oids), _topo_oid_text(oids))
    else:
        who = "with no surrounding feature found"
    row["detail"] = "Gap of {0} m2 (width {1} m) {2}.".format(
        _topo_fmt(row["value"]), _topo_fmt(row["width"]), who)
    return row


# --------------------------------------------------------------------------
# SLIVER
# --------------------------------------------------------------------------

def _topo_sliver_rings(shape):
    """The rings of one feature in Esri order (each outer ring clockwise followed by its holes
    counter-clockwise), read like every other rule with ``_topo_group_rings``: a feature in
    OGC ring order (outer counter-clockwise, holes clockwise) is read by nesting, so its holes
    are subtracted from the area instead of being taken as further outer rings."""
    out = []
    for outer, holes in _topo_group_rings(shape)[0]:
        o = close_ring(outer)
        if ring_signed_area(o) > 0:
            o = o[::-1]
        out.append(o)
        for h in holes:
            h = close_ring(h)
            if ring_signed_area(h) < 0:
                h = h[::-1]
            out.append(h)
    return out


def _topo_sliver_rows(feats, ctx, opts):
    area_limit = float(opts["sliver_area_m2"])
    width_limit = float(opts["sliver_width_m"])
    if area_limit <= 0 and width_limit <= 0:
        return []
    rows = []
    unit = ctx.unit_m
    for f in feats:
        shape = _topo_sliver_rings(f["shape"]) or f["shape"]
        area = polygon_area(shape) * unit * unit
        perim = polygon_perimeter(shape) * unit
        width = 2.0 * area / perim if perim > 0 else 0.0
        by_area = area_limit > 0 and area < area_limit
        by_width = width_limit > 0 and width < width_limit
        flagged = (by_area and by_width) if (area_limit > 0 and width_limit > 0) \
            else (by_area or by_width)
        if not flagged:
            continue
        rings = [list(r) for r in shape]
        point = shape[0][0]
        if area > 0:
            point = _topo_anchor(shape, ctx, width)
        row = {"rule": TOPO_RULE_SLIVER, "layer": "INPUT", "oid_a": f["oid"], "oid_b": None,
               "value": area, "unit": "m2", "width": width, "pieces": 1, "point": point,
               "rings": rings,
               "detail": "Polygon area {0} m2, average width {1} m.".format(
                   _topo_fmt(area), _topo_fmt(width))}
        rows.append(row)
    return rows


# --------------------------------------------------------------------------
# Lines
# --------------------------------------------------------------------------

def _topo_line_prepare(rows, lat):
    """Line features as ``{"oid", "paths": [[lattice points]], "shape"}``; a path keeps its
    vertices without consecutive duplicates. Returns ``(features, null_oids)``."""
    feats, nulls = [], []
    for row in rows:
        shape = row["shape"]
        if not shape:
            nulls.append(row["oid"])
            continue
        paths = []
        for path in shape:
            pts = []
            prev = None
            for x, y in path:
                p = lat.to_int(x, y)
                if p != prev:
                    pts.append(p)
                    prev = p
            if len(pts) >= 2:
                paths.append(pts)
        feats.append({"oid": row["oid"], "paths": paths, "shape": shape})
    return feats, nulls


def _topo_line_segments(feats):
    """``[(a, b, feature_index)]`` of every segment of the features."""
    segs = []
    for fi, f in enumerate(feats):
        for path in f["paths"]:
            for k in range(len(path) - 1):
                segs.append((path[k], path[k + 1], fi))
    return segs


def _topo_segment_pairs(segs, pad):
    """Candidate pairs ``(i, j)`` (i < j) of segments whose boxes (grown by ``pad``) meet,
    each pair once."""
    n = len(segs)
    if n < 2:
        return
    x0 = [0] * n
    x1 = [0] * n
    y0 = [0] * n
    y1 = [0] * n
    ext = []
    for i, (a, b, _f) in enumerate(segs):
        x0[i], x1[i] = (a[0], b[0]) if a[0] <= b[0] else (b[0], a[0])
        y0[i], y1[i] = (a[1], b[1]) if a[1] <= b[1] else (b[1], a[1])
        x0[i] -= pad
        y0[i] -= pad
        x1[i] += pad
        y1[i] += pad
        ext.append(max(x1[i] - x0[i], y1[i] - y0[i]))
    ext.sort()
    cell = max(2 * ext[n // 2], 1)
    grid = {}
    big = []
    for i in range(n):
        gx0, gx1 = x0[i] // cell, x1[i] // cell
        gy0, gy1 = y0[i] // cell, y1[i] // cell
        if (gx1 - gx0 + 1) * (gy1 - gy0 + 1) > TOPO_BIG_SEGMENT_CELLS:
            big.append(i)
            continue
        for gx in range(gx0, gx1 + 1):
            for gy in range(gy0, gy1 + 1):
                grid.setdefault((gx, gy), []).append(i)
    for (gx, gy), lst in grid.items():
        m = len(lst)
        for ii in range(m):
            i = lst[ii]
            for jj in range(ii + 1, m):
                j = lst[jj]
                if x0[j] > x1[i] or x1[j] < x0[i] or y0[j] > y1[i] or y1[j] < y0[i]:
                    continue
                if max(x0[i], x0[j]) // cell != gx or max(y0[i], y0[j]) // cell != gy:
                    continue
                yield (i, j) if i < j else (j, i)
    big_set = set(big)
    for bi in big:
        for j in range(n):
            if j == bi:
                continue
            if x0[j] > x1[bi] or x1[j] < x0[bi] or y0[j] > y1[bi] or y1[j] < y0[bi]:
                continue
            if j in big_set and j < bi:
                continue
            yield (bi, j) if bi < j else (j, bi)


def _topo_parallel_overlap(a, b, c, d, tol):
    """Where two segments run together within ``tol`` (lattice steps) of each other.

    Returns ``None`` or ``(key, lo, hi)``: the shorter segment must lie in the band of
    half-width ``tol`` around the longer one; ``key`` identifies the supporting line of the
    longer segment (direction reduced by its gcd, offset) and ``lo``/``hi`` are the ends of
    the shared stretch along that line (lattice steps), so stretches of the same line can
    be merged.
    """
    lab2 = (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2
    lcd2 = (d[0] - c[0]) ** 2 + (d[1] - c[1]) ** 2
    if lab2 < lcd2:
        a, b, c, d = c, d, a, b
        lab2, lcd2 = lcd2, lab2
    if lab2 == 0:
        return None
    dx, dy = b[0] - a[0], b[1] - a[1]
    length = math.sqrt(lab2)
    t2 = tol * length
    cc = dx * (c[1] - a[1]) - dy * (c[0] - a[0])
    cd = dx * (d[1] - a[1]) - dy * (d[0] - a[0])
    if abs(cc) > t2 or abs(cd) > t2:
        return None
    g = math.gcd(abs(dx), abs(dy))
    ux, uy = dx // g, dy // g
    if ux < 0 or (ux == 0 and uy < 0):
        ux, uy = -ux, -uy
    norm = math.sqrt(ux * ux + uy * uy)

    def along(p):
        return (p[0] * ux + p[1] * uy) / norm

    s1, s2 = along(a), along(b)
    lo1, hi1 = (s1, s2) if s1 <= s2 else (s2, s1)
    s3, s4 = along(c), along(d)
    lo2, hi2 = (s3, s4) if s3 <= s4 else (s4, s3)
    lo, hi = max(lo1, lo2), min(hi1, hi2)
    if hi <= lo:
        return None
    return (ux, uy, ux * a[1] - uy * a[0]), lo, hi


def _topo_merged_length(intervals):
    """Total length of the union of ``[(lo, hi)]`` and the longest merged stretch
    ``(length, lo, hi)``."""
    total = 0.0
    best = (0.0, 0.0, 0.0)
    cur_lo = cur_hi = None
    for lo, hi in sorted(intervals):
        if cur_hi is None or lo > cur_hi:
            if cur_hi is not None:
                total += cur_hi - cur_lo
                if cur_hi - cur_lo > best[0]:
                    best = (cur_hi - cur_lo, cur_lo, cur_hi)
            cur_lo, cur_hi = lo, hi
        elif hi > cur_hi:
            cur_hi = hi
    if cur_hi is not None:
        total += cur_hi - cur_lo
        if cur_hi - cur_lo > best[0]:
            best = (cur_hi - cur_lo, cur_lo, cur_hi)
    return total, best


def _topo_stretch_midpoint(key, lo, hi):
    """Lattice point (float) in the middle of the stretch ``lo..hi`` on the line ``key``."""
    ux, uy, off = key
    norm2 = float(ux * ux + uy * uy)
    s = (lo + hi) / 2.0 * math.sqrt(norm2)   # = x * ux + y * uy for the point
    # solve x * ux + y * uy = s and ux * y - uy * x = off
    return ((s * ux - off * uy) / norm2, (s * uy + off * ux) / norm2)


def _topo_side(c, p, q):
    """Sign of the turn c -> p -> q seen from p (cross of (p - c) and (q - c))."""
    v = (p[0] - c[0]) * (q[1] - c[1]) - (p[1] - c[1]) * (q[0] - c[0])
    return (v > 0) - (v < 0)


def _topo_dir_cmp(centre, a, b):
    """Compare the directions centre->a and centre->b by angle only (0 = same direction)."""
    ax, ay = a[0] - centre[0], a[1] - centre[1]
    bx, by = b[0] - centre[0], b[1] - centre[1]
    ha = 0 if (ay > 0 or (ay == 0 and ax > 0)) else 1
    hb = 0 if (by > 0 or (by == 0 and bx > 0)) else 1
    if ha != hb:
        return ha - hb
    cr = ax * by - ay * bx
    return -1 if cr > 0 else (1 if cr < 0 else 0)


def _topo_crosses_at(p, a_prev, a_next, b_prev, b_next):
    """True when two lines that both pass through ``p`` cross there: the neighbours of one
    lie on both sides of the other. Lines that share a direction are not a crossing."""
    c0 = _topo_dir_cmp(p, a_prev, a_next)

    def inside_wedge(q):
        c1 = _topo_dir_cmp(p, a_prev, q)
        c2 = _topo_dir_cmp(p, q, a_next)
        if c1 == 0 or c2 == 0:
            return None
        if c0 < 0:
            return c1 < 0 and c2 < 0
        return c1 < 0 or c2 < 0

    if c0 == 0:
        return False
    ia = inside_wedge(b_prev)
    ib = inside_wedge(b_next)
    if ia is None or ib is None:
        return False
    return ia != ib


def _topo_point_on_segment_int(p, a, b):
    cr = (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0])
    if cr != 0:
        return False
    return min(a[0], b[0]) <= p[0] <= max(a[0], b[0]) and min(a[1], b[1]) <= p[1] <= max(a[1], b[1])


def _topo_vertex_table(feats):
    """``{point: {feature_index: [(prev, next)]}}`` for the vertices of the lines; a path
    end has ``None`` for the missing neighbour."""
    table = {}
    for fi, f in enumerate(feats):
        for path in f["paths"]:
            n = len(path)
            closed = n > 2 and path[0] == path[-1]
            for k, p in enumerate(path):
                prev = path[k - 1] if k > 0 else (path[-2] if closed else None)
                nxt = path[k + 1] if k < n - 1 else (path[1] if closed else None)
                if closed and k == n - 1:
                    continue
                table.setdefault(p, {}).setdefault(fi, []).append((prev, nxt))
    return table


def _topo_path_ends(feats):
    """``[[end points]]`` per line feature: the first and last vertex of each open path."""
    out = []
    for f in feats:
        pts = []
        for path in f["paths"]:
            if len(path) > 2 and path[0] == path[-1]:
                continue
            pts.append(path[0])
            pts.append(path[-1])
        out.append(pts)
    return out


def _topo_near_end(p, end_points, tol):
    """Whether lattice point p is within ``tol`` of one of the end points."""
    t2 = tol * tol
    for e in end_points:
        if (p[0] - e[0]) ** 2 + (p[1] - e[1]) ** 2 <= t2:
            return True
    return False


def _topo_touch_crossing(p, fi, fj, a, b, c, d, table):
    """Whether lines fi and fj cross at the lattice point p, where segment a-b of fi meets
    segment c-d of fj."""
    occ_i = table.get(p, {}).get(fi)
    occ_j = table.get(p, {}).get(fj)
    if not occ_i:
        occ_i = [(a, b)]
    if not occ_j:
        occ_j = [(c, d)]
    for pi, ni in occ_i:
        if pi is None or ni is None:
            continue
        for pj, nj in occ_j:
            if pj is None or nj is None:
                continue
            if _topo_crosses_at(p, pi, ni, pj, nj):
                return True
    return False


def _topo_line_rows(feats, rules, ctx, stats):
    """LINE_SELF_OVERLAP and LINE_INTERSECT rows of one line layer."""
    segs = _topo_line_segments(feats)
    tol = float(ctx.radius)
    want_self = TOPO_RULE_LINE_SELF in rules
    want_int = TOPO_RULE_LINE_INTERSECT in rules
    if not (want_self or want_int) or len(segs) < 2:
        return []
    table = _topo_vertex_table(feats) if want_int else None
    ends = _topo_path_ends(feats) if want_int else None
    shared = {}        # (feature or pair) -> {line key: [(lo, hi)]}
    pair_cross = {}
    for i, j in _topo_segment_pairs(segs, int(math.ceil(tol))):
        a, b, fi = segs[i]
        c, d, fj = segs[j]
        if fi == fj and not want_self:
            continue
        if fi != fj and not want_int:
            continue
        piece = _topo_parallel_overlap(a, b, c, d, tol)
        if piece is not None and piece[2] - piece[1] > tol:
            gkey = fi if fi == fj else ((fi, fj) if fi < fj else (fj, fi))
            shared.setdefault(gkey, {}).setdefault(piece[0], []).append((piece[1], piece[2]))
            continue
        if fi == fj or piece is not None:
            continue
        key = (fi, fj) if fi < fj else (fj, fi)
        d1 = (d[0] - c[0]) * (a[1] - c[1]) - (d[1] - c[1]) * (a[0] - c[0])
        d2 = (d[0] - c[0]) * (b[1] - c[1]) - (d[1] - c[1]) * (b[0] - c[0])
        d3 = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
        d4 = (b[0] - a[0]) * (d[1] - a[1]) - (b[1] - a[1]) * (d[0] - a[0])
        points = []
        if d1 * d2 < 0 and d3 * d4 < 0:
            den = d3 - d4
            x = c[0] + _topo_round_div((d[0] - c[0]) * d3, den)
            y = c[1] + _topo_round_div((d[1] - c[1]) * d3, den)
            # a crossing within the tolerance of the end of either line is a touch (a line end
            # snapped to a resolution can lie a step across the line it was meant to meet)
            if not _topo_near_end((x, y), ends[fi], tol) and not _topo_near_end((x, y), ends[fj], tol):
                points.append(((x, y), True))
        elif d1 == 0 or d2 == 0 or d3 == 0 or d4 == 0:
            for p, on in ((a, d1 == 0), (b, d2 == 0), (c, d3 == 0), (d, d4 == 0)):
                if on and _topo_point_on_segment_int(p, a, b) \
                        and _topo_point_on_segment_int(p, c, d):
                    points.append((p, False))
        for p, proper in points:
            rec = pair_cross.setdefault(key, {})
            if p in rec:
                continue
            rec[p] = True if proper else _topo_touch_crossing(p, fi, fj, a, b, c, d, table)
    rows = []
    unit = ctx.g_m
    measured = {}
    for gkey, by_line in shared.items():
        total = 0.0
        best = (0.0, None)
        for lkey, ivs in by_line.items():
            length, (blen, blo, bhi) = _topo_merged_length(ivs)
            total += length
            if blen > best[0]:
                best = (blen, _topo_stretch_midpoint(lkey, blo, bhi))
        measured[gkey] = (total, best[1])
    for gkey, (total, mid) in measured.items():
        if isinstance(gkey, tuple):
            continue
        f = feats[gkey]
        rows.append({"rule": TOPO_RULE_LINE_SELF, "layer": "LINES", "oid_a": f["oid"],
                     "oid_b": None, "value": total * unit, "unit": "m", "width": None,
                     "pieces": 1, "point": ctx.lat.to_xy(mid), "rings": None,
                     "detail": "Line {0} runs along itself for {1} m.".format(
                         f["oid"], _topo_fmt(total * unit))})
    keys = set(k for k in measured if isinstance(k, tuple))
    keys |= set(k for k, rec in pair_cross.items() if any(rec.values()))
    for key in keys:
        fa, fb = feats[key[0]], feats[key[1]]
        length, mid = measured.get(key, (0.0, None))
        length *= unit
        crossings = sorted(p for p, ok in pair_cross.get(key, {}).items() if ok)
        if mid is None:
            mid = crossings[0]
        parts = []
        if length > 0:
            parts.append("overlap along {0} m".format(_topo_fmt(length)))
        if crossings:
            parts.append("{0} crossing(s)".format(len(crossings)))
        rows.append({"rule": TOPO_RULE_LINE_INTERSECT, "layer": "LINES", "oid_a": fa["oid"],
                     "oid_b": fb["oid"], "value": length, "unit": "m", "width": None,
                     "pieces": len(crossings), "point": ctx.lat.to_xy(mid), "rings": None,
                     "detail": "Lines {0} and {1}: {2}.".format(
                         fa["oid"], fb["oid"], " and ".join(parts))})
    return rows


def _topo_line_outside_rows(lines, ref_feats, ref_index, ctx):
    """LINE_OUTSIDE rows: the parts of each line outside the union of the reference
    polygons (farther than the tolerance from them)."""
    net = _topo_net_edges(ref_feats)
    keys = list(net)
    probe = _TopoSegIndex(segs=keys) if keys else None
    rows = []
    unit = ctx.g_m
    radius = float(ctx.radius)
    for f in lines:
        total = 0.0
        best = (0.0, None)
        for path in f["paths"]:
            for k in range(len(path) - 1):
                a, b = path[k], path[k + 1]
                pts = set()
                if probe is not None:
                    for idx in probe.candidates(a, b):
                        c, d = probe.segs[idx]
                        res = _topo_hit(a, b, c, d)
                        if res is not None:
                            pts.update(res[0])
                dx, dy = b[0] - a[0], b[1] - a[1]
                chain = [a] + sorted(pts, key=lambda q: (q[0] - a[0]) * dx + (q[1] - a[1]) * dy) + [b]
                for p, q in zip(chain, chain[1:]):
                    if p == q:
                        continue
                    length = math.hypot(q[0] - p[0], q[1] - p[1])
                    mid = ((p[0] + q[0]) / 2.0, (p[1] + q[1]) / 2.0)
                    if _topo_covered_closed(ref_feats, ref_index, mid):
                        continue
                    if probe is not None and probe.near(mid, radius):
                        continue
                    if length <= radius:
                        continue
                    total += length
                    if length > best[0]:
                        best = (length, mid)
        if total > 0:
            rows.append({"rule": TOPO_RULE_LINE_OUTSIDE, "layer": "LINES", "oid_a": f["oid"],
                         "oid_b": None, "value": total * unit, "unit": "m", "width": None,
                         "pieces": 1, "point": ctx.lat.to_xy(best[1]), "rings": None,
                         "detail": "{0} m of line {1} lies outside the polygons.".format(
                             _topo_fmt(total * unit), f["oid"])})
    return rows


def _topo_covered_closed(feats, index, p):
    """True when the point is inside or on the boundary of any polygon."""
    for i in index.query((p[0], p[1], p[0], p[1])):
        if _topo_feature_locate(feats[i], p[0], p[1]) != 0:
            return True
    return False


# --------------------------------------------------------------------------
# Driver
# --------------------------------------------------------------------------

TOPO_THIN_CLASSIFY_CAP = 20000
_TOPO_OTHER_WEIGHT = 1 << 24   # weight of the other layer's edges in the combined arrangement


def _topo_copy_layer(feats):
    return [{"oid": f["oid"], "shape": f["shape"],
             "parts": [[list(o), [list(h) for h in hs]] for o, hs in f["parts"]]}
            for f in feats]


def _topo_new_stats():
    return {"input_features": 0, "other_features": 0, "line_features": 0,
            "input_vanished": 0, "other_vanished": 0,
            "clustered_vertices": 0, "inserted_vertices": 0, "vanished_rings": 0,
            "net_edges": 0, "faces": 0, "noding_unstable": 0, "unresolved_faces": 0,
            "ignored_narrow_gaps": 0, "ignored_narrow_overlaps": 0,
            "ignored_narrow_other": 0, "ignored_narrow_unclassified": 0,
            "gaps_over_max": 0, "below_min_area": 0}


def _topo_effective_tolerance_m(opts):
    g_m = TOPO_GRID_M
    return max(float(opts["tolerance_m"]), 2.0 * g_m, 2.0 * float(opts["resolution_m"]))


def _topo_phase1_input(feats, ctx, rules, stats):
    """OVERLAP and GAP rows of the input layer (``feats`` is a snapped copy)."""
    net = _topo_net_edges(feats)
    stats["net_edges"] += len(net)
    recs, stable = _topo_node(net, max_records=ctx.max_pieces)
    if not stable:
        stats["noding_unstable"] += 1
    faces = _topo_faces(list(recs))
    stats["faces"] += len(faces)
    ctx.check_limit("faces", len(faces), ctx.max_faces)
    index = _topo_index_features(feats)
    layers = [(feats, index)]
    gaps, over = [], []
    thin_budget = TOPO_THIN_CLASSIFY_CAP
    for face in faces:
        if not ctx.thick(face):
            if thin_budget > 0:
                thin_budget -= 1
                counts, _s = _topo_classify_face(face, layers)
                if counts is None:
                    stats["ignored_narrow_unclassified"] += 1
                elif counts[0] == 0:
                    stats["ignored_narrow_gaps"] += 1
                elif counts[0] >= 2:
                    stats["ignored_narrow_overlaps"] += 1
            else:
                stats["ignored_narrow_unclassified"] += 1
            continue
        counts, sample = _topo_classify_face(face, layers)
        if counts is None:
            stats["unresolved_faces"] += 1
            continue
        if counts[0] == 0 and TOPO_RULE_GAP in rules:
            gaps.append(face)
        elif counts[0] >= 2 and TOPO_RULE_OVERLAP in rules:
            over.append((face, sample))
    ctx.check_limit("regions", len(gaps) + len(over), ctx.max_regions)
    rows = []
    for face in gaps:
        # the area decides before the (more expensive) row is built
        area = ctx.area_m2(face)
        if area < ctx.min_area_m2:
            stats["below_min_area"] += 1
        elif ctx.max_gap_m2 > 0 and area > ctx.max_gap_m2:
            stats["gaps_over_max"] += 1
        else:
            rows.append(_topo_gap_row(face, recs, None, ctx))
    if over:
        for row in _topo_overlap_rows(over, feats, index, ctx, stats):
            if row["value"] < ctx.min_area_m2:
                stats["below_min_area"] += 1
            else:
                rows.append(row)
    return rows


def _topo_phase1_other(feats_a, feats_b, ctx, rules, stats):
    """Rows of the rules between the input and the other layer (snapped copies)."""
    recs = {}
    for key, (w, _o) in _topo_net_edges(feats_a).items():
        recs[key] = [w, set()]
    for key, (w, _o) in _topo_net_edges(feats_b).items():
        rec = recs.get(key)
        if rec is None:
            recs[key] = [w * _TOPO_OTHER_WEIGHT, set()]
        else:
            rec[0] += w * _TOPO_OTHER_WEIGHT
    recs, stable = _topo_node(recs, max_records=ctx.max_pieces)
    if not stable:
        stats["noding_unstable"] += 1
    faces = _topo_faces(list(recs))
    stats["faces"] += len(faces)
    ctx.check_limit("faces", len(faces), ctx.max_faces)
    index_a = _topo_index_features(feats_a)
    index_b = _topo_index_features(feats_b)
    layers = [(feats_a, index_a), (feats_b, index_b)]
    suspects = []
    for face in faces:
        if not ctx.thick(face):
            stats["ignored_narrow_other"] += 1
            continue
        counts, sample = _topo_classify_face(face, layers)
        if counts is None:
            stats["unresolved_faces"] += 1
            continue
        na, nb = counts
        if na and not nb and TOPO_RULE_NOT_COVERED in rules:
            suspects.append((face, sample, na, nb))
        elif na and nb and TOPO_RULE_OVERLAPS_OTHER in rules:
            suspects.append((face, sample, na, nb))
        elif nb and not na and TOPO_RULE_OTHER_NOT_COVERED in rules:
            suspects.append((face, sample, na, nb))
    ctx.check_limit("regions", len(suspects), ctx.max_regions)
    rows = []
    if suspects:
        for row in _topo_other_rows(suspects, feats_a, index_a, feats_b, index_b, rules,
                                    ctx, stats):
            if row["value"] < ctx.min_area_m2:
                stats["below_min_area"] += 1
            else:
                rows.append(row)
    return rows


def _topo_empty_layer_rows(feats, side, rule, ctx, stats):
    """Rows of ``rule`` when the layer to compare against is empty or all null: each polygon
    of ``feats`` is uncovered as a whole. Only the faces the polygon covers count (its holes
    are faces with no label and are left out); Maximum Error Regions and Minimum Error Area
    apply as on the normal path."""
    work = _topo_copy_layer(feats)
    _topo_index_features(work)
    ctx.check_limit("regions", len(work), ctx.max_regions)
    rows = []
    for f in work:
        faces = _topo_overlay([((side, f["oid"]), f)], ctx, stats)
        fs = [fc for fc, labels, _p in faces if labels]
        if not fs:
            continue
        if side == "A":
            row = _topo_region_row(rule, "INPUT", f["oid"], None, fs, ctx)
        else:
            row = _topo_region_row(rule, "OTHER", None, f["oid"], fs, ctx)
        if row["value"] < ctx.min_area_m2:
            stats["below_min_area"] += 1
            continue
        if side == "A":
            row["detail"] = ("{0} m2 of input feature {1} is not covered by the other "
                             "layer.").format(_topo_fmt(row["value"]), f["oid"])
        else:
            row["detail"] = ("{0} m2 of other feature {1} is not covered by the input "
                             "layer.").format(_topo_fmt(row["value"]), f["oid"])
        rows.append(row)
    return rows


def topo_check(polys, others=None, lines=None, options=None):
    """Run the topology rules.

    ``polys``: input polygons, ``[{"oid", "shape"}]`` with ``shape`` the core rings of
    ``common.geom`` (``None`` for a null geometry). ``others``: the second polygon layer
    (needed by the three "other" rules, and the reference of LINE_OUTSIDE when given).
    ``lines``: line features, ``shape`` a list of paths. ``options``: ``topo_options()``.
    A layer that no selected rule uses is ignored: not prepared and not counted.

    Returns ``{"errors": [row], "stats": {...}, "nulls": {...}, "tolerance_m",
    "grid_m", "rules", "ring_notes"}`` (``ring_notes``: per layer, ``"input"`` and
    ``"other"``, the ObjectIDs whose rings were read by nesting because their ring order is
    not Esri's, and those with an outer ring directly inside another; see
    ``_topo_group_rings``). Every error row has ``rule``, ``layer``, ``oid_a``, ``oid_b``,
    ``value``, ``unit``, ``width``, ``pieces``, ``point`` (layer units), ``rings`` (output
    polygon rings, ``None`` for line rules), ``detail`` and ``severity`` (``SMALL`` for an
    overlap, gap or uncovered region whose area is below ``small_area_m2``, else ``NORMAL``;
    it only labels the row, nothing is dropped).
    """
    opts = options or topo_options()
    rules = set(opts["rules"])
    if TOPO_RULE_SLIVER in rules and not (float(opts["sliver_area_m2"]) > 0
                                          or float(opts["sliver_width_m"]) > 0):
        raise ValueError("SLIVER needs a sliver area or a sliver width above zero")
    if rules & set(TOPO_OTHER_RULES) and others is None:
        raise ValueError("the rules {0} need the other layer".format(
            sorted(rules & set(TOPO_OTHER_RULES))))
    if rules & set(TOPO_LINE_RULES) and lines is None:
        raise ValueError("the line rules need a line layer")
    # R13-1: no refusal for an empty input used as the LINE_OUTSIDE reference (it raised a
    # ValueError that reached the user as a traceback): an empty reference covers nothing, so
    # every line is outside, as for an empty other layer or an all-null input
    # R11-1: a layer no selected rule uses is dropped here, so it is not prepared, counted
    # or used to place the lattice
    if not (rules & set(TOPO_OTHER_RULES) or TOPO_RULE_LINE_OUTSIDE in rules):
        others = None
    if not rules & set(TOPO_LINE_RULES):
        lines = None
    unit_m = float(opts["unit_m"])
    tol_m = _topo_effective_tolerance_m(opts)
    g_units = TOPO_GRID_M / unit_m
    lat = _topo_make_lattice([polys or [], others or [], lines or []], g_units)
    ctx = _TopoCtx(lat, unit_m, tol_m, opts)
    stats = _topo_new_stats()
    feats_a, nulls_a = _topo_prepare_layer(polys or [], lat, "input")
    stats["input_features"] = len(feats_a)
    nulls = {"input": nulls_a, "other": [], "lines": []}
    feats_b = None
    if others is not None:
        feats_b, nulls_b = _topo_prepare_layer(others, lat, "other")
        nulls["other"] = nulls_b
        stats["other_features"] = len(feats_b)
    ring_notes = {"input": _topo_ring_notes(feats_a),
                  "other": _topo_ring_notes(feats_b or [])}
    rows = []
    ctx.say("Preparing the geometry")
    a_rules = rules & set((TOPO_RULE_OVERLAP, TOPO_RULE_GAP))
    o_rules = rules & set(TOPO_OTHER_RULES)
    if a_rules and feats_a:
        ctx.say("Snapping and matching the input boundaries")
        work = _topo_copy_layer(feats_a)
        snap = _topo_snap_layers([work], ctx.radius)
        for key in ("clustered_vertices", "inserted_vertices", "vanished_rings"):
            stats[key] += snap[key]
        stats["input_vanished"] = sum(1 for f in work if not f["parts"])
        ctx.say("Finding overlaps and gaps")
        rows.extend(_topo_phase1_input(work, ctx, a_rules, stats))
    if o_rules and feats_a and feats_b:
        ctx.say("Comparing the input with the other layer")
        wa = _topo_copy_layer(feats_a)
        wb = _topo_copy_layer(feats_b)
        snap = _topo_snap_layers([wa, wb], ctx.radius)
        stats["other_vanished"] = sum(1 for f in wb if not f["parts"])
        rows.extend(_topo_phase1_other(wa, wb, ctx, o_rules, stats))
    elif o_rules and feats_a and not feats_b and TOPO_RULE_NOT_COVERED in o_rules:
        # an empty (or all-null) other layer covers nothing: every input polygon is uncovered
        rows.extend(_topo_empty_layer_rows(feats_a, "A", TOPO_RULE_NOT_COVERED, ctx, stats))
    elif o_rules and feats_b and not feats_a and TOPO_RULE_OTHER_NOT_COVERED in o_rules:
        # an empty (or all-null) input layer covers nothing: every other polygon is uncovered
        rows.extend(_topo_empty_layer_rows(feats_b, "B", TOPO_RULE_OTHER_NOT_COVERED, ctx,
                                           stats))
    if TOPO_RULE_SLIVER in rules:
        ctx.say("Looking for slivers")
        rows.extend(_topo_sliver_rows(feats_a, ctx, opts))
    if rules & set(TOPO_LINE_RULES):
        ctx.say("Checking the lines")
        feats_l, nulls_l = _topo_line_prepare(lines, lat)
        nulls["lines"] = nulls_l
        stats["line_features"] = len(feats_l)
        rows.extend(_topo_line_rows(feats_l, rules, ctx, stats))
        if TOPO_RULE_LINE_OUTSIDE in rules:
            ref = feats_b if feats_b is not None else feats_a
            if ref is not None:
                ref = _topo_copy_layer(ref)
                ref_index = _topo_index_features(ref)
                rows.extend(_topo_line_outside_rows(feats_l, ref, ref_index, ctx))
    rows = [r for r in rows if r["rule"] in rules]
    small = float(opts["small_area_m2"])
    for r in rows:
        r["severity"] = (TOPO_SEVERITY_SMALL if small > 0 and r["rule"] in TOPO_REGION_RULES
                         and r["value"] < small else TOPO_SEVERITY_NORMAL)
    order = dict((r, i) for i, r in enumerate(TOPO_RULES))
    rows.sort(key=lambda r: (order[r["rule"]], -r["value"],
                             -1 if r["oid_a"] is None else r["oid_a"],
                             -1 if r["oid_b"] is None else r["oid_b"]))
    return {"errors": rows, "stats": stats, "nulls": nulls, "tolerance_m": tol_m,
            "grid_m": TOPO_GRID_M, "rules": tuple(r for r in TOPO_RULES if r in rules),
            "ring_notes": ring_notes}


def _topo_ring_notes(feats):
    """``{TOPO_RING_REORDERED: [oid], TOPO_RING_NESTED: [oid]}`` of a prepared layer."""
    out = {TOPO_RING_REORDERED: [], TOPO_RING_NESTED: []}
    for f in feats:
        note = f.get("ring_note")
        if note:
            out[note].append(f["oid"])
    return out


def topo_small_counts(errors):
    """``{rule: number of errors with severity SMALL}`` for the rules that have any."""
    acc = {}
    for r in errors:
        if r.get("severity") == TOPO_SEVERITY_SMALL:
            acc[r["rule"]] = acc.get(r["rule"], 0) + 1
    return acc


def topo_summary(errors):
    """``[(rule, count, total_value, unit, largest)]`` for the rules that have errors."""
    acc = {}
    for r in errors:
        rec = acc.setdefault(r["rule"], [0, 0.0, r["unit"], 0.0])
        rec[0] += 1
        rec[1] += r["value"]
        rec[3] = max(rec[3], r["value"])
    return [(rule, acc[rule][0], acc[rule][1], acc[rule][2], acc[rule][3])
            for rule in TOPO_RULES if rule in acc]


def topo_result_lines(errors):
    """One message line per rule that has errors.

    Area and length rules: ``"<RULE>: N error(s), total T <unit>, largest L <unit>."``.
    LINE_INTERSECT has one row per PAIR of lines (``pieces`` = its crossings, ``value`` = the
    length along which the two lines overlap), so a total length alone would read
    "total 0.0000 m" for lines that only cross: its line counts the pairs, the crossings and
    the overlapping pairs separately.
    """
    lines = []
    for rule, count, total, unit, largest in topo_summary(errors):
        if rule != TOPO_RULE_LINE_INTERSECT:
            lines.append("{0}: {1} error(s), total {2:.4f} {3}, largest {4:.4f} {3}.".format(
                rule, count, total, unit, largest))
            continue
        rows = [r for r in errors if r["rule"] == rule]
        crossings = sum(int(r["pieces"] or 0) for r in rows)
        crossing_pairs = sum(1 for r in rows if r["pieces"])
        overlapping = [r["value"] for r in rows if r["value"] > 0]
        text = ("{0}: {1} error(s), one per pair of lines: {2} pair(s) cross, {3} crossing(s) "
                "in all").format(rule, count, crossing_pairs, crossings)
        if overlapping:
            text += ("; {0} pair(s) overlap along a length, {1:.4f} m in all, the longest "
                     "{2:.4f} m.").format(len(overlapping), sum(overlapping), max(overlapping))
        else:
            text += "; no pair overlaps along a length."
        lines.append(text)
    return lines


# ==========================================================================
# quality/mojibake_core.py
# ==========================================================================
# Pure logic of the Broken Text Encoding Detector tool (no arcpy).
#
# Finds text that was damaged by a wrong character encoding and, where the damage
# is reversible, proposes the original text. Standard library only: no ftfy, no
# chardet, no dictionaries and no statistics from outside this file.
#
# What is looked for (``PATTERN``)
# --------------------------------
# Reversible (a repair is proposed):
#
# * ``UTF8_AS_CP1252``    UTF-8 bytes shown as Western European text (``Ã©`` for
#   é, ``Ø§Ù„Ø±ÙŠØ§Ø¶`` for الرياض, ``â€™`` for ’, ``ï»¿`` BOM). Also the Latin-1 reading,
#   which differs from Windows-1252 only in the bytes 0x80-0x9F.
# * ``UTF8_AS_CP1256``    UTF-8 bytes shown through the Arabic Windows code page
#   (``ط§ظ„ط±ظٹط§ط¶`` for الرياض).
# * ``UTF8_AS_ISO8859_6`` UTF-8 bytes shown through ISO-8859-6 (many C1 controls).
# * ``UTF8_AS_OTHER_CODEPAGE`` UTF-8 bytes shown through a Western or Central European
#   page other than Windows-1252 (ISO-8859-15, Windows-1257, Windows-1250, ISO-8859-2/4/13,
#   DOS and Macintosh pages). Only found when the three main pages also give a reading.
# * ``DOUBLE_ENCODED_UTF8`` the same, applied two to eight times (more than three is never HIGH,
#   rule U13).
# * ``CP1256_AS_CP1252``  Arabic Windows-1256 bytes shown as Western European text
#   (``ÇáÑíÇÖ`` for الرياض).
# * ``ISO8859_6_AS_CP1252`` the same for ISO-8859-6 bytes.
# * ``CP1252_AS_CP1256``  Western European bytes shown through Windows-1256
#   (a token that mixes Latin and Arabic letters, e.g. ``Mنnchen`` for ``Mänchen``).
# * ``CP1254_AS_CP1252``  Turkish Windows-1254 bytes shown as Western European
#   (``Ýstanbul``, ``Þiþli``, ``Kýzýlay``).
#
# Not reversible (detected only, no proposal):
#
# * ``REPLACEMENT_CHAR``  U+FFFD (information was lost when the text was decoded).
# * ``C1_CONTROL``        stray C1 control characters U+0080-U+009F.
# * ``QUESTION_MARKS``    runs of ``?`` where non-ASCII characters were lost.
# * ``MOJIBAKE_UNREPAIRED`` the text has the UTF-8 signature but the decoded text
#   is outside the supported scripts or still not plausible (X1), or UTF-8 shown through
#   Windows-1252/Latin-1 lost some bytes afterwards, for example when a cleaning step removed
#   the C1 controls (X2).
#
# A repair is the reverse transformation done with Python's own codecs: encode the
# damaged text with the code page it was wrongly read as, decode the bytes with the
# code page it really had. The single-byte code pages are used in a "sloppy" way
# (bytes that the code page leaves undefined, and C1 controls, map to the code
# point with the same number) so that text damaged by a Latin-1 reader is also
# covered. A repair is accepted only when
#
# 1. the transformation is valid (the codecs raise no error, UTF-8 is decoded
#    strictly),
# 2. every character of the result is allowed (letters of the supported scripts
#    Latin, Arabic, Greek, Cyrillic, Hebrew, Armenian, Georgian, the Indic scripts, Thai, Lao,
#    Tibetan, Myanmar, Khmer, Ethiopic, Han, kana, Hangul; marks; digits; normal punctuation;
#    a few symbols; the invisible format characters of ordinary text (soft hyphen, ZWSP, ZWNJ,
#    ZWJ, LRM, RLM, ALM, the bidi embeddings, overrides and isolates, word joiner); no controls,
#    no U+FFFD; a combining mark only on a letter of its own script, the general combining
#    diacritics U+0300-U+036F also on Greek and Cyrillic letters; decomposed (NFD) text is
#    counted on its composed form for the evidence, the proposal keeps its characters),
# 3. every word (token) of the result is written in one script, and
# 4. the result is more plausible than the original under the measure below.
#
# ASCII control characters other than white space (NUL padding, SUB, ESC, DEL, FS-US) are set
# aside at the ends of a value and read as word separators inside it before the analysis, and
# the proposal gets them back in their places (``_moj_analyse_with_c0``).
#
# Plausibility measure
# --------------------
# ``implausibility(text)`` = 3 x (control characters, U+FFFD) + 2 x (valid UTF-8
# multi-byte sequences visible in the text when it is encoded with one of the three
# single-byte code pages above) + 2 x (words that mix letters of several scripts) +
# 1 x ("dense" words: two or more letters, all of them non-ASCII Latin-1 letters).
# Lower is more plausible. The UTF-8 family needs ``implausibility(repair) <
# implausibility(original)`` and ``implausibility(repair) == 0``. The Arabic
# single-byte family needs dense words in the original whose repair is entirely
# Arabic. The Turkish rule needs a closed alphabet (ASCII plus Turkish letters).
#
# Confidence (``CONFIDENCE``) is a class given by the rule that produced the
# finding, not a probability. ``MOJIBAKE_RULES`` lists every rule with its class and
# its wording. For a finding with a proposed repair the class says how far the
# proposal can be trusted to restore the original; for a finding without a proposal
# it says how sure the damage is.
#
# "Never a wrong HIGH" (design rule): HIGH is given only when the value
# has exactly one valid, plausible reading. Every value is also read through the second-opinion
# ("shadow") pages ISO-8859-15, Windows-1257, Windows-1250, ISO-8859-2/3/4/10/13/14/16, DOS 850/437/
# 852/775 and Mac Roman/Latin-2, and through chains of the three main pages (up to eight layers, so
# a Windows-1256 pass followed by a Windows-1252 pass is found; a reading of more than three
# layers is at most MEDIUM, U13). A shadow reading counts only when
# its text is clean and passes the same acceptance test as the main reading; it never starts a
# finding. If another page gives different clean text, the finding is MEDIUM (rule U4) or LOW (U6,
# a tie between main pages) and the other reading is named in DETAIL. Two further caps: the
# ISO-8859-6 reading of UTF-8 is at most MEDIUM (U8: a lossy variant of the damage that dropped or
# replaced bytes cannot be told from valid text) and a decoded value that is only digits through an
# Arabic page is at most MEDIUM (U9: a number has no letters to check the reading against). A
# repair that is itself UTF-8 whose last character was cut off (a value encoded more than once and
# then cut to a field width) is at most MEDIUM (U12, ``_moj_cut_layer``).
#
# Limits that remain (documented in docs/tools/MojibakeDetector.md with measured rates): a few
# Mac Roman or DOS 850 readings of rare letters still look like the only reading and stay HIGH (for
# example a combining macron, or g-caron through DOS 850), unsupported scripts are only
# MOJIBAKE_UNREPAIRED, damage that turns Arabic into other valid Arabic (Windows-1256 read as
# ISO-8859-6 without undefined bytes), damage to emoji and symbols, and damage by East Asian legacy
# code pages (GBK, Shift-JIS, EUC-KR) are not looked for, and a double encoding cut so that only
# complete characters remain looks exactly like a single one.
#
# Also in this module: ``mojibake_read_dbf`` and ``mojibake_preflight``, which read
# the header, the ``.cpg`` and the raw text bytes of a dBASE/shapefile attribute file
# (standard library only).

# --------------------------------------------------------------------------
# Names
# --------------------------------------------------------------------------

CHECK_UTF8 = "UTF8_MOJIBAKE"
CHECK_CODEPAGE = "CODEPAGE_SWAP"
CHECK_REPLACEMENT = "REPLACEMENT_CHAR"
CHECK_C1 = "C1_CONTROL"
CHECK_QUESTION = "QUESTION_MARKS"
MOJIBAKE_CHECKS = (CHECK_UTF8, CHECK_CODEPAGE, CHECK_REPLACEMENT, CHECK_C1, CHECK_QUESTION)

PAT_UTF8_CP1252 = "UTF8_AS_CP1252"
PAT_UTF8_CP1256 = "UTF8_AS_CP1256"
PAT_UTF8_ISO = "UTF8_AS_ISO8859_6"
PAT_DOUBLE = "DOUBLE_ENCODED_UTF8"
PAT_UTF8_OTHER = "UTF8_AS_OTHER_CODEPAGE"
PAT_CP1256_AS_1252 = "CP1256_AS_CP1252"
PAT_ISO_AS_1252 = "ISO8859_6_AS_CP1252"
PAT_1252_AS_1256 = "CP1252_AS_CP1256"
PAT_1254_AS_1252 = "CP1254_AS_CP1252"
PAT_REPLACEMENT = "REPLACEMENT_CHAR"
PAT_C1 = "C1_CONTROL"
PAT_QUESTION = "QUESTION_MARKS"
PAT_UNREPAIRED = "MOJIBAKE_UNREPAIRED"
MOJIBAKE_PATTERNS = (PAT_UTF8_CP1252, PAT_UTF8_CP1256, PAT_UTF8_ISO, PAT_UTF8_OTHER, PAT_DOUBLE,
                     PAT_CP1256_AS_1252, PAT_ISO_AS_1252, PAT_1252_AS_1256, PAT_1254_AS_1252,
                     PAT_REPLACEMENT, PAT_C1, PAT_QUESTION, PAT_UNREPAIRED)
_MOJ_PATTERN_CHECK = {
    PAT_UTF8_CP1252: CHECK_UTF8, PAT_UTF8_CP1256: CHECK_UTF8, PAT_UTF8_ISO: CHECK_UTF8,
    PAT_UTF8_OTHER: CHECK_UTF8,
    PAT_DOUBLE: CHECK_UTF8, PAT_UNREPAIRED: CHECK_UTF8,
    PAT_CP1256_AS_1252: CHECK_CODEPAGE, PAT_ISO_AS_1252: CHECK_CODEPAGE,
    PAT_1252_AS_1256: CHECK_CODEPAGE, PAT_1254_AS_1252: CHECK_CODEPAGE,
    PAT_REPLACEMENT: CHECK_REPLACEMENT, PAT_C1: CHECK_C1, PAT_QUESTION: CHECK_QUESTION}

CONF_HIGH = "HIGH"
CONF_MEDIUM = "MEDIUM"
CONF_LOW = "LOW"
MOJIBAKE_CONFIDENCES = (CONF_HIGH, CONF_MEDIUM, CONF_LOW)
_MOJ_CONF_RANK = {CONF_HIGH: 3, CONF_MEDIUM: 2, CONF_LOW: 1}

# rule id -> (confidence, wording). The wording of every rule that occurs is written to the
# Summary of the report (mojibake_rule_rows); the docs list all of them.
MOJIBAKE_RULES = {
    "U1": (CONF_HIGH, "UTF-8 bytes shown through a single-byte code page: the whole value decodes "
                      "strictly as UTF-8, every non-ASCII character is part of a valid multi-byte "
                      "sequence, the result has only allowed characters in single-script words, "
                      "and it holds at least two decoded characters or one inside a word of "
                      "three or more letters (three or more letters when the result is in "
                      "an Indic, South-East Asian or East Asian script), and no other code page "
                      "gives clean, different text (otherwise the rule is U4 or U6)."),
    "U2": (CONF_MEDIUM, "As U1, but the value holds a single decoded character in a short word "
                        "(fewer than three letters), or fewer than three decoded letters of an "
                        "Indic, South-East Asian or East Asian script, or any letter of the rarely "
                        "used Arabic Supplement, Extended-A or presentation-form blocks "
                        "(U+FB50-U+FDFF, U+FE70-U+FEFF, as old CAD and PDF exports store Arabic), "
                        "so there is little context. Also U2: a repair that leaves a Latin "
                        "combining accent that does not compose with its letter, and a value "
                        "whose every damaged-looking sequence is also clean text: a Latin-1 "
                        "capital at the end of an upper-case run, or a capital that is a word on "
                        "its own (not Â or Ã), followed by a typographic sign (HAITÍ…, IRÃ…, "
                        "Å–Moskenes, SKÅ²), or a lower-case à to ï at the end of a word followed "
                        "by two closing signs (Città»–), because that is also clean text with "
                        "upper-case words."),
    "U3": (CONF_MEDIUM, "As U1 for some words of the value; the other non-ASCII words were left "
                        "unchanged (a value that mixes damaged and intact text). A word in "
                        "which damaged characters are glued to Latin letters (kashmir + "
                        "damaged Arabic) is repaired in its non-ASCII part only, so it keeps "
                        "two scripts. When a word left unchanged still decodes as UTF-8 "
                        "through the same code page to text that is refused, no repair is "
                        "proposed (X1)."),
    "U7": (CONF_HIGH, "UTF-8 bytes shown through a single-byte code page two or three times in a "
                      "row (double encoding): every layer decodes strictly, the final text "
                      "passes the checks of U1 and does not decode once more (otherwise the "
                      "rule is U13)."),
    "U4": (CONF_MEDIUM, "The value can be read in more than one way: another code page "
                        "(ISO-8859-15, Baltic, Central European, DOS, ...) or another layer "
                        "also gives valid text and the texts differ, so the bytes do not say "
                        "which one is the original. The most plausible reading is proposed "
                        "(fewer unusual Arabic characters, fewer characters the code page "
                        "could not show, fewer capitals inside words) and the others are "
                        "named in DETAIL. Never HIGH."),
    "U6": (CONF_LOW, "As U4, but two readings through the main code pages are equally "
                     "plausible, so the choice is arbitrary."),
    "U8": (CONF_MEDIUM, "UTF-8 bytes shown through ISO-8859-6. That code page leaves most "
                        "bytes of Arabic UTF-8 undefined, so a tool that made this damage "
                        "either passed those bytes on unchanged (reversible) or dropped or "
                        "replaced them (text that has lost bytes reads as valid, different "
                        "Arabic). The two cases look the same, so it can never be HIGH."),
    "U9": (CONF_MEDIUM, "UTF-8 bytes shown through an Arabic code page that decode to "
                        "Arabic-Indic or Persian digits and number signs only (a postal code, "
                        "a date, a phone number). A letter followed by an Arabic sign is the "
                        "same pair in clean text, so a number is never HIGH through those "
                        "code pages."),
    "U10": (CONF_MEDIUM, "UTF-8 bytes shown through two different single-byte code pages in a row "
                         "(for example Windows-1256 and then Windows-1252). It is rare, and a "
                         "short string of Arabic or Persian letters can look the same by chance, "
                         "so it is never HIGH."),
    "U11": (CONF_MEDIUM, "As U1 or U7, but the case of the text may have been changed after the "
                         "damage (upper, lower, title or swapped case by a cleaning step): the repair "
                         "holds Arabic Quranic annotation marks (U+0656-U+065F, U+06D6-U+06ED, "
                         "not used in names), or the stored text has a uniform case (or a word "
                         "in swapped case, such as 'aMERIKA') and, with "
                         "the case of one of its non-ASCII characters changed, also gives clean, "
                         "different text. Case pairs such as Š/š or Œ/œ "
                         "are one bit apart, so a case change turns one letter into another. "
                         "The most plausible reading is proposed and the others are named in "
                         "DETAIL. Never HIGH."),
    "U12": (CONF_MEDIUM, "As U1 or U7, but the repaired text is itself UTF-8 bytes shown through "
                         "a single-byte code page whose last character is incomplete: the value "
                         "was encoded more than once and then cut (for example to a field width), "
                         "so the next layer cannot be decoded. When the part before the cut "
                         "decodes, it is proposed without the cut character; otherwise no repair "
                         "is proposed. The same holds when the value is cut inside its first "
                         "layer. DETAIL says which. Never HIGH."),
    "U13": (CONF_MEDIUM, "As U7, but the value was encoded four to eight times: after three "
                         "layers the text was still UTF-8 shown through a single-byte code page. "
                         "The text after the last layer that decodes is proposed when it passes "
                         "the checks of U1. Never HIGH."),
    "U5": (CONF_HIGH, "A UTF-8 byte order mark shown as text (\u00ef\u00bb\u00bf) at the start of a "
                      "value whose other characters are ASCII. When other characters are damaged "
                      "too, the rule of the rest applies (U1, U7, ...) and DETAIL names the byte "
                      "order mark. Through Windows-1256 (\u00ef\u00bb + Arabic question mark) "
                      "it is U2 (MEDIUM)."),
    "S1": (CONF_MEDIUM, "Single-byte code page swap (Arabic bytes shown as Western European text): "
                        "every non-ASCII word of the value is a dense run of Latin-1 letters that "
                        "decodes entirely to Arabic letters, and the value has four or more such "
                        "letters, at least one of them a lower-case Latin-1 letter (a run of "
                        "capitals only, such as a Portuguese or French all-caps word, is S2). "
                        "The swap is a one-to-one byte mapping, so the decoded text is "
                        "always valid Arabic; the class can never be HIGH."),
    "S4": (CONF_LOW, "Windows-1256 and ISO-8859-6 both give Arabic and the results differ "
                     "equally; Windows-1256 is proposed and the other result is named in DETAIL."),
    "S2": (CONF_LOW, "As S1, but the value has fewer than four such letters, or other non-ASCII "
                     "words that were not repaired."),
    "S3": (CONF_MEDIUM, "Western European text shown through the Arabic code page: a word of "
                        "at least two ASCII Latin letters with an Arabic letter that touches "
                        "one of them becomes a pure Latin word with no run of three non-ASCII "
                        "letters. A label such as Zone-X + one Arabic letter (a sign or a digit "
                        "in between, or a single Latin letter) is not reported."),
    "T1": (CONF_MEDIUM, "Turkish code page 1254 shown as Western European: two or more of the "
                        "characters \u00dd \u00fd \u00de \u00fe \u00d0 \u00f0, at least one of them not "
                        "\u00fd/\u00dd, no letters that mark Icelandic or Faroese, and a result "
                        "written only in ASCII and Turkish letters."),
    "T2": (CONF_LOW, "As T1 with a single such character, or only \u00fd/\u00dd (Czech, Slovak, "
                     "Turkmen, Faroese and Icelandic words use the same letters)."),
    "F1": (CONF_HIGH, "The value contains U+FFFD, the replacement character. It is never valid "
                      "text; the lost characters cannot be restored."),
    "F2": (CONF_HIGH, "The replacement character itself was damaged: its UTF-8 bytes shown as "
                      "Western European text (the three characters i-diaeresis, inverted "
                      "question mark, one-quarter sign). The lost characters cannot be restored."),
    "C1": (CONF_HIGH, "The value contains C1 control characters (U+0080-U+009F). They are not "
                      "used in text and are what a Latin-1 reader makes of the bytes "
                      "0x80-0x9F. No accepted repair exists."),
    "X1": (CONF_LOW, "The text has the signature of UTF-8 shown through a single-byte code page, "
                     "but the decoded text is outside the supported scripts or not plausible, so "
                     "no repair is proposed. Also X1: a partial repair (U3) whose other words "
                     "still decode that way. A value whose every such pair is an accented capital "
                     "at the end of an upper-case run followed by a typographic sign "
                     "(MALMÖ–LUND, JOSÉ’S PIZZA) is clean text and is not "
                     "reported."),
    "X2": (CONF_LOW, "UTF-8 shown through Windows-1252 or Latin-1 with some bytes removed afterwards "
                     "(for example a cleaning step that deleted the C1 control characters, or a "
                     "reader that dropped the bytes it could not show): every non-ASCII character "
                     "is a UTF-8 lead byte or a continuation byte in its place, at least one "
                     "continuation byte is missing, and a run of non-ASCII characters holds two or "
                     "more lead bytes, one of them still followed by a continuation byte "
                     "(\u00d8\u00a7\u00d9\u00d9\u00d8\u00b1). The removed bytes cannot be "
                     "restored, so no repair is proposed."),
    "Q1": (CONF_MEDIUM, "A word made only of three or more question marks, next to words with "
                        "letters or digits: characters were probably lost on the way, but it "
                        "can also be a placeholder typed by hand (Tel: ???)."),
    "Q2": (CONF_MEDIUM, "Question marks only (three or more), or a word of exactly two question "
                        "marks next to other words. Could also be a hand-typed placeholder."),
    "Q3": (CONF_LOW, "A single question mark inside a word or at the start of a word "
                     "(M?nchen, ?lvaro). A single question mark at the end of a word (Caf?) "
                     "is not reported."),
}


def mojibake_rule_rows(issues):
    """Report rows ``("Rule <id>", "<class>: <wording>")`` for every rule that occurs in
    ``issues``, in the order of ``MOJIBAKE_RULES``; a rule id without wording (none today) is
    listed with its id only."""
    used = set(i["rule"] for i in issues)
    rows = [("Rule " + rule, "{0}: {1}".format(conf, text))
            for rule, (conf, text) in MOJIBAKE_RULES.items() if rule in used]
    rows += [("Rule " + rule, "(no wording)") for rule in sorted(used - set(MOJIBAKE_RULES))]
    return rows

# --------------------------------------------------------------------------
# Sloppy single-byte code pages
# --------------------------------------------------------------------------


def _moj_make_codec(name, c1_passthrough):
    """``(decode table, encode dict, native)`` of a single-byte code page.

    Bytes the code page leaves undefined decode to the code point with the same
    number (Latin-1 behaviour); with ``c1_passthrough`` the C1 controls U+0080 -
    U+009F also encode to the byte of the same number. ``native[byte]`` is true when
    the code page itself defines the character of that byte (a character that only a
    pass-through reader could show is not native).
    """
    table, native = [], []
    for byte in range(256):
        try:
            table.append(bytes([byte]).decode(name))
            native.append(True)
        except UnicodeDecodeError:
            table.append(chr(byte))
            native.append(False)
    encode = {}
    for byte, char in enumerate(table):
        encode.setdefault(char, byte)
    if c1_passthrough:
        for byte in range(0x80, 0xA0):
            encode.setdefault(chr(byte), byte)
    return table, encode, native


_MOJ_CODECS = {
    "cp1252": _moj_make_codec("cp1252", True),
    "cp1256": _moj_make_codec("cp1256", False),
    "iso8859_6": _moj_make_codec("iso8859_6", False),
    "cp1254": _moj_make_codec("cp1254", True),
}

# Code pages that are only used as a second opinion (see ``_moj_analyse_utf8``): UTF-8 read through
# one of them gives a different but equally valid text for many values that also read as
# Windows-1252. They never start a finding and never write a repair into a HIGH finding.
_MOJ_SHADOW_PAGES = (
    ("iso8859_15", "ISO-8859-15 (Latin-9)"), ("cp1257", "Windows-1257 (Baltic)"),
    ("cp1250", "Windows-1250 (Central European)"), ("iso8859_2", "ISO-8859-2"),
    ("iso8859_4", "ISO-8859-4"), ("iso8859_13", "ISO-8859-13"), ("iso8859_14", "ISO-8859-14"),
    ("iso8859_16", "ISO-8859-16"), ("iso8859_3", "ISO-8859-3"), ("iso8859_10", "ISO-8859-10"),
    ("cp850", "DOS code page 850"), ("cp437", "DOS code page 437"), ("cp852", "DOS code page 852"),
    ("cp775", "DOS code page 775"), ("mac_roman", "Mac Roman"), ("mac_latin2", "Mac Central European"))
for _name, _label in _MOJ_SHADOW_PAGES:
    _MOJ_CODECS[_name] = _moj_make_codec(_name, False)
_MOJ_CODEC_LABEL = {"cp1252": "Windows-1252/Latin-1", "cp1256": "Windows-1256",
                    "iso8859_6": "ISO-8859-6"}
_MOJ_CODEC_LABEL.update(dict(_MOJ_SHADOW_PAGES))


def mojibake_encode(text, codec):
    """Bytes of ``text`` in the sloppy single-byte ``codec``; ``None`` if a character has no byte."""
    encode = _MOJ_CODECS[codec][1]
    out = bytearray()
    for char in text:
        byte = encode.get(char)
        if byte is None:
            return None
        out.append(byte)
    return bytes(out)


def mojibake_decode(data, codec):
    """Text of ``data`` in the sloppy single-byte ``codec``."""
    table = _MOJ_CODECS[codec][0]
    return u"".join(table[b] for b in data)


# --------------------------------------------------------------------------
# Character classes
# --------------------------------------------------------------------------

_MOJ_ARABIC_BLOCKS = ((0x0600, 0x06FF), (0x0750, 0x077F), (0x08A0, 0x08FF),
                      (0xFB50, 0xFDFF), (0xFE70, 0xFEFF))
_MOJ_ALLOWED_SYMBOLS = frozenset(u"\u00a2\u00a3\u00a4\u00a5\u00a6\u00a8\u00a9\u00ac\u00ae\u00af"
                                 u"\u00b0\u00b1\u00b4\u00b5\u00b8\u00d7\u00f7\u20ac\u2122")
_MOJ_ALLOWED_LATIN1_PUNCT = frozenset(u"\u00a1\u00a7\u00ab\u00b6\u00b7\u00bb\u00bf")
_MOJ_ALLOWED_OTHER_NUMBERS = frozenset(u"\u00b2\u00b3\u00b9\u00bc\u00bd\u00be")
_MOJ_ORDINALS = frozenset(u"\u00aa\u00ba")
# Only ASCII white space separates words: Latin-1 mojibake contains NBSP (U+00A0) and NEL
# (U+0085), which Python counts as white space but which belong to the damaged word.
_MOJ_SPACES = u" \t\r\n\f\v"
_MOJ_SPLIT = re.compile(u"([ \t\r\n\f\v]+)")
_MOJ_ASCII_PUNCT = u"!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
_MOJ_TURKISH_SIX = u"\u00dd\u00fd\u00de\u00fe\u00d0\u00f0"           # Ý ý Þ þ Ð ð
_MOJ_TURKISH_MAP = dict(zip(_MOJ_TURKISH_SIX, u"\u0130\u0131\u015e\u015f\u011e\u011f"))  # İ ı Ş ş Ğ ğ
_MOJ_TURKISH_LETTERS = frozenset(u"\u00e7\u00c7\u00f6\u00d6\u00fc\u00dc\u00e2\u00c2\u00ee\u00ce"
                                 u"\u00fb\u00db\u0130\u0131\u015e\u015f\u011e\u011f")
_MOJ_BOM = u"\ufeff"
_MOJ_FFFD_AS_TEXT = u"\u00ef\u00bf\u00bd"   # the bytes EF BF BD read as Latin-1
_MOJ_BOM_AS_TEXT = u"\u00ef\u00bb\u00bf"   # the bytes EF BB BF read as Latin-1


def _moj_in_arabic(code):
    for low, high in _MOJ_ARABIC_BLOCKS:
        if low <= code <= high:
            return True
    return False


# Scripts beyond the five core ones (Latin, Arabic, Greek, Cyrillic, Hebrew) that a repair may
# produce. Real place names in the Gulf hold Indic, South-East Asian and East Asian names, and
# UTF-8 text in those scripts is as often damaged as Arabic. Kana, Han and Hangul are separate
# families; a word must stay inside one family.
_MOJ_EXTRA_BLOCKS = (
    (0x0531, 0x058F, "armenian"), (0x0900, 0x097F, "devanagari"), (0x0980, 0x09FF, "bengali"),
    (0x0A00, 0x0A7F, "gurmukhi"), (0x0A80, 0x0AFF, "gujarati"), (0x0B00, 0x0B7F, "oriya"),
    (0x0B80, 0x0BFF, "tamil"), (0x0C00, 0x0C7F, "telugu"), (0x0C80, 0x0CFF, "kannada"),
    (0x0D00, 0x0D7F, "malayalam"), (0x0D80, 0x0DFF, "sinhala"), (0x0E00, 0x0E7F, "thai"),
    (0x0E80, 0x0EFF, "lao"), (0x0F00, 0x0FFF, "tibetan"), (0x1000, 0x109F, "myanmar"),
    (0x10A0, 0x10FF, "georgian"), (0x1100, 0x11FF, "hangul"), (0x1200, 0x139F, "ethiopic"),
    (0x1780, 0x17FF, "khmer"), (0x3040, 0x30FF, "cjk"), (0x3130, 0x318F, "hangul"),
    (0x3400, 0x4DBF, "cjk"), (0x4E00, 0x9FFF, "cjk"), (0xAC00, 0xD7AF, "hangul"),
    (0x20000, 0x2A6DF, "cjk"))
_MOJ_CORE_SCRIPTS = frozenset(["latin", "arabic", "greek", "cyrillic", "hebrew"])


def _moj_extra_script(code):
    for low, high, name in _MOJ_EXTRA_BLOCKS:
        if low <= code <= high:
            return name
    return None


def _moj_letter_script(char):
    """Script family of a letter inside the supported set, else ``None``."""
    code = ord(char)
    if code < 0x80:
        return "latin"
    if 0xC0 <= code <= 0x17F or 0x218 <= code <= 0x21B or code in (0x1A0, 0x1A1, 0x1AF, 0x1B0) \
            or 0x1E00 <= code <= 0x1EFF or 0x1D400 <= code <= 0x1D7FF:
        return "latin"      # (the last two: Vietnamese and the mathematical styled letters)
    if _moj_in_arabic(code):
        return "arabic"
    if 0x370 <= code <= 0x3FF:
        return "greek"
    if 0x400 <= code <= 0x4FF:
        return "cyrillic"
    if 0x5D0 <= code <= 0x5EA:
        return "hebrew"
    return _moj_extra_script(code)


def _moj_mark_script(code):
    """Script family of a combining mark that may appear in a repaired text, else ``None``."""
    if 0x300 <= code <= 0x36F:
        return "latin"
    if _moj_in_arabic(code):
        return "arabic"
    if 0x591 <= code <= 0x5C7:
        return "hebrew"
    return _moj_extra_script(code)


def _moj_exotic_count(text):
    """Letters of ``text`` outside Latin, Arabic, Greek, Cyrillic and Hebrew, or mathematical
    styled letters: a repair into such letters is only trusted with three or more of them."""
    count = 0
    for char in text:
        code = ord(char)
        if code >= 0x900 and unicodedata.category(char)[0] == "L":
            script = _moj_letter_script(char)
            if script is not None and (script not in _MOJ_CORE_SCRIPTS or code >= 0x1D400):
                count += 1
    return count


# Invisible format characters (category Cf) that occur in ordinary text, above all in Arabic
# text exported from Windows or the web: soft hyphen, Arabic letter mark, ZWSP/ZWNJ/ZWJ, LRM/RLM,
# the bidi embeddings and overrides LRE/RLE/PDF/LRO/RLO, word joiner, the bidi isolates
# LRI/RLI/FSI/PDI, and U+FEFF inside a value (zero-width no-break space; a leading one is a
# byte order mark and is dropped). Other Cf characters (Arabic number signs, invisible math
# operators, tags, interlinear annotation) are not allowed.
_MOJ_ALLOWED_FORMAT = frozenset(
    [0xAD, 0x61C, 0x2060, 0xFEFF] + list(range(0x200B, 0x2010)) + list(range(0x202A, 0x202F))
    + list(range(0x2066, 0x206A)))


def _moj_char_allowed(char):
    """Is ``char`` allowed in a repaired text? (rule 2 of the module docstring)"""
    code = ord(char)
    if code < 0x80:
        return char in u"\t\n\r" or 0x20 <= code < 0x7F
    category = unicodedata.category(char)
    kind = category[0]
    if kind == "L":
        return char in _MOJ_ORDINALS or _moj_letter_script(char) is not None
    if kind == "M":
        return _moj_mark_script(code) is not None
    if kind == "N":
        # a digit only of a script that is allowed (a random Arabic pair can decode to a digit of
        # an unsupported script, e.g. U+1A98)
        return char in _MOJ_ALLOWED_OTHER_NUMBERS or (
            category == "Nd" and (_moj_in_arabic(code) or _moj_extra_script(code) is not None
                                  or 0x1D7CE <= code <= 0x1D7FF or 0xFF10 <= code <= 0xFF19))
    if kind == "Z":
        return category == "Zs"
    if kind == "P":
        return (char in _MOJ_ALLOWED_LATIN1_PUNCT or 0x2010 <= code <= 0x2027
                or 0x2030 <= code <= 0x205E or _moj_in_arabic(code)
                or code in (0x5BE, 0x5C0, 0x5C3, 0x5C6, 0x5F3, 0x5F4))     # Hebrew maqaf, paseq, geresh
    if kind == "S":
        return char in _MOJ_ALLOWED_SYMBOLS
    if category == "Cf":
        return code in _MOJ_ALLOWED_FORMAT
    return False


def _moj_is_c1(char):
    return u"\u0080" <= char <= u"\u009f"


def _moj_is_control(char):
    return unicodedata.category(char) in ("Cc", "Co", "Cs", "Cn") and char not in u"\t\n\r"


def _moj_tokens(text):
    """Letter-based words of ``text``: list of lists of letters (marks and digits stay inside)."""
    words, current = [], []
    for char in text:
        kind = unicodedata.category(char)[0]
        if kind == "L":
            current.append(char)
        elif kind == "M" or unicodedata.category(char) == "Nd":
            continue
        else:
            if current:
                words.append(current)
                current = []
    if current:
        words.append(current)
    return words


def _moj_mixed_word_count(text):
    """Words that mix letters of more than one script (ASCII Latin and Latin-1 are one script)."""
    count = 0
    for word in _moj_tokens(text):
        scripts = set(_moj_letter_script(c) or "other:" + c for c in word)
        if len(scripts) > 1:
            count += 1
    return count


def _moj_dense_word_count(text):
    """Words of two or more letters that are all non-ASCII Latin-1 letters (U+00C0-U+00FF)."""
    count = 0
    for word in _moj_tokens(text):
        if len(word) >= 2 and all(u"\u00c0" <= c <= u"\u00ff" for c in word):
            count += 1
    return count


# A valid UTF-8 multi-byte sequence (RFC 3629 / Unicode table 3-7): 2 bytes C2-DF 80-BF;
# 3 bytes E0 A0-BF 80-BF, E1-EC / EE-EF 80-BF 80-BF, ED 80-9F 80-BF; 4 bytes F0 90-BF 80-BF
# 80-BF, F1-F3 80-BF x3, F4 80-8F 80-BF 80-BF.
_MOJ_UTF8_SEQ = re.compile(
    b"[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee\xef][\x80-\xbf]{2}|"
    b"\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf]{2}|"
    b"[\xf1-\xf3][\x80-\xbf]{3}|\xf4[\x80-\x8f][\x80-\xbf]{2}")


_MOJ_READINGS = ("cp1252", "cp1256", "iso8859_6")


def _moj_utf8_sequences(text, readings=_MOJ_READINGS):
    """Largest number of valid UTF-8 multi-byte sequences in ``text`` when it is encoded with
    one of the single-byte code pages ``readings``."""
    best = 0
    if text.isascii():
        return 0
    for codec in readings:
        data = mojibake_encode(text, codec)
        if data is not None:
            best = max(best, len(_MOJ_UTF8_SEQ.findall(data)))
    return best


def mojibake_implausibility(text, readings=_MOJ_READINGS):
    """The documented plausibility measure (lower is more plausible); see the module docstring.

    ``readings`` are the code pages through which UTF-8 sequences are counted: all three for
    a text that may be damaged; only ``("cp1252",)`` for a repaired text, because Arabic text
    legitimately holds letter + punctuation pairs (such as a letter followed by the Arabic
    comma) that look like sequences through the other two.
    """
    controls = sum(1 for c in text if _moj_is_control(c) or c == u"\ufffd")
    return (3 * controls + 2 * _moj_utf8_sequences(text, readings)
            + 2 * _moj_mixed_word_count(text) + _moj_dense_word_count(text))


def _moj_tashkeel_count(text):
    return sum(1 for c in text if unicodedata.category(c) == "Mn" and _moj_in_arabic(ord(c)))


# Arabic-Indic and Persian digits and the Arabic signs that stand between digits of a number
# (comma, semicolon, percent sign, decimal and thousands separators).
_MOJ_ARABIC_DIGITS = frozenset(u"\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669"
                               u"\u06f0\u06f1\u06f2\u06f3\u06f4\u06f5\u06f6\u06f7\u06f8\u06f9")
_MOJ_ARABIC_NUMBER_SIGNS = frozenset(u"\u060c\u061b\u066a\u066b\u066c")


def _moj_digits_only_nonascii(text):
    """Is every non-ASCII character of ``text`` an Arabic-Indic or Persian digit or a sign
    of a number, with at least one digit? (A postal code, a date, a phone number.)"""
    digits = 0
    for char in text:
        if ord(char) < 0x80:
            continue
        if char in _MOJ_ARABIC_DIGITS:
            digits += 1
        elif char not in _MOJ_ARABIC_NUMBER_SIGNS:
            return False
    return digits > 0


def _moj_arabic_oddity(text):
    """Tie-break between two Arabic readings of the same bytes: the number of Arabic-block
    characters that are unusual in a name (digits, extended Persian/Urdu letters, symbols)
    plus the vowel marks (tashkeel). The reading with fewer is the more plausible one.
    A text whose non-ASCII characters are all digits and number signs is a number, and digits
    are not unusual in a number."""
    if _moj_digits_only_nonascii(text):
        return 0
    odd = 0
    for char in text:
        code = ord(char)
        if not _moj_in_arabic(code):
            continue
        if 0x621 <= code <= 0x64A or code == 0x640:
            continue
        odd += 1
    return odd


def _moj_case_oddity(text):
    """Words with an upper-case letter after the first letter and a lower-case letter
    (a capital I-grave inside ``Mller``): the reading that makes fewer of them is the more
    plausible one. Only used to choose between two readings, never to accept one."""
    odd = 0
    for word in _moj_tokens(text):
        if len(word) >= 2 and any(c.isupper() for c in word[1:]) and any(c.islower() for c in word):
            odd += 1
    return odd


def _moj_undefined_count(text, codec):
    """Characters of ``text`` that a real reader of ``codec`` could not have shown: the
    code page leaves their byte undefined, or they are C1 controls passed through."""
    table, encode, native = _MOJ_CODECS[codec]
    if codec == "cp1252":
        return 0        # Windows and Latin-1 readers show the five undefined bytes as C1 controls
    count = 0
    for char in text:
        byte = encode.get(char)
        if byte is not None and ord(char) > 0x7F and (not native[byte] or table[byte] != char):
            count += 1
    return count


_MOJ_INHERITED_BASES = frozenset(["greek", "cyrillic"])


def _moj_nfc(text):
    """``text`` in Unicode normalisation form C. Decomposed (NFD) text, as macOS and some exports
    write it, holds a base letter + a combining accent where composed text has one letter; the
    evidence counts (decoded letters, words of three letters) are made on the composed form so
    that both forms of the same name get the same finding. The proposal itself is never
    normalised: the copy gets back exactly the characters that were damaged."""
    return unicodedata.normalize("NFC", text)


def _moj_text_allowed(text):
    """Every character is allowed and every combining mark sits on a letter of its own script
    (a Latin accent on a Latin letter, an Arabic mark on an Arabic letter, a Hebrew point on a
    Hebrew letter, a vowel sign on a letter of the same Indic script): a stray accent behind an
    Arabic letter is what a wrong decoding makes. The general combining diacritics
    (U+0300-U+036F, Unicode script Inherited) may also sit on a Greek or Cyrillic letter: that
    is how decomposed (NFD) text writes the Greek tonos and dialytika and the Cyrillic short-i
    breve, diaeresis and stress accent."""
    base = None
    for char in text:
        if not _moj_char_allowed(char):
            return False
        category = unicodedata.category(char)
        if category[0] == "M":
            code = ord(char)
            mark = _moj_mark_script(code)
            if base != mark and not (mark == "latin" and base in _MOJ_INHERITED_BASES):
                return False
        else:
            base = _moj_letter_script(char) if category[0] == "L" else None
    return True


# --------------------------------------------------------------------------
# UTF-8 family
# --------------------------------------------------------------------------

_MOJ_UTF8_CODECS = (("cp1252", PAT_UTF8_CP1252), ("cp1256", PAT_UTF8_CP1256),
                    ("iso8859_6", PAT_UTF8_ISO))
_MOJ_MAIN_CODECS = tuple(c for c, _p in _MOJ_UTF8_CODECS)
_MOJ_PATTERN_OF = dict(_MOJ_UTF8_CODECS)
_MOJ_MAX_LAYERS = 3      # layers a HIGH repair may peel (U7)
_MOJ_CHAIN_LAYERS = 8    # layers the chains look for; more than _MOJ_MAX_LAYERS is rule U13


def _moj_peel_run(text, codec, max_layers=_MOJ_MAX_LAYERS):
    """Decode ``text`` as UTF-8 bytes seen through ``codec``, repeatedly (at most
    ``max_layers`` layers). Returns ``(result, layers, undefined)``: ``layers`` is 0 when
    the text is not valid, ``undefined`` counts the characters a real reader of ``codec``
    could not have shown (see ``_moj_undefined_count``)."""
    current, layers, undefined = text, 0, 0
    while layers < max_layers:
        if current.isascii():
            break
        data = mojibake_encode(current, codec)
        if data is None:
            break
        try:
            decoded = data.decode("utf-8")
        except UnicodeDecodeError:
            break
        if decoded == current:
            break
        undefined += _moj_undefined_count(current, codec)
        current = decoded
        layers += 1
    return current, layers, undefined


def _moj_peel(text, codec):
    """``(result, layers)`` of ``_moj_peel_run``; ``layers`` is 0 when the text is not valid."""
    result, layers, _undefined = _moj_peel_run(text, codec)
    return result, layers


def _moj_chains(text):
    """Every way to decode ``text`` as UTF-8 bytes seen through the three main code pages, one
    code page after the other (a text that was damaged by Windows-1256 and again by
    Windows-1252 needs two different ones). Each run of one code page is peeled as far as it
    goes, up to ``_MOJ_CHAIN_LAYERS`` layers in all: a reading of more than ``_MOJ_MAX_LAYERS``
    layers is never HIGH (rule U13), but without it the best reading of a value encoded four
    times or more was an early layer that still held mojibake. Returns ``[(result, chain, undefined)]``; ``chain`` has one code page per layer."""
    out = []

    def walk(current, last, chain, undefined):
        left = _MOJ_CHAIN_LAYERS - len(chain)
        if left <= 0 or current.isascii():
            return
        for codec in _MOJ_MAIN_CODECS:
            if codec == last:
                continue
            result, layers, undef = _moj_peel_run(current, codec, left)
            if not layers:
                continue
            found = chain + (codec,) * layers
            out.append((result, found, undefined + undef))
            walk(result, codec, found, undefined + undef)

    walk(text, None, (), 0)
    return out


def _moj_nonascii(text):
    return sum(1 for c in text if ord(c) > 0x7F)


def _moj_word_letter_count(text, index):
    """Letter count of the whitespace-delimited word that contains position ``index``."""
    start = index
    while start > 0 and text[start - 1] not in _MOJ_SPACES:
        start -= 1
    end = index
    while end < len(text) and text[end] not in _MOJ_SPACES:
        end += 1
    return sum(1 for c in text[start:end] if unicodedata.category(c)[0] == "L")


def _moj_format_only_in_latin(original, text):
    """Is every non-ASCII character of the repair an invisible format character (bidi controls,
    ALM, ZWJ, soft hyphen, word joiner, ...) in a value with ASCII letters? Through the Arabic
    code pages their UTF-8 bytes show as ``\u00e2\u20ac`` + one character, Tah + oe, or
    alef-madda + soft hyphen inside Latin letters: not clean Arabic, so the repair is not a clean
    pair that decoded to a sign. It has no decoded letter, so it is at most U2."""
    nonascii = [c for c in text if ord(c) > 0x7F]
    return bool(nonascii) and all(ord(c) in _MOJ_ALLOWED_FORMAT for c in nonascii) \
        and any(c.isascii() and c.isalpha() for c in original)


def _moj_foreign_core_count(text):
    """Greek, Cyrillic and Hebrew letters of ``text`` (composed form). Through an Arabic code page
    a reading without Arabic letters is accepted when it has three or more of them (or three
    exotic letters, ``_moj_exotic_count``); it is then at most MEDIUM (U2): a clean Arabic letter
    followed by a Persian letter or a sign can decode to one such letter."""
    return sum(1 for c in _moj_nfc(text) if unicodedata.category(c)[0] == "L"
               and _moj_letter_script(c) in ("greek", "cyrillic", "hebrew"))


def _moj_utf8_accept(original, repaired, codec="cp1252"):
    """Rules 2-4 of the module docstring for a UTF-8 repair; returns the text (without a
    leading byte order mark) or ``None``.

    Through the Arabic code pages the letters U+00C2/U+00C3 of the Western reading are the
    Arabic letters alef-madda/alef-hamza, which may be followed by extended Arabic letters
    in clean text. So a repair through those code pages that has no Arabic character is only
    accepted when the original also holds ASCII letters (``Cafأ©``: Western text on an Arabic
    system). Through those code pages a repair must also decode to at least one non-ASCII
    letter (a clean pair such as a tah followed by an extended Arabic letter decodes to a
    symbol)."""
    text = repaired[1:] if repaired.startswith(_MOJ_BOM) else repaired
    if not _moj_text_allowed(text):
        return None
    if codec != "cp1252":
        # (on the composed form: a decomposed ``Cafe`` + U+0301 decoded the letter e-acute)
        if not any(ord(c) > 0x7F and unicodedata.category(c)[0] == "L" for c in _moj_nfc(text)) \
                and not _moj_digits_only_nonascii(text) \
                and not _moj_format_only_in_latin(original, text) \
                and not (repaired.startswith(_MOJ_BOM) and text.isascii() and text.strip()):
            return None     # only symbols or marks came out: clean extended Arabic letters
        if not any(_moj_in_arabic(ord(c)) for c in text) \
                and not any(c.isascii() and c.isalpha() for c in original) \
                and _moj_exotic_count(text) < 3 and _moj_foreign_core_count(text) < 3:
            return None
    if mojibake_implausibility(text, ("cp1252",)) != 0:
        return None
    if not mojibake_implausibility(original) > 0:
        return None
    return text


def _moj_stray_latin_mark(text):
    """Does ``text`` keep a general combining accent (U+0300-U+036F) on a Latin letter after NFC
    composition? Decomposed (NFD) text is made by splitting composed letters, so every accent of
    real NFD Latin text composes again; an accent that stays loose (``HAIT`` + U+0345, ``MAL`` +
    U+0352 + ``S``) is what clean upper-case text with Í or Ì before a typographic sign
    (``HAITÍ…``, ``MALÍ’S``) decodes to. Only an accent on an ASCII letter counts: Yoruba writes
    an acute on a letter with a dot below (``ẹ́``), which has no composed form, and the Cyrillic
    stress accent has none either."""
    base = False
    for char in _moj_nfc(text):
        kind = unicodedata.category(char)[0]
        if kind == "M":
            if 0x300 <= ord(char) <= 0x36F and base:
                return True
        else:
            base = kind == "L" and char.isascii()
    return False


# Signs that join two words without a space in clean text (SKÅ–BAR, MALÍ’S, Å–Moskenes): dashes,
# the right single quotation mark (the typographic apostrophe), the bullet, the middle dot, the
# ellipsis and the soft hyphen (an invisible hyphenation point inside a word).
_MOJ_JOIN_SIGNS = frozenset(u"‐‑‒–—―’•·…\u00ad")
# The soft hyphen: a hyphenation point, the word goes on in any case (Å + SHY + land).
_MOJ_INNER_SPACES = frozenset(u"\u00ad")
# The no-break space: a space, so the next word may start with a capital (Å + NBSP + MOSKENES). A
# lower-case word of two letters or more after a one-letter word is read as damage: Å + NBSP is
# the UTF-8 of Š, and Škoda, Šibenik, Šid or Što are far more common than the one-letter word Å
# bound to a lower-case word (Å + NBSP + og Moskenes), which keeps a wrong HIGH (a documented
# limit; Å + NBSP + i is MEDIUM anyway, one decoded letter in a short word).
_MOJ_NBSP = u"\u00a0"
# Signs after which the one-letter word Å may be followed by a lower-case word (Å–moskenes,
# Å·kirke): the dashes, the bullet and the middle dot. Å + these is the UTF-8 of Ŗ, ŗ, ŕ and ŷ,
# which do not start words in current Latvian, Slovak or Welsh place names. Not the apostrophe
# (Å’ is Œ: Œuvre, Œuilly) nor the ellipsis (Å… is Ņ: Ņujorka) nor the no-break space (Š).
_MOJ_DASH_JOINS = frozenset(u"‐‑‒–—―•·")
# Â and Ã are no words on their own, and Ã + sign is the commonest damage of a Latin-1 capital
# (Ã–STERREICH for ÖSTERREICH, Ã… i Lofoten for Å i Lofoten): a capital that is a word on its own
# is read as clean text, except these two.
_MOJ_NOT_WORDS = frozenset(u"ÂÃ")


def _moj_caps_sign_pair(text, start, decoded):
    """Is the two-byte UTF-8 sequence at ``text[start:start + 2]`` (one character per byte), which
    decodes to ``decoded``, also clean upper-case text: a Latin-1 capital at the end of a run of
    letters with no lower-case letter, or a capital that is a word on its own, followed by a sign
    that is not a letter (``HYVÄ…``, ``IRÃ”``, ``SKÅ–BAR``, ``Å–Moskenes``, ``SKÅ²``)? The capitals
    Â to Þ are the UTF-8 lead bytes C2 to DE, and the Windows-1252 signs … ’ ” ™ ® • – — ° ², the
    no-break space, the soft hyphen and the ordinal indicators ª º are continuation bytes, so such
    clean text is valid UTF-8.

    A capital that is a whole word (no letter before it) counts too, except Â and Ã
    (``_MOJ_NOT_WORDS``: ``Ã–STERREICH`` stays the damage of ``ÖSTERREICH``), and only when the
    character before it is not a non-ASCII sign and the letters after the sign are ASCII (``Î•Î»Î»``
    is the damage of Greek, not a one-letter word).

    What may follow the sign:

    * nothing, a space, a digit or another sign: always clean;
    * after a soft hyphen: any letters (a hyphenation point: ``Å`` + SHY + ``land``);
    * after a no-break space or a sign that joins words (``_MOJ_JOIN_SIGNS``): a word that starts
      with a capital (``Å–MOSKENES``, ``Å–Moskenes``, ``IRMÃ–Maria``, ``Å`` + NBSP + ``MOSKENES``),
      or ``s`` after the apostrophe (``Å’s``); a lower-case word when two capitals or more come
      before the capital (``SKÅ–bar``, ``IRMÃ–maria``), or when the capital is the one-letter word
      ``Å`` and the sign a dash, the bullet or the middle dot (``Å–moskenes``,
      ``_MOJ_DASH_JOINS``); any other lower-case continuation is damage (S + ``Ä…`` + junga:
      ``Sąjunga``; ``Å`` + NBSP + ``koda``: ``Škoda``; ``Å’uvre``: ``Œuvre``);
    * after another sign: capitals only, and only when the decoded letter is a lower-case letter
      among capitals (``SKÅ™S`` would decode to ``SKřS``); otherwise the pair is the damage of a
      capital inside a word (``DÄ°YARBAKIR``, ``CÃ”TE``)."""
    lead, sign = text[start], text[start + 1]
    if not (u"\u00c0" <= lead <= u"\u00de" and unicodedata.category(lead) == "Lu"):
        return False
    if unicodedata.category(sign)[0] not in "PSZ" and unicodedata.category(sign) != "No" \
            and sign not in _MOJ_ORDINALS and sign not in _MOJ_JOIN_SIGNS:
        return False            # (the soft hyphen is a format character, Cf)
    before, index = 0, start - 1
    while index >= 0 and unicodedata.category(text[index])[0] in "LM":
        if text[index].islower():
            return False
        before += unicodedata.category(text[index])[0] == "L"
        index -= 1
    if not before and (lead in _MOJ_NOT_WORDS or (index >= 0 and ord(text[index]) > 0x7F)):
        return False            # Ã or Â alone is no word (Ã–STERREICH is damage), and a capital
        #                         after a non-ASCII sign is inside a run of mojibake (Î•Î»Î»Î¬)
    end = start + 2
    while end < len(text) and unicodedata.category(text[end])[0] in "LM":
        end += 1
    rest = text[start + 2:end]
    if not before and not rest.isascii():
        return False            # a one-letter word followed by more mojibake (Î•Î»: Greek)
    if not rest or sign in _MOJ_INNER_SPACES:
        return True             # a space, or a hyphenation point inside the word: any letters
    if sign in _MOJ_JOIN_SIGNS or sign == _MOJ_NBSP:
        if sign == u"\u2019" and rest in (u"s", u"S"):
            return True         # the possessive: Å’s, MALMÖ’S
        if rest[0].isupper():
            return True         # the next word (MOSKENES, Moskenes)
        if before >= 2:
            return True         # two capitals or more, then lower case: SKÅ–bar, IRMÃ–maria (one
            #                     capital is the damage of a capitalised word: S + Ä… + junga)
        return not before and lead == u"\u00c5" and sign in _MOJ_DASH_JOINS   # Å–moskenes
    if any(c.islower() for c in rest):
        return False
    return decoded.islower()


# Signs that can stand two in a row after the last letter of a word in clean text (``città»–``,
# ``café…”``, ``à`` + NBSP + ``»``): closing quotation marks, the ellipsis, dashes, the bullet,
# the middle dot, trade mark and registered signs, the degree sign, superscript digits, daggers,
# the no-break space and the soft hyphen. All are continuation bytes in Windows-1252.
_MOJ_TAIL_SIGNS = frozenset(u"’”»›…–—•·™®"
                            u"°¹²³†‡\u00a0\u00ad")


def _moj_lower_signs_triple(text, start):
    """Is the three-byte UTF-8 sequence at ``text[start:start + 3]`` also clean text: a lower-case
    Latin-1 letter à to ï (the UTF-8 lead bytes E0 to EF) that ends a word, followed by two signs
    of ``_MOJ_TAIL_SIGNS`` (``«città»–``, ``Café…”``)? What may follow the second sign is ruled as
    in ``_moj_caps_sign_pair``: nothing or a non-letter; any letters after a soft hyphen; after a
    no-break space or a sign that joins words, a word that starts with a capital or ``s`` after
    the apostrophe. A lower-case continuation is damage (``Viá»‡t`` for ``Việt``), and so is a
    triple after a non-ASCII sign or before non-ASCII letters (more mojibake)."""
    lead, first, second = text[start:start + 3]
    if not (u"\u00e0" <= lead <= u"\u00ef") or first not in _MOJ_TAIL_SIGNS \
            or second not in _MOJ_TAIL_SIGNS:
        return False
    end = start + 3
    while end < len(text) and unicodedata.category(text[end])[0] in "LM":
        end += 1
    rest = text[start + 3:end]
    if (start and not text[start - 1].isalpha() and ord(text[start - 1]) > 0x7F) \
            or not rest.isascii():
        return False            # inside a run of mojibake, not a clean word end
    if not rest or second in _MOJ_INNER_SPACES:
        return True
    if second in _MOJ_JOIN_SIGNS or second == _MOJ_NBSP:
        if second == u"\u2019" and rest in (u"s", u"S"):
            return True
        return rest[0].isupper()
    return False


def _moj_caps_signs_only(original, codec):
    """Is every UTF-8 sequence of ``original`` through ``codec`` a pair of
    ``_moj_caps_sign_pair`` or a triple of ``_moj_lower_signs_triple``? Then the stored text reads
    as clean text with typographic signs after an accented letter as well, and the repair is at
    most U2."""
    data = mojibake_encode(original, codec) if codec in _MOJ_CODECS else None
    if data is None or len(data) != len(original):
        return False
    found = False
    for match in _MOJ_UTF8_SEQ.finditer(data):
        size = match.end() - match.start()
        if size == 2 and _moj_caps_sign_pair(original, match.start(),
                                             match.group(0).decode("utf-8")):
            found = True
        elif size == 3 and _moj_lower_signs_triple(original, match.start()):
            found = True
        else:
            return False
    return found


def _moj_utf8_confidence(original, repaired, partial, layers=1, codec="cp1252", first=None):
    """``(confidence, rule)`` of an accepted UTF-8 repair. ``first`` is the code page of the
    first layer (default ``codec``)."""
    if partial:
        return CONF_MEDIUM, "U3"
    if codec == "iso8859_6":
        return CONF_MEDIUM, "U8"    # ISO-8859-6 leaves most bytes of Arabic UTF-8 undefined: see U8
    if _moj_stray_latin_mark(repaired):
        return CONF_MEDIUM, "U2"    # a loose Latin accent: clean capitals + a sign (HAITÍ…)
    if _moj_caps_signs_only(original[1:] if original.startswith(_MOJ_BOM) else original,
                            first or codec):
        return CONF_MEDIUM, "U2"    # also clean upper-case text with typographic signs (IRÃ…)
    exotic = _moj_exotic_count(repaired)
    if 0 < exotic < 3:
        return CONF_MEDIUM, "U2"    # little evidence for a script outside the five core ones
    if any(unicodedata.category(c)[0] == "L" and (0x750 <= ord(c) <= 0x77F or 0x8A0 <= ord(c) <= 0x8FF
                                                  or 0xFB50 <= ord(c) <= 0xFDFF or 0xFE70 <= ord(c) <= 0xFEFF)
           for c in repaired):
        return CONF_MEDIUM, "U2"    # letters of the rarely used Arabic Supplement / Extended / form blocks
    if codec != "cp1252" and _moj_digits_only_nonascii(repaired):
        return CONF_MEDIUM, "U9"    # a number through an Arabic code page: see U9
    if codec != "cp1252" and layers == 1 and exotic == 0 \
            and not any(_moj_in_arabic(ord(c)) for c in repaired) \
            and not any(c.isascii() and c.isalpha() for c in original):
        return CONF_MEDIUM, "U2"    # Greek, Cyrillic or Hebrew alone through an Arabic page
    high = "U7" if layers >= 2 else "U1"    # U7 needs the same evidence as U1
    repaired = _moj_nfc(repaired)           # decomposed text: count the composed letters
    decoded = _moj_nonascii(repaired)
    if codec != "cp1252":
        # through the Arabic code pages a letter followed by a Persian letter or an Arabic sign
        # is a clean pair that decodes to a sign or a digit: only decoded letters count
        decoded = sum(1 for c in repaired if ord(c) > 0x7F and unicodedata.category(c)[0] == "L")
    if decoded == 0 and original.startswith(_MOJ_BOM_AS_TEXT):
        return CONF_HIGH, "U5"
    if decoded >= (2 if codec == "cp1252" else 3):
        return CONF_HIGH, high
    for index, char in enumerate(repaired):
        if ord(char) > 0x7F and (codec == "cp1252" or unicodedata.category(char)[0] == "L") \
                and _moj_word_letter_count(repaired, index) >= 3:
            return CONF_HIGH, high
    return CONF_MEDIUM, "U2"


_MOJ_NONASCII_RUN = re.compile(u"([^\x00-\x7f]+)")


def _moj_glued_run_repair(part, codec):
    """Repair of a word in which a damaged non-ASCII run is glued to ASCII letters
    (``kashmir`` + Windows-1256 mojibake of Arabic letters): ``(text, layers, runs left)`` or
    ``None``. Each run of non-ASCII characters is peeled on its own (UTF-8 continuation bytes are
    never ASCII, so the damage of one character never spans an ASCII character) and must pass the
    acceptance test of ``_moj_utf8_accept`` and the evidence of U1: at least two decoded characters
    through Windows-1252/Latin-1, at least three decoded letters through the Arabic code pages
    (a clean Arabic letter pair can decode to one character by chance). ``runs left`` are the
    non-ASCII runs that were not repaired. The word then holds two scripts, as the source did;
    the finding is U3 (MEDIUM)."""
    if not any(c.isascii() and c.isalpha() for c in part):
        return None
    pieces = _MOJ_NONASCII_RUN.split(part)
    out, left, layers_max, changed = [], [], 0, 0
    for piece in pieces:
        if not piece or piece.isascii():
            out.append(piece)
            continue
        result, layers, _undefined = _moj_peel_run(piece, codec, _MOJ_CHAIN_LAYERS)
        accepted = _moj_utf8_accept(part, result, codec) if layers else None
        if accepted is not None and accepted == result:
            letters = sum(1 for c in _moj_nfc(result)
                          if ord(c) > 0x7F and unicodedata.category(c)[0] == "L")
            enough = _moj_nonascii(_moj_nfc(result)) >= 2 if codec == "cp1252" else letters >= 3
            if enough:
                out.append(result)
                layers_max = max(layers_max, layers)
                changed += 1
                continue
        out.append(piece)
        left.append(piece)
    if not changed:
        return None
    return u"".join(out), layers_max, left


def _moj_still_utf8(run, codec, glued=False):
    """Does a non-ASCII run that a partial repair left unchanged still decode strictly as UTF-8
    through ``codec``? Then the repair would keep mojibake (the run was refused for its script or
    its plausibility, not because it is clean), so no repair is proposed (rule X1). Through the
    Arabic code pages one decoded character is not counted in a word of its own (a clean two-letter
    Arabic word can be valid UTF-8 through Windows-1256 by chance); it is counted in a run glued to
    ASCII letters (``glued``), which is no clean word either way."""
    data = mojibake_encode(run, codec)
    if data is None:
        return False
    try:
        decoded = data.decode("utf-8")
    except UnicodeDecodeError:
        return False
    return decoded != run and len(decoded) >= (1 if codec == "cp1252" or glued else 2)


def _moj_utf8_partial(text):
    """Repair the words that are damaged and keep the others:
    ``(codec, pattern, result, layers, glued, residue)``. ``glued`` counts the words whose damaged
    run was glued to ASCII letters and was repaired on its own (``_moj_glued_run_repair``);
    ``residue`` counts the non-ASCII runs left unchanged that still decode as UTF-8 through the
    code page (``_moj_still_utf8``): when it is not 0 the caller proposes no repair."""
    parts = _MOJ_SPLIT.split(text)
    best = None
    for codec, pattern in _MOJ_UTF8_CODECS:
        out, layers_max, changed, glued, left = [], 0, 0, 0, []
        for index, part in enumerate(parts):
            if not part or part.isascii():
                out.append(part)
                continue
            result, layers, _undefined = _moj_peel_run(part, codec, _MOJ_CHAIN_LAYERS)
            if layers:
                accepted = _moj_utf8_accept(part, result, codec)
                if accepted is not None and index and result.startswith(_MOJ_BOM):
                    accepted = result   # U+FEFF inside the value is kept (only a leading one is a BOM)
                if accepted is not None:
                    out.append(accepted)
                    layers_max = max(layers_max, layers)
                    changed += 1
                    continue
            split = _moj_glued_run_repair(part, codec)
            if split is not None:
                out.append(split[0])
                layers_max = max(layers_max, split[1])
                changed += 1
                glued += 1
                left.extend((part, run, True) for run in split[2])
                continue
            out.append(part)
            glued_part = any(c.isascii() and c.isalpha() for c in part)
            left.extend((part, run, glued_part) for run in _MOJ_NONASCII_RUN.findall(part))
        if changed:
            # (a clean upper-case word with a typographic sign after an accented capital,
            # MALMÖ–LUND, also decodes: it is not residue, see _moj_caps_signs_only)
            residue = sum(1 for word, run, glue in left if _moj_still_utf8(run, codec, glue)
                          and not _moj_caps_signs_only(word, codec))
            candidate = (codec, PAT_DOUBLE if layers_max >= 2 else pattern, u"".join(out),
                         layers_max, glued, residue)
            if best is None:
                best = candidate
    return best


def _moj_clean_reading(text, allow_combining=True):
    """Is ``text`` a text that could stand on its own: assigned characters, no controls, at
    least one non-ASCII letter, digit, punctuation mark, symbol or mark, and no UTF-8 sequence
    left in it (that would be mojibake again)? Used for the second opinions of
    ``_moj_analyse_utf8``. With ``allow_combining`` false, Latin combining marks (U+0300-U+036F)
    on letters make the text unclean: through Mac Roman almost every accented letter has a
    second reading made of one, and counting those would make every repair doubtful."""
    text = text[1:] if text.startswith(_MOJ_BOM) else text
    if not text or text.isascii():
        return False
    seen = marks = letters = combining = False
    for char in text:
        category = unicodedata.category(char)
        if (category in ("Cc", "Cs", "Co", "Cn") and char not in u"\t\n\r") or char == u"\ufffd":
            return False
        if category[0] == "M":
            marks = True
            if 0x300 <= ord(char) <= 0x36F:
                combining = True
        elif category[0] == "L":
            letters = True
        if ord(char) > 0x7F and category[0] in "LNPS":
            seen = True
    if combining and letters and not allow_combining:
        return False        # Latin combining marks on letters: see the docstring
    return (seen or marks) and _moj_utf8_sequences(text, ("cp1252",)) == 0


def _moj_utf8_readings(text):
    """All ways the UTF-8 family can read ``text``: ``(candidates, others)``.

    A candidate is a reading that passes every check of ``_moj_utf8_accept`` (dict with
    ``codec``, ``chain``, ``result``, ``undefined``, ``main``; ``main`` is false for the second-opinion pages).
    ``others`` are readings through the main code pages that are valid UTF-8 and clean text but
    not accepted (an unsupported script, a run of signs, ...): they cannot be proposed, but they
    show that the damage could also have another origin."""
    candidates, others = [], []
    for result, chain, undefined in _moj_chains(text):
        # (the guards against clean Arabic pairs are for one layer: a text that decodes twice
        # is not a pair)
        accepted = _moj_utf8_accept(text, result, chain[-1] if len(chain) == 1 else "cp1252")
        if accepted is not None:
            candidates.append({"codec": chain[-1], "chain": chain, "result": accepted,
                               "undefined": undefined, "main": True})
        elif _moj_clean_reading(result):
            others.append({"codec": chain[-1], "chain": chain,
                           "result": result[1:] if result.startswith(_MOJ_BOM) else result})
    if not candidates:
        return candidates, others        # nothing to be in doubt about
    for codec, _label in _MOJ_SHADOW_PAGES:
        result, layers, undefined = _moj_peel_run(text, codec)
        if not layers:
            continue
        if not _moj_clean_reading(result, allow_combining=not codec.startswith("mac_")):
            continue
        # a second opinion counts only when it is a repair the tool itself would accept: letters
        # of the supported scripts (most readings through DOS and Mac pages are rare letters or
        # signs, and would make every accented letter doubtful)
        accepted = _moj_utf8_accept(text, result, "cp1252")
        if accepted is not None:
            candidates.append({"codec": codec, "chain": (codec,) * layers, "result": accepted,
                               "undefined": undefined, "main": False})
    return candidates, others


def _moj_reading_key(item):
    """Smaller is the more plausible reading: more layers (a text that decodes again is
    itself damaged), fewer unusual Arabic characters, fewer characters that the code page
    could not have shown, fewer words with a capital inside."""
    return (-len(item["chain"]), _moj_arabic_oddity(item["result"]), item["undefined"],
            _moj_case_oddity(item["result"]))


def _moj_short(text, width=60):
    return text if len(text) <= width else text[:width - 1] + u"\u2026"


def _moj_label(item):
    return _MOJ_CODEC_LABEL[item["codec"]]


# Arabic marks used to annotate the Quran (small high letters and signs, the extended vowel
# marks): they do not occur in names, and a case change of damaged text often produces them
# (Windows-1252 0x8A/0x9A and Windows-1256 0x8C/0x9C are case pairs: يـ becomes U+065A, ی U+06DC).
_MOJ_QURANIC_MARKS = frozenset(chr(c) for c in list(range(0x0656, 0x0660)) + list(range(0x06D6, 0x06EE)))
_MOJ_JOINERS = u"\u200c\u200d"
_MOJ_MAX_SINGLE_SWAPS = 24     # longer texts: only the whole-character swaps are tried


def _moj_quranic_count(text):
    return sum(1 for c in text if c in _MOJ_QURANIC_MARKS)


def _moj_case_uniform(text):
    """Is ``text`` unchanged by an upper-case, lower-case or title-case pass, with at least
    one non-ASCII cased character? Such a text may have been case-changed after the damage
    (Excel PROPER/UPPER/LOWER, ``!NAME!.title()`` in Calculate Field, SQL LOWER)."""
    if not any(ord(c) > 0x7F and c.swapcase() != c for c in text):
        return False
    return text == text.upper() or text == text.lower() or text == text.title() \
        or _moj_case_swapped(text)


def _moj_case_swapped(text):
    """Does a word of ``text`` look like a swapped case (Python ``swapcase``, Word "tOGGLE
    cASE")? A word whose first ASCII letter is lower case and whose other ASCII letters (two or
    more) are all upper case: ``aMERIKANISCHE``, ``sأ¼D``. Such a text is not
    of a uniform case, but a case pass after the damage changed its letters all the same.
    The same test is also made on the cased letters of every script (R11-1): a word that
    starts with mojibake, such as ``ؤœAPEK`` (``Čapek`` read as Windows-1256 and then
    swapped), has ``œ`` as its first cased letter and only upper-case letters after it."""
    for word in text.split():
        for cased in ([c for c in word if c.isascii() and c.isalpha()],
                      [c for c in word if c.islower() or c.isupper()]):
            if len(cased) >= 2 and cased[0].islower() and all(c.isupper() for c in cased[1:]):
                return True
    return False


def _moj_continuation_pair(char, other):
    """Do ``char`` and ``other`` both stand for a UTF-8 continuation byte (0x80-0xBF) through
    Windows-1252 or Windows-1256 (Š/š, Œ/œ, Ž/ž)?"""
    for codec in ("cp1252", "cp1256"):
        one, two = mojibake_encode(char, codec), mojibake_encode(other, codec)
        if one is not None and two is not None and 0x80 <= one[0] <= 0xBF and 0x80 <= two[0] <= 0xBF:
            return True
    return False


def _moj_case_variants(text):
    """Texts made from ``text`` by changing the case of non-ASCII characters: all of one
    character at a time, then all of them together. A swap that does not give exactly one
    character (German sharp s, ...) is skipped."""
    swaps = {}
    for char in text:
        if ord(char) > 0x7F and char not in swaps:
            other = char.swapcase()
            if other != char and len(other) == 1:
                swaps[char] = other
    out = []
    for char, other in swaps.items():
        out.append(text.replace(char, other))
    if len(swaps) > 1:
        out.append(u"".join(swaps.get(c, c) for c in text))
    # one occurrence at a time, for the characters that stand for a continuation byte
    # (0x80-0xBF) in both cases: a letter and a joiner can share such a byte
    positions = [i for i, c in enumerate(text) if c in swaps and _moj_continuation_pair(c, swaps[c])]
    if len(positions) <= _MOJ_MAX_SINGLE_SWAPS:
        for index in positions:
            variant = text[:index] + swaps[text[index]] + text[index + 1:]
            if variant not in out:
                out.append(variant)
    return out


def _moj_joiners_plausible(text):
    """A zero-width (non-)joiner needs a letter or mark of a non-Latin script (Persian, Indic)
    on at least one side and no Latin letter on either side: next to Latin text it is what a
    case change made of a quotation mark."""
    for index, char in enumerate(text):
        if char not in _MOJ_JOINERS:
            continue
        near = [text[n] for n in (index - 1, index + 1) if 0 <= n < len(text)]
        script_side = False
        for other in near:
            kind = unicodedata.category(other)[0]
            if kind == "L" and (ord(other) < 0x80 or _moj_letter_script(other) == "latin"):
                return False
            if ord(other) > 0x7F and kind in "LM":
                script_side = True
        if not script_side:
            return False
    return True


def _moj_glued_quotes(text):
    """Quotation marks with a non-ASCII letter or mark on both sides (``میلی“بار``): what a case change
    makes of a zero-width non-joiner (E2 80 8C and E2 80 9C differ by one case bit)."""
    count = 0
    for index in range(1, len(text) - 1):
        if unicodedata.category(text[index]) not in ("Pi", "Pf"):
            continue
        if all(ord(near) > 0x7F and unicodedata.category(near)[0] in "LM"
               for near in (text[index - 1], text[index + 1])):
            count += 1
    return count


def _moj_case_alternatives(text, result):
    """Clean readings, different from ``result`` beyond case, of ``text`` with the case of
    its non-ASCII characters changed (see U11). Only looked for when ``text`` has a uniform
    case. An alternative must not add Quranic marks and must place joiners plausibly."""
    if not _moj_case_uniform(text):
        return []
    found, seen = [], set([result.casefold()])
    stored_marks = _moj_quranic_count(text)
    for variant in _moj_case_variants(text):
        for alt, chain, _undefined in _moj_chains(variant):
            accepted = _moj_utf8_accept(variant, alt, chain[-1] if len(chain) == 1 else "cp1252")
            if accepted is None or accepted.casefold() in seen:
                continue
            if _moj_quranic_count(accepted) > stored_marks:
                continue
            if _moj_joiner_count(accepted) > _moj_joiner_count(result) \
                    and not _moj_joiners_plausible(accepted):
                continue
            if _moj_glued_quotes(accepted) > _moj_glued_quotes(result):
                continue
            seen.add(accepted.casefold())
            found.append(accepted)
    return found


def _moj_joiner_count(text):
    return sum(1 for c in text if c in _MOJ_JOINERS)


def _moj_case_check(text, result):
    """Rule U11 for a repair that would be HIGH: ``None`` when it stays HIGH, otherwise
    ``(proposed, detail)``. The repair is doubtful when it adds Quranic annotation marks, or
    when the stored text has a uniform case and changing the case of one of its non-ASCII
    characters gives another clean reading (a case pass after the damage turns one letter
    into another: 0x8A/0x9A, 0x8C/0x9C, 0x8E/0x9E are case pairs in Windows-1252/1256).
    The most plausible reading is proposed: fewer Quranic marks, fewer quotation marks glued
    between letters, joiners only between letters, fewer unusual Arabic characters, fewer
    capitals inside words; the bytes as stored win a tie."""
    marks = _moj_quranic_count(result) > _moj_quranic_count(text)
    alternatives = _moj_case_alternatives(text, result)
    if not marks and not alternatives:
        return None
    options = [result] + alternatives
    ranked = sorted(range(len(options)), key=lambda i: (
        _moj_quranic_count(options[i]), _moj_glued_quotes(options[i]),
        0 if _moj_joiners_plausible(options[i]) else 1, _moj_arabic_oddity(options[i]),
        _moj_case_oddity(options[i]), i))
    best = options[ranked[0]]
    reasons = []
    if marks:
        reasons.append("the direct reading holds Quranic annotation marks (rare in names)")
    if alternatives:
        reasons.append("the stored text has a uniform case, and with the case of a "
                       "non-ASCII character changed it also reads as clean text")
    others = [o for o in options if o != best]
    detail = "UTF-8 bytes; " + "; ".join(reasons) + " (was the case changed after the damage?)"
    if others:
        detail += "; also possible: " + "; ".join(_moj_short(o) for o in others[:3])
    return best, detail


def _moj_cut_layer(text, result):
    """Is ``result`` (an accepted repair of ``text``) itself one more layer of UTF-8 damage
    whose last character was cut off (rule U12)? A double-encoded value cut at a field width
    peels one layer cleanly; the next layer then fails only because its final UTF-8 sequence
    is incomplete, and through Windows-1256 the half-peeled text is Arabic letters that pass
    every other check.

    Through each main code page, the bytes of ``result`` must be valid UTF-8 except for an
    incomplete sequence at the very end, and one of these must hold:

    * the bytes before it hold at least one complete multi-byte sequence (the result is still
      UTF-8 shown as text: ``ط§ظ„ط¯ط§ط``);
    * through Windows-1252, the incomplete sequence is two or three bytes long (``â€`` at the
      end of a word; through the Arabic pages a clean Persian pair such as ``مچ`` gives such
      bytes);
    * it is one byte shown as an upper-case letter right after a lower-case letter (``FuÃ``,
      ``OsagÃ``: a capital at the end of a lower-case word is not how words are written; also
      ``Â``/``Ã`` right after a sign such as a hyphen, ``Bun-Ã``), or
      the Windows-1252 letter ``â`` (byte 0xE2, the lead byte of ’ “ ” – …) at the end of a
      word: French, Portuguese, Romanian and Vietnamese never end a word in â (``Saâ``).

    Returns ``(codec, deeper)`` or ``None``; ``deeper`` is the decodable part peeled further
    (the cut character dropped) when it is ASCII text or passes the acceptance test, otherwise
    ``None``. A cut that leaves only complete characters cannot be seen (a stored
    ``giÃ¡`` is the single-layer damage of ``giá``)."""
    for codec in _MOJ_MAIN_CODECS:
        data = mojibake_encode(result, codec)
        if data is None or data.isascii():
            continue
        try:
            data.decode("utf-8")
            continue                      # a full further layer: handled by the peeling itself
        except UnicodeDecodeError as exc:
            if exc.reason != "unexpected end of data" or exc.end != len(data):
                continue
            start = exc.start
        head, tail = data[:start], data[start:]
        try:
            prefix = head.decode("utf-8")
        except UnicodeDecodeError:
            continue
        evidence = len(prefix) < len(head) or (codec == "cp1252" and len(tail) >= 2)
        if not evidence and len(tail) == 1 and len(result) >= 2:
            last, before = result[-1], result[-2]
            evidence = (last.isupper() and (before.islower() or (
                last in u"\u00c2\u00c3" and not before.isalpha() and not before.isspace()))) \
                or (codec == "cp1252" and last == u"\u00e2" and not before.isspace())
        if not evidence:
            continue
        deeper = None
        if prefix.isascii():
            deeper = prefix if prefix.strip() else None
        else:
            peeled, _layers = _moj_peel_any(prefix, codec)
            accepted = _moj_utf8_accept(text, peeled, codec)
            if accepted is not None and not accepted.isascii():
                deeper = accepted
        return codec, deeper
    return None


def _moj_peel_any(text, first, max_layers=_MOJ_MAX_LAYERS):
    """``(result, layers)``: ``text`` peeled through ``first`` and then through any main code page
    for as long as a whole layer decodes (a value damaged by Windows-1256 and then Windows-1252
    needs both)."""
    current, layers = text, 0
    order = (first,) + tuple(c for c in _MOJ_MAIN_CODECS if c != first)
    while layers < max_layers:
        for codec in order:
            result, done, _undefined = _moj_peel_run(current, codec, max_layers - layers)
            if done:
                current, layers = result, layers + done
                break
        else:
            break
    return current, layers


def _moj_cut_first_layer(text):
    """Rule U12 when the value itself ends in the middle of a UTF-8 character: through a main code
    page its bytes are valid UTF-8 except for an incomplete sequence at the very end, and the bytes
    before it hold at least one complete multi-byte sequence. The decodable part is peeled as far
    as it goes (a further layer that was cut too is handled by ``_moj_cut_layer``), must pass the
    acceptance test with non-ASCII text left, and must hold the evidence of U1 (a clean Arabic
    letter followed by a Persian letter is one UTF-8 character through Windows-1256: ``غژف``). Returns ``(codec, (proposal, layers))`` or
    ``None``. Without this, a value cut inside its first layer (``ط·آ§ط¸â€‍ط·آ``) was not
    reported at all, or only its other words were repaired (U3)."""
    for codec in _MOJ_MAIN_CODECS:
        data = mojibake_encode(text, codec)
        if data is None or data.isascii():
            continue
        try:
            data.decode("utf-8")
            continue
        except UnicodeDecodeError as exc:
            if exc.reason != "unexpected end of data" or exc.end != len(data):
                continue
            head = data[:exc.start]
        try:
            prefix = head.decode("utf-8")
        except UnicodeDecodeError:
            continue
        if len(prefix) == len(head):
            continue                      # no complete multi-byte sequence: no evidence
        peeled, layers = _moj_peel_any(prefix, codec, _MOJ_MAX_LAYERS - 1)
        layers += 1
        for _step in range(_MOJ_MAX_LAYERS):
            further = _moj_cut_layer(text, peeled)
            if further is None or further[1] is None:
                break
            peeled, layers = further[1], layers + 1
        accepted = _moj_utf8_accept(text, peeled, codec)
        if accepted is None or accepted.isascii() or _moj_cut_layer(text, accepted) is not None:
            continue
        if _moj_utf8_confidence(text, accepted, False, layers, codec)[0] != CONF_HIGH:
            continue                      # as little evidence as U2: a clean Arabic + Persian pair
        return codec, (accepted, layers)
    return None


def _moj_analyse_utf8(text):
    """Finding of the UTF-8 family, or ``None``.

    The value is decoded through every code page the tool knows. Only the three main pages
    (Windows-1252/Latin-1, Windows-1256, ISO-8859-6) can start a finding; the others
    (ISO-8859-15, Baltic, Central European, DOS, Mac, ...) are second opinions. If the value
    can be read in more than one way and the readings differ, the repair is never HIGH:
    the bytes alone do not say which code page it was, so the best reading is proposed as
    MEDIUM (or LOW when two main readings are equally plausible) and the others are named."""
    candidates, others = _moj_utf8_readings(text)
    main = [c for c in candidates if c["main"]]
    if not main:
        cut = _moj_cut_first_layer(text)
        if cut is not None:                         # the first layer was cut short: see U12
            cut_codec, proposed = cut
            return {"pattern": PAT_DOUBLE if proposed[1] >= 2 else _MOJ_PATTERN_OF[cut_codec],
                    "confidence": CONF_MEDIUM, "rule": "U12", "proposed": proposed[0],
                    "detail": "UTF-8 bytes read as {0} whose last character was cut off (the value "
                              "was probably cut to a field width); the proposal is the part that "
                              "decodes, without the cut character".format(_MOJ_CODEC_LABEL[cut_codec])}
        part = _moj_utf8_partial(text)
        if part is None:
            return None
        codec, pattern, result, layers, glued, residue = part
        if residue:
            # a word left unchanged still decodes as UTF-8 through the code page but was refused
            # (its script, or not plausible): the partial repair would still hold mojibake
            return {"pattern": PAT_UNREPAIRED, "confidence": CONF_LOW, "rule": "X1",
                    "proposed": None,
                    "detail": "UTF-8 read as {0}; some words decode, but {1} part(s) that also "
                              "decode as UTF-8 give text outside the supported scripts or not "
                              "plausible, so no repair is proposed".format(
                                  _MOJ_CODEC_LABEL[codec], residue)}
        lost = [w for w in _MOJ_SPLIT.split(result) if w and _moj_lost_bytes_word(w)]
        if lost:
            # the words left unchanged are UTF-8 that lost bytes (rule X2): the partial repair
            # would still hold mojibake, so nothing is proposed
            return {"pattern": PAT_UNREPAIRED, "confidence": CONF_LOW, "rule": "X2",
                    "proposed": None,
                    "detail": "UTF-8 read as {0}; some words decode, but {1} word(s) lost bytes "
                              "after the damage (for example the C1 controls were removed), so "
                              "no repair is proposed".format(_MOJ_CODEC_LABEL[codec], len(lost))}
        confidence, rule = _moj_utf8_confidence(text, result, True, layers, codec)
        detail = "UTF-8 bytes read as {0} in some words; the other words are unchanged".format(
            _MOJ_CODEC_LABEL[codec])
        if glued:
            detail += ("; {0} word(s) glued to Latin letters were repaired in their non-ASCII "
                       "part only, so they keep two scripts").format(glued)
        return {"pattern": pattern, "confidence": confidence, "rule": rule, "proposed": result,
                "detail": detail}
    best_of = {}
    for index, item in enumerate(candidates):
        rank = (_moj_reading_key(item), index)
        old = best_of.get(item["result"])
        if old is None or rank < old[0]:
            best_of[item["result"]] = (rank, item)
    ranked = [pair[1] for pair in sorted(best_of.values(), key=lambda pair: pair[0])]
    best = ranked[0]
    other_texts, seen = [], set([best["result"]])
    for item in ranked[1:] + others:
        if item["result"] not in seen:
            seen.add(item["result"])
            other_texts.append((item, item["result"]))
    codec, chain, result = best["codec"], best["chain"], best["result"]
    layers = len(chain)
    pattern = PAT_DOUBLE if layers >= 2 else _MOJ_PATTERN_OF.get(codec, PAT_UTF8_OTHER)
    if other_texts:
        tie = len(ranked) > 1 and _moj_reading_key(ranked[0]) == _moj_reading_key(ranked[1]) \
            and ranked[0]["main"] and ranked[1]["main"]
        names = "; ".join("{0}: {1}".format(_moj_label(item), _moj_short(other))
                          for item, other in other_texts[:3])
        if len(other_texts) > 3:
            names += "; {0} more".format(len(other_texts) - 3)
        detail = "UTF-8 bytes read as {0}; also possible: {1}".format(_moj_label(best), names)
        return {"pattern": pattern, "confidence": CONF_LOW if tie else CONF_MEDIUM,
                "rule": "U6" if tie else "U4", "proposed": result, "detail": detail}
    confidence, rule = _moj_utf8_confidence(text, result, False, layers, codec, chain[0])
    if layers > _MOJ_MAX_LAYERS and confidence == CONF_HIGH:
        confidence, rule = CONF_MEDIUM, "U13"       # encoded four times or more: see U13
    elif layers >= 2 and len(set(chain)) > 1 and rule in ("U7", "U2"):
        confidence, rule = CONF_MEDIUM, "U10"       # two different code pages in a row: see U10
    if confidence == CONF_HIGH:
        cut = _moj_cut_layer(text, result)
        if cut is not None:                         # a further layer was cut short: see U12
            cut_codec, deeper = cut
            detail = ("UTF-8 bytes read as {0}, and the repaired text is itself UTF-8 read as "
                      "{1} whose last character was cut off (the value was probably cut to a "
                      "field width after being encoded more than once)").format(
                          _moj_label(best), _MOJ_CODEC_LABEL[cut_codec])
            if deeper is not None:
                detail += "; the proposal is the part that decodes, without the cut character"
            else:
                detail += "; the part before the cut does not decode cleanly, so no repair is proposed"
            proposed = deeper
            return {"pattern": PAT_DOUBLE, "confidence": CONF_MEDIUM, "rule": "U12",
                    "proposed": proposed, "detail": detail}
        doubt = _moj_case_check(text, result)
        if doubt is not None:                       # a case change after the damage: see U11
            return {"pattern": pattern, "confidence": CONF_MEDIUM, "rule": "U11",
                    "proposed": doubt[0], "detail": doubt[1]}
    detail = "UTF-8 bytes read as {0}".format(_moj_label(best))
    if layers >= 2:
        detail += "; encoded {0} times".format(layers) if len(set(chain)) == 1 \
            else "; encoded {0} times ({1})".format(layers, " then ".join(_moj_label({"codec": c})
                                                                           for c in chain))
    if text.startswith(u"\u00ef\u00bb\u00bf"):
        detail += "; starts with a UTF-8 byte order mark shown as text"
    if rule == "U2" and _moj_stray_latin_mark(result):
        detail += "; the repair leaves a combining accent that does not join its letter"
    elif rule == "U2" and _moj_caps_signs_only(text, chain[0]):
        detail += ("; the stored text also reads as clean text: an accented letter that ends a "
                   "word or an upper-case run, followed by a typographic sign")
    return {"pattern": pattern, "confidence": confidence, "rule": rule, "proposed": result,
            "detail": detail}


# --------------------------------------------------------------------------
# Single-byte family
# --------------------------------------------------------------------------

def _moj_split_word(part):
    """``(prefix, core, suffix)``: ASCII punctuation at both ends of ``part`` split off."""
    core = part.strip(_MOJ_ASCII_PUNCT)
    if not core:
        return part, u"", u""
    start = part.index(core)
    return part[:start], core, part[start + len(core):]


def _moj_arabic_word(core, true_codec):
    """Repair of one word whose non-ASCII characters are shown through cp1252 but are
    ``true_codec`` Arabic bytes; ``None`` unless it becomes entirely Arabic."""
    if any(c.isascii() and c.isalpha() for c in core):
        return None
    chars = [c for c in core if ord(c) > 0x7F]
    if len(chars) < 2:
        return None
    out = []
    for char in core:
        if ord(char) <= 0x7F:
            out.append(char)
            continue
        byte = _MOJ_CODECS["cp1252"][1].get(char)
        if byte is None:
            return None
        decoded = _MOJ_CODECS[true_codec][0][byte]
        if not (ord(decoded) > 0x7F and _moj_in_arabic(ord(decoded))):
            return None
        out.append(decoded)
    return u"".join(out)


def _moj_analyse_arabic_bytes(text):
    """CP1256/ISO-8859-6 bytes shown as Western European text."""
    parts = _MOJ_SPLIT.split(text)
    results = {}
    for true_codec, pattern in (("cp1256", PAT_CP1256_AS_1252), ("iso8859_6", PAT_ISO_AS_1252)):
        out, eligible, letters, other = [], 0, 0, 0
        for part in parts:
            if not part or part.isascii():
                out.append(part)
                continue
            prefix, core, suffix = _moj_split_word(part)
            fixed = _moj_arabic_word(core, true_codec) if core else None
            if fixed is None:
                other += 1
                out.append(part)
            else:
                eligible += 1
                letters += sum(1 for c in fixed if unicodedata.category(c)[0] == "L")
                out.append(prefix + fixed + suffix)
        if eligible:
            results[true_codec] = (pattern, u"".join(out), eligible, letters, other)
    if not results:
        return None
    pick = "cp1256"
    tie = False
    if "cp1256" not in results:
        pick = "iso8859_6"
    elif "iso8859_6" in results and results["cp1256"][1] != results["iso8859_6"][1]:
        odd_1256 = _moj_arabic_oddity(results["cp1256"][1])
        odd_iso = _moj_arabic_oddity(results["iso8859_6"][1])
        if odd_iso < odd_1256:
            pick = "iso8859_6"
        tie = odd_iso == odd_1256
    pattern, result, eligible, letters, other = results[pick]
    if tie:
        confidence, rule = CONF_LOW, "S4"
    elif other == 0 and letters >= 4 and any(c.islower() and ord(c) > 0x7F for c in text):
        confidence, rule = CONF_MEDIUM, "S1"
    else:
        confidence, rule = CONF_LOW, "S2"
    detail = ("{0} bytes shown as Western European text; {1} word(s) decoded".format(
        "Windows-1256" if pick == "cp1256" else "ISO-8859-6", eligible))
    if other:
        detail += "; {0} other non-ASCII word(s) left unchanged".format(other)
    if tie:
        alt = results["iso8859_6" if pick == "cp1256" else "cp1256"][1]
        detail += "; {0} bytes would give: {1}".format(
            "ISO-8859-6" if pick == "cp1256" else "Windows-1256", alt)
    return {"pattern": pattern, "confidence": confidence, "rule": rule, "proposed": result,
            "detail": detail}


def _moj_max_nonascii_run(text):
    best = run = 0
    for char in text:
        if ord(char) > 0x7F and unicodedata.category(char)[0] == "L":
            run += 1
            best = max(best, run)
        else:
            run = 0
    return best


def _moj_glued_to_latin(part):
    """Is the word a Latin word with Arabic letters glued to its letters? It must hold at
    least two ASCII letters and an Arabic letter or mark that touches an ASCII letter. A label such as
    ``Zone-X`` + one Arabic letter, ``B1`` + one Arabic letter or ``N.`` + one Arabic letter
    (a plot, block or unit mark in a Saudi address) is not one: the Arabic letter is
    separated from the Latin letters by a sign or a digit, or there is a single Latin letter."""
    if sum(1 for c in part if c.isascii() and c.isalpha()) < 2:
        return False
    for index, char in enumerate(part):
        if not _moj_in_arabic(ord(char)) or unicodedata.category(char)[0] not in "LM":
            continue
        before = part[index - 1] if index else u""
        after = part[index + 1] if index + 1 < len(part) else u""
        if (before.isascii() and before.isalpha()) or (after.isascii() and after.isalpha()):
            return True
    return False


def _moj_analyse_western_via_arabic(text):
    """Western European bytes shown through Windows-1256: Latin and Arabic letters in one word."""
    parts = _MOJ_SPLIT.split(text)
    out, changed = [], 0
    for part in parts:
        if not part or part.isascii():
            out.append(part)
            continue
        letters = [c for c in part if unicodedata.category(c)[0] in "LM"]
        has_ascii_latin = any(c.isascii() for c in letters)
        has_arabic = any(_moj_in_arabic(ord(c)) for c in letters)
        core = part.strip(_MOJ_ASCII_PUNCT)
        if not (has_ascii_latin and has_arabic) \
                or (core and unicodedata.category(core[0]) == "Mn") \
                or not _moj_glued_to_latin(part):
            # a vowel mark in front of a Latin word is a typing artefact seen in real names
            # (a kasra before "Ekleed"), not a Western letter shown through Windows-1256
            out.append(part)
            continue
        data = mojibake_encode(part, "cp1256")
        if data is None:
            out.append(part)
            continue
        fixed = mojibake_decode(data, "cp1252")
        scripts = set(_moj_letter_script(c) for c in fixed if unicodedata.category(c)[0] == "L")
        if scripts != set(["latin"]) or not _moj_text_allowed(fixed) \
                or _moj_max_nonascii_run(fixed) >= 3:
            out.append(part)
            continue
        out.append(fixed)
        changed += 1
    if not changed:
        return None
    return {"pattern": PAT_1252_AS_1256, "confidence": CONF_MEDIUM, "rule": "S3",
            "proposed": u"".join(out),
            "detail": "{0} word(s) mix Latin and Arabic letters; Western European bytes shown "
                      "through Windows-1256".format(changed)}


def _moj_analyse_turkish(text):
    triggers = sum(1 for c in text if c in _MOJ_TURKISH_MAP)
    if not triggers:
        return None
    fixed = u"".join(_MOJ_TURKISH_MAP.get(c, c) for c in text)
    for char in fixed:
        if ord(char) <= 0x7F or char in _MOJ_TURKISH_LETTERS:
            continue
        if unicodedata.category(char)[0] == "L" or not _moj_char_allowed(char):
            return None
    # y-acute alone (Czech, Slovak, Turkmen, Faroese, Icelandic) says nothing: the dotless i
    # of Turkish is written with the same byte. Evidence needs one of the other five letters.
    other_than_y = sum(1 for c in text if c in _MOJ_TURKISH_MAP and c not in u"\u00fd\u00dd")
    if triggers >= 2 and other_than_y >= 1:
        confidence, rule = CONF_MEDIUM, "T1"
    else:
        confidence, rule = CONF_LOW, "T2"
    return {"pattern": PAT_1254_AS_1252, "confidence": confidence, "rule": rule,
            "proposed": fixed,
            "detail": "{0} character(s) of the set Y-acute, thorn, eth read as Turkish "
                      "dotted/dotless i, s-cedilla, g-breve".format(triggers)}


# --------------------------------------------------------------------------
# Detection without repair
# --------------------------------------------------------------------------

def _moj_question_marks(text):
    """``(confidence, rule, detail)`` or ``None`` for lost characters shown as ``?``."""
    if u"?" not in text:
        return None
    pure_long = pure_short = other_words = 0
    embedded = False
    for token in _MOJ_SPLIT.split(text):
        if not token or token.isspace():
            continue
        if any(c in token for c in u"/:=&#@\\"):
            continue
        core = token.strip(u",.;:()[]{}'\"!-_*")
        if core and set(core) == set(u"?"):
            if len(core) >= 3:
                pure_long += 1
            elif len(core) == 2:
                pure_short += 1
            continue
        if any(unicodedata.category(c)[0] in "LN" for c in token):
            other_words += 1
        if re.search(r"[^\W\d_]\?[^\W\d_]", token) or re.search(r"(?<![^\W_])\?[^\W\d_]{2,}", token):
            embedded = True
    if pure_long and other_words:
        return CONF_MEDIUM, "Q1", ("{0} word(s) of question marks only; could be a typed "
                                   "placeholder".format(pure_long))
    if pure_long:
        return CONF_MEDIUM, "Q2", "only question marks; could be a typed placeholder"
    if pure_short and other_words:
        return CONF_MEDIUM, "Q2", "a word of two question marks"
    if embedded:
        return CONF_LOW, "Q3", "a question mark inside or at the start of a word"
    return None


# --------------------------------------------------------------------------
# One value
# --------------------------------------------------------------------------

def mojibake_analyse_value(value, checks=MOJIBAKE_CHECKS):
    """The finding for one text value, or ``None`` when nothing is wrong.

    Returns ``{"pattern", "confidence", "rule", "proposed" (text or None), "detail"}``.
    One finding per value: a repair beats ``REPLACEMENT_CHAR``, then ``C1_CONTROL``, then
    ``MOJIBAKE_UNREPAIRED``, then ``QUESTION_MARKS``; the detail names further signals.
    """
    if value is None or not isinstance(value, str) or value == u"":
        return None
    if _MOJ_C0_FIND.search(value):
        return _moj_analyse_with_c0(value, checks)
    return _moj_analyse_value(value, checks)


# ASCII control characters other than the white space of _MOJ_SPACES: NUL padding and the SUB
# end-of-file mark of fixed-width and legacy exports, ESC, the separators FS-US, DEL.
_MOJ_C0_FIND = re.compile(u"[\x00-\x08\x0e-\x1f\x7f]")


def _moj_analyse_with_c0(value, checks):
    """A value with ASCII control characters (see ``_MOJ_C0_FIND``): they are ASCII, so every layer
    of UTF-8 damage keeps them in place, and they say nothing about the damage. Controls at the
    start or the end (NUL padding, a SUB end-of-file mark) are set aside, and each control inside
    the value is read as a space, a word separator; the rest is analysed as usual. Without this a
    damaged value with a trailing NUL or SUB was silent or got no repair (the control failed the
    acceptance test). The proposal gets the control characters back in their places and changes
    nothing else. A clean value with control characters stays without a finding (as before)."""
    lead = re.match(u"[\x00-\x08\x0e-\x1f\x7f]*", value).group(0)
    tail = re.search(u"[\x00-\x08\x0e-\x1f\x7f]*$", value[len(lead):]).group(0)
    inner = value[len(lead):len(value) - len(tail)]
    masked = _MOJ_C0_FIND.sub(u" ", inner)
    finding = _moj_analyse_value(masked, checks) if masked else None
    if finding is None:
        return None
    count = len(_MOJ_C0_FIND.findall(value))
    if finding["proposed"] is not None:
        # ASCII characters keep their order in every repair, and a repair makes or drops no ASCII
        # space (a value cut to a field width loses only its end): the n-th space of the proposal
        # is the n-th space of the masked value
        spaces = [inner[i] for i, c in enumerate(masked) if c == u" "]
        out, index = [], 0
        for char in finding["proposed"]:
            if char == u" ":
                if index >= len(spaces):
                    out = None
                    break
                char = spaces[index]
                index += 1
            out.append(char)
        if out is None:
            finding["proposed"] = None      # (not expected; never a guessed placement)
            finding["pattern"], finding["confidence"], finding["rule"] = PAT_UNREPAIRED, CONF_LOW, "X1"
        else:
            finding["proposed"] = lead + u"".join(out) + tail
            if finding["proposed"] == value:
                return None
    finding["detail"] += "; {0} ASCII control character(s) kept in place".format(count)
    return finding


def _moj_analyse_value(value, checks):
    checks = set(checks)
    has_fffd = u"\ufffd" in value
    c1 = sum(1 for c in value if _moj_is_c1(c))
    qm = _moj_question_marks(value) if CHECK_QUESTION in checks else None
    finding = None
    if not value.isascii():
        if CHECK_UTF8 in checks and not has_fffd:
            finding = _moj_analyse_utf8(value)
        if finding is None and CHECK_UTF8 in checks and not has_fffd and not c1:
            finding = _moj_lost_bytes_finding(value, strong=True)
        if finding is None and CHECK_CODEPAGE in checks and not has_fffd \
                and not _moj_western_signature(value):
            # (a value that is valid UTF-8 shown through Windows-1252 but was refused above is a
            # text of an unsupported script, not a one-byte swap: it is reported as X1 below)
            finding = (_moj_analyse_arabic_bytes(value)
                       or _moj_analyse_western_via_arabic(value)
                       or _moj_analyse_turkish(value))
        if finding is None and _MOJ_FFFD_AS_TEXT in value and CHECK_REPLACEMENT in checks:
            finding = {"pattern": PAT_REPLACEMENT, "confidence": CONF_HIGH, "rule": "F2",
                       "proposed": None,
                       "detail": "replacement character stored as UTF-8 bytes shown as text"}
        if finding is None and has_fffd and CHECK_REPLACEMENT in checks:
            finding = {"pattern": PAT_REPLACEMENT, "confidence": CONF_HIGH, "rule": "F1",
                       "proposed": None,
                       "detail": "replacement character U+FFFD x{0}".format(
                           value.count(u"\ufffd"))}
        if finding is None and c1 and CHECK_C1 in checks:
            finding = {"pattern": PAT_C1, "confidence": CONF_HIGH, "rule": "C1",
                       "proposed": None, "detail": "C1 control character(s) x{0}".format(c1)}
        if finding is None and CHECK_UTF8 in checks and not has_fffd and not c1 \
                and _moj_western_signature(value) and not _moj_caps_signs_only(value, "cp1252"):
            # (clean upper-case text with a typographic sign after an accented capital, such as
            # MALMÖ–LUND or JOSÉ’S PIZZA, is valid UTF-8 through Windows-1252 too; its decoded
            # text is refused, and it is not reported)
            finding = {"pattern": PAT_UNREPAIRED, "confidence": CONF_LOW, "rule": "X1",
                       "proposed": None,
                       "detail": "UTF-8 signature, decoded text not in the supported scripts"}
        if finding is None and CHECK_UTF8 in checks and not has_fffd and not c1:
            finding = _moj_lost_bytes_finding(value)
    if finding is None and qm is not None:
        finding = {"pattern": PAT_QUESTION, "confidence": qm[0], "rule": qm[1],
                   "proposed": None, "detail": qm[2]}
        qm = None
    if finding is None:
        return None
    if finding["proposed"] is not None and finding["proposed"] == value:
        return None
    also = []
    if qm is not None and finding["pattern"] != PAT_QUESTION:
        also.append("question marks")
    if has_fffd and finding["pattern"] != PAT_REPLACEMENT:
        also.append("U+FFFD")
    if c1 and finding["proposed"] is None and finding["pattern"] != PAT_C1:
        also.append("C1 controls")
    if also:
        finding["detail"] += "; also " + ", ".join(also)
    return finding


def _moj_lead_need(byte):
    """Continuation bytes a UTF-8 lead byte needs, or ``None`` for a byte that cannot start a
    sequence (RFC 3629: C2-DF one, E0-EF two, F0-F4 three)."""
    if 0xC2 <= byte <= 0xDF:
        return 1
    if 0xE0 <= byte <= 0xEF:
        return 2
    if 0xF0 <= byte <= 0xF4:
        return 3
    return None


def _moj_lost_bytes_parse(text):
    """``(lead bytes, missing continuation bytes, paired lead bytes, best run)`` of ``text`` read
    as UTF-8 shown through Windows-1252/Latin-1 from which continuation bytes were removed, or
    ``None`` when the text cannot be that. ``paired`` counts the lead bytes still followed by a
    continuation byte shown as a Latin-1 character (U+00A0-U+00BF); ``best run`` is ``(leads,
    paired)`` of the run of non-ASCII characters with the most lead bytes."""
    if text.isascii():
        return None
    data = mojibake_encode(text, "cp1252")
    if data is None:
        return None
    leads = missing = paired = 0
    run, best = [0, 0], (0, 0)
    i, n = 0, len(data)
    while i < n:
        byte = data[i]
        if byte < 0x80:
            run = [0, 0]
            i += 1
            continue
        need = _moj_lead_need(byte)
        if need is None:
            return None
        j, got, latin1 = i + 1, 0, False
        while got < need and j < n and 0x80 <= data[j] <= 0xBF:
            latin1 = latin1 or data[j] >= 0xA0
            j += 1
            got += 1
        leads += 1
        missing += need - got
        paired += 1 if latin1 else 0
        run[0] += 1
        run[1] += 1 if latin1 else 0
        if (run[0], run[1]) > best:
            best = (run[0], run[1])
        i = j
    return leads, missing, paired, best


def _moj_lost_bytes_signature(text, strong=False):
    """Rule X2: is ``text`` UTF-8 shown through Windows-1252/Latin-1 with some continuation bytes
    removed afterwards? Returns ``(lead bytes, missing bytes)`` or ``None``.

    The text is encoded with the sloppy Windows-1252 table. Each non-ASCII byte must be a lead
    byte, or a continuation byte (0x80-0xBF) right after its lead or another continuation of the
    same character; a stray continuation byte or a byte that cannot start a sequence (``À``,
    ``Á``, ``õ`` to ``ÿ``) means the text is not this damage. At least one continuation byte
    must be missing (otherwise the text is valid UTF-8 and the other rules decide), and one run
    of non-ASCII characters must hold two or more lead bytes, one of them followed by a
    continuation byte shown as a Latin-1 character (U+00A0-U+00BF): ``Ø§ÙÙ``. Clean accented
    words (``préférée``, ``çîçewayî``) have no such pair.

    ``strong``: the evidence that beats a single-byte swap reading (Arabic Windows-1256 bytes
    shown as Western text, rules S1-S4, whose letters can also be lead bytes): two or more paired
    lead bytes, and at least one in three lead bytes paired. Lost-byte Arabic, Cyrillic, Greek or
    Hebrew keeps about half of its pairs; Windows-1256 Arabic has a pair only where a letter is
    followed by a sign such as the Arabic comma."""
    parsed = _moj_lost_bytes_parse(text)
    if parsed is None:
        return None
    leads, missing, paired, best = parsed
    if not missing or best[0] < 2 or best[1] < 1:
        return None
    if strong and (paired < 2 or 3 * paired < leads):
        return None
    return leads, missing


def _moj_lost_bytes_word(word):
    """A word left unchanged by a partial UTF-8 repair that is UTF-8 with lost bytes: it parses as
    such, misses a byte and has two or more lead bytes in one run (``ÙÙÙ``). The other words of
    the value decoded as UTF-8, so the pair is not needed here."""
    parsed = _moj_lost_bytes_parse(word)
    return parsed is not None and parsed[1] > 0 and parsed[3][0] >= 2


def _moj_lost_bytes_finding(value, strong=False):
    """The X2 finding of ``value`` or ``None`` (see ``_moj_lost_bytes_signature``)."""
    lost = _moj_lost_bytes_signature(value, strong)
    if lost is None:
        return None
    return {"pattern": PAT_UNREPAIRED, "confidence": CONF_LOW, "rule": "X2", "proposed": None,
            "detail": "UTF-8 signature with {0} byte(s) missing (UTF-8 read as "
                      "Windows-1252/Latin-1, then characters removed, for example the C1 "
                      "controls); the lost bytes cannot be restored".format(lost[1])}


def _moj_western_signature(text):
    """Does ``text`` decode as UTF-8 when read as Windows-1252/Latin-1 (a repair was refused)?"""
    data = mojibake_encode(text, "cp1252")
    if data is None:
        return False
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        return False
    return True


def mojibake_confidence_rank(confidence):
    return _MOJ_CONF_RANK.get(confidence, 0)


# --------------------------------------------------------------------------
# Many values
# --------------------------------------------------------------------------

def scan_mojibake(rows, field_names, checks=MOJIBAKE_CHECKS):
    """Issues of ``rows`` = ``[(oid, [value per field])]``.

    Returns ``(issues, stats)``; an issue is ``{"oid", "field", "original", "proposed",
    "pattern", "confidence", "rule", "detail"}``, sorted by OID then field order.
    ``stats[field]`` = ``{"values", "nulls", "non_blank"}`` counts of rows.
    """
    cache = {}
    issues = []
    stats = dict((f, {"values": 0, "nulls": 0, "non_blank": 0}) for f in field_names)
    for oid, values in rows:
        for name, value in zip(field_names, values):
            s = stats[name]
            s["values"] += 1
            if value is None:
                s["nulls"] += 1
                continue
            text = value if isinstance(value, str) else str(value)
            if text.strip(_MOJ_SPACES) == u"":
                continue        # blank: ASCII white space only (NEL U+0085 and NBSP are text)
            s["non_blank"] += 1
            if text not in cache:
                cache[text] = mojibake_analyse_value(text, checks)
            found = cache[text]
            if found is None:
                continue
            issues.append({"oid": oid, "field": name, "original": text,
                           "proposed": found["proposed"], "pattern": found["pattern"],
                           "confidence": found["confidence"], "rule": found["rule"],
                           "detail": found["detail"]})
    return issues, stats


def plan_repairs(issues, level=CONF_HIGH):
    """Repairs to apply at ``level`` or better: ``{field: {original: proposed}}`` plus the
    issues they came from. A repair is a function of the value alone, so the same damaged
    value in the same field always gets the same repair."""
    need = _MOJ_CONF_RANK[level]
    plan, used = {}, []
    for issue in issues:
        if issue["proposed"] is None or _MOJ_CONF_RANK[issue["confidence"]] < need:
            continue
        plan.setdefault(issue["field"], {})[issue["original"]] = issue["proposed"]
        used.append(issue)
    return plan, used


def mojibake_field_summary(issues, stats, field_names):
    """Rows ``(field, values, nulls, blanks, damaged, repairable, high, medium, low, top pattern)``.
    ``values`` counts rows, ``nulls`` the None values, ``blanks`` the empty or white-space-only
    texts (a spreadsheet import can give an empty text instead of NULL)."""
    rows = []
    for name in field_names:
        mine = [i for i in issues if i["field"] == name]
        patterns = {}
        for i in mine:
            patterns[i["pattern"]] = patterns.get(i["pattern"], 0) + 1
        top = ""
        if patterns:
            top = sorted(patterns.items(), key=lambda kv: (-kv[1], kv[0]))[0][0]
        s = stats.get(name, {"values": 0, "nulls": 0})
        rows.append((name, s["values"], s["nulls"], s["values"] - s["nulls"] - s["non_blank"],
                     len(mine),
                     sum(1 for i in mine if i["proposed"] is not None),
                     sum(1 for i in mine if i["confidence"] == CONF_HIGH),
                     sum(1 for i in mine if i["confidence"] == CONF_MEDIUM),
                     sum(1 for i in mine if i["confidence"] == CONF_LOW), top))
    return rows


def mojibake_summary(issues, row_count, fields):
    summary = [("Rows checked", row_count), ("Fields scanned", ", ".join(fields)),
               ("Damaged values", len(issues)),
               ("With a proposed repair", sum(1 for i in issues if i["proposed"] is not None))]
    for level in MOJIBAKE_CONFIDENCES:
        summary.append(("Confidence " + level, sum(1 for i in issues if i["confidence"] == level)))
    for pattern in MOJIBAKE_PATTERNS:
        n = sum(1 for i in issues if i["pattern"] == pattern)
        if n:
            summary.append(("Pattern " + pattern, n))
    return summary


# --------------------------------------------------------------------------
# dBASE / shapefile pre-flight
# --------------------------------------------------------------------------

# Code page mark (byte 29 of the .dbf header) -> Windows/DOS/Mac code page number.
# CONFIRMED against Microsoft Learn, "Code Pages Supported by Visual FoxPro"
# (learn.microsoft.com/en-us/previous-versions/visualstudio/foxpro/8t45x02s(v=vs.71)),
# 26 rows. 0x57 is not in that table (see mojibake_ldid_info).
MOJIBAKE_LDID_CODEPAGES = {
    0x01: 437, 0x02: 850, 0x03: 1252, 0x04: 10000, 0x64: 852, 0x65: 866, 0x66: 865,
    0x67: 861, 0x68: 895, 0x69: 620, 0x6A: 737, 0x6B: 857, 0x78: 950, 0x79: 949,
    0x7A: 936, 0x7B: 932, 0x7C: 874, 0x7D: 1255, 0x7E: 1256, 0x96: 10007, 0x97: 10029,
    0x98: 10006, 0xC8: 1250, 0xC9: 1251, 0xCA: 1254, 0xCB: 1253}
# Code page number -> Python codec (None: no codec in the standard library).
_MOJ_CODEPAGE_CODECS = {
    437: "cp437", 620: None, 737: "cp737", 850: "cp850", 852: "cp852", 857: "cp857",
    861: "cp861", 865: "cp865", 866: "cp866", 874: "cp874", 895: None, 932: "cp932",
    936: "cp936", 949: "cp949", 950: "cp950", 1250: "cp1250", 1251: "cp1251",
    1252: "cp1252", 1253: "cp1253", 1254: "cp1254", 1255: "cp1255", 1256: "cp1256",
    10000: "mac_roman", 10006: "mac_greek", 10007: "mac_cyrillic", 10029: "mac_latin2"}


def mojibake_ldid_info(ldid):
    """``(code page number or None, python codec or None, note)`` for an LDID byte."""
    if ldid == 0:
        return None, None, "not set (0)"
    if ldid in MOJIBAKE_LDID_CODEPAGES:
        page = MOJIBAKE_LDID_CODEPAGES[ldid]
        return page, _MOJ_CODEPAGE_CODECS.get(page), "code page {0}".format(page)
    if ldid == 0x57:
        return None, None, ("0x57 (87): GDAL's documentation says GDAL treats it as ISO-8859-1; "
                            "what it means to other software is not defined in the sources "
                            "checked")
    return None, None, "0x{0:02X} is not in the table checked (Visual FoxPro code pages)".format(
        ldid)


def mojibake_cpg_codec(text):
    """``(python codec or None, normalised text)`` for the content of a ``.cpg`` file.

    The content is a code page name or number ("UTF-8", "1252", "ISO-8859-6",
    "ANSI 1256"); it is resolved with ``codecs.lookup`` only.
    """
    label = (text or u"").strip().strip(u"\ufeff").strip()
    if not label:
        return None, label
    candidates = [label, label.replace(u" ", u"")]
    iso = re.match(r"(?i)^(?:ISO)?[-_ ]?8859[-_ ]?(\d{1,2})$", label)
    if iso:
        # Esri's own ISO labels: "88591" ... "885916" (article 000013192), also "8859-6"
        candidates.insert(0, "iso8859_" + str(int(iso.group(1))))
    digits = re.findall(r"\d{3,5}", label)
    if digits:
        candidates.append("cp" + digits[-1])
        # a code page number of the header-mark table whose codec is not named cpNNNN
        # (10000 Mac Roman, 10006, 10007, 10029)
        if _MOJ_CODEPAGE_CODECS.get(int(digits[-1])):
            candidates.append(_MOJ_CODEPAGE_CODECS[int(digits[-1])])
    for name in candidates:
        try:
            return codecs.lookup(name).name, label
        except (LookupError, ValueError):
            continue
    return None, label


def mojibake_read_dbf(path, max_distinct=20000):
    """Header, fields and the distinct non-ASCII text values (as bytes) of a dBASE file.

    Layout used (dBASE III/IV and Visual FoxPro tables, as written for shapefiles;
    Microsoft Learn, "Table File Structure", Table Header Record Structure): byte 0
    version, bytes 4-7 record count, 8-9 header length, 10-11 record length (little
    endian), byte 29 code page mark; 32-byte field descriptors from byte 32, name in
    bytes 0-10, type in byte 11, length in byte 16; the descriptors end with 0x0D; each
    record starts with a delete flag (``*`` = deleted).
    Returns ``{"records", "file_records" (records the file size has room for), "ldid",
    "fields": [{"name", "type", "length", "offset", "values": set of bytes}],
    "truncated": bool}``.
    """
    with open(path, "rb") as handle:
        head = handle.read(32)
        if len(head) < 32:
            raise ValueError("The file is too short to be a dBASE table.")
        records = struct.unpack("<I", head[4:8])[0]
        header_len, record_len = struct.unpack("<HH", head[8:12])
        ldid = head[29]
        if header_len < 33 or record_len < 2:
            raise ValueError("The dBASE header is not valid.")
        fields, offset = [], 1
        while True:
            desc = handle.read(32)
            if len(desc) < 32 or desc[0] == 0x0D:
                break
            name = desc[0:11].split(b"\x00")[0].decode("ascii", "replace")
            length = desc[16]
            fields.append({"name": name, "type": chr(desc[11]), "length": length,
                           "offset": offset, "values": set()})
            offset += length
        if offset > record_len:
            raise ValueError("The field lengths do not fit the record length.")
        handle.seek(0, 2)
        file_size = handle.tell()
        handle.seek(header_len)
        truncated = False
        text_fields = [f for f in fields if f["type"] == "C"]
        remaining = records
        while remaining > 0:
            chunk = handle.read(record_len * min(remaining, 2000))
            if not chunk:
                break
            for pos in range(0, len(chunk) - record_len + 1, record_len):
                remaining -= 1
                if chunk[pos:pos + 1] == b"*":
                    continue
                for field in text_fields:
                    raw = chunk[pos + field["offset"]:pos + field["offset"] + field["length"]]
                    raw = raw.rstrip(b" \x00")
                    if raw and not raw.isascii():
                        if len(field["values"]) < max_distinct:
                            field["values"].add(raw)
                        else:
                            truncated = True
    return {"records": records, "ldid": ldid, "fields": fields, "truncated": truncated,
            "file_records": max(file_size - header_len, 0) // record_len}


def _moj_codec_name(name):
    """The canonical Python codec name (``cp936`` and ``gbk`` are one codec, so are
    ``mac_roman`` and ``mac-roman``), or ``name`` itself when it is not a codec."""
    try:
        return codecs.lookup(name).name
    except (LookupError, TypeError, ValueError):
        return name


def _moj_valid_utf8(raw):
    try:
        raw.decode("utf-8")
        return True
    except UnicodeDecodeError:
        return False


def _moj_cut_utf8(raw, width):
    """Does ``raw`` end in the middle of a UTF-8 character that the field width cut off? (The
    only error is an incomplete sequence at the very end, and the value is within three bytes
    of the field width, which is the room a four-byte character can be short of.)"""
    try:
        raw.decode("utf-8")
        return False
    except UnicodeDecodeError as exc:
        return exc.reason == "unexpected end of data" and exc.end == len(raw) \
            and len(raw) >= width - 3


def mojibake_preflight(dbf_path):
    """Code page facts of a dBASE/shapefile attribute file and warnings from the bytes.

    ``dbf_path`` is the ``.dbf`` (or the ``.shp``: the extension is swapped). Only facts
    that follow from the bytes are reported: the declaration (``.cpg`` text and code page
    mark) and, per text field, whether its non-ASCII values are valid UTF-8. Whether
    ArcGIS Pro uses the ``.cpg`` or the code page mark first is NOT VERIFIED and is not
    claimed. Returns ``{"dbf", "cpg_path", "cpg_text", "cpg_codec", "ldid", "ldid_note",
    "ldid_codec", "declared", "fields": [...], "findings": [{"level", "field", "rule",
    "text"}], "records"}``.
    """
    base, ext = os.path.splitext(dbf_path)
    if ext.lower() != ".dbf":
        dbf_path = base + ".dbf"
    cpg_path = base + ".cpg"
    if not os.path.exists(cpg_path):
        for candidate in (base + ".CPG", base + ".Cpg"):
            if os.path.exists(candidate):
                cpg_path = candidate
                break
    info = mojibake_read_dbf(dbf_path)
    cpg_text, cpg_codec, cpg_nul = None, None, False
    if os.path.exists(cpg_path):
        with open(cpg_path, "rb") as handle:
            cpg_raw = handle.read(256)
        cpg_nul = b"\x00" in cpg_raw
        cpg_text = cpg_raw.replace(b"\x00", b"").decode("ascii", "replace")
        cpg_codec, cpg_text = mojibake_cpg_codec(cpg_text)
    page, ldid_codec, ldid_note = mojibake_ldid_info(info["ldid"])
    findings = []
    declared = []
    if cpg_nul:
        findings.append({"level": "WARNING", "field": None, "rule": "P0",
                         "text": "The .cpg file contains NUL bytes; they were ignored when "
                                 "reading the code page name. Rewrite the file as plain text."})
    if info["file_records"] != info["records"]:
        findings.append({"level": "WARNING", "field": None, "rule": "P0",
                         "text": "The dBASE header says {0} records but the file size holds {1}; "
                                 "{2}".format(info["records"], info["file_records"],
                                              "records after the first {0} were not checked."
                                              .format(info["records"])
                                              if info["records"] < info["file_records"] else
                                              "the file may be cut short.")})
    if cpg_text is not None:
        declared.append("CPG file: {0}".format(cpg_text or "(empty)"))
    declared.append("code page mark: " + ldid_note)
    cpg_utf8 = cpg_codec == "utf-8"
    cpg_declares = bool(cpg_text)
    ldid_declares = info["ldid"] != 0
    other_page = (cpg_declares and not cpg_utf8) or (not cpg_declares and ldid_declares)
    if cpg_codec and ldid_codec and _moj_codec_name(cpg_codec) != _moj_codec_name(ldid_codec):
        findings.append({"level": "WARNING", "field": None, "rule": "P0",
                         "text": "The .cpg file ({0}) and the code page mark ({1}) name "
                                 "different code pages.".format(cpg_text, ldid_note)})
    if not cpg_declares and not ldid_declares:
        findings.append({"level": "INFO", "field": None, "rule": "P0",
                         "text": "No code page is declared ({0}, code page mark 0).".format(
                             "no .cpg file" if cpg_text is None else
                             "the .cpg file is empty or holds only white space")})
    field_rows = []
    for field in info["fields"]:
        if field["type"] != "C":
            continue
        values = sorted(field["values"])
        valid = [v for v in values if _moj_valid_utf8(v)]
        cut = [v for v in values if _moj_cut_utf8(v, field["length"])]
        bad = [v for v in values if not _moj_valid_utf8(v) and v not in cut]
        field_rows.append({"name": field["name"], "non_ascii": len(values),
                           "valid_utf8": len(valid) + len(cut), "not_utf8": len(bad),
                           "cut_utf8": len(cut)})
        if not values:
            continue
        valid = valid + cut      # a value cut at the field width is UTF-8 text with its end lost
        sample = valid[0].decode("utf-8", "ignore")[:40] if valid else ""
        if cut:
            findings.append({
                "level": "WARNING", "field": field["name"], "rule": "P4",
                "text": "Field {0}: {1} distinct value(s) end in the middle of a UTF-8 character. "
                        "The text was cut at the field width ({2} bytes), so the last "
                        "character is lost; the code page declaration is not the cause. "
                        "Widen the field before the next export.".format(
                            field["name"], len(cut), field["length"])})
        confidence = CONF_HIGH if len(values) >= 3 else CONF_MEDIUM
        if cpg_utf8 and bad:
            findings.append({
                "level": "WARNING", "field": field["name"], "rule": "P1",
                "text": "Field {0}: the .cpg declares UTF-8 but {1} of {2} distinct non-ASCII "
                        "values are not valid UTF-8 (HIGH: the declaration is wrong for those "
                        "values).".format(field["name"], len(bad), len(values))})
        elif not bad and not cpg_utf8:
            if other_page:
                text = ("Field {0}: all {1} distinct non-ASCII values are valid UTF-8 byte "
                        "sequences (for example {2}) although another code page is declared; "
                        "the data are probably UTF-8. Writing UTF-8 into the .cpg file should "
                        "fix the display. Confidence {3} (rule P2).".format(
                            field["name"], len(values), sample, confidence))
            else:
                text = ("Field {0}: all {1} distinct non-ASCII values are valid UTF-8 byte "
                        "sequences (for example {2}) and no code page is declared; add a .cpg "
                        "file with UTF-8. Confidence {3} (rule P2).".format(
                            field["name"], len(values), sample, confidence))
            findings.append({"level": "WARNING", "field": field["name"], "rule": "P2",
                             "text": text})
        elif other_page and valid and bad:
            findings.append({
                "level": "WARNING", "field": field["name"], "rule": "P3",
                "text": "Field {0}: {1} non-ASCII values are valid UTF-8 and {2} are not; the "
                        "field mixes encodings (MEDIUM, rule P3).".format(
                            field["name"], len(valid), len(bad))})
    return {"dbf": dbf_path, "cpg_path": cpg_path if cpg_text is not None else None,
            "cpg_text": cpg_text, "cpg_codec": cpg_codec, "ldid": info["ldid"],
            "ldid_note": ldid_note, "ldid_codec": ldid_codec, "declared": "; ".join(declared),
            "fields": field_rows, "findings": findings, "records": info["records"],
            "truncated": info["truncated"]}


# ==========================================================================
# quality/domain_conformance_tool.py
# ==========================================================================
# Domain Audit: the ArcGIS Pro tool (adapter).

_CONFORMANCE_OUTSIDE_FIX = ("Choose an output location outside the scanned workspace; in Input "
                            "Workspace mode outputs may not replace any dataset of that "
                            "geodatabase, even an earlier output of this tool.")


_DC_SUBTYPE_NOTE = ("SUBTYPE_CODE 0 can mean 'no subtype' as well as subtype code 0.")

class DomainConformanceAudit(object):
    """Check attribute values against coded-value and range domains (subtype aware)."""

    DOC = {
        "summary": "Checks every value of every domain field against the domain that applies to "
                   "its row (subtype-level domains win), explains each violation (description "
                   "typed as code, case or space variant, out of range, unknown subtype) with a "
                   "suggested code, and audits the domains themselves (unused domains, duplicate "
                   "descriptions, codes never used, type mismatches). Read-only.",
        "usage": "Give either Input Tables (one or more layers or tables) or Input Workspace "
                 "(every feature class and table of a geodatabase), not both. In Input "
                 "Workspace mode an output that would replace any dataset of the scanned "
                 "geodatabase (including an output of an earlier run) is refused whatever the "
                 "overwrite setting: write the outputs outside the scanned workspace.\n\n"
                 "Selections and definition queries on input layers are honoured for the value "
                 "checks; domain usage is read from the schema. Two layers on the same table "
                 "(for example with different definition queries) are both read: every row "
                 "shown by either layer is checked, a row shown by both once. When the tables "
                 "come from more than one geodatabase, SRC_TABLE and DATASET hold the full path "
                 "of each table; the domain table's WORKSPACE column always names the "
                 "geodatabase of each row.\n\nA row whose subtype code is "
                 "NULL or unknown is checked against the field-level domain (an unknown code also "
                 "gets an INVALID_SUBTYPE row; a NULL code does not); a "
                 "field whose domain is set only at subtype level is then not checked for that "
                 "row, and a warning counts those values. Fix the subtype codes and run again."
                 "\n\nInvisible marks (right-to-left mark, Arabic letter mark U+061C, zero-width "
                 "space, word joiner U+2060, BOM, C0 control "
                 "characters other than tab and line breaks, DEL, C1 control characters "
                 "U+0080-U+009F other than U+0085, invisible operators U+2061-U+2064, U+180E, "
                 "combining grapheme joiner, variation selectors) are ignored when a value is matched against a "
                 "code or a description, so a pasted Arabic value that only looks right is "
                 "reported with its suggested code. A value that equals a description exactly is "
                 "suggested that description's code even when it is also a case variant of "
                 "another code. A blank value, or one made only of invisible marks, is never "
                 "matched to a description. Coded domains on date and time fields compare "
                 "dates and times, so a DateOnly value equals a midnight code. ArcGIS Pro "
                 "returns the codes of a Date domain as text in the Windows short date form "
                 "(for example 3/5/2024): the tool reads them in the day, month and year order "
                 "of the Windows short date format, or in the only order in which every code is "
                 "a date, and a message names the order. When the codes cannot be read as dates "
                 "(no such order, a two-digit year, or a calendar that is not Gregorian) the "
                 "values of that domain are not checked: a warning counts them, and no "
                 "violation and no CODE_NEVER_USED row is reported for the domain. "
                 "If nothing was checked (only shapefiles, "
                 "tables without a domain field, an input that shows no rows, or a domain that "
                 "the subtype of every row removes) the run ends with a warning instead of "
                 "\"No domain violations found\".\n\n"
                 "Shapefiles and dBASE tables have no domains and are skipped with a message; "
                 "an output that would replace any input, skipped ones included, is refused.\n\n"
                 "Unused domains and never-used codes refer only to the scanned tables and "
                 "fields. CODE_NEVER_USED means the code never occurs as a valid value; when "
                 "violations suggest the code its detail says how many, and the data then does "
                 "mean that code: fix the values, do not delete the code; when the domain applied to "
                 "no row that was read, its detail says why: the input shows no rows, the rows' "
                 "subtype codes are NULL or unknown, no row has a subtype that uses the domain, "
                 "or every row's subtype removes it. In Input Tables mode UNUSED_DOMAIN therefore lists every domain of the "
                 "geodatabase that the chosen tables do not use, which can be many rows in a "
                 "large geodatabase; clear Check domain hygiene to leave them out.\n\n"
                 "Range domains on TimeOnly fields compare the time of day with the time of "
                 "day of the bounds (bounds that come back as text such as 8:00:00 AM, 08:00:00 "
                 "or a date and time are read as a time of day); TimestampOffset values are compared with offset-aware "
                 "bounds exactly and with bounds without an offset by clock time. Date range "
                 "bounds that come back as text are read as dates in the same way, and text that "
                 "ends with a UTC offset (+03:00) as a date and time with that offset. A value that "
                 "cannot be compared with the bounds is not reported as a violation and not "
                 "counted as checked; a warning counts it, and when no value at all could be "
                 "compared the run ends with a warning instead of \"No domain violations "
                 "found\".\n\nTYPE_MISMATCH compares the field type with the domain's "
                 "field type as arcpy reports it (Domain.type, for example Text or Double). An "
                 "unknown spelling gives no "
                 "TYPE_MISMATCH row rather than a false one.\n\nValues are matched after "
                 "removal of invisible marks, Unicode NFC, trimming and case folding only: "
                 "Arabic spelling variants (hamza and alef forms, tashkeel, tatweel, "
                 "presentation forms), full-width Latin letters and Arabic-Indic digits "
                 "(U+0660-0669, U+06F0-06F9, so a value of Arabic-Indic digits never matches "
                 "the code 12) are not folded and give OUT_OF_DOMAIN with no suggested code. "
                 "Case folding does fold the German sharp s and Latin ligatures (STRASSE "
                 "matches a code written with the sharp s). A range domain whose minimum is above "
                 "its maximum gets a RANGE_MIN_ABOVE_MAX row. All rows of a table are read into memory, so check very large tables "
                 "in parts. The report's Detail sheet holds violation rows and domain rows "
                 "under one header: filter on RECORD first. A .csv report path gives two files, "
                 "<name>_summary.csv and <name>_detail.csv; in them a text that a spreadsheet "
                 "would run as a formula (starting with =, @, or + or - not followed by a plain "
                 "number) gets a leading apostrophe. The output tables keep the exact text; "
                 "the Excel report shows control characters as <U+XXXX>. A report path inside "
                 "a file geodatabase (.gdb) folder is refused.\n\nLayers with a join are not supported: "
                 "check the tables themselves.\n\nSUBTYPE_CODE is empty when the row or field has no subtype. A "
                 "dBASE output table (in a folder) cannot store an empty number and stores 0, "
                 "which can be a real subtype code; a warning says so. Write the outputs to a "
                 "geodatabase to keep it empty. In a dBASE or shapefile output a text field holds "
                 "at most 254 UTF-8 bytes (an Arabic letter takes 2): longer text is cut to 254 "
                 "bytes and a warning counts the cut values (the report keeps the full text). "
                 "The dBASE table also gets the extra columns OID and Field1, and the field "
                 "name SUBTYPE_CODE is cut to SUBTYPE_CO.\n\nThe tool never edits data.",
        "params": {
            "in_tables": "Layers or tables to check. Leave empty when Input Workspace is used.",
            "in_workspace": "Geodatabase whose feature classes and tables are all checked. "
                            "Leave empty when Input Tables is used.",
            "fields": "Fields to check (only when exactly one input table is given). Default: "
                      "every field that has a domain at field or subtype level.",
            "check_hygiene": "Report unused domains, duplicate and near-duplicate descriptions, "
                             "text codes that differ only by case or spaces (NEAR_DUP_CODE) and "
                             "field/domain type mismatches.",
            "scan_unused_codes": "Report codes of used coded-value domains that never occur as a "
                                 "valid value in the scanned data (the detail counts the "
                                 "violations that suggest the code).",
            "null_is_violation": "Report null values in domain fields as NULL_VALUE violations. "
                                 "By default nulls are only counted.",
            "out_table": "Output table with one row per violation: SRC_TABLE, SRC_OID, FIELD, "
                         "SUBTYPE_CODE, DOMAIN, VALUE, ISSUE, SUGGESTED.",
            "out_domain_table": "Optional output table of domain usage (USAGE rows) and domain "
                                "hygiene issues (ISSUE rows), with the WORKSPACE (geodatabase) "
                                "of each row.",
            "out_report": "Optional Excel (.xlsx) report with Summary and Detail sheets; a .csv "
                          "path gives two CSV files, <name>_summary.csv and <name>_detail.csv. "
                          "A report path inside a file geodatabase (.gdb) folder is refused.",
            "violation_count": "Number of violations found (derived).",
        },
        "tags": ["domain", "coded value", "subtype", "validation", "quality"],
    }

    def __init__(self):
        self.label = "Domain Audit"
        self.description = ("Checks attribute values against coded-value and range domains at "
                            "subtype level and audits the domains themselves (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_tables", "Input Tables", ["GPFeatureLayer", "GPTableView"],
                       required=False, multi_value=True),
            make_param("in_workspace", "Input Workspace", "DEWorkspace", required=False),
            make_param("fields", "Fields", "Field", required=False, multi_value=True,
                       depends_on="in_tables"),
            make_param("check_hygiene", "Check domain hygiene", "GPBoolean", required=False,
                       default=True),
            make_param("scan_unused_codes", "Report codes never used", "GPBoolean",
                       required=False, default=True),
            make_param("null_is_violation", "Treat nulls as violations", "GPBoolean",
                       required=False, default=False),
            make_param("out_table", "Output Violations Table", "DETable", direction="Output"),
            make_param("out_domain_table", "Output Domain Table", "DETable", direction="Output",
                       required=False),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("violation_count", "Violation Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        p = param_map(parameters)
        p["fields"].enabled = len(param_list(p["in_tables"])) <= 1
        return

    @protected_outputs(scanned="in_workspace")
    def updateMessages(self, parameters):
        p = param_map(parameters)
        tables = param_list(p["in_tables"])
        workspace = param_text(p["in_workspace"])
        if tables and workspace:
            p["in_workspace"].setErrorMessage(
                "Give either Input Tables or Input Workspace, not both.")
        elif not tables and not workspace and param_text(p["out_table"]):
            # only once the user has started filling the tool in
            p["in_tables"].setErrorMessage("Give Input Tables or an Input Workspace.")
        if len(tables) > 1 and param_list(p["fields"]):
            p["fields"].setErrorMessage("Fields can only be chosen when one input table is given.")
        if workspace and not tables:
            for name in ("out_table", "out_domain_table"):
                out = param_text(p[name])
                same_ws = dataset_identity(workspace_of(out)) == dataset_identity(workspace) \
                    if out else False
                if same_ws and arcpy.Exists(out):
                    p[name].setErrorMessage(
                        "This output would replace a dataset of the scanned workspace. "
                        + _CONFORMANCE_OUTSIDE_FIX)
        report_gdb = _conformance_report_gdb(param_text(p["out_report"]))
        if report_gdb:
            p["out_report"].setErrorMessage(_conformance_report_gdb_message(
                param_text(p["out_report"]), report_gdb))
        if find_duplicate_outputs([param_text(p["out_table"]), param_text(p["out_domain_table"])]):
            p["out_domain_table"].setErrorMessage(
                "The domain table must be a different dataset from the violations table.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))

    # ------------------------------------------------------------------

    def _inputs(self, p, collector):
        """List of ``(path, workspace for domains)`` to scan."""
        tables = param_list(p["in_tables"])
        workspace = param_text(p["in_workspace"])
        if tables and workspace:
            raise ToolError("Both Input Tables and Input Workspace were given.",
                            "Clear one of the two parameters.")
        if not tables and not workspace:
            raise ToolError("No input was given.", "Choose Input Tables or an Input Workspace.")
        if tables:
            return tables
        if is_folder_workspace(workspace):
            collector.warning("'{0}' is a folder: shapefiles and dBASE tables have no domains, "
                              "so nothing can be checked. Choose a geodatabase.".format(workspace))
            return []
        walked = walk_workspace(workspace, ("FeatureClass", "Table"))
        for err in walked["errors"]:
            collector.warning("Could not list '{0}': {1}. Check that it is readable.".format(
                err["path"], err["message"]))
        # Rule 4 / decision D-015: an output may never be one of the scanned datasets,
        # whatever overwriteOutput says (not even an earlier output of this tool).
        paths = [i["path"] for i in walked["items"]]
        try:
            refuse_if_same([param_text(p["out_table"]), param_text(p["out_domain_table"])], paths)
        except ToolError as err:
            raise ToolError("{0} The geodatabase is scanned by this run.".format(err.cause),
                            _CONFORMANCE_OUTSIDE_FIX)
        return paths

    def _run(self, parameters, p, collector):
        report_gdb = _conformance_report_gdb(param_text(p["out_report"]))
        if report_gdb:
            # Review R8-N1: a report file inside a .gdb folder lies among the geodatabase's own
            # files (hidden in the Catalog pane), whether or not that geodatabase is scanned.
            raise ToolError(_conformance_report_gdb_message(param_text(p["out_report"]), report_gdb),
                            "Choose a report path in a plain folder outside every geodatabase.")
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        out_table = param_text(p["out_table"])
        out_domain = param_text(p["out_domain_table"])
        refuse_duplicate_outputs([out_table, out_domain])
        wanted_fields = param_list(p["fields"])
        null_violation = param_bool(p["null_is_violation"])
        # Review R10-1: Pro returns Date codes as text in the Windows short date form.
        date_order, date_format = _conformance_date_order()

        descs = []
        seen = {}
        # Review D1: EVERY input (also skipped shapefile/dBASE tables and duplicates) is
        # an input of the output check, so no output can replace it.
        all_inputs = []
        for path in self._inputs(p, collector):
            desc = describe_dataset(path)
            all_inputs.append(desc["catalog_path"])
            key = normalize_catalog_path(desc["catalog_path"])
            if key in seen:
                first = seen[key]
                if _conformance_same_input(path, first["read_inputs"]):
                    collector.info("'{0}' is listed twice; it is checked once.".format(path))
                else:
                    # Review R5-2: two layers on one source can show different rows (definition
                    # query, selection). The rows of every such input are read; a row shown by
                    # more than one of them is checked once.
                    first["read_inputs"].append(path)
                    collector.info("'{0}' reads the same data as '{1}': the rows of both are "
                                   "checked, a row shown by both once.".format(path, first["input"]))
                continue
            desc["read_inputs"] = [desc["input"]]
            seen[key] = desc
            if is_folder_workspace(desc["workspace"]):
                collector.info("'{0}' is in a folder (shapefile/dBASE) and has no domains; "
                               "skipped.".format(path))
                continue
            descs.append(desc)
        refuse_if_same([out_table, out_domain], all_inputs)
        if wanted_fields and len(descs) != 1:
            raise ToolError("Fields were chosen but {0} tables are being checked.".format(
                len(descs)), "Choose fields only when exactly one input table is given.")
        # Review R5-1: tables of more than one geodatabase are named by their full path in
        # SRC_TABLE / DATASET, so two tables with the same name (regional copies of one
        # schema) can be told apart; the domain table also gets the WORKSPACE of each row.
        many_ws = len(set(normalize_catalog_path(d["workspace"]) for d in descs)) > 1
        for desc in descs:
            desc["label"] = desc["catalog_path"] if many_ws else desc["name"]
        if many_ws:
            collector.info("The tables come from more than one geodatabase, so SRC_TABLE and "
                           "DATASET hold the full path of each table.")

        domains_by_ws = {}
        violations, usage, stats_list = [], [], []
        used_codes_by_ws, scanned_by_ws, usage_by_ws, suggested_by_ws = {}, {}, {}, {}
        applied_by_ws, unreadable_by_ws, orders_told = {}, {}, set()
        reach_by_ws = {}
        progress = Progress("Checking domain values", len(descs))
        for desc in descs:
            ws = desc["workspace"]
            ws_key = normalize_catalog_path(ws)
            if ws_key not in domains_by_ws:
                domains_by_ws[ws_key] = (ws, read_domains(ws))
            domains = domains_by_ws[ws_key][1]
            subtypes = read_subtypes(desc["catalog_path"])
            resolved = None
            if wanted_fields:
                resolved = []
                for wanted in wanted_fields:
                    field, how = match_field(desc["fields"], wanted, label="field",
                                             exact_name_first=True)
                    collector.info(match_message(wanted, field, how))
                    resolved.append(field["name"])
            check_fields = domain_fields_to_check(desc["fields"], subtypes, resolved)
            if resolved:
                for name in resolved:
                    if name not in check_fields:
                        collector.warning("Field '{0}' of {1} has no domain at field or subtype "
                                          "level and was not checked. Choose a field with a "
                                          "domain.".format(name, desc["label"]))
            table_usage = domain_usage_rows(desc["label"], desc["fields"], subtypes)
            for row in table_usage:
                row["workspace"] = ws
            usage.extend(table_usage)
            usage_by_ws.setdefault(ws_key, []).extend(table_usage)
            read_names = list(check_fields)
            if subtypes["field"] and subtypes["field"] not in read_names:
                read_names.append(subtypes["field"])
            rows = _conformance_read_rows(desc["read_inputs"], read_names) if check_fields else []
            used = used_codes_by_ws.setdefault(ws_key, {})
            found, stats = check_table_conformance(desc["label"], desc["fields"], subtypes, rows,
                                                   domains, check_fields, null_violation, used,
                                                   suggested_by_ws.setdefault(ws_key, {}),
                                                   applied_by_ws.setdefault(ws_key, set()),
                                                   date_order=date_order,
                                                   domain_reach=reach_by_ws.setdefault(ws_key, {}))
            for name in sorted(stats["missing_domains"]):
                count = stats["missing_values"].get(name, 0)
                collector.warning("Domain '{0}' is assigned in {1} but does not exist in the "
                                  "workspace; its {2} non-null value(s) were not checked{3}. "
                                  "Assign an existing domain.".format(
                                      name, desc["label"], count,
                                      ", and its NULLs get no NULL_VALUE row" if null_violation else ""))
            for (fname, dname), count in sorted(stats["undetermined"].items()):
                collector.warning(
                    "{0} value(s) of {1}.{2} could not be compared with the bounds of range "
                    "domain '{3}' (a time of day against bounds of another kind, or a date "
                    "against a bound that could not be read as a date) and were not "
                    "checked. Check the domain's minimum and maximum in the Domains view.".format(
                        count, desc["label"], fname, dname))
            unreadable_by_ws.setdefault(ws_key, set()).update(stats["unreadable_codes"])
            for (fname, dname), count in sorted(stats["unreadable"].items()):
                codes = stats["unreadable_codes"].get(dname) or []
                collector.warning(
                    "{0} value(s) of {1}.{2} were not checked: the codes of coded-value domain "
                    "'{3}' came back from ArcGIS as text that could not be read as dates ({4}){5}. "
                    "No violation and no CODE_NEVER_USED row is reported for this domain. Check "
                    "the codes in the Domains view.".format(
                        count, desc["label"], fname, dname,
                        ", ".join("'{0}'".format(c) for c in codes[:3])
                        + (", ..." if len(codes) > 3 else ""),
                        _conformance_order_note(date_order, date_format)))
            for dname, (order, how) in sorted(stats["date_orders"].items()):
                if (ws_key, dname) in orders_told:
                    continue
                orders_told.add((ws_key, dname))
                collector.info(
                    "The date codes of domain '{0}' came back from ArcGIS as text and were read "
                    "as {1}{2}.".format(dname, DOMAIN_DATE_WORDS[order], {
                        "hint": " (the Windows short date format {0})".format(date_format),
                        "only": " (the only order in which every code is a date)",
                        "same": " (every order gives the same dates)"}[how]))
            for fname, count in sorted(stats["no_subtype"].items()):
                collector.warning(
                    "{0} value(s) of {1}.{2} were not checked: their row's subtype code is NULL or "
                    "unknown and the field has a domain only at subtype level. Fix the subtype "
                    "codes (an unknown code also gets an INVALID_SUBTYPE row) and run "
                    "again.".format(
                        count, desc["label"], fname))
            scanned = scanned_by_ws.setdefault(ws_key, set())
            for name in check_fields:
                scanned.update(_conformance_domains_of_field(desc["fields"], subtypes, name))
            violations.extend(found)
            stats_list.append((desc["label"], stats))
            if check_fields:
                collector.info("{0}: {1} row(s), {2} field(s) with domains, {3} violation(s).".format(
                    desc["label"], stats["rows"], len(check_fields), len(found)))
            else:
                collector.info("{0}: no field with a domain, rows not read.".format(desc["label"]))
            progress.tick()
        progress.close()

        domain_rows = []
        for ws_key in sorted(domains_by_ws):
            ws, domains = domains_by_ws[ws_key]
            ws_usage = usage_by_ws.get(ws_key, [])
            domain_rows.extend(ws_usage)
            hygiene = domain_hygiene_rows(
                domains, ws_usage, used_codes_by_ws.get(ws_key, {}),
                check_hygiene=param_bool(p["check_hygiene"], True),
                scan_unused_codes=param_bool(p["scan_unused_codes"], True),
                scanned_domains=scanned_by_ws.get(ws_key, set()),
                suggested_codes=suggested_by_ws.get(ws_key, {}),
                applied_domains=applied_by_ws.get(ws_key, set()),
                domain_reach=reach_by_ws.get(ws_key, {}),
                unreadable_domains=unreadable_by_ws.get(ws_key, set()),
                date_order=date_order)
            for row in hygiene:
                row["workspace"] = ws
            domain_rows.extend(hygiene)
        if wanted_fields and param_bool(p["scan_unused_codes"], True):
            collector.info("Codes never used are judged on the chosen fields only.")

        inputs = all_inputs
        cut = [0]
        notes = [self._write_violations(out_table, violations, inputs, cut, collector)]
        if out_domain:
            notes.append(self._write_domain_table(out_domain, domain_rows, inputs, cut))
        if cut[0]:
            # Source values and names are written as they are; a dBASE/shapefile text field
            # cannot hold more than 254 bytes, so they are cut and counted (the report keeps the
            # full text) rather than refusing the whole run.
            collector.warning(
                "{0} text value(s) are longer than {1} bytes in UTF-8 (an Arabic letter takes 2 "
                "bytes; a character above U+FFFF, such as an emoji, is counted as 6), the most a dBASE/shapefile text field holds; they are cut to {1} bytes "
                "in the output{2}. Write the outputs to a file geodatabase to keep the full "
                "text.".format(cut[0], SHAPEFILE_MAX_TEXT,
                               " (the report keeps the full text)" if report else ""))
        for note in notes:
            if note:
                collector.warning(note)
        summary = domain_audit_summary(violations, domain_rows, stats_list)
        detail_header = ["RECORD", "TABLE", "OID", "FIELD", "SUBTYPE_CODE", "DOMAIN",
                         "VALUE_OR_CODE", "ISSUE", "SUGGESTED_OR_DETAIL", "WORKSPACE"]
        detail = [("VIOLATION", v["table"], v["oid"], v["field"], v["subtype_code"], v["domain"],
                   v["value"], v["issue"], v["suggested"], None) for v in violations]
        detail += [(r["record_type"], r["dataset"], None, r["field"], r["subtype_code"],
                    r["domain"], r["code"], r["issue"], r["detail"], r.get("workspace"))
                   for r in domain_rows]
        for path in write_report(report, summary, detail_header, detail):
            collector.info("Report written to {0}.".format(path))
        checked_total = sum(stats["checked_values"] for _name, stats in stats_list)
        # Review R14-2: every value with a domain that was left out, whatever the cause.
        no_subtype_total = sum(sum(stats["no_subtype"].values()) for _n, stats in stats_list)
        missing_total = sum(sum(stats["missing_values"].values()) for _n, stats in stats_list)
        skipped = sum(sum(stats["undetermined"].values()) + sum(stats["unreadable"].values())
                      for _n, stats in stats_list) + no_subtype_total + missing_total
        if violations:
            collector.warning("{0} domain violation(s) found; see {1}.".format(
                len(violations), out_table))
        elif not stats_list:
            # An empty result must not read like a pass when nothing was looked at.
            collector.warning("No table was checked (shapefiles and dBASE tables have no domains, "
                              "or the workspace has no tables), so the empty result says nothing "
                              "about the data. Choose a geodatabase table or feature class.")
        elif checked_total == 0 and any(stats["unreadable"] for _n, stats in stats_list):
            # Review R10-1: the values were left out because the date codes could not be read.
            collector.warning("No value was checked: the codes of the date domain(s) could not be "
                              "read as dates (see the warning above), so the empty result says "
                              "nothing about the data.")
        elif checked_total == 0 and any(stats["undetermined"] for _n, stats in stats_list):
            # Review R11-1: every value with a domain was left out because it could not be
            # compared with the bounds of its range domain.
            collector.warning("No value was checked: the values could not be compared with the "
                              "bounds of the range domain(s) (see the warning above), so the "
                              "empty result says nothing about the data.")
        elif checked_total == 0 and no_subtype_total:
            # Review R14-2: every value left out because its row's subtype code is NULL or unknown
            # (with values of a missing domain, the warnings above count both).
            collector.warning("No value was checked: the rows' subtype codes are NULL or unknown and "
                              "the fields have a domain only at subtype level (see the warning "
                              "above), so the empty result says nothing about the data. Fix the "
                              "subtype codes and run again.")
        elif checked_total == 0 and missing_total:
            # Review R14-2: every value left out because its domain does not exist.
            collector.warning("No value was checked: the domains assigned to the fields do not exist "
                              "in the workspace (see the warning above), so the empty result says "
                              "nothing about the data. Assign an existing domain.")
        elif checked_total == 0:
            # Review R9-b: when the inputs that have domain fields show no row at all (an empty
            # table, a layer whose definition query shows none), say that, not the
            # causes that are about rows that were read.
            read_tables = [stats for _name, stats in stats_list if stats["nulls"]]
            if read_tables and not any(stats["rows"] for stats in read_tables):
                collector.warning("No value was checked: the input shows no rows (an empty table, "
                                  "or a layer whose definition query shows none), so "
                                  "the empty result says nothing about the data. Clear the "
                                  "definition query, or choose a table with rows.")
            else:
                collector.warning("No value was checked: the chosen table(s) have no field with a "
                                  "domain that holds a value (the input shows no rows, the domain "
                                  "fields are empty or NULL, the subtype of every row removes the "
                                  "field's domain, or the fields chosen have no domain), so the "
                                  "empty result says nothing about the data.")
        else:
            # Review R11-1, R14-2: values left out (range bounds that could not be compared, date
            # codes that could not be read, a NULL or unknown subtype code, a domain that does not
            # exist) are not counted as checked, and the line says so.
            collector.info("No domain violations found in {0} checked value(s).{1}".format(
                checked_total, "" if not skipped else
                " {0} other value(s) were not checked (see the warnings above).".format(skipped)))
        set_derived_output(parameters, "violation_count", str(len(violations)))
        flush_messages(collector)

    def _write_violations(self, out_path, violations, inputs, cut, collector=None):
        folder = is_folder_workspace(workspace_of(out_path))

        def fit(value):
            return cut_utf8_bytes(value, folder, cut)

        violations = [dict(v, table=fit(v["table"]), field=fit(v["field"]), domain=fit(v["domain"]),
                           value=fit(v["value"]), suggested=fit(v["suggested"]))
                      for v in violations]
        specs = [
            {"name": "SRC_TABLE", "type": "TEXT", "values": [v["table"] for v in violations]},
            # the toolkit's one ObjectID field rule (``arcio.oid_field_spec``)
            oid_output_field(out_path, [v["oid"] for v in violations], collector),
            {"name": "FIELD", "type": "TEXT", "values": [v["field"] for v in violations]},
            {"name": "SUBTYPE_CODE", "type": "LONG"},
            {"name": "DOMAIN", "type": "TEXT", "values": [v["domain"] for v in violations]},
            {"name": "VALUE", "type": "TEXT", "values": [v["value"] for v in violations]},
            {"name": "ISSUE", "type": "TEXT", "length": 24},
            {"name": "SUGGESTED", "type": "TEXT", "values": [v["suggested"] for v in violations]},
        ]
        path, names = create_table(out_path, specs, inputs=inputs)
        nulls = set()
        insert_rows(path, [names[s["name"]] for s in specs],
                    [(v["table"], oid_field_value(specs[1], v["oid"]), v["field"], v["subtype_code"], v["domain"],
                      v["value"], v["issue"], v["suggested"]) for v in violations],
                    null_fields=nulls)
        # RT8-Q-3: a dBASE table stores "no subtype" as 0, often a real subtype code.
        return folder_null_number_warning(path, specs, names, nulls, _DC_SUBTYPE_NOTE)

    def _write_domain_table(self, out_path, rows, inputs, cut):
        folder = is_folder_workspace(workspace_of(out_path))

        def fit(value):
            return cut_utf8_bytes(value, folder, cut)

        rows = [dict(r, domain=fit(r["domain"]), dataset=fit(r["dataset"]), field=fit(r["field"]),
                     code=fit(r["code"]), detail=fit(r["detail"]),
                     workspace=fit(r.get("workspace"))) for r in rows]
        specs = [
            {"name": "DOMAIN", "type": "TEXT", "values": [r["domain"] for r in rows]},
            {"name": "RECORD_TYPE", "type": "TEXT", "length": 8},
            {"name": "DATASET", "type": "TEXT", "values": [r["dataset"] for r in rows]},
            {"name": "FIELD", "type": "TEXT", "values": [r["field"] for r in rows]},
            {"name": "SUBTYPE_CODE", "type": "LONG"},
            {"name": "ISSUE", "type": "TEXT", "length": 24},
            {"name": "CODE", "type": "TEXT", "values": [r["code"] for r in rows]},
            {"name": "DETAIL", "type": "TEXT", "values": [r["detail"] for r in rows]},
            {"name": "WORKSPACE", "type": "TEXT", "values": [r["workspace"] for r in rows]},
        ]
        path, names = create_table(out_path, specs, inputs=inputs)
        nulls = set()
        insert_rows(path, [names[s["name"]] for s in specs],
                    [(r["domain"], r["record_type"], r["dataset"], r["field"], r["subtype_code"],
                      r["issue"], r["code"], r["detail"], r["workspace"]) for r in rows],
                    null_fields=nulls)
        return folder_null_number_warning(path, specs, names, nulls, _DC_SUBTYPE_NOTE)


def _conformance_report_gdb(path):
    """The file geodatabase folder (``...\\name.gdb``) that ``path`` lies inside, or None.

    Every folder of the path counts, at any depth and in any case, with either separator; the
    last part (the report file name itself) does not."""
    if not path or not str(path).strip():
        return None
    text = str(path).strip()
    parts = re.split(r"[\\/]+", text)
    for index, part in enumerate(parts[:-1]):
        if part.strip().casefold().endswith(".gdb"):
            pieces = [m for m in re.finditer(r"[\\/]+", text)]
            end = pieces[index].start() if index < len(pieces) else len(text)
            return text[:end]
    return None


def _conformance_report_gdb_message(path, gdb):
    return ("The report '{0}' is inside the file geodatabase '{1}'. A geodatabase folder holds "
            "only the geodatabase's own files: the report would be hidden in the Catalog pane "
            "and lost when the geodatabase is copied, compacted or deleted.".format(path, gdb))


# Windows calendar types (LOCALE_ICALENDARTYPE) that are Gregorian.
_CONFORMANCE_GREGORIAN = frozenset(["1", "2", "9", "10", "11", "12"])


def _conformance_locale_info(lctype):
    """``GetLocaleInfoEx`` of the user's default locale as text, ``None`` off Windows or on error."""
    try:
        import ctypes
        buf = ctypes.create_unicode_buffer(100)
        if not ctypes.windll.kernel32.GetLocaleInfoEx(None, lctype, buf, len(buf)):
            return None
        return buf.value
    except Exception:  # not Windows, or no such call
        return None


def _conformance_order_of_format(fmt):
    """``"MDY"``, ``"DMY"`` or ``"YMD"`` from a Windows short date format such as ``M/d/yyyy``;
    ``None`` when the format does not name a day, a month and a year."""
    seen = []
    for run in re.finditer(r"d+|M+|y+", str(fmt or "")):
        text = run.group(0)
        if text[0] == "d" and len(text) > 2:   # ddd / dddd: the name of the weekday, not the day
            continue
        letter = {"d": "D", "M": "M", "y": "Y"}[text[0]]
        if letter not in seen:
            seen.append(letter)
    order = "".join(seen)
    return order if order in ("MDY", "DMY", "YMD") else None


def _conformance_date_order():
    """``(order, format)``: the Windows short date order (review R10-1) in which ArcGIS Pro writes
    the codes of a Date domain as text, and the format text for messages. ``DOMAIN_DATE_NONE``
    when the calendar is not Gregorian or the format has a two-digit year, so such text is never
    guessed; ``(None, None)`` when it cannot be read (not Windows)."""
    fmt = _conformance_locale_info(0x1F)          # LOCALE_SSHORTDATE
    if not fmt:
        return None, None
    calendar = _conformance_locale_info(0x1009)   # LOCALE_ICALENDARTYPE
    if calendar is not None and calendar.strip() not in _CONFORMANCE_GREGORIAN:
        return DOMAIN_DATE_NONE, fmt
    if "yyyy" not in fmt:
        return DOMAIN_DATE_NONE, fmt
    return _conformance_order_of_format(fmt), fmt


def _conformance_order_note(order, fmt):
    if order == DOMAIN_DATE_NONE:
        return ("; the Windows short date format {0} has a two-digit year or a calendar that "
                "is not Gregorian, so such text is not read".format(fmt))
    if order is None:
        return "; the Windows short date format could not be read either"
    return "; the Windows short date format is {0}".format(fmt)


def _conformance_same_input(path, inputs):
    """True when ``path`` is the same layer or table text as one of ``inputs``."""
    key = normalize_catalog_path(path).casefold()
    return any(normalize_catalog_path(other).casefold() == key for other in inputs)


def _conformance_read_rows(inputs, names):
    """Rows of every input (layers on one source), each ObjectID once, in reading order."""
    rows, seen = [], set()
    for path in inputs:
        for row in read_features(path, names, geometry=False):
            if row["oid"] in seen:
                continue
            seen.add(row["oid"])
            rows.append(row)
    return rows


def _conformance_domains_of_field(fields, subtypes, name):
    """Every domain name that can apply to field ``name`` (field and subtype level)."""
    out = set()
    for f in fields:
        if f["name"] == name and f.get("domain"):
            out.add(f["domain"])
    for entry in ((subtypes or {}).get("subtypes") or {}).values():
        for fname, dom in (entry.get("domains") or {}).items():
            if dom and fname.casefold() == name.casefold():
                out.add(dom)
    return out


# ==========================================================================
# quality/normalised_keys_tool.py
# ==========================================================================
# Join Key Diagnostics: the ArcGIS Pro tool (adapter).

_KEYS_MODE_DUPLICATES = "DUPLICATES"
_KEYS_MODE_JOIN = "JOIN"
_KEYS_INTEGER_TYPES = ("SmallInteger", "Integer", "BigInteger", "Short", "Long")
# Largest value an existing integer field of each Field.type can hold (RT8-Q-4).
_KEYS_INTEGER_MAX = {"SmallInteger": 32767, "Short": 32767, "Integer": 2147483647,
                     "Long": 2147483647, "BigInteger": 2 ** 53}
# Review D3: a shapefile / dBASE copy stores null numbers as 0, cuts text to 254
# characters and drops the time of dates, so its group labels would not match.
_KEYS_FOLDER_COPY_MESSAGE = ("Output Features is a shapefile or dBASE table (in a folder). Such a "
                             "copy stores empty numbers as 0, cuts text to 254 characters and "
                             "drops the time of dates, so its DUP_GROUP labels could disagree "
                             "with the detail table.")
_KEYS_FOLDER_COPY_FIX = "Write Output Features to a geodatabase."
# In place on a shapefile / dBASE input the empty group fields are stored as 0.
_KEYS_IN_PLACE_NULL_NOTE = ("DUP_GROUP 0 means a unique key or a key with a null part; "
                            "DUP_COUNT 0 means a key with a null part.")


def _keys_folder_output(path):
    return bool(path) and is_folder_workspace(split_catalog_path(path)[0])


def _keys_trailing_space_note(path, columns):
    """Warning text, or ``None``, for key texts that end with a space and are written to a
    dBASE table or shapefile (``columns``: ``[(actual field name, values)]``).

    The whole point of the tool is to show keys that differ only by spaces, but a dBASE
    table keeps no trailing spaces (reported behaviour, not tested for this tool):
    two raw keys that differ only by a trailing space would look identical there."""
    if not _keys_folder_output(path):
        return None
    parts = []
    for name, values in columns:
        count = sum(1 for v in values if isinstance(v, str) and v != v.rstrip(u" "))
        if count:
            parts.append("{0} value(s) of {1}".format(count, name))
    if not parts:
        return None
    return ("{0} end with a space. A dBASE table keeps no trailing spaces, so in '{1}' they are "
            "stored without them and keys that differ only by a trailing space look identical. "
            "Write the Output Table to a file geodatabase (or read the report, which keeps "
            "them) to see them.".format(", ".join(parts), path))


# Control characters an Excel cell cannot hold (the shared XLSX writer drops them).
_KEYS_XLSX_CONTROL = frozenset(list(range(0, 9)) + [11, 12] + list(range(14, 32)))
# Most characters (UTF-16 units) an Excel cell can hold; the shared XLSX writer cuts longer
# text and ends it with a "[cut: ...]" marker: the tool also warns in its messages.
_KEYS_XLSX_CELL_MAX = 32767


def _keys_utf16_len(text):
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def _keys_xlsx_visible(value):
    """``value`` with every control character an XLSX cell cannot hold written as a
    visible ``<U+0001>`` escape, so ``A`` + U+0001 does not look like ``A``."""
    if not isinstance(value, str):
        return value
    return u"".join(u"<U+{0:04X}>".format(ord(c)) if ord(c) in _KEYS_XLSX_CONTROL else c
                    for c in value)


def _keys_has_surrogate(value):
    return any(0xD800 <= ord(c) <= 0xDFFF for c in value)


def _keys_surrogates_visible(value):
    """``value`` with every lone UTF-16 surrogate (U+D800-U+DFFF) written as a visible
    ``<U+D800>`` escape. The shared report writers turn such a character into U+FFFD
    (it cannot be written as UTF-8), so ``A`` + U+D800 would look exactly like ``A`` +
    U+FFFD in the report."""
    if not isinstance(value, str) or not _keys_has_surrogate(value):
        return value
    return u"".join(u"<U+{0:04X}>".format(ord(c)) if 0xD800 <= ord(c) <= 0xDFFF else c
                    for c in value)


def _keys_report_rows(report, detail, key_columns):
    """``(rows for the report, warning or None)``.

    The report writers protect the spreadsheet: an XLSX cell cannot hold control
    characters, and a CSV cell that starts with ``=``, ``@``, ``+``/``-``, tab or CR gets
    a leading ``'``. Both can make two different keys look the same in the report. In an
    XLSX report the key columns (``key_columns``: indexes) show such characters as
    ``<U+0001>``; in a CSV report the keys are written as they are (control characters
    included) and the ``'`` is still added. In both formats a lone UTF-16 surrogate, which
    the shared writers would turn into U+FFFD, is shown as ``<U+D800>``. The
    warning counts the affected key cells and says that the Output Table keeps the exact
    keys."""
    if report is None:
        return detail, None
    rows, changed, too_long, surrogates = [], 0, 0, 0
    xlsx = report["format"] == REPORT_FORMAT_XLSX
    for row in detail:
        row = list(row)
        for i in key_columns:
            value = row[i]
            if not isinstance(value, str):
                continue
            if _keys_has_surrogate(value):
                surrogates += 1
                value = row[i] = _keys_surrogates_visible(value)
            if xlsx:
                shown = _keys_xlsx_visible(value)
                if shown != value:
                    changed += 1
                    row[i] = shown
                if _keys_utf16_len(shown) > _KEYS_XLSX_CELL_MAX:
                    too_long += 1
            elif neutralize_formula(value) != value:
                changed += 1
        rows.append(row)
    notes = []
    if surrogates:
        notes.append("{0} key cell(s) contain a lone UTF-16 surrogate (U+D800-U+DFFF, half of a "
                     "character pair), which a report file cannot hold; the report shows each as "
                     "<U+D800> (its code point).".format(surrogates))
    if xlsx:
        if changed:
            notes.append("{0} key cell(s) in the report contain control characters, which an "
                         "Excel cell cannot hold; the report shows each as <U+0001> (its code "
                         "point).".format(changed))
        if too_long:
            notes.append("{0} key cell(s) are longer than {1:,} characters, the most an Excel "
                         "cell can hold; the report cuts them and ends them with a [cut: ...] note, "
                         "so long keys that differ only after the cut look the same there. Use a "
                         "CSV report to see them in full.".format(too_long, _KEYS_XLSX_CELL_MAX))
        if not notes:
            return rows, None
        return rows, " ".join(notes) + " The Output Table keeps the exact keys."
    if changed:
        notes.append("{0} key cell(s) in the CSV report start with =, @, +, -, a tab or a carriage "
                     "return; the report puts ' before them so a spreadsheet does not run them as "
                     "a formula, so a key '=1 and a key =1 can look the same there.".format(changed))
    if not notes:
        return rows, None
    return rows, " ".join(notes) + " The Output Table keeps the exact keys."


# Summary cell when no step is ticked (an empty cell read as "unknown").
_KEYS_NO_STEPS_SUMMARY = "none (Unicode NFC composition only)"

_KEYS_CASE_ONLY_NOTE = (
    "{0} WOULD_MATCH key(s) differ only by letter case (MATCH_AFTER = CASE). Esri's Add Join "
    "page says one-to-first joins are not case sensitive and one-to-many joins are, so such "
    "keys may already join in ArcGIS Pro (depending on the join type); they are listed here "
    "because a case-sensitive comparison, a one-to-many join, a relate or a database join "
    "would not match them.")


class NormalisedKeyDiagnostics(object):
    """Find duplicates after normalisation, or explain why join keys do not match."""

    DOC = {
        "summary": "Finds duplicate keys that only differ by spaces, case, Arabic-Indic digits, "
                   "leading zeros, number-vs-text type or Arabic letter forms, and lists which raw "
                   "values collapsed together. In JOIN mode it compares the keys of two tables and "
                   "states, for each key that does not match exactly, after which normalisation "
                   "steps it would match.",
        "usage": "Normalisation steps always run in the fixed order TRIM, CASE, DIGITS, "
                 "LEADING_ZEROS, TYPE, ARABIC_LETTERS, TA_MARBUTA, whatever order they are "
                 "ticked in. Text keys are always put in Unicode canonical composition (NFC) "
                 "before the steps and after each of them, so a decomposed spelling (as exported "
                 "on macOS or copied from a PDF) is the same key as the precomposed one. A null "
                 "in any key field never matches anything. With TRIM ticked the ends are "
                 "stripped again after every later step, and LEADING_ZEROS also runs again after "
                 "every later step. Selections and definition queries on input layers are "
                 "honoured.\n\n"
                 "The input is never changed unless Write group fields and Edit input in place "
                 "are both checked; then a backup copy is made first and all changes are written "
                 "in one edit session. In-place editing is refused for layers with joined tables, "
                 "a selection or a definition query. Without in-place editing, Write group fields "
                 "writes a geodatabase copy of the input (Output Features) with DUP_GROUP and "
                 "DUP_COUNT; a shapefile or dBASE copy is refused.\n\n"
                 "JOIN mode: MATCHED means identical characters, letter case included. Esri "
                 "states that one-to-first joins are not case sensitive (one-to-many joins are), "
                 "so a WOULD_MATCH whose MATCH_AFTER is only CASE may already join. MATCH_AFTER "
                 "names the steps that were needed, not every step that changed a key. RIGHT_KEY "
                 "is the right-hand key found at the earliest step in the fixed order; "
                 "RIGHT_COUNT counts every right-hand row whose key equals the left key "
                 "after all enabled steps.\n\n"
                 "Report: control characters show as <U+0001> in an Excel report and a lone "
                 "surrogate as <U+D800> in both formats; the run warns when a report cell differs "
                 "from the key, and the Output Table keeps the exact keys. Edge cases and limits "
                 "are listed on the tool page (docs/tools/NormalisedKeyDiagnostics.md).",
        "params": {
            "mode": "DUPLICATES: find duplicate keys in one table. JOIN: diagnose the keys of "
                    "the input against a join table.",
            "in_table": "Layer or table whose keys are checked (the left side in JOIN mode).",
            "key_fields": "One or more fields forming the key (a composite key when several).",
            "join_table": "JOIN mode: the layer or table to join to (the right side).",
            "join_key_fields": "JOIN mode: the key fields of the join table, in the same order "
                               "and number as Key Fields.",
            "normalisation": "Normalisation steps to apply. Default: TRIM, CASE, DIGITS, "
                             "LEADING_ZEROS, TYPE. ARABIC_LETTERS folds alef/yeh forms, "
                             "tashkeel and tatweel; TA_MARBUTA also folds teh marbuta to heh.",
            "write_groups": "DUPLICATES mode: write DUP_GROUP (empty for unique keys and for "
                            "keys with a null part; 0 instead when editing a shapefile or "
                            "dBASE input in place) and DUP_COUNT fields, to a geodatabase "
                            "copy (Output Features) or in place.",
            "in_place": "Write the group fields into the input itself (requires Write group "
                        "fields). A backup copy is made first; unchecked by default.",
            "out_features": "Copy of the input with DUP_GROUP and DUP_COUNT, when Write group "
                            "fields is checked and Edit input in place is not. Must be in a "
                            "geodatabase (a shapefile or dBASE copy is refused).",
            "out_table": "Detail table. DUPLICATES: DUP_GROUP, NORM_KEY, SRC_OID, RAW_KEY, "
                         "DUP_COUNT for every row in a group. JOIN: LEFT_KEY, LEFT_COUNT, STATUS, "
                         "RIGHT_KEY, RIGHT_COUNT, MATCH_AFTER per distinct key.",
            "out_report": "Optional Excel (.xlsx) or CSV report with Summary and Detail sheets.",
            "issue_count": "DUPLICATES: rows in duplicate groups. JOIN: keys that do not match "
                           "exactly (derived).",
        },
        "tags": ["duplicates", "join", "key", "normalise", "Arabic", "quality"],
    }

    def __init__(self):
        self.label = "Join Key Diagnostics"
        self.description = ("Finds keys that are duplicates after normalisation and explains why "
                            "join keys do not match (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("mode", "Mode", "GPString", default=_KEYS_MODE_DUPLICATES,
                       value_list=[_KEYS_MODE_DUPLICATES, _KEYS_MODE_JOIN]),
            make_param("in_table", "Input Table", ["GPFeatureLayer", "GPTableView"]),
            make_param("key_fields", "Key Fields", "Field", multi_value=True,
                       depends_on="in_table"),
            make_param("join_table", "Join Table", ["GPFeatureLayer", "GPTableView"],
                       required=False, enabled=False),
            make_param("join_key_fields", "Join Key Fields", "Field", required=False,
                       multi_value=True, depends_on="join_table", enabled=False),
            make_param("normalisation", "Normalisation", "GPString", required=False,
                       multi_value=True, value_list=list(KEY_STEPS),
                       default=list(DEFAULT_KEY_STEPS)),
            make_param("write_groups", "Write group fields", "GPBoolean", required=False,
                       default=False),
            make_param("in_place", "Edit input in place", "GPBoolean", required=False,
                       default=False, category="Edit input"),
            make_param("out_features", "Output Features", ["DEFeatureClass", "DETable"],
                       direction="Output", required=False),
            make_param("out_table", "Output Table", "DETable", direction="Output"),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("issue_count", "Issue Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        p = param_map(parameters)
        join = (param_text(p["mode"]) or _KEYS_MODE_DUPLICATES) == _KEYS_MODE_JOIN
        p["join_table"].enabled = join
        p["join_key_fields"].enabled = join
        p["write_groups"].enabled = not join
        groups = not join and param_bool(p["write_groups"])
        # A checked Edit input in place stays enabled after Write group fields is unchecked, so
        # the user can untick it where updateMessages puts the error (RT-R9 UX note).
        p["in_place"].enabled = groups or (not join and param_bool(p["in_place"]))
        p["out_features"].enabled = groups and not param_bool(p["in_place"])
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        join = (param_text(p["mode"]) or _KEYS_MODE_DUPLICATES) == _KEYS_MODE_JOIN
        if join:
            if not param_text(p["join_table"]):
                p["join_table"].setIDMessage("ERROR", 735)
            elif not param_list(p["join_key_fields"]):
                p["join_key_fields"].setIDMessage("ERROR", 735)
            elif param_list(p["key_fields"]) and \
                    len(param_list(p["join_key_fields"])) != len(param_list(p["key_fields"])):
                p["join_key_fields"].setErrorMessage(
                    "Choose as many join key fields as key fields ({0}), in the same order.".format(
                        len(param_list(p["key_fields"]))))
        else:
            write = param_bool(p["write_groups"])
            if param_bool(p["in_place"]) and not write:
                p["in_place"].setErrorMessage("Edit input in place requires Write group fields. "
                                              "Check Write group fields, or uncheck Edit input "
                                              "in place.")
            elif write and not param_bool(p["in_place"]) and not param_text(p["out_features"]):
                p["out_features"].setErrorMessage(
                    "Choose Output Features for the copy with group fields, or check Edit input "
                    "in place.")
            elif write and not param_bool(p["in_place"]) and find_duplicate_outputs(
                    [param_text(p["out_table"]), param_text(p["out_features"])]):
                p["out_features"].setErrorMessage(
                    "Output Features must be a different dataset from the Output Table.")
            elif write and not param_bool(p["in_place"]) and \
                    _keys_folder_output(param_text(p["out_features"])):
                p["out_features"].setErrorMessage(
                    _KEYS_FOLDER_COPY_MESSAGE + " " + _KEYS_FOLDER_COPY_FIX)
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))

    # ------------------------------------------------------------------

    def _key_fields(self, desc, wanted, label, collector):
        names = []
        for name in wanted:
            field, how = match_field(desc["fields"], name, label=label, exact_name_first=True)
            collector.info(match_message(name, field, how))
            names.append(field["name"])
        if not names:
            raise ToolError("No {0} was chosen.".format(label), "Choose at least one key field.")
        return names

    def _read_keys(self, desc, names):
        """``[(oid, key tuple)]``; FLOAT (single) values become their shortest decimal."""
        single = set(f["name"] for f in desc["fields"] if is_single_field(f))
        rows = read_features(desc["input"], names, geometry=False)
        return [(r["oid"], tuple(float32_shortest(r["attrs"][n]) if n in single
                                 else r["attrs"][n] for n in names)) for r in rows]

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        mode = (param_text(p["mode"]) or _KEYS_MODE_DUPLICATES).upper()
        try:
            steps = ordered_steps(param_list(p["normalisation"]))
        except ValueError as exc:
            raise ToolError("Unknown normalisation step: {0}.".format(exc),
                            "Choose steps from the list: {0}.".format(", ".join(KEY_STEPS)))
        collector.info("Normalisation steps (fixed order): {0}.".format(
            ", ".join(steps) if steps else "none; only the Unicode NFC composition of text is applied"))
        desc = describe_dataset(param_text(p["in_table"]))
        keys = self._key_fields(desc, param_list(p["key_fields"]), "key field", collector)
        if mode == _KEYS_MODE_JOIN:
            self._run_join(parameters, p, collector, report, desc, keys, steps)
        else:
            self._run_duplicates(parameters, p, collector, report, desc, keys, steps)
        flush_messages(collector)

    def _run_duplicates(self, parameters, p, collector, report, desc, keys, steps):
        write = param_bool(p["write_groups"])
        in_place = write and param_bool(p["in_place"])
        out_features = param_text(p["out_features"]) if write and not in_place else None
        if write and not in_place and not out_features:
            raise ToolError("Write group fields is checked but no Output Features was given.",
                            "Choose Output Features or check Edit input in place.")
        clash = [k for k in keys if k.casefold() in ("dup_group", "dup_count")] if write else []
        if clash:  # RT-R4 N2: the group fields would overwrite the key they were computed from
            raise ToolError("The key field {0} is also a field this tool writes (DUP_GROUP / "
                            "DUP_COUNT); writing group fields would overwrite the key values. "
                            "Nothing was written.".format(", ".join(clash)),
                            "Copy the key to a field with another name and use that as the key, "
                            "or uncheck Write group fields.")
        if in_place and any("." in f["name"] for f in desc["fields"]):
            raise ToolError("The input appears to have a joined table (qualified field names), "
                            "which cannot be edited in place.",
                            "Remove the join, or write the group fields to a copy instead.")
        if out_features and any("." in f["name"] for f in desc["fields"]):
            # R10 note: a copy of a joined layer renames t.PID to t_PID, so the key fields could
            # not be found in the copy after the Output Table had been written.
            raise ToolError("The input appears to have a joined table (qualified field names); "
                            "a copy of it renames the joined fields, so the group fields cannot "
                            "be written to Output Features. Nothing was written.",
                            "Remove the join, or first export the joined layer to a geodatabase "
                            "and run the tool on that export.")
        if out_features:
            refuse_duplicate_outputs([param_text(p["out_table"]), out_features])
            if _keys_folder_output(out_features):
                raise ToolError(_KEYS_FOLDER_COPY_MESSAGE + " Nothing was written.",
                                _KEYS_FOLDER_COPY_FIX)
            check_output_path(out_features, [desc["catalog_path"]])
        if in_place:
            visible = len(read_features(desc["input"], [], geometry=False))
            if visible != len(read_features(desc["catalog_path"], [], geometry=False)):
                raise ToolError(
                    "The input layer has a selection or definition query; group fields written "
                    "in place would leave stale group numbers in the other rows.",
                    "Clear the selection and definition query, or write the group fields to a "
                    "copy (Output Features) instead.")
        if write:  # refuse non-integer DUP_GROUP/DUP_COUNT before anything is written
            self._group_specs(dict((f["name"].casefold(), f) for f in desc["fields"]))
        rows = self._read_keys(desc, keys)
        progress = Progress("Grouping keys", len(rows))
        groups, nulls = find_duplicate_groups(rows, steps)
        progress.tick(len(rows))
        progress.close()
        if write:  # RT8-Q-4: values must fit existing fields; checked before any output
            self._check_group_ranges(dict((f["name"].casefold(), f) for f in desc["fields"]),
                                     groups)
        detail = duplicate_detail_rows(groups)
        out_table = param_text(p["out_table"])
        inputs = [desc["catalog_path"]]
        oid_spec = oid_output_field(out_table, [d[2] for d in detail], collector)
        stored = [tuple(d[:2]) + (oid_field_value(oid_spec, d[2]),) + tuple(d[3:]) for d in detail]
        specs = [{"name": "DUP_GROUP", "type": "LONG"},
                 {"name": "NORM_KEY", "type": "TEXT", "values": [d[1] for d in detail]},
                 oid_spec,
                 {"name": "RAW_KEY", "type": "TEXT", "values": [d[3] for d in detail]},
                 {"name": "DUP_COUNT", "type": "LONG"}]
        path, names = create_table(out_table, specs, inputs=inputs)
        insert_rows(path, [names[s["name"]] for s in specs], stored)
        note = _keys_trailing_space_note(path, [(names["NORM_KEY"], [d[1] for d in detail]),
                                                (names["RAW_KEY"], [d[3] for d in detail])])
        if note:
            collector.warning(note)
        if nulls:
            collector.info("{0} row(s) have a null key part and are never grouped.".format(
                len(nulls)))
        blank = [g for g in groups if all(isinstance(part, str) and part == u""
                                          for part in g["norm_key"])]
        if blank:
            collector.info("{0} duplicate group(s) ({1} row(s)) have an empty key after "
                           "normalisation (blank text, e.g. spaces only): they are grouped "
                           "like any other key. Fill or clear those keys if empty is not a "
                           "real value.".format(len(blank), sum(len(g["members"]) for g in blank)))
        in_groups = len(detail)
        collector.info("{0} row(s) read; {1} duplicate group(s) covering {2} row(s).".format(
            len(rows), len(groups), in_groups))
        if in_place:
            self._write_in_place(desc, groups, rows, collector, [path])
        elif out_features:
            self._write_copy(desc, keys, groups, steps, out_features, inputs, collector)
        summary = [("Mode", _KEYS_MODE_DUPLICATES), ("Normalisation", "; ".join(steps) or _KEYS_NO_STEPS_SUMMARY),
                   ("Rows read", len(rows)), ("Rows with a null key part", len(nulls)),
                   ("Duplicate groups", len(groups)), ("Rows in duplicate groups", in_groups)]
        report_rows, report_note = _keys_report_rows(report, detail, (1, 3))
        for written in write_report(report, summary,
                                    ["DUP_GROUP", "NORM_KEY", "SRC_OID", "RAW_KEY", "DUP_COUNT"],
                                    report_rows):
            collector.info("Report written to {0}.".format(written))
        if report_note:
            collector.warning(report_note)
        if groups:
            collector.warning("{0} duplicate group(s) found; see {1}.".format(len(groups), path))
        set_derived_output(parameters, "issue_count", str(in_groups))

    def _group_specs(self, existing):
        """AddField specs for DUP_GROUP / DUP_COUNT that do not exist yet."""
        specs = []
        for name in ("DUP_GROUP", "DUP_COUNT"):
            field = existing.get(name.casefold())
            if field is None:
                specs.append({"name": name, "type": "LONG"})
            elif field["type"] not in _KEYS_INTEGER_TYPES:
                raise ToolError("The input already has a field {0} of type {1}.".format(
                    field["name"], field["type"]),
                    "Rename or delete that field, or write the group fields to a copy.")
        return specs

    def _check_group_ranges(self, existing, groups):
        """Refuse when the largest group number or count does not fit an existing
        DUP_GROUP / DUP_COUNT field (e.g. SHORT: 32,767), before anything is written."""
        largest = {"DUP_GROUP": max([g["group"] for g in groups] or [0]),
                   "DUP_COUNT": max([len(g["members"]) for g in groups] or [0])}
        for name in ("DUP_GROUP", "DUP_COUNT"):
            field = existing.get(name.casefold())
            limit = _KEYS_INTEGER_MAX.get(field["type"]) if field else None
            if limit is not None and largest[name] > limit:
                raise ToolError(
                    "The existing field {0} ({1}) can hold values up to {2:,}, but this run "
                    "needs {3:,} ({4}). Nothing was written.".format(
                        field["name"], field["type"], limit, largest[name],
                        "the largest duplicate group" if name == "DUP_COUNT"
                        else "the number of duplicate groups"),
                    "Delete the field {0} or replace it with a LONG field, then run the tool "
                    "again.".format(field["name"]))

    def _write_in_place(self, desc, groups, rows, collector, outputs=()):
        existing = dict((f["name"].casefold(), f) for f in desc["fields"])
        specs = self._group_specs(existing)
        # stop before any edit if this fails; never take the name of an output
        backup = backup_copy(desc["catalog_path"], outputs)
        collector.info("Backup copy written to {0}.".format(backup))
        names = dict((s, existing[s.casefold()]["name"]) for s in ("DUP_GROUP", "DUP_COUNT")
                     if s.casefold() in existing)
        if specs:
            names.update(add_fields(desc["catalog_path"], specs, desc["workspace"]))
        assigned = group_assignment(groups)
        changes = {}
        for oid, key in rows:
            group, count = assigned.get(oid, (None, None if None in key else 1))
            changes[oid] = {names["DUP_GROUP"]: group, names["DUP_COUNT"]: count}
        null_fields = set()
        if is_folder_workspace(desc["workspace"]):
            # A shapefile / dBASE number field cannot hold NULL and ArcGIS Pro refuses None
            # there ("The field is not nullable", Pro session 1, S3): write the 0 the usage
            # text promises, and remember the fields so the warning below names them.
            for change in changes.values():
                for name in list(change):
                    if change[name] is None:
                        null_fields.add(name)
                        change[name] = 0
        with edit_session(desc["workspace"]):
            changed = update_rows(desc["input"], [names["DUP_GROUP"], names["DUP_COUNT"]],
                                  changes, null_fields=null_fields)
        collector.info("Updated {0} row(s) in place.".format(changed))
        note = folder_null_number_warning(
            desc["catalog_path"], [{"name": names["DUP_GROUP"], "type": "LONG"},
                                   {"name": names["DUP_COUNT"], "type": "LONG"}],
            {}, null_fields, note=_KEYS_IN_PLACE_NULL_NOTE)
        if note:
            collector.warning(note)

    def _write_copy(self, desc, keys, groups, steps, out_path, inputs, collector):
        # The copy has the input's fields: integer DUP_GROUP/DUP_COUNT fields it already has
        # (e.g. from an earlier run) are reused, like in place; only missing ones are added.
        existing = dict((f["name"].casefold(), f) for f in desc["fields"])
        path, names = copy_for_output(desc["input"], out_path, self._group_specs(existing),
                                      inputs=inputs)
        for name in ("DUP_GROUP", "DUP_COUNT"):
            if name not in names:
                names[name] = existing[name.casefold()]["name"]
        copy_desc = describe_dataset(path)
        copy_keys = [match_field(copy_desc["fields"], k, label="key field",
                                 exact_name_first=True)[0]["name"]
                     for k in keys]
        lookup = group_lookup(groups, steps)
        changes = {}
        for oid, key in self._read_keys(copy_desc, copy_keys):
            group, count = group_for_key(lookup, key, steps)
            changes[oid] = {names["DUP_GROUP"]: group, names["DUP_COUNT"]: count}
        update_rows(path, [names["DUP_GROUP"], names["DUP_COUNT"]], changes)
        collector.info("Copy with group fields written to {0}.".format(path))

    def _run_join(self, parameters, p, collector, report, desc, keys, steps):
        jdesc = describe_dataset(param_text(p["join_table"]))
        jkeys = self._key_fields(jdesc, param_list(p["join_key_fields"]), "join key field",
                                 collector)
        if len(jkeys) != len(keys):
            raise ToolError("{0} key field(s) but {1} join key field(s) were given.".format(
                len(keys), len(jkeys)), "Choose the same number of fields on both sides.")
        left = [k for _oid, k in self._read_keys(desc, keys)]
        right = [k for _oid, k in self._read_keys(jdesc, jkeys)]
        rows = diagnose_join(left, right, steps)
        detail = [(key_text(r["left_key"]), r["left_count"], r["status"], key_text(r["right_key"]),
                   r["right_count"], r["match_after"]) for r in rows]
        specs = [{"name": "LEFT_KEY", "type": "TEXT", "values": [d[0] for d in detail]},
                 {"name": "LEFT_COUNT", "type": "LONG"},
                 {"name": "STATUS", "type": "TEXT", "length": 16},
                 {"name": "RIGHT_KEY", "type": "TEXT", "values": [d[3] for d in detail]},
                 {"name": "RIGHT_COUNT", "type": "LONG"},
                 {"name": "MATCH_AFTER", "type": "TEXT", "values": [d[5] for d in detail]}]
        path, names = create_table(param_text(p["out_table"]), specs,
                                   inputs=[desc["catalog_path"], jdesc["catalog_path"]])
        insert_rows(path, [names[s["name"]] for s in specs], detail)
        note = _keys_trailing_space_note(path, [(names["LEFT_KEY"], [d[0] for d in detail]),
                                                (names["RIGHT_KEY"], [d[3] for d in detail])])
        if note:
            collector.warning(note)
        counts = join_status_counts(rows)
        not_exact = sum(c for s, c in counts if s not in ("MATCHED", "ONE_TO_MANY"))
        collector.info("Keys: " + ", ".join("{0} {1}".format(c, s) for s, c in counts) + ".")
        would = dict(counts)["WOULD_MATCH"]
        if would:
            collector.warning("{0} key(s) only match after normalisation; see MATCH_AFTER in "
                              "{1}.".format(would, path))
        positions, gain = type_step_gain(left, right, steps, rows)
        if positions:  # R10-2: LONG 1 and TEXT "1" print the same but never match without TYPE
            types = dict((f["name"], f["type"]) for f in desc["fields"])
            jtypes = dict((f["name"], f["type"]) for f in jdesc["fields"])
            pairs = ", ".join("{0} ({1}) and {2} ({3})".format(keys[i], types.get(keys[i]),
                                                             jkeys[i], jtypes.get(jkeys[i]))
                              for i in positions)
            if gain:
                advice = ("With TYPE ticked, {0} UNMATCHED_LEFT key(s) of this run would match. "
                          "Tick TYPE to compare numbers as text.".format(gain))
            else:  # R12 minor note: no advice to tick TYPE when it would match nothing
                advice = ("With TYPE ticked, no UNMATCHED_LEFT key of this run would match either, "
                          "so ticking TYPE would not change this result.")
            collector.warning(
                "Key field(s) {0}: one side holds numbers and the other text. TYPE is not ticked, "
                "so a number never matches a text, even when both print the same (the number 1 "
                "and the text 1 both show as 1 in LEFT_KEY and RIGHT_KEY). {1}".format(pairs, advice))
        case_only = sum(1 for r in rows if r["status"] == "WOULD_MATCH" and
                        r["match_after"] == "CASE")
        if case_only:
            collector.info(_KEYS_CASE_ONLY_NOTE.format(case_only))
        summary = [("Mode", _KEYS_MODE_JOIN), ("Normalisation", "; ".join(steps) or _KEYS_NO_STEPS_SUMMARY),
                   ("Left rows", len(left)), ("Right rows", len(right))] + list(counts) + \
            [("WOULD_MATCH after CASE only", case_only)]
        report_rows, report_note = _keys_report_rows(report, detail, (0, 3))
        for written in write_report(report, summary,
                                    ["LEFT_KEY", "LEFT_COUNT", "STATUS", "RIGHT_KEY",
                                     "RIGHT_COUNT", "MATCH_AFTER"], report_rows):
            collector.info("Report written to {0}.".format(written))
        if report_note:
            collector.warning(report_note)
        set_derived_output(parameters, "issue_count", str(not_exact))


# ==========================================================================
# quality/geometry_quality_tool.py
# ==========================================================================
# Geometry Quality Checker: the ArcGIS Pro tool (adapter).

_GQ_SHORT_SEGMENT_OFF = ("Minimum segment length is not larger than the near-duplicate tolerance, "
                         "so no SHORT_SEGMENT can be found (shorter segments are NEAR_DUP_VERTEX). "
                         "Give a minimum segment length larger than the tolerance.")
_GQ_NUMBER_PARAMS = ("min_angle_deg", "max_tip_width_m", "near_dup_tol_m", "min_segment_m",
                     "max_thinness",
                     "min_area_m2", "min_part_share_pct", "max_part_distance_m")


class GeometryQualityChecker(object):
    """Find spikes, near-duplicate vertices, short segments, slivers and stray parts."""

    DOC = {
        "summary": "Finds geometry problems that Check Geometry does not report, or reports only "
                   "at its own fixed limit: spikes (sharp vertex angles), near-duplicate vertices, "
                   "short segments (at a length you set), sliver polygons, "
                   "tiny polygons, tiny parts of multipart polygons and parts far from the main "
                   "part. Writes one error point per problem at the offending vertex, segment "
                   "or part. Read-only, so it also works on versioned data.",
        "usage": "Lengths, areas and distances are measured in metres in a projected system "
                 "chosen from the data: the input system when it is projected (except Web "
                 "Mercator, which distorts distances, and polar stereographic), otherwise the "
                 "UTM zone of the data's centre. Geographic "
                 "or Web Mercator data spanning more than 3 UTM zones is read in degrees and "
                 "each feature is measured on its own Transverse Mercator projection centred "
                 "on the feature (WGS 84 ellipsoid). Polar data (centre beyond 84N or 80S, or "
                 "input in a polar stereographic system such as EPSG 3031) is also measured "
                 "feature by feature, features beyond 84N / 80S each on a polar stereographic "
                 "projection with true scale at the feature. With an unknown coordinate system the "
                 "data's own units are used and a warning is given. The error points are "
                 "written in the input coordinate system, through the same projection, so "
                 "an input on a datum other than WGS 84 is not offset (an information "
                 "message notes that no datum transformation is applied).\n\nVertex numbers are 0-based within each ring or path; part numbers "
                 "are 1-based (holes belong to their part). Area and part checks have an empty VERTEX "
                 "(TINY_AREA also an empty PART); a shapefile output stores these as 0, and a "
                 "warning says so (write to a geodatabase to keep them empty). Exact duplicate vertices (0 m) are "
                 "left to Check Geometry.\n\nFeatures with true curves are skipped and listed "
                 "(densifying them would create artificial vertices). Null geometries are "
                 "counted and listed.\n\nThe default thinness 0.1 flags any part more "
                 "elongated than about 30:1 (a 30 x 1 rectangle has 0.098): road, river, strip "
                 "or right-of-way polygons will be reported as SLIVER in bulk, so lower Maximum "
                 "thinness for such layers. SHORT_SEGMENT needs a Minimum segment length larger "
                 "than the near-duplicate tolerance (a warning says so otherwise). For geographic "
                 "input, areas and part distances are computed from the projected vertices; long "
                 "edges are not densified for these measures (an approximation for edges of "
                 "many kilometres).\n\nSelections and definition queries on the input layer "
                 "are honoured. The tool never edits data.\n\nSHORT_SEGMENT, TINY_AREA and "
                 "REMOTE_PART are off by default (their threshold is 0): a message at the "
                 "start of every run lists the checks that ran and the ones that did not. "
                 "SPIKE tests the vertex angle, so a legitimate sharp corner is reported "
                 "too; a spike whose tip has two vertices (a blunt tip) has two vertex angles "
                 "near 90 degrees and is only found when Maximum spike tip width is above 0. "
                 "On an open line the end vertices have no angle; a line whose first and last "
                 "vertex are the same (4 or more vertices) is a closed loop, so its start vertex "
                 "has an angle and can be a SPIKE. One fault can raise more than one check: a "
                 "near-duplicate vertex that steps backwards is a NEAR_DUP_VERTEX and also gives "
                 "SPIKE angles at the cutback. "
                 "The checks assume valid geometry (ring order, closed rings): run Check "
                 "Geometry first on data from other software. A feature with NaN or infinite coordinates is skipped and listed.",
        "params": {
            "in_features": "Line or polygon features to check.",
            "checks": "Checks to run. Default: all. Area and part checks apply to polygons "
                      "only.",
            "min_angle_deg": "SPIKE: vertices where the two segments meet at less than this "
                             "angle (degrees; 180 = straight).",
            "max_tip_width_m": "SPIKE, blunt tips: a segment of at most this many metres is "
                               "treated as the tip of a spike; its two vertices are replaced by "
                               "the tip middle and the angle there is tested against Minimum "
                               "angle. 0 = off (only single-vertex spikes are found). The narrow "
                               "end of a long thin strip counts as a blunt spike too.",
            "near_dup_tol_m": "NEAR_DUP_VERTEX: consecutive vertices closer than or equal to "
                              "this many metres (but not identical).",
            "min_segment_m": "SHORT_SEGMENT: segments longer than the near-duplicate tolerance "
                             "but shorter than this many metres. 0 = off. Must be larger than "
                             "the tolerance to find anything.",
            "max_thinness": "SLIVER: polygon parts whose thinness 4*pi*Area/Perimeter^2 is "
                            "below this value (1 = circle, about 0.785 = square). Each part of "
                            "a multipart polygon (with its holes) is measured on its own. The "
                            "default 0.1 flags parts more elongated than about 30:1. A value of "
                            "1 or more flags every part (no polygon reaches 1); a warning says so.",
            "min_area_m2": "TINY_AREA: polygons smaller than this many square metres. 0 = off.",
            "min_part_share_pct": "TINY_PART: parts of a multipart polygon holding less than "
                                  "this percentage of its area.",
            "max_part_distance_m": "REMOTE_PART: parts further than this many metres from the "
                                   "largest part. 0 = off.",
            "out_features": "Output point feature class: SRC_OID, CHECK, PART, VERTEX, VALUE, "
                            "UNIT, DETAIL.",
            "out_report": "Optional Excel (.xlsx) or CSV report with Summary and Detail sheets.",
            "issue_count": "Number of problems found (derived).",
        },
        "tags": ["geometry", "spike", "sliver", "multipart", "validation", "quality"],
    }

    def __init__(self):
        self.label = "Geometry Quality Checker"
        self.description = ("Finds spikes, near-duplicate vertices, short segments, slivers, tiny "
                            "areas and stray parts, with error points (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        d = DEFAULT_GEOMETRY_OPTIONS
        return [
            make_param("in_features", "Input Features", "GPFeatureLayer",
                       value_list=["Polyline", "Polygon"]),
            make_param("checks", "Checks", "GPString", required=False, multi_value=True,
                       value_list=list(GEOMETRY_CHECKS), default=list(GEOMETRY_CHECKS)),
            make_param("min_angle_deg", "Minimum angle (degrees)", "GPDouble", required=False,
                       default=d["min_angle_deg"]),
            make_param("max_tip_width_m", "Maximum spike tip width (m)", "GPDouble",
                       required=False, default=d["max_tip_width_m"]),
            make_param("near_dup_tol_m", "Near-duplicate tolerance (m)", "GPDouble",
                       required=False, default=d["near_dup_tol_m"]),
            make_param("min_segment_m", "Minimum segment length (m)", "GPDouble",
                       required=False, default=d["min_segment_m"]),
            make_param("max_thinness", "Maximum sliver thinness", "GPDouble", required=False,
                       default=d["max_thinness"]),
            make_param("min_area_m2", "Minimum area (m2)", "GPDouble", required=False,
                       default=d["min_area_m2"]),
            make_param("min_part_share_pct", "Minimum part share (%)", "GPDouble",
                       required=False, default=d["min_part_share_pct"]),
            make_param("max_part_distance_m", "Maximum part distance (m)", "GPDouble",
                       required=False, default=d["max_part_distance_m"]),
            make_param("out_features", "Output Error Points", "DEFeatureClass",
                       direction="Output"),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("issue_count", "Issue Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        for name in _GQ_NUMBER_PARAMS:
            value = p[name].value
            if value is not None and float(value) < 0:
                p[name].setErrorMessage("The value must be zero or more.")
        angle = p["min_angle_deg"].value
        if angle is not None and float(angle) > 180:
            p["min_angle_deg"].setErrorMessage("The angle must be between 0 and 180 degrees.")
        share = p["min_part_share_pct"].value
        if share is not None and float(share) > 100:
            p["min_part_share_pct"].setErrorMessage("The share must be between 0 and 100 %.")
        seg, tol = p["min_segment_m"].value, p["near_dup_tol_m"].value
        if tol is None:
            tol = DEFAULT_GEOMETRY_OPTIONS["near_dup_tol_m"]
        # R9-T3: the same rule as the run-time warning (``_gq_short_segment_off``), so the
        # dialog does not warn about SHORT_SEGMENT when that check is not selected.
        if seg is not None and _gq_short_segment_off(_gq_selected_checks(p["checks"]), float(seg),
                                                     float(tol)) \
                and not p["min_segment_m"].hasError() and not p["near_dup_tol_m"].hasError():
            p["min_segment_m"].setWarningMessage(_GQ_SHORT_SEGMENT_OFF)
        # R11-M2: a thinness of 1 or more flags every polygon part (same rule as the run).
        thin = p["max_thinness"].value
        if thin is not None and not p["max_thinness"].hasError() and \
                thinness_flags_everything(_gq_selected_checks(p["checks"]), float(thin)):
            p["max_thinness"].setWarningMessage(THINNESS_FLAGS_ALL_TEXT)
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))

    def _options(self, p):
        checks = param_list(p["checks"]) or list(GEOMETRY_CHECKS)
        unknown = [c for c in checks if c.upper() not in GEOMETRY_CHECKS]
        if unknown:
            raise ToolError("Unknown check(s): {0}.".format(", ".join(unknown)),
                            "Choose checks from the list: {0}.".format(", ".join(GEOMETRY_CHECKS)))
        values = dict((name, param_number(p[name])) for name in _GQ_NUMBER_PARAMS)
        return geometry_options(checks=[c.upper() for c in checks], **values)

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        opts = self._options(p)
        if _gq_short_segment_off(opts["checks"], opts["min_segment_m"], opts["near_dup_tol_m"]):
            collector.warning(_GQ_SHORT_SEGMENT_OFF)
        desc = describe_dataset(param_text(p["in_features"]))
        kind = kind_from_shape_type(desc["shape_type"])
        if kind not in (GEOM_POLYLINE, GEOM_POLYGON):
            raise ToolError("The input must contain lines or polygons.",
                            "Choose a line or polygon layer.")
        for note in unused_check_notes(kind, opts):
            collector.warning(note)
        if kind == GEOM_POLYGON and thinness_flags_everything(opts["checks"], opts["max_thinness"]):
            collector.warning(THINNESS_FLAGS_ALL_TEXT)      # R11-M2 (SLIVER is polygon-only)
        collector.info(checks_run_summary(kind, opts))

        def measuring_sr(described):
            try:
                return metric_sr_for(described)
            except ToolError:
                # No usable coordinates (empty input, empty selection, only null shapes):
                # nothing to measure, which is not a failure. Anything else is re-raised.
                if any(r["shape"] is not None
                       for r in read_features_skip_curves(described["input"])[0]):
                    raise
                return {"wkid": described["sr"]["wkid"] if described["sr"] else None,
                        "meters_per_unit": 1.0, "reproject": False, "warnings": [],
                        "reason": "The input has no geometry to measure."}, None

        # Error points go back through the same projection, so a datum shift cannot
        # offset them: the datum note is information, not a warning (rule 10).
        plan = choose_measuring(desc, measuring_sr, collector, "input",
                                geographic_sr=arcpy.SpatialReference, datum_as_info=True)
        read_sr = None if plan["read_sr"] is desc["sr_object"] else plan["read_sr"]
        rows, skipped = read_features_skip_curves(desc["input"], sr=read_sr)
        # R11-M1: NaN / infinite coordinates are found on the rows AS READ. A per-feature
        # projection (below) can turn an infinite latitude into finite garbage, which would
        # then be checked and reported as a huge SLIVER instead of being skipped and listed.
        bad = set(r["oid"] for r in rows
                  if r["shape"] is not None and has_nonfinite_coordinate(r["shape"]))
        frames = None
        if plan["local"]:  # wide geographic data: each feature on its own projection
            projected, frames = local_tm_rows([r for r in rows if r["oid"] not in bad], collector)
            projected = iter(projected)
            rows = [r if r["oid"] in bad else next(projected) for r in rows]
        progress = Progress("Checking geometry", len(rows))
        issues, nulls, nonfinite = [], [], []
        for row in rows:
            if row["oid"] in bad or (row["shape"] is not None and
                                     has_nonfinite_coordinate(row["shape"])):  # R3-F7
                nonfinite.append(row["oid"])
            elif row["shape"] is None:
                nulls.append(row["oid"])
            else:
                found = check_geometry(row["oid"], kind, row["shape"], opts, plan["mpu"])
                if frames is not None:  # error points back to the degrees read
                    for issue in found:
                        issue["point"] = local_tm_point_back(issue["point"],
                                                             frames.get(row["oid"]))
                issues.extend(found)
            progress.tick()
        progress.close()
        issues.sort(key=lambda i: (i["oid"], GEOMETRY_CHECKS.index(i["check"]), i["part"] or 0,
                                   i["vertex"] if i["vertex"] is not None else -1))

        # SRC_OID: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``)
        oid_spec = oid_output_field(param_text(p["out_features"]), [i["oid"] for i in issues],
                                    collector)
        specs = [oid_spec,
                 {"name": "CHECK", "type": "TEXT", "length": 20},
                 {"name": "PART", "type": "LONG"},
                 {"name": "VERTEX", "type": "LONG"},
                 {"name": "VALUE", "type": "DOUBLE"},
                 {"name": "UNIT", "type": "TEXT", "length": 8},
                 {"name": "DETAIL", "type": "TEXT", "values": [i["detail"] for i in issues]}]
        path, names = create_feature_class(param_text(p["out_features"]), GEOM_POINT,
                                           desc["sr_object"], specs,
                                           inputs=[desc["catalog_path"]])
        for spec in specs:      # HQ-3: e.g. a GeoPackage may not accept CHECK (an SQL keyword)
            if names[spec["name"]] != spec["name"]:
                collector.info("Field {0} is called {1} in this output (the output format "
                               "does not accept that name).".format(spec["name"],
                                                                    names[spec["name"]]))
        # Points are in the system read (measuring system, or the degrees read for
        # per-feature measuring); the insert cursor projects them into the output's
        # (= the input's) coordinate system.
        empty = set()
        insert_rows(path, [names[s["name"]] for s in specs],
                    [(i["point"], (oid_field_value(oid_spec, i["oid"]), i["check"], i["part"], i["vertex"], i["value"],
                                   i["unit"], i["detail"])) for i in issues],
                    kind=GEOM_POINT, wkid=plan["wkid"], null_fields=empty)
        # RT8-Q-3: a shapefile stores "no vertex" / "no part" as 0, and vertex 0 is real.
        note = folder_null_number_warning(
            path, specs, names, empty,
            "Area and part checks (SLIVER, TINY_AREA, TINY_PART, REMOTE_PART) have no vertex "
            "(and TINY_AREA no part): their VERTEX 0 (PART 0) means 'none', not vertex 0.")
        if note:
            collector.warning(note)
        if nulls:
            collector.warning("{0} feature(s) have no geometry: OID {1}. Delete or repair "
                              "them.".format(len(nulls), _gq_oid_list(nulls)))
        if nonfinite:
            collector.warning("{0} feature(s) have NaN or infinite coordinates and were not checked: "
                              "OID {1}. Repair or delete them.".format(len(nonfinite),
                                                                       _gq_oid_list(nonfinite)))
        if skipped:
            collector.warning("{0} feature(s) with true curves were skipped: OID {1}. Densify "
                              "them first to check them.".format(len(skipped),
                                                                  _gq_oid_list(skipped)))
        collector.info("{0} feature(s) checked; {1} problem(s) found.".format(
            len(rows) - len(nulls) - len(nonfinite), len(issues)))
        summary = geometry_summary(issues, len(rows) + len(skipped), nulls, skipped, nonfinite)
        detail = [(i["oid"], i["check"], i["part"], i["vertex"], i["value"], i["unit"],
                   i["detail"]) for i in issues]
        detail += [(oid, "NULL_GEOMETRY", None, None, None, None, "No geometry.")
                   for oid in nulls]
        detail += [(oid, "NONFINITE_COORDINATES", None, None, None, None,  # R5-D1
                    "NaN or infinite coordinates; not checked.") for oid in nonfinite]
        detail += [(oid, "SKIPPED_CURVE", None, None, None, None,
                    "True curves; not checked.") for oid in skipped]
        for written in write_report(report, summary, ["SRC_OID", "CHECK", "PART", "VERTEX",
                                                      "VALUE", "UNIT", "DETAIL"], detail):
            collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "issue_count", str(len(issues)))
        flush_messages(collector)


def _gq_selected_checks(param):
    """Checks chosen in the dialog, upper case; an empty choice means all seven (as at run time)."""
    chosen = [c.strip().strip("'\"").upper() for c in param_list(param)]
    return [c for c in chosen if c] or list(GEOMETRY_CHECKS)


def _gq_short_segment_off(checks, min_segment_m, near_dup_tol_m):
    """True when SHORT_SEGMENT is selected but cannot find anything (0 < minimum <= tolerance).

    One rule for the dialog (``updateMessages``) and the run (``_run``)."""
    return CHECK_SHORT_SEGMENT in checks and 0 < min_segment_m <= near_dup_tol_m


def _gq_oid_list(oids, limit=20):
    text = ", ".join(str(o) for o in oids[:limit])
    if len(oids) > limit:
        text += " ... ({0} more)".format(len(oids) - limit)
    return text


# ==========================================================================
# quality/bilingual_names_tool.py
# ==========================================================================
# Arabic-English Name Check: the ArcGIS Pro tool (adapter).

def _bilingual_cut_bytes(text, limit):
    """``text`` cut to at most ``limit`` bytes as a dBASE field counts them (UTF-8; a character
    above U+FFFF counts 6, ``common.arcio._arcio_dbf_bytes``), never in the middle of a character."""
    if _arcio_dbf_bytes(text) <= limit:
        return text
    out, used = [], 0
    for ch in text:
        width = _arcio_dbf_bytes(ch)
        if used + width > limit:
            break
        out.append(ch)
        used += width
    return u"".join(out)


def _bilingual_fit_text(rows, folder):
    """Rows as the output table can store them. A dBASE table written by ArcGIS Pro has a
    UTF-8 code page and its text fields hold at most 254 BYTES (an Arabic letter takes 2),
    so in a folder a FIELD, VALUE or DETAIL is cut to 254 UTF-8 bytes (an Arabic
    DETAIL cut to 254 characters comes back shortened again in ArcGIS Pro); the report keeps the full text.
    Returns ``(rows, number of values cut)``."""
    if not folder:
        return rows, 0
    out, cut = [], 0
    for row in rows:
        new = list(row)
        for i in (1, 2, 4):
            if isinstance(new[i], str):
                fitted = _bilingual_cut_bytes(new[i], SHAPEFILE_MAX_TEXT)
                if fitted != new[i]:
                    new[i] = fitted
                    cut += 1
        out.append(tuple(new))
    return out, cut


# An Excel cell holds at most 32,767 characters (counted in UTF-16 units); openpyxl cuts a longer
# text without a word. The shared report writer first writes each control character as the visible
# "<U+XXXX>" (8 characters, ``common.report._REPORT_ILLEGAL``), so the limit is measured on the text
# as it is written, after that expansion; before, a value cut to 32,767 here could grow past the
# limit again and be cut silently by openpyxl.
EXCEL_MAX_CELL = 32767


def _bilingual_cut_utf16(text, limit):
    """``text`` cut to at most ``limit`` UTF-16 units, never inside a surrogate pair."""
    if len(text) <= limit // 2:
        return text
    out, used = [], 0
    for ch in text:
        width = 2 if ord(ch) > 0xFFFF else 1
        if used + width > limit:
            break
        out.append(ch)
        used += width
    return u"".join(out)


def _bilingual_excel_text(text, limit=EXCEL_MAX_CELL):
    """``text`` as the Excel report writes it (control characters as ``<U+XXXX>``, a lone surrogate
    as U+FFFD), cut to at most ``limit`` UTF-16 units, never inside a pair or inside a ``<U+XXXX>``.
    The shared writer translates it again, which changes nothing. Returns ``(text, cut)``."""
    shown = text.translate(_REPORT_ILLEGAL)
    if len(shown) <= limit // 2:
        return shown, False
    out, used = [], 0
    for ch in text:
        piece = _REPORT_ILLEGAL.get(ord(ch), ch)
        width = sum(2 if ord(c) > 0xFFFF else 1 for c in piece)
        if used + width > limit:
            return u"".join(out), True
        out.append(piece)
        used += width
    return u"".join(out), False


def _bilingual_fit_excel(rows):
    """Detail rows as an Excel report can hold them: a text longer than ``EXCEL_MAX_CELL``
    UTF-16 units as written (after the ``<U+XXXX>`` expansion of control characters) is cut to it.
    Returns ``(rows, number of values cut)``."""
    out, cut = [], 0
    for row in rows:
        new = list(row)
        for i, v in enumerate(new):
            if isinstance(v, str):
                new[i], was_cut = _bilingual_excel_text(v)
                cut += 1 if was_cut else 0
        out.append(tuple(new))
    return out, cut


def _bilingual_text_spec(name, rows, index, folder):
    """Text column spec: in a folder the width is the longest value in UTF-8 bytes."""
    values = [r[index] for r in rows]
    if not folder:
        return {"name": name, "type": "TEXT", "values": values}
    longest = max([_arcio_dbf_bytes(v) for v in values if isinstance(v, str)] or [1])
    return {"name": name, "type": "TEXT", "length": max(1, longest)}


def _bilingual_unquote(text):
    """One value of a multivalue string. Outer quotes that ArcGIS Pro may put around a value
    with spaces or an apostrophe ('Burger King', "McDonald's") are removed and a doubled quote
    inside them is one quote; an apostrophe that only ends or starts a name (Dunkin') is kept.
    ``common.params.param_list`` strips every quote at both ends, which would drop the
    apostrophe of "Dunkin'"."""
    text = text.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "'\"":
        quote = text[0]
        text = text[1:-1].replace(quote * 2, quote).strip()
    return text


def _bilingual_latin_names(param):
    """Values of the Latin names parameter: ``Parameter.values`` when it is a list, otherwise
    ``valueAsText``; a value that still holds ``;`` (a whole multivalue string passed as one
    value) is split there; each value is unquoted with ``_bilingual_unquote``."""
    values = getattr(param, "values", None)
    if isinstance(values, (list, tuple)):
        items = [part for v in values if v is not None for part in str(v).split(";")]
    else:
        items = (param_text(param) or u"").split(";")
    return [v for v in (_bilingual_unquote(i) for i in items) if v]


def _bilingual_output_name_problem(out_path):
    """The message for an output table name that the run would refuse (for example "issues.csv" in
    a folder, where only ``.dbf`` is a table), or ``None``. Checked in the dialog so the name is
    refused before the run, with the same fix as the run gives; ``None`` when the location does not
    exist yet or cannot be checked (the run then decides)."""
    if not out_path or not str(out_path).strip():
        return None
    try:
        workspace, name = split_catalog_path(str(out_path).strip())
        if not workspace or not name or not arcpy.Exists(workspace):
            return None
        base = name
        if is_folder_workspace(workspace) and name.casefold().endswith((".shp", ".dbf")):
            base = name[:-4]
        valid = arcpy.ValidateTableName(base, validation_workspace(workspace))
    except Exception:
        return None
    if valid == base:
        return None
    return ("The output name '{0}' is not valid in '{1}'. Use a name such as '{2}' (letters, digits "
            "and underscores; in a folder the table is a dBASE table, .dbf).".format(name, workspace, valid))


def _bilingual_unexpected_error(exc, out_table, out_report):
    """Error text for an unexpected exception: what happened, what may be left, what to do, and the
    last lines of the traceback (the cause is the exception's own text)."""
    lines = traceback.format_exc().strip().splitlines()
    return ("Arabic-English Name Check stopped with an unexpected error. The output table '{0}'{1} may be missing "
            "or incomplete: delete what is left of it and run the tool again after fixing the cause below "
            "(for example a locked or read-only output location, a full disk, or an input whose data "
            "source cannot be read).\nError: {2}: {3}\nTechnical details (last lines of the traceback):\n{4}"
            ).format(out_table or "(none)", " and the report '{0}'".format(out_report) if out_report else "",
                     type(exc).__name__, exc, "\n".join(line.strip() for line in lines[-6:]))


def _bilingual_values_text(values, limit=5):
    """``"a", "b" and N more``: at most ``limit`` values in quotes."""
    text = u", ".join(u"\"{0}\"".format(v) for v in values[:limit])
    if len(values) > limit:
        text += u" and {0} more".format(len(values) - limit)
    return text


def _bilingual_listed_placeholder_warning(values, count):
    """Warning for INCONSISTENT_PAIR groups whose own name is a real name but that list a placeholder as
    one of their names (``placeholder_variant_values``): ("Park", "-") and ("Park", "<arabic>")."""
    return (u"{0} INCONSISTENT_PAIR issue(s) are in groups that list a placeholder ({1}) as one of their "
            u"names: without Treat placeholders as missing, a row whose other name is a placeholder differs "
            u"from the rows with a real name. Check Treat placeholders as missing to report such values as "
            u"MISSING_EN or MISSING_AR and leave them out of INCONSISTENT_PAIR.".format(
                count, _bilingual_values_text(values)))


def _bilingual_no_issue_message(row_count, checks):
    """The message of a run without issues; it names the checks when not all five were run."""
    if set(checks) >= set(BILINGUAL_CHECKS):
        return "No name issues found in {0} row(s).".format(row_count)
    return "No name issues found in {0} row(s) for the chosen checks ({1}); the other checks were not run.".format(
        row_count, ", ".join(c for c in BILINGUAL_CHECKS if c in set(checks)))


class BilingualNameQA(object):
    """Check English/Arabic name pairs for missing, swapped and inconsistent values."""

    DOC = {
        "summary": "Checks an English and an Arabic name field side by side: missing names, "
                   "Arabic letters in the English field, Latin text in the Arabic field, swapped "
                   "values, Arabic-Indic or Persian digits in English or mixed digit systems, and names "
                   "that are translated inconsistently (the same English name with different "
                   "Arabic names, or the reverse). Read-only.",
        "usage": "Spaces, punctuation and digits never decide the script. Arabic presentation "
                 "forms and Persian letters count as Arabic; fullwidth Latin letters (\uff2b\uff26\uff23) count as "
                 "Latin, mathematical Latin letters do not; zero-width non-joiners inside "
                 "Arabic names are accepted. Invisible marks that copy and paste leaves behind "
                 "(left-to-right and right-to-left marks, zero-width space, soft hyphen, byte "
                 "order mark) are ignored when names are compared.\n\n"
                 "A brand name that stays in Latin in the Arabic field (KFC) is reported as "
                 "WRONG_SCRIPT_AR unless you accept it: check Accept Latin names equal to the "
                 "English name (the Arabic value is the same as the English value of its row) "
                 "and/or list the names in Latin names accepted in the Arabic field. "
                 "A swap whose Latin side is accepted this way is reported as WRONG_SCRIPT_EN only. "
                 "SWAPPED needs a wholly Arabic English value and a wholly Latin Arabic value; "
                 "a mixed English value such as \"Al Baik <Arabic>\" with a Latin Arabic value "
                 "is reported as WRONG_SCRIPT_EN and WRONG_SCRIPT_AR.\n\n"
                 "Inconsistent pairs compare names in Unicode canonical composition (NFC, so a "
                 "decomposed spelling equals the precomposed one): English names with spaces "
                 "trimmed and repeated spaces collapsed, ignoring case, and Arabic names after optional Arabic letter "
                 "folding (alef forms, yeh, "
                 "tashkeel, tatweel; teh marbuta and heh, and the seats of hamza, are NOT folded). "
                 "Typographic apostrophes, quotes and dashes in English names are compared as their "
                 "ASCII forms (King\u2019s = King's). The DETAIL of an inconsistent pair counts the "
                 "different names after this comparison and lists the first 10 "
                 "(alphabetically), each by one of its spellings; when the raw spellings are "
                 "more, their number is added, e.g. \"2 different Arabic names (3 spellings)\". "
                 "Generic names (\"Mosque\", \"School\") can form very large groups; this is by "
                 "design, and the DETAIL stays short.\n\n"
                 "Placeholders (for example \"-\", \"N/A\", \"NA\", \"x\", \"0\", \"...\", \"\u061f\", "
                 "tatweel only; the full list is in the tool page) are names to this "
                 "tool unless you check Treat placeholders as missing: they are then MISSING_EN or "
                 "MISSING_AR and left out of the other checks. As names, they go through every other "
                 "check, and rows that share one are grouped for INCONSISTENT_PAIR: \"-\" as the English "
                 "name of rows with different Arabic names makes them one group (a warning names such "
                 "placeholders), and \"-\" as the Arabic name of one \"Park\" row makes it differ from "
                 "the other \"Park\" rows (a second warning names such placeholders). Digits: Arabic-Indic or Persian digits "
                 "in the English name, and two digit systems (ASCII, Arabic-Indic, Persian) in the "
                 "Arabic name, are MIXED_DIGITS; the DETAIL names the digit systems found. A code "
                 "inside an Arabic name may use ASCII, Arabic-Indic or Persian digits (M4 and "
                 "M\u0664 are both codes), and its digits count for MIXED_DIGITS: \"\u0637\u0631\u064a\u0642 A1 "
                 "\u0631\u0642\u0645 \u0665\" mixes ASCII and Arabic-Indic digits.\n\nIn a dBASE table or shapefile output (text fields of "
                 "at most 254 bytes in UTF-8; an Arabic letter takes 2 bytes, a character above U+FFFF "
                 "is counted as 6) a longer FIELD, VALUE or DETAIL is "
                 "cut to 254 bytes (never in the middle of a letter) "
                 "and a warning says how many values were cut; the report keeps the full text (an "
                 "Excel cell holds at most 32,767 UTF-16 units: a character above U+FFFF, such as an "
                 "emoji, counts 2, and a control character counts as the 8 characters <U+XXXX> it is "
                 "written as; a longer value is cut there, with a warning; a CSV report keeps "
                 "the full length, but a value that starts with =, @, a tab or a carriage return, or "
                 "with + or - followed by something that is not a plain number (\"--\", \"-Olaya\"), is "
                 "written with a leading apostrophe so that a spreadsheet does not run it as a "
                 "formula). SRC_OID is a Long field while every ObjectID fits 32 bits; with 64-bit "
                 "ObjectIDs it is a Big Integer field in a geodatabase or GeoPackage (an ObjectID above 2^53 - 1, "
                 "which ArcGIS Pro cannot store there, stops the run with the fix) and, in a dBASE "
                 "table, a Double field while every ObjectID has at most 12 significant digits (a "
                 "dBASE Double keeps no more) and else a text field of 20 characters with every digit "
                 "kept, with a message. "
                 "If writing the output fails part-way, the unfinished table is deleted.\n\n"
                 "Selections and definition queries on the input layer "
                 "are honoured. The tool never edits data.",
        "params": {
            "in_table": "Layer or table with the two name fields.",
            "english_field": "Text field with the English (Latin script) name.",
            "arabic_field": "Text field with the Arabic name.",
            "checks": "Checks to run. Default: all. If none is chosen, all five are run (a message "
                      "says so).",
            "allow_latin_codes_in_arabic": "Accept short codes of up to 6 Latin letters and "
                                            "digits (ASCII, Arabic-Indic or Persian) that contain a "
                                            "digit (for example A1, M4, M\u0664) "
                                            "inside Arabic names. Short Arabizi words with a "
                                            "digit (\"3ali\", \"Ta7lia\") also look like codes "
                                            "and pass; uncheck this for data that may hold "
                                            "Arabizi.",
            "normalise_arabic": "Fold Arabic letter variants (alef forms, yeh, Persian yeh and "
                                "keheh, presentation forms, tashkeel, tatweel), Arabic-Indic and "
                                "Persian digits and invisible marks before comparing Arabic "
                                "names for INCONSISTENT_PAIR.",
            "same_as_english": "Accept an Arabic value that is the same as the English value of "
                               "its row (a brand name kept in Latin, for example KFC) instead of "
                               "reporting WRONG_SCRIPT_AR.",
            "latin_names": "Latin names accepted as the whole Arabic value in any row (brand names "
                           "such as Starbucks). Compared ignoring case, invisible marks, and spaces at "
                           "the ends or repeated (\"Star bucks\" is not \"Starbucks\").",
            "placeholders_as_missing": "Report a placeholder name (for example \"-\", \"N/A\", \"NA\", \"x\", \"null\", \"unknown\", "
                                       "\"0\", \"...\", the Arabic question mark, Arabic \"unknown\" or "
                                       "\"none\", a value without letters or digits) as MISSING_EN or "
                                       "MISSING_AR and leave it out of the other checks.",
            "out_table": "Output table: SRC_OID, FIELD, VALUE, ISSUE, DETAIL.",
            "out_report": "Optional Excel (.xlsx) or CSV report with Summary and Detail sheets.",
            "issue_count": "Number of issues found (derived).",
        },
        "tags": ["Arabic", "bilingual", "names", "script", "validation", "quality"],
    }

    def __init__(self):
        self.label = "Arabic-English Name Check"
        self.description = ("Checks English/Arabic name pairs for missing, wrong-script, swapped "
                            "and inconsistent values (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_table", "Input Table", ["GPFeatureLayer", "GPTableView"]),
            make_param("english_field", "English Name Field", "Field", depends_on="in_table",
                       value_list=["Text"]),
            make_param("arabic_field", "Arabic Name Field", "Field", depends_on="in_table",
                       value_list=["Text"]),
            make_param("checks", "Checks", "GPString", required=False, multi_value=True,
                       value_list=list(BILINGUAL_CHECKS), default=list(BILINGUAL_CHECKS)),
            make_param("allow_latin_codes_in_arabic", "Allow Latin codes in Arabic names",
                       "GPBoolean", required=False, default=True),
            make_param("normalise_arabic", "Normalise Arabic letters", "GPBoolean",
                       required=False, default=True),
            make_param("same_as_english", "Accept Latin names equal to the English name", "GPBoolean",
                       required=False, default=False),
            make_param("latin_names", "Latin names accepted in the Arabic field", "GPString",
                       required=False, multi_value=True),
            make_param("placeholders_as_missing", "Treat placeholders as missing", "GPBoolean",
                       required=False, default=False),
            make_param("out_table", "Output Table", "DETable", direction="Output"),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("issue_count", "Issue Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        en, ar = param_text(p["english_field"]), param_text(p["arabic_field"])
        if en and ar and en.casefold() == ar.casefold():
            p["arabic_field"].setErrorMessage("Choose two different fields.")
        problem = _bilingual_output_name_problem(param_text(p["out_table"]))
        if problem:
            p["out_table"].setErrorMessage(problem)
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception as exc:
            # Any other failure (an arcpy error while reading the input, creating or filling the
            # output, or writing the report): say what happened and what to do, instead of a bare
            # traceback. An output table that failed while its rows were written is already deleted.
            flush_messages(collector)
            arcpy.AddError(_bilingual_unexpected_error(exc, param_text(p["out_table"]),
                                                       param_text(p["out_report"])))

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        chosen = param_list(p["checks"])
        if not chosen:
            collector.info("No check was chosen, so all five checks are run: {0}.".format(
                ", ".join(BILINGUAL_CHECKS)))
        checks = [c.upper() for c in (chosen or list(BILINGUAL_CHECKS))]
        unknown = [c for c in checks if c not in BILINGUAL_CHECKS]
        if unknown:
            raise ToolError("Unknown check(s): {0}.".format(", ".join(unknown)),
                            "Choose checks from the list: {0}.".format(", ".join(BILINGUAL_CHECKS)))
        desc = describe_dataset(param_text(p["in_table"]))
        fields = []
        for pname, label in (("english_field", "English name field"),
                             ("arabic_field", "Arabic name field")):
            field, how = match_field(desc["fields"], param_text(p[pname]), label=label,
                                     exact_name_first=True)
            collector.info(match_message(param_text(p[pname]), field, how))
            if str(field["type"]).casefold() not in ("string", "text"):
                raise ToolError("The {0} '{1}' is not a text field.".format(label, field["name"]),
                                "Choose a text field.")
            fields.append(field["name"])
        en_name, ar_name = fields
        if en_name == ar_name:
            raise ToolError("The English and Arabic name fields are the same field.",
                            "Choose two different fields.")
        rows = read_features(desc["input"], [en_name, ar_name], geometry=False)
        progress = Progress("Checking names", len(rows))
        pairs = [(r["oid"], r["attrs"][en_name], r["attrs"][ar_name]) for r in rows]
        issues = check_bilingual(pairs, en_name, ar_name, checks,
                                 param_bool(p["allow_latin_codes_in_arabic"], True),
                                 param_bool(p["normalise_arabic"], True),
                                 _bilingual_latin_names(p["latin_names"]),
                                 param_bool(p["same_as_english"], False),
                                 param_bool(p["placeholders_as_missing"], False))
        progress.tick(len(rows))
        progress.close()
        values = [None if i["value"] is None else str(i["value"]) for i in issues]
        detail = [(i["oid"], i["field"], v, i["issue"], i["detail"])
                  for i, v in zip(issues, values)]
        out_path = param_text(p["out_table"])
        folder = is_folder_workspace(split_catalog_path(out_path)[0])
        shown, cut = _bilingual_fit_text(detail, folder)
        # SRC_OID: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``): LONG while every
        # ObjectID fits 32 bits, BIGINTEGER in a geodatabase, in a folder DOUBLE while every id has
        # at most 12 significant digits and TEXT otherwise.
        oid_spec, oid_note = oid_field_spec([r[0] for r in detail], folder)
        if oid_note:
            collector.info(oid_note)
        if oid_spec["type"] == "TEXT":
            shown = [(oid_field_value(oid_spec, r[0]),) + tuple(r[1:]) for r in shown]
        specs = [oid_spec,
                 _bilingual_text_spec("FIELD", shown, 1, folder),
                 _bilingual_text_spec("VALUE", shown, 2, folder),
                 {"name": "ISSUE", "type": "TEXT", "length": 20},
                 _bilingual_text_spec("DETAIL", shown, 4, folder)]
        path, names = create_table(out_path, specs, inputs=[desc["catalog_path"]])
        nulls = set()
        try:
            insert_rows(path, [names[s["name"]] for s in specs], shown, null_fields=nulls)
        except Exception:
            # never leave a half-filled output table behind
            try:
                safe_delete(path, [desc["catalog_path"]])
            except Exception:
                pass
            raise
        excel_cut = 0
        report_detail = detail
        if report and report["format"] == REPORT_FORMAT_XLSX:
            report_detail, excel_cut = _bilingual_fit_excel(detail)
            report_detail = [(bilingual_report_oid(r[0]),) + tuple(r[1:]) for r in report_detail]
        if cut:
            collector.warning(
                "{0} text value(s) are longer than {1} bytes in UTF-8 (an Arabic letter takes 2 bytes, a character "
                "above U+FFFF is counted as 6), the "
                "most a dBASE/shapefile text field holds; they are cut to {1} bytes in the output table{2}. Write "
                "the output to a file geodatabase to keep the full text.".format(
                    cut, SHAPEFILE_MAX_TEXT,
                    " (the report keeps the full text)" if report and not excel_cut else ""))
        if excel_cut:
            collector.warning(
                "{0} text value(s) are longer than {1} UTF-16 units, the most an Excel cell holds (a "
                "character above U+FFFF, such as an emoji, counts as 2 units; a control character counts "
                "as the 8 characters <U+XXXX> it is written as); they are cut to {1} units in the Excel "
                "report. Choose a .csv report to keep the full length (a CSV report adds a leading apostrophe "
                "to a value that a spreadsheet would read as a formula).".format(excel_cut, EXCEL_MAX_CELL))
        note = folder_null_number_warning(path, specs, names, nulls,
                                          "An empty VALUE means the name was missing.")
        if note:
            collector.warning(note)
        if not param_bool(p["placeholders_as_missing"], False):
            held, held_count = placeholder_pair_values(issues)
            if held:
                shown_values = ", ".join(u"\"{0}\"".format(v) for v in held[:5])
                if len(held) > 5:
                    shown_values += u" and {0} more".format(len(held) - 5)
                collector.warning(
                    u"{0} INCONSISTENT_PAIR issue(s) are rows grouped by a placeholder value ({1}): "
                    u"without Treat placeholders as missing a placeholder is compared like a name. "
                    u"Check Treat placeholders as missing to report such values as MISSING_EN or "
                    u"MISSING_AR instead.".format(held_count, shown_values))
            listed, listed_count = placeholder_variant_values(issues, pairs, en_name,
                                                              param_bool(p["normalise_arabic"], True))
            if listed:
                collector.warning(_bilingual_listed_placeholder_warning(listed, listed_count))
        if issues:
            collector.warning("{0} name issue(s) in {1} row(s); see {2}.".format(
                len(issues), len(set(i["oid"] for i in issues)), path))
        else:
            collector.info(_bilingual_no_issue_message(len(rows), checks))
        for written in write_report(report, bilingual_summary(issues, len(rows)),
                                    ["SRC_OID", "FIELD", "VALUE", "ISSUE", "DETAIL"], report_detail):
            collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "issue_count", str(len(issues)))
        flush_messages(collector)


# ==========================================================================
# quality/multivalue_codes_tool.py
# ==========================================================================
# Multi-Value Code Validator: the ArcGIS Pro tool (adapter).

def _mv_value_list(text):
    """Codes of the Value List parameter (a multivalue string) as a list.

    Values are separated by ``;``. A value that starts with a quote (``'`` or ``"``) and has a
    closing quote of the same kind followed (after spaces) by ``;`` or the end is quoted, so a
    code holding ``;`` or spaces survives (``'A;B'`` -> ``A;B``). Inside a quoted value the quote
    written twice is one literal quote, and a quote that is not followed by ``;`` or the end
    is kept as a character (``'O'Neil Park'`` -> ``O'Neil Park``). A value without such a
    closing quote is read as typed, quotes included (``'s-Hertogenbosch``, ``12"`` and
    ``O'Neil`` are kept whole). Values are trimmed of spaces; empty values are dropped."""
    if not text:
        return []
    out, i, n = [], 0, len(text)

    def closes(j):
        """True when the quote at ``j`` ends the value (only spaces up to ``;`` or the end)."""
        k = j + 1
        while k < n and text[k] == " ":
            k += 1
        return k >= n or text[k] == ";"

    while i < n:
        while i < n and text[i] == " ":
            i += 1
        cell, start, closed = [], i, False
        if i < n and text[i] in "'\"":
            quote, i = text[i], i + 1
            while i < n:
                if text[i] == quote:
                    if i + 1 < n and text[i + 1] == quote:
                        cell.append(quote)
                        i += 2
                        continue
                    if closes(i):
                        i += 1
                        closed = True
                        break
                cell.append(text[i])
                i += 1
            if not closed:  # no closing quote: read the value as typed
                cell, i = [], start
        while i < n and text[i] != ";":
            cell.append(text[i])
            i += 1
        value = u"".join(cell).strip()
        if value:
            out.append(value)
        i += 1
    return out


def _mv_storable(value, counter=None):
    """``value`` as an output table can store it.

    A lone UTF-16 surrogate (U+D800-U+DFFF, half of a character pair) cannot be encoded as
    UTF-8, so writing it fails with a raw UnicodeEncodeError. A proper pair of surrogates is
    joined into its character; every lone one becomes U+FFFD (the replacement character), as
    the report does. A changed value is counted in ``counter[0]``. Other values are returned
    unchanged."""
    if not isinstance(value, str) or not any(u"\ud800" <= ch <= u"\udfff" for ch in value):
        return value
    fixed = value.encode("utf-16-le", "surrogatepass").decode("utf-16-le", "replace")
    if counter is not None and fixed != value:
        counter[0] += 1
    return fixed


_MV_SOURCE_DOMAIN = "DOMAIN"
_MV_SOURCE_TABLE = "TABLE"
_MV_SOURCE_LIST = "LIST"
# Field.type -> AddField keyword for the attributes copied to the explode output.
_MV_ADDFIELD_KEYWORDS = {"String": "TEXT", "SmallInteger": "SHORT", "Integer": "LONG",
                         "BigInteger": "BIGINTEGER", "Single": "FLOAT", "Double": "DOUBLE",
                         "Date": "DATE", "DateOnly": "DATEONLY", "Guid": "GUID",
                         "TimeOnly": "TIMEONLY", "TimestampOffset": "TIMESTAMPOFFSET"}
# Geometry measure fields the geodatabase maintains (never carried, no warning).
_MV_SHAPE_MEASURES = ("shape_length", "shape_area", "shape.stlength()", "shape.starea()")
# POSITION is a SHORT field.
_MV_MAX_POSITION = 32767
# Lookup field types compared numerically in TABLE mode, as numeric domains are.
# The ObjectID (OID) is an integer too: "01" and "2.0" equal the ObjectIDs 1 and 2.
_MV_NUMERIC_TYPES = ("smallinteger", "integer", "biginteger", "single", "double", "oid")
# Lookup field types that cannot hold codes (refused).
_MV_NO_CODE_TYPES = ("geometry", "blob", "raster")
# Lookup field types compared as text in the form the table returns them (a warning shows it).
_MV_TEXT_FORM_TYPES = ("date", "dateonly", "timeonly", "timestampoffset", "guid", "globalid", "xml")
# Types a shapefile / dBASE output cannot hold at all: not carried there (a warning names them).
_MV_GDB_ONLY_KEYWORDS = ("TIMEONLY", "TIMESTAMPOFFSET")
# Types a shapefile / dBASE output cannot hold but whose values another type keeps: written in that
# type there (a warning names them), decided before anything is written. REPORTED by ArcGIS Pro
# 3.3.2: Add Field on a dBASE table refuses GUID (ERROR 001140) and BIGINTEGER / DATEONLY
# (ERROR 003738). Field.type -> (keyword, text width, what the warning says).
_MV_FOLDER_CONVERSIONS = {
    "Guid": ("TEXT", 38, "GUID, as text of 38 characters"),
    "GlobalID": ("TEXT", 38, "GlobalID, as text of 38 characters"),
    "DateOnly": ("DATE", None, "Date Only, as a date"),
    "BigInteger": ("TEXT", 20, "Big Integer, as text with every digit"),
}


def _mv_folder_value(field_type, value):
    """``value`` of a ``field_type`` field converted by ``_MV_FOLDER_CONVERSIONS`` for a folder
    output (None stays None)."""
    if value is None:
        return None
    if field_type == "DateOnly":
        if isinstance(value, datetime.datetime):
            return value
        if isinstance(value, datetime.date):
            return datetime.datetime(value.year, value.month, value.day)
        return value
    if field_type == "BigInteger" and isinstance(value, int) and not isinstance(value, bool):
        return str(value)
    if field_type == "BigInteger" and isinstance(value, float) and value == int(value):
        return str(int(value))
    return str(value)


class MultiValueCodeValidator(object):
    """Validate delimited multi-value code fields token by token, and explode them."""

    DOC = {
        "summary": "Validates text fields that hold several codes in one value (for example "
                   "\"A;B;C\"): every token is checked against the field's coded-value domain "
                   "(subtype level), a lookup table or a value list, and empty, padded, wrongly "
                   "cased, unknown and repeated tokens and mixed delimiters are reported. "
                   "Optionally writes an exploded table with one row per token.",
        "usage": "Positions are 1-based over the raw split, so an empty token still takes a "
                 "position. Tokens are trimmed before they are validated: spaces, line breaks "
                 "and invisible marks (right-to-left mark, zero-width space, BOM) at either end "
                 "are named WHITESPACE or INVISIBLE_MARK and then ignored. A value that holds "
                 "nothing but spaces or invisible marks is counted as blank (not as an empty "
                 "token). Codes of a domain, table or list that have such padding are compared "
                 "without it (a warning counts them). DUPLICATE_TOKEN marks a repeat of a valid "
                 "code only. Data such as \"A; B; C\" gives a WHITESPACE row for every token "
                 "after the first.\n\nAUTO delimiter: the most frequent of ; , | / and the Arabic comma "
                 "and semicolon (U+060C, U+061B) in the field, counted after the text of the valid "
                 "codes is removed (the / of Hospital/Clinic is not a separator; the codes are removed "
                 "in any case, also when Case sensitive is checked, and padded codes also "
                 "trimmed); when no "
                 "candidate occurs outside the codes, the values are single codes and the first "
                 "candidate that occurs in no valid code is used (; unless a code such as 'A;B' "
                 "holds it; an info message says so); ; is used when every candidate occurs inside "
                 "a code. "
                 "A token that contains one of the "
                 "other candidate delimiters and is not a valid code, not even ignoring case, is "
                 "flagged MIXED_DELIMITER (hospital/clinic for the code Hospital/Clinic is only "
                 "CASE_MISMATCH). Codes that contain the chosen delimiter cannot be validated; "
                 "they are listed in a warning. A value with more than 32,767 tokens stops the "
                 "run before anything is written (POSITION is a short integer).\n\nIn DOMAIN mode the domain is resolved per "
                 "row at subtype level; Domain Name is used when the field (or the row's "
                 "subtype) has no domain (an info message says when it was not used for any row). Numeric domains and numeric lookup fields (TABLE "
                 "mode) compare numerically (\"01\" = 1; only ASCII numbers); in an integer domain "
                 "or lookup field a decimal spelling matches only the integer it equals exactly "
                 "(1.0 = 1, but 0.99999999999999999 is UNKNOWN_TOKEN); a Value List and a "
                 "text lookup field compare as text. In a Double or Float domain or lookup field "
                 "the token is rounded as that type stores numbers (integer and decimal text "
                 "alike), so 9007199254740993 equals the Double code 9007199254740992 and "
                 "0.1000000001 equals the Float code 0.1. An ObjectID lookup field compares as "
                 "an integer; a Date, GUID or GlobalID lookup field compares as text in the form "
                 "the table returns (a warning shows it), and a Geometry, Blob or Raster field is "
                 "refused. A Value List code that contains another delimiter candidate (A,B,C) "
                 "is one code; a warning says so. A lookup field or "
                 "Value List without any valid code is refused; a domain without codes gives a "
                 "warning.\n\n"
                 "The exploded output carries the other attribute fields whose type Add Field can "
                 "create (TimeOnly and TimestampOffset only into a geodatabase); a warning names "
                 "every field that is not carried (other types, non-editable fields). A shapefile "
                 "or dBASE output cannot hold GUID, GlobalID, Big Integer or Date Only fields: "
                 "there a GUID field and PARENT_GUID are text of 38 characters, a Big Integer "
                 "field is text with every digit and a Date Only field is a date; a warning names "
                 "them, and this is decided before anything is written. Rows of "
                 "a subtype without a domain (and no Domain Name) are neither checked nor "
                 "exploded; a warning counts them, and so do the info message and the report Summary "
                 "(Rows not checked (no domain)). With Keep geometry, true curves are "
                 "densified into straight segments and Z/M values are dropped (x,y only; a "
                 "warning says so). An input field whose name "
                 "is taken by one of the tool's own fields (PARENT_OID, POSITION, TOKEN, "
                 "DESCRIPTION, TOKEN_STATUS, PARENT_GUID), or by another field once cut to 10 "
                 "characters in a shapefile or dBASE output, is carried under a new name such as "
                 "DESCRIPTION_1; a warning lists each such field. A carried field keeps its "
                 "field-level domain when the output geodatabase has it (a warning names the "
                 "fields that lose it). The exploded TOKEN is the token as typed (trimmed); in a "
                 "case-insensitive run a valid token keeps its own case (a gets the description of A). "
                 "Subtypes and subtype-level domains are not carried.\n\n"
                 "In a shapefile or dBASE output a text field holds at most 254 UTF-8 bytes "
                 "(an Arabic letter takes 2): longer text, such as a long carried attribute, is "
                 "cut to 254 bytes and a warning counts the cut values; write the outputs to a "
                 "file geodatabase to keep the full text (the report keeps it too). A shapefile "
                 "or dBASE table cannot store an empty number or hold a domain: an empty carried "
                 "number is stored as 0 (an empty text as empty text) and a warning names those "
                 "fields. A lone UTF-16 "
                 "surrogate (half of a character pair) cannot be stored in any output table: it "
                 "is written as U+FFFD (the replacement character) and a warning counts the "
                 "values.\n\n"
                 "Null values are counted only. Selections and definition queries on input "
                 "layers are honoured. The input is never edited, and no output or report may "
                 "replace the input or the lookup table (refused before anything is written).",
        "params": {
            "in_table": "Layer or table with the multi-value code field.",
            "code_field": "Text field holding delimited codes.",
            "delimiter": "Delimiter between codes, or AUTO to detect it.",
            "valid_source": "Where the valid codes come from: DOMAIN (coded-value domain), "
                            "TABLE (a field of a lookup table) or LIST (Value List).",
            "domain_name": "DOMAIN mode: domain to use when the field itself has no domain.",
            "lookup_table": "TABLE mode: table holding the valid codes.",
            "lookup_field": "TABLE mode: field of the lookup table holding the valid codes.",
            "value_list": "LIST mode: the valid codes (a code in quotes, such as 'A;B', is one code; "
                          "a quote that is part of a code is kept).",
            "case_sensitive": "Compare codes with exact case. Wrong case is then reported as "
                              "CASE_MISMATCH with the correct code.",
            "explode": "Also write one row per token (empty tokens are skipped).",
            "keep_geometry": "Write the exploded rows as features with the parent's geometry.",
            "out_table": "Output table of token issues: SRC_OID, POSITION, TOKEN, ISSUE, "
                         "SUGGESTED.",
            "out_explode": "Exploded output (required when Explode is checked): PARENT_OID, "
                           "POSITION, TOKEN, DESCRIPTION, TOKEN_STATUS (OK for a valid token, "
                           "even a padded one) and the other attribute "
                           "fields that can be carried (a warning names any that are not).",
            "out_report": "Optional Excel (.xlsx) or CSV report with Summary and Detail sheets.",
            "issue_count": "Number of token issues found (derived).",
        },
        "tags": ["multi-value", "delimited", "domain", "codes", "explode", "quality"],
    }

    def __init__(self):
        self.label = "Multi-Value Code Validator"
        self.description = ("Validates delimited multi-value code fields token by token against a "
                            "domain, table or list, and explodes them (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_table", "Input Table", ["GPFeatureLayer", "GPTableView"]),
            make_param("code_field", "Code Field", "Field", depends_on="in_table",
                       value_list=["Text"]),
            make_param("delimiter", "Delimiter", "GPString", default=";",
                       value_list=list(DELIMITER_CANDIDATES) + [DELIMITER_AUTO]),
            make_param("valid_source", "Valid Codes From", "GPString", default=_MV_SOURCE_DOMAIN,
                       value_list=[_MV_SOURCE_DOMAIN, _MV_SOURCE_TABLE, _MV_SOURCE_LIST]),
            make_param("domain_name", "Domain Name", "GPString", required=False),
            make_param("lookup_table", "Lookup Table", "GPTableView", required=False,
                       enabled=False),
            make_param("lookup_field", "Lookup Field", "Field", required=False,
                       depends_on="lookup_table", enabled=False),
            make_param("value_list", "Value List", "GPString", required=False, multi_value=True,
                       enabled=False),
            make_param("case_sensitive", "Case sensitive", "GPBoolean", required=False,
                       default=True),
            make_param("explode", "Explode tokens", "GPBoolean", required=False, default=False),
            make_param("keep_geometry", "Keep geometry", "GPBoolean", required=False,
                       default=False, enabled=False),
            make_param("out_table", "Output Issues Table", "DETable", direction="Output"),
            make_param("out_explode", "Output Exploded", ["DETable", "DEFeatureClass"],
                       direction="Output", required=False, enabled=False),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("issue_count", "Issue Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        p = param_map(parameters)
        source = (param_text(p["valid_source"]) or _MV_SOURCE_DOMAIN).upper()
        p["domain_name"].enabled = source == _MV_SOURCE_DOMAIN
        p["lookup_table"].enabled = source == _MV_SOURCE_TABLE
        p["lookup_field"].enabled = source == _MV_SOURCE_TABLE
        p["value_list"].enabled = source == _MV_SOURCE_LIST
        explode = param_bool(p["explode"])
        p["keep_geometry"].enabled = explode
        p["out_explode"].enabled = explode
        if source == _MV_SOURCE_DOMAIN and param_text(p["in_table"]):
            try:  # validation must never fail because a dataset cannot be read yet
                desc = describe_dataset(param_text(p["in_table"]))
                p["domain_name"].filter.list = sorted(read_domains(desc["workspace"]))
            except Exception:
                pass
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        source = (param_text(p["valid_source"]) or _MV_SOURCE_DOMAIN).upper()
        if source == _MV_SOURCE_TABLE:
            if not param_text(p["lookup_table"]):
                p["lookup_table"].setErrorMessage(
                    "Lookup Table is required when Valid Codes From is TABLE.")
            elif not param_text(p["lookup_field"]):
                p["lookup_field"].setErrorMessage(
                    "Lookup Field is required when Valid Codes From is TABLE.")
        if source == _MV_SOURCE_LIST and not _mv_value_list(param_text(p["value_list"])):
            p["value_list"].setErrorMessage(
                "Value List is required when Valid Codes From is LIST.")
        if param_bool(p["explode"]) and not param_text(p["out_explode"]):
            p["out_explode"].setErrorMessage(
                "Output Exploded is required when Explode tokens is checked.")
        elif param_bool(p["explode"]) and find_duplicate_outputs(
                [param_text(p["out_table"]), param_text(p["out_explode"])]):
            p["out_explode"].setErrorMessage(
                "Output Exploded must be a different dataset from the Output Issues Table.")
        if param_bool(p["explode"]) and param_bool(p["keep_geometry"]) and                 param_text(p["in_table"]):
            try:  # validation must never fail because a dataset cannot be read yet
                is_table = not describe_dataset(param_text(p["in_table"]))["shape_type"]
            except Exception:
                is_table = False
            if is_table:
                p["keep_geometry"].setErrorMessage(
                    "Keep geometry needs a feature layer; the input is a table.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))

    # ------------------------------------------------------------------

    def _code_sets(self, p, desc, field, subtypes, collector):
        """Return ``fn(subtype code) -> CodeSet or None`` for the chosen source."""
        source = (param_text(p["valid_source"]) or _MV_SOURCE_DOMAIN).upper()
        if source == _MV_SOURCE_LIST:
            values = _mv_value_list(param_text(p["value_list"]))
            if not values:
                raise ToolError("LIST mode needs a value list.", "Enter the valid codes.")
            codes = CodeSet.from_values(values)
            if not codes.texts:  # only blank or invisible values
                raise ToolError("The Value List holds no valid code (only spaces or invisible "
                                "marks), so every token would be UNKNOWN_TOKEN.",
                                "Enter the valid codes.")
            # ; is left out: a Value List code holds ; only when it was written in quotes on purpose.
            joined = [t for t in codes.texts
                      if any(d in t for d in DELIMITER_CANDIDATES if d != u";")]
            if joined:
                collector.warning(
                    "{0} code(s) of the Value List contain one of the delimiter candidates "
                    ", | / or the Arabic comma or semicolon, such as '{1}'; each is checked as "
                    "ONE code. If they are several codes, enter one code per row of the Value "
                    "List (or separate them with ;).".format(len(joined), joined[0]))
            if codes.padded:
                collector.warning(
                    "{0} code(s) of the Value List had invisible marks (or other padding) at the "
                    "start or end; they are compared without them (tokens are trimmed too). "
                    "Retype those codes in the Value List.".format(codes.padded))
            return lambda _code: codes
        if source == _MV_SOURCE_TABLE:
            ldesc = describe_dataset(param_text(p["lookup_table"]))
            self._lookup_path = ldesc["catalog_path"]
            lfield, how = match_field(ldesc["fields"], param_text(p["lookup_field"]),
                                      label="lookup field", exact_name_first=True)
            collector.info(match_message(param_text(p["lookup_field"]), lfield, how))
            ltype = str(lfield.get("type") or "")
            if ltype.casefold() in _MV_NO_CODE_TYPES:
                raise ToolError("The lookup field {0} of {1} is a {2} field; it cannot hold "
                                "codes.".format(lfield["name"], ldesc["name"], ltype),
                                "Choose the text or numeric field that holds the codes.")
            rows = read_features(ldesc["input"], [lfield["name"]], geometry=False)
            # FLOAT (single) codes read back widened (0.1 -> 0.10000000149011612):
            # use the decimal the user typed.
            convert = float32_shortest if is_single_field(lfield) else (lambda v: v)
            if ltype.casefold() in _MV_NUMERIC_TYPES:
                # a numeric lookup field is compared numerically, as a numeric domain is
                # ("01", "+2" and "2.0" equal the codes 1 and 2; only ASCII numbers).
                numbers = [convert(r["attrs"][lfield["name"]]) for r in rows]
                numbers = list(dict.fromkeys(v for v in numbers if v is not None and v == v))
                codes = CodeSet(numbers, domain={"field_type": ltype, "codes": {}})
            else:
                codes = CodeSet.from_values(convert(r["attrs"][lfield["name"]]) for r in rows)
            if not codes.texts:  # refuse instead of flagging every token UNKNOWN_TOKEN
                raise ToolError("The lookup field {0} of {1} holds no valid code (only nulls, "
                                "blanks or invisible marks), so every token would be "
                                "UNKNOWN_TOKEN.".format(lfield["name"], ldesc["name"]),
                                "Choose the lookup field that holds the codes, or clear the "
                                "selection or definition query on the lookup table.")
            collector.info("{0} valid code(s) read from {1}.".format(len(codes.texts),
                                                                   ldesc["name"]))
            if ltype.casefold() in _MV_TEXT_FORM_TYPES:
                collector.warning(
                    "The lookup field {0} of {1} is a {2} field: its codes are compared as text, "
                    "in the form the table returns them, such as '{3}'. A token written another "
                    "way (another date format, no time, other case or no braces) is "
                    "UNKNOWN_TOKEN. Use a text lookup field that holds the codes as they are "
                    "written in the data.".format(lfield["name"], ldesc["name"], ltype,
                                                  sorted(codes.texts)[0]))
            if codes.padded:
                collector.warning(
                    "{0} code(s) of {1} had spaces or invisible marks at the start or end; they "
                    "are compared without them (tokens are trimmed too). Clean the lookup "
                    "table.".format(codes.padded, ldesc["name"]))
            return lambda _code: codes
        if source != _MV_SOURCE_DOMAIN:
            raise ToolError("Unknown source of valid codes '{0}'.".format(source),
                            "Choose DOMAIN, TABLE or LIST.")
        domains = read_domains(desc["workspace"])
        fallback = param_text(p["domain_name"])
        if fallback and fallback not in domains:
            raise ToolError("The domain '{0}' does not exist in {1}.".format(
                fallback, desc["workspace"]),
                "Choose one of: {0}.".format(", ".join(sorted(domains)) or "(no domains)"))
        cache = {}

        def for_subtype(code):
            name = domain_for_field(field["name"], field.get("domain"), subtypes, code) or fallback
            if not name:
                return None
            if name not in cache:
                dom = domains.get(name)
                if dom is None:
                    raise ToolError("The domain '{0}' assigned to {1} does not exist.".format(
                        name, field["name"]), "Choose a Domain Name or fix the assignment.")
                if dom.get("domain_type") == "Range":
                    raise ToolError("The domain '{0}' is a range domain.".format(name),
                                    "Use a coded-value domain, a lookup table or a value list.")
                cache[name] = CodeSet.from_domain(dom)
                if not cache[name].texts:
                    collector.warning(
                        "The domain {0} has no codes; every token checked against it is "
                        "reported as UNKNOWN_TOKEN. Add codes to the domain or choose another "
                        "source.".format(name))
                if cache[name].padded:
                    collector.warning(
                        "{0} code(s) of the domain {1} have spaces or invisible marks at the start "
                        "or end; they are compared without them (tokens are trimmed too). Clean "
                        "the domain.".format(cache[name].padded, name))
            return cache[name]

        if fallback:
            # True when a row of this subtype is checked against Domain Name (no domain of its own).
            self._uses_domain_name = lambda code: not domain_for_field(
                field["name"], field.get("domain"), subtypes, code)
        if not field.get("domain") and not fallback and not any(
                (e.get("domains") or {}).get(field["name"]) for e in
                (subtypes.get("subtypes") or {}).values()):
            raise ToolError("The field {0} has no domain and no Domain Name was given.".format(
                field["name"]), "Choose a Domain Name, or use TABLE or LIST as the source.")
        return for_subtype

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        explode = param_bool(p["explode"])
        out_explode = param_text(p["out_explode"])
        if explode and not out_explode:
            raise ToolError("Explode tokens is checked but no output was given.",
                            "Choose Output Exploded.")
        if explode:
            refuse_duplicate_outputs([param_text(p["out_table"]), out_explode])
        desc = describe_dataset(param_text(p["in_table"]))
        field, how = match_field(desc["fields"], param_text(p["code_field"]), label="code field",
                                 exact_name_first=True)
        collector.info(match_message(param_text(p["code_field"]), field, how))
        if str(field["type"]).casefold() not in ("string", "text"):
            raise ToolError("The code field {0} is not a text field.".format(field["name"]),
                            "Choose a text field that holds delimited codes.")
        keep_geometry = explode and param_bool(p["keep_geometry"])
        kind = kind_from_shape_type(desc["shape_type"]) if desc["shape_type"] else None
        if keep_geometry and kind is None:
            raise ToolError("Keep geometry needs a point, multipoint, line or polygon input; "
                            "{0} is a {1}.".format(desc["name"], desc["shape_type"] or "table"),
                            "Uncheck Keep geometry or use a point, line or polygon layer.")
        subtypes = read_subtypes(desc["catalog_path"])
        self._lookup_path = None
        self._uses_domain_name = None
        codes_for = self._code_sets(p, desc, field, subtypes, collector)
        # The lookup table is an input of every output check, and both
        # outputs are checked before anything is written.
        inputs = [desc["catalog_path"]] + ([self._lookup_path] if self._lookup_path else [])
        check_output_path(param_text(p["out_table"]), inputs)
        if explode:
            check_output_path(out_explode, inputs)
        carry = self._carry_fields(desc, field, out_explode, collector) if explode else []
        read_names = [field["name"]] + [f["name"] for f in carry]
        if subtypes["field"] and subtypes["field"] not in read_names:
            read_names.append(subtypes["field"])
        if keep_geometry and (desc.get("has_z") or desc.get("has_m")):
            # the exploded features are written in 2D (the geometry reader drops Z/M).
            collector.warning(
                "{0} has {1} values; the exploded output keeps the x,y geometry only (its Z "
                "and M values are dropped). Join the exploded rows back to the input with "
                "PARENT_OID if you need them.".format(
                    desc["name"], " and ".join(n for n, on in (("Z", desc.get("has_z")),
                                                             ("M", desc.get("has_m"))) if on)))
        rows = read_features(desc["input"], read_names, geometry=keep_geometry)
        values = [r["attrs"][field["name"]] for r in rows]
        delimiter = param_text(p["delimiter"]) or ";"
        if delimiter.upper() == DELIMITER_AUTO:
            code_texts = self._all_code_texts(rows, subtypes, codes_for)
            choice = delimiter_choice(values, code_texts,
                                      case_sensitive=param_bool(p["case_sensitive"], True))
            delimiter = choice["delimiter"]
            collector.info("Delimiter detected: '{0}'.".format(delimiter))
            if choice["plain_count"] and choice["plain"] != delimiter:
                collector.info("'{0}' is the most frequent candidate but occurs inside valid codes, "
                               "so it was not chosen.".format(choice["plain"]))
            if choice["reason"] == AUTO_SINGLE_CODES:
                collector.info("No candidate delimiter occurs outside the valid codes, so the values "
                               "are single codes; '{0}' is the first candidate that occurs in no "
                               "valid code.".format(delimiter))
            elif choice["reason"] == AUTO_ALL_INSIDE:
                collector.info("No candidate delimiter occurs outside the valid codes, and every "
                               "candidate occurs inside a valid code; ';' is used.")

        flags, exploded, nulls, blanks, no_domain = [], [], 0, 0, 0
        checked, domain_name_used = 0, False
        warned = set()
        progress = Progress("Checking tokens", len(rows))
        for row in sorted(rows, key=lambda r: r["oid"]):
            value = row["attrs"][field["name"]]
            progress.tick()
            if value is None:
                nulls += 1
                continue
            if is_blank_value(value):
                blanks += 1  # nothing to split: counted, not an EMPTY_TOKEN issue
                continue
            st_code = row["attrs"].get(subtypes["field"]) if subtypes["field"] else None
            codes = codes_for(st_code)
            if codes is None:
                no_domain += 1
                continue
            checked += 1
            if self._uses_domain_name is not None and self._uses_domain_name(st_code):
                domain_name_used = True
            if id(codes) not in warned:
                warned.add(id(codes))
                bad = codes.codes_containing(delimiter)
                if bad:
                    collector.warning("Code(s) {0} contain the delimiter '{1}' and cannot be "
                                      "validated. Use another delimiter.".format(
                                          ", ".join(bad), delimiter))
                if codes.case_twins and not param_bool(p["case_sensitive"], True):
                    collector.warning("Code(s) {0} differ only by case. In a case-insensitive run a "
                                      "token that matches one of them exactly is that code; a token "
                                      "that matches them only ignoring case is valid and stands for "
                                      "the first of them listed. Check Case sensitive to tell them "
                                      "apart.".format(", ".join(codes.case_twins)))
            f, e = check_multivalue(row["oid"], value, delimiter, codes,
                                    param_bool(p["case_sensitive"], True))
            flags.extend(f)
            for item in e:
                item["row"] = row
            exploded.extend(e)
        progress.close()
        if no_domain:
            collector.warning("{0} row(s) have no domain for {1} (subtype without domain) and "
                              "were neither checked nor exploded. Give a Domain Name to check them.".format(
                                  no_domain, field["name"]))
        fallback = param_text(p["domain_name"]) if self._uses_domain_name is not None else None
        if fallback and checked and not domain_name_used:
            collector.info("Domain Name '{0}' was not used: every row checked has a domain of its own "
                           "on {1} (Domain Name is used only where the field or the row's subtype has "
                           "none).".format(fallback, field["name"]))

        too_many = [i for i in flags + exploded if i["position"] > _MV_MAX_POSITION]
        if too_many:
            raise ToolError("Row {0} holds more than {1:,} tokens, more than the POSITION field "
                            "(a short integer) can number.".format(too_many[0]["oid"],
                                                                   _MV_MAX_POSITION),
                            "Split that value into shorter values first. Nothing was written.")

        cut, replaced = [0], [0]
        issues_folder = is_folder_workspace(split_catalog_path(param_text(p["out_table"]))[0])
        detail = [(f["oid"], f["position"], f["token"], f["issue"], f["suggested"]) for f in flags]
        stored = [(o, pos, cut_utf8_bytes(_mv_storable(tok, replaced), issues_folder, cut), iss,
                   cut_utf8_bytes(_mv_storable(sug, replaced), issues_folder, cut))
                  for o, pos, tok, iss, sug in detail]
        oid_spec = oid_output_field(param_text(p["out_table"]), [r[0] for r in stored], collector)
        stored = [(oid_field_value(oid_spec, r[0]),) + tuple(r[1:]) for r in stored]
        specs = [oid_spec, {"name": "POSITION", "type": "SHORT"},
                 {"name": "TOKEN", "type": "TEXT", "values": [r[2] for r in stored]},
                 {"name": "ISSUE", "type": "TEXT", "length": 16},
                 {"name": "SUGGESTED", "type": "TEXT", "values": [r[4] for r in stored]}]
        path, names = create_table(param_text(p["out_table"]), specs, inputs=inputs)
        insert_rows(path, [names[s["name"]] for s in specs], stored)
        if explode:
            try:
                cut[0] += self._write_explode(out_explode, desc, carry, exploded,
                                              kind if keep_geometry else None, inputs, collector,
                                              replaced)
            except Exception:
                # never leave the issues table of a run that failed behind
                try:
                    safe_delete(path, inputs)
                except Exception:
                    pass
                raise
        if replaced[0]:
            collector.warning(
                "{0} text value(s) hold a lone UTF-16 surrogate (half of a character pair, "
                "U+D800-U+DFFF), which no output table can store; it is written as U+FFFD (the "
                "replacement character) in the output{1}. Check the source text.".format(
                    replaced[0], " and in the report" if report else ""))
        if cut[0]:
            collector.warning(
                "{0} text value(s) are longer than {1} bytes in UTF-8 (an Arabic letter takes 2 "
                "bytes), the most a dBASE/shapefile text field holds; they are cut to {1} bytes "
                "in the output{2}. Write the outputs to a file geodatabase to keep the full "
                "text.".format(cut[0], SHAPEFILE_MAX_TEXT,
                               " (the report keeps the full text)" if report else ""))
        collector.info("{0} row(s) read, {1} null, {2} blank; {3} token issue(s).{4}".format(
            len(rows), nulls, blanks, len(flags),
            " {0} row(s) not checked (no domain).".format(no_domain) if no_domain else ""))
        if flags:
            collector.warning("{0} token issue(s) in {1} row(s); see {2}.".format(
                len(flags), len(set(f["oid"] for f in flags)), path))
        summary = multivalue_summary(flags, exploded, len(rows), nulls, delimiter, blanks, no_domain)
        for written in write_report(report, summary,
                                    ["SRC_OID", "POSITION", "TOKEN", "ISSUE", "SUGGESTED"], detail):
            collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "issue_count", str(len(flags)))
        flush_messages(collector)

    @staticmethod
    def _all_code_texts(rows, subtypes, codes_for):
        """Every valid code text the rows can be checked against (for AUTO detection)."""
        keys = set()
        for row in rows:
            keys.add(row["attrs"].get(subtypes["field"]) if subtypes["field"] else None)
        sets = {}
        for key in keys:
            try:
                cs = codes_for(key)
            except ToolError:
                continue          # reported when a row is checked
            except TypeError:
                continue
            if cs is not None:
                sets[id(cs)] = cs
        return [t for cs in sets.values() for t in cs.texts]

    def _carry_fields(self, desc, code_field, out_path, collector):
        """Input attributes copied to the explode output (types AddField can create).

        Fields named like the tool's own output fields are carried too; they are
        renamed in ``_write_explode``. Every attribute field that is not
        carried (a type AddField cannot create, a TimeOnly / TimestampOffset field
        in a shapefile or dBASE output, a non-editable field other than the
        ObjectID, shape and GlobalID) is named in a warning. In a shapefile or
        dBASE output a GUID, GlobalID (PARENT_GUID), Big Integer or Date Only field
        is carried as a copy with ``folder_type`` / ``folder_length`` set
        (``_MV_FOLDER_CONVERSIONS``) and named in a warning, before anything is
        written."""
        folder = is_folder_workspace(split_catalog_path(out_path or "")[0])
        out, dropped = [], []
        # The geodatabase names its length and area fields after the shape field (geom_Length and
        # geom_Area for a shape field named geom): they are maintained too.
        measures = set(_MV_SHAPE_MEASURES) | set(
            (f["name"] + suffix).casefold() for f in desc["fields"] if f["type"] == "Geometry"
            for suffix in ("_length", "_area"))
        converted = []

        def carried(f, shown):
            if folder and f["type"] in _MV_FOLDER_CONVERSIONS:
                keyword, width, how = _MV_FOLDER_CONVERSIONS[f["type"]]
                converted.append("{0} ({1})".format(shown, how))
                return dict(f, folder_type=keyword, folder_length=width)
            return f

        for f in desc["fields"]:
            if f["type"] == "GlobalID":
                if not any(g["type"] == "GlobalID" for g in out):  # one PARENT_GUID
                    out.append(carried(f, "PARENT_GUID from the GlobalID " + f["name"]))
                continue
            if f["type"] in ("OID", "Geometry") or f["name"] == desc.get("oid_field") or (
                    not f.get("editable", True) and f["name"].casefold() in measures):
                continue  # system fields, maintained by the geodatabase
            keyword = _MV_ADDFIELD_KEYWORDS.get(f["type"])
            if keyword is None or not f.get("editable", True) or (
                    folder and keyword in _MV_GDB_ONLY_KEYWORDS):
                dropped.append("{0} ({1})".format(f["name"], f["type"]))
                continue
            out.append(carried(f, f["name"]))
        if converted:
            collector.warning(
                "A shapefile or dBASE table cannot hold {0} field(s) of {1} in their type, so the "
                "exploded output writes them in another type: {2}. Write the exploded output to a "
                "file geodatabase to keep their types.".format(
                    len(converted), desc["name"], "; ".join(converted)))
        if dropped:
            collector.warning(
                "{0} input field(s) are not carried to the exploded output: {1}. Their type "
                "cannot be created there or they are not editable; join "
                "them back with PARENT_OID if needed.".format(len(dropped), ", ".join(dropped)))
        return out

    def _write_explode(self, out_path, desc, carry, exploded, kind, inputs, collector,
                       replaced=None):
        guid = [f for f in carry if f["type"] == "GlobalID"]
        attrs = [f for f in carry if f["type"] != "GlobalID"]
        folder = is_folder_workspace(split_catalog_path(out_path)[0])
        cut = [0]

        def fit(value):
            return cut_utf8_bytes(_mv_storable(value, replaced), folder, cut)

        def width_of(value):  # the same cut, not counted (counted once, when the rows are written)
            return cut_utf8_bytes(_mv_storable(value), folder, [0])

        def carry_value(f, value):  # a carried value as its output field stores it
            if f.get("folder_type"):
                return _mv_folder_value(f["type"], value)
            return value if f["type"] == "GlobalID" else fit(value)

        oid_spec = oid_output_field(out_path, [e["oid"] for e in exploded], collector,
                                    name="PARENT_OID")
        specs = [dict(oid_spec), {"name": "POSITION", "type": "SHORT"},
                 {"name": "TOKEN", "type": "TEXT", "values": [width_of(e["token"]) for e in exploded]},
                 {"name": "DESCRIPTION", "type": "TEXT",
                  "values": [width_of(e["description"]) for e in exploded]},
                 {"name": "TOKEN_STATUS", "type": "TEXT", "length": 16}]
        if guid:
            spec = {"name": "PARENT_GUID", "type": guid[0].get("folder_type") or "GUID"}
            if guid[0].get("folder_length"):
                spec["length"] = guid[0]["folder_length"]
            specs.append(spec)
        own = len(specs)
        out_domains = read_output_domains(out_path)
        for f in attrs:
            spec = {"name": f["name"], "type": f.get("folder_type") or _MV_ADDFIELD_KEYWORDS[f["type"]],
                    "alias": f.get("alias")}
            keep_field_domain(spec, f.get("domain"), out_domains)
            if f.get("folder_type"):
                if f.get("folder_length"):
                    spec["length"] = f["folder_length"]
            elif spec["type"] == "TEXT":
                spec["length"] = f.get("length") or None
                spec["values"] = [width_of(e["row"]["attrs"].get(f["name"])) for e in exploded]
            specs.append(spec)
        # an input field named like one of the tool's own fields (DESCRIPTION,
        # POSITION ...) or clashing once cut to 10 bytes (about 5 Arabic letters) in a folder output is carried
        # under a unique name (DESCRIPTION_1 ...), never dropped; each rename is reported.
        specs, renamed = unique_field_specs(out_path, specs, fixed=own)
        if renamed:
            collector.warning(
                "{0} input field(s) are written under another name in {1} because the name is "
                "taken by another output field: {2}.".format(
                    len(renamed), out_path,
                    "; ".join("{0} -> {1}".format(a, b) for a, b in renamed)))
        if kind:
            path, names = create_feature_class(out_path, kind, desc["sr_object"], specs, inputs)
        else:
            path, names = create_table(out_path, specs, inputs=inputs)
        rows = []
        for e in exploded:
            values = [oid_field_value(oid_spec, e["oid"]), e["position"], e["token"],
                      e["description"], e["status"]]
            values[2], values[3] = fit(values[2]), fit(values[3])
            if guid:
                values.append(carry_value(guid[0], e["row"]["attrs"].get(guid[0]["name"])))
            values += [carry_value(f, e["row"]["attrs"].get(f["name"])) for f in attrs]
            rows.append((e["row"]["shape"], values) if kind else values)
        wkid = desc["sr"]["wkid"] if (kind and desc["sr"]) else None
        # A shapefile or dBASE table cannot store an empty number: the shared writer stores 0
        # (and "" for empty text). Only the carried input fields are named; the tool's own
        # DESCRIPTION is empty on purpose for a token that is not a valid code.
        empty = set()
        insert_rows(path, [names[s["name"]] for s in specs], rows, kind=kind, wkid=wkid,
                    null_fields=empty)
        collector.info("{0} token row(s) written to {1}.".format(len(rows), path))
        note = folder_null_number_warning(
            path, specs[own:], names, empty,
            "The input keeps them empty; join it back with PARENT_OID to tell them apart.")
        if note:
            collector.warning(note)
        if folder:
            lost = [s for s in specs if s.get("lost_domain")]
            if lost:
                collector.warning(
                    "A shapefile or dBASE table cannot hold domains, so these copied fields have "
                    "no domain in {0} and show codes instead of descriptions: {1}. Write the "
                    "exploded output to a geodatabase (the input's geodatabase keeps the domains) "
                    "if you need them.".format(path, ", ".join(
                        "{0} ({1})".format(names.get(s["name"], s["name"]), s["lost_domain"])
                        for s in lost)))
        else:
            lost = lost_domain_warning(specs, path)
            if lost:
                collector.warning(lost)
        return cut[0]


# ==========================================================================
# quality/near_miss_vocab_tool.py
# ==========================================================================
# Near-Miss Value Checker: the ArcGIS Pro tool (adapter).

_VOCAB_SOURCE_TABLE = "TABLE"
_VOCAB_SOURCE_FILE = "FILE"
_VOCAB_SOURCE_DOMAIN = "DOMAIN"
_VOCAB_SOURCES = (_VOCAB_SOURCE_TABLE, _VOCAB_SOURCE_FILE, _VOCAB_SOURCE_DOMAIN)
_VOCAB_COLUMNS = ("FIELD", "VALUE", "COUNT", "ISSUE", "SUGGESTION", "SCORE", "SAMPLE_OIDS",
                  "VOCAB", "DETAIL")
# Seconds between two reads of arcpy.env.isCancelled while values are checked.
_VOCAB_CANCEL_POLL = 0.5


def _vocab_stop_if_cancelled():
    """End the run when the user has cancelled it. ``execute`` sets ``autoCancelling`` to
    False, so a cancellation sets ``arcpy.env.isCancelled`` instead of ending the script on
    the current line (which could happen while the output table is being written)."""
    try:
        cancelled = bool(arcpy.env.isCancelled)
    except Exception:       # an arcpy without the property
        cancelled = False
    if cancelled:
        raise ToolError("The tool was cancelled.",
                        "No output table or report was written. Run the tool again when you "
                        "are ready.")


def _vocab_is_text(field):
    return str(field.get("type")).casefold() in ("string", "text")


class NearMissVocabularyChecker(object):
    """Check text fields against a controlled vocabulary and suggest near-miss corrections."""

    DOC = {
        "summary": "Checks one or more text fields against a controlled vocabulary (a field of "
                   "a table, a .txt or .csv word list, or each field's coded-value domain) and "
                   "lists every distinct value that is not in it: spelling variants that only "
                   "differ in case, spaces or Arabic letter forms (NORMALISATION), near-miss "
                   "spellings with the closest allowed value and a similarity score "
                   "(NEAR_MISS), and values with no close match (UNKNOWN). Read-only.",
        "usage": "A value conforms when it equals a vocabulary entry exactly. Otherwise both "
                 "are normalised: Unicode NFC (a decomposed spelling, as exported on macOS or "
                 "copied from a PDF, equals its precomposed form), control and invisible characters removed "
                 "(ZWNJ and ZWJ included, whatever the Arabic option), spaces trimmed and "
                 "collapsed, Arabic-Indic digits read as ASCII digits, case ignored (option; "
                 "Python casefold, so also ß = ss and ligatures such as the fi ligature = fi) and "
                 "Arabic letters folded (option: tashkeel, tatweel, alef forms, alef maqsura to "
                 "yeh, Persian kaf and yeh, presentation forms; teh marbuta to heh only when "
                 "chosen). Hamza on waw or yeh (U+0624, U+0626) is NOT folded: it is a letter "
                 "of its own, so a dropped hamza is a near miss at best (0.75 for a 4-letter "
                 "word, UNKNOWN at the default cutoff). "
                 "Equal after normalisation = NORMALISATION (score 1). When such a "
                 "value differs from its suggestion only in invisible characters (for example "
                 "RLM U+200F or a zero width space U+200B), in Unicode composition, in space "
                 "forms (NBSP U+00A0 or another space than U+0020, one for one) or in look-alike "
                 "letter forms (Arabic presentation forms, Persian kaf and yeh), DETAIL says so "
                 "(\"Differs only in space forms (U+00A0).\"), also for a NEAR_MISS; vocabulary entries that contain invisible characters are named in a "
                 "message, because a suggestion copies them into the data; entries that contain control "
                 "characters (such as U+0001) are named in a warning for the same reason, and "
                 "when a value differs from its suggestion only by such characters DETAIL says \"Differs only in control characters (U+0001).\".\n\n"
                 "Otherwise the similarity of the normalised texts is Python's "
                 "difflib.SequenceMatcher ratio (2 x matching characters / total characters, "
                 "autojunk off, shorter text first). The best entry at or above the cutoff is "
                 "the suggestion (NEAR_MISS); among equal scores an entry whose numbers do not "
                 "differ from the value's comes first, then code-point order, and "
                 "the other tied entries are listed in DETAIL (the first 10, then \"... and N "
                 "more\"). Below the cutoff the value is "
                 "UNKNOWN. Example: with the vocabulary Riyadh and Jeddah and cutoff 0.8, "
                 "'Riyad' suggests Riyadh (0.909) and 'Dammam' is UNKNOWN.\n\n"
                 "Digits count as letters in the score, so 'Block 21' can suggest 'Block 12' "
                 "(0.875). When both texts contain numbers and the numbers differ, DETAIL says "
                 "so; turn on Numbers must match to never suggest such an entry. Only runs of "
                 "digits are compared: letters in a code (3B against 3C) are not protected, and "
                 "1,000, 12.0 or 012 count as other numbers than 1000 or 12.\n\n"
                 "Null, empty and whitespace-only values are skipped and counted in the report. "
                 "A value that is not blank but empty once normalised (tatweel or tashkeel only) "
                 "is UNKNOWN, and DETAIL says it is empty once normalised. "
                 "Table and file vocabulary entries are trimmed; coded-value domain codes are "
                 "used exactly as stored (subtype-level domains are honoured). Each domain's "
                 "number of allowed codes is reported. Rows with no coded-value domain (for "
                 "example rows of a subtype without one) are not checked, with a warning; a "
                 "coded-value domain with no codes (or only blank codes) is named in a warning "
                 "and its rows are not checked; and the run is refused when no row read has a "
                 "coded-value domain with codes. A .txt file has one value per line; a .csv "
                 "file has a header row and the column named in Vocabulary Column (default the "
                 "first column); its delimiter (comma, semicolon, tab or vertical bar) is "
                 "detected from the header row and reported. A row with more cells than the "
                 "header (usually a value with an unquoted delimiter, such as King Fahd Road, "
                 "North) gives a warning with the count and the first such line; in a file with "
                 "a one-column header the whole line is read as one value, as written (quotes "
                 "included), otherwise the extra "
                 "cells are ignored. A .txt line ends only at a line feed or carriage return. "
                 "When values are reported and the "
                 "first of several columns was used by default, a warning names the columns; "
                 "Vocabulary Column set for a .txt file is ignored with a warning. "
                 "Files must be UTF-8: other encodings, and text with NUL characters (UTF-16 "
                 "saved without a byte-order mark), are refused.\n\n"
                 "The output has one row per field and distinct value that is not in the "
                 "vocabulary, with its row count and up to 10 sample ObjectIDs. The tool never "
                 "edits data: apply the suggestions yourself (for example with Calculate Field "
                 "or in an edit session) after reviewing them. The report Summary counts "
                 "values per field cell (one per row and checked field), so with several "
                 "fields its value counts add up to more than Rows read. A .csv report is "
                 "written as two files, <name>_summary.csv and <name>_detail.csv. The run time grows with the "
                 "number of distinct values times the number of vocabulary entries (4.87 s for "
                 "19,871 distinct values against 3,000 entries is a best case; 25,000 values that "
                 "almost match many entries can take a minute or more, and 3,000 values against "
                 "50,000 similar entries took about 9 minutes in one measurement; Cancel stops "
                 "the run between two values and writes nothing). Long texts are slow: the time "
                 "for one comparison grows about with the square of the text length or faster "
                 "(two near-identical texts of 10,000 characters took about 2 minutes in one "
                 "measurement, and Cancel cannot stop a single comparison). Selections and "
                 "definition queries on the input layer and on a vocabulary layer are "
                 "honoured.\n\nIn a dBASE table or shapefile output (text fields of at most 254 "
                 "bytes in UTF-8, an Arabic letter takes 2 bytes; field names of at most 10: "
                 "SAMPLE_OIDS becomes SAMPLE_OID) longer "
                 "texts are cut to 254 bytes (never in the middle of a letter) and a warning says how many values were cut; "
                 "two values that differ only after the cut then look the same in the table; "
                 "the report keeps the full text. If writing the output fails part-way, the "
                 "unfinished table is deleted.\n\nControl characters (U+0000 to U+001F "
                 "except tab, line feed and carriage return) are kept in the output table; "
                 "an Excel report cannot hold them, so it shows each one as <U+XXXX> and a "
                 "warning names them; a CSV report does the same. An Excel cell holds at most "
                 "32,767 characters: a longer text is cut in the Excel report, the cut is marked "
                 "and a warning gives the count (a CSV report keeps the full text). A CSV report "
                 "also puts an "
                 "apostrophe (') before a text that starts with =, @, +, -, tab or carriage "
                 "return (except a plain number such as -5), so that Excel does not run it "
                 "as a formula.",
        "params": {
            "in_table": "Layer or table with the text fields to check.",
            "fields": "Text fields to check. Each is checked separately against the vocabulary.",
            "vocab_source": "TABLE: a field of a table or layer. FILE: a .txt or .csv word "
                            "list. DOMAIN: the coded-value domain of each checked field "
                            "(field or subtype level).",
            "vocab_table": "TABLE source: table or layer holding the allowed values.",
            "vocab_field": "TABLE source: text field with the allowed values.",
            "vocab_file": "FILE source: UTF-8 .txt file (one value per line) or .csv file "
                          "(header row; comma, semicolon, tab or vertical bar delimiter, "
                          "detected from the header).",
            "vocab_column": "FILE source, .csv only: header name of the column with the "
                            "allowed values. Default: the first column. Ignored, with a "
                            "warning, for a .txt file (one value per line, no header).",
            "cutoff": "Lowest similarity (0 to 1) for a NEAR_MISS suggestion. Default 0.8.",
            "ignore_case": "Ignore upper/lower case when comparing (a case-only difference is "
                           "then NORMALISATION).",
            "normalise_arabic": "Fold Arabic letter variants, tashkeel and tatweel before "
                                "comparing.",
            "fold_teh_marbuta": "Also treat teh marbuta and heh as the same letter (only with "
                                "Normalise Arabic letters).",
            "numbers_must_match": "When both the value and an entry contain numbers and the "
                                  "numbers differ, never suggest that entry (Block 21 is not a "
                                  "near miss of Block 12; Gate 1 can still suggest Gate). "
                                  "Without it such a suggestion is made and DETAIL says the "
                                  "numbers differ. Only digit runs are compared: letters in a "
                                  "code (3B, 3C), separators (1,000, 12.0) and leading zeros "
                                  "(012) are not handled.",
            "out_table": "Output table: FIELD, VALUE, COUNT, ISSUE, SUGGESTION, SCORE, "
                         "SAMPLE_OIDS, VOCAB, DETAIL.",
            "out_report": "Optional report. Excel (.xlsx): one workbook with a Summary and a Detail "
                          "sheet. CSV (.csv): two files next to each other, <name>_summary.csv and "
                          "<name>_detail.csv; no file called <name>.csv is written.",
            "issue_count": "Number of distinct non-conforming values (rows of the output "
                           "table; derived).",
        },
        "tags": ["vocabulary", "spelling", "fuzzy", "gazetteer", "Arabic", "quality"],
    }

    def __init__(self):
        self.label = "Near-Miss Value Checker"
        self.description = ("Checks text fields against a controlled vocabulary and suggests the "
                            "closest allowed value for near-miss spellings (v"
                            + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_table", "Input Table", ["GPFeatureLayer", "GPTableView"]),
            make_param("fields", "Fields to Check", "Field", multi_value=True,
                       depends_on="in_table", value_list=["Text"]),
            make_param("vocab_source", "Vocabulary Source", "GPString",
                       default=_VOCAB_SOURCE_TABLE, value_list=list(_VOCAB_SOURCES)),
            make_param("vocab_table", "Vocabulary Table", ["GPFeatureLayer", "GPTableView"],
                       required=False),
            make_param("vocab_field", "Vocabulary Field", "Field", required=False,
                       depends_on="vocab_table", value_list=["Text"]),
            make_param("vocab_file", "Vocabulary File", "DEFile", required=False,
                       value_list=["txt", "csv"], enabled=False),
            make_param("vocab_column", "Vocabulary Column", "GPString", required=False,
                       enabled=False),
            make_param("cutoff", "Similarity Cutoff", "GPDouble", required=False,
                       default=VOCAB_DEFAULT_CUTOFF),
            make_param("ignore_case", "Ignore case", "GPBoolean", required=False, default=True),
            make_param("normalise_arabic", "Normalise Arabic letters", "GPBoolean",
                       required=False, default=True),
            make_param("fold_teh_marbuta", "Treat teh marbuta as heh", "GPBoolean",
                       required=False, default=False),
            make_param("numbers_must_match", "Numbers must match", "GPBoolean", required=False,
                       default=False),
            make_param("out_table", "Output Table", "DETable", direction="Output"),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("issue_count", "Issue Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        p = param_map(parameters)
        source = (param_text(p["vocab_source"]) or _VOCAB_SOURCE_TABLE).upper()
        p["vocab_table"].enabled = source == _VOCAB_SOURCE_TABLE
        p["vocab_field"].enabled = source == _VOCAB_SOURCE_TABLE
        p["vocab_file"].enabled = source == _VOCAB_SOURCE_FILE
        p["vocab_column"].enabled = source == _VOCAB_SOURCE_FILE
        p["fold_teh_marbuta"].enabled = param_bool(p["normalise_arabic"], True)
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        source = (param_text(p["vocab_source"]) or _VOCAB_SOURCE_TABLE).upper()
        if source == _VOCAB_SOURCE_TABLE:
            if not param_text(p["vocab_table"]):
                p["vocab_table"].setIDMessage("ERROR", 735)
            if not param_text(p["vocab_field"]):
                p["vocab_field"].setIDMessage("ERROR", 735)
        if source == _VOCAB_SOURCE_FILE and not param_text(p["vocab_file"]):
            p["vocab_file"].setIDMessage("ERROR", 735)
        if source == _VOCAB_SOURCE_FILE and param_text(p["vocab_column"]) and \
                (param_text(p["vocab_file"]) or "").casefold().endswith(".txt"):
            p["vocab_column"].setWarningMessage(
                "A .txt word list has one value per line and no header, so Vocabulary Column "
                "is ignored. Clear it, or save the list as .csv with a header row.")
        value = p["cutoff"].value
        if value is not None and not (0.0 < float(value) <= 1.0):
            p["cutoff"].setErrorMessage("The similarity cutoff must be greater than 0 and at "
                                        "most 1 (for example 0.8).")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        # Esri: with autoCancelling True (the default) a cancellation ends the script on the
        # current line, possibly while the output table is written. With False the tool reads
        # arcpy.env.isCancelled between values (_vocab_stop_if_cancelled) and stops cleanly.
        try:
            previous = arcpy.env.autoCancelling
            arcpy.env.autoCancelling = False
        except Exception:
            previous = None
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        finally:
            if previous is not None:
                try:
                    arcpy.env.autoCancelling = previous
                except Exception:
                    pass

    # ------------------------------------------------------------------

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        source = (param_text(p["vocab_source"]) or _VOCAB_SOURCE_TABLE).upper()
        if source not in _VOCAB_SOURCES:
            raise ToolError("Unknown vocabulary source '{0}'.".format(source),
                            "Choose one of: {0}.".format(", ".join(_VOCAB_SOURCES)))
        cutoff = param_number(p["cutoff"], VOCAB_DEFAULT_CUTOFF)
        if cutoff is None or not (0.0 < cutoff <= 1.0):
            raise ToolError("The similarity cutoff {0} is outside 0 to 1.".format(cutoff),
                            "Use a value greater than 0 and at most 1, for example 0.8.")
        options = {"ignore_case": param_bool(p["ignore_case"], True),
                   "normalise_arabic": param_bool(p["normalise_arabic"], True)}
        options["fold_teh_marbuta"] = options["normalise_arabic"] and \
            param_bool(p["fold_teh_marbuta"], False)
        options["numbers_must_match"] = param_bool(p["numbers_must_match"], False)

        desc = describe_dataset(param_text(p["in_table"]))
        fields = []
        for wanted in param_list(p["fields"]):
            field, how = match_field(desc["fields"], wanted, label="field to check",
                                     exact_name_first=True)
            collector.info(match_message(wanted, field, how))
            if not _vocab_is_text(field):
                raise ToolError("The field '{0}' is not a text field.".format(field["name"]),
                                "Choose text fields only.")
            if field["name"] not in [f["name"] for f in fields]:
                fields.append(field)
        if not fields:
            raise ToolError("No field to check was given.", "Choose one or more text fields.")

        inputs = [desc["catalog_path"]]
        vocab_desc = None
        if source == _VOCAB_SOURCE_TABLE:
            if not param_text(p["vocab_table"]) or not param_text(p["vocab_field"]):
                raise ToolError("The TABLE vocabulary source needs a vocabulary table and field.",
                                "Choose Vocabulary Table and Vocabulary Field.")
            vocab_desc = describe_dataset(param_text(p["vocab_table"]))
            inputs.append(vocab_desc["catalog_path"])
        elif source == _VOCAB_SOURCE_FILE:
            vocab_path = param_text(p["vocab_file"])
            if not vocab_path:
                raise ToolError("The FILE vocabulary source needs a vocabulary file.",
                                "Choose a .txt or .csv Vocabulary File.")
            if not vocab_path.casefold().endswith((".txt", ".csv")):
                raise ToolError("The vocabulary file '{0}' is not a .txt or .csv file.".format(
                    vocab_path), "Save the word list as UTF-8 .txt or .csv.")
            inputs.append(vocab_path)
        out_path = param_text(p["out_table"])
        check_output_path(out_path, inputs)  # refuse output == input before any work

        # Vocabularies: one shared list (TABLE/FILE) or one per coded-value domain.
        vocabularies = {}
        file_info = {}  # FILE source, .csv: delimiter, header and column used
        if source == _VOCAB_SOURCE_TABLE:
            vfield, how = match_field(vocab_desc["fields"], param_text(p["vocab_field"]),
                                      label="vocabulary field", exact_name_first=True)
            collector.info(match_message(param_text(p["vocab_field"]), vfield, how))
            if not _vocab_is_text(vfield):
                raise ToolError("The vocabulary field '{0}' is not a text field.".format(
                    vfield["name"]), "Choose a text field for the vocabulary.")
            vrows = read_features(vocab_desc["input"], [vfield["name"]], geometry=False)
            vocabularies[None] = Vocabulary(
                [r["attrs"][vfield["name"]] for r in vrows], strip=True,
                name=u"{0}.{1}".format(vocab_desc["name"], vfield["name"]), **options)
        elif source == _VOCAB_SOURCE_FILE:
            entries = read_vocabulary_file(vocab_path, param_text(p["vocab_column"]), file_info)
            column = param_text(p["vocab_column"])
            if column and not vocab_path.casefold().endswith(".csv"):
                first = next((e for e in entries if e is not None and e.strip()), None)
                as_header = first is not None and first.strip().casefold() == column.strip().casefold()
                collector.warning(
                    u"Vocabulary Column '{0}' was ignored: a .txt word list has one value per "
                    u"line and no header{1}. To use a header row, save the list as .csv.".format(
                        column, u", so its first line '{0}' is used as an allowed value; delete "
                        u"that line if it is a header".format(first.strip()) if as_header else u""))
            if file_info.get("long_rows"):
                self._report_long_rows(file_info, vocab_path, collector)
            if file_info:
                collector.info(u"Vocabulary file {0}: {1}-delimited CSV with the columns {2}; "
                               u"column '{3}' used.".format(
                                   vocab_path, vocab_delimiter_name(file_info["delimiter"]),
                                   u", ".join(file_info["header"]) or u"(none)",
                                   file_info["column"] or u""))
            vocabularies[None] = Vocabulary(entries, strip=True,
                                            name=os.path.basename(vocab_path.replace("\\", "/")),
                                            **options)
        domains, subtypes = {}, {"field": "", "subtypes": {}}
        if source == _VOCAB_SOURCE_DOMAIN:
            domains = read_domains(desc["workspace"])
            subtypes = read_subtypes(desc["catalog_path"])
        else:
            vocab = vocabularies[None]
            if not len(vocab):
                raise ToolError("The vocabulary '{0}' has no values.".format(vocab.name),
                                "Choose a vocabulary table, field or file that lists the "
                                "allowed values.")
            collector.info("Vocabulary {0}: {1} allowed value(s).".format(vocab.name, len(vocab)))
            self._report_collisions(vocab, collector)

        names = [f["name"] for f in fields]
        read_names = list(names)
        st_field = subtypes.get("field") or ""
        if st_field and st_field not in read_names:
            read_names.append(st_field)
        rows = read_features(desc["input"], read_names, geometry=False)
        collector.info("{0} row(s) read from {1}.".format(len(rows), desc["name"]))

        results, totals = [], {}
        no_domain = 0
        checked = 0
        # DOMAIN: rows whose coded-value domain has no usable code (none, or only blank ones) are
        # not checked: every value would come out UNKNOWN and hide the empty domain.
        empty_rows = 0
        empty_domains = []
        checked_groups = 0
        for field in fields:
            name = field["name"]
            if source == _VOCAB_SOURCE_DOMAIN and not self._has_coded_domain(field, domains,
                                                                             subtypes):
                collector.warning("The field {0} has no coded-value domain (at field or "
                                  "subtype level), so it was not checked.".format(name))
                continue
            checked += 1
            groups = self._group_rows(rows, field, source, domains, subtypes, st_field)
            if source == _VOCAB_SOURCE_DOMAIN:
                skipped = len(groups.pop(None, []))
                no_domain += skipped
                if skipped:
                    collector.warning("{0}: {1} row(s) have no coded-value domain (at field "
                                      "or subtype level) and were not checked.".format(
                                          name, skipped))
            for dom_name in sorted(groups, key=lambda d: (d is not None, d or u"")):
                pairs = groups[dom_name]
                if source == _VOCAB_SOURCE_DOMAIN:
                    if dom_name not in vocabularies:
                        vocabularies[dom_name] = Vocabulary(
                            domains[dom_name]["codes"].keys(), strip=False, name=dom_name,
                            **options)
                        if len(vocabularies[dom_name]):
                            collector.info("Vocabulary {0}: {1} allowed value(s).".format(
                                dom_name, len(vocabularies[dom_name])))
                            self._report_collisions(vocabularies[dom_name], collector)
                    vocab = vocabularies[dom_name]
                    if not len(vocab):
                        empty_rows += len(pairs)
                        if dom_name not in empty_domains:
                            empty_domains.append(dom_name)
                        collector.warning(self._empty_domain_text(vocab, dom_name, name, len(pairs)))
                        continue
                else:
                    vocab = vocabularies[None]
                checked_groups += 1
                distinct = len(set(v for _o, v in pairs))
                progress = Progress("Checking {0}".format(name), distinct)
                last_poll = [time.time()]

                def step(_n, progress=progress, last_poll=last_poll):
                    progress.tick(1)
                    now = time.time()
                    if now - last_poll[0] >= _VOCAB_CANCEL_POLL:
                        last_poll[0] = now
                        _vocab_stop_if_cancelled()
                _vocab_stop_if_cancelled()
                found, stats = check_field_values(pairs, vocab, name, cutoff, progress=step)
                progress.close()
                results.extend(found)
                merge_stats(totals, stats)
        if not checked:
            raise ToolError("None of the chosen fields has a coded-value domain.",
                            "Choose fields with coded-value domains, or use the TABLE or FILE "
                            "vocabulary source.")
        if empty_domains and not checked_groups:
            if no_domain:
                raise ToolError(
                    "No row read has a coded-value domain with codes: {0} row(s) have no "
                    "coded-value domain and the coded-value domain{1} {2} {3} no codes, so no "
                    "value of the chosen field(s) could be checked.".format(
                        no_domain, "s" if len(empty_domains) > 1 else "",
                        ", ".join(empty_domains), "have" if len(empty_domains) > 1 else "has"),
                    "Add the allowed codes to the domain, check the subtype codes of the rows "
                    "(and any selection or definition query), or use the TABLE or FILE "
                    "vocabulary source.")
            raise ToolError(
                "The coded-value domain{0} {1} {2} no codes, so no value of the chosen field(s) "
                "could be checked.".format("s" if len(empty_domains) > 1 else "",
                                           ", ".join(empty_domains),
                                           "have" if len(empty_domains) > 1 else "has"),
                "Add the allowed codes to the domain (Domains view, or the Add Coded Value To "
                "Domain tool) and run the tool again, or use the TABLE or FILE vocabulary source.")
        if source == _VOCAB_SOURCE_DOMAIN and no_domain and not checked_groups:
            raise ToolError(
                "None of the {0} row(s) read has a coded-value domain for the chosen field(s), "
                "so no value could be checked.".format(len(rows)),
                "The chosen field(s) have a coded-value domain only in subtypes that none of "
                "these rows belongs to. Check the subtype codes of the rows (and any selection or definition query), or use the TABLE "
                "or FILE vocabulary source.")
        compared = totals.get("rows", 0) - totals.get("blank", 0)
        totals["rows"] = len(rows)
        _vocab_stop_if_cancelled()      # last point before anything is written

        results = sort_results(results, names)
        self._write_output(out_path, results, inputs, collector, report)
        self._report_controls(results, report, collector)
        if results:
            rows_hit = sum(r["count"] for r in results)
            collector.warning("{0} distinct value(s) in {1} row(s) are not in the vocabulary; "
                              "see {2}.".format(len(results), rows_hit, out_path))
            if source == _VOCAB_SOURCE_FILE and len(file_info.get("header") or ()) > 1 and \
                    not param_text(p["vocab_column"]):
                collector.warning(
                    u"Vocabulary Column was not set, so the first of the {0} columns of the "
                    u"{1}-delimited file {2} ('{3}') was used as the vocabulary. If the allowed "
                    u"values are in another column, set Vocabulary Column to one of: {4}.".format(
                        len(file_info["header"]), vocab_delimiter_name(file_info["delimiter"]),
                        os.path.basename(vocab_path.replace("\\", "/")), file_info["column"],
                        u", ".join(file_info["header"])))
        elif not compared:
            collector.info("No value was checked: {0} row(s) read, and every value that "
                           "could be checked is null or blank.".format(len(rows)))
        else:
            collector.info("Every checked value is in the vocabulary.")
        extra = [("Input", desc["name"]), ("Fields checked", ", ".join(names)),
                 ("Vocabulary source", source),
                 ("Vocabulary", "; ".join(sorted(v.name for v in vocabularies.values()))),
                 ("Similarity cutoff", cutoff)]
        yes_no = lambda flag: "Yes" if flag else "No"
        extra += [("Ignore case", yes_no(options["ignore_case"])),
                  ("Normalise Arabic letters", yes_no(options["normalise_arabic"])),
                  ("Treat teh marbuta as heh", yes_no(options["fold_teh_marbuta"])),
                  ("Numbers must match", yes_no(options["numbers_must_match"]))]
        if source == _VOCAB_SOURCE_DOMAIN:
            extra.append(("Rows without a coded-value domain (not checked)", no_domain))
            if empty_domains:
                extra.append(("Rows whose coded-value domain has no codes (not checked)",
                              empty_rows))
        detail = [[r["field"], r["value"], r["count"], r["issue"], r["suggestion"], r["score"],
                   r["sample_oids"], r["vocab"], r["detail"]] for r in results]
        summary = vocab_summary(results, totals, extra)
        if report:
            # An Excel cell cannot hold most control characters (the shared writer dropped them)
            # and in a CSV file they are invisible: show them as <U+XXXX> in both formats.
            detail = [[vocab_visible_controls(v) for v in row] for row in detail]
            summary = [[vocab_visible_controls(v) for v in row] for row in summary]
            if report.get("format") == "xlsx":
                self._report_excel_cut(detail, summary, collector)
        for written in write_report(report, summary, list(_VOCAB_COLUMNS), detail):
            collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "issue_count", str(len(results)))
        flush_messages(collector)

    def _report_long_rows(self, info, vocab_path, collector):
        """Warn about CSV rows with more cells than the header (an unquoted delimiter)."""
        line, cells = info["long_example"]
        name = os.path.basename(vocab_path.replace("\\", "/"))
        delim = vocab_delimiter_name(info["delimiter"])
        raw = info.get("long_line")
        example = u"line {0}: '{1}'".format(
            line, raw if raw is not None else info["delimiter"].join(cells))
        if len(info["header"]) <= 1:
            collector.warning(
                u"{0} row(s) of the one-column CSV file {1} have more cells than its header "
                u"(for example {2}): a {3} inside a value is not quoted. Each such line was read "
                u"as one value, as written (quotes included). If the file has more columns, name them in the header "
                u"row; otherwise put values that contain a {3} in double quotes.".format(
                    info["long_rows"], name, example, delim))
        else:
            collector.warning(
                u"{0} row(s) of the CSV file {1} have more cells than its {2} header columns "
                u"(for example {3}): a {4} inside a value is probably not quoted, so the cells "
                u"are shifted and the extra cells were ignored. Put values that contain a {4} in "
                u"double quotes, or fix the header row.".format(
                    info["long_rows"], name, len(info["header"]), example, delim))

    def _report_excel_cut(self, detail, summary, collector):
        """Warn about report cells longer than an Excel cell holds (the shared writer cuts them
        and marks the cut)."""
        cut = sum(1 for row in list(detail) + list(summary) for v in row if vocab_excel_too_long(v))
        if cut:
            collector.warning(
                u"{0} report cell(s) are longer than {1:,} characters, the most an Excel cell "
                u"holds: the Excel report cuts them and marks the cut. The output table in a "
                u"geodatabase keeps the full text. Choose a .csv report to get the full text in "
                u"the report.".format(cut, VOCAB_XLSX_MAX_CELL))

    def _report_controls(self, results, report, collector):
        """Warn about control characters in VALUE or SUGGESTION: invisible in Pro, and an Excel
        report shows them as <U+XXXX> (an Excel cell cannot hold them). The example is the first
        reported row; it names the value when the value holds a control character, otherwise the
        suggestion (a vocabulary entry with a control character)."""
        hits = [r for r in results
                if vocab_control_codes(r["value"]) or vocab_control_codes(r["suggestion"])]
        if not hits:
            return
        codes = sorted(set(c for r in hits for c in vocab_control_codes(r["value"]) +
                           vocab_control_codes(r["suggestion"])))
        where = u"the output table keeps them"
        if report:
            where += u"; the report shows each one as <U+XXXX>"
        first = hits[0]
        if vocab_control_codes(first["value"]):
            example = u"the value {0}".format(vocab_visible_controls(first["value"]))
        else:
            example = u"the suggestion {0} for the value {1}".format(
                vocab_visible_controls(first["suggestion"]), first["value"])
        collector.warning(
            u"{0} reported row(s) have invisible control characters ({1}) in the value or the "
            u"suggestion, for example {2}; {3}. Such a value can look equal to its suggestion, "
            u"and applying such a suggestion copies the control characters into the data.".format(
                len(hits), u", ".join(u"U+{0:04X}".format(c) for c in codes[:10]) +
                (u" ..." if len(codes) > 10 else u""), example, where))

    def _report_collisions(self, vocab, collector):
        groups = vocab.collisions()
        if groups:
            collector.info("Vocabulary {0}: {1} group(s) of entries differ only in what the "
                           "comparison ignores (such as case, spaces, Arabic letter forms, "
                           "invisible characters or Arabic-Indic digits), for example {2}; each "
                           "is accepted as written.".format(vocab.name, len(groups),
                                                            " / ".join(groups[0])))
        self._report_hidden_entries(vocab, collector)
        self._report_control_entries(vocab, collector)

    def _report_control_entries(self, vocab, collector):
        """Warn about vocabulary entries that hold control characters (such as U+0001): used as a
        suggestion, such an entry carries the character into the data although it looks like the
        plain text."""
        bad = vocab.control_entries()
        if not bad:
            return
        codes = sorted(set(c for e in bad for c in vocab_entry_control_codes(e)))
        shown = u", ".join(vocab_show_hidden(e, controls=True) for e in bad[:5])
        if len(bad) > 5:
            shown += u" ... and {0} more".format(len(bad) - 5)
        collector.warning(u"Vocabulary {0}: {1} entr{2} contain{3} control characters ({4}): {5}. "
                          u"A suggestion copies them into your data; remove them from the "
                          u"vocabulary if they are not wanted.".format(
                              vocab.name, len(bad), u"y" if len(bad) == 1 else u"ies",
                              u"s" if len(bad) == 1 else u"",
                              u", ".join(u"U+{0:04X}".format(c) for c in codes[:10]) +
                              (u" ..." if len(codes) > 10 else u""), shown))

    def _report_hidden_entries(self, vocab, collector):
        """Name the vocabulary entries that hold invisible format marks: used as a suggestion,
        such an entry carries the mark into the data although it looks like the plain text."""
        hidden = vocab.hidden_entries()
        if not hidden:
            return
        codes = sorted(set(c for e in hidden for c in vocab_hidden_codes(e)))
        shown = u", ".join(vocab_show_hidden(e) for e in hidden[:5])
        if len(hidden) > 5:
            shown += u" ... and {0} more".format(len(hidden) - 5)
        collector.info(u"Vocabulary {0}: {1} entr{2} contain{3} invisible characters ({4}): {5}. "
                       u"A suggestion copies them into your data; remove them from the "
                       u"vocabulary if they are not wanted.".format(
                           vocab.name, len(hidden), u"y" if len(hidden) == 1 else u"ies",
                           u"s" if len(hidden) == 1 else u"",
                           u", ".join(u"U+{0:04X}".format(c) for c in codes), shown))

    def _empty_domain_text(self, vocab, dom_name, field_name, rows):
        """Warning for a coded-value domain without a usable code (``vocab`` is empty)."""
        why = "has no codes"
        if vocab.skipped:
            why = ("has no usable codes (its {0} code(s) are blank or empty once "
                   "normalised)".format(vocab.skipped))
        return ("The coded-value domain {0} {1}, so the {2} row(s) of {3} that use it were not "
                "checked. Add the allowed codes to the domain (Domains view, or the Add Coded "
                "Value To Domain tool) and run the tool again.".format(dom_name, why, rows,
                                                                       field_name))

    def _has_coded_domain(self, field, domains, subtypes):
        """True if a coded-value domain applies to ``field`` at field or subtype level."""
        names = [field.get("domain")]
        for entry in (subtypes.get("subtypes") or {}).values():
            for fname, dom in (entry.get("domains") or {}).items():
                if fname.casefold() == field["name"].casefold():
                    names.append(dom)
        return any(n and n in domains and domains[n]["domain_type"] == "CodedValue"
                   for n in names)

    def _group_rows(self, rows, field, source, domains, subtypes, st_field):
        """``{domain name or None: [(oid, value)]}`` for one field.

        TABLE/FILE: everything under ``None``. DOMAIN: rows grouped by the
        coded-value domain that applies to the row (subtype level first);
        rows without one go under ``None``.
        """
        name = field["name"]
        if source != _VOCAB_SOURCE_DOMAIN:
            return {None: [(r["oid"], r["attrs"][name]) for r in rows]}
        groups = {}
        for r in rows:
            code = r["attrs"].get(st_field) if st_field else None
            dom = domain_for_field(name, field.get("domain"), subtypes, code)
            if dom is not None and (dom not in domains or
                                    domains[dom]["domain_type"] != "CodedValue"):
                dom = None
            groups.setdefault(dom, []).append((r["oid"], r["attrs"][name]))
        return groups

    def _write_output(self, out_path, results, inputs, collector, report=None):
        # In a folder (dBASE table, text fields of at most 254 characters) longer texts are
        # cut; the report keeps the full text.
        folder = is_folder_workspace(split_catalog_path(out_path)[0])
        shown, cut = _vocab_fit_text(results, folder)
        cols = dict((c, [r[c.lower()] for r in shown]) for c in _VOCAB_COLUMNS)
        specs = [_vocab_text_spec("FIELD", cols["FIELD"], folder),
                 _vocab_text_spec("VALUE", cols["VALUE"], folder),
                 {"name": "COUNT", "type": "LONG"},
                 {"name": "ISSUE", "type": "TEXT", "length": max(len(i) for i in VOCAB_ISSUES)},
                 _vocab_text_spec("SUGGESTION", cols["SUGGESTION"], folder),
                 {"name": "SCORE", "type": "DOUBLE"},
                 _vocab_text_spec("SAMPLE_OIDS", cols["SAMPLE_OIDS"], folder),
                 _vocab_text_spec("VOCAB", cols["VOCAB"], folder),
                 _vocab_text_spec("DETAIL", cols["DETAIL"], folder)]
        path, mapping = create_table(out_path, specs, inputs=inputs)
        nulls = set()
        rows = [[r["field"], r["value"], r["count"], r["issue"], r["suggestion"], r["score"],
                 r["sample_oids"], r["vocab"], r["detail"]] for r in shown]
        try:
            insert_rows(path, [mapping[s["name"]] for s in specs], rows, null_fields=nulls)
        except Exception:
            # never leave a half-filled output table behind
            try:
                safe_delete(path, inputs)
            except Exception:
                pass
            raise
        for spec in specs:
            if mapping[spec["name"]] != spec["name"]:
                collector.info("Field '{0}' is called '{1}' in the output (a valid field name in "
                               "this workspace; a dBASE field name has at most 10 bytes (about 5 Arabic letters))."
                               .format(spec["name"], mapping[spec["name"]]))
        if cut:
            collector.warning(
                "{0} text value(s) are longer than {1} bytes in UTF-8 (an Arabic letter takes 2 "
                "bytes), the most a dBASE/shapefile text field holds; they are cut to {1} bytes "
                "in the output table{2}. Two values that differ only after the cut then look the "
                "same there. Write the output to a file geodatabase to keep the full text.".format(
                    cut, SHAPEFILE_MAX_TEXT,
                    " (the report keeps the full text)" if report else ""))
        note = folder_null_number_warning(path, specs, mapping, nulls,
                                          "SCORE 0 means UNKNOWN (no suggestion).")
        if note:
            collector.warning(note)
        return path


def _vocab_cut_bytes(text, limit):
    """``text`` cut to at most ``limit`` bytes as a dBASE field counts them (UTF-8; a character
    above U+FFFF counts 6, ``common.arcio._arcio_dbf_bytes``), never in the middle of a character."""
    if _arcio_dbf_bytes(text) <= limit:
        return text
    out, used = [], 0
    for ch in text:
        width = _arcio_dbf_bytes(ch)
        if used + width > limit:
            break
        out.append(ch)
        used += width
    return u"".join(out)


def _vocab_text_spec(name, values, folder):
    """Text column spec: in a folder the width is the longest value in UTF-8 bytes (a dBASE
    table written by ArcGIS Pro has a UTF-8 code page and holds at most 254 BYTES)."""
    if not folder:
        return {"name": name, "type": "TEXT", "values": values}
    longest = max([_arcio_dbf_bytes(v) for v in values if isinstance(v, str)] or [1])
    return {"name": name, "type": "TEXT", "length": max(1, longest)}


def _vocab_fit_text(results, folder):
    """Results as the output table can store them: in a folder (dBASE table, text fields of at
    most 254 BYTES in UTF-8) longer FIELD, VALUE, SUGGESTION, SAMPLE_OIDS, VOCAB and DETAIL
    texts are cut to 254 bytes without splitting a letter. Returns ``(results, number of
    values cut)``."""
    if not folder:
        return results, 0
    out, cut = [], 0
    for result in results:
        new = dict(result)
        for key in ("field", "value", "suggestion", "sample_oids", "vocab", "detail"):
            if isinstance(new[key], str):
                fitted = _vocab_cut_bytes(new[key], SHAPEFILE_MAX_TEXT)
                if fitted != new[key]:
                    new[key] = fitted
                    cut += 1
        out.append(new)
    return out, cut


# ==========================================================================
# quality/atlas_tool.py
# ==========================================================================
# QC Scorecard Report: the ArcGIS Pro tool (adapter).

# The third column is text, not GPTableView: ArcGIS Pro 3.3.2 rejected every call whose row had an
# EMPTY Checked dataset cell with "ERROR 000735: Issue Tables: Value is required",
# while an empty GPString cell (Tool) was accepted. The tool reads and checks the path itself.
_ATLAS_TABLE_COLUMNS = [["GPTableView", "Issue table"], ["GPString", "Tool"],
                        ["GPString", "Checked dataset"]]
_ATLAS_SEVERITY_COLUMNS = [["GPString", "Rule"], ["GPString", "Severity"]]
_ATLAS_SYSTEM_TYPES = ("OID", "Geometry", "Raster", "Blob", "GUID", "GlobalID")
_ATLAS_AUTO_SYSTEM_NAMES = ("SHAPE_LENGTH", "SHAPE_AREA", "SHAPE_LEN")
_ATLAS_LOCATE_CHUNK = 500
_ATLAS_LAYER_KINDS = {"point": "point", "multipoint": "point", "polyline": "polyline",
                      "polygon": "polygon"}


class QcScorecardAtlas(object):
    """Turn QC issue tables into one offline HTML scorecard with a verdict and an error atlas."""

    DOC = {
        "summary": "Reads the issue tables written by the toolkit's quality tools "
                   "(Geometry Quality Checker, Domain Audit, Line Network Rule Check) "
                   "or any table in the unified issue schema, and writes ONE self-contained "
                   "HTML report that opens from a file or a phone without internet: a delivery "
                   "verdict (PASS or FAIL with the pass rate and the threshold), a card per "
                   "rule sorted by count, an SVG error atlas over a simplified outline of "
                   "optional context layers that can be toggled by rule, a hexagon density "
                   "panel and a bar chart. It also writes the unified issue table and "
                   "optionally a PNG of the atlas. Read-only: inputs are never changed.",
        "usage": "Give one row per issue table in Issue Tables: the table (or feature class, or "
                 "layer), the tool that made it (leave empty for automatic recognition from the "
                 "column names) and, optionally, the dataset that tool checked. The checked "
                 "dataset does three things: it names the source of tools that do not write one "
                 "(Geometry Quality Checker), it gives the number of checked features (the pass "
                 "rate is 100 x (1 - features with an ERROR / checked features)), and it gives a "
                 "location to issues that have none (Domain Audit writes a table: "
                 "the report finds the feature by its object id in the checked dataset and uses "
                 "a point on it). Issues that still have no location are counted everywhere but "
                 "not drawn; the report says how many. An issue table that holds the issues of several "
                 "checked datasets (Domain Audit over several tables or a workspace, "
                 "Line Network Rule Check with its rule-point layer, a unified table with several "
                 "SOURCE values) is listed once per checked dataset: the same table and tool, a "
                 "different Checked dataset in each row. It is read once, and each issue belongs "
                 "to the checked dataset its source names. A Geometry Quality Checker table names "
                 "no source, so it takes one checked dataset only.\n\nThe tools write no severity. The "
                 "toolkit's own default is used (for example SPIKE and DANGLE are errors, "
                 "PSEUDO_NODE and SLIVER are warnings). A threshold table (RULE_ID, "
                 "SEVERITY, MAX_COUNT, MAX_RATE) or the Severity Overrides rows replace that "
                 "default per rule, and the report marks which severities are toolkit "
                 "defaults. The threshold table also sets "
                 "limits per rule. Default without limits: any ERROR fails the delivery. "
                 "MAX_RATE is the largest accepted share, in percent, of all checked features "
                 "that the rule may hit; it needs checked datasets, and every issue of the rule "
                 "that is not on a checked feature (no object id, an id not in the checked "
                 "dataset, or a source that is not checked) counts as one failing feature of "
                 "its own, so such errors can never help a rule pass. The minimum pass rate adds "
                 "one more condition to PASS.\n\nContext layers are drawn in grey as an "
                 "outline. When they hold more vertices than the vertex limit, every k-th "
                 "vertex is kept; beyond what that can fit, a layer is drawn as its extent. "
                 "Issue locations are in the coordinate system of the first issue table with "
                 "geometry; the geometry of other layers is projected to it while it is read "
                 "(no datum transformation). X and Y columns are never projected: when a row "
                 "has geometry, its geometry places the issue if the columns disagree with it "
                 "or the layer was projected (a warning says so); the X and Y columns of a "
                 "table without geometry are taken in the run's coordinate system. For degrees the map is drawn with longitude scaled by "
                 "cos(latitude). Issues at the same point (to 1 mm) are one location: the map draws "
                 "one marker per location (larger, with a dark rim, when several issues share "
                 "it) and the hexagons count locations. The hexagon size is the distance "
                 "between two parallel sides; empty means the longer side of the checked area "
                 "(the checked datasets and the issue locations; context layers do not count, "
                 "as for the summary sentence) divided by a number from 6 to 24, the rounded "
                 "square root of (locations / 3), so 6 up to 126 locations and 24 from 1,657 "
                 "locations up. At "
                 "most 3,000 markers are drawn; above that every k-th marker of each rule is "
                 "drawn and the report says so, while the density panel and all counts use "
                 "every issue. The pass rate counts a checked feature once if it has at least "
                 "one ERROR (matched by object id in the checked dataset); error rows without "
                 "an object id, or with an id that is not in the checked dataset, are reported "
                 "and the rate is kept between 0 and 100. An issue's source matches a checked "
                 "dataset by its name, the typed text or its catalog path, in any case and with "
                 "either slash (Domain Audit writes full paths when it checked "
                 "several geodatabases); error rows whose source matches no checked dataset are "
                 "named in a warning.\n\nIssue "
                 "tables from the Domain Audit's second output (the usage and "
                 "hygiene table) and Excel report sheets are not read; give the violations "
                 "table. All text from your data is HTML-escaped in the report. The tool never "
                 "edits data and never overwrites an input.",
        "params": {
            "issue_tables": "One row per issue table: the table, feature class or layer; the "
                            "tool that made it (empty = recognise by column names; "
                            "GeometryQualityChecker, DomainConformanceAudit, LineNetworkRules "
                            "or UNIFIED); and optionally the dataset that tool checked. A "
                            "layer or table view with a selection or definition query is read "
                            "as it shows, with a warning. One issue table may be given in "
                            "several rows only with the same tool and a different checked "
                            "dataset in each (a table that holds the issues of several "
                            "datasets; not a Geometry Quality Checker table); it is read once. A dataset named in several rows is "
                            "checked over every feature any of them shows. In a dBASE table "
                            "(.dbf, shapefile) SRC_OID 0 and X = Y = 0 are read as empty.",
            "context_layers": "Optional layers drawn in grey as the outline of the map. "
                              "Selections and definition queries are honoured.",
            "rule_thresholds": "Optional table with RULE_ID and any of SEVERITY, MAX_COUNT, "
                               "MAX_RATE. An Excel sheet (book.xlsx\\Sheet1$) works too; a "
                               "numeric RULE_ID (101.0) is the rule 101. "
                               "Without it any ERROR fails the delivery. A rule whose issues "
                               "are all INFO never fails (a warning says its limit is not "
                               "applied).",
            "severity_overrides": "Optional rows Rule, Severity (ERROR, WARNING or INFO) that "
                                  "replace the toolkit's default severity of a rule, for "
                                  "example DANGLE = WARNING for a network with legitimate "
                                  "dead-end streets. They win over the SEVERITY column of the "
                                  "threshold table. The report says which severities are "
                                  "toolkit defaults.",
            "min_pass_rate": "Optional minimum pass rate in percent (0-100). Needs checked "
                             "datasets. The delivery fails when the pass rate is lower.",
            "max_vertices": "Most vertices of context outline kept in the report (default "
                            "200000). More are thinned; beyond that a layer is drawn as its "
                            "extent.",
            "hex_size": "Optional hexagon size for the density panel, as the distance between "
                        "two parallel sides, for example 500 Meters. Empty = the longer side "
                        "of the checked area (checked datasets and issue locations, not the "
                        "context layers) divided by 6 to 24 (more hexagons for more "
                        "locations). Every "
                        "unit of the dialog is accepted (Feet, Yards, Miles, Inches are US "
                        "Survey units, FeetInt, YardsInt, MilesInt, InchesInt international); "
                        "a length is not usable for geographic coordinates, where "
                        "DecimalDegrees is.",
            "report_title": "Title of the report. Default: QC scorecard.",
            "out_html": "The report: one self-contained HTML file.",
            "out_issue_table": "Optional output table with every issue in the unified schema: "
                               "RUN_ID, TOOL, RULE_ID, SOURCE, SRC_OID, SEVERITY, X, Y, "
                               "MESSAGE, FIELD, VALUE. SRC_OID is a Long field while every "
                               "object id fits 32 bits; larger ids make it a Big Integer field "
                               "in a geodatabase, GeoPackage or memory (an id above 2^53 - 1 "
                               "stops the run) and, in a "
                               "folder, a Double while every id has at most 12 significant "
                               "digits, else text of 20 characters with every digit kept.",
            "out_png": "Optional PNG picture of the atlas (needs matplotlib, which ArcGIS Pro "
                       "ships; without it a warning is given and the PNG is skipped).",
            "issue_count": "Number of issues read (derived).",
            "verdict": "PASS or FAIL (derived).",
        },
        "tags": ["QC", "report", "scorecard", "delivery", "HTML", "SVG", "issues", "validation"],
    }

    def __init__(self):
        self.label = "QC Scorecard Report"
        self.description = ("Turns QC issue tables into one offline HTML scorecard with a PASS "
                            "or FAIL verdict, rule cards and an error atlas (v"
                            + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        tables = make_param("issue_tables", "Issue Tables", "GPValueTable")
        tables.columns = [list(c) for c in _ATLAS_TABLE_COLUMNS]
        # No ValueList filter on the Tool column: ArcGIS Pro 3.3.2 rejected an EMPTY Tool cell
        # with ERROR 000800 "The value is not a member of AUTO | ..." (one error per
        # row, for the text, ValueTable and list forms alike). The names are checked in
        # updateMessages and execute instead.
        severity = make_param("severity_overrides", "Severity Overrides", "GPValueTable",
                              required=False)
        severity.columns = [list(c) for c in _ATLAS_SEVERITY_COLUMNS]
        return [
            tables,
            make_param("context_layers", "Context Layers", "GPFeatureLayer", required=False,
                       multi_value=True),
            make_param("rule_thresholds", "Rule Thresholds Table", "GPTableView", required=False),
            severity,
            make_param("min_pass_rate", "Minimum Pass Rate (%)", "GPDouble", required=False),
            make_param("max_vertices", "Maximum Outline Vertices", "GPLong", required=False,
                       default=ATLAS_MAX_VERTICES_DEFAULT),
            make_param("hex_size", "Hexagon Size", "GPLinearUnit", required=False),
            make_param("report_title", "Report Title", "GPString", required=False,
                       default="QC scorecard"),
            make_param("out_html", "Output HTML Report", "DEFile", direction="Output",
                       value_list=["html"]),
            make_param("out_issue_table", "Output Issue Table", "DETable", direction="Output",
                       required=False),
            make_param("out_png", "Output PNG", "DEFile", direction="Output", required=False,
                       value_list=["png"]),
            derived_output("issue_count", "Issue Count", "GPLong"),
            derived_output("verdict", "Verdict", "GPString"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    def updateMessages(self, parameters):
        self._validate(parameters)

    @protected_outputs()
    def _validate(self, parameters):
        p = param_map(parameters)
        rate = p["min_pass_rate"].value
        if rate is not None and not 0 <= float(rate) <= 100:
            p["min_pass_rate"].setErrorMessage("The pass rate must be between 0 and 100.")
        elif rate is not None and 0 < float(rate) < 1:
            p["min_pass_rate"].setWarningMessage(_atlas_fraction_text(float(rate)))
        limit = p["max_vertices"].value
        if limit is not None and int(limit) < ATLAS_MIN_VERTICES:
            p["max_vertices"].setErrorMessage(
                "The vertex limit must be at least {0}.".format(ATLAS_MIN_VERTICES))
        try:
            rows = _atlas_table_rows(p["issue_tables"])
        except (TypeError, ValueError):
            rows = []
        for row in rows:
            if row[1] is not None and str(row[1]).strip().upper() not in \
                    [UNI_TOOL_AUTO] + [t.upper() for t in UNI_TOOLS]:
                p["issue_tables"].setErrorMessage(
                    "Tool '{0}' is not supported; use {1}, or leave it empty.".format(
                        row[1], ", ".join(UNI_TOOLS)))
                break
        for row in rows:
            if row[2]:
                try:
                    found = arcpy.Exists(row[2])
                except Exception:
                    found = True
                if not found:
                    p["issue_tables"].setErrorMessage(
                        "The checked dataset '{0}' was not found. Give its full path or the name "
                        "of a layer in the map, or leave the cell empty.".format(row[2]))
                    break
        try:
            for row in _atlas_pairs(p["severity_overrides"]):
                if row[1] is None or str(row[1]).strip().upper() not in (
                        "ERROR", "WARNING", "INFO", "WARN", "ERR", "INFORMATION", "NOTE", "CRITICAL"):
                    p["severity_overrides"].setErrorMessage(
                        "Severity '{0}' of rule '{1}' is not ERROR, WARNING or INFO.".format(
                            row[1], row[0]))
                    break
        except (TypeError, ValueError):
            pass
        # The tables inside the value table are inputs too: never write the issue table over one.
        paths = [r[0] for r in rows if r[0]] + [r[2] for r in rows if r[2]]
        if p["rule_thresholds"].valueAsText:
            paths.append(p["rule_thresholds"].valueAsText)
        refuse_existing_protected_output(p["out_issue_table"], paths)
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))

    # ------------------------------------------------------------------ run

    def _run(self, parameters, p, collector):
        entries = _atlas_entries(p["issue_tables"])
        if not entries:
            raise ToolError("No issue table was given.",
                            "Add at least one issue table to 'Issue Tables'.")
        register_inputs([e["table"] for e in entries] + [e["checked"] for e in entries
                                                         if e["checked"]])
        inputs = input_texts(p) + [e["table"] for e in entries] + \
            [e["checked"] for e in entries if e["checked"]]
        # Output locations are chosen and checked before the main work.
        html_path = choose_output_file(param_text(p["out_html"]), ".html", inputs)
        png_path = choose_output_file(param_text(p["out_png"]), ".png", inputs)
        table_out = param_text(p["out_issue_table"])
        if table_out:
            check_output_path(table_out, inputs)
        min_rate = param_number(p["min_pass_rate"])
        if min_rate is not None and not 0 <= min_rate <= 100:
            raise ToolError("The minimum pass rate must be between 0 and 100.",
                            "Type a percentage such as 98.")
        max_vertices = param_number(p["max_vertices"], ATLAS_MAX_VERTICES_DEFAULT)
        if max_vertices < ATLAS_MIN_VERTICES:
            raise ToolError("The vertex limit must be at least {0}.".format(ATLAS_MIN_VERTICES),
                            "Type a larger number, or leave the default.")
        title = (param_text(p["report_title"]) or "QC scorecard").strip() or "QC scorecard"
        rate_notes = []
        if min_rate is not None and 0 < min_rate < 1:
            rate_notes.append(_atlas_fraction_text(min_rate))
            collector.warning(rate_notes[-1])
        thresholds = self._read_thresholds(param_text(p["rule_thresholds"]), collector)
        merge_severity_overrides(thresholds, _atlas_pairs(p["severity_overrides"]))

        state = {"run_sr": None, "run_info": None, "notes": rate_notes, "severity_words": {},
                 "input_warnings": list(self._threshold_warnings), "checked_extent": None}
        state["notes"].extend(self._threshold_warnings)
        issues, sources = self._read_issue_tables(entries, state, collector)
        totals, known_oids = self._checked_datasets(entries, issues, sources, state, collector)
        for position, source in enumerate(sources):
            source["located"] = sum(1 for i in issues if i["_entry"] == position
                                    and i.get("X") is not None and i.get("Y") is not None)
        layers = self._read_context(param_list(p["context_layers"]), state, collector,
                                    int(max_vertices))

        severity_changed = apply_thresholds(issues, thresholds)
        if severity_changed:
            collector.info("{0} issue(s) got their severity from the threshold table or the "
                           "overrides.".format(
                severity_changed))
        guessed = sum(1 for i in issues if i.pop("_severity_guess", False))
        if guessed:
            state["notes"].append("{0} issue(s) had an empty severity cell; they are treated as "
                                  "WARNING (an empty cell is not an unknown word, so it is not "
                                  "counted as ERROR). Give those rules a severity with Severity "
                                  "Overrides or the threshold table if they are errors.".format(
                                      guessed))
            state["input_warnings"].append(state["notes"][-1])
            collector.warning(state["notes"][-1])
        words = state["severity_words"]
        if words:
            state["notes"].append(
                "{0} issue(s) had a severity that is not ERROR, WARNING or INFO ({1}); they are "
                "counted as ERROR, so an unknown word never passes a delivery. Use Severity "
                "Overrides to give those rules the right severity.".format(
                    sum(words.values()), ", ".join(sorted(words)[:10])))
            collector.warning(state["notes"][-1])
        score = build_scorecard(issues, thresholds, totals or None, min_rate,
                                known_oids if totals else None)
        for text in score["rate_warnings"]:
            collector.warning(text)
        for text in score["limit_warnings"]:
            collector.warning(text)
        # inputs read only in part (a selection or definition query on an issue table layer)
        # and dBASE zeros read as empty: said under the verdict, not only in the notes
        score["input_warnings"] = list(state["input_warnings"])
        if score["unmatched"]:
            collector.warning("No issues were found for the rule(s) named in the threshold table "
                              "or the severity overrides: {0}. Check the spelling (rule ids are "
                              "compared without regard to case).".format(
                                  ", ".join(score["unmatched"][:10])))
        if score["accepted_errors"]:
            collector.info("{0} error(s) are accepted by the rule limits; the report says so "
                           "under the verdict.".format(score["accepted_errors"]))

        info = state["run_info"]
        crs = {"known": bool(info), "geographic": bool(info and info["type"] == "Geographic"),
               "wkid": info["wkid"] if info else None,
               "label": _atlas_crs_label(info), "unit": _atlas_unit_name(info)}
        for name in state.get("xy_tables", []):
            if crs["known"]:
                text = ("{0} has no geometry: its X and Y columns are taken as coordinates in "
                        "the run's coordinate system ({1}, that of the first issue table with "
                        "geometry, else of a checked dataset or context layer) and are not "
                        "projected.".format(name, crs["label"]))
            else:
                text = ("{0} has no geometry and no input gives a coordinate system: its X and "
                        "Y columns are drawn as they are.".format(name))
            state["notes"].append(text)
            collector.info(text)
        if not crs["known"]:
            state["notes"].append("The coordinate system of the issue locations is unknown; "
                                  "coordinates are drawn as they are.")
        elif not crs["geographic"] and atlas_columns_look_like_degrees(issues):
            state["notes"].append(
                "The X and Y columns of the issue table(s) without geometry all lie between "
                "-180 and 180 / -90 and 90, which looks like degrees, but the run's coordinate "
                "system ({0}) is projected; those issues may be drawn in the wrong place. Give "
                "X and Y in the run's coordinate system.".format(crs["label"]))
            collector.warning(state["notes"][-1])
        for issue in issues:
            issue.pop("_xy_columns", None)
        hex_text = param_text(p["hex_size"])
        hex_size = hex_size_in_map_units(hex_text, crs["geographic"],
                                         info["meters_per_unit"] if info else None)
        now = datetime.datetime.now()
        run_id = "RUN-" + now.strftime("%Y%m%d-%H%M%S")
        model = assemble_model(issues, score, sources, layers, crs, title, run_id,
                               now.strftime("%Y-%m-%d %H:%M"), __version__, hex_size,
                               state["notes"], severity_words=state["severity_words"],
                               checked_extent=state["checked_extent"])
        page = render_report_html(model)

        # The report is written first: a failure while writing the issue table must not cost
        # the user the report.
        written = []
        write_text_file(html_path, page)
        collector.info("Report written to {0}.".format(html_path))
        if png_path:
            ok, why = render_atlas_png(model, png_path)
            if ok:
                collector.info("PNG written to {0}.".format(png_path))
            else:
                collector.warning("The PNG was not written: {0}.".format(why))
        if table_out:
            written.append(self._write_table(table_out, issues, run_id, inputs, collector,
                                             html_path))
        collector.info("{0}: {1} issue(s) ({2} error(s), {3} warning(s)); {4} located at {5} "
                       "distinct location(s), {6} without location.".format(
                           score["verdict"], score["total"], score["errors"], score["warnings"],
                           model["located"], model["locations"], model["unlocated"]))
        if model["error_located"]:
            collector.info("{0} error(s) with a location sit at {1} distinct location(s); issues "
                           "at the same point are drawn once.".format(model["error_located"],
                                                                      model["error_locations"]))
        for reason in score["reasons"]:
            collector.info("Reason: " + reason)
        if score["rate"] is not None:
            collector.info("Pass rate {0} % over {1} checked feature(s){2}.".format(
                atlas_format_compared(score["rate"], min_rate), score["checked_total"],
                "" if min_rate is None else ", required {0} %".format(atlas_format_typed(min_rate))))
        if written:
            collector.info("Issue table written to {0}.".format(written[0]))
            if any(t["max_count"] is not None or t["max_rate"] is not None
                   for t in thresholds.values()) or min_rate is not None:
                collector.info("The issue table keeps each issue's severity but not the limits "
                               "(maximum count, maximum rate, minimum pass rate) of this run; "
                               "give the same limits again when you read it back, or the "
                               "verdict can differ.")
        set_derived_output(parameters, "issue_count", str(score["total"]))
        set_derived_output(parameters, "verdict", score["verdict"])
        flush_messages(collector)

    # ------------------------------------------------------------- sources

    def _read_thresholds(self, path, collector):
        self._threshold_warnings = []
        if not path:
            return {}
        desc = describe_dataset(path)
        fields = desc["fields"]
        wanted = {}
        wanted["RULE_ID"], _how = match_field(fields, "RULE_ID", True, "rule id column")
        for name in ("SEVERITY", "MAX_COUNT", "MAX_RATE"):
            field, _how = match_field(fields, name, False, name + " column")
            wanted[name] = field
        names = [f["name"] for f in wanted.values() if f]
        rows = []
        for row in iter_features(path, names, geometry=False):
            rows.append(dict((key, row["attrs"].get(f["name"]) if f else None)
                             for key, f in wanted.items()))
        partial = _atlas_partial_layer_text(desc, len(rows), "threshold row(s)",
                                            "Rules whose row is hidden keep the toolkit default "
                                            "severity and get no limit.")
        if partial:
            self._threshold_warnings.append(partial)
            collector.warning(partial)
        thresholds = parse_thresholds(rows)
        collector.info("{0} rule threshold row(s) read from {1}.".format(len(thresholds),
                                                                         desc["name"]))
        return thresholds

    def _group_issue_tables(self, entries):
        """One group per issue table. A table that holds the issues of several checked
        datasets is listed once per checked dataset (the same table, the same tool, a different
        Checked dataset in each row) and read once; any other repeat is refused."""
        groups, by_where = [], {}
        for entry in entries:
            desc = describe_dataset(entry["table"])
            where = desc["catalog_path"].casefold()
            checked_key = describe_dataset(entry["checked"])["catalog_path"].casefold() \
                if entry["checked"] else None
            if where not in by_where:
                by_where[where] = len(groups)
                groups.append({"entry": entry, "desc": desc, "checked": (
                    [entry["checked"]] if entry["checked"] else []), "keys": set([checked_key])})
                continue
            group = groups[by_where[where]]
            if not entry["checked"] or not group["checked"]:
                raise ToolError("'{0}' is listed more than once in Issue Tables; its issues would "
                                "be counted twice.".format(desc["name"]),
                                "Keep one row per issue table. A table that holds the issues of "
                                "several checked datasets may be listed once per checked dataset, "
                                "with a different Checked dataset in every row.")
            if entry["tool"] != group["entry"]["tool"]:
                raise ToolError("'{0}' is listed in several rows of Issue Tables with different "
                                "tools ({1}, {2}).".format(desc["name"], group["entry"]["tool"],
                                                           entry["tool"]),
                                "Give the same Tool in every row of this table, or leave it "
                                "empty in all of them.")
            if checked_key in group["keys"]:
                raise ToolError("'{0}' is listed more than once in Issue Tables with the same "
                                "checked dataset ('{1}'); its issues would be counted twice."
                                .format(desc["name"], entry["checked"]),
                                "Give every row of this table a different Checked dataset.")
            group["keys"].add(checked_key)
            group["checked"].append(entry["checked"])
        return groups

    def _read_issue_tables(self, entries, state, collector):
        issues, sources = [], []
        for group in self._group_issue_tables(entries):
            entry, desc = group["entry"], group["desc"]
            columns = [f["name"] for f in desc["fields"]
                       if f["type"] not in _ATLAS_SYSTEM_TYPES
                       and f["name"].upper() not in _ATLAS_AUTO_SYSTEM_NAMES]
            tool = entry["tool"]
            if tool == UNI_TOOL_AUTO:
                tool = uni_detect_tool(columns)
                if tool is None:
                    if uni_is_domain_hygiene_table(columns):
                        raise ToolError(
                            "'{0}' is the usage and hygiene table of the Domain "
                            "Audit, not its list of violations.".format(desc["name"]),
                            "Give the violations table (the tool's Output Table).")
                    raise ToolError(
                        "The columns of '{0}' are not those of a supported issue table "
                        "({1}).".format(desc["name"], ", ".join(columns) or "no columns"),
                        "Supported tables: " + uni_describe_columns_needed() + ".")
                collector.info("{0}: recognised as {1}.".format(desc["name"], tool))
            else:
                missing = uni_missing_columns(tool, columns)
                if missing:
                    raise ToolError(
                        "'{0}' is not a {1} table: the column(s) {2} are missing.".format(
                            desc["name"], tool, ", ".join(missing)),
                        "Choose the right tool for this table, or leave the tool empty to "
                        "recognise it automatically.")
            kind = kind_from_shape_type(desc["shape_type"])
            has_geometry = kind is not None
            read_sr = None
            if has_geometry:
                self._adopt_sr(desc, state, collector, desc["name"])
                read_sr = self._read_sr(desc, state)
            checked_names = [describe_dataset(c)["name"] for c in group["checked"]]
            if len(checked_names) > 1 and tool == UNI_TOOL_GEOMETRY:
                raise ToolError(
                    "'{0}' is a Geometry Quality Checker table, which names no source, but it is "
                    "listed with {1} checked datasets.".format(desc["name"], len(checked_names)),
                    "Give it one row with the dataset it checked.")
            # one checked dataset: it names the issues without a source of their own; several:
            # each issue keeps the source it names (an empty one stays the table's name)
            checked_name = checked_names[0] if len(checked_names) == 1 else None
            rows = []
            progress = Progress("Reading " + desc["name"], 0)
            for row in iter_features(entry["table"], columns, sr=read_sr, geometry=has_geometry):
                record = dict(row["attrs"])
                xy = None
                if row["shape"] is not None:
                    point = representative_point(kind, row["shape"])
                    xy = (point[0], point[1]) if point else None
                record["_xy"] = xy
                if xy is not None and kind in (GEOM_POLYLINE, GEOM_POLYGON):
                    record["_bbox"] = geometry_bbox(kind, row["shape"])
                rows.append(record)
            progress.close()
            partial = _atlas_partial_layer_text(
                desc, len(rows), "issue row(s)", "Issues outside the selection or the definition "
                "query are not in this report, its counts or its verdict; clear them, or give the "
                "table's path, to judge every issue.")
            if partial:
                state["notes"].append(partial)
                state["input_warnings"].append(partial)
                collector.warning(partial)
            found = uni_adapt(tool, rows, checked_name or desc["name"])
            if len(found) == len(rows):
                # rule ids and sources as the toolkit compares them: a DOUBLE rule id is its
                # integer text with every digit, and a long full path is not cut
                atlas_restore_ids(found, rows, tool)
            if len(found) == len(rows) and atlas_is_dbase_table(
                    desc["catalog_path"], is_folder_workspace(desc["workspace"])):
                upper = set(c.upper() for c in columns)
                ids, places = atlas_dbase_empty_values(
                    found, rows, tool == UNI_TOOL_UNIFIED and "X" in upper and "Y" in upper)
                if ids or places:
                    text = _atlas_dbase_text(desc["name"], ids, places)
                    state["notes"].append(text)
                    state["input_warnings"].append(text)
                    collector.warning(text)
            if tool == UNI_TOOL_UNIFIED and len(found) == len(rows):
                self._settle_xy(found, rows, kind, read_sr is not None, desc["name"], state,
                                collector)
            if tool == UNI_TOOL_UNIFIED and len(found) == len(rows):
                for word, n in atlas_escalate_unknown_severities(
                        found, [_atlas_cell(r, "SEVERITY") for r in rows]).items():
                    state["severity_words"][word] = state["severity_words"].get(word, 0) + n
            oid_cells = [_atlas_cell(r, "SRC_OID") if _atlas_cell(r, "SRC_OID") is not None
                         else (_atlas_cell(r, "OID") if tool == UNI_TOOL_UNIFIED else None)
                         for r in rows]
            cut, example = atlas_fractional_oids(oid_cells)
            if cut:
                state["notes"].append(
                    "{0}: {1} object id(s) have a fraction (for example {2!r}); each was cut to "
                    "its whole number (12.7 counts as feature 12). Object ids are whole "
                    "numbers: check the SRC_OID column.".format(desc["name"], cut, example))
                collector.warning(state["notes"][-1])
            for issue in found:
                issue["_entry"] = len(sources)
            sources.append({"tool": tool, "table": desc["name"], "rows": len(rows),
                            "checked": "; ".join(checked_names) or None,
                            "checked_texts": list(group["checked"]),
                            "checked_count": None, "located": 0})
            issues.extend(found)
            collector.info("{0}: {1} row(s) read.".format(desc["name"], len(rows)))
        return issues, sources

    def _settle_xy(self, found, rows, kind, projected, name, state, collector):
        """X/Y columns of a unified table against its geometry: the
        geometry is read in the run's coordinate system, the columns are not projected."""
        info = state["run_info"]
        tolerance = atlas_xy_tolerance(bool(info and info["type"] == "Geographic"),
                                       info["meters_per_unit"] if info else None)
        moved, disagree = atlas_prefer_geometry(found, rows, kind, projected, tolerance)
        if moved:
            state["notes"].append(
                "{0}: the X and Y columns of {1} issue(s) were not used: they are in the "
                "table's own coordinate system, while its geometry was projected to the run's "
                "coordinate system. Each issue is placed at its geometry.".format(name, moved))
            collector.info(state["notes"][-1])
        if disagree:
            state["notes"].append(
                "{0}: the X and Y columns of {1} issue(s) do not match their geometry (for "
                "example X/Y left in degrees after the feature class was projected). Each "
                "issue is placed at its geometry, not at the X and Y columns.".format(
                    name, disagree))
            collector.warning(state["notes"][-1])
        if kind is None and any(i.get("_xy_columns") for i in found):
            # said once the run's coordinate system is settled (after the checked datasets and
            # context layers are read), so the line can say whether there is one at all
            state.setdefault("xy_tables", []).append(name)

    def _adopt_sr(self, desc, state, collector, name):
        """The first dataset with a coordinate system gives the coordinate system of the run."""
        info = desc["sr"]
        if state["run_sr"] is not None or info is None or sr_is_unknown(info):
            if info is None or sr_is_unknown(info):
                state["notes"].append("{0} has no coordinate system; its coordinates are used as "
                                      "they are.".format(name))
                collector.warning(state["notes"][-1])
            return
        state["run_sr"], state["run_info"] = desc["sr_object"], info

    def _read_sr(self, desc, state):
        """The spatial reference to read with: ``None`` when the dataset already is in the run's
        coordinate system (or has none)."""
        info = desc["sr"]
        if state["run_sr"] is None or info is None or sr_is_unknown(info):
            return None
        if info.get("wkid") and info["wkid"] == (state["run_info"] or {}).get("wkid"):
            return None
        return state["run_sr"]

    def _checked_datasets(self, entries, issues, sources, state, collector):
        """Count the checked datasets, name the issues' sources after them and give a location
        to issues that have none. Returns ``({dataset name: feature count}, {dataset name: set
        of its object ids})``; the ids decide which issues belong to a checked feature."""
        totals, datasets, places, known = {}, {}, {}, {}
        reads, extent = {}, [None]
        for index, entry in enumerate(entries):
            if not entry["checked"]:
                continue
            desc = describe_dataset(entry["checked"])
            name = desc["name"]
            where = desc["catalog_path"].casefold()
            if places.setdefault(name.casefold(), where) != where:
                # Issues are matched to their dataset by name; two different datasets with one
                # name would get each other's features and counts.
                raise ToolError(
                    "Two different checked datasets are both called '{0}'.".format(name),
                    "Rename one of them (for example a copy with another name), or run the tool "
                    "once for each.")
            datasets.setdefault(name, desc)
            # No issue table with geometry gave the run a coordinate system: the first checked
            # dataset with geometry and a system gives it, whether or not an issue still needs
            # a location (a table whose issues all have X and Y is in that system too).
            kind = kind_from_shape_type(desc["shape_type"])
            if state["run_sr"] is None and kind is not None \
                    and desc["sr"] is not None and not sr_is_unknown(desc["sr"]):
                self._adopt_sr(desc, state, collector, name)
            # The object ids of each way the dataset is named (a layer's selection and
            # definition query are honoured), read once per text. A dataset named in several
            # rows, for example as a layer with a selection and by its path, is checked over the
            # union of what the rows name, so the order of the rows never matters.
            text_key = str(entry["checked"]).strip().casefold()
            per_name = reads.setdefault(name, {})
            if text_key not in per_name:
                ids = set()
                read_sr = self._read_sr(desc, state) if kind is not None else None
                for row in iter_features(entry["checked"], (), sr=read_sr,
                                         geometry=kind is not None):
                    ids.add(row["oid"])
                    if row["shape"] is not None:
                        extent[0] = merge_extents([extent[0], geometry_bbox(kind, row["shape"])])
                per_name[text_key] = (entry["checked"], ids)
        for name, per_name in reads.items():
            sets = [ids for _text, ids in per_name.values()]
            known[name] = set().union(*sets)
            totals[name] = len(known[name])
            if any(ids != sets[0] for ids in sets):
                text = ("'{0}' is named as the checked dataset in {1} rows that show different "
                        "features (a layer with a selection or a definition query, and the "
                        "dataset or another layer: {2} features). The checked features are all "
                        "features any of those rows shows ({3}), whatever the order of the "
                        "rows.".format(name, len(sets), ", ".join(
                            str(len(ids)) for ids in sorted(sets, key=len)), totals[name]))
                state["notes"].append(text)
                state["input_warnings"].append(text)
                collector.warning(text)
                # locate from the data source, so no row hides a feature of another row
                datasets[name] = dict(datasets[name], locate_from=datasets[name]["catalog_path"])
        for source in sources:
            names = [describe_dataset(c)["name"] for c in source.pop("checked_texts", [])]
            if len(names) == 1:
                source["checked_count"] = totals[names[0]]
            elif names:
                source["checked"] = "; ".join("{0} ({1} features)".format(n, totals[n])
                                              for n in names)
        state["checked_extent"] = extent[0]
        if not totals:
            return totals, known
        # Canonical SOURCE: a reference that names a checked dataset (its name, the typed
        # layer name or path, or its catalog path; any case, either slash, a trailing slash)
        # becomes the dataset's name, so counts, rates and locations agree. Domain
        # Audit writes the FULL catalog path in SRC_TABLE when it checked several geodatabases.
        refs = []
        for entry in entries:
            if entry["checked"]:
                desc = describe_dataset(entry["checked"])
                refs.append((desc["name"], (desc["name"], entry["checked"], desc["catalog_path"])))
        ambiguous = atlas_match_sources(issues, refs)
        if ambiguous:
            collector.warning("'{0}' names more than one checked dataset (a layer name that is "
                              "also the name of another dataset?); issues with that SOURCE are "
                              "not matched to either.".format("', '".join(ambiguous[:5])))
        # Location of table-only issues from the checked datasets.
        for name, desc in sorted(datasets.items()):
            kind = kind_from_shape_type(desc["shape_type"])
            wanted = {}
            for issue in issues:
                if issue.get("X") is None and issue.get("SOURCE") == name \
                        and issue.get("SRC_OID") is not None:
                    wanted.setdefault(issue["SRC_OID"], []).append(issue)
            if not wanted:
                continue
            if kind is None or not desc["oid_field"]:
                collector.info("{0} is a table without geometry: its {1} issue(s) cannot be "
                               "located.".format(name, sum(len(v) for v in wanted.values())))
                continue
            self._adopt_sr(desc, state, collector, name)
            read_sr = self._read_sr(desc, state)
            checked_text = desc.get("locate_from") or next(
                e["checked"] for e in entries if e["checked"]
                and describe_dataset(e["checked"])["name"] == name)
            oids = sorted(wanted)
            found = 0
            for start in range(0, len(oids), _ATLAS_LOCATE_CHUNK):
                chunk = oids[start:start + _ATLAS_LOCATE_CHUNK]
                where = "{0} IN ({1})".format(desc["oid_field"], ",".join(str(o) for o in chunk))
                for row in iter_features(checked_text, (), sr=read_sr, where=where):
                    point = representative_point(kind, row["shape"]) if row["shape"] else None
                    if point is None:
                        continue
                    for issue in wanted.get(row["oid"], ()):
                        issue["X"], issue["Y"] = point[0], point[1]
                        found += 1
            total = sum(len(v) for v in wanted.values())
            collector.info("{0}: {1} of {2} issue(s) located from the checked dataset.".format(
                name, found, total))
            if found < total:
                collector.warning("{0} issue(s) of {1} could not be located (object id not found "
                                  "in the checked dataset, empty geometry, or not selected in "
                                  "the layer).".format(total - found, name))
        return totals, known

    def _read_context(self, names, state, collector, max_vertices):
        budget = AtlasVertexBudget(max_vertices)
        for text in names:
            desc = describe_dataset(text)
            kind = kind_from_shape_type(desc["shape_type"])
            layer_kind = _ATLAS_LAYER_KINDS.get(str(desc["shape_type"] or "").casefold())
            if kind is None or layer_kind is None:
                collector.warning("{0} has no point, line or polygon geometry and is not drawn."
                                  .format(desc["name"]))
                continue
            self._adopt_sr(desc, state, collector, desc["name"])
            read_sr = self._read_sr(desc, state)
            index = budget.add_layer(desc["name"], layer_kind)
            progress = Progress("Reading outline " + desc["name"], 0)
            for row in iter_features(text, (), sr=read_sr):
                if row["curved"]:
                    budget.skip_curved(index)
                    continue
                shape = row["shape"]
                if shape is None:
                    continue
                if kind == GEOM_POINT:
                    budget.add_feature(index, [[shape]])
                elif kind == GEOM_MULTIPOINT:
                    budget.add_feature(index, [list(shape)])
                elif kind in (GEOM_POLYLINE, GEOM_POLYGON):
                    budget.add_feature(index, shape)
            progress.close()
        layers = budget.finish()
        for layer in layers:
            if layer["thinned"] or layer["extent_only"]:
                collector.info("{0}: {1} vertices in, {2} drawn{3}.".format(
                    layer["name"], layer["vertices_in"], layer["vertices_out"],
                    " (extent only)" if layer["extent_only"] else ""))
        return layers

    # -------------------------------------------------------------- output

    def _write_table(self, table_out, issues, run_id, inputs, collector, html_path=None):
        workspace = workspace_of(table_out)
        folder = is_folder_workspace(workspace)
        # SRC_OID: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``): LONG while
        # every id fits 32 bits, BIGINTEGER in a geodatabase, in a folder DOUBLE while every id has
        # at most 12 significant digits and TEXT otherwise.
        oid_spec, oid_note = oid_field_spec([i.get("SRC_OID") for i in issues], folder)
        # A dBASE text field holds at most 254 BYTES (UTF-8: an Arabic letter takes 2), so in a
        # folder every text value is cut by bytes and MESSAGE is sized at 254, not 255 (a
        # 255-character size placeholder made every folder output fail).
        cut = [0]
        rows = []
        for issue in issues:
            row = uni_issue_row(issue, run_id)
            row[4] = oid_field_value(oid_spec, row[4])
            rows.append([cut_utf8_bytes(v, folder, cut) for v in row])
        message_width = SHAPEFILE_MAX_TEXT if folder else 255
        specs = [{"name": "RUN_ID", "type": "TEXT", "values": [r[0] for r in rows] + ["x" * 24]},
                 {"name": "TOOL", "type": "TEXT", "values": [r[1] for r in rows] + ["x" * 40]},
                 {"name": "RULE_ID", "type": "TEXT", "values": [r[2] for r in rows] + ["x" * 60]},
                 {"name": "SOURCE", "type": "TEXT", "values": [r[3] for r in rows] + ["x" * 60]},
                 oid_spec,
                 {"name": "SEVERITY", "type": "TEXT", "length": 7},
                 {"name": "X", "type": "DOUBLE"},
                 {"name": "Y", "type": "DOUBLE"},
                 {"name": "MESSAGE", "type": "TEXT", "values": [r[8] for r in rows] + ["x" * message_width]},
                 {"name": "FIELD", "type": "TEXT", "values": [r[9] for r in rows] + ["x" * 60]},
                 {"name": "VALUE", "type": "TEXT", "values": [r[10] for r in rows] + ["x" * 60]}]
        assert [s["name"] for s in specs] == list(UNI_FIELDS)
        if oid_note:
            collector.info(oid_note)
        path, names = create_table(table_out, specs, inputs=inputs)
        null_fields = set()
        try:
            insert_rows(path, [names[s["name"]] for s in specs], rows, null_fields=null_fields)
        except Exception as err:
            try:
                safe_delete(path, inputs)
            except Exception:
                pass
            raise ToolError("The issue table could not be written: {0}".format(err),
                            "The report{0} was written. Choose another output location, for "
                            "example a file geodatabase.".format(
                                " ({0})".format(html_path) if html_path else ""))
        note = folder_null_number_warning(
            path, specs, names, null_fields,
            "Issues without a location have X = 0, Y = 0 (and a missing object id 0) in this "
            "output. When this table is read back, the Atlas reads SRC_OID 0 and X = Y = 0 as "
            "empty again (other programs see 0); write the table to a file geodatabase to keep "
            "them empty.")
        if note:
            collector.warning(note)
        if cut[0]:
            collector.warning("{0} text value(s) were cut to {1} bytes in this folder output (a "
                              "dBASE text field holds {1} bytes; an Arabic letter takes 2). Write "
                              "the table to a file geodatabase to keep the full text.".format(
                                  cut[0], SHAPEFILE_MAX_TEXT))
        return path


# ------------------------------------------------------------------ helpers

def _atlas_table_rows(param):
    """Rows ``[table, tool, checked]`` of the issue-table value table (empty cells None)."""
    rows = parse_value_table_text(param.valueAsText)
    if not rows and param.values:
        rows = param_value_table(param, 3)
    out = []
    for row in rows:
        cells = (list(row) + [None, None, None])[:3]
        if cells[0] is None:
            continue
        out.append([str(c).strip() if c is not None else None for c in cells])
    return out


def _atlas_pairs(param):
    """Rows ``[rule, severity]`` of the severity-override value table (empty cells None)."""
    if param.valueAsText is None and not param.values:
        return []
    rows = parse_value_table_text(param.valueAsText)
    out = []
    for row in rows:
        cells = (list(row) + [None, None])[:2]
        if cells[0] is None:
            continue
        out.append([str(c).strip() if c is not None else None for c in cells])
    return out


def _atlas_cell(row, name):
    """The value of column ``name`` (any case) of a row read from a table, or ``None``."""
    for key, value in row.items():
        if not str(key).startswith("_") and str(key).upper() == name:
            return value
    return None


def _atlas_partial_layer_text(desc, read, what, consequence):
    """A warning when a layer or table view gave fewer rows than its data source (a selection
    or a definition query), else ``None``."""
    if not desc.get("is_layer"):
        return None
    try:
        full = count_rows(desc["catalog_path"])
    except Exception:
        return None
    if full <= read:
        return None
    return ("Only {0} of {1} {2} of '{3}' were read: the layer or table view has a selection or "
            "a definition query (its data source {4} has {1}). {5}".format(
                read, full, what, desc["input"], desc["catalog_path"], consequence))


def _atlas_dbase_text(name, ids, places):
    """What was read as empty in a dBASE issue table (``atlas_dbase_empty_values``)."""
    parts = []
    if ids:
        parts.append("{0} issue(s) with SRC_OID 0 are read as having no object id (an ERROR "
                     "among them counts as one failing feature of its own, so the pass rate is a "
                     "lower bound; a shapefile FID 0 cannot be told apart from an empty cell and "
                     "is read the same way)".format(ids))
    if places:
        parts.append("{0} issue(s) with X = 0 and Y = 0 are read as having no location (the "
                     "row's geometry places them when it has one)".format(places))
    return ("{0} is a dBASE table, which cannot store an empty number (ArcGIS writes 0): {1}. "
            "Write issue tables to a file geodatabase to keep empty values empty.".format(
                name, "; ".join(parts)))


def _atlas_fraction_text(rate):
    return ("Minimum Pass Rate is a percentage (0 to 100): {0} means {0} %, not {1} %. Type "
            "{1} if you meant a fraction.".format(atlas_format_typed(rate), atlas_format_typed(rate * 100.0)))


def _atlas_unit_name(info):
    if not info:
        return "map units"
    if info.get("type") == "Geographic":
        return "degrees"
    per = info.get("meters_per_unit")
    if not per:
        return "map units"
    per = float(per)
    if abs(per - 1.0) < 1e-9:
        return "m"
    if abs(per - 1200.0 / 3937.0) < 1e-9:
        return "US ft"
    if abs(per - 0.3048) < 1e-9:
        return "ft"
    return "map units"


def _atlas_entries(param):
    entries = []
    for table, tool, checked in _atlas_table_rows(param):
        tool = (tool or UNI_TOOL_AUTO).strip()
        by_upper = dict((t.upper(), t) for t in UNI_TOOLS)
        if tool.upper() == UNI_TOOL_AUTO:
            tool = UNI_TOOL_AUTO
        elif tool.upper() in by_upper:
            tool = by_upper[tool.upper()]
        else:
            raise ToolError("Tool '{0}' is not supported.".format(tool),
                            "Use {0}, or leave it empty.".format(", ".join(UNI_TOOLS)))
        entries.append({"table": table, "tool": tool, "checked": checked or None})
    return entries


def _atlas_crs_label(info):
    if not info:
        return "coordinate system unknown"
    name = info.get("name") or "coordinate system"
    return "{0} (WKID {1})".format(name, info["wkid"]) if info.get("wkid") else name


# ==========================================================================
# quality/checkpoint_accuracy_tool.py
# ==========================================================================
# Positional Accuracy Report (NSSDA/ASPRS): the ArcGIS Pro tool (adapter).

_CPA_Z_UNITS = {"SAME_AS_XY": None, "METER": 1.0, "FOOT": 0.3048, "US_FOOT": 1200.0 / 3937.0}
_CPA_Z_UNIT_NAMES = {"METER": "Meter", "FOOT": "Foot", "US_FOOT": "Foot_US"}
_CPA_NUMERIC_TYPES = ("SmallInteger", "Integer", "BigInteger", "Single", "Double")
_CPA_NUMBER_PARAMS = (("search_tolerance_m", "Search tolerance"), ("h_class_cm", "Horizontal class"),
                      ("v_class_cm", "Vertical class"), ("nssda_h_limit_m", "NSSDA horizontal accuracy"),
                      ("nssda_v_limit_m", "NSSDA vertical accuracy"),
                      ("display_exaggeration", "Display exaggeration"))
# core option name -> dialog label, for the messages of accuracy_options (review R12 minor note)
_CPA_OPTION_LABELS = (("nssda_h_limit_m", "NSSDA Claimed Horizontal Accuracy (meters)"),
                      ("nssda_v_limit_m", "NSSDA Claimed Vertical Accuracy (meters)"),
                      ("h_class_cm", "ASPRS Horizontal Class, RMSEH (cm)"),
                      ("v_class_cm", "ASPRS Vertical Class, RMSEV (cm)"),
                      ("h2_cm", "Check Point Horizontal Accuracy, RMSEH2 (cm)"),
                      ("v2_cm", "Check Point Vertical Accuracy, RMSEV2 (cm)"))
_CPA_NONNEGATIVE_PARAMS = (("check_h_acc_cm", "Check point horizontal accuracy"),
                           ("check_v_acc_cm", "Check point vertical accuracy"))

# (output field, key in the residual row, AddField type)
_CPA_RESIDUAL_COLUMNS = (
    ("PAIR_ID", "pair_id", "LONG"), ("KEY", "key", "TEXT"), ("FEAT_OID", "feat_oid", "LONG"),
    ("CHK_OID", "chk_oid", "LONG"), ("X_FEAT", "x_feat", "DOUBLE"), ("Y_FEAT", "y_feat", "DOUBLE"),
    ("X_CHK", "x_chk", "DOUBLE"), ("Y_CHK", "y_chk", "DOUBLE"), ("DX", "dx", "DOUBLE"),
    ("DY", "dy", "DOUBLE"), ("DR", "dr", "DOUBLE"), ("AZIMUTH", "azimuth", "DOUBLE"),
    ("Z_FEAT", "z_feat", "DOUBLE"), ("Z_CHK", "z_chk", "DOUBLE"), ("DZ", "dz", "DOUBLE"),
    ("TERRAIN", "terrain", "TEXT"), ("METHOD", "method", "TEXT"), ("FLAGS", "flags", "TEXT"))
_CPA_UNPAIRED_COLUMNS = (("SIDE", "side", "TEXT"), ("SRC_OID", "oid", "LONG"), ("KEY", "key", "TEXT"),
                         ("REASON", "reason", "TEXT"), ("DETAIL", "detail", "TEXT"))
_CPA_SUMMARY_TEXT = ("SUBSET", "NSSDA_HRES", "NSSDA_VRES", "H_RESULT", "V_RESULT", "N_FLAG", "NZ_FLAG",
                     "BIAS_FLAG", "UNIT", "Z_UNIT", "CRS_NAME", "NOTES")
_CPA_SUMMARY_LONG = ("N_PAIRS", "N_WITH_Z", "N_NO_CHK", "BLUNDERS", "CRS_WKID")
_CPA_NULL_NOTE = ("0 there can mean 'not available' (no elevation, no direction for a zero displacement, "
                  "a statistic the standard does not define for the data), not a measured zero; read the "
                  "result columns and NOTES with it.")
_CPA_FIXED_LENGTHS = {"SIDE": 8, "REASON": 32, "METHOD": 16, "FLAGS": 40, "SUBSET": 8,
                      "N_FLAG": 8, "NZ_FLAG": 8, "DISPLAY_ONLY": 3, "UNIT": 16, "Z_UNIT": 16, "NSSDA_HRES": 24,
                      "NSSDA_VRES": 24, "H_RESULT": 24, "V_RESULT": 24, "BIAS_FLAG": 40}


def _cpa_oid_list(oids, limit=20):
    text = ", ".join(str(o) for o in oids[:limit])
    return text + (" ... ({0} more)".format(len(oids) - limit) if len(oids) > limit else "")


def _cpa_specs(columns, rows):
    """Field specs for ``columns`` (name, row key, type); text width from the values."""
    specs = []
    for name, key, kind in columns:
        spec = {"name": name, "type": kind}
        if kind == "TEXT":
            if name in _CPA_FIXED_LENGTHS:
                spec["length"] = _CPA_FIXED_LENGTHS[name]
            else:
                spec["values"] = [r.get(key) for r in rows]
        specs.append(spec)
    return specs


def _cpa_oid_fields(out_path, specs, rows, columns, collector):
    """Give the ObjectID ``columns`` (name, row key) of ``specs`` the toolkit's one ObjectID field
    rule (``arcio.oid_field_spec``); returns the rows to write (new dicts when the ids become
    text, so the report rows are never changed)."""
    if not out_path:
        return rows
    for name, key in columns:
        spec = oid_output_field(out_path, [r.get(key) for r in rows], collector, name=name)
        for i, old in enumerate(specs):
            if old["name"] == name:
                specs[i] = spec
        if spec["type"] == "TEXT":
            rows = [dict(r, **{key: oid_field_value(spec, r.get(key))}) for r in rows]
    return rows


_CPA_CUT = " ...[cut]"


def _cpa_fit_folder_text(out_path, columns, rows, label, collector):
    """Rows whose text values fit a shapefile / dBASE field (254 bytes), else ``rows`` unchanged.

    A dBASE text field written by ArcGIS Pro holds at most 254 bytes in UTF-8 (an Arabic letter
    takes 2; the shared writer refuses a wider value, ``arcio._arcio_text_length``), and the run must
    not stop for it (the default NOTES text is 369 characters; a NO_KEY_MATCH detail that quotes two
    Arabic keys of about 40 characters is already above 254 bytes). In a folder the value is cut at a
    character boundary by the writer's own byte rule (``arcio.cut_utf8_bytes``) and ends with
    ``...[cut]``; a warning says how many values and in which fields. A file geodatabase keeps the
    full text. Returns new row dicts for the table (the rows used for the report are never changed).
    """
    if not out_path or not is_folder_workspace(workspace_of(out_path)):
        return rows
    cut = {}
    out = []
    for row in rows:
        new = None
        for name, key, kind in columns:
            value = row.get(key)
            if kind != "TEXT" or not isinstance(value, str):
                continue
            counter = [0]
            short = cut_utf8_bytes(value, True, counter, _CPA_CUT)
            if not counter[0]:
                continue
            if new is None:
                new = dict(row)
            new[key] = short
            cut[name] = cut.get(name, 0) + 1
            if name == "NOTES":
                collector.info("{0} NOTES (full text, cut to {1} bytes in the {2}): {3}".format(
                    row.get("SUBSET", ""), SHAPEFILE_MAX_TEXT, label, value))
        out.append(new if new is not None else row)
    if cut:
        collector.warning("{0}: a shapefile or dBASE text field holds at most {1} bytes in UTF-8 (an Arabic letter "
                          "takes 2), so {2} were cut and end with '...[cut]'. The full text is in the messages "
                          "(NOTES) and in the report; write the output to a file geodatabase to keep it "
                          "whole.".format(
                              label, SHAPEFILE_MAX_TEXT,
                              ", ".join("{0} value(s) of {1}".format(n, name) for name, n in sorted(cut.items()))))
    return out


def _cpa_table_rows(columns, rows):
    return [tuple(r.get(key) for _name, key, _kind in columns) for r in rows]


def _cpa_summary_columns():
    out = []
    for name in SUMMARY_FIELDS:
        kind = "TEXT" if name in _CPA_SUMMARY_TEXT else "LONG" if name in _CPA_SUMMARY_LONG else "DOUBLE"
        out.append((name, name, kind))
    return tuple(out)


def _cpa_linear_unit(desc, mpu):
    """Name of the linear unit of the input's projected system."""
    name = getattr(desc["sr_object"], "linearUnitName", None)
    return unit_label(mpu, name if isinstance(name, str) and name else None)


def _cpa_resolve_field(desc, wanted, label, numeric=False, text=False):
    """Field dict for a Field parameter value, checked for its type; ``None`` when empty."""
    if not wanted:
        return None
    field, how = match_field(desc["fields"], wanted, label=label, exact_name_first=True)
    if numeric and field["type"] not in _CPA_NUMERIC_TYPES:
        raise ToolError("The {0} '{1}' is not a number field (it is {2}).".format(label, field["name"], field["type"]),
                        "Choose a numeric field (short, long, float or double) holding the elevation.")
    if text and field["type"] != "String":
        raise ToolError("The {0} '{1}' is not a text field (it is {2}).".format(label, field["name"], field["type"]),
                        "Choose a text field holding the values NVA or VVA.")
    return field, how


class CheckPointAccuracyReport(object):
    """Positional accuracy of a dataset against independent check points (NSSDA and ASPRS Ed. 2)."""

    DOC = {
        "summary": "Compares features (points, or lines and polygons by their centroid) with independent "
                   "check points of higher accuracy and reports the positional accuracy twice, side by "
                   "side: NSSDA (FGDC-STD-007.3-1998, accuracy at the 95 % confidence level) and ASPRS "
                   "Positional Accuracy Standards for Digital Geospatial Data, Edition 2 (RMSEH, RMSEV, "
                   "RMSE3D, with non-vegetated and vegetated vertical accuracy when a terrain class field "
                   "is given). Writes a residual table, a summary table, a list of everything that could "
                   "not be paired, true displacement lines, optional exaggerated display lines and an "
                   "optional plot. Read-only.",
        "usage": "Both inputs must be in the same projected coordinate system with a known linear unit "
                 "(geographic degrees, an unknown system, Web and World Mercator and the world equidistant "
                 "cylindrical (Plate Carree) systems are refused: the residuals are ground distances). The tool does no projection and no datum transformation. The "
                 "coordinate system and the unit are written to the summary table and the report. A "
                 "residual is feature minus check point.\n\nPairing. KEY: features and check points with "
                 "the same key text are paired (exact match after trimming and Unicode normalisation; "
                 "upper and lower case, inner spaces and leading zeros are not folded, and a hint is "
                 "given when a key differs only that way). A key that occurs more than once on either "
                 "side pairs nothing and every row carrying it is listed, "
                 "even when one copy has no geometry. NEAREST: a check point is "
                 "paired with the one feature within the search tolerance; when two or more features are "
                 "in range, or two check points claim the same feature, nothing is paired and the "
                 "candidates are listed as AMBIGUOUS. The tool never picks one. Unpaired rows of both "
                 "sides, with the reason, are written to the unpaired table. A check point that is not "
                 "paired for any reason except its own missing geometry is not compared: it is left out "
                 "of every statistic, and while there is one no ASPRS conformance sentence and no NSSDA "
                 "'Tested' sentence is written (the values are given as computed).\n\nLines and polygons are "
                 "represented by their centroid (length-weighted for lines, area-weighted for polygons; "
                 "the centroid of a concave polygon can lie outside it). A centroid is not a well-defined "
                 "point, so such a comparison measures agreement of the centroids and is not an NSSDA "
                 "test of well-defined points; the METHOD field says how each point was made.\n\n"
                 "Statistics. RMSE uses the divisor n. NSSDA horizontal: Accuracy_r = 2.4477 * 0.5 * "
                 "(RMSEx + RMSEy) when RMSEmin/RMSEmax is between 0.6 and 1.0 (Appendix 3-A, Case 2); "
                 "outside that range the standard gives no formula and the value is left empty, with the "
                 "Case 1 value 1.7308 * RMSEr (valid if RMSEx = RMSEy) shown for reference only. NSSDA "
                 "vertical: 1.9600 * RMSEz. ASPRS Ed. 2: RMSEH = sqrt(RMSEx^2 + RMSEy^2), RMSEV = RMSEz, "
                 "RMSE3D = sqrt(RMSEH^2 + RMSEV^2), each combined with the survey accuracy of the check "
                 "points (RMSE2) when given; otherwise the result is the fit to the check points only "
                 "and says so. The check counts are flagged against the published minimums (NSSDA 20, "
                 "ASPRS 30), the mean error against 25 % of the class (ASPRS 7.2) and single "
                 "discrepancies above 3 times the class (blunders). VVA is reported and has no "
                 "pass/fail threshold. Every constant, formula and page is listed in docs/standards.md.\n\n"
                 "Elevations are read from fields (no surface is sampled) and are used as stored: the "
                 "tool cannot check that both heights refer to the same vertical datum. The unit of the "
                 "elevations is the horizontal unit unless Elevation Unit says otherwise.\n\nDisplay "
                 "lines run from the check point to the feature point. Output Displacement Lines hold "
                 "the true displacement; Output Display Lines are stretched by the exaggeration factor "
                 "for map display only (field DISPLAY_ONLY; in a shapefile folder the name is cut to "
                 "DISPLAY_ON) and must not be measured. In a folder (dBASE, shapefile) empty numbers "
                 "are stored as 0, with a warning.\n\nSelections and definition queries on the input "
                 "layers are honoured. The inputs are never modified. Existing outputs are replaced only "
                 "when geoprocessing is allowed to overwrite outputs.",
        "params": {
            "in_features": "The dataset under test: point, line or polygon features.",
            "in_checks": "Independent check points of higher accuracy than the dataset (point features).",
            "pair_method": "KEY pairs by equal key text; NEAREST pairs by distance and reports "
                           "ambiguity instead of guessing.",
            "feature_key": "Key field of the features. Required for KEY; for NEAREST it only labels "
                           "the pairs: a pair whose keys differ is flagged KEY_DIFFERS, named in a warning "
                           "and counted in the report, and stays in the statistics.",
            "check_key": "Key field of the check points. Required for KEY.",
            "search_tolerance_m": "NEAREST: the largest distance in metres between a check point and "
                                  "its feature. Required for NEAREST. A check point with no feature within it "
                                  "is not paired (NO_FEATURE_WITHIN_TOLERANCE) and is left out of every "
                                  "statistic; while any check point is not compared, no conformance or "
                                  "'Tested' sentence is written. So the tolerance is not a blunder filter: "
                                  "make it larger than the largest error to find (at least 3 times the "
                                  "horizontal class).",
            "feature_z": "Optional elevation field of the features (needed for vertical accuracy).",
            "check_z": "Optional elevation field of the check points (needed for vertical accuracy).",
            "z_unit": "Unit of both elevation fields: the horizontal unit (default), meters, "
                      "international feet or US survey feet.",
            "terrain_field": "Optional text field of the check points with NVA (non-vegetated) or VVA "
                             "(vegetated). Other values are listed in the messages and counted in the overall "
                             "statistics only.",
            "standard": "Which statistics to compute: both side by side (default), NSSDA or ASPRS Ed. 2.",
            "h_class_cm": "ASPRS horizontal accuracy class: the target RMSEH in centimeters. Enables "
                          "the pass/fail result, and the conformance sentence after a PASS.",
            "v_class_cm": "ASPRS vertical accuracy class: the target RMSEV (NVA) in centimeters.",
            "check_h_acc_cm": "Survey accuracy of the check points (RMSEH2) in centimeters, combined "
                              "into RMSEH. Leave empty if unknown; a result within the class is then "
                              "FIT_PASS (the fit to the check points only), not PASS.",
            "check_v_acc_cm": "Survey accuracy of the check point elevations (RMSEV2) in centimeters.",
            "nssda_h_limit_m": "Optional horizontal accuracy in meters the data claims at 95 %; the "
                               "tool says whether the tested accuracy is within it.",
            "nssda_v_limit_m": "Optional vertical accuracy in meters the data claims at 95 %.",
            "well_defined": "Tick only if the compared points are discrete, well-defined points (for example "
                            "surveyed corners or marked targets), which is what NSSDA and ASPRS test. Without "
                            "it the numbers are reported but no conformance or 'tested' sentence is written. "
                            "The NSSDA 'Tested' sentence also needs at least 20 check points (NSSDA 3.2.2). "
                            "Centroids of lines and polygons are never such points.",
            "out_residuals": "Output table with one row per pair: coordinates, DX, DY, DR, AZIMUTH "
                             "(degrees clockwise from grid north), elevations, DZ, TERRAIN, METHOD, "
                             "FLAGS.",
            "out_summary": "Output table with one row per subset (ALL, and NVA and VVA when a terrain "
                           "field is given): counts, mean, standard deviation, RMSE, NSSDA, ASPRS "
                           "results, flags, unit, coordinate system and notes.",
            "out_unpaired": "Output table of every check point that was not paired and every feature "
                            "that was not paired for a reason that needs a look, with the reason. "
                            "Features that merely have no check point are listed only when the "
                            "option below is ticked.",
            "list_absent_features": "Off (default): features that merely have no check point (KEY: no check "
                                    "point with the key; NEAREST: no check point within the tolerance) are "
                                    "counted, in the messages and the N_NO_CHK column of the summary, but not "
                                    "listed. A large layer with a few hundred check points would otherwise "
                                    "bury the rows that matter. Check points, and features with a real "
                                    "problem (null geometry or key, duplicate, ambiguous), are always listed. "
                                    "On: every unpaired feature is listed.",
            "out_vectors": "Optional line feature class: the true displacement of each pair, from the "
                           "check point to the feature point.",
            "out_display": "Optional line feature class: the displacement lines stretched by the "
                           "exaggeration factor, for display only (field DISPLAY_ONLY).",
            "display_exaggeration": "Factor by which Output Display Lines and the plot arrows are stretched. "
                                    "Empty (default): automatic, the largest of 1, 2, 5, 10, 20, 50 ... that "
                                    "draws the median error at most about 3 % of the extent of the check points long "
                                    "and no error longer than 15 % of it (never below 1). The factor used is "
                                    "written to the messages, to EXAGG of the display lines and to the plot.",
            "out_report": "Optional Excel (.xlsx) or CSV report: Summary sheet (statistics, statements) "
                          "and Detail sheet (the residuals).",
            "out_plot": "Optional PNG with the residual vectors and a histogram of the horizontal "
                        "error (needs matplotlib, which ArcGIS Pro includes). When the errors spread over less "
                        "than 1 cm, the colour scale and the histogram are not stretched to that spread and the "
                        "title gives the common value.",
            "pair_count": "Number of pairs (derived).",
        },
        "tags": ["accuracy", "NSSDA", "ASPRS", "RMSE", "check points", "positional accuracy", "QA"],
    }

    def __init__(self):
        self.label = "Positional Accuracy Report (NSSDA/ASPRS)"
        self.description = ("Positional accuracy against check points: NSSDA and ASPRS Ed. 2 side by "
                            "side, with residuals and displacement lines (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_features", "Features to Test", "GPFeatureLayer",
                       value_list=["Point", "Polyline", "Polygon"]),
            make_param("in_checks", "Check Points", "GPFeatureLayer", value_list=["Point"]),
            make_param("pair_method", "Pairing Method", "GPString", value_list=list(PAIR_METHODS),
                       default=PAIR_KEY),
            make_param("feature_key", "Key Field of the Features", "Field", required=False,
                       depends_on="in_features"),
            make_param("check_key", "Key Field of the Check Points", "Field", required=False,
                       depends_on="in_checks"),
            make_param("search_tolerance_m", "Search Tolerance (meters)", "GPDouble", required=False),
            make_param("feature_z", "Elevation Field of the Features", "Field", required=False,
                       depends_on="in_features", value_list=["Short", "Long", "BigInteger", "Float", "Double"],
                       category="Elevation"),
            make_param("check_z", "Elevation Field of the Check Points", "Field", required=False,
                       depends_on="in_checks", value_list=["Short", "Long", "BigInteger", "Float", "Double"],
                       category="Elevation"),
            make_param("z_unit", "Elevation Unit", "GPString", required=False,
                       value_list=list(_CPA_Z_UNITS), default="SAME_AS_XY", category="Elevation"),
            make_param("terrain_field", "Terrain Class Field (NVA / VVA)", "Field", required=False,
                       depends_on="in_checks", value_list=["Text"], category="Elevation"),
            make_param("standard", "Standard", "GPString", required=False, value_list=list(STANDARDS),
                       default="BOTH", category="Standards"),
            make_param("h_class_cm", "ASPRS Horizontal Class, RMSEH (cm)", "GPDouble", required=False,
                       category="Standards"),
            make_param("v_class_cm", "ASPRS Vertical Class, RMSEV (cm)", "GPDouble", required=False,
                       category="Standards"),
            make_param("check_h_acc_cm", "Check Point Horizontal Accuracy, RMSEH2 (cm)", "GPDouble",
                       required=False, category="Standards"),
            make_param("check_v_acc_cm", "Check Point Vertical Accuracy, RMSEV2 (cm)", "GPDouble",
                       required=False, category="Standards"),
            make_param("nssda_h_limit_m", "NSSDA Claimed Horizontal Accuracy (meters)", "GPDouble",
                       required=False, category="Standards"),
            make_param("nssda_v_limit_m", "NSSDA Claimed Vertical Accuracy (meters)", "GPDouble",
                       required=False, category="Standards"),
            make_param("well_defined", "Points Are Well-Defined (declaration)", "GPBoolean", required=False,
                       default=False, category="Standards"),
            make_param("out_residuals", "Output Residual Table", "DETable", direction="Output"),
            make_param("out_summary", "Output Summary Table", "DETable", direction="Output"),
            make_param("out_unpaired", "Output Unpaired Table", "DETable", direction="Output"),
            make_param("list_absent_features", "List Features Without a Check Point", "GPBoolean", required=False,
                       default=False, category="Display outputs"),
            make_param("out_vectors", "Output Displacement Lines", "DEFeatureClass", direction="Output",
                       required=False, category="Display outputs"),
            make_param("out_display", "Output Display Lines (exaggerated)", "DEFeatureClass",
                       direction="Output", required=False, category="Display outputs"),
            make_param("display_exaggeration", "Display Exaggeration Factor (empty = automatic)", "GPDouble",
                       required=False, category="Display outputs"),
            make_param("out_report", "Output Report", "DEFile", direction="Output", required=False,
                       value_list=["xlsx", "csv"], category="Display outputs"),
            make_param("out_plot", "Output Plot (PNG)", "DEFile", direction="Output", required=False,
                       value_list=["png"], category="Display outputs"),
            derived_output("pair_count", "Pair Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        for name, label in _CPA_NUMBER_PARAMS:
            value = p[name].value
            if value is not None and float(value) <= 0:
                p[name].setErrorMessage("The {0} must be above zero.".format(label.lower()))
        for name, label in _CPA_NONNEGATIVE_PARAMS:
            value = p[name].value
            if value is not None and float(value) < 0:
                p[name].setErrorMessage("The {0} must be zero or more.".format(label.lower()))
        method = (p["pair_method"].valueAsText or PAIR_KEY).upper()
        if method == PAIR_KEY:
            if p["in_features"].value is not None and p["feature_key"].value is None:
                p["feature_key"].setErrorMessage("Pairing by KEY needs a key field of the features.")
            if p["in_checks"].value is not None and p["check_key"].value is None:
                p["check_key"].setErrorMessage("Pairing by KEY needs a key field of the check points.")
        elif method == PAIR_NEAREST and p["search_tolerance_m"].value is None:
            p["search_tolerance_m"].setErrorMessage("Pairing by NEAREST needs a search tolerance.")
        if (p["feature_z"].value is None) != (p["check_z"].value is None):
            missing = p["check_z"] if p["feature_z"].value is not None else p["feature_z"]
            missing.setErrorMessage("Give an elevation field for both the features and the check points, "
                                    "or for neither.")
        # The error goes on the output that repeats an earlier one (not always on out_unpaired).
        out_names = ("out_residuals", "out_summary", "out_unpaired", "out_vectors", "out_display")
        out_labels = {"out_residuals": "Output Residual Table", "out_summary": "Output Summary Table",
                      "out_unpaired": "Output Unpaired Table", "out_vectors": "Output Displacement Lines",
                      "out_display": "Output Display Lines"}
        seen = []
        for name in out_names:
            text = param_text(p[name])
            if not text:
                continue
            first = [n for n, t in seen if find_duplicate_outputs([t, text])]
            if first:
                p[name].setErrorMessage("This output is the same dataset as {0}; give each output its "
                                        "own name.".format(out_labels[first[0]]))
                break
            seen.append((name, text))
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))

    # ------------------------------------------------------------------
    def _plot_path(self, p, report):
        """Checked PNG path, or ``None``. Refuses an input, a report file or an existing file."""
        text = param_text(p["out_plot"])
        if not text:
            return None
        if os.path.splitext(text)[1].casefold() != ".png":
            text += ".png"
        refuse_report_on_inputs([text], input_texts(p))
        if report and text.casefold() in [x.casefold() for x in report["paths"]]:
            raise ToolError("The plot file and the report file are the same file.",
                            "Give the plot and the report different names.")
        folder = os.path.dirname(os.path.abspath(text))
        if not os.path.isdir(folder):
            raise ToolError("The plot folder '{0}' does not exist.".format(folder),
                            "Choose an existing folder for the plot.")
        refuse_existing_report_files([text], overwrite_output())
        return text

    def _options(self, p, mpu, has_class):
        method = (param_text(p["pair_method"]) or PAIR_KEY).upper()
        standard = (param_text(p["standard"]) or "BOTH").upper()
        z_choice = (param_text(p["z_unit"]) or "SAME_AS_XY").upper()
        if method not in PAIR_METHODS:
            raise ToolError("Unknown pairing method '{0}'.".format(method),
                            "Choose one of: {0}.".format(", ".join(PAIR_METHODS)))
        if standard not in STANDARDS:
            raise ToolError("Unknown standard '{0}'.".format(standard),
                            "Choose one of: {0}.".format(", ".join(STANDARDS)))
        if z_choice not in _CPA_Z_UNITS:
            raise ToolError("Unknown elevation unit '{0}'.".format(z_choice),
                            "Choose one of: {0}.".format(", ".join(_CPA_Z_UNITS)))
        try:
            opts = accuracy_options(
                standard=standard, h_class_cm=param_number(p["h_class_cm"]),
                v_class_cm=param_number(p["v_class_cm"]),
                nssda_h_limit_m=param_number(p["nssda_h_limit_m"]),
                nssda_v_limit_m=param_number(p["nssda_v_limit_m"]),
                h2_cm=param_number(p["check_h_acc_cm"]), v2_cm=param_number(p["check_v_acc_cm"]),
                meters_per_unit=mpu, has_class_field=has_class,
                z_meters_per_unit=_CPA_Z_UNITS[z_choice], z_unit=_CPA_Z_UNIT_NAMES.get(z_choice),
                well_defined=param_bool(p["well_defined"]))
        except ValueError as exc:
            text = str(exc)
            for name, label in _CPA_OPTION_LABELS:
                if text.startswith(name + " "):
                    text = "'{0}'{1}".format(label, text[len(name):])
                    break
            raise ToolError(text + ".", "Correct the value and run the tool again.")
        tolerance = param_number(p["search_tolerance_m"])
        if method == PAIR_NEAREST and not tolerance:
            raise ToolError("Pairing by NEAREST needs a search tolerance above zero.",
                            "Give a Search Tolerance in meters a little larger than the largest error to find "
                            "(at least 3 times the horizontal class, so that a blunder is still paired).")
        exaggeration = param_number(p["display_exaggeration"])   # None = automatic (see auto_exaggeration)
        if exaggeration is not None and exaggeration <= 0:
            raise ToolError("The display exaggeration must be above zero.",
                            "Give a factor such as 10, or leave it empty for the automatic factor.")
        return method, opts, (tolerance / mpu if tolerance else None), exaggeration

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        plot = self._plot_path(p, report)
        feats = describe_dataset(param_text(p["in_features"]))
        checks = describe_dataset(param_text(p["in_checks"]))
        inputs = [feats["catalog_path"], checks["catalog_path"]]
        f_kind = kind_from_shape_type(feats["shape_type"])
        if f_kind not in (GEOM_POINT, GEOM_POLYLINE, GEOM_POLYGON):
            raise ToolError("The features to test must be points, lines or polygons.",
                            "Choose a point, line or polygon layer.")
        if kind_from_shape_type(checks["shape_type"]) != GEOM_POINT:
            raise ToolError("The check points must be point features (not multipoints, lines or polygons).",
                            "Choose a point layer with one check point per feature.")

        # Coordinate systems first: nothing is read or written for data that cannot be compared.
        for label, desc in (("features", feats), ("check points", checks)):
            refusal = crs_refusal(desc["sr"], label)
            if refusal:
                raise ToolError(*refusal)
        if not same_crs(feats["sr"], checks["sr"]):
            raise ToolError("The features ({0}) and the check points ({1}) are in different coordinate "
                            "systems.".format(feats["sr"]["name"], checks["sr"]["name"]),
                            "Project one of them with the Project tool so both use the same projected "
                            "system. The tool does no projection or datum transformation of its own.")
        mpu = float(checks["sr"]["meters_per_unit"])
        crs = {"name": checks["sr"]["name"], "wkid": checks["sr"]["wkid"], "mpu": mpu,
               "unit": _cpa_linear_unit(checks, mpu)}

        # Fields.
        f_key = c_key = f_z = c_z = terrain = None
        infos = []
        pair_method = (param_text(p["pair_method"]) or PAIR_KEY).upper()
        for wanted, desc, label, side in ((param_text(p["feature_key"]), feats, "key field of the features", "f_key"),
                                          (param_text(p["check_key"]), checks, "key field of the check points", "c_key"),
                                          (param_text(p["feature_z"]), feats, "elevation field of the features", "f_z"),
                                          (param_text(p["check_z"]), checks, "elevation field of the check points", "c_z"),
                                          (param_text(p["terrain_field"]), checks, "terrain class field", "terrain")):
            got = _cpa_resolve_field(desc, wanted, label, numeric=side in ("f_z", "c_z"), text=side == "terrain")
            if got is None:
                continue
            field, how = got
            infos.append(match_message(wanted, field, how))
            if side == "f_key":
                f_key = field["name"]
            elif side == "c_key":
                c_key = field["name"]
            elif side == "f_z":
                f_z = field["name"]
            elif side == "c_z":
                c_z = field["name"]
            else:
                terrain = field["name"]
        for text in infos:
            collector.info(text)
        if pair_method == PAIR_KEY and not (f_key and c_key):
            raise ToolError("Pairing by KEY needs a key field for the features and for the check points.",
                            "Choose both key fields, or pair by NEAREST.")
        if bool(f_z) != bool(c_z):
            raise ToolError("An elevation field was given for only one of the inputs.",
                            "Give an elevation field for both the features and the check points, or for neither.")
        method, opts, tolerance, exaggeration = self._options(p, mpu, bool(terrain))

        # Every output is checked before anything is read or written (no half-finished runs).
        out_res = param_text(p["out_residuals"])
        out_sum = param_text(p["out_summary"])
        out_unp = param_text(p["out_unpaired"])
        out_vec = param_text(p["out_vectors"])
        out_dis = param_text(p["out_display"])
        outs = [o for o in (out_res, out_sum, out_unp, out_vec, out_dis) if o]
        refuse_duplicate_outputs(outs)
        for out in outs:
            check_output_path(out, inputs)
        if method == PAIR_KEY and param_number(p["search_tolerance_m"]):
            collector.info("The search tolerance is not used when pairing by KEY.")

        progress = Progress("Reading the features and the check points", 0)
        f_fields = [f for f in (f_key, f_z) if f]
        c_fields = [f for f in (c_key, c_z, terrain) if f]
        f_rows = read_features(feats["input"], f_fields)
        c_rows = read_features(checks["input"], c_fields)
        features = prepare_records(f_rows, f_kind, f_key, f_z, None)
        check_recs = prepare_records(c_rows, GEOM_POINT, c_key, c_z, terrain)
        report_notes = []
        bad_z = invalid_z_note(features, check_recs)
        if bad_z:
            collector.warning(bad_z)
            report_notes.append(bad_z)
        if f_kind != GEOM_POINT:
            report_notes.append("The features are {0}s compared by their centroid. A centroid is not a "
                                "well-defined point, so this measures the agreement of centroids and is not an "
                                "NSSDA test of well-defined points.".format(
                                    "line" if f_kind == GEOM_POLYLINE else "polygon"))
        if not opts["well_defined"]:
            report_notes.append("Points Are Well-Defined was not ticked: the numbers are reported, but no "
                                "conformance or 'tested' sentence is written (NSSDA 3.2.2 and ASPRS 7.13 test "
                                "horizontal accuracy at discrete, well-defined points; the tool also holds back the "
                                "vertical sentences without this declaration, its own stricter rule).")
        progress.label("Pairing {0} check points with {1} features".format(len(check_recs), len(features)))
        list_absent = param_bool(p["list_absent_features"])
        result = run_accuracy(features, check_recs, method, tolerance, opts, crs, exaggeration or 1.0,
                              list_absent_features=list_absent)
        rows, unpaired, summary, counts = result["rows"], result["unpaired"], result["summary"], result["counts"]
        if method == PAIR_NEAREST:
            n_ambiguous = sum(1 for u in unpaired if u["side"] == SIDE_CHECK and u["reason"] == "AMBIGUOUS")
            wide = tolerance_extent_note(features, check_recs, tolerance, crs["unit"], mpu, ambiguous=n_ambiguous)
            if wide:
                collector.warning(wide)
                report_notes.append(wide)
        exagg_auto = exaggeration is None
        if exagg_auto:
            exaggeration = auto_exaggeration(rows)

        # ---- messages ---------------------------------------------------
        collector.info("Coordinate system: {0} (WKID {1}); distances in {2} (1 unit = {3:.10g} m). "
                       "Residual = feature minus check point.".format(crs["name"], crs["wkid"], crs["unit"], mpu))
        if opts["z_unit"] and f_z:
            collector.info("Elevations are read as {0}.".format(opts["z_unit"]))
        if f_z:
            collector.info("Elevations are used as stored; the tool cannot check that both fields refer to "
                           "the same vertical datum.")
        info, warning = constants_notes()
        collector.info(info)
        if warning:
            collector.warning(warning)
        if f_kind != GEOM_POINT:
            collector.warning("The features are {0}s, represented by their centroid. A centroid is not a "
                              "well-defined point, so this measures the agreement of centroids and is not an "
                              "NSSDA test of well-defined points.".format(
                                  "line" if f_kind == GEOM_POLYLINE else "polygon"))
        collector.info("{0} pair(s) formed by {1} from {2} check point(s) and {3} feature(s).".format(
            counts["pairs"], method, counts["checks"], counts["features"]))
        if counts["features_absent"] and not list_absent:
            collector.info("{0} feature(s) have no check point ({1}). They are counted (N_NO_CHK of the summary) "
                           "and not listed in the unpaired table; tick 'List Features Without a Check Point' to "
                           "list them. Check points and features with a problem are always listed.".format(
                               counts["features_absent"],
                               "no check point with the key" if method == PAIR_KEY else
                               "no check point within the search tolerance"))
        reasons = {}
        for item in unpaired:
            reasons.setdefault((item["side"], item["reason"]), []).append(item["oid"])
        for (side, reason), oids in sorted(reasons.items()):
            text = "{0} {1} not paired: {2} (OID {3}).".format(
                len(oids), "check point(s)" if side == SIDE_CHECK else "feature(s)", reason,
                _cpa_oid_list(sorted(oids)))
            if reason in CPA_ABSENCE_REASONS and side != SIDE_CHECK:
                collector.info(text)
            elif side == SIDE_CHECK and reason not in CPA_NOT_COMPARED_EXEMPT:
                collector.warning(text + " See the unpaired table. Not compared: left out of every statistic.")
            else:
                collector.warning(text + " See the unpaired table.")
        if result["not_compared_text"]:
            collector.warning(result["not_compared_text"])
        differs = key_differs_text(rows)
        if differs:
            collector.warning(differs)
            report_notes.append(differs)
        if not rows:
            collector.warning("No pairs were formed, so no accuracy statistics were computed. See the "
                              "unpaired table for the reason.")
        for item in summary:
            if item["N_PAIRS"]:
                line = ("{0}: n = {1}; RMSEx = {2:.4f}, RMSEy = {3:.4f}, RMSEr = {4:.4f} {5}".format(
                    item["SUBSET"], item["N_PAIRS"], item["RMSE_X"], item["RMSE_Y"], item["RMSE_R"], crs["unit"]))
                if item["NSSDA_H95"] is not None:
                    line += "; NSSDA horizontal 95 % = {0:.4f} {1}".format(item["NSSDA_H95"], crs["unit"])
                if item["RMSEH_CM"] is not None:
                    line += "; ASPRS RMSEH = {0:.2f} cm".format(item["RMSEH_CM"])
                if item["RMSEV_CM"] is not None:
                    line += "; RMSEV = {0:.2f} cm".format(item["RMSEV_CM"])
                collector.info(line + ".")
        if summary and summary[0]["N_PAIRS"]:
            top = summary[0]
            n = top["N_PAIRS"]
            if opts["standard"] in ("NSSDA", "BOTH") and n < cpa_constant("NSSDA_MIN_POINTS"):
                collector.warning("Only {0} pair(s): NSSDA asks for at least {1} check points (3.2.2). Treat the "
                                  "result as indicative; no NSSDA 'Tested' sentence is written for it.".format(
                                      n, cpa_constant("NSSDA_MIN_POINTS")))
            # not elif: with BOTH and fewer than 20 pairs both minimums are missed and both are said (review R10)
            if opts["standard"] in ("ASPRS_ED2", "BOTH") and n < cpa_constant("ASPRS_MIN_POINTS"):
                collector.warning("Only {0} pair(s): ASPRS Edition 2 asks for at least {1} check points "
                                  "(7.14). The reduced-number wording is used in the statements.".format(
                                      n, cpa_constant("ASPRS_MIN_POINTS")))
            if opts["standard"] in ("NSSDA", "BOTH") and top["NSSDA_H95"] is None and top["XY_RATIO"] is not None:
                collector.warning("NSSDA horizontal accuracy is not stated: RMSEmin/RMSEmax = {0} is below "
                                  "{1} (Case 2 of Appendix 3-A). Look for a systematic shift or a skewed "
                                  "error pattern.".format(ratio_text(top["XY_RATIO"]), cpa_constant("NSSDA_RATIO_MIN")))
            for item in summary:
                if item["BLUNDERS"]:
                    collector.warning("{0}: {1} pair(s) exceed 3 times the class in a component (ASPRS 7.2 "
                                      "blunder); see FLAGS.".format(item["SUBSET"], item["BLUNDERS"]))
                if item["BIAS_FLAG"] not in (None, "OK", "NO_CLASS_GIVEN", "NO_DATA", "NOT_ASSESSED",
                                              "NO_Z_DATA"):
                    collector.warning("{0}: mean error is above 25 % of the class ({1}); the residuals look "
                                      "biased (ASPRS 7.2).".format(item["SUBSET"], item["BIAS_FLAG"]))
        if terrain and result["unclassified"]:
            collector.warning("{0} pair(s) have a terrain class other than NVA or VVA ({1}); they are in ALL "
                              "only.".format(result["unclassified"],
                                             terrain_values_text(result["unclassified_values"])))
            if not any(item["N_PAIRS"] for item in summary[1:]):
                collector.warning("No check point has a recognised terrain class (NVA or VVA), so the NVA and "
                                  "VVA rows are empty and there is no vertical verdict. Check the values of "
                                  "the terrain class field.")
        if terrain and summary and summary[0]["V_RESULT"] == "NO_NVA_POINTS" and any(
                item["N_PAIRS"] for item in summary[1:]):
            collector.warning("No pair with an elevation is classed NVA, so there is no vertical verdict "
                              "(V_RESULT NO_NVA_POINTS): ASPRS Ed. 2 holds only the NVA to the vertical class.")
        if summary and summary[0]["N_PAIRS"]:
            top = summary[0]
            fit = [w for w in (top["H_RESULT"], top["V_RESULT"]) if str(w).startswith("FIT_PASS")]
            fit += [item["V_RESULT"] for item in summary[1:] if str(item["V_RESULT"]).startswith("FIT_PASS")]
            if fit:
                text = ("The result is FIT_PASS, not PASS: the survey accuracy of the check points "
                        "(RMSEH2 / RMSEV2, ASPRS Ed. 2 7.12.2) was not given, so RMSEH / RMSEV only "
                        "cover the fit to the check points. Give 'Check Point Horizontal / Vertical "
                        "Accuracy' to get a complete result; no conformance sentence is written.")
                collector.warning(text)
                report_notes.append(text)
            self_h, self_v = self_comparison(top, opts)
            if self_h:
                text = ("Every horizontal residual is {0}: the data set was probably tested "
                        "against itself or a copy of the check points. No conformance sentence is "
                        "written.".format(self_comparison_text(top, opts, "horizontal")))
                collector.warning(text)
                report_notes.append(text)
            if self_v:
                text = ("Every vertical residual is {0}: check that the elevations do not come from the "
                        "same source. No vertical conformance sentence is written.".format(
                            self_comparison_text(top, opts, "vertical")))
                collector.warning(text)
                report_notes.append(text)
        if not opts["well_defined"] and summary and summary[0]["N_PAIRS"]:
            collector.warning("Points Are Well-Defined was not ticked, so no conformance or 'tested' sentence is "
                              "written. Tick it if the compared points are discrete, well-defined points.")
        for text in result["statements"]:
            collector.info(text)

        # ---- schemas, checked before anything is created -----------------
        res_cols, sum_cols, unp_cols = _CPA_RESIDUAL_COLUMNS, _cpa_summary_columns(), _CPA_UNPAIRED_COLUMNS
        res_rows = _cpa_fit_folder_text(out_res, res_cols, rows, "Residual table", collector)
        sum_rows = _cpa_fit_folder_text(out_sum, sum_cols, summary, "Summary table", collector)
        unp_rows = _cpa_fit_folder_text(out_unp, unp_cols, unpaired, "Unpaired table", collector)
        res_specs = _cpa_specs(res_cols, res_rows)
        sum_specs = _cpa_specs(sum_cols, sum_rows)
        unp_specs = _cpa_specs(unp_cols, unp_rows)
        # FEAT_OID, CHK_OID, SRC_OID: the toolkit's one ObjectID field rule
        res_rows = _cpa_oid_fields(out_res, res_specs, res_rows,
                                   (("FEAT_OID", "feat_oid"), ("CHK_OID", "chk_oid")), collector)
        unp_rows = _cpa_oid_fields(out_unp, unp_specs, unp_rows, (("SRC_OID", "oid"),), collector)
        plan_field_names(res_specs, split_catalog_path(out_res)[0])
        plan_field_names(sum_specs, split_catalog_path(out_sum)[0])
        plan_field_names(unp_specs, split_catalog_path(out_unp)[0])
        zero_lines = 0
        vec_cols = (("PAIR_ID", "pair_id", "LONG"), ("KEY", "key", "TEXT"), ("DX", "dx", "DOUBLE"),
                    ("DY", "dy", "DOUBLE"), ("DR", "dr", "DOUBLE"), ("DZ", "dz", "DOUBLE"),
                    ("AZIMUTH", "azimuth", "DOUBLE"), ("FLAGS", "flags", "TEXT"))
        dis_cols = (("PAIR_ID", "pair_id", "LONG"), ("KEY", "key", "TEXT"), ("DR", "dr", "DOUBLE"),
                    ("EXAGG", "exagg", "DOUBLE"), ("DISPLAY_ONLY", "display_only", "TEXT"))
        true_lines, zero_lines = displacement_lines(rows, 1.0)
        shown_lines, _zero = displacement_lines(rows, exaggeration)
        vec_rows = [dict(r) for r, _g in true_lines]
        dis_rows = []
        for r, _g in shown_lines:
            d = dict(r)
            d["exagg"], d["display_only"] = exaggeration, "YES"
            dis_rows.append(d)
        vec_rows = _cpa_fit_folder_text(out_vec, vec_cols, vec_rows, "Displacement lines", collector)
        dis_rows = _cpa_fit_folder_text(out_dis, dis_cols, dis_rows, "Display lines", collector)
        vec_specs = dis_specs = None
        if out_vec:
            vec_specs = _cpa_specs(vec_cols, vec_rows)
            plan_field_names(vec_specs, split_catalog_path(out_vec)[0])
        if out_dis:
            dis_specs = _cpa_specs(dis_cols, dis_rows)
            plan_field_names(dis_specs, split_catalog_path(out_dis)[0])
            if exaggeration == 1.0 and rows:
                collector.warning("The display exaggeration is 1, so the display lines equal the true "
                                  "displacement lines.")
        if (out_dis or plot) and rows:
            collector.info("Exaggeration of the display lines and the plot arrows: x{0:g} ({1}). They are for "
                           "display only; the residual and displacement tables hold the true values.".format(
                               exaggeration, "automatic: median error at most about 3 % of the extent of the check "
                                             "points, no error above 15 % of it" if exagg_auto else "as given"))

        # ---- write ------------------------------------------------------
        progress.label("Writing the residual table")
        sr_object = checks["sr_object"]
        wkid = checks["sr"]["wkid"]
        table, names = create_table(out_res, res_specs, inputs=inputs)
        nulls = set()
        insert_rows(table, [names[n] for n, _k, _t in res_cols], _cpa_table_rows(res_cols, res_rows), null_fields=nulls)
        note = folder_null_number_warning(table, res_specs, names, nulls, note=_CPA_NULL_NOTE)
        if note:
            collector.warning(note)
        collector.info("Residual table written to {0} ({1} row(s)).".format(table, len(rows)))

        progress.label("Writing the summary table")
        table, names = create_table(out_sum, sum_specs, inputs=inputs)
        nulls = set()
        insert_rows(table, [names[n] for n, _k, _t in sum_cols], _cpa_table_rows(sum_cols, sum_rows), null_fields=nulls)
        note = folder_null_number_warning(table, sum_specs, names, nulls, note=_CPA_NULL_NOTE)
        if note:
            collector.warning(note)
        collector.info("Summary table written to {0}.".format(table))

        progress.label("Writing the unpaired table")
        table, names = create_table(out_unp, unp_specs, inputs=inputs)
        nulls = set()
        insert_rows(table, [names[n] for n, _k, _t in unp_cols], _cpa_table_rows(unp_cols, unp_rows), null_fields=nulls)
        note = folder_null_number_warning(table, unp_specs, names, nulls, note=_CPA_NULL_NOTE)
        if note:
            collector.warning(note)
        collector.info("Unpaired table written to {0} ({1} row(s)).".format(table, len(unpaired)))

        for out, specs, cols, lines, label in ((out_vec, vec_specs, vec_cols, true_lines, "Displacement lines"),
                                               (out_dis, dis_specs, dis_cols, shown_lines, "Display lines")):
            if not out:
                continue
            progress.label("Writing " + label.lower())
            fc, names = create_feature_class(out, GEOM_POLYLINE, sr_object, specs, inputs=inputs)
            nulls = set()
            keyed = dis_rows if specs is dis_specs else vec_rows
            insert_rows(fc, [names[n] for n, _k, _t in cols],
                        [(geom, list(values)) for (_r, geom), values in
                         zip(lines, _cpa_table_rows(cols, keyed))],
                        kind=GEOM_POLYLINE, wkid=wkid, null_fields=nulls)
            note = folder_null_number_warning(fc, specs, names, nulls, note=_CPA_NULL_NOTE)
            if note:
                collector.warning(note)
            collector.info("{0} written to {1} ({2} line(s)).".format(label, fc, len(lines)))
        if (out_vec or out_dis) and zero_lines:
            collector.info("{0} pair(s) have no displacement (DR = 0) and have no line.".format(zero_lines))
        progress.close()

        if plot:
            if not rows:
                collector.warning("The plot was not written: there are no pairs.")
            else:
                done, why = render_plot(plot, rows, summary[0], crs["unit"], exaggeration,
                                        opts["h_class_cm"], mpu)
                if done:
                    collector.info("Plot written to {0}.".format(plot))
                    drs = [r["dr"] for r in rows]
                    if plot_error_range(drs, mpu)[2]:
                        collector.info("Plot: {0}. The horizontal errors spread over less than {1:g} cm, so the "
                                       "colour scale and the histogram are not stretched to that spread (a "
                                       "constant shift is drawn in one colour).".format(
                                           flat_plot_text(drs, crs["unit"], mpu), PLOT_MIN_SPAN_M * 100.0))
                else:
                    collector.warning("The plot was not written: {0}.".format(why))

        notes = [info] + ([warning] if warning else []) + report_notes
        method_text = "{0}{1}".format(method, "" if tolerance is None else
                                      " (search tolerance {0:g} m)".format(tolerance * mpu))
        summary_rows = [("Features", feats["catalog_path"]), ("Check points", checks["catalog_path"])]
        summary_rows += summary_report_rows(summary, counts, crs, opts, method_text, result["statements"], notes)
        detail = _cpa_table_rows(res_cols, rows)
        book = {"summary": summary, "counts": counts, "crs": crs, "opts": opts, "statements": result["statements"],
                "notes": notes + (["Display exaggeration x{0:g} ({1}).".format(
                    exaggeration, "automatic" if exagg_auto else "as given")] if (out_dis or plot) and rows else []),
                "method_text": method_text, "features_path": feats["catalog_path"],
                "checks_path": checks["catalog_path"], "detail_header": [n for n, _k, _t in res_cols],
                "detail_rows": detail, "unpaired_header": [n for n, _k, _t in unp_cols],
                "unpaired_rows": _cpa_table_rows(unp_cols, unpaired), "tool_version": __version__}
        for written in write_report(report, summary_rows, [n for n, _k, _t in res_cols], detail,
                                    xlsx_builder=lambda openpyxl: build_workbook(openpyxl, book)):
            collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "pair_count", str(counts["pairs"]))
        flush_messages(collector)


# ==========================================================================
# quality/tile_edge_tool.py
# ==========================================================================
# Tile Edge Match Check: the ArcGIS Pro tool (adapter).

_TE_LAYER_KINDS = ("polyline", "polygon", "point", "multipoint")
_TE_SKIP_FIELD_TYPES = ("Geometry", "Blob", "Raster", "XML", "OID", "GlobalID", "Guid")
_TE_REPORT_HEADER = ["RULE", "LAYER", "TILE_A", "TILE_B", "OFFSET_M", "FIELDS", "OID_A", "OID_B",
                     "X", "Y", "DETAIL"]


# Appended to a text value cut to fit a dBASE/shapefile text field (ASCII; the cut leaves room).
_TE_CUT_MARK = " ...[cut]"


def _te_text_column(values, out_path, minimum):
    """``(stored values, width, number cut)`` for one TEXT column of an output (DBASE-AUDIT).
    The width is counted in the unit of the output's workspace, never in characters:

    * folder (dBASE/shapefile): UTF-8 bytes as Pro writes them (an Arabic letter takes 2, a
      character above U+FFFF 6, ``arcio._arcio_dbf_bytes``). A value over 254 bytes is cut at a
      character boundary and ends with ``_TE_CUT_MARK`` (``arcio.cut_utf8_bytes``), so the run
      never stops on a long tile ID, layer name or DETAIL, and Pro never cuts bytes silently;
    * geodatabase / GeoPackage: UTF-16 code units (an emoji counts 2, ``arcio._arcio_utf16_units``;
      a width in characters gave "Field length exceeded" for an emoji tile ID).

    The values go with the width in the field spec, so ``common.arcio`` sizes the field from
    them as well."""
    folder = is_folder_workspace(split_catalog_path(out_path)[0])
    counter = [0]
    if folder:
        stored = [cut_utf8_bytes(v, True, counter, _TE_CUT_MARK) for v in values]
        size = _arcio_dbf_bytes
    else:
        stored = list(values)
        size = _arcio_utf16_units
    width = max([int(minimum)] + [size(v) for v in stored if isinstance(v, str)])
    if folder:
        width = min(width, SHAPEFILE_MAX_TEXT)
    return stored, width, counter[0]


def _te_cut_warnings(collector, out_path, cuts):
    """One warning per field whose values were cut for a folder output."""
    for name, count in cuts:
        if count:
            collector.warning(
                "{0} value(s) of {1} in {2} were longer than the {3} bytes a shapefile/dBASE "
                "text field holds (UTF-8: an Arabic letter takes 2, an emoji 6); they were cut "
                "at a character boundary and end with '{4}'. The report keeps the full text; "
                "write the output to a file geodatabase to keep it in the table.".format(
                    count, name, out_path, SHAPEFILE_MAX_TEXT, _TE_CUT_MARK.strip()))


def _te_resolution_m(sr, info):
    """XY resolution of a coordinate system in metres (``sr.XYResolution``, taken to be in
    the units of the system), or ``None`` when it is not available. A geographic system's
    resolution is in degrees and is converted at 111,320 m per degree (an upper bound)."""
    try:
        res = float(sr.XYResolution)
    except Exception:
        return None
    if not res > 0 or res != res or res == float("inf"):
        return None
    if (info or {}).get("type") == "Geographic":
        return res * 111320.0
    mpu = (info or {}).get("meters_per_unit")
    return res * float(mpu) if mpu else None


class TileEdgeConsistencyChecker(object):
    """Finds gaps, offsets and attribute mismatches along the shared edges of a tile index."""

    DOC = {
        "summary": "Checks the seams of tiled data. Give a tile or sheet index (polygons) and "
                   "one or more feature layers: the tool finds the edges the tiles share and "
                   "reports, as one error point each, line ends that stop at an edge with no "
                   "counterpart on the neighbouring tile (DANGLING_END), line ends on the two "
                   "sides that do not meet (END_OFFSET, with the measured distance), lines "
                   "that run past the edge instead of stopping at it (OVERSHOOT), paired "
                   "features whose chosen attributes differ (ATTRIBUTE_MISMATCH), polygon "
                   "halves with no partner, halves that do not meet at the edge or pieces "
                   "cut into slivers (POLYGON_UNMATCHED, POLYGON_GAP, POLYGON_SLIVER), points stored twice on both sides (POINT_DUPLICATE), "
                   "features that cross an edge without being cut (EDGE_CROSSING, optional) "
                   "and overlapping tiles (TILE_OVERLAP). A second table has one row per "
                   "shared edge with its counts and a status, so the seams can be mapped. "
                   "Read-only. Designed for a Basic licence: it calls no Advanced or "
                   "extension tool.",
        "usage": "Quick start. Give the tile index (polygons) and one line layer that holds "
                 "the lines of all tiles (merge per-tile classes first, or tick Treat Line "
                 "Layers as One Dataset); run with the defaults; symbolise Output Error "
                 "Points by RULE and Output Edge Lines by STATUS; read the run messages; "
                 "untick Skip Line Ends That Touch Another Line to see junction ends.\n\n"
                 "Prepare the data. The tool pairs the ends of lines that were cut at a tile "
                 "edge, so the lines of all tiles must be in one layer. If the data comes as "
                 "one feature class per tile, merge the classes first (Merge) or tick Treat "
                 "Line Layers as One Dataset; if you give one layer per tile without that "
                 "option, every layer is checked on its own and every road that crosses a "
                 "seam is reported as a dangling end on both sides. A line layer listed twice "
                 "with that option is checked once (the repeat is left out). The run says so in a "
                 "warning when unpaired ends of one layer coincide with unpaired ends of "
                 "another layer across a tile edge, and when many unpaired ends sit exactly "
                 "on tile boundaries.\n\n"
                 "Tile index. Any polygon layer: a regular grid or an irregular sheet index. "
                 "Two tiles share an edge where parts of their boundaries run along each other "
                 "(within the Tile Adjacency Tolerance) for a length above that tolerance, so "
                 "T-junctions of an irregular index work and tiles that only touch at a corner "
                 "have no edge. Tiles are found from their boundaries alone. Tiles that overlap "
                 "are reported as TILE_OVERLAP and the run goes on; the stretches where their "
                 "boundaries run along each other with the tiles on opposite sides are still "
                 "checked as edges. The Tile ID Field is used to name tiles in the outputs (the "
                 "ObjectID when empty). Where two boundaries run close together but do not "
                 "form a shared edge (a gap between sheets, or a curved boundary drawn with "
                 "different vertices on the two tiles that differ by more than the adjacency "
                 "tolerance) nothing is checked along that stretch; the tool counts such tile "
                 "pairs and warns, naming the largest.\n\n"
                 "Line ends. The end points of every line part (closed parts have none) are "
                 "assigned to the tile that contains them. Coordinates are stored on a grid "
                 "(the XY resolution, 0.0001 m in many geodatabases), so the two ends of a "
                 "road cut at a tile edge lie a few micrometres on either side of a boundary "
                 "that is not on the grid. An end within the snap distance of a tile "
                 "boundary is therefore on it, and is assigned to the tile the line comes "
                 "from (the first point back along the line that is farther from every "
                 "boundary than the snap distance). The snap distance is the Tile Adjacency "
                 "Tolerance, and the adjacency, the Match Tolerance and the Edge Distance are "
                 "never taken smaller than twice the XY resolution of the inputs (read from "
                 "their coordinate systems) or, for the Edge Distance, the snap distance. A "
                 "line that stays within the snap distance of a boundary along its whole "
                 "length is not assigned. An end within Edge Distance of a shared edge of "
                 "its tile must have a counterpart: ends of the same layer in different "
                 "touching tiles are paired one to one, nearest first, when they are within "
                 "the Search Distance. A pair within the Match Tolerance is consistent; a "
                 "pair farther apart is END_OFFSET with its distance (OFFSET_M); an edge end "
                 "with no partner is DANGLING_END. When its nearest end on the other side, within "
                 "the Search Distance, was already paired with another end (pairs are made "
                 "nearest first; two ends competing for one), the DANGLING_END names that end in OID_B with its distance in OFFSET_M "
                 "and says which end it is paired with. A line end that is a real dead end close to "
                 "a tile edge is reported too; raise or lower Edge Distance to suit the data. "
                 "A line end that touches another line of the layer (a vertex or a segment "
                 "within the Match Tolerance, on the same tile as the end; the cut piece on "
                 "the other side of the seam does not count) is a junction: it is not a "
                 "dangling end, and it is not paired as an offset against an end farther "
                 "away than the Match Tolerance, so two junction ends on the two sides of "
                 "an edge that are 3 m apart are not reported (the run warns how many such "
                 "pairs it left out; pairs whose two nodes are already joined across the edge "
                 "by a correctly cut line are not counted, but a connection through several "
                 "lines is not followed, so the count is a hint to look, and with the filter "
                 "off such connected nodes do show as END_OFFSET). A free edge end whose "
                 "nearest end on the other side is such a junction end is DANGLING_END with "
                 "that end in OID_B and their distance in OFFSET_M (DETAIL: it touches another "
                 "line there (a junction), so the two were not paired), and that place is not "
                 "counted in the warning. Untick Skip Line Ends That Touch Another "
                 "Line to report every unpaired edge end as before. The filter applies to "
                 "every line check, ATTRIBUTE_MISMATCH included, so a run with fewer checks "
                 "pairs the same ends as the default run. A missing road whose "
                 "end would sit exactly on a junction on the seam is therefore not found, "
                 "and a free dead end can still pair with another dead end across the "
                 "seam within the Search Distance (END_OFFSET), so keep the Search Distance "
                 "below the spacing of the lines. "
                 "A line that comes from the neighbouring tile, passes the edge and ends "
                 "inside this tile no further beyond the edge than the Edge Distance, measured "
                 "square to the edge (and more than the snap distance), is an overshoot: its "
                 "end is also tried as an end of "
                 "the tile the line comes from. When it pairs with an end on the edge and the "
                 "two are farther apart than the Match Tolerance the finding is OVERSHOOT "
                 "(OFFSET_M is how far the end passes the edge, square to the edge whatever "
                 "the angle of the line; the END_OFFSET check gives "
                 "both END_OFFSET and OVERSHOOT), not two dangling ends. A deeper overshoot is "
                 "an uncut line: use EDGE_CROSSING. A line that passes the corner shared by "
                 "three or four tiles and stops past it in a tile that touches the tile it "
                 "comes from only at that corner is an overshoot from that diagonal tile "
                 "(DETAIL: it passes the corner it shares with that tile; OFFSET_M is the "
                 "distance from the end to the nearest edge of its tile at the corner). "
                 "Counterparts are looked for in the tiles that touch the end, so a line that "
                 "is cut exactly at the corner shared by four tiles is paired with the piece "
                 "in the diagonal tile.\n\n"
                 "Attributes. List field names or aliases in Fields to Compare; each layer "
                 "that has the field is compared on it for every pair of line ends, point "
                 "duplicates and polygon halves. With Treat Line Layers as One Dataset, line "
                 "ends of two layers are compared on a listed field when both layers have it, "
                 "also when they store it under different names (CLASS in one layer, Class or a "
                 "field with the alias CLASS in the other); FIELDS then shows both names "
                 "(CLASS/Class), and a warning names the line layers without the field. Text is put in canonical Unicode form, "
                 "invisible marks (bidirectional marks, zero-width space) are dropped, it is "
                 "trimmed and compared ignoring case; Arabic presentation forms (the lam-alef "
                 "ligature and the like) equal the letters they stand for; other variants "
                 "(Arabic and Persian yeh or kaf, alef forms, diacritics, Arabic-Indic "
                 "digits against Latin digits) are different "
                 "values; empty text equals null; a date without a time (Date Only field) "
                 "equals the same day at exactly midnight. Integers must "
                 "be the same integer, whole-number floats the same number, other floats "
                 "equal within a relative 1e-9. The mismatching fields are in FIELDS and the "
                 "values in DETAIL; when two values print the same but are stored as "
                 "different types (integer 1 and text '1' in combined layers), DETAIL names "
                 "the types: CLASS: 1 (integer) / '1' (text). Values longer than 40 "
                 "characters are shortened with '...'; when two long values would then look "
                 "the same, both are shown from just before the first character where they "
                 "differ (...lane number 0001 north / ...lane number 0001 south).\n\n"
                 "Polygons. A polygon piece is a polygon whose boundary runs along a shared "
                 "edge (within Edge Distance). Pieces on the two sides that overlap along the "
                 "edge are halves of one cut feature and are compared. Where their facing "
                 "boundaries are farther apart than the Match Tolerance (a gap between the "
                 "halves, or one half passing the edge into the other tile) the pair is "
                 "POLYGON_GAP; OFFSET_M is the largest distance measured across the edge "
                 "(steps and rectangular notches in the boundaries included) and "
                 "DETAIL says gap or overlap. A multipart polygon with one part on each side, "
                 "the parts meeting at the edge, counts as two matched halves. Only the parts of a "
                 "boundary within the Edge Distance count (a boundary that drifts away from the "
                 "edge counts up to where it leaves that band, whatever its vertices); where a "
                 "half is farther away, the other half is POLYGON_UNMATCHED. A piece belongs to "
                 "the tile on whose side it mostly lies, so a thin strip along the seam is never "
                 "paired with a polygon of its own tile, and slivers thinner than a millimetre "
                 "are still found. A "
                 "piece with a stretch of edge where no polygon of the layer continues is "
                 "POLYGON_UNMATCHED; a piece smaller than the Sliver Area is POLYGON_SLIVER "
                 "(0 = off). A polygon that ends at the edge of the data by design is reported "
                 "as POLYGON_UNMATCHED too.\n\n"
                 "Points. Two points of one layer in different touching tiles within the Match "
                 "Tolerance are POINT_DUPLICATE. A point within the snap distance of a tile "
                 "boundary is on it and belongs to every tile whose boundary it is on; it is "
                 "paired with points of the neighbouring tile and with other points on the "
                 "same boundary. Every point on a tile boundary, paired or not, is counted "
                 "in an information message. "
                 "Points are paired one to one, nearest first; a copy left over (a point "
                 "stored in three tiles at a corner) is reported with its nearest copy, so "
                 "every copy is named in a row.\n\n"
                 "Crossings. N_CROSSING of the edge table always counts the lines and "
                 "polygons that pass from one side of an edge to the other inside the edge "
                 "(a feature through the corner of four tiles counts on each edge that meets "
                 "the corner); add EDGE_CROSSING to Checks to get an error point for each.\n\n"
                 "Error points. TILE_A and TILE_B are the two tiles of the edge. For "
                 "END_OFFSET, POINT_DUPLICATE, ATTRIBUTE_MISMATCH, EDGE_CROSSING and "
                 "TILE_OVERLAP, TILE_A is the tile that comes first in the tile layer. For "
                 "POLYGON_GAP, TILE_A is the tile that comes first and OID_A its half. For "
                 "OVERSHOOT, TILE_A is the tile the overshooting line comes from (OID_A) and "
                 "TILE_B the tile it runs into (OID_B is the partner). For "
                 "DANGLING_END, POLYGON_UNMATCHED and POLYGON_SLIVER, TILE_A is the tile the "
                 "feature (OID_A) is in and TILE_B the tile across the edge. OID_A and OID_B "
                 "are feature ObjectIDs (OID_B is empty when there is no partner; for "
                 "DANGLING_END it is the nearest junction end on the other side when there "
                 "is one, or the nearest end on the other side that was paired with another "
                 "end); for "
                 "TILE_OVERLAP they are the ObjectIDs of the two tiles.\n\n"
                 "Edge table. One row per shared edge (and per pair of overlapping tiles): "
                 "TILE_A, TILE_B (TILE_A comes first in the tile layer), EDGE_LEN_M, "
                 "N_ENDS (line ends within Edge Distance of the edge, counted on the "
                 "nearest edge of their tile), N_CROSSING, N_MATCHED (end pairs within the "
                 "tolerance and polygon halves), N_OFFSET (END_OFFSET and OVERSHOOT rows), "
                 "N_DANGLING, N_ATTR, N_OTHER "
                 "(unmatched, gap or sliver polygons, duplicate points) and STATUS: OK, ISSUES, "
                 "NO_DATA (nothing reaches the edge) or TILES_OVERLAP. A pair of ends that "
                 "meets at a corner but not on an edge is counted on the nearest edge. The "
                 "optional Output Edge Lines has the same fields on the edge geometry, for a "
                 "map coloured by STATUS.\n\n"
                 "Size and the Search Distance. The work grows with the number of line ends "
                 "within the Edge Distance plus the Search Distance of a seam. A Search "
                 "Distance or Edge Distance near the tile size makes almost every end a "
                 "candidate: 1,903 road pieces on 3 x 3 tiles of 1 km took 0.2 to 0.7 s with "
                 "100 or 250 m, 1.6 s with 400 m, and about 30 to 47 s with 1,000 m before "
                 "the bound was added. The tool therefore stops when the Search Distance or "
                 "the Edge Distance is more than a quarter of the typical (median) tile size, "
                 "and warns above a tenth. Timings are of the checking code alone on the "
                 "development machine (no cursors, single run, order of magnitude): 176,507 "
                 "pieces on 10 x 10 tiles of 2 km took about 13 s without and 18 s with the "
                 "junction filter, at about 500 MB of memory.\n\n"
                 "Units. All distances are in metres. The tile index must be in a projected "
                 "coordinate system; geographic (degree) tile indexes and tile indexes with an "
                 "unknown coordinate system are refused, because a tolerance in metres cannot "
                 "be applied to degrees. Feature layers in another coordinate system are "
                 "projected into the tile index system as they are read (a datum difference "
                 "gives a warning); a layer with an unknown system is refused. Web Mercator "
                 "distorts distances and gives a warning. Z and M values are ignored and true "
                 "curves are densified.\n\n"
                 "Selections and definition queries on the input layers are honoured. The "
                 "inputs are never edited: an output or report equal to an input is refused. "
                 "If an arcpy error stops the run while the outputs are written, the outputs "
                 "this run created are deleted.\n\n"
                 "Built-in alternatives: Generate Edgematch Links and Edgematch Features "
                 "(Editing toolbox; the ArcGIS Pro 3.3 tool pages show Basic: No, Standard: "
                 "No, Advanced: Yes). Generate Edgematch Links takes line features only "
                 "(Source Features, Adjacent Features, a Search Distance above zero) and writes "
                 "link lines between matching but disconnected lines, with a confidence value "
                 "(EM_CONF); its optional Match Fields (pairs of source and adjacent fields) "
                 "help pick the right match among candidates. Edgematch Features then reshapes "
                 "lines using those links and edits its input. Those pages do not mention a "
                 "tile index, polygons, points or counts per edge. This tool edits nothing and "
                 "runs on Basic. Other Esri products (Production Mapping, Data Reviewer) may "
                 "offer related checks; they were not compared here.",
        "params": {
            "in_tiles": "Polygon layer with the tiles, map sheets or work units.",
            "tile_id_field": "Optional field that names the tiles in the outputs. Spaces "
                             "around a value are removed; an empty or blank value gives "
                             "'OID n' ('OID n (no tile ID)' when another tile's ID is the text 'OID n'). A "
                             "warning is given when two tiles have the same ID.",
            "in_features": "Line, polygon or point layers to check along the tile edges.",
            "compare_fields": "Optional field names (or aliases) compared across an edge for "
                              "paired features. A layer without the field is not compared on it. "
                              "Combined line layers are compared on a listed field even when "
                              "each stores it under another name or alias.",
            "checks": "Checks to run: DANGLING_END, END_OFFSET (gives END_OFFSET and OVERSHOOT), "
                      "ATTRIBUTE_MISMATCH, "
                      "POLYGON_PIECE (gives POLYGON_UNMATCHED, POLYGON_GAP and POLYGON_SLIVER), "
                      "POINT_DUPLICATE, EDGE_CROSSING (off by default).",
            "tolerance_m": "Ends (and points) closer than this many metres count as meeting "
                           "(never less than twice the XY resolution of the inputs; a warning "
                           "says so when the value is raised, and when the Search Distance is "
                           "raised with it).",
            "search_m": "Farthest distance, in metres, at which a counterpart on the other "
                        "side is looked for. Must be at least the Match Tolerance.",
            "edge_m": "A line end or polygon boundary within this many metres of a shared edge "
                      "is at the edge (never less than the snap distance). Two polygon halves "
                      "that are both at the edge but farther apart than the Match Tolerance "
                      "are POLYGON_GAP.",
            "adjacency_m": "Tile boundaries closer than this many metres are the same edge. "
                           "It is also the snap distance: a line end or point this close to a "
                           "tile boundary is on it (never less than twice the XY resolution of "
                           "the inputs).",
            "sliver_area_m2": "Polygon pieces at an edge smaller than this many square metres "
                              "are slivers. 0 = off.",
            "skip_connected": "Checked (default): a line end that touches another line of the "
                              "layer within the Match Tolerance is a junction, not a dangling "
                              "end, and is not paired with an end farther away than the Match "
                              "Tolerance. Two junction ends on the two sides of an edge that do "
                              "not meet (3 m apart, say) are therefore not reported; the run "
                              "counts such pairs in a warning. This applies to every line check "
                              "(DANGLING_END, END_OFFSET and ATTRIBUTE_MISMATCH, also when "
                              "ATTRIBUTE_MISMATCH is the only one), so fewer checks never pair "
                              "other ends. Unchecked: every edge end without a partner is "
                              "reported.",
            "combine_layers": "Checked: all line layers are one dataset, so a line end of one "
                              "layer is paired with a line end of another (for data delivered "
                              "as one layer per tile). Unchecked (default): every layer is "
                              "checked on its own. Merging the layers first has the same effect.",
            "out_errors": "Output point feature class: RULE, LAYER, TILE_A, TILE_B, OFFSET_M, "
                          "FIELDS, OID_A, OID_B, DETAIL.",
            "out_summary": "Output table with one row per shared edge: TILE_A, TILE_B, "
                           "EDGE_LEN_M, N_ENDS, N_CROSSING, N_MATCHED, N_OFFSET, "
                           "N_DANGLING, N_ATTR, N_OTHER, STATUS.",
            "out_edges": "Optional line feature class with the shared edges and the fields of "
                         "the edge table.",
            "out_report": "Optional Excel (.xlsx) or CSV report with Summary and Detail sheets.",
            "error_count": "Number of error points written (derived).",
        },
        "tags": ["tile", "sheet", "edge matching", "seam", "quality", "basic"],
    }

    def __init__(self):
        self.label = "Tile Edge Match Check"
        self.description = ("Finds gaps, offsets and attribute mismatches along the shared edges "
                            "of a tile or sheet index, with an error layer and an edge table "
                            "(v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_tiles", "Tile Index", "GPFeatureLayer", value_list=["Polygon"]),
            make_param("tile_id_field", "Tile ID Field", "Field", required=False,
                       depends_on="in_tiles"),
            make_param("in_features", "Features to Check", "GPFeatureLayer", multi_value=True,
                       value_list=["Polyline", "Polygon", "Point", "Multipoint"]),
            make_param("compare_fields", "Fields to Compare", "GPString", required=False,
                       multi_value=True),
            make_param("checks", "Checks", "GPString", required=False, multi_value=True,
                       value_list=list(TILE_CHECKS), default=list(TILE_DEFAULT_CHECKS)),
            make_param("tolerance_m", "Match Tolerance (m)", "GPDouble", required=False,
                       default=0.5),
            make_param("search_m", "Search Distance (m)", "GPDouble", required=False,
                       default=10.0),
            make_param("edge_m", "Edge Distance (m)", "GPDouble", required=False, default=1.0),
            make_param("adjacency_m", "Tile Adjacency Tolerance (m)", "GPDouble", required=False,
                       default=0.01),
            make_param("sliver_area_m2", "Sliver Area (m2)", "GPDouble", required=False,
                       default=1.0),
            make_param("skip_connected", "Skip Line Ends That Touch Another Line", "GPBoolean",
                       required=False, default=True),
            make_param("combine_layers", "Treat Line Layers as One Dataset", "GPBoolean",
                       required=False, default=False),
            make_param("out_errors", "Output Error Points", "DEFeatureClass", direction="Output"),
            make_param("out_summary", "Output Edge Table", "DETable", direction="Output"),
            make_param("out_edges", "Output Edge Lines", "DEFeatureClass", direction="Output",
                       required=False),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("error_count", "Error Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        values = {}
        for name in ("tolerance_m", "search_m", "edge_m", "adjacency_m", "sliver_area_m2"):
            value = p[name].value
            if value is not None and float(value) < 0:
                p[name].setErrorMessage("The value must be zero or more.")
            values[name] = None if value is None else float(value)
        tol, search = values["tolerance_m"], values["search_m"]
        if tol is not None and search is not None and search < tol:
            p["search_m"].setErrorMessage("The Search Distance must be at least the Match "
                                          "Tolerance.")
        checks = [c.upper() for c in param_list(p["checks"])]
        if "ATTRIBUTE_MISMATCH" in checks and not param_list(p["compare_fields"]):
            p["compare_fields"].setWarningMessage("ATTRIBUTE_MISMATCH is checked but no fields "
                                                  "are listed, so it will compare nothing.")
        if param_list(p["compare_fields"]) and checks and "ATTRIBUTE_MISMATCH" not in checks:
            p["compare_fields"].setWarningMessage("ATTRIBUTE_MISMATCH is not checked, so these "
                                                  "fields are ignored.")
        pair = find_duplicate_outputs([param_text(p[n]) for n in ("out_errors", "out_summary",
                                                                   "out_edges")])
        if pair:
            p["out_summary"].setErrorMessage("Two outputs are the same dataset; give every "
                                             "output its own name.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            flush_messages(collector)
            raise

    # ------------------------------------------------------------------

    def _checks(self, p):
        checks = [c.upper() for c in param_list(p["checks"])] or list(TILE_DEFAULT_CHECKS)
        unknown = [c for c in checks if c not in TILE_CHECKS]
        if unknown:
            raise ToolError("Unknown check(s): {0}.".format(", ".join(unknown)),
                            "Choose checks from the list: {0}.".format(", ".join(TILE_CHECKS)))
        return [c for c in TILE_CHECKS if c in checks]

    def _tile_system(self, desc, collector):
        """Measuring facts of the tile index; refuses a geographic or unknown system."""
        info = desc["sr"] or {}
        if sr_is_unknown(info):
            raise ToolError("The tile index has an unknown coordinate system, so a tolerance "
                            "in metres cannot be applied.",
                            "Define its coordinate system (Define Projection tool), or project "
                            "it to a projected metric system, then run the tool again.")
        if info.get("type") == "Geographic":
            raise ToolError("The tile index is in a geographic coordinate system ({0}), whose "
                            "unit is degrees; distances and tolerances in metres cannot be "
                            "applied to it.".format(info.get("name")),
                            "Project the tile index and the features to a projected metric "
                            "coordinate system suited to the area (Project tool), then run the "
                            "tool again.")
        mpu = info.get("meters_per_unit")
        if not mpu or mpu <= 0:
            raise ToolError("The unit of the tile index coordinate system ({0}) is not known."
                            .format(info.get("name")),
                            "Project the tile index to a projected metric system first.")
        if is_web_mercator(info.get("wkid")):
            collector.warning("The tile index is in a Web Mercator system ({0}), which distorts "
                              "distances (about 15 % at 30 degrees latitude, 100 % at 60). "
                              "Tolerances in metres are applied in map units scaled by its "
                              "nominal unit, so they are not true metres; project the data to a "
                              "UTM zone or a national grid first.".format(info.get("name")))
        collector.info("Tile index coordinate system: {0}; one unit = {1:g} m.".format(
            info.get("name"), mpu))
        return info, float(mpu)

    def _read_tiles(self, p, desc, collector):
        wanted = param_text(p["tile_id_field"])
        field = None
        if wanted:
            field, how = match_field(desc["fields"], wanted, label="tile ID field",
                                     exact_name_first=True)
            collector.info(match_message(wanted, field, how))
        names = [field["name"]] if field else []
        rows = read_features(desc["input"], names)
        tiles, seen = [], {}
        empty = []
        texts = []
        for row in rows:
            text = value_to_text(row["attrs"][field["name"]]) if field else None
            texts.append(text.strip() if isinstance(text, str) else text)
        # a tile without an ID is "OID n", unless a real ID is already that text
        taken = set(str(t) for t in texts if t not in (None, ""))
        for row, text in zip(rows, texts):
            label = text if text not in (None, "") else tile_fallback_label(row["oid"], taken)
            seen.setdefault(label, []).append(row["oid"])
            if not row["shape"]:
                empty.append(row["oid"])
            tiles.append({"oid": row["oid"], "label": label, "rings": row["shape"]})
        duplicates = dict((k, v) for k, v in seen.items() if len(v) > 1)
        if duplicates:
            first = sorted(duplicates)[0]
            collector.warning("{0} tile ID value(s) are used by more than one tile (for example "
                              "'{1}': OID {2}); the outputs cannot tell those tiles apart. Use "
                              "a unique Tile ID Field.".format(
                                  len(duplicates), first,
                                  ", ".join(str(o) for o in duplicates[first][:6])))
        if empty:
            collector.warning("{0} tile(s) have no geometry and were ignored: OID {1}.".format(
                len(empty), ", ".join(str(o) for o in empty[:20])))
        return tiles

    def _read_layer(self, path, tile_desc, tile_info, compare_wanted, used_names, collector,
                    resolutions):
        desc = describe_dataset(path)
        kind = kind_from_shape_type(desc["shape_type"])
        if kind not in _TE_LAYER_KINDS:
            raise ToolError("'{0}' is not a line, polygon or point layer.".format(path),
                            "Choose line, polygon or point layers for Features to Check.")
        if same_dataset(desc["catalog_path"], tile_desc["catalog_path"]):
            raise ToolError("'{0}' is the tile index itself.".format(path),
                            "Remove the tile index from Features to Check.")
        info = desc["sr"] or {}
        resolutions.append(_te_resolution_m(desc["sr_object"], info))
        label = desc["name"]
        n = 1
        while label in used_names:
            n += 1
            label = "{0} ({1})".format(desc["name"], n)
        used_names.add(label)
        if sr_is_unknown(info):
            raise ToolError("The layer '{0}' has an unknown coordinate system, so it cannot be "
                            "projected into the tile index system.".format(label),
                            "Define its coordinate system (Define Projection tool) and run the "
                            "tool again.")
        same = (info.get("wkid") and info.get("wkid") == tile_info.get("wkid")) or (
            not info.get("wkid") and not tile_info.get("wkid")
            and info.get("name") == tile_info.get("name"))
        read_sr = None if same else tile_desc["sr_object"]
        if not same:
            collector.info("The layer '{0}' ({1}) is projected into the tile index system as it "
                           "is read.".format(label, info.get("name")))
            warn = datum_mismatch_warning(
                "The layer '{0}'".format(label), info,
                {"wkid": tile_info.get("wkid"), "gcs_wkid": gcs_wkid_of(tile_info)})
            if warn:
                collector.warning(warn)
        compare, compare_keys = [], []
        for wanted in compare_wanted:
            field, how = match_field(desc["fields"], wanted, required=False,
                                     label="field to compare")
            if field is None:
                collector.info("The layer '{0}' has no field '{1}': it is not compared on it."
                               .format(label, wanted))
                continue
            if field["type"] in _TE_SKIP_FIELD_TYPES:
                collector.warning("The field '{0}' of '{1}' has the type {2}, which cannot be "
                                  "compared; it is skipped.".format(field["name"], label,
                                                                    field["type"]))
                continue
            collector.info("{0}: {1}".format(label, match_message(wanted, field, how)))
            if field["name"] not in compare:
                compare.append(field["name"])
            # the listed name is the key: combined line layers that store it under different
            # names (CLASS / Class, or an alias) are still compared on it (round 14 review, R14-1)
            compare_keys.append((normalize_field_name(wanted), field["name"]))
        rows = read_features(desc["input"], compare, sr=read_sr)
        collector.info("{0}: {1} feature(s) read.".format(label, len(rows)))
        return desc, {"name": label, "kind": kind, "rows": rows, "compare": compare,
                      "compare_keys": compare_keys}

    @staticmethod
    def _combined_field_messages(layers, compare_wanted, collector):
        """Round 14 review, R14-1: with Treat Line Layers as One Dataset, line ends of two layers
        are compared on a listed field when both layers have it, under whatever name each stores
        it. Says so when the stored names differ, and warns when only some line layers have it."""
        lines = [l for l in layers if l["kind"] == "polyline"]
        done = set()
        for wanted in compare_wanted:
            key = normalize_field_name(wanted)
            if not key or key in done:
                continue
            done.add(key)
            found = []
            for layer in lines:
                names = [n for k, n in layer.get("compare_keys") or [] if k == key]
                if names:
                    found.append((layer["name"], names[0]))
            missing = [l["name"] for l in lines if l["name"] not in dict(found)]
            if found and missing:
                collector.warning(
                    "With Treat Line Layers as One Dataset, the field '{0}' is compared only where "
                    "both line layers have it ({1}); line ends of {2} are not compared on it."
                    .format(wanted, ", ".join("'{0}'".format(n) for n, _f in found),
                            ", ".join("'{0}'".format(n) for n in missing)))
            if len(set(f for _n, f in found)) > 1:
                collector.info(
                    "The field '{0}' has different names in the combined line layers ({1}); line "
                    "ends of these layers are compared on it, and FIELDS shows both names "
                    "(NAME_A/NAME_B).".format(
                        wanted, ", ".join("{0} in '{1}'".format(f, n) for n, f in found)))

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))
        if report and report["note"]:
            collector.info(report["note"])
        checks = self._checks(p)
        tol_m = param_number(p["tolerance_m"], 0.5)
        search_m = param_number(p["search_m"], 10.0)
        edge_m = param_number(p["edge_m"], 1.0)
        adj_m = param_number(p["adjacency_m"], 0.01)
        sliver_m2 = param_number(p["sliver_area_m2"], 1.0)
        for value in (tol_m, search_m, edge_m, adj_m, sliver_m2):
            if value < 0 or value != value or value == float("inf"):
                raise ToolError("Distances and the sliver area must be zero or more.",
                                "Enter 0 or a positive number.")
        if search_m < tol_m:
            raise ToolError("The Search Distance ({0:g} m) is smaller than the Match Tolerance "
                            "({1:g} m).".format(search_m, tol_m),
                            "Make the Search Distance at least the Match Tolerance.")
        out_errors = param_text(p["out_errors"])
        out_summary = param_text(p["out_summary"])
        out_edges = param_text(p["out_edges"])
        refuse_duplicate_outputs([out_errors, out_summary, out_edges])
        layer_paths = param_list(p["in_features"])
        if not layer_paths:
            raise ToolError("No features to check were given.",
                            "Choose at least one line, polygon or point layer.")
        compare_wanted = param_list(p["compare_fields"])
        skip_connected = param_bool(p["skip_connected"], True)
        combine = param_bool(p["combine_layers"], False)

        tile_desc = describe_dataset(param_text(p["in_tiles"]))
        if kind_from_shape_type(tile_desc["shape_type"]) != GEOM_POLYGON:
            raise ToolError("The tile index must contain polygons.",
                            "Choose a polygon layer for Tile Index.")
        tile_info, mpu = self._tile_system(tile_desc, collector)
        tiles = self._read_tiles(p, tile_desc, collector)
        collector.info("{0} tile(s) read.".format(len(tiles)))
        if not tiles:
            raise ToolError("The tile index has no features.",
                            "Check the layer, its selection and its definition query.")
        self._check_distances(tiles, mpu, search_m, edge_m, collector)

        inputs = [tile_desc["catalog_path"]]
        layers, used = [], set()
        seen_sources = set()
        resolutions = [_te_resolution_m(tile_desc["sr_object"], tile_info)]
        for path in layer_paths:
            desc, core_layer = self._read_layer(path, tile_desc, tile_info, compare_wanted, used,
                                                collector, resolutions)
            key = desc["catalog_path"]
            inputs.append(key)
            if key in seen_sources:
                if combine and core_layer["kind"] == "polyline":
                    # round 11 review, R11-1: two copies of one line layer in one combined dataset
                    # touch each other at every end, so every end was a junction and every line
                    # finding disappeared. The repeat is left out.
                    collector.warning("The line layer '{0}' is listed more than once. With Treat "
                                      "Line Layers as One Dataset the copies would form one "
                                      "dataset in which every line end touches its own copy, "
                                      "which would hide every line finding, so the repeated "
                                      "entry was left out and the layer is checked once.".format(
                                          desc["name"]))
                    continue
                collector.warning("The layer '{0}' is listed more than once; each entry is "
                                  "checked on its own, so its findings appear twice.".format(
                                      core_layer["name"]))
            seen_sources.add(key)
            layers.append(core_layer)
        if "ATTRIBUTE_MISMATCH" in checks and compare_wanted \
                and not any(l["compare"] for l in layers):
            collector.warning("None of the listed fields exists in any layer, so no attributes "
                              "were compared.")
        n_lines = sum(1 for l in layers if l["kind"] == "polyline")
        if combine and n_lines < 2:
            collector.info("Treat Line Layers as One Dataset has no effect: fewer than two different "
                           "line layers were given.")
        elif combine:
            collector.info("The {0} line layers are checked as one dataset: line ends of "
                           "different layers are paired.".format(n_lines))
            if "ATTRIBUTE_MISMATCH" in checks:
                self._combined_field_messages(layers, compare_wanted, collector)
        for out in (out_errors, out_summary, out_edges):
            if out:
                check_output_path(out, inputs)

        known = [r for r in resolutions if r]
        res_m = max(known) if known else 0.0
        if known:
            collector.info("Coordinate resolution of the inputs: {0:g} m (largest of {1} "
                           "read).".format(res_m, len(known)))
        progress = Progress("Checking tile edges", len(layers) + 1)

        def step(text):
            progress.label(text)
            progress.tick()
        try:
            result = tile_edge_check(
                tiles, layers,
                {"tolerance": tol_m / mpu, "search": search_m / mpu, "edge": edge_m / mpu,
                 "adjacency": adj_m / mpu, "sliver_area": sliver_m2 / (mpu * mpu),
                 "checks": checks, "unit_m": mpu, "resolution": res_m / mpu, "progress": step,
                 "skip_connected": skip_connected, "combine_layers": combine})
        finally:
            progress.close()
        errors, edges = result["errors"], result["edges"]
        self._messages(collector, result, tiles, mpu, res_m, skip_connected, tol_m, search_m,
                       checks, adj_m, edge_m)

        created = []
        try:
            self._write_errors(out_errors, tile_desc, tile_info, errors, mpu, inputs, created,
                               collector)
            self._write_edges(out_summary, out_edges, tile_desc, tile_info, edges, mpu, inputs,
                              created, collector)
        except Exception:
            for done in created:
                try:
                    safe_delete(done, inputs)
                except Exception:
                    pass
            raise

        summary = self._report_summary(result, tile_desc, tile_info, mpu, tol_m, search_m,
                                       edge_m, adj_m, sliver_m2, checks, skip_connected, combine)
        detail = [(e["rule"], e["layer"], e["tile_a"], e["tile_b"],
                   None if e["offset"] is None else e["offset"] * mpu, e["fields"], e["oid_a"],
                   e["oid_b"], e["point"][0], e["point"][1], e["detail"]) for e in errors]
        for written in write_report(report, summary, _TE_REPORT_HEADER, detail):
            collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "error_count", str(len(errors)))
        flush_messages(collector)

    def _check_distances(self, tiles, mpu, search_m, edge_m, collector):
        """Refuses a Search or Edge Distance above a quarter of the typical tile size and warns
        above a tenth: nearly every line end would then be an edge end and pairing would compare
        every end with every other one."""
        typical_m = tile_typical_size(tiles) * mpu
        level, limit, share = tile_distance_check(typical_m, search_m, edge_m)
        if level == "refuse":
            raise ToolError(
                "The Search Distance ({0:g} m) or the Edge Distance ({1:g} m) is more than a quarter "
                "of the typical tile size ({2:,.0f} m, the median of the longer sides of the tiles). "
                "Nearly every line end would count as an end at the edge, and the run time grows "
                "with the square of the number of ends.".format(search_m, edge_m, typical_m),
                "Use at most {0:,.0f} m for both; a few metres is usual (the defaults are 10 m "
                "and 1 m).".format(limit))
        if level == "warn":
            collector.warning(
                "The larger of the Search Distance ({0:g} m) and the Edge Distance ({1:g} m) is "
                "{2:.0%} of the typical tile size ({3:,.0f} m). Line ends far from the sheet line "
                "then count as edge ends and the run is slower; a few metres is usual.".format(
                    search_m, edge_m, share, typical_m))

    def _messages(self, collector, result, tiles, mpu, res_m=0.0, skip_connected=True,
                  tol_m=None, search_m=None, checks=None, adj_m=None, edge_m=None):
        errors, edges, stats = result["errors"], result["edges"], result["stats"]
        collector.info("{0} shared edge(s) found between {1} tile(s); {2} pair(s) of tiles "
                       "touch only at a corner.".format(stats["edges"], stats["tiles"],
                                                        stats["corner_only_pairs"]))
        collector.info("Snap distance {0:.4f} m: a line end or point that close to a tile "
                       "boundary is on it{1}.".format(
                           stats["snap"] * mpu,
                           " (twice the coordinate resolution is the smallest value used)"
                           if res_m else ""))
        raised = dict((name, (stats[key] * mpu, given)) for name, key, given in (
            ("Tolerance", "tolerance_used", tol_m), ("Search Distance", "search_used", search_m))
            if given is not None and key in stats and stats[key] * mpu > given + 1e-9)
        if raised:
            # round 14 review, minor note: the Search Distance is raised to equal the raised
            # Tolerance, not to twice the resolution; say each reason
            parts = []
            if "Tolerance" in raised:
                parts.append("Raised to twice the coordinate resolution of the inputs: Tolerance "
                             "{0:g} m used (entered {1:g} m). Gaps up to that size are matched."
                             .format(*raised["Tolerance"]))
            if "Search Distance" in raised:
                parts.append("Search Distance {0:g} m used (entered {1:g} m): raised to equal the "
                             "Tolerance used.".format(*raised["Search Distance"]))
            collector.warning(" ".join(parts))
        for name, key, given, why in (
                ("Tile Adjacency Tolerance", "adjacency_used", adj_m, "twice the coordinate resolution"),
                ("Edge Distance", "edge_used", edge_m, "the snap distance")):
            if given is not None and key in stats and stats[key] * mpu > given + 1e-9:
                collector.info("{0} {1:g} m used (entered {2:g} m): raised to {3}.".format(
                    name, stats[key] * mpu, given, why))
        if stats["tiles"] >= 2 and stats["edges"] == 0 and stats["overlapping_pairs"] == 0:
            collector.warning("No two tiles share an edge, so nothing could be checked. If the "
                              "tiles are meant to touch, raise the Tile Adjacency Tolerance "
                              "(tile boundaries farther apart than it do not form an edge).")
        if stats["unshared"]:
            shown = sorted(stats["unshared"], key=lambda u: -(u["close"] - u["shared"]))[:5]
            collector.warning(
                "{0} pair(s) of tiles have boundaries that run close together for a length "
                "that is not a shared edge, so line ends and features there are not checked "
                "(a gap between sheets, or a curved boundary drawn with different vertices "
                "on the two tiles). Raise the Tile Adjacency Tolerance if they are meant to "
                "touch. Largest: {1}.".format(
                    len(stats["unshared"]),
                    "; ".join("{0} / {1}: {2:.1f} m close, {3:.1f} m shared".format(
                        u["tile_a"], u["tile_b"], u["close"] * mpu, u["shared"] * mpu)
                        for u in shown)))
        if stats["overlapping_pairs"]:
            collector.warning("{0} pair(s) of tiles overlap (TILE_OVERLAP). Their shared "
                              "stretches, where the boundaries run along each other with the "
                              "tiles on opposite sides, are still checked.".format(
                                  stats["overlapping_pairs"]))
        if stats["empty_tiles"]:
            collector.info("{0} tile(s) with no usable geometry were left out.".format(
                len(stats["empty_tiles"])))
        collector.info("{0} line end(s) read, {1} within Edge Distance of a shared edge."
                       .format(stats["ends"], stats["ends_near_edges"]))
        crossings = sum(e["crossing"] for e in edges)
        if crossings and not any(e["rule"] == "EDGE_CROSSING" for e in errors):
            collector.info("{0} crossing(s) of a shared edge by a line or polygon that is not cut "
                           "there (N_CROSSING). EDGE_CROSSING is not checked, so they do not change "
                           "STATUS: an edge whose only finding is such a crossing stays OK. Add "
                           "EDGE_CROSSING to Checks if the data should be cut at the tile edges."
                           .format(crossings))
        if skip_connected and stats["ends_connected"]:
            collector.info("{0} line end(s) within Edge Distance of a shared edge touch another "
                           "line of their layer (a junction): they are not dangling ends and are "
                           "not paired as offsets.".format(stats["ends_connected"]))
        if skip_connected and stats["junction_pairs_not_reported"]:
            collector.warning(
                "{0} pair(s) of line ends on the two sides of a tile edge are farther apart than "
                "the Match Tolerance but within the Search Distance, and were not reported because "
                "at least one end of each pair touches another line (a junction). If the roads "
                "should have met there, the gap is hidden by the junction. Pairs whose two ends are "
                "already joined across the edge by a correctly cut line are not counted; a connection "
                "through several lines is not followed, so this is a hint to look, not a list of "
                "defects. Uncheck 'Skip Line Ends That Touch Another Line' to {1}; that run "
                "also pairs connected junctions that are not gaps.".format(
                    stats["junction_pairs_not_reported"],
                    "see them as END_OFFSET" if checks is None or "END_OFFSET" in checks else
                    "pair them (they show as END_OFFSET only when END_OFFSET is checked)"))
        if stats["split_layer_pairs"]:
            collector.warning(
                "{0} unpaired line end(s) of one layer coincide with an unpaired line end of "
                "another layer on the other side of a tile edge. This is what data delivered as "
                "one layer per tile looks like: every layer is checked on its own, so the two "
                "halves of every line are reported as dangling ends. Merge the layers first, or "
                "check 'Treat Line Layers as One Dataset'.".format(stats["split_layer_pairs"]))
        elif stats["many_dangling_on_boundary"] or stats["unmatched_edges"]:
            listing = ""
            if stats["unmatched_edges"]:
                listing = " Edges with ends and no matched pair at all: {0}.".format(
                    "; ".join("{0} / {1} ({2} ends)".format(u["tile_a"], u["tile_b"], u["ends"])
                              for u in stats["unmatched_edges"][:5]))
            collector.warning(
                "{0} line end(s) lie exactly on a tile boundary and have no partner on the other "
                "side (of {1} line ends on a tile boundary in all).{2} A line cut at a sheet "
                "line has its partner exactly there, so many of these usually mean that the "
                "neighbouring tile's data is missing, or was given as a separate layer (data "
                "delivered one layer per tile has to be merged first, or checked with 'Treat "
                "Line Layers as One Dataset'); they are not that many broken lines.".format(
                    stats["dangling_on_boundary"], stats["boundary_ends"], listing))
        if stats["points_on_edge"]:
            collector.info("{0} point(s) lie on a tile boundary (within the snap distance); "
                           "they were compared with the points of the neighbouring tile and "
                           "with each other, and are otherwise not checked."
                           .format(stats["points_on_edge"]))
        if stats["null_geometry"]:
            first = stats["null_geometry"][:6]
            collector.warning("{0} feature(s) have no geometry and were ignored (for example {1})."
                              .format(len(stats["null_geometry"]),
                                      ", ".join("{0} OID {1}".format(n, o) for n, o in first)))
        if stats["bad_coordinates"]:
            collector.warning("{0} line part(s), polygon ring(s), point(s) or tile ring(s) have "
                              "a missing or non-finite coordinate (NaN / infinity) and were "
                              "ignored.".format(stats["bad_coordinates"]))
        if stats["zero_length_parts"]:
            collector.warning("{0} line part(s) have zero length and were ignored."
                              .format(stats["zero_length_parts"]))
        for rule in TILE_RULES:
            count = sum(1 for e in errors if e["rule"] == rule)
            if count:
                collector.info("{0}: {1}".format(rule, count))
        if not errors:
            collector.info("No inconsistencies found along {0} edge(s).".format(len(edges)))

    def _write_errors(self, out_errors, tile_desc, tile_info, errors, mpu, inputs, created,
                      collector):
        # DBASE-AUDIT: the five text columns are sized in the output's unit (bytes in
        # a folder, UTF-16 units in a geodatabase) and cut to 254 bytes in a folder.
        text_cols = {}
        cuts = []
        for key, name, minimum in (("layer", "LAYER", 32), ("tile_a", "TILE_A", 16),
                                   ("tile_b", "TILE_B", 16), ("fields", "FIELDS", 20),
                                   ("detail", "DETAIL", 60)):
            stored, width, cut = _te_text_column([e[key] for e in errors], out_errors, minimum)
            text_cols[key] = (stored, width)
            cuts.append((name, cut))
        # TILE_A and TILE_B hold the same labels: one width for both, as before
        both = max(text_cols["tile_a"][1], text_cols["tile_b"][1])

        def text_spec(name, key, width=None):
            return {"name": name, "type": "TEXT", "length": width or text_cols[key][1],
                    "values": text_cols[key][0]}

        # OID_A, OID_B: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``)
        oid_spec = oid_output_field(out_errors, [e["oid_a"] for e in errors] +
                                    [e["oid_b"] for e in errors], collector, label="OID_A and OID_B")
        oid_a, oid_b = dict(oid_spec, name="OID_A"), dict(oid_spec, name="OID_B")
        specs = [{"name": "RULE", "type": "TEXT", "length": 24},
                 text_spec("LAYER", "layer"),
                 text_spec("TILE_A", "tile_a", both),
                 text_spec("TILE_B", "tile_b", both),
                 {"name": "OFFSET_M", "type": "DOUBLE"},
                 text_spec("FIELDS", "fields"),
                 oid_a, oid_b,
                 text_spec("DETAIL", "detail")]
        specs, _renamed = plan_output_fields(out_errors, specs, fixed=len(specs))
        path, fmap = create_feature_class(out_errors, GEOM_POINT, tile_desc["sr_object"], specs,
                                          inputs=inputs)
        created.append(path)
        null_fields = set()
        col = dict((k, v[0]) for k, v in text_cols.items())
        insert_rows(path, [fmap[s["name"]] for s in specs],
                    [(e["point"], (e["rule"], col["layer"][i], col["tile_a"][i], col["tile_b"][i],
                                   None if e["offset"] is None else e["offset"] * mpu,
                                   col["fields"][i], oid_field_value(oid_spec, e["oid_a"]),
                                   oid_field_value(oid_spec, e["oid_b"]), col["detail"][i]))
                     for i, e in enumerate(errors)],
                    kind=GEOM_POINT, wkid=tile_info.get("wkid"), null_fields=null_fields)
        collector.info("{0} error point(s) written to {1}.".format(len(errors), path))
        _te_cut_warnings(collector, path, cuts)
        note = folder_null_number_warning(path, specs, fmap, null_fields,
                                          "The RULE column tells which fields apply to a point.")
        if note:
            collector.info(note)

    def _edge_values(self, e, mpu, tile_a=None, tile_b=None):
        return [e["tile_a"] if tile_a is None else tile_a,
                e["tile_b"] if tile_b is None else tile_b, e["length"] * mpu, e["ends"],
                e["crossing"], e["matched"], e["offset"], e["dangling"], e["attr"], e["other"],
                e["status"]]

    def _edge_specs(self, edges, out_path):
        """``(specs, stored TILE_A, stored TILE_B, cuts)`` for an edge output (``out_path``
        decides the unit of the TILE_A / TILE_B width, see ``_te_text_column``)."""
        a, wa, ca = _te_text_column([e["tile_a"] for e in edges], out_path, 16)
        b, wb, cb = _te_text_column([e["tile_b"] for e in edges], out_path, 16)
        width = max(wa, wb)
        specs = [{"name": "TILE_A", "type": "TEXT", "length": width, "values": a},
                 {"name": "TILE_B", "type": "TEXT", "length": width, "values": b},
                 {"name": "EDGE_LEN_M", "type": "DOUBLE"}, {"name": "N_ENDS", "type": "LONG"},
                 {"name": "N_CROSSING", "type": "LONG"}, {"name": "N_MATCHED", "type": "LONG"},
                 {"name": "N_OFFSET", "type": "LONG"}, {"name": "N_DANGLING", "type": "LONG"},
                 {"name": "N_ATTR", "type": "LONG"}, {"name": "N_OTHER", "type": "LONG"},
                 {"name": "STATUS", "type": "TEXT", "length": 16}]
        return specs, a, b, [("TILE_A", ca), ("TILE_B", cb)]

    def _write_edges(self, out_summary, out_edges, tile_desc, tile_info, edges, mpu, inputs,
                     created, collector):
        specs, ta, tb, cuts = self._edge_specs(edges, out_summary)
        specs, _r = plan_output_fields(out_summary, specs, fixed=11)
        path, fmap = create_table(out_summary, specs, inputs=inputs)
        created.append(path)
        insert_rows(path, [fmap[s["name"]] for s in specs],
                    [self._edge_values(e, mpu, ta[i], tb[i]) for i, e in enumerate(edges)])
        collector.info("{0} edge row(s) written to {1}.".format(len(edges), path))
        _te_cut_warnings(collector, path, cuts)
        if out_edges:
            specs, ta, tb, cuts = self._edge_specs(edges, out_edges)
            specs, _r = plan_output_fields(out_edges, specs, fixed=11)
            path, fmap = create_feature_class(out_edges, GEOM_POLYLINE, tile_desc["sr_object"],
                                              specs, inputs=inputs)
            created.append(path)
            drawn = [(i, e) for i, e in enumerate(edges) if e["paths"]]
            insert_rows(path, [fmap[s["name"]] for s in specs],
                        [(e["paths"], self._edge_values(e, mpu, ta[i], tb[i])) for i, e in drawn],
                        kind=GEOM_POLYLINE, wkid=tile_info.get("wkid"))
            collector.info("{0} edge line(s) written to {1}.".format(len(drawn), path))
            _te_cut_warnings(collector, path, cuts)

    def _report_summary(self, result, tile_desc, tile_info, mpu, tol_m, search_m, edge_m, adj_m,
                        sliver_m2, checks, skip_connected=True, combine=False):
        errors, edges, stats = result["errors"], result["edges"], result["stats"]
        rows = [("Tiles", stats["tiles"]), ("Shared edges", stats["edges"]),
                ("Edges with issues", sum(1 for e in edges if e["status"] in ("ISSUES",
                                                                              "TILES_OVERLAP"))),
                ("Error points", len(errors)), ("Checks", ", ".join(checks)),
                ("Match tolerance (m)", tol_m), ("Search distance (m)", search_m),
                ("Edge distance (m)", edge_m), ("Tile adjacency tolerance (m)", adj_m),
                ("Sliver area (m2)", sliver_m2),
                ("Snap distance (m)", stats["snap"] * mpu),
                ("Skip line ends that touch another line", "yes" if skip_connected else "no"),
                ("Line ends skipped as junctions", stats["ends_connected"]),
                ("Line layers treated as one dataset", "yes" if combine else "no"),
                ("Tile pairs close but not sharing an edge", len(stats["unshared"])),
                ("Coordinate system", "{0} (WKID {1}); one unit = {2:g} m".format(
                    tile_info.get("name"), tile_info.get("wkid"), mpu))]
        for rule in TILE_RULES:
            rows.append(("Rule " + rule, sum(1 for e in errors if e["rule"] == rule)))
        return rows


# ==========================================================================
# quality/topology_lite_tool.py
# ==========================================================================
# Topology Check (Lite): the ArcGIS Pro tool (adapter).

_TLITE_NUMBER_PARAMS = ("tolerance_m", "min_area_m2", "small_area_m2", "max_gap_m2", "sliver_area_m2",
                        "sliver_width_m", "max_regions")
_TLITE_DEFAULT_MAX_REGIONS = 50000
_TLITE_DEFAULT_SMALL_AREA = 0.1
_TLITE_AREA_RULES = (TOPO_RULE_OVERLAP, TOPO_RULE_GAP, TOPO_RULE_SLIVER) + TOPO_OTHER_RULES
_TLITE_REPORT_HEADER = ["RULE", "SEVERITY", "LAYER", "OID_A", "OID_B", "AREA_M2", "LENGTH_M", "WIDTH_M",
                        "PIECES", "X", "Y", "DETAIL"]


def _tlite_resolution_m(sr, info):
    """XY resolution of a coordinate system in metres, or ``None`` when it is not
    available (``sr.XYResolution`` is in the units of the system)."""
    try:
        res = float(sr.XYResolution)
    except Exception:
        return None
    if not res > 0 or res != res or res == float("inf"):
        return None
    mpu = (info or {}).get("meters_per_unit")
    return res * float(mpu) if mpu else None


_TLITE_LARGE_TOLERANCE_FACTOR = 100


def _tlite_large_tolerance_warning(tol_used):
    """Warning text when the tolerance used is more than 100 x the default 0.001 m (that is,
    above 0.1 m), so that a value typed in millimetres instead of metres does not close real
    overlaps and gaps silently; ``None`` otherwise."""
    limit = _TLITE_LARGE_TOLERANCE_FACTOR * TOPO_DEFAULT_TOLERANCE_M
    try:
        tol = float(tol_used)
    except (TypeError, ValueError):
        return None
    if not tol > limit or tol != tol:
        return None
    return ("The tolerance used, {0:g} m, is more than {1:d} times the default ({2:g} m): "
            "boundaries up to about {0:g} m apart are snapped together, so overlaps and gaps up "
            "to about that width are closed and not reported. The tolerance is in metres "
            "(1 mm = 0.001). Keep a large tolerance only if you chose it on "
            "purpose.".format(tol, _TLITE_LARGE_TOLERANCE_FACTOR, TOPO_DEFAULT_TOLERANCE_M))


def _tlite_oid_list(oids, limit=20):
    text = ", ".join(str(o) for o in oids[:limit])
    if len(oids) > limit:
        text += " ... ({0} more)".format(len(oids) - limit)
    return text


def _tlite_ring_length(rings):
    total = 0.0
    for ring in rings or ():
        for k in range(1, len(ring)):
            total += math.hypot(ring[k][0] - ring[k - 1][0], ring[k][1] - ring[k - 1][1])
    return total


class TopologyLite(object):
    """Topology rules for polygons and lines without a geodatabase topology."""

    DOC = {
        "summary": "Checks polygons (and optionally a second polygon layer and lines) against "
                   "topology rules without needing a geodatabase topology, so it works on a "
                   "Basic licence: overlaps inside a layer (one error per pair of features, "
                   "with both ObjectIDs and the overlap area), gaps (voids enclosed by the "
                   "polygons), slivers (polygons under an area or width), and, against a "
                   "second layer, 'must be covered by', 'must not overlap with' and "
                   "'must cover' (gaps against a boundary). For lines: must not self-overlap, "
                   "must not intersect (cross or overlap) and must be inside the polygons. "
                   "Writes an error point layer, optionally an error polygon layer, a "
                   "summary table and a report. Read-only.",
        "usage": "Quick start: choose the Input Polygons, leave Rules at OVERLAP and GAP, "
                 "name an Output Error Points feature class and run; then sort the output by "
                 "SEVERITY and AREA_M2 (or symbolise it on RULE and SEVERITY).\n\n"
                 "Rules. OVERLAP, GAP and SLIVER need only the input polygons. "
                 "NOT_COVERED_BY_OTHER (parts of the input that no polygon of the Other "
                 "Polygons covers), OVERLAPS_OTHER (input and other overlap) and "
                 "OTHER_NOT_COVERED (parts of the other layer, for example a boundary, that no "
                 "input polygon covers) need Other Polygons. LINE_SELF_OVERLAP and "
                 "LINE_INTERSECT need Lines; LINE_OUTSIDE needs Lines and uses the Other "
                 "Polygons when given, else the input polygons; an empty reference (no polygon "
                 "with geometry) covers nothing, so every line is outside, and a warning says "
                 "so. The rules follow the wording "
                 "of the geodatabase topology rules (Must Not Overlap, Must Not Have Gaps, Must "
                 "Be Covered By Feature Class Of, Must Not Overlap With, Must Cover Each Other, "
                 "Must Not Self-Overlap, Must Not Intersect, Must Be Inside), but this tool "
                 "does not create a topology and its errors are not topology errors that can "
                 "be marked as exceptions or fixed with the Fix Topology Error tools.\n\n"
                 "Gaps. A gap is a region that no polygon covers and that is enclosed by "
                 "polygons (or is the hole of one polygon). Empty space at the outside of "
                 "the layer, and space connected to it through a channel wider than the "
                 "tolerance, is not a gap (as for the Must Not Have Gaps rule); use the "
                 "boundary layer and OTHER_NOT_COVERED to find gaps against an outline. "
                 "Esri's Must Not Have Gaps rule writes line errors along the outlines of "
                 "the voids (and, as observed in ArcGIS Pro, one more along the outer outline of the "
                 "whole tiling). This tool writes one polygon error per void and none for "
                 "the perimeter.\n\n"
                 "Severity. Every overlap, gap and uncovered part below Small Error Area "
                 "(default 0.1 m2, a value chosen for real data, not a standard) gets "
                 "SEVERITY = SMALL, all other errors NORMAL. Nothing is dropped; use it to "
                 "sort the table or to symbolise the layer (unique values on SEVERITY, or on "
                 "RULE and SEVERITY). Minimum Error Area drops errors instead.\n\n"
                 "Tolerance and coordinate resolution. All coordinates are first rounded to a "
                 "grid of 0.0001 m (the default XY resolution of a projected system), so "
                 "coordinates that the data store has already snapped to its resolution give "
                 "no false results. Vertices closer than the tolerance are treated as one "
                 "point and a vertex that lies within the tolerance of another polygon's "
                 "edge is made part of that edge, so boundaries that differ only by that much "
                 "match. A region (overlap, gap, uncovered part) whose mean width "
                 "(2 x area / perimeter) is not larger than the tolerance is noise and is "
                 "not reported; the tool counts them in a message. The tolerance actually used "
                 "is the largest of the one entered, twice the grid and twice the XY "
                 "resolution of the inputs. Overlaps and gaps are measured on the geometry "
                 "after this snapping, so areas differ from an exact computation by at most "
                 "the tolerance times the boundary length involved.\n\n"
                 "Geometry. Planar geometry in the coordinate system of the input, which must "
                 "be projected (geographic and unknown systems are refused; Web Mercator "
                 "gives a warning). The other layer and the lines are projected into the "
                 "system of the input as they are read. Z and M are ignored. Features with "
                 "true curves are skipped and listed; null geometries are listed. Rings in "
                 "OGC order (outer counter-clockwise, holes clockwise) are read by nesting, so "
                 "their holes are still checked, and a warning lists those features. A polygon "
                 "touching another at a point or along an edge is not an overlap. The tool "
                 "never edits data; selections and definition queries on the layers are "
                 "honoured.\n\nSlivers. Give a Sliver Area, a Sliver Width (2 x area / perimeter: a strip's width, half the side of a square), or both (a polygon must then fail both); the rule is refused with neither.\n\nSafety limit. Maximum Error Regions (default 50000) stops a run whose layers overlap heavily (many polygons stacked on each other) before it uses all the memory; 0 = no limit. It counts regions and pieces of work, not bytes. Layers full of tiny digitising overlaps and gaps are slow without being stopped (12,000 polygons with 1 cm vertex noise: about 23 s of processor time in a Python test, 35,000 errors); run such data in parts.\n\nOutput. One error point per error, always inside the error "
                 "region (the centroid of its largest piece when that lies well inside, else the "
                 "pole of inaccessibility, else the middle of the widest horizontal stretch), "
                 "at the middle of "
                 "the longest overlapped stretch (line rules) or at a crossing. LINE_INTERSECT "
                 "gives one row per pair of lines: PIECES is the number of crossings, LENGTH_M "
                 "the length along which they overlap. In a shapefile "
                 "output, empty numbers are stored as 0 and a warning says so.",
        "params": {
            "in_features": "Polygon layer to check.",
            "other_features": "Optional second polygon layer: a layer to compare with, or a "
                              "boundary or must-cover layer. Needed by the three "
                              "'other' rules.",
            "line_features": "Optional line layer for the three line rules.",
            "rules": "Rules to check. Default: OVERLAP and GAP.",
            "tolerance_m": "Tolerance in metres: vertices and edges closer than this are the "
                           "same place; regions narrower than this are ignored. The tool uses "
                           "at least twice the 0.0001 m grid and twice the XY resolution of "
                           "the inputs. Default 0.001 m (the Esri default cluster tolerance).",
            "min_area_m2": "Do not report overlaps, gaps and uncovered parts smaller than this "
                           "many square metres. 0 = report all.",
            "small_area_m2": "Overlaps, gaps and uncovered parts smaller than this many square "
                             "metres get SEVERITY = SMALL (usually digitising noise: sort or "
                             "symbolise on SEVERITY to look at the NORMAL ones first). Nothing "
                             "is dropped; use Minimum Error Area to drop them. Default 0.1; "
                             "0 = every error is NORMAL.",
            "max_gap_m2": "Do not report gaps larger than this many square metres (a lake or "
                          "a park left out on purpose). 0 = no limit.",
            "sliver_area_m2": "SLIVER: report polygons smaller than this many square metres. "
                              "Empty or 0 = no area test.",
            "sliver_width_m": "SLIVER: report polygons whose width, 2 x area / perimeter, is "
                              "below this many metres (a strip is as wide as the strip; a "
                              "square is half its side). Empty or 0 = no width test. Each test "
                              "works alone; when both are given a polygon must fail both "
                              "(small AND thin). The SLIVER rule needs at least one of them.",
            "max_regions": "Safety limit on the number of overlap, gap and uncovered regions "
                           "(and on the work to find them): the run stops with a message when "
                           "it is passed, instead of using all the memory. Default 50000. In the "
                           "tests a run with 35,000 errors used about 480 MB and a heavily "
                           "stacked layer was stopped at the limit after about 170 MB; 0 = "
                           "no limit.",
            "out_points": "Output error point feature class: RULE, SEVERITY, LAYER, OID_A, OID_B, "
                          "AREA_M2, LENGTH_M, WIDTH_M, PIECES, DETAIL.",
            "out_polygons": "Optional output error polygon feature class with the same fields: "
                            "the overlap, gap, sliver or uncovered region itself (line rules "
                            "have no polygon).",
            "out_summary": "Optional output table with one row per rule: errors, total and "
                           "largest value.",
            "out_report": "Optional report: an Excel (.xlsx) file with Summary and Detail sheets, "
                          "or for .csv two files, <name>_summary.csv and <name>_detail.csv.",
            "error_count": "Number of errors found (derived).",
        },
        "tags": ["topology", "overlap", "gap", "sliver", "coverage", "validation", "quality"],
    }

    def __init__(self):
        self.label = "Topology Check (Lite)"
        self.description = ("Finds overlaps, gaps, slivers, uncovered areas and line errors "
                            "without a geodatabase topology (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_features", "Input Polygons", "GPFeatureLayer",
                       value_list=["Polygon"]),
            make_param("other_features", "Other Polygons", "GPFeatureLayer", required=False,
                       value_list=["Polygon"]),
            make_param("line_features", "Lines", "GPFeatureLayer", required=False,
                       value_list=["Polyline"]),
            make_param("rules", "Rules", "GPString", required=False, multi_value=True,
                       value_list=list(TOPO_RULES), default=list(TOPO_DEFAULT_RULES)),
            make_param("tolerance_m", "Tolerance (m)", "GPDouble", required=False,
                       default=TOPO_DEFAULT_TOLERANCE_M),
            make_param("min_area_m2", "Minimum Error Area (m2)", "GPDouble", required=False,
                       default=0.0),
            make_param("small_area_m2", "Small Error Area (m2)", "GPDouble", required=False,
                       default=_TLITE_DEFAULT_SMALL_AREA),
            make_param("max_gap_m2", "Maximum Gap Area (m2)", "GPDouble", required=False,
                       default=0.0),
            make_param("sliver_area_m2", "Sliver Area (m2)", "GPDouble", required=False),
            make_param("sliver_width_m", "Sliver Width (2 x area / perimeter, m)", "GPDouble",
                       required=False),
            make_param("max_regions", "Maximum Error Regions", "GPLong", required=False,
                       default=_TLITE_DEFAULT_MAX_REGIONS),
            make_param("out_points", "Output Error Points", "DEFeatureClass",
                       direction="Output"),
            make_param("out_polygons", "Output Error Polygons", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("out_summary", "Output Summary Table", "DETable", direction="Output",
                       required=False),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("error_count", "Error Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        for name in _TLITE_NUMBER_PARAMS:
            value = p[name].value
            if value is not None and float(value) < 0:
                p[name].setErrorMessage("The value must be zero or more.")
        rules = [r.upper() for r in param_list(p["rules"])] or list(TOPO_DEFAULT_RULES)
        if TOPO_RULE_SLIVER in rules and not ((param_number(p["sliver_area_m2"]) or 0) > 0
                                              or (param_number(p["sliver_width_m"]) or 0) > 0):
            p["sliver_area_m2"].setWarningMessage(
                "The SLIVER rule needs a Sliver Area or a Sliver Width above zero.")
        if param_text(p["in_features"]) is not None:
            if any(r in TOPO_OTHER_RULES for r in rules) and not param_text(p["other_features"]):
                p["other_features"].setWarningMessage(
                    "A rule that compares with the other layer is selected, but no Other "
                    "Polygons are given.")
            if any(r in TOPO_LINE_RULES for r in rules) and not param_text(p["line_features"]):
                p["line_features"].setWarningMessage(
                    "A line rule is selected, but no Lines are given.")
        pair = find_duplicate_outputs([param_text(p[n]) for n in ("out_points", "out_polygons",
                                                                   "out_summary")])
        if pair:
            p["out_points"].setErrorMessage("Two outputs are the same dataset; give every "
                                            "output its own name.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            flush_messages(collector)
            raise

    # ------------------------------------------------------------------

    def _rules(self, p, has_other, has_lines, collector):
        rules = [r.upper() for r in param_list(p["rules"])] or list(TOPO_DEFAULT_RULES)
        unknown = [r for r in rules if r not in TOPO_RULES]
        if unknown:
            raise ToolError("Unknown rule(s): {0}.".format(", ".join(unknown)),
                            "Choose rules from the list: {0}.".format(", ".join(TOPO_RULES)))
        rules = [r for r in TOPO_RULES if r in rules]
        need_other = [r for r in rules if r in TOPO_OTHER_RULES]
        if need_other and not has_other:
            raise ToolError("The rule(s) {0} compare the input with another layer, but no "
                            "Other Polygons were given.".format(", ".join(need_other)),
                            "Choose the Other Polygons layer, or remove those rules.")
        need_lines = [r for r in rules if r in TOPO_LINE_RULES]
        if need_lines and not has_lines:
            raise ToolError("The rule(s) {0} check lines, but no Lines were given.".format(
                ", ".join(need_lines)),
                "Choose the Lines layer, or remove those rules.")
        if has_other and not need_other and TOPO_RULE_LINE_OUTSIDE not in rules:
            collector.warning("Other Polygons were given, but no selected rule uses them; "
                              "they are ignored: not read, not checked, and their coordinate "
                              "resolution does not count in the tolerance.")
        if has_lines and not need_lines:
            collector.warning("Lines were given, but no line rule is selected; they are "
                              "ignored: not read, not checked, and their coordinate "
                              "resolution does not count in the tolerance.")
        return rules

    @staticmethod
    def _layers_used(rules, has_other, has_lines):
        """Which optional layers the selected rules use (R11-1).

        Other Polygons are used by the three "other" rules and, when given, as the reference
        of LINE_OUTSIDE; Lines only by the line rules. A layer given but not used is not
        described, read or counted in the coordinate resolution."""
        use_other = has_other and bool(
            [r for r in rules if r in TOPO_OTHER_RULES or r == TOPO_RULE_LINE_OUTSIDE])
        use_lines = has_lines and bool([r for r in rules if r in TOPO_LINE_RULES])
        return use_other, use_lines

    def _system(self, desc, label, collector):
        info = desc["sr"] or {}
        if sr_is_unknown(info):
            raise ToolError("The {0} has an unknown coordinate system, so areas and tolerances "
                            "in metres cannot be applied.".format(label),
                            "Define its coordinate system (Define Projection tool), or project "
                            "it to a projected metric system, then run the tool again.")
        if info.get("type") == "Geographic":
            raise ToolError("The {0} is in a geographic coordinate system ({1}), whose unit is "
                            "degrees; areas and tolerances in metres cannot be applied to "
                            "it.".format(label, info.get("name")),
                            "Project the data to a projected metric coordinate system suited "
                            "to the area (Project tool), then run the tool again.")
        mpu = info.get("meters_per_unit")
        if not mpu or mpu <= 0:
            raise ToolError("The unit of the {0} coordinate system ({1}) is not known.".format(
                label, info.get("name")),
                "Project the data to a projected metric system first.")
        if is_web_mercator(info.get("wkid")):
            collector.warning("The {0} is in a Web Mercator system ({1}), which distorts "
                              "distances and areas (about 15 % in length at 30 degrees "
                              "latitude, 100 % at 60). Areas are not true square metres; "
                              "project the data to a UTM zone or a national grid first."
                              .format(label, info.get("name")))
        return info, float(mpu)

    def _read(self, desc, label, read_sr, collector):
        rows, skipped = read_features_skip_curves(desc["input"], sr=read_sr)
        collector.info("{0}: {1} feature(s) read.".format(label, len(rows)))
        if skipped:
            collector.warning("{0}: {1} feature(s) with true curves were skipped: OID {2}. "
                              "Densify them first to check them.".format(
                                  label, len(skipped), _tlite_oid_list(skipped)))
        return rows

    def _other_layer(self, path, kind, label, in_desc, in_info, inputs, collector, resolutions):
        desc = describe_dataset(path)
        shape_kind = kind_from_shape_type(desc["shape_type"])
        if shape_kind != kind:
            raise ToolError("The {0} must contain {1}.".format(
                label, "polygons" if kind == GEOM_POLYGON else "lines"),
                "Choose a {0} layer.".format("polygon" if kind == GEOM_POLYGON else "line"))
        if same_dataset(desc["catalog_path"], in_desc["catalog_path"]) and kind == GEOM_POLYGON:
            raise ToolError("The {0} is the input layer itself.".format(label),
                            "Choose another layer, or remove it to check the input alone.")
        info = desc["sr"] or {}
        if sr_is_unknown(info):
            raise ToolError("The {0} has an unknown coordinate system, so it cannot be "
                            "projected into the system of the input.".format(label),
                            "Define its coordinate system (Define Projection tool) and run "
                            "the tool again.")
        resolutions.append(_tlite_resolution_m(desc["sr_object"], info))
        same = (info.get("wkid") and info.get("wkid") == in_info.get("wkid")) or (
            not info.get("wkid") and not in_info.get("wkid")
            and info.get("name") == in_info.get("name"))
        read_sr = None if same else in_desc["sr_object"]
        if not same:
            collector.warning("The {0} ({1}) is projected into the system of the input as it "
                              "is read, vertex by vertex: straight edges are not densified, so "
                              "long edges can move by more than the tolerance and show as "
                              "false errors along them. Give all layers in the same projected "
                              "system for exact results.".format(label, info.get("name")))
            warn = datum_mismatch_warning(
                "The {0}".format(label), info,
                {"wkid": in_info.get("wkid"), "gcs_wkid": gcs_wkid_of(in_info)})
            if warn:
                collector.warning(warn)
        inputs.append(desc["catalog_path"])
        return desc, self._read(desc, label, read_sr, collector)

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))
        if report and report["note"]:
            collector.info(report["note"])
        values = dict((n, param_number(p[n])) for n in _TLITE_NUMBER_PARAMS)
        for name, value in values.items():
            if value is not None and (value < 0 or value != value or value == float("inf")):
                raise ToolError("The value of '{0}' must be zero or more.".format(name),
                                "Enter 0 or a positive number.")
        out_points = param_text(p["out_points"])
        out_polygons = param_text(p["out_polygons"])
        out_summary = param_text(p["out_summary"])
        refuse_duplicate_outputs([out_points, out_polygons, out_summary])
        has_other = bool(param_text(p["other_features"]))
        has_lines = bool(param_text(p["line_features"]))
        rules = self._rules(p, has_other, has_lines, collector)
        has_other, has_lines = self._layers_used(rules, has_other, has_lines)
        if TOPO_RULE_SLIVER in rules and not ((values["sliver_area_m2"] or 0) > 0
                                              or (values["sliver_width_m"] or 0) > 0):
            raise ToolError("The SLIVER rule is selected, but neither a Sliver Area nor a "
                            "Sliver Width is given.",
                            "Enter a Sliver Area (m2), a Sliver Width (m), or both (a polygon "
                            "must then fail both), or remove the SLIVER rule.")

        desc = describe_dataset(param_text(p["in_features"]))
        if kind_from_shape_type(desc["shape_type"]) != GEOM_POLYGON:
            raise ToolError("The input must contain polygons.", "Choose a polygon layer.")
        info, mpu = self._system(desc, "input", collector)
        collector.info("Coordinate system: {0}; one unit = {1:g} m.".format(
            info.get("name"), mpu))
        inputs = [desc["catalog_path"]]
        resolutions = [_tlite_resolution_m(desc["sr_object"], info)]
        polys = self._read(desc, "Input", None, collector)
        others = None
        if has_other:
            _od, others = self._other_layer(param_text(p["other_features"]), GEOM_POLYGON,
                                            "other polygons", desc, info, inputs, collector,
                                            resolutions)
        lines = None
        if has_lines:
            _ld, lines = self._other_layer(param_text(p["line_features"]), GEOM_POLYLINE,
                                           "lines", desc, info, inputs, collector,
                                           resolutions)
        # an ignored layer is not read, but an output still may not replace it
        for given, used in ((p["other_features"], has_other), (p["line_features"], has_lines)):
            if param_text(given) and not used:
                inputs.append(param_text(given))
        for out in (out_points, out_polygons, out_summary):
            if out:
                check_output_path(out, inputs)
        known = [r for r in resolutions if r]
        res_m = max(known) if known else 0.0
        if known:
            collector.info("Coordinate resolution of the inputs: {0:g} m (largest of {1} "
                           "read).".format(res_m, len(known)))
        options = topo_options(
            rules=rules, tolerance_m=values["tolerance_m"], min_area_m2=values["min_area_m2"],
            small_area_m2=values["small_area_m2"],
            max_gap_m2=values["max_gap_m2"], sliver_area_m2=values["sliver_area_m2"],
            sliver_width_m=values["sliver_width_m"], unit_m=mpu, resolution_m=res_m,
            max_regions=(_TLITE_DEFAULT_MAX_REGIONS if values["max_regions"] is None
                         else int(values["max_regions"])))
        progress = Progress("Checking topology", 0)
        options["progress"] = progress.label
        try:
            result = topo_check(polys, others=others, lines=lines, options=options)
        except TopoLimitError as err:
            raise ToolError(
                "Too much to compute: {0}. The layers overlap or cross each other so heavily "
                "(for example many polygons stacked on each other, or a layer that is not meant to "
                "tile) that the run would need very large amounts of memory (without the "
                "limit, 44,000 overlap regions took 1.3 GB in a test).".format(err),
                "Check the input first (Find Identical, Check Geometry), run on a selection or "
                "a smaller area, or raise Maximum Error Regions (0 = no limit) if you have the "
                "memory.")
        finally:
            progress.close()
        errors = result["errors"]
        self._messages(collector, result, polys, others, lines, values, res_m)

        created = []
        try:
            self._write_points(out_points, desc, info, errors, mpu, inputs, created, collector)
            if out_polygons:
                self._write_polygons(out_polygons, desc, info, errors, mpu, inputs, created,
                                     collector)
            if out_summary:
                self._write_summary(out_summary, result, inputs, created, collector)
        except Exception:
            for done in created:
                try:
                    safe_delete(done, inputs)
                except Exception:
                    pass
            raise

        summary = self._report_summary(result, info, mpu, values, rules)
        detail = [(e["rule"], e["severity"], e["layer"], e["oid_a"], e["oid_b"]) + self._values(e, mpu)
                  + (e["point"][0], e["point"][1], e["detail"]) for e in errors]
        for written in write_report(report, summary, _TLITE_REPORT_HEADER, detail):
            collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "error_count", str(len(errors)))
        flush_messages(collector)

    # ------------------------------------------------------------------

    def _messages(self, collector, result, polys, others, lines, values, res_m):
        stats, errors = result["stats"], result["errors"]
        tol = result["tolerance_m"]
        asked = values["tolerance_m"]
        collector.info("Coordinates are rounded to a grid of {0:g} m. Tolerance used: {1:g} m"
                       "{2}.".format(result["grid_m"], tol,
                                     "" if asked is None or abs(tol - asked) < 1e-12 else
                                     " (entered {0:g} m; the tool uses at least twice the grid "
                                     "and twice the XY resolution of the inputs)".format(asked)))
        large = _tlite_large_tolerance_warning(tol)
        if large:
            collector.warning(large)
        if stats["clustered_vertices"] or stats["inserted_vertices"]:
            collector.info("Snapping within the tolerance moved {0} vertex(es) onto a "
                           "neighbouring vertex and added {1} vertex(es) to edges they "
                           "touch.".format(stats["clustered_vertices"],
                                           stats["inserted_vertices"]))
        narrow = (stats["ignored_narrow_gaps"], stats["ignored_narrow_overlaps"],
                  stats["ignored_narrow_other"], stats["ignored_narrow_unclassified"])
        if any(narrow):
            collector.info("Regions not wider than the tolerance were ignored as noise: {0} "
                           "gap(s), {1} overlap(s), {2} part(s) in the comparison with the "
                           "other layer, {3} not classified.".format(*narrow))
        if stats["below_min_area"]:
            collector.info("{0} error(s) below the Minimum Error Area were not "
                           "reported.".format(stats["below_min_area"]))
        if stats["gaps_over_max"]:
            collector.info("{0} gap(s) larger than the Maximum Gap Area were not "
                           "reported.".format(stats["gaps_over_max"]))
        if stats["noding_unstable"]:
            collector.warning("The boundaries could not be made consistent in {0} place(s) "
                              "(many near-coincident edges); the results there may be "
                              "incomplete. Try a larger tolerance.".format(
                                  stats["noding_unstable"]))
        if stats["unresolved_faces"]:
            collector.warning("{0} region(s) could not be classified (they lie exactly on "
                              "other boundaries) and are not reported. Try a larger "
                              "tolerance.".format(stats["unresolved_faces"]))
        vanished = stats["input_vanished"] + stats["other_vanished"]
        if vanished:
            collector.warning("{0} feature(s) vanished when snapped: they are smaller than "
                              "the tolerance, or have no area (a zero-area or self-crossing "
                              "ring: run Check Geometry). They take no part in the overlap, "
                              "gap and comparison rules.".format(vanished))
        notes = result.get("ring_notes") or {}
        for label in ("input", "other"):
            layer_notes = notes.get(label) or {}
            fixed = layer_notes.get(TOPO_RING_REORDERED) or []
            if fixed:
                collector.warning(
                    "{0} {1} feature(s) have rings that are not in Esri order (for example OGC "
                    "order: outer ring counter-clockwise, holes clockwise; Check Geometry reports "
                    "'incorrect ring ordering'): OID {2}. They were read by nesting (a ring inside "
                    "an outer ring is a hole, a ring inside a hole an island), so their holes "
                    "are still checked. Run Check Geometry and Repair Geometry to fix the "
                    "data.".format(len(fixed), label, _tlite_oid_list(fixed)))
            nested = layer_notes.get(TOPO_RING_NESTED) or []
            if nested:
                collector.warning(
                    "{0} {1} feature(s) have an outer ring directly inside another outer ring "
                    "of the same feature: OID {2}. As Esri ring order says, the inner ring is "
                    "read as a second, overlapping part, not as a hole, so no gap is reported "
                    "there. If it is meant to be a hole, its ring order is wrong: run Check "
                    "Geometry.".format(len(nested), label, _tlite_oid_list(nested)))
        for label, nulls in (("input", result["nulls"]["input"]),
                             ("other", result["nulls"]["other"]),
                             ("line", result["nulls"]["lines"])):
            if nulls:
                collector.warning("{0} {1} feature(s) have no geometry: OID {2}. Delete or "
                                  "repair them.".format(len(nulls), label,
                                                        _tlite_oid_list(nulls)))
        if TOPO_RULE_LINE_OUTSIDE in result["rules"]:
            # R13-1: an empty reference is not refused; say what it means
            ref_label, ref_count = (("input", stats["input_features"]) if others is None
                                    else ("other polygons", stats["other_features"]))
            if not ref_count:
                collector.warning("The {0} layer, the reference of LINE_OUTSIDE, has no "
                                  "polygons with geometry, so every line is reported as "
                                  "LINE_OUTSIDE. Check the selection or definition query, or "
                                  "give Other Polygons.".format(ref_label))
        small = topo_small_counts(errors)
        for (rule, count, total, unit, largest), line in zip(topo_summary(errors),
                                                             topo_result_lines(errors)):
            collector.info(line)
            if small.get(rule):
                collector.info("{0}: {1} of the {2} error(s) are SMALL (area below {3:g} m2, "
                               "often digitising noise); sort or symbolise on SEVERITY, or "
                               "raise Minimum Error Area to leave them out.".format(
                                   rule, small[rule], count, values["small_area_m2"]
                                   if values["small_area_m2"] is not None
                                   else _TLITE_DEFAULT_SMALL_AREA))
        collector.info("{0} error(s) found in {1} input polygon(s){2}{3}.".format(
            len(errors), stats["input_features"],
            "" if others is None else ", {0} other polygon(s)".format(stats["other_features"]),
            "" if lines is None else ", {0} line(s)".format(stats["line_features"])))

    def _values(self, e, mpu):
        """``(area_m2, length_m, width_m, pieces)`` of an error row."""
        if e["unit"] == "m2":
            return (e["value"], _tlite_ring_length(e["rings"]) * mpu, e["width"], e["pieces"])
        return (None, e["value"], None, e["pieces"])

    def _specs(self, errors, out_path=None, collector=None):
        # OID_A, OID_B: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``)
        oid_spec = oid_output_field(out_path or "memory\\x", [e["oid_a"] for e in errors] +
                                    [e["oid_b"] for e in errors], collector, label="OID_A and OID_B")
        self._oid_spec = oid_spec
        return [{"name": "RULE", "type": "TEXT", "length": 24},
                {"name": "SEVERITY", "type": "TEXT", "length": 8},
                {"name": "LAYER", "type": "TEXT", "length": 8},
                dict(oid_spec, name="OID_A"), dict(oid_spec, name="OID_B"),
                {"name": "AREA_M2", "type": "DOUBLE"}, {"name": "LENGTH_M", "type": "DOUBLE"},
                {"name": "WIDTH_M", "type": "DOUBLE"}, {"name": "PIECES", "type": "LONG"},
                {"name": "DETAIL", "type": "TEXT",
                 "length": text_field_length([e["detail"] for e in errors], 60)}]

    def _row(self, e, mpu):
        area, length, width, pieces = self._values(e, mpu)
        spec = getattr(self, "_oid_spec", {"type": "LONG"})
        return (e["rule"], e["severity"], e["layer"], oid_field_value(spec, e["oid_a"]),
                oid_field_value(spec, e["oid_b"]), area, length,
                width, pieces, e["detail"])

    def _write_points(self, out_path, desc, info, errors, mpu, inputs, created, collector):
        specs, _renamed = plan_output_fields(out_path, self._specs(errors, out_path, collector), fixed=10)
        path, fmap = create_feature_class(out_path, GEOM_POINT, desc["sr_object"], specs,
                                          inputs=inputs)
        created.append(path)
        null_fields = set()
        insert_rows(path, [fmap[s["name"]] for s in specs],
                    [(e["point"], self._row(e, mpu)) for e in errors],
                    kind=GEOM_POINT, wkid=info.get("wkid"), null_fields=null_fields)
        collector.info("{0} error point(s) written to {1}.".format(len(errors), path))
        note = folder_null_number_warning(
            path, specs, fmap, null_fields,
            "The RULE column tells which fields apply: AREA_M2 and WIDTH_M are empty for the "
            "line rules, OID_B is empty when there is no second feature.")
        if note:
            collector.warning(note)

    def _write_polygons(self, out_path, desc, info, errors, mpu, inputs, created, collector):
        drawn = [e for e in errors if e["rings"]]
        specs, _renamed = plan_output_fields(out_path, self._specs(errors, out_path, collector), fixed=10)
        path, fmap = create_feature_class(out_path, GEOM_POLYGON, desc["sr_object"], specs,
                                          inputs=inputs)
        created.append(path)
        null_fields = set()
        insert_rows(path, [fmap[s["name"]] for s in specs],
                    [(e["rings"], self._row(e, mpu)) for e in drawn],
                    kind=GEOM_POLYGON, wkid=info.get("wkid"), null_fields=null_fields)
        collector.info("{0} error polygon(s) written to {1}.".format(len(drawn), path))
        note = folder_null_number_warning(
            path, specs, fmap, null_fields,
            "OID_B is empty when there is no second feature (0 means none).")
        if note:
            collector.warning(note)

    def _write_summary(self, out_path, result, inputs, created, collector):
        counts = dict((r, (c, t, u, m)) for r, c, t, u, m in topo_summary(result["errors"]))
        small = topo_small_counts(result["errors"])
        rows = []
        for rule in result["rules"]:
            c, t, u, m = counts.get(rule, (0, 0.0, "m2" if rule in _TLITE_AREA_RULES else "m",
                                          0.0))
            rows.append((rule, c, small.get(rule, 0), t, u, m))
        specs = [{"name": "RULE", "type": "TEXT", "length": 24},
                 {"name": "ERRORS", "type": "LONG"}, {"name": "SMALL", "type": "LONG"},
                 {"name": "TOTAL", "type": "DOUBLE"},
                 {"name": "UNIT", "type": "TEXT", "length": 4},
                 {"name": "LARGEST", "type": "DOUBLE"}]
        specs, _renamed = plan_output_fields(out_path, specs, fixed=6)
        path, fmap = create_table(out_path, specs, inputs=inputs)
        created.append(path)
        insert_rows(path, [fmap[s["name"]] for s in specs], rows)
        collector.info("{0} summary row(s) written to {1}.".format(len(rows), path))

    def _report_summary(self, result, info, mpu, values, rules):
        stats, errors = result["stats"], result["errors"]
        rows = [("Input polygons", stats["input_features"]),
                ("Other polygons", stats["other_features"]),
                ("Lines", stats["line_features"]),
                ("Rules", ", ".join(rules)),
                ("Errors", len(errors)),
                ("Tolerance used (m)", result["tolerance_m"]),
                ("Grid (m)", result["grid_m"]),
                ("Minimum error area (m2)", values["min_area_m2"]),
                ("Small error area (m2)", values["small_area_m2"]),
                ("Maximum gap area (m2)", values["max_gap_m2"]),
                ("Sliver area (m2)", values["sliver_area_m2"]),
                ("Sliver width (m)", values["sliver_width_m"]),
                ("Ignored narrow gaps", stats["ignored_narrow_gaps"]),
                ("Ignored narrow overlaps", stats["ignored_narrow_overlaps"]),
                ("Ignored narrow parts (other layer)", stats["ignored_narrow_other"]),
                ("Coordinate system", "{0} (WKID {1}); one unit = {2:g} m".format(
                    info.get("name"), info.get("wkid"), mpu))]
        counts = dict((r, c) for r, c, _t, _u, _m in topo_summary(errors))
        small = topo_small_counts(errors)
        for rule in result["rules"]:
            rows.append(("Rule " + rule, counts.get(rule, 0)))
            if rule in TOPO_REGION_RULES:
                rows.append(("Rule " + rule + ", of which SMALL", small.get(rule, 0)))
        return rows


# ==========================================================================
# quality/mojibake_tool.py
# ==========================================================================
# Broken Text Encoding Detector: the ArcGIS Pro tool (adapter).

_MOJIBAKE_TEXT_TYPES = ("string", "text")
_MOJIBAKE_FOLDER_COPY = ("Output Repaired Copy is a shapefile or dBASE table (in a folder). Such a "
                         "copy is written in the system code page and cannot store every "
                         "character, so Arabic text could be damaged again.")
_MOJIBAKE_FOLDER_FIX = "Write the repaired copy to a geodatabase."


def _mojibake_folder_output(path):
    return bool(path) and is_folder_workspace(split_catalog_path(path)[0])


def _mojibake_dbf_path(catalog_path):
    """The ``.dbf`` behind a shapefile / dBASE input, or ``None``."""
    base, ext = os.path.splitext(str(catalog_path or ""))
    if ext.lower() in (".shp", ".dbf") and os.path.isfile(base + ".dbf"):
        return base + ".dbf"
    return None


_MOJIBAKE_CELL_MAX = 32000     # an Excel cell holds at most 32,767 characters


def _mojibake_cell(value):
    """Report cell text: very long values are cut so that Excel can open the file."""
    if isinstance(value, str) and len(value) > _MOJIBAKE_CELL_MAX:
        return value[:_MOJIBAKE_CELL_MAX] + u"... (cut, {0} characters)".format(len(value))
    return value


# A UTF-16 surrogate code point on its own (half of a pair: a text cut in UTF-16 units). Python
# keeps it in a str, but UTF-8 cannot encode it, so the CSV and xlsx writers stop on it.
_MOJIBAKE_SURROGATE = re.compile(u"[\ud800-\udfff]")


def _mojibake_safe_rows(rows, counter=None):
    """``rows`` with every lone UTF-16 surrogate in a text value replaced by U+FFFD, for the
    output tables and the report (such a value used to crash the report write).
    ``counter[0]`` counts the rows that changed. The repaired copy is not touched."""
    out = []
    for row in rows:
        new = tuple(_MOJIBAKE_SURROGATE.sub(u"\ufffd", v) if isinstance(v, str) else v
                    for v in row)
        if counter is not None and new != tuple(row):
            counter[0] += 1
        out.append(new)
    return out


_MOJIBAKE_CUT = " ...[cut]"
# text columns of the issues table, the repair log and the field summary (None: not text)
_MOJIBAKE_ISSUE_COLUMNS = ("SRC_TABLE", "FIELD_NAME", None, "ORIG_TEXT", "PROP_TEXT", "PATTERN",
                           "CONFIDENCE", "RULE_ID", "DETAIL")
_MOJIBAKE_LOG_COLUMNS = (None, "FIELD_NAME", "ORIG_TEXT", "FIXED_TEXT", "PATTERN", "CONFIDENCE",
                         "RULE_ID", "STATUS")
_MOJIBAKE_SUMMARY_COLUMNS = ("FIELD_NAME", None, None, None, None, None, None, None, None,
                             "TOP_PATTERN")


def _mojibake_fit_rows(out_path, columns, rows, collector):
    """``rows`` with every text value cut to what a dBASE field holds when ``out_path`` is in a
    folder (254 bytes as Pro writes them; characters above U+FFFF count 6, see
    ``arcio.cut_utf8_bytes``). A cut value ends with ``...[cut]``, cut at a character boundary,
    and a warning names the fields. A geodatabase or GeoPackage keeps the full text (its width is
    sized from the values in UTF-16 units by ``arcio``). ``columns``: one name per row position,
    ``None`` for a non-text column. (A long U11 DETAIL with characters above U+FFFF used to
    exceed a geodatabase field.)"""
    if not _mojibake_folder_output(out_path):
        return rows
    cuts = {}
    out = []
    for row in rows:
        new = list(row)
        for index, name in enumerate(columns):
            if name is None or not isinstance(new[index], str):
                continue
            counter = [0]
            new[index] = cut_utf8_bytes(new[index], True, counter, _MOJIBAKE_CUT)
            if counter[0]:
                cuts[name] = cuts.get(name, 0) + 1
        out.append(tuple(new))
    if cuts:
        collector.warning("{0}: a dBASE field holds at most {1} bytes, so {2} were cut and end with "
                          "'...[cut]'. The full text is in the report (if one is written); write the "
                          "table to a geodatabase to keep it whole.".format(
                              out_path, SHAPEFILE_MAX_TEXT,
                              ", ".join("{0} value(s) of {1}".format(n, name)
                                        for name, n in sorted(cuts.items()))))
    return out


def _mojibake_folder_note(collector, requested, texts):
    """Warn when text outside ASCII goes into a table in a folder (a dBASE table): which
    characters a dBASE table keeps depends on its code page (NOT VERIFIED for every
    ArcGIS Pro version), and this tool is about text that was stored wrongly."""
    if not _mojibake_folder_output(requested):
        return
    if any(isinstance(t, str) and not t.isascii() for t in texts):
        collector.warning("{0} is a dBASE table. It may not keep every character of the damaged "
                          "and repaired text exactly (which characters it keeps depends on its "
                          "code page). Write the table to a geodatabase for an exact record."
                          .format(requested))


def _mojibake_duplicate_param(p, names):
    """Name of the first parameter of ``names`` whose dataset an earlier one already names
    (the second of a duplicated pair), or ``None``. Empty parameters are skipped."""
    seen = set()
    for name in names:
        text = param_text(p[name])
        if not text:
            continue
        key = dataset_identity(text)
        if key in seen:
            return name
        seen.add(key)
    return None


class MojibakeDetector(object):
    """Find text damaged by a wrong character encoding and propose repairs."""

    DOC = {
        "summary": "Scans the text fields of a layer or table for text that was damaged by a "
                   "wrong character encoding (mojibake): UTF-8 read as Windows-1252 or Latin-1 "
                   "('Ã©' for é), UTF-8 read through the Arabic code page Windows-1256, Arabic "
                   "Windows-1256 or ISO-8859-6 bytes read as Western European text, Western "
                   "European or Turkish text read through the wrong code page, double encoding, "
                   "replacement characters (U+FFFD), stray C1 control characters and question "
                   "marks where characters were lost. Where the damage can be undone it "
                   "proposes the repaired text, with a confidence class and the rule behind it. "
                   "For shapefiles and dBASE tables it also reads the declared code page. The "
                   "input is never edited.",
        "usage": "Every finding has CONFIDENCE HIGH, MEDIUM or LOW and a RULE_ID. The class is "
                 "given by the rule that produced the finding, not by a probability; every "
                 "rule is listed in the documentation, and the Summary of the report gives "
                 "the class and wording of each rule that occurs. For a finding with "
                 "a proposed text the class says how far the proposal can be trusted to be "
                 "the original; for a finding without one it says how sure the damage is. "
                 "HIGH is a rule class, not a guarantee: it is given only when the text has "
                 "exactly one plausible reading, and it was measured to be wrong in a small "
                 "number of rare cases (see the limits in the documentation). Only UTF-8 "
                 "damage read as Windows-1252, Windows-1256 or double encoded can be HIGH. "
                 "When another code page would also give clean, different text (for example "
                 "'StraÃŸe' also reads as 'Straþe' in ISO-8859-15), the finding is MEDIUM and "
                 "DETAIL names the other reading. UTF-8 read as ISO-8859-6, numbers (digits "
                 "only) read through an Arabic code page, and swaps between single-byte code "
                 "pages (one byte becomes one character, always valid text) are MEDIUM or LOW "
                 "at best. Do not change the case (upper, lower, title, swapped: Excel "
                 "PROPER, .title() in Calculate Field, SQL LOWER) of damaged text before the "
                 "repair: a case change can turn one letter into another, so a value whose "
                 "case may have been changed is MEDIUM (rule U11) and DETAIL names the "
                 "readings; a case edit of only part of the text can still give a wrong "
                 "HIGH. A value whose words were damaged a different number of times can get "
                 "a HIGH proposal that is still damaged: run the tool again on the copy. "
                 "A value that was encoded more than once and then cut (for example to a "
                 "field width) is MEDIUM (rule U12): the part before the cut is proposed, "
                 "and a second run does not complete it. A value encoded four to eight times is "
                 "MEDIUM (rule U13) and is left as stored at the default level. ASCII control "
                 "characters (NUL padding, SUB) next to damaged text are kept in place in the "
                 "repair, and decomposed (NFD) text keeps its combining accents. "
                 "Question marks and replacement characters cannot be repaired, "
                 "because the characters are gone; the same holds for UTF-8 text from which "
                 "a cleaning step removed the control characters (rule X2, LOW, reported "
                 "without a repair). Check MEDIUM and LOW proposals by eye "
                 "before you apply them.\n\n"
                 "Output Repaired Copy is a copy of the input in which only the repairs of the "
                 "chosen level and better are applied (default HIGH). It needs an Output "
                 "Repair Log, which lists every value that was changed. With a log but no "
                 "copy, the log shows what would be changed. The copy must be in a "
                 "geodatabase. A layer with a selection or definition query is scanned and "
                 "copied as selected.\n\n"
                 "Check Declared Code Page applies to a shapefile or dBASE input: it reads the "
                 ".cpg file and the code page mark in the .dbf header and checks the raw "
                 "bytes of the text fields for valid UTF-8; the messages and the report name "
                 "what it finds. The tool looks at the characters that ArcGIS returns; "
                 "damage that produced valid but wrong letters (for example Windows-1256 read "
                 "as ISO-8859-6) cannot be detected.",
        "params": {
            "in_table": "Layer or table to scan.",
            "fields": "Text fields to scan. Default: all text fields.",
            "out_table": "Output table: one row per damaged value and field (SRC_TABLE, "
                         "FIELD_NAME, SRC_OID, ORIG_TEXT, PROP_TEXT, PATTERN, CONFIDENCE, "
                         "RULE_ID, DETAIL).",
            "checks": "Kinds of damage to look for. Default: all.",
            "check_code_page": "For a shapefile or dBASE input, read the .cpg file and the "
                               "code page mark and check the raw text bytes.",
            "out_field_summary": "Optional table with one row per scanned field: counts by "
                                 "confidence.",
            "out_repaired": "Optional copy of the input with the repairs of the chosen level "
                            "applied. Must be in a geodatabase.",
            "repair_level": "Lowest confidence class that is applied to the repaired copy "
                            "(or listed in the log). Default HIGH. Lower levels apply "
                            "proposals that are only likely or that another code page "
                            "contradicts; look at the repair log first (run it without a "
                            "copy to preview). Repair before any upper/lower/title-case "
                            "step: a case change after the damage can change letters "
                            "(rule U11, MEDIUM). At MEDIUM, clean labels with a sign after "
                            "an accented letter (Å–Moskenes, HAITÍ…) are rewritten into broken "
                            "text (rule U2): check the log for them.",
            "out_repair_log": "Table that lists every repaired value (needed with Output "
                              "Repaired Copy). Without a copy it shows what would change.",
            "out_report": "Optional Excel (.xlsx) or CSV report with Summary and Detail "
                          "sheets (a .csv report is two files: <name>_summary.csv and "
                          "<name>_detail.csv).",
            "issue_count": "Number of damaged values found (derived).",
        },
        "tags": ["encoding", "mojibake", "Arabic", "UTF-8", "code page", "text", "quality"],
    }

    def __init__(self):
        self.label = "Broken Text Encoding Detector"
        self.description = ("Finds text damaged by a wrong character encoding (Arabic and Latin) "
                            "and proposes repairs (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_table", "Input Table", ["GPFeatureLayer", "GPTableView"]),
            make_param("fields", "Fields to Scan", "Field", required=False, multi_value=True,
                       depends_on="in_table", value_list=["Text"]),
            make_param("out_table", "Output Issues Table", "DETable", direction="Output"),
            make_param("checks", "Checks", "GPString", required=False, multi_value=True,
                       value_list=list(MOJIBAKE_CHECKS), default=list(MOJIBAKE_CHECKS)),
            make_param("check_code_page", "Check Declared Code Page (shapefile / dBASE)",
                       "GPBoolean", required=False, default=True),
            make_param("out_field_summary", "Output Field Summary", "DETable",
                       direction="Output", required=False),
            make_param("out_repaired", "Output Repaired Copy", ["DEFeatureClass", "DETable"],
                       direction="Output", required=False, category="Repair"),
            make_param("repair_level", "Repair Level", "GPString", required=False,
                       value_list=list(MOJIBAKE_CONFIDENCES), default=CONF_HIGH,
                       category="Repair"),
            make_param("out_repair_log", "Output Repair Log", "DETable", direction="Output",
                       required=False, category="Repair"),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("issue_count", "Issue Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        p = param_map(parameters)
        p["repair_level"].enabled = bool(param_text(p["out_repaired"])
                                         or param_text(p["out_repair_log"]))
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        copy, log = param_text(p["out_repaired"]), param_text(p["out_repair_log"])
        if copy and not log:
            p["out_repair_log"].setErrorMessage(
                "Choose an Output Repair Log: it lists every value changed in the copy.")
        elif copy and _mojibake_folder_output(copy):
            p["out_repaired"].setErrorMessage(_MOJIBAKE_FOLDER_COPY + " " + _MOJIBAKE_FOLDER_FIX)
        second = _mojibake_duplicate_param(p, ("out_table", "out_field_summary", "out_repaired",
                                                "out_repair_log"))
        if second is not None:     # on the later output of the pair, which has a value (R11-3)
            p[second].setErrorMessage("The outputs must be different datasets.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))

    # ------------------------------------------------------------------

    def _scan_fields(self, desc, wanted, collector):
        if wanted:
            names = []
            for name in wanted:
                field, how = match_field(desc["fields"], name, label="field",
                                         exact_name_first=True)
                collector.info(match_message(name, field, how))
                if str(field["type"]).casefold() not in _MOJIBAKE_TEXT_TYPES:
                    raise ToolError("The field '{0}' is not a text field.".format(field["name"]),
                                    "Choose text fields only.")
                if field["name"] not in names:
                    names.append(field["name"])
            return names
        names = [f["name"] for f in desc["fields"]
                 if str(f["type"]).casefold() in _MOJIBAKE_TEXT_TYPES]
        if not names:
            raise ToolError("The input has no text field.", "Choose an input with a text field.")
        collector.info("Scanning all {0} text field(s): {1}.".format(len(names), ", ".join(names)))
        return names

    def _preflight(self, desc, collector):
        """Messages and report rows of the code page check; ``[]`` when not applicable."""
        dbf = _mojibake_dbf_path(desc["catalog_path"])
        if dbf is None:
            collector.info("Code page check skipped: the input is not a shapefile or dBASE "
                           "table on disk.")
            return []
        try:
            facts = mojibake_preflight(dbf)
        except (IOError, OSError, ValueError) as exc:
            collector.warning("The code page check could not read '{0}': {1}".format(dbf, exc))
            return []
        collector.info("Code page of {0}: {1}.".format(os.path.basename(dbf), facts["declared"]))
        rows = [("Attribute file", facts["dbf"]), ("Records in the dBASE header", facts["records"]),
                ("Declared code page", facts["declared"])]
        for finding in facts["findings"]:
            if finding["level"] == "WARNING":
                collector.warning(finding["text"])
            else:
                collector.info(finding["text"])
            rows.append(("Code page check " + finding["rule"], finding["text"]))
        if not facts["findings"]:
            collector.info("The code page check found nothing to report.")
        if facts["truncated"]:
            rows.append(("Code page check", "Only the first distinct values of a field were "
                                            "checked."))
        return rows

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        checks = [c.upper() for c in (param_list(p["checks"]) or list(MOJIBAKE_CHECKS))]
        unknown = [c for c in checks if c not in MOJIBAKE_CHECKS]
        if unknown:
            raise ToolError("Unknown check(s): {0}.".format(", ".join(unknown)),
                            "Choose checks from the list: {0}.".format(", ".join(MOJIBAKE_CHECKS)))
        level = (param_text(p["repair_level"]) or CONF_HIGH).upper()
        if level not in MOJIBAKE_CONFIDENCES:
            raise ToolError("Unknown repair level '{0}'.".format(level),
                            "Choose HIGH, MEDIUM or LOW.")
        out_copy, out_log = param_text(p["out_repaired"]), param_text(p["out_repair_log"])
        if out_copy and not out_log:
            raise ToolError("Output Repaired Copy needs an Output Repair Log.",
                            "Choose a table for the log of changed values.")
        if out_copy and _mojibake_folder_output(out_copy):
            raise ToolError(_MOJIBAKE_FOLDER_COPY + " Nothing was written.", _MOJIBAKE_FOLDER_FIX)
        outputs = [param_text(p[n]) for n in ("out_table", "out_field_summary", "out_repaired",
                                              "out_repair_log")]
        refuse_duplicate_outputs([o for o in outputs if o])
        desc = describe_dataset(param_text(p["in_table"]))
        inputs = [desc["catalog_path"]]
        if out_copy:
            check_output_path(out_copy, inputs)   # before anything is written
        names = self._scan_fields(desc, param_list(p["fields"]), collector)
        preflight_rows = []
        if param_bool(p["check_code_page"], True):
            preflight_rows = self._preflight(desc, collector)
        rows = read_features(desc["input"], names, geometry=False)
        progress = Progress("Scanning text", len(rows))
        issues, stats = scan_mojibake([(r["oid"], [r["attrs"][n] for n in names]) for r in rows],
                                      names, checks)
        progress.tick(len(rows))
        progress.close()
        table_name = desc["name"]
        lone = [0]
        detail = _mojibake_safe_rows([(table_name, i["field"], i["oid"], i["original"],
                                       i["proposed"], i["pattern"], i["confidence"], i["rule"],
                                       i["detail"]) for i in issues], lone)
        if lone[0]:
            collector.warning("{0} finding(s) hold half of a UTF-16 surrogate pair (a text cut "
                              "in the middle of a character above U+FFFF). The tables and the "
                              "report show it as U+FFFD; the repaired copy keeps the value as "
                              "stored.".format(lone[0]))
        stored = _mojibake_fit_rows(param_text(p["out_table"]), _MOJIBAKE_ISSUE_COLUMNS,
                                    detail, collector)
        folder = _mojibake_folder_output(param_text(p["out_table"]))
        sizes = [cut_utf8_bytes(v, folder, [0], _MOJIBAKE_CUT) for v in [table_name] + list(names)]
        oid_spec = oid_output_field(param_text(p["out_table"]), [r[2] for r in stored], collector)
        stored = [tuple(r[:2]) + (oid_field_value(oid_spec, r[2]),) + tuple(r[3:]) for r in stored]
        specs = [{"name": "SRC_TABLE", "type": "TEXT", "values": sizes[:1] + [r[0] for r in stored]},
                 {"name": "FIELD_NAME", "type": "TEXT", "values": sizes[1:] + [r[1] for r in stored]},
                 oid_spec,
                 {"name": "ORIG_TEXT", "type": "TEXT", "values": [r[3] for r in stored]},
                 {"name": "PROP_TEXT", "type": "TEXT", "values": [r[4] for r in stored]},
                 {"name": "PATTERN", "type": "TEXT", "length": 24},
                 {"name": "CONFIDENCE", "type": "TEXT", "length": 8},
                 {"name": "RULE_ID", "type": "TEXT", "length": 4},
                 {"name": "DETAIL", "type": "TEXT", "values": [r[8] for r in stored]}]
        path, mapping = create_table(param_text(p["out_table"]), specs, inputs=inputs)
        insert_rows(path, [mapping[s["name"]] for s in specs], stored)
        _mojibake_folder_note(collector, param_text(p["out_table"]),
                              [i["original"] for i in issues] + [i["proposed"] for i in issues])
        if issues:
            collector.warning("{0} damaged value(s) in {1} row(s); {2} with a proposed repair; "
                              "see {3}.".format(len(issues), len(set(i["oid"] for i in issues)),
                                                sum(1 for i in issues if i["proposed"] is not None),
                                                path))
            for conf in MOJIBAKE_CONFIDENCES:
                count = sum(1 for i in issues if i["confidence"] == conf)
                if count:
                    collector.info("  {0}: {1}".format(conf, count))
        else:
            collector.info("No damaged text found in {0} row(s).".format(len(rows)))
        summary_rows = mojibake_field_summary(issues, stats, names)
        if param_text(p["out_field_summary"]):
            self._write_field_summary(p, summary_rows, inputs, collector)
        repaired_rows = []
        if out_log:
            repaired_rows = self._repairs(desc, p, issues, level, out_copy, out_log, inputs,
                                          collector)
        summary = mojibake_summary(issues, len(rows), names) + preflight_rows
        summary.append(("Repair level", level if (out_copy or out_log) else "(no repair output)"))
        summary.append(("Values changed in the copy",
                        sum(1 for r in repaired_rows if r[7] == "APPLIED")))
        for row in summary_rows:
            summary.append(("Field " + row[0], "{0} damaged of {1} values; {2} repairable; "
                            "HIGH {3}, MEDIUM {4}, LOW {5}".format(row[4], row[1], row[5], row[6],
                                                                    row[7], row[8])))
        summary.extend(mojibake_rule_rows(issues))     # class and wording of each rule found
        report_detail = [tuple(_mojibake_cell(v) for v in row) for row in detail]
        summary = _mojibake_safe_rows(summary)
        for written in write_report(report, summary,
                                    ["SRC_TABLE", "FIELD_NAME", "SRC_OID", "ORIG_TEXT",
                                     "PROP_TEXT", "PATTERN", "CONFIDENCE", "RULE_ID", "DETAIL"],
                                    report_detail):
            collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "issue_count", str(len(issues)))
        flush_messages(collector)

    def _write_field_summary(self, p, summary_rows, inputs, collector):
        summary_rows = _mojibake_fit_rows(param_text(p["out_field_summary"]),
                                          _MOJIBAKE_SUMMARY_COLUMNS, summary_rows, collector)
        specs = [{"name": "FIELD_NAME", "type": "TEXT", "values": [r[0] for r in summary_rows]},
                 {"name": "N_VALUES", "type": "LONG"}, {"name": "N_NULL", "type": "LONG"},
                 {"name": "N_BLANK", "type": "LONG"}, {"name": "N_DAMAGED", "type": "LONG"}, {"name": "N_REPAIRABLE", "type": "LONG"},
                 {"name": "N_HIGH", "type": "LONG"}, {"name": "N_MEDIUM", "type": "LONG"},
                 {"name": "N_LOW", "type": "LONG"}, {"name": "TOP_PATTERN", "type": "TEXT",
                                                    "length": 24}]
        path, mapping = create_table(param_text(p["out_field_summary"]), specs, inputs=inputs)
        insert_rows(path, [mapping[s["name"]] for s in specs], summary_rows)
        collector.info("Field summary written to {0}.".format(path))

    def _repairs(self, desc, p, issues, level, out_copy, out_log, inputs, collector):
        """Repaired copy and log; returns the log rows."""
        plan, used = plan_repairs(issues, level)
        log_status = {}
        if out_copy:
            copy_path, _names = copy_for_output(desc["input"], out_copy, [], inputs=inputs)
            if used:
                log_status = self._apply(copy_path, plan, used, collector)
            else:
                collector.info("Nothing to repair at level {0}; the copy is unchanged.".format(
                    level))
            collector.info("Repaired copy written to {0}.".format(copy_path))
        rows = []
        for issue in used:
            status = log_status.get((issue["field"], issue["original"]),
                                    "APPLIED" if out_copy else "WOULD_APPLY")
            rows.append((issue["oid"], issue["field"], issue["original"], issue["proposed"],
                         issue["pattern"], issue["confidence"], issue["rule"], status))
        rows = _mojibake_safe_rows(rows)
        stored = _mojibake_fit_rows(out_log, _MOJIBAKE_LOG_COLUMNS, rows, collector)
        oid_spec = oid_output_field(out_log, [r[0] for r in stored], collector)
        stored = [(oid_field_value(oid_spec, r[0]),) + tuple(r[1:]) for r in stored]
        specs = [oid_spec,
                 {"name": "FIELD_NAME", "type": "TEXT", "values": [r[1] for r in stored]},
                 {"name": "ORIG_TEXT", "type": "TEXT", "values": [r[2] for r in stored]},
                 {"name": "FIXED_TEXT", "type": "TEXT", "values": [r[3] for r in stored]},
                 {"name": "PATTERN", "type": "TEXT", "length": 24},
                 {"name": "CONFIDENCE", "type": "TEXT", "length": 8},
                 {"name": "RULE_ID", "type": "TEXT", "length": 4},
                 {"name": "STATUS", "type": "TEXT", "length": 20}]
        path, mapping = create_table(out_log, specs, inputs=inputs)
        insert_rows(path, [mapping[s["name"]] for s in specs], stored)
        _mojibake_folder_note(collector, out_log, [r[2] for r in rows] + [r[3] for r in rows])
        collector.info("Repair log written to {0} ({1} value(s)).".format(path, len(rows)))
        return rows

    def _apply(self, copy_path, plan, used, collector):
        """Write the repairs into the copy; return ``{(field, original): status}``."""
        copy_desc = describe_dataset(copy_path)
        lengths = dict((f["name"].casefold(), f["length"]) for f in copy_desc["fields"])
        names = list(plan)
        copy_names = [match_field(copy_desc["fields"], n, label="field", exact_name_first=True)[0]["name"]
                      for n in names]
        by_copy = dict(zip(names, copy_names))
        rows = read_features(copy_path, copy_names, geometry=False)
        status, wanted = {}, {}
        for issue in used:
            wanted[(issue["field"], issue["original"])] = wanted.get(
                (issue["field"], issue["original"]), 0) + 1
        changes, applied, too_long = {}, {}, set()
        # DBASE-AUDIT: the copy's field width counts UTF-8 bytes in a folder (dBASE)
        # and UTF-16 units in a geodatabase, not characters; a repair that does not fit in that
        # unit is skipped (SKIPPED_TOO_LONG) instead of being cut by Pro or stopping the update.
        size = (_arcio_dbf_bytes if is_folder_workspace(split_catalog_path(copy_path)[0])
                else _arcio_utf16_units)
        for row in rows:
            for name in names:
                value = row["attrs"][by_copy[name]]
                fixed = plan[name].get(value)
                if fixed is None:
                    continue
                width = lengths.get(by_copy[name].casefold())
                if width and size(fixed) > width:
                    too_long.add((name, value))
                    continue
                changes.setdefault(row["oid"], {})[by_copy[name]] = fixed
                applied[(name, value)] = applied.get((name, value), 0) + 1
        update_rows(copy_path, copy_names, changes)
        for key, count in wanted.items():
            if key in too_long:
                status[key] = "SKIPPED_TOO_LONG"
            elif applied.get(key, 0) == count:
                status[key] = "APPLIED"
            else:
                status[key] = "NOT_FOUND_IN_COPY"
        problems = sum(1 for s in status.values() if s != "APPLIED")
        if problems:
            collector.warning("{0} repaired value(s) could not be applied to the copy; see the "
                              "STATUS column of the repair log.".format(problems))
        return status


