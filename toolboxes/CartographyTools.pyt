# ==========================================================================
# common/errors.py
# ==========================================================================
# Error type used by every tool: a failure always states its cause and its fix.

class ToolError(Exception):
    """A user-facing failure.

    ``cause`` says what went wrong, ``fix`` says what the user can do about it.
    ``str(err)`` gives one readable sentence pair suitable for ``arcpy.AddError``.
    """

    def __init__(self, cause, fix=None):
        Exception.__init__(self, cause)
        self.cause = cause
        self.fix = fix

    def __str__(self):
        if self.fix:
            return "{0} Fix: {1}".format(self.cause, self.fix)
        return str(self.cause)


# ==========================================================================
# common/numeric.py
# ==========================================================================
# Numbers as ArcGIS stores them: single-precision (FLOAT) values.
#
# FLOAT fields hold 32-bit floats (fieldtypes.html), so a value typed as 0.1
# reads back from a cursor as 0.10000000149011612. Comparing that with the text
# "0.1" or with a DOUBLE 0.1 fails although the user sees the same number.
#
# * ``float32_shortest(value)``: the shortest decimal float that rounds to the
#   same 32-bit value (0.10000000149011612 -> 0.1); non-floats unchanged.
# * ``float32_equal(a, b)``: True when two numbers are the same 32-bit float.
# * ``is_single_field(field)``: True for a FLOAT field dict (``Field.type`` "Single").
# * ``exact_number(value)``: a number for comparisons and dictionary keys that
#   keeps integers exact (BigInteger values above 2**53 stay distinct) while
#   1, 1.0 and "1" stay equal.
#
# Pure Python (``struct``), no arcpy. Shared by every toolbox: reuse these
# instead of adding another copy.

_NUMERIC_SINGLE_TYPES = frozenset(["single", "float"])
# Integer text as ArcGIS writes it: ASCII digits only, optional sign.
_NUMERIC_INT_TEXT = re.compile(r"^[+-]?[0-9]+$")


def _numeric_pack(value):
    """4-byte single-precision form of ``value`` or ``None`` (overflow, not a number)."""
    try:
        return struct.pack("<f", value)
    except (OverflowError, struct.error, TypeError):
        return None


def float32_shortest(value):
    """Shortest decimal float with the same single-precision value as ``value``.

    Non-floats, NaN, infinities and values outside the single range are
    returned unchanged.
    """
    if not isinstance(value, float) or value != value or value in (float("inf"), float("-inf")):
        return value
    target = _numeric_pack(value)
    if target is None:
        return value
    for digits in range(1, 10):
        candidate = float("{0:.{1}g}".format(value, digits))
        if _numeric_pack(candidate) == target:
            return candidate
    return value


def float32_equal(a, b):
    """True if numbers ``a`` and ``b`` are the same single-precision value."""
    if isinstance(a, bool) or isinstance(b, bool):
        return False
    try:
        fa, fb = float(a), float(b)
    except (TypeError, ValueError):
        return False
    pa, pb = _numeric_pack(fa), _numeric_pack(fb)
    return pa is not None and pa == pb


def is_single_field(field):
    """True for a FLOAT (single-precision) field dict."""
    return str(field.get("type") or "").casefold() in _NUMERIC_SINGLE_TYPES


def exact_number(value):
    """``value`` as an exact number (``int`` or ``float``), or ``None``.

    ``float()`` loses the last digits of integers above 2**53 (BigInteger
    fields, 16+ digit identifiers), so two different keys or codes would
    compare equal. Integers stay ``int`` here, integer text ("0012",
    "9007199254740993") becomes ``int``, other numbers and numeric text become
    ``float``. Python's ``int`` and ``float`` compare and hash exactly, so 1,
    1.0 and "1" still give equal keys. NaN and values that are not numbers
    give ``None``.
    """
    if value is None:
        return None
    if isinstance(value, int):
        return int(value)  # bool -> 0 / 1, as float() gave
    if isinstance(value, float):
        return None if value != value else value
    if isinstance(value, str):
        text = value.strip()
        if _NUMERIC_INT_TEXT.match(text):
            try:
                return int(text)
            except ValueError:  # over Python's integer text limit
                return None
    try:
        number = float(value)
    except (TypeError, ValueError, OverflowError):
        return None
    return None if number != number else number


# ==========================================================================
# common/messages.py
# ==========================================================================
# Message collector so pure cores can report progress without importing arcpy.
#
# A core appends messages to a ``MessageCollector``; the tool adapter later sends
# them to ArcGIS Pro (see ``arcio.flush_messages``). Levels follow the toolkit
# rule: ``info`` for normal progress, ``warning`` only for things the user must
# act on, ``error`` only for real failure.

MESSAGE_INFO = "info"
MESSAGE_WARNING = "warning"
MESSAGE_ERROR = "error"


class MessageCollector(object):
    """Ordered list of ``(level, text)`` pairs."""

    def __init__(self):
        self.items = []

    def info(self, text):
        self.items.append((MESSAGE_INFO, str(text)))

    def warning(self, text):
        self.items.append((MESSAGE_WARNING, str(text)))

    def error(self, text):
        self.items.append((MESSAGE_ERROR, str(text)))

    def extend(self, other):
        """Append all messages of another collector, keeping their order."""
        self.items.extend(other.items)

    def texts(self, level=None):
        """Message texts, optionally only those of one level."""
        return [t for (lvl, t) in self.items if level is None or lvl == level]

    def has_errors(self):
        return any(lvl == MESSAGE_ERROR for (lvl, _t) in self.items)

    def counts(self):
        """Number of messages per level, e.g. ``{"info": 3, "warning": 1, "error": 0}``."""
        result = {MESSAGE_INFO: 0, MESSAGE_WARNING: 0, MESSAGE_ERROR: 0}
        for lvl, _t in self.items:
            result[lvl] = result.get(lvl, 0) + 1
        return result

    def clear(self):
        self.items = []

    def __len__(self):
        return len(self.items)


# ==========================================================================
# common/text.py
# ==========================================================================
# Text normalisation, placeholder detection, scripts, edit distance, natural sort.
#
# Pure Python (stdlib only). Every character set is a fixed, documented constant
# so results never depend on the Python or Unicode database version for the
# characters that matter here.
#
# Main entry points:
#
# * ``to_nfc(text)``: Unicode canonical composition (NFC). ``normalize_text``
#   and ``arabic_normalize`` always apply it first, so a decomposed spelling
#   (macOS export, PDF copy: "u" + combining diaeresis, Arabic yeh + combining
#   hamza) gets the same result as the precomposed one.
# * ``normalize_text(value, ...)``: options-driven cleaning (whitespace,
#   invisible marks, control characters, digits, case, Arabic folding).
# * ``arabic_normalize(text, ...)``: Arabic-aware folding (tashkeel, tatweel,
#   alef forms, alef maqsura / teh marbuta options, Persian letters, digits).
# * ``is_placeholder(value, ...)``: "N/A", "-", "null", "none", "0000" ...
# * ``script_of(text)`` / ``script_profile(text)``: Arabic / Latin / mixed / digits.
# * ``levenshtein`` / ``damerau_levenshtein``: bounded edit distances.
# * ``natural_sort_key``: "Lot 2" before "Lot 10".
#
# ``None`` is passed through unchanged by every normaliser (a null is not an
# empty string; callers decide how to report it).

# --------------------------------------------------------------------------
# Character sets (fixed lists)
# --------------------------------------------------------------------------

# Whitespace that is folded to an ordinary space: ASCII space and tab, NBSP,
# U+1680, U+2000-U+200A, U+202F, U+205F, U+3000. Line breaks are separate.
TEXT_SPACES = frozenset(
    [u" ", u"\u0009", u" ", u" ", u" ", u" ", u"　"]
    + [chr(c) for c in range(0x2000, 0x200B)])

# Line breaks: LF, CR, VT, FF, NEL, LINE SEPARATOR, PARAGRAPH SEPARATOR.
TEXT_LINE_BREAKS = frozenset([u"\n", u"\r", u"\x0b", u"\x0c", u"\x85", u" ", u" "])

# Invisible format characters removed by ``remove_invisible``: zero width
# space, BOM / zero width no-break space, word joiner, soft hyphen, LRM, RLM,
# Arabic letter mark, bidi embeddings/overrides (U+202A-202E) and isolates
# (U+2066-2069).
TEXT_INVISIBLE = frozenset(
    [u"​", u"﻿", u"⁠", u"­", u"‎", u"‏", u"؜"]
    + [chr(c) for c in range(0x202A, 0x202F)]
    + [chr(c) for c in range(0x2066, 0x206A)])

# Zero width non-joiner / joiner. They change Arabic and Persian shaping, so
# they are removed only when asked (``joiners=True``).
TEXT_JOINERS = frozenset([u"‌", u"‍"])

# Arabic harakat / tashkeel: U+064B-U+065F, superscript alef U+0670,
# Quranic marks U+06D6-U+06ED (excluding U+06DD/U+06DE symbols) and U+0610-061A.
TEXT_ARABIC_TASHKEEL = frozenset(
    [chr(c) for c in range(0x064B, 0x0660)] + [u"ٰ"]
    + [chr(c) for c in range(0x0610, 0x061B)]
    + [chr(c) for c in range(0x06D6, 0x06EE) if c not in (0x06DD, 0x06DE, 0x06E5, 0x06E6)])
TEXT_ARABIC_TATWEEL = u"ـ"

# Alef with madda / hamza above / hamza below / wasla -> bare alef.
TEXT_ALEF_FORMS = {u"آ": u"ا", u"أ": u"ا", u"إ": u"ا",
                   u"ٱ": u"ا"}
TEXT_ALEF_MAQSURA = {u"ى": u"ي"}      # alef maqsura -> yeh
TEXT_TEH_MARBUTA = {u"ة": u"ه"}       # teh marbuta -> heh
# Persian / Urdu letters -> Arabic equivalents (keheh -> kaf, farsi yeh -> yeh).
TEXT_PERSIAN_LETTERS = {u"ک": u"ك", u"ی": u"ي"}

# Arabic-Indic (U+0660-0669) and extended / Persian (U+06F0-06F9) digits -> ASCII.
TEXT_DIGIT_MAP = dict([(chr(0x0660 + i), str(i)) for i in range(10)]
                      + [(chr(0x06F0 + i), str(i)) for i in range(10)])
# Arabic decimal separator and thousands separator (only with separators=True).
TEXT_ARABIC_SEPARATORS = {u"٫": u".", u"٬": u","}

# Default placeholder spellings (compared after trim, whitespace collapse and
# casefold). All-zero strings are handled separately (``zero_run``).
TEXT_DEFAULT_PLACEHOLDERS = frozenset([
    u"n/a", u"n.a.", u"na", u"n\\a", u"-", u"--", u"---", u"null", u"<null>", u"none",
    u"nil", u"?", u"??", u".", u"unknown", u"tbd", u"#n/a", u"x"])


# --------------------------------------------------------------------------
# Small building blocks
# --------------------------------------------------------------------------

def collapse_whitespace(text, keep_line_breaks=False):
    """Fold every ``TEXT_SPACES`` character (and line breaks, unless
    ``keep_line_breaks``) to one space, collapse runs and trim the ends."""
    if text is None:
        return None
    out = []
    pending = False
    for ch in text:
        if ch in TEXT_SPACES or (not keep_line_breaks and ch in TEXT_LINE_BREAKS):
            pending = True
            continue
        if ch in TEXT_LINE_BREAKS:
            # keep the break itself; drop spaces around it
            out.append(ch)
            pending = False
            continue
        if pending and out and out[-1] not in TEXT_LINE_BREAKS:
            out.append(u" ")
        pending = False
        out.append(ch)
    return u"".join(out).strip(u" ")


def has_line_breaks(text):
    """True if ``text`` contains any ``TEXT_LINE_BREAKS`` character."""
    return bool(text) and any(ch in TEXT_LINE_BREAKS for ch in text)


def is_control_char(ch):
    """True for C0/C1 control characters other than line breaks and tab."""
    if ch in TEXT_LINE_BREAKS or ch == u"\t":
        return False
    return unicodedata.category(ch) == "Cc"


def has_control_chars(text):
    """True if ``text`` contains a control character (see ``is_control_char``)."""
    return bool(text) and any(is_control_char(ch) for ch in text)


def strip_control_chars(text, line_breaks=False):
    """Remove control characters; with ``line_breaks=True`` also line breaks and tabs."""
    if text is None:
        return None
    return u"".join(ch for ch in text if not is_control_char(ch)
                    and not (line_breaks and (ch in TEXT_LINE_BREAKS or ch == u"\t")))


def remove_invisible(text, joiners=False):
    """Remove ``TEXT_INVISIBLE`` marks (and ZWNJ/ZWJ when ``joiners``)."""
    if text is None:
        return None
    return u"".join(ch for ch in text if ch not in TEXT_INVISIBLE
                    and not (joiners and ch in TEXT_JOINERS))


def has_invisible(text, joiners=True):
    """True if ``text`` contains an invisible mark (ZWNJ/ZWJ count unless ``joiners=False``)."""
    return bool(text) and any(ch in TEXT_INVISIBLE or (joiners and ch in TEXT_JOINERS)
                              for ch in text)


def fold_digits(text, separators=False):
    """Arabic-Indic and Persian digits -> ASCII; with ``separators`` also
    U+066B -> "." and U+066C -> ","."""
    if text is None:
        return None
    out = []
    for ch in text:
        if ch in TEXT_DIGIT_MAP:
            out.append(TEXT_DIGIT_MAP[ch])
        elif separators and ch in TEXT_ARABIC_SEPARATORS:
            out.append(TEXT_ARABIC_SEPARATORS[ch])
        else:
            out.append(ch)
    return u"".join(out)


def to_nfc(text):
    """Unicode canonical composition (NFC) of a text; anything else (``None``,
    numbers, dates) is returned unchanged.

    Canonically equivalent spellings look identical and must compare equal:
    "u" + U+0308 becomes U+00FC, Arabic yeh + combining hamza above
    (U+064A U+0654) becomes U+0626. Only canonical equivalence is applied
    (not NFKC), so ligatures, superscripts and full-width forms are kept.
    """
    if isinstance(text, str):
        return unicodedata.normalize("NFC", text)
    return text


def _text_is_presentation_form(ch):
    c = ord(ch)
    return (0xFB50 <= c <= 0xFDFF) or (0xFE70 <= c <= 0xFEFE)


def _text_presentation_nfkc(ch):
    """NFKC of one presentation form. The isolated tashkeel forms (U+FE70-FE7E) and the
    shadda ligatures (U+FC5E-FC63) decompose into SPACE + mark(s); the space only carries
    the sign, so it is dropped (otherwise removing the mark as tashkeel leaves a space)."""
    comp = unicodedata.normalize("NFKC", ch)
    if len(comp) > 1 and comp[0] == u" " and all(unicodedata.combining(c) for c in comp[1:]):
        return comp[1:]
    return comp


def arabic_normalize(text, tashkeel=True, tatweel=True, alef=True, alef_maqsura=True,
                     teh_marbuta=False, persian=True, digits=True, presentation=True,
                     marks=True):
    """Arabic-aware folding; each step is an option.

    Unicode NFC is always applied first (``to_nfc``): without it a combining
    hamza (U+0654) of a decomposed spelling would be removed as tashkeel,
    while its precomposed equivalent U+0626 is kept.

    * ``presentation``: Arabic presentation forms (U+FB50-FDFF, U+FE70-FEFE)
      are decomposed with NFKC, applied to those code points only;
    * ``tashkeel``: remove ``TEXT_ARABIC_TASHKEEL``; ``tatweel``: remove U+0640;
    * ``alef``: U+0622/0623/0625/0671 -> U+0627;
    * ``alef_maqsura``: U+0649 -> U+064A (on by default);
    * ``teh_marbuta``: U+0629 -> U+0647 (off by default: it changes meaning);
    * ``persian``: U+06A9 -> U+0643, U+06CC -> U+064A;
    * ``digits``: Arabic-Indic / Persian digits -> ASCII;
    * ``marks``: remove invisible marks including ZWNJ/ZWJ, LRM/RLM, ALM.
    """
    if text is None:
        return None
    text = to_nfc(text)
    if presentation:
        text = u"".join(_text_presentation_nfkc(ch) if _text_is_presentation_form(ch) else ch
                        for ch in text)
    out = []
    for ch in text:
        if tashkeel and ch in TEXT_ARABIC_TASHKEEL:
            continue
        if tatweel and ch == TEXT_ARABIC_TATWEEL:
            continue
        if marks and (ch in TEXT_INVISIBLE or ch in TEXT_JOINERS):
            continue
        if alef and ch in TEXT_ALEF_FORMS:
            ch = TEXT_ALEF_FORMS[ch]
        elif alef_maqsura and ch in TEXT_ALEF_MAQSURA:
            ch = TEXT_ALEF_MAQSURA[ch]
        elif teh_marbuta and ch in TEXT_TEH_MARBUTA:
            ch = TEXT_TEH_MARBUTA[ch]
        elif persian and ch in TEXT_PERSIAN_LETTERS:
            ch = TEXT_PERSIAN_LETTERS[ch]
        elif digits and ch in TEXT_DIGIT_MAP:
            ch = TEXT_DIGIT_MAP[ch]
        out.append(ch)
    return u"".join(out)


def strip_leading_zeros(text):
    """``"007"`` -> ``"7"`` and ``"000"`` -> ``"0"`` for ASCII-digit-only strings;
    anything else is returned unchanged."""
    if text and text.isascii() and text.isdigit():
        return text.lstrip(u"0") or u"0"
    return text


def date_text(value):
    """ISO text of a date/time value; a datetime at exactly 00:00:00 is written as
    the date only ("2024-01-05"), so a DATE field value at midnight, a DATEONLY
    value and an ISO date typed as text give the same text. Other values: ``None``.
    """
    if isinstance(value, datetime.datetime):
        if value.time() == datetime.time(0, 0):
            return value.date().isoformat()
        return value.isoformat(" ")
    if isinstance(value, (datetime.date, datetime.time)):
        return value.isoformat()
    return None


def value_to_text(value):
    """Text form of a cell value for key comparison.

    ``None`` stays ``None``; integral floats lose ``.0`` (``1.0`` -> ``"1"``);
    other numbers use ``repr``-exact ``str``; bools become ``"True"``/``"False"``.
    """
    if value is None:
        return None
    if isinstance(value, bool):
        return str(value)
    if isinstance(value, float):
        if value != value or value in (float("inf"), float("-inf")):
            return str(value)
        if value == int(value):
            return str(int(value))
        return repr(value)
    if isinstance(value, bytes):
        return value.decode("utf-8", "replace")
    return value if isinstance(value, str) else str(value)


def normalize_text(value, trim=True, collapse=True, casefold=False, invisible=True,
                   controls=True, digits=True, leading_zeros=False, arabic=None):
    """Options-driven normalisation of one value (``None`` stays ``None``).

    Order: ``value_to_text`` -> Unicode NFC (always, ``to_nfc``) -> controls
    (removed, line breaks kept for ``collapse``) -> invisible marks -> Arabic (``arabic`` is ``None`` for
    off, ``True`` for defaults, or a dict of ``arabic_normalize`` options)
    -> digits -> whitespace (``collapse`` folds all spaces and line breaks
    to one space; else only ``trim``) -> casefold -> leading zeros.
    """
    text = value_to_text(value)
    if text is None:
        return None
    text = to_nfc(text)
    if controls:
        text = strip_control_chars(text)
    if invisible:
        text = remove_invisible(text)
    if arabic:
        text = arabic_normalize(text, **(arabic if isinstance(arabic, dict) else {}))
    if digits:
        text = fold_digits(text)
    if collapse:
        text = collapse_whitespace(text)
    elif trim:
        text = text.strip(u"".join(sorted(TEXT_SPACES | TEXT_LINE_BREAKS)))
    if casefold:
        text = text.casefold()
    if leading_zeros:
        text = strip_leading_zeros(text)
    return text


def is_blank(value):
    """True for ``None`` and for text that is empty after removing whitespace,
    line breaks and invisible marks."""
    if value is None:
        return True
    if not isinstance(value, str):
        return False
    return collapse_whitespace(remove_invisible(value, joiners=True)) == u""


def is_placeholder(value, placeholders=None, zero_run=3, blank=False):
    """True if ``value`` is a placeholder such as "N/A", "-", "null", "none".

    The value is compared after invisible-mark removal, digit folding,
    whitespace collapse and casefold with ``placeholders`` (an iterable of
    spellings, compared casefolded; default ``TEXT_DEFAULT_PLACEHOLDERS``).
    ``zero_run``: strings of at least this many zeros and nothing else
    ("000", "0000") count; ``None``/0 disables. ``blank``: empty/whitespace
    counts as a placeholder too (default False: report blanks separately).
    Non-text values (numbers, dates, ``None``) are never placeholders.
    """
    if not isinstance(value, str):
        return False
    text = collapse_whitespace(fold_digits(remove_invisible(value, joiners=True))).casefold()
    if text == u"":
        return bool(blank)
    pool = TEXT_DEFAULT_PLACEHOLDERS if placeholders is None else \
        frozenset(collapse_whitespace(str(p)).casefold() for p in placeholders)
    if text in pool:
        return True
    if zero_run and len(text) >= zero_run and text.strip(u"0") == u"":
        return True
    return False


# --------------------------------------------------------------------------
# Scripts
# --------------------------------------------------------------------------

SCRIPT_ARABIC = "arabic"
SCRIPT_LATIN = "latin"
SCRIPT_MIXED = "mixed"
SCRIPT_DIGITS = "digits"
SCRIPT_OTHER = "other"
SCRIPT_EMPTY = "empty"

_TEXT_ARABIC_BLOCKS = ((0x0600, 0x06FF), (0x0750, 0x077F), (0x08A0, 0x08FF),
                       (0xFB50, 0xFDFF), (0xFE70, 0xFEFF))


def _text_in_arabic_block(c):
    for lo, hi in _TEXT_ARABIC_BLOCKS:
        if lo <= c <= hi:
            return True
    return False


def script_profile(text):
    """Character counts: ``{"arabic", "latin", "other_letters", "ascii_digits",
    "arabic_digits", "other_digits", "other"}``.

    Letters are Unicode category L*; Arabic = letters in the Arabic blocks;
    Latin = letters whose Unicode name starts with "LATIN". Combining marks
    (tashkeel), spaces and punctuation count as "other".
    """
    counts = {"arabic": 0, "latin": 0, "other_letters": 0, "ascii_digits": 0,
              "arabic_digits": 0, "other_digits": 0, "other": 0}
    for ch in text or u"":
        cat = unicodedata.category(ch)
        c = ord(ch)
        if cat == "Nd":
            if u"0" <= ch <= u"9":
                counts["ascii_digits"] += 1
            elif ch in TEXT_DIGIT_MAP:
                counts["arabic_digits"] += 1
            else:
                counts["other_digits"] += 1
        elif cat.startswith("L"):
            if _text_in_arabic_block(c):
                counts["arabic"] += 1
            elif unicodedata.name(ch, "").startswith("LATIN"):
                counts["latin"] += 1
            else:
                counts["other_letters"] += 1
        else:
            counts["other"] += 1
    return counts


def script_of(text):
    """Dominant script of ``text``.

    ``"empty"`` (no letters or digits), ``"digits"`` (digits only, any
    script), ``"arabic"``, ``"latin"``, ``"other"`` (letters of one other
    script family) or ``"mixed"`` (letters of more than one of Arabic /
    Latin / other). Digits never make a text mixed.
    """
    p = script_profile(text)
    families = [k for k in ("arabic", "latin", "other_letters") if p[k]]
    if not families:
        if p["ascii_digits"] or p["arabic_digits"] or p["other_digits"]:
            return SCRIPT_DIGITS
        return SCRIPT_EMPTY
    if len(families) > 1:
        return SCRIPT_MIXED
    return {"arabic": SCRIPT_ARABIC, "latin": SCRIPT_LATIN,
            "other_letters": SCRIPT_OTHER}[families[0]]


def has_mixed_digits(text):
    """True if ``text`` mixes ASCII digits with Arabic-Indic/Persian digits."""
    p = script_profile(text)
    return bool(p["ascii_digits"] and p["arabic_digits"])


# --------------------------------------------------------------------------
# Edit distance
# --------------------------------------------------------------------------

def levenshtein(a, b, max_distance=None):
    """Levenshtein distance (insert, delete, substitute; each cost 1).

    With ``max_distance`` the computation stops early and returns
    ``max_distance + 1`` as soon as the distance is known to exceed it.
    ``None`` inputs are treated as empty strings.
    """
    a = a or u""
    b = b or u""
    if a == b:
        return 0
    if len(a) < len(b):
        a, b = b, a
    if max_distance is not None and len(a) - len(b) > max_distance:
        return max_distance + 1
    if not b:
        return len(a)
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i] + [0] * len(b)
        row_min = i
        for j, cb in enumerate(b, 1):
            cost = 0 if ca == cb else 1
            v = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            cur[j] = v
            if v < row_min:
                row_min = v
        if max_distance is not None and row_min > max_distance:
            return max_distance + 1
        prev = cur
    d = prev[-1]
    if max_distance is not None and d > max_distance:
        return max_distance + 1
    return d


def damerau_levenshtein(a, b, max_distance=None):
    """Optimal-string-alignment distance: Levenshtein plus transposition of
    two adjacent characters (cost 1). A substring is never edited twice, so
    ``("CA", "ABC")`` is 3 (the unrestricted Damerau distance would be 2).

    ``max_distance`` bounds as in ``levenshtein``.
    """
    a = a or u""
    b = b or u""
    if a == b:
        return 0
    if max_distance is not None and abs(len(a) - len(b)) > max_distance:
        return max_distance + 1
    if not a or not b:
        return max(len(a), len(b))
    n = len(b)
    two_back = None
    prev = list(range(n + 1))
    prev_min = 0
    for i in range(1, len(a) + 1):
        cur = [i] + [0] * n
        row_min = i
        for j in range(1, n + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            v = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            if (two_back is not None and j > 1 and a[i - 1] == b[j - 2]
                    and a[i - 2] == b[j - 1]):
                v = min(v, two_back[j - 2] + 1)
            cur[j] = v
            if v < row_min:
                row_min = v
        # Later cells come from this row or, by a transposition, from the
        # previous row plus 1: both minima bound the final distance.
        if max_distance is not None and min(row_min, prev_min + 1) > max_distance:
            return max_distance + 1
        two_back, prev, prev_min = prev, cur, row_min
    d = prev[-1]
    if max_distance is not None and d > max_distance:
        return max_distance + 1
    return d


# --------------------------------------------------------------------------
# Natural sort
# --------------------------------------------------------------------------

def natural_sort_key(value):
    """Sort key that orders digit runs numerically: "Lot 2" < "Lot 10".

    Digits are folded to ASCII first (Arabic-Indic digits sort as numbers),
    text chunks are compared casefolded, and the raw text is the last
    tie-break, so the order is total and deterministic ("7" < "007" < "07"
    is decided by the raw strings). ``None`` sorts before every text;
    non-text values are converted with ``value_to_text``. Signs and decimal
    points are not interpreted ("1.5" is 1, ".", 5).
    """
    if value is None:
        return (0, (), u"")
    raw = value_to_text(value)
    text = fold_digits(raw)
    chunks = []
    i = 0
    n = len(text)
    while i < n:
        j = i
        if text[i].isascii() and text[i].isdigit():
            while j < n and text[j].isascii() and text[j].isdigit():
                j += 1
            chunks.append((0, int(text[i:j]), u""))
        else:
            while j < n and not (text[j].isascii() and text[j].isdigit()):
                j += 1
            chunks.append((1, 0, text[i:j].casefold()))
        i = j
    return (1, tuple(chunks), raw)


# ==========================================================================
# common/issues.py
# ==========================================================================
# Unified QC issue schema and the adapters that fill it (pure Python, no arcpy).
#
# The QC Scorecard Report reads the Detail outputs of the toolkit's quality tools and
# turns every row into one *issue*, a plain dict with the keys of
# ``UNI_FIELDS`` (``RUN_ID`` is added by the caller)::
#
#     TOOL, RULE_ID, SOURCE, SRC_OID, SEVERITY, X, Y, MESSAGE, FIELD, VALUE
#
# There is **one adapter function per tool**; none of the tools is changed. The column
# names an adapter expects are the REAL names ArcGIS Pro wrote in the captured
# outputs (``tests/fixtures/pro/<Tool>/<case>/``), not names taken from documents:
#
# =========================  =======================================================
# GeometryQualityChecker     SRC_OID, CHECK, PART, VERTEX, VALUE, UNIT, DETAIL
#                            (point feature class; location = the point)
# DomainConformanceAudit     SRC_TABLE, SRC_OID, FIELD, SUBTYPE_CODE, DOMAIN, VALUE,
#                            ISSUE, SUGGESTED (table: no location of its own)
# LineNetworkRules           RULE, LAYER, SRC_OID, NODE_ID, DEGREE, VALUE, DETAIL
#                            (point feature class; location = the point)
# unified table              RULE_ID, SEVERITY, MESSAGE and SRC_OID (or OID); optional
#                            RUN_ID, TOOL, SOURCE, X, Y, FIELD, VALUE
# =========================  =======================================================
#
# A row given to an adapter is a dict ``{column name: value}`` plus the special keys
# ``"_xy"`` (``(x, y)`` taken from the row's geometry, or ``None``). Columns an
# adapter does not know are not lost: they are appended to MESSAGE as ``NAME=value``.
#
# The tools write no severity. ``UNI_SEVERITY_BY_RULE`` is this toolkit's own default
# classification (a judgement, not a standard); the Atlas lets a threshold table
# override it per rule.

UNI_TOOL_GEOMETRY = "GeometryQualityChecker"
UNI_TOOL_DOMAIN = "DomainConformanceAudit"
UNI_TOOL_NETWORK = "LineNetworkRules"
UNI_TOOL_UNIFIED = "UNIFIED"
UNI_TOOLS = (UNI_TOOL_GEOMETRY, UNI_TOOL_DOMAIN, UNI_TOOL_NETWORK, UNI_TOOL_UNIFIED)
UNI_TOOL_AUTO = "AUTO"

UNI_ERROR = "ERROR"
UNI_WARNING = "WARNING"
UNI_INFO = "INFO"
UNI_SEVERITIES = (UNI_ERROR, UNI_WARNING, UNI_INFO)

# Column order of the unified issue table. The handoff calls the object id column OID;
# the toolkit's own outputs all call it SRC_OID and OID is not used as a field name here.
UNI_FIELDS = ("RUN_ID", "TOOL", "RULE_ID", "SOURCE", "SRC_OID", "SEVERITY", "X", "Y",
              "MESSAGE", "FIELD", "VALUE")

UNI_MESSAGE_MAX = 1000   # characters kept in MESSAGE
UNI_VALUE_MAX = 254      # characters kept in VALUE / FIELD / SOURCE / RULE_ID

# Default severity per rule (the tools write none). Unknown rules: UNI_DEFAULT_SEVERITY.
UNI_DEFAULT_SEVERITY = UNI_WARNING
UNI_SEVERITY_BY_RULE = {
    # GeometryQualityChecker
    "SPIKE": UNI_ERROR,
    "NEAR_DUP_VERTEX": UNI_ERROR,
    "SHORT_SEGMENT": UNI_WARNING,
    "SLIVER": UNI_WARNING,
    "TINY_AREA": UNI_WARNING,
    "TINY_PART": UNI_WARNING,
    "REMOTE_PART": UNI_WARNING,
    # DomainConformanceAudit: the stored value is not a valid code of its domain
    "OUT_OF_DOMAIN": UNI_ERROR,
    "OUT_OF_RANGE": UNI_ERROR,
    "DESCRIPTION_AS_CODE": UNI_ERROR,
    "CASE_OR_SPACE_VARIANT": UNI_ERROR,
    "AMBIGUOUS_DESCRIPTION": UNI_ERROR,
    "INVALID_SUBTYPE": UNI_ERROR,
    "NULL_VALUE": UNI_WARNING,
    # LineNetworkRules
    "DANGLE": UNI_ERROR,
    "PSEUDO_NODE": UNI_WARNING,
    "T_MISS": UNI_ERROR,
    "WIDE_NODE_CLUSTER": UNI_WARNING,
    "POINT_NOT_ON_LINE": UNI_ERROR,
    "POINT_NOT_ON_ENDPOINT": UNI_ERROR,
}

# Columns that belong to the table itself, never to the issue.
_UNI_SYSTEM_COLUMNS = frozenset(["OBJECTID", "FID", "SHAPE", "SHAPE_LENGTH", "SHAPE_AREA",
                                 "SHAPE_LEN", "GLOBALID", "OID@", "SHAPE@", "SHAPE@JSON"])

# Required columns (upper case) per tool; a table is recognised as the first whose
# required columns are all present (unified first, then the others).
_UNI_REQUIRED = (
    (UNI_TOOL_UNIFIED, ("RULE_ID", "SEVERITY", "MESSAGE")),
    (UNI_TOOL_GEOMETRY, ("SRC_OID", "CHECK", "DETAIL")),
    (UNI_TOOL_DOMAIN, ("SRC_TABLE", "SRC_OID", "FIELD", "DOMAIN", "VALUE", "ISSUE")),
    (UNI_TOOL_NETWORK, ("RULE", "LAYER", "SRC_OID", "DETAIL")),
)
# Known (consumed) columns per tool; everything else goes to MESSAGE.
_UNI_KNOWN = {
    UNI_TOOL_GEOMETRY: ("SRC_OID", "CHECK", "PART", "VERTEX", "VALUE", "UNIT", "DETAIL"),
    UNI_TOOL_DOMAIN: ("SRC_TABLE", "SRC_OID", "FIELD", "SUBTYPE_CODE", "DOMAIN", "VALUE",
                      "ISSUE", "SUGGESTED"),
    UNI_TOOL_NETWORK: ("RULE", "LAYER", "SRC_OID", "NODE_ID", "DEGREE", "VALUE", "DETAIL"),
    UNI_TOOL_UNIFIED: ("RUN_ID", "TOOL", "RULE_ID", "SOURCE", "SRC_OID", "OID", "SEVERITY",
                       "X", "Y", "MESSAGE", "FIELD", "VALUE"),
}
# The hygiene table of DomainConformanceAudit (out_domain_table) is a different output.
_UNI_DOMAIN_HYGIENE = ("DOMAIN", "RECORD_TYPE", "ISSUE")


def uni_clean_text(value, limit=None):
    """Text for a table or an HTML page: ``None`` stays ``None``; control characters
    (except tab and line breaks, which become spaces) are removed; the text is cut to
    ``limit`` characters with an ellipsis."""
    if value is None:
        return None
    if isinstance(value, float):
        text = uni_format_number(value)
    else:
        text = str(value)
    out = []
    for ch in text:
        if ch in "\t\r\n":
            out.append(" ")
        elif ord(ch) < 32 or ord(ch) in (127, 0xFFFE, 0xFFFF) or 0xD800 <= ord(ch) <= 0xDFFF:
            continue
        else:
            out.append(ch)
    text = "".join(out).strip()
    if limit is not None and len(text) > limit:
        text = text[:max(limit - 3, 0)] + "..."
    return text


def uni_format_number(value):
    """Short text of a number (6 significant digits); other values as text."""
    if isinstance(value, bool):
        return str(value)
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        if math.isnan(value) or math.isinf(value):
            return ""
        return "{0:.6g}".format(value)
    return str(value)


def uni_normalise_severity(value, default=UNI_DEFAULT_SEVERITY):
    """``ERROR`` / ``WARNING`` / ``INFO`` from any capitalisation (``WARN`` too);
    ``(severity, recognised)`` where ``recognised`` is False when ``default`` was used."""
    text = str(value).strip().upper() if value is not None else ""
    aliases = {"ERR": UNI_ERROR, "CRITICAL": UNI_ERROR, "WARN": UNI_WARNING,
               "INFORMATION": UNI_INFO, "NOTE": UNI_INFO}
    text = aliases.get(text, text)
    if text in UNI_SEVERITIES:
        return text, True
    return default, False


def uni_severity_for(rule_id):
    """Default severity of a rule id (``UNI_DEFAULT_SEVERITY`` for an unknown rule)."""
    return UNI_SEVERITY_BY_RULE.get(str(rule_id).strip().upper(), UNI_DEFAULT_SEVERITY)


def _uni_upper_row(row):
    """``{UPPER NAME: value}`` of the attribute columns of a row (special keys dropped)."""
    return dict((str(k).upper(), v) for k, v in row.items() if not str(k).startswith("_"))


def uni_detect_tool(columns):
    """Which tool's Detail output (or the unified schema) a table with these column
    names is; ``None`` when none matches. Names are compared in upper case."""
    names = set(str(c).upper() for c in columns)
    if "OID" in names and "SRC_OID" not in names:
        names.add("SRC_OID")   # the unified schema as the handoff spells it
    for tool, required in _UNI_REQUIRED:
        if all(name in names for name in required):
            return tool
    return None


def uni_missing_columns(tool, columns):
    """Required columns (upper case) of ``tool`` that a table with ``columns`` lacks."""
    names = set(str(c).upper() for c in columns)
    if "OID" in names and "SRC_OID" not in names:
        names.add("SRC_OID")
    for name, required in _UNI_REQUIRED:
        if name == tool:
            return [c for c in required if c not in names]
    return []


def uni_is_domain_hygiene_table(columns):
    """True for the usage / hygiene table of DomainConformanceAudit (not an issue table)."""
    names = set(str(c).upper() for c in columns)
    return all(name in names for name in _UNI_DOMAIN_HYGIENE) and "SRC_OID" not in names


def uni_describe_columns_needed():
    """Text for an error message: the columns each supported table must have."""
    parts = []
    for tool, required in _UNI_REQUIRED:
        parts.append("{0}: {1}".format("unified issue table" if tool == UNI_TOOL_UNIFIED else tool,
                                       ", ".join(required)))
    return "; ".join(parts)


def _uni_extras(upper_row, tool):
    """Text ``NAME=value`` of the columns the adapter does not know (empty values skipped)."""
    known = set(_UNI_KNOWN[tool])
    parts = []
    for name in sorted(upper_row):
        if name in known or name in _UNI_SYSTEM_COLUMNS:
            continue
        value = upper_row[name]
        if value is None or (isinstance(value, str) and not value.strip()):
            continue
        parts.append("{0}={1}".format(name, uni_clean_text(value, 80)))
    return "; ".join(parts)


def _uni_message(text, extras, rule_id):
    text = uni_clean_text(text) or ""
    if not text:
        text = str(rule_id)
    if extras:
        text = "{0} [{1}]".format(text, extras)
    return uni_clean_text(text, UNI_MESSAGE_MAX)


def _uni_xy(row):
    xy = row.get("_xy")
    if xy is None:
        return None, None
    try:
        x, y = float(xy[0]), float(xy[1])
    except (TypeError, ValueError, IndexError):
        return None, None
    if math.isnan(x) or math.isnan(y) or math.isinf(x) or math.isinf(y):
        return None, None
    return x, y


def _uni_int(value):
    try:
        if value is None or (isinstance(value, str) and not value.strip()):
            return None
        if isinstance(value, int) and not isinstance(value, bool):
            return value
        if isinstance(value, str):
            try:
                # a text ObjectID field (``arcio.oid_field_spec`` in a folder) keeps every digit;
                # float() would round ids of more than 15 digits
                return int(value.strip())
            except ValueError:
                pass
        return int(float(value))
    except (TypeError, ValueError, OverflowError):
        return None


def _uni_issue(tool, rule_id, source, oid, severity, x, y, message, field, value,
               sev_from="default"):
    """One issue. ``_sev_from`` says where the severity came from: ``default`` (the toolkit's
    default for the rule; the source tools write none), ``table`` (a unified table's own
    SEVERITY column) or ``guess`` (an unrecognised value, taken as WARNING)."""
    return {"_sev_from": sev_from, "TOOL": tool,
            "RULE_ID": uni_clean_text(rule_id, UNI_VALUE_MAX) or "UNKNOWN",
            "SOURCE": uni_clean_text(source, UNI_VALUE_MAX),
            "SRC_OID": oid, "SEVERITY": severity, "X": x, "Y": y,
            "MESSAGE": message,
            "FIELD": uni_clean_text(field, UNI_VALUE_MAX),
            "VALUE": uni_clean_text(value, UNI_VALUE_MAX)}


def adapt_geometry_quality(rows, source=None):
    """GeometryQualityChecker ``out_features`` rows -> issues.

    RULE_ID = CHECK; SOURCE = ``source`` (the checked dataset; the tool's output carries no
    dataset name); SRC_OID = SRC_OID; X, Y = the error point; MESSAGE = DETAIL;
    VALUE = VALUE + UNIT (for example ``2.29153 deg``). PART and VERTEX are only in DETAIL.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("CHECK")
        severity = uni_severity_for(rule)
        x, y = _uni_xy(row)
        value = r.get("VALUE")
        value_text = None
        if value is not None and uni_format_number(value) != "":
            value_text = uni_format_number(value)
            if r.get("UNIT"):
                value_text += " " + str(r["UNIT"])
        message = _uni_message(r.get("DETAIL"), _uni_extras(r, UNI_TOOL_GEOMETRY), rule)
        out.append(_uni_issue(UNI_TOOL_GEOMETRY, rule, source, _uni_int(r.get("SRC_OID")),
                              severity, x, y, message, None, value_text))
    return out


_UNI_DOMAIN_TEXT = {
    "OUT_OF_DOMAIN": "is not a code of domain {domain}",
    "OUT_OF_RANGE": "is outside the range of domain {domain}",
    "DESCRIPTION_AS_CODE": "is the description of a code of domain {domain}, not the code",
    "CASE_OR_SPACE_VARIANT": "differs from a code of domain {domain} only by case or spaces",
    "AMBIGUOUS_DESCRIPTION": "matches more than one description of domain {domain}",
    "INVALID_SUBTYPE": "is not a defined subtype",
    "NULL_VALUE": "is empty although domain {domain} applies",
}


def adapt_domain_conformance(rows, source=None):
    """DomainConformanceAudit ``out_table`` rows (violations) -> issues.

    RULE_ID = ISSUE; SOURCE = SRC_TABLE (``source`` only when that is empty); SRC_OID = SRC_OID;
    FIELD = FIELD; VALUE = VALUE; MESSAGE is built from the columns (field, value, domain,
    subtype, suggestion). The table has no geometry, so X and Y are empty unless the caller
    locates the feature later (``QcScorecardAtlas`` does, from the checked dataset).
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("ISSUE")
        field = r.get("FIELD")
        value = r.get("VALUE")
        domain = r.get("DOMAIN")
        template = _UNI_DOMAIN_TEXT.get(str(rule).strip().upper() if rule is not None else "",
                                        "has the issue " + str(rule))
        shown = "empty" if value is None else "'{0}'".format(uni_clean_text(value, 120))
        text = "Field {0}: value {1} {2}".format(field, shown,
                                                 template.format(domain=domain or "(none)"))
        if r.get("SUBTYPE_CODE") is not None and uni_format_number(r["SUBTYPE_CODE"]) != "":
            text += " (subtype {0})".format(uni_format_number(r["SUBTYPE_CODE"]))
        if r.get("SUGGESTED") not in (None, ""):
            text += "; suggested: {0}".format(uni_clean_text(r["SUGGESTED"], 80))
        message = _uni_message(text + ".", _uni_extras(r, UNI_TOOL_DOMAIN), rule)
        table = r.get("SRC_TABLE")
        x, y = _uni_xy(row)
        out.append(_uni_issue(UNI_TOOL_DOMAIN, rule, table if table not in (None, "") else source,
                              _uni_int(r.get("SRC_OID")), uni_severity_for(rule), x, y, message,
                              field, value))
    return out


def adapt_line_network_rules(rows, source=None):
    """LineNetworkRules ``out_errors`` rows -> issues.

    RULE_ID = RULE; SOURCE = LAYER (``source`` only when that is empty; point-rule rows name
    the rule-point layer); SRC_OID = SRC_OID; X, Y = the error point; MESSAGE = DETAIL;
    VALUE = VALUE (metres) when present. NODE_ID and DEGREE are not carried.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("RULE")
        x, y = _uni_xy(row)
        value = r.get("VALUE")
        value_text = None
        if value is not None and uni_format_number(value) != "":
            value_text = uni_format_number(value) + " m"
        layer = r.get("LAYER")
        message = _uni_message(r.get("DETAIL"), _uni_extras(r, UNI_TOOL_NETWORK), rule)
        out.append(_uni_issue(UNI_TOOL_NETWORK, rule, layer if layer not in (None, "") else source,
                              _uni_int(r.get("SRC_OID")), uni_severity_for(rule), x, y, message,
                              None, value_text))
    return out


def adapt_unified(rows, source=None):
    """Rows already in the unified schema -> issues.

    SEVERITY is normalised (an unrecognised one becomes WARNING and the issue gets
    ``"_severity_guess": True``). X and Y come from the columns X and Y, else from the row's
    geometry. TOOL defaults to ``UNIFIED``; SOURCE to ``source``. RUN_ID is not carried.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("RULE_ID")
        severity, recognised = uni_normalise_severity(r.get("SEVERITY"))
        x, y = None, None
        try:
            if r.get("X") is not None and r.get("Y") is not None:
                x, y = float(r["X"]), float(r["Y"])
                if math.isnan(x) or math.isnan(y) or math.isinf(x) or math.isinf(y):
                    x, y = None, None
        except (TypeError, ValueError):
            x, y = None, None
        if x is None:
            x, y = _uni_xy(row)
        oid = _uni_int(r.get("SRC_OID") if r.get("SRC_OID") is not None else r.get("OID"))
        tool = uni_clean_text(r.get("TOOL"), UNI_VALUE_MAX) or UNI_TOOL_UNIFIED
        extras = _uni_extras(r, UNI_TOOL_UNIFIED)
        message = _uni_message(r.get("MESSAGE"), extras, rule)
        src = r.get("SOURCE")
        issue = _uni_issue(tool, rule, src if src not in (None, "") else source, oid, severity,
                           x, y, message, r.get("FIELD"), r.get("VALUE"),
                           "table" if recognised else "guess")
        if not recognised:
            issue["_severity_guess"] = True
        out.append(issue)
    return out


UNI_ADAPTERS = {UNI_TOOL_GEOMETRY: adapt_geometry_quality,
                UNI_TOOL_DOMAIN: adapt_domain_conformance,
                UNI_TOOL_NETWORK: adapt_line_network_rules,
                UNI_TOOL_UNIFIED: adapt_unified}


def uni_adapt(tool, rows, source=None):
    """Issues of ``rows`` with the adapter of ``tool`` (one of ``UNI_TOOLS``)."""
    return UNI_ADAPTERS[tool](rows, source)


def uni_issue_row(issue, run_id):
    """Values of one issue in ``UNI_FIELDS`` order (for the output table)."""
    values = dict(issue)
    values["RUN_ID"] = run_id
    return [values.get(name) for name in UNI_FIELDS]


# ==========================================================================
# common/fields.py
# ==========================================================================
# Field lookup that tolerates the way people actually type field names.
#
# Rule (toolkit engineering rule 1): match the **alias first, then the name**,
# ignoring case, spaces, dashes and underscores. The caller is told which one
# matched so it can report it. Two or more candidates is an error that lists them;
# the tool never guesses.
#
# Fields are plain dicts as returned by ``arcio.describe_dataset``::
#
#     {"name": "NAME_EN", "alias": "Name (English)", "type": "String",
#      "length": 50, "domain": None, ...}

# Characters ignored when comparing field names (besides all Unicode whitespace).
_FIELDS_IGNORED = frozenset("-_‐‑‒–—ـ")  # dashes, underscore, Arabic tatweel

MATCHED_BY_ALIAS = "alias"
MATCHED_BY_NAME = "name"


def normalize_field_name(text):
    """Comparison key for a field name or alias.

    NFKC-normalises (so Arabic presentation forms and full-width Latin compare
    equal to their plain forms), case-folds, and drops whitespace, dashes,
    underscores and the Arabic tatweel.
    """
    if text is None:
        return ""
    text = unicodedata.normalize("NFKC", str(text)).casefold()
    return "".join(ch for ch in text if not ch.isspace() and ch not in _FIELDS_IGNORED)


def describe_field(field):
    """Human readable ``NAME (alias: Alias)`` label for messages."""
    alias = field.get("alias")
    if alias and alias != field["name"]:
        return "{0} (alias: {1})".format(field["name"], alias)
    return field["name"]


def match_field(fields, wanted, required=True, label=None, exact_name_first=False):
    """Find the field the user means by ``wanted``.

    Returns ``(field, matched_by)`` where ``matched_by`` is ``"alias"`` or
    ``"name"``; returns ``(None, None)`` when nothing matches and ``required``
    is False. Raises ``ToolError`` for an ambiguous match, or for no match when
    ``required`` is True. ``label`` names the parameter in messages.

    ``exact_name_first``: use it when ``wanted`` comes from a ``Field``
    parameter (a field *name* picked from the list). A field whose name equals
    ``wanted`` exactly (then ignoring case only) wins before any alias, so a
    different field that merely carries that text as its alias is never used.
    Rule 1 (alias first, tolerant comparison) still applies when nothing has
    that exact name, e.g. for typed or configured names.
    """
    if exact_name_first and wanted:
        for same in (lambda n: n == wanted, lambda n: n.casefold() == str(wanted).casefold()):
            hits = [f for f in fields if f.get("name") is not None and same(f["name"])]
            if len(hits) == 1:
                return hits[0], MATCHED_BY_NAME
    key = normalize_field_name(wanted)
    what = label or "field"
    if not key:
        if required:
            raise ToolError("No {0} was given.".format(what),
                            "Choose a field from the list.")
        return None, None

    for matched_by, attr in ((MATCHED_BY_ALIAS, "alias"), (MATCHED_BY_NAME, "name")):
        hits = [f for f in fields if normalize_field_name(f.get(attr)) == key]
        if len(hits) == 1:
            return hits[0], matched_by
        if len(hits) > 1:
            raise ToolError(
                "The {0} '{1}' is ambiguous: it matches the {2} of {3} fields: {4}.".format(
                    what, wanted, attr, len(hits), ", ".join(describe_field(f) for f in hits)),
                "Type the exact field name instead, or rename one of the fields or aliases.")

    if required:
        available = ", ".join(describe_field(f) for f in fields) or "(none)"
        raise ToolError(
            "The {0} '{1}' was not found by alias or by name.".format(what, wanted),
            "Choose one of the available fields: {0}.".format(available))
    return None, None


def match_fields(fields, wanted_names, label=None, exact_name_first=False):
    """Resolve several required fields at once.

    Returns a list of ``(wanted, field, matched_by)`` in the given order.
    """
    return [(w,) + match_field(fields, w, True, label, exact_name_first) for w in wanted_names]


def match_message(wanted, field, matched_by):
    """Message text reporting how a field was resolved."""
    return "Field '{0}' matched {1} by {2}.".format(wanted, describe_field(field), matched_by)


def text_field_length(values, minimum=1):
    """Width for a text field that must hold every value in ``values``.

    ``None`` values are ignored; other values are measured as ``str(value)``.
    Engineering rule 8: text widths are derived from the longest value written.
    """
    longest = 0
    for value in values:
        if value is not None:
            longest = max(longest, len(str(value)))
    return max(int(minimum), longest)


# ==========================================================================
# common/domains.py
# ==========================================================================
# Coded-value and range domains, at field AND subtype level, as plain dicts.
#
# Engineering rule 2: read domains at field and subtype level, never guess a
# code, and when a needed value is not in the domain stop with a message that
# lists the accepted values.
#
# Structures (built by ``arcio.read_domains`` / ``arcio.read_subtypes``, or by
# hand in tests)::
#
#     domains = {"D_Status": {"name": "D_Status", "domain_type": "CodedValue",
#                             "field_type": "Short",
#                             "codes": {1: "Active", 2: "Retired"},
#                             "range": None}}
#
#     subtypes = {"field": "ROAD_CLASS",          # "" when the table has no subtypes
#                 "subtypes": {1: {"name": "Primary",
#                                  "domains": {"SURFACE": "D_Surface_Primary"}}}}
#
# Field-level domains come from the field dicts (``field["domain"]``).

_DOMAINS_NUMERIC_TYPES = frozenset(
    ["short", "long", "smallinteger", "integer", "biginteger", "float", "single", "double"])


def domain_for_field(field_name, field_domain, subtypes=None, subtype_code=None):
    """Name of the domain that applies to ``field_name`` for one row.

    If the table has a subtype field and ``subtype_code`` is one of its
    subtypes that lists this field, the subtype-level domain wins (``None``
    there means the subtype deliberately has no domain). Otherwise the
    field-level domain ``field_domain`` applies.
    """
    if subtypes and subtypes.get("field") and subtype_code is not None:
        entry = _domains_find_subtype(subtypes, subtype_code)
        if entry is not None:
            per_field = entry.get("domains") or {}
            for name, dom in per_field.items():
                if name.casefold() == str(field_name).casefold():
                    return dom or None
    return field_domain or None


def _domains_find_subtype(subtypes, code):
    table = subtypes.get("subtypes") or {}
    if code in table:
        return table[code]
    for key, entry in table.items():
        if _domains_same_value(key, code, numeric=True):
            return entry
    return None


def _domains_is_numeric(domain):
    return str(domain.get("field_type") or "").casefold() in _DOMAINS_NUMERIC_TYPES


def _domains_same_value(a, b, numeric):
    """Equality that treats 1, 1.0 and "1" as equal for numeric domains only."""
    if a is None or b is None:
        return a is b
    if numeric:
        # exact_number, not float(): BigInteger codes above 2**53 stay distinct.
        na, nb = exact_number(a), exact_number(b)
        return na is not None and na == nb
    return str(a) == str(b)


def accepted_values_text(domain, limit=50):
    """``code = description`` list for messages (truncated after ``limit``)."""
    if domain.get("domain_type") == "Range":
        low, high = domain.get("range") or (None, None)
        return "a value from {0} to {1}".format(low, high)
    pairs = ["{0} = {1}".format(c, d) for c, d in (domain.get("codes") or {}).items()]
    if len(pairs) > limit:
        pairs = pairs[:limit] + ["... ({0} more)".format(len(pairs) - limit)]
    return "; ".join(pairs) if pairs else "(the domain has no codes)"


class CodedValueIndex(object):
    """Set of the codes of one coded-value domain, built once.

    ``value in index`` gives the same answer as ``value_in_domain`` (numbers
    compared exactly for numeric domains, so "1", 1 and 1.0 are equal; text
    compared as text) in constant time instead of a scan over every code.
    """

    def __init__(self, domain):
        self.numeric = _domains_is_numeric(domain)
        self.keys = set()
        for code in (domain.get("codes") or {}):
            key = self._key(code)
            if key is not None:
                self.keys.add(key)

    def _key(self, value):
        if value is None:
            return None
        return exact_number(value) if self.numeric else str(value)

    def __contains__(self, value):
        key = self._key(value)
        return key is not None and key in self.keys


def value_in_domain(domain, value, index=None):
    """True if ``value`` is allowed by ``domain``. Nulls are not violations.

    ``index`` (a ``CodedValueIndex`` of a coded-value ``domain``) makes the
    test a dictionary lookup; pass it when testing many values.
    """
    if value is None or domain is None:
        return True
    numeric = _domains_is_numeric(domain)
    if domain.get("domain_type") == "Range":
        low, high = domain.get("range") or (None, None)
        lo, hi, number = exact_number(low), exact_number(high), exact_number(value)
        if lo is None or hi is None or number is None:
            return False
        return lo <= number <= hi
    if index is not None:
        return value in index
    return any(_domains_same_value(code, value, numeric) for code in (domain.get("codes") or {}))


def code_description(domain, code):
    """Description of ``code`` or ``None`` if it is not in the domain."""
    numeric = _domains_is_numeric(domain)
    for key, desc in (domain.get("codes") or {}).items():
        if _domains_same_value(key, code, numeric):
            return desc
    return None


def require_code(domain, value, field_name=None):
    """Return the stored code for ``value``, which may be a code or a description.

    Codes are tried first (exact type-aware match), then descriptions
    (case-insensitive). Raises ``ToolError`` listing the accepted values when
    there is no match, or when a description matches more than one code.
    """
    where = " for field '{0}'".format(field_name) if field_name else ""
    name = domain.get("name", "?")
    if domain.get("domain_type") == "Range":
        if value_in_domain(domain, value) and value is not None:
            return value
        raise ToolError(
            "The value '{0}'{1} is outside the range domain '{2}'.".format(value, where, name),
            "Use {0}.".format(accepted_values_text(domain)))
    numeric = _domains_is_numeric(domain)
    codes = domain.get("codes") or {}
    for code in codes:
        if _domains_same_value(code, value, numeric):
            return code
    wanted = str(value).strip().casefold()
    hits = [code for code, desc in codes.items() if str(desc).strip().casefold() == wanted]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        raise ToolError(
            "The description '{0}'{1} matches several codes in domain '{2}': {3}.".format(
                value, where, name, ", ".join(str(h) for h in hits)),
            "Give the code itself instead of the description.")
    raise ToolError(
        "The value '{0}'{1} is not in the coded-value domain '{2}'.".format(value, where, name),
        "Use one of the accepted values: {0}.".format(accepted_values_text(domain)))


# --------------------------------------------------------------------------
# Domains of fields copied to a new output
# --------------------------------------------------------------------------

def domain_fits_field_type(domain, keyword):
    """True when an output-workspace domain (``arcio.read_domains`` entry) can be
    assigned to a field of AddField type ``keyword`` (same field type, or a type
    that is not reported)."""
    field_type = str((domain or {}).get("field_type") or "")
    return not field_type or field_type.casefold() == str(keyword).casefold()


def keep_field_domain(spec, domain_name, out_domains):
    """Carry the field-level domain ``domain_name`` of a copied field to its
    output field spec (for ``arcio.add_fields``), as Copy Features does.

    ``out_domains``: the domains of the output workspace (``arcio.read_domains``
    / ``arcio.read_output_domains``; ``{}`` for a folder). The spec gets
    ``"domain"`` when that workspace has a domain of that name for the spec's
    field type, else ``"lost_domain"`` (see ``lost_domain_warning``). No domain:
    the spec is unchanged. Subtypes and subtype-level domains are not carried.
    Returns ``spec``.
    """
    if domain_name:
        if out_domains is not None and domain_name in out_domains and \
                domain_fits_field_type(out_domains[domain_name], spec["type"]):
            spec["domain"] = domain_name
        else:
            spec["lost_domain"] = domain_name
    return spec


def lost_domain_warning(specs, output):
    """Warning text, or ``None``, naming the copied fields of ``specs``
    (``keep_field_domain``) whose domain the output workspace of ``output`` does
    not have (same rule and wording as the datamgmt tools)."""
    lost = ["{0} ({1})".format(s["name"], s["lost_domain"]) for s in specs
            if s.get("lost_domain")]
    if not lost:
        return None
    return ("The workspace of {0} does not have the domain(s) of these copied fields (or has "
            "one of that name for another field type), so they have no domain there and show "
            "codes instead of descriptions: {1}. Add the domains to the output geodatabase and "
            "assign them (Assign Domain To Field), or write the output to the input's "
            "geodatabase.".format(output, ", ".join(lost)))


# ==========================================================================
# common/paths.py
# ==========================================================================
# Catalog path handling that never relies on the host operating system.
#
# Engineering rule 4: never destroy input. Before any delete or overwrite the
# tool compares normalised catalog paths and refuses if an output equals an
# input. ``os.path.normcase`` does nothing outside Windows, so normalisation is
# done by hand: separators, duplicate separators, trailing separators, ``.`` and
# ``..`` segments, Unicode form and case.

# Path components that end a workspace (everything after them is inside it).
_PATHS_WORKSPACE_EXTS = (".gdb", ".sde", ".gpkg", ".geodatabase", ".mdb")


def normalize_catalog_path(path):
    """Comparison key for a catalog path; not meant to be shown to users.

    ``C:/Data//City.GDB/Roads/`` and ``c:\\data\\city.gdb\\roads`` give the same key.
    """
    if path is None:
        return ""
    text = unicodedata.normalize("NFC", str(path).strip()).replace("/", "\\")
    unc = text.startswith("\\\\")
    parts = []
    for part in text.split("\\"):
        if part in ("", "."):
            continue
        if part == ".." and parts and parts[-1] != "..":
            parts.pop()
            continue
        parts.append(part)
    joined = "\\".join(parts)
    if unc:
        joined = "\\\\" + joined
    return joined.casefold()


# Files that belong to one shapefile / dBASE table in a folder workspace. In a
# folder, ``name``, ``name.shp`` and ``name.dbf`` (and every sidecar) are one
# dataset: Pro writes a table ``folder\name`` as ``name.dbf`` and a feature
# class as ``name.shp`` + ``name.shx`` + ``name.dbf`` + ...
FOLDER_DATASET_EXTS = (".shp", ".dbf", ".shx", ".prj", ".cpg", ".sbn", ".sbx", ".qix", ".fbn",
                       ".fbx", ".ain", ".aih", ".atx", ".ixs", ".mxs", ".xml")


def _paths_folder_stem(name):
    """Base name without shapefile/dBASE extensions (``roads.shp.xml`` -> ``roads``)."""
    text = str(name)
    while True:
        dot = text.rfind(".")
        if dot <= 0 or text[dot:].casefold() not in FOLDER_DATASET_EXTS:
            return text
        text = text[:dot]


def dataset_identity(path):
    """Canonical identity of the dataset a catalog path names (comparison key).

    * Geodatabase (and memory) datasets: ``<workspace>\\<name>``, ignoring case
      and separators; feature datasets are transparent (names are unique in a
      geodatabase), so ``a.gdb\\fds\\roads`` == ``a.gdb\\roads``.
    * Folder workspaces: ``<folder>\\<base name>`` without shapefile/dBASE
      extensions, so ``t``, ``t.dbf``, ``T.DBF``, ``t.shp`` and ``t.shx`` are the
      same dataset (they share one file set, and Pro resolves ``t`` to
      ``t.dbf`` / ``t.shp``). Other files (``t.csv``) keep their extension.
    * GeoPackage: ``x.gpkg\\main.roads`` (the way ArcGIS Pro lists it) and ``x.gpkg\\roads``
      are the same dataset.
    * A workspace path itself is its own identity.
    Returns ``""`` for an empty path.
    """
    if path is None or not str(path).strip():
        return ""
    text = str(path).strip()
    workspace = workspace_of(text)
    key = normalize_catalog_path(text)
    if not workspace or normalize_catalog_path(workspace) == key:
        return key
    name = split_catalog_path(text)[1]
    if is_folder_workspace(workspace):
        name = _paths_folder_stem(name)
    elif normalize_catalog_path(workspace).endswith(".gpkg") and name.casefold().startswith("main."):
        name = name[len("main."):]  # GeoPackage datasets are listed as <file>.gpkg\\main.<name>
    return normalize_catalog_path(workspace + "\\" + name)


def folder_dataset_candidates(path):
    """Paths an output may really occupy: for a folder output without a
    shapefile/dBASE extension, also ``.shp`` and ``.dbf`` (Pro adds one)."""
    text = str(path)
    workspace, name = split_catalog_path(text)
    if workspace and is_folder_workspace(workspace) and _paths_folder_stem(name) == name \
            and "." not in name:
        return [text, text + ".shp", text + ".dbf"]
    return [text]


def same_dataset(a, b):
    """True if two catalog paths name the same dataset (``dataset_identity``)."""
    key_a = dataset_identity(a)
    return bool(key_a) and key_a == dataset_identity(b)


# Run-scoped register of every dataset/file the running tool reads (quality review
# D1/D2: an input that a tool forgot to pass in ``inputs`` was overwritten). While a
# run is active (``arcio.guarded_run`` around ``execute``), ``refuse_if_same`` and the
# report checks compare outputs with these paths too, so a forgotten input can no
# longer be replaced. Outside a run (dialog validation) nothing is registered.
#
# Tables joined to an input layer are registered too, by NAME only: a layer reports
# the catalog path of its own table, never of the tables joined to it, so an
# output or report named like a joined table is refused in any workspace
# (conservative; re-review N1 of LineNetworkRules, first done in carto only).
_PATHS_RUN = {"active": False, "inputs": [], "joined": set()}

# Extensions of file tables a join can read (a qualifier such as ``valves.csv``).
_PATHS_JOIN_FILE_EXTS = ("csv", "txt", "tab", "dbf", "shp", "xls", "xlsx")


def begin_input_register():
    """Start a run: clear and activate the register of read datasets."""
    _PATHS_RUN["active"] = True
    _PATHS_RUN["inputs"] = []
    _PATHS_RUN["joined"] = set()


def end_input_register():
    """End a run: clear and deactivate the register."""
    _PATHS_RUN["active"] = False
    _PATHS_RUN["inputs"] = []
    _PATHS_RUN["joined"] = set()


def joined_table_names(fields):
    """Case-folded names of the tables a layer reads through joins.

    With a join, a layer's fields are qualified ``<table>.<field>`` (an enterprise
    table ``db.owner.table.field``); the table name is the last part before the
    field. The layer's own table is listed too (its fields are qualified as well).
    For a file table (``valves.csv.FIELD``) the file name and its stem are listed
    as well. A layer without qualified field names gives an empty set. ``fields``
    are dicts with a ``"name"`` (``arcio.field_info``) or objects with ``.name``.
    """
    names = set()
    for field in fields or []:
        name = (field.get("name") if isinstance(field, dict) else getattr(field, "name", "")) or ""
        if "." in name:
            qualifier = name.rsplit(".", 1)[0]
            pieces = qualifier.split(".")
            table = pieces[-1].strip()
            if table:
                names.add(table.casefold())
            if len(pieces) > 1 and table.casefold() in _PATHS_JOIN_FILE_EXTS and pieces[-2].strip():
                names.add((pieces[-2].strip() + "." + table).casefold())
                names.add(pieces[-2].strip().casefold())
    return names


def register_joined_tables(names):
    """Record names of tables joined to an input layer (ignored outside a run)."""
    if not _PATHS_RUN["active"]:
        return
    _PATHS_RUN["joined"].update(n.casefold() for n in names or () if n)


def registered_joined_tables():
    """Names registered by ``register_joined_tables`` (empty outside a run)."""
    return set(_PATHS_RUN["joined"]) if _PATHS_RUN["active"] else set()


def _paths_output_base(path):
    """Case-folded output name without a ``.shp`` / ``.dbf`` extension."""
    name = split_catalog_path(path)[1]
    if name.casefold().endswith((".dbf", ".shp")):
        name = name[:-4]
    return name.casefold()


def refuse_joined_table_outputs(outputs, joined):
    """Raise ``ToolError`` if an output has the name of a table read through a join.

    The output==input check compares catalog paths, and a layer reports only the
    path of its own table, not of the tables joined to it. So an output named
    like any table of a joined layer (``joined_table_names``) is refused, whatever
    its workspace (conservative: the joined table's workspace is not known).
    A report file is matched by its file name and by its name without extension.
    """
    if not joined:
        return
    for out in outputs:
        if not out:
            continue
        name = split_catalog_path(out)[1].casefold()
        candidates = set([_paths_output_base(out), name])
        if "." in name:
            candidates.add(name.rsplit(".", 1)[0])
        hit = sorted(candidates & set(joined))
        if hit:
            raise ToolError(
                "The output '{0}' has the name of a table that an input layer reads through "
                "a join ({1}); it could replace that table.".format(out, hit[0]),
                "Choose another output name, or remove the join from the layer.")


def register_inputs(paths):
    """Record datasets/files the running tool reads (ignored outside a run)."""
    if not _PATHS_RUN["active"]:
        return
    for path in paths or ():
        if path and str(path).strip() and path not in _PATHS_RUN["inputs"]:
            _PATHS_RUN["inputs"].append(path)


def registered_inputs():
    """Datasets/files registered by the running tool (empty outside a run)."""
    return list(_PATHS_RUN["inputs"]) if _PATHS_RUN["active"] else []


def refuse_if_same(outputs, inputs):
    """Raise ``ToolError`` if any output path equals any input path.

    ``None`` and empty entries are ignored. Inputs must already be resolved to
    catalog paths (a layer name is not a path; see ``arcio.describe_dataset``).
    During a guarded run every registered input (``registered_inputs``) is
    compared as well, whether or not the caller listed it, and an output named
    like a registered joined table (``registered_joined_tables``) is refused.
    """
    inputs = list(inputs or ()) + registered_inputs()
    refuse_joined_table_outputs(outputs, registered_joined_tables())
    for out in outputs:
        if not out:
            continue
        for inp in inputs:
            if inp and same_dataset(out, inp):
                raise ToolError(
                    "The output '{0}' is the same dataset as the input '{1}'.".format(out, inp),
                    "Choose a different output name or location; this tool never overwrites its input.")


def split_catalog_path(path):
    """Split into ``(parent, name)`` on the last ``\\`` or ``/``."""
    text = str(path).rstrip("\\/")
    cut = max(text.rfind("\\"), text.rfind("/"))
    if cut < 0:
        return "", text
    return text[:cut], text[cut + 1:]


def workspace_of(catalog_path):
    """Workspace that contains a dataset.

    The workspace is the path up to the last component ending in ``.gdb``,
    ``.sde``, ``.gpkg``, ``.geodatabase`` or ``.mdb`` (so a feature class
    inside a feature dataset still maps to its geodatabase); ``memory`` and
    ``in_memory`` are workspaces too. Otherwise (shapefiles, dBASE tables) it
    is the parent folder. The original spelling is kept.
    """
    text = str(catalog_path).rstrip("\\/")
    pieces = text.replace("/", "\\").split("\\")
    for i in range(len(pieces) - 1, -1, -1):
        low = pieces[i].casefold()
        if low.endswith(_PATHS_WORKSPACE_EXTS) or (i == 0 and low in ("memory", "in_memory")):
            if i == len(pieces) - 1:
                return text  # the path is itself a workspace
            return _paths_rejoin(text, i + 1)
    return split_catalog_path(text)[0]


def _paths_rejoin(text, count):
    """First ``count`` components of ``text`` with its original separators."""
    seen = 0
    for pos, ch in enumerate(text):
        if ch in "\\/":
            seen += 1
            if seen == count:
                return text[:pos]
    return text


def is_folder_workspace(workspace):
    """True if the workspace is a plain folder (shapefiles, dBASE).

    A container inside a geodatabase is not a folder: a feature dataset
    (``C:\\QA\\city.gdb\\Checks``, the parent ``split_catalog_path`` gives for an
    output in it) follows the rules of its geodatabase, so any component
    ending in ``.gdb``, ``.sde``, ``.gpkg``, ``.geodatabase`` or ``.mdb`` (or a
    leading ``memory`` / ``in_memory``) makes this False (RT7-Q-2).
    """
    pieces = str(workspace).rstrip("\\/").replace("/", "\\").split("\\")
    for i, piece in enumerate(pieces):
        low = piece.casefold()
        if low.endswith(_PATHS_WORKSPACE_EXTS) or (i == 0 and low in ("memory", "in_memory")):
            return False
    return True


def find_duplicate_outputs(outputs):
    """First pair ``(a, b)`` of outputs that name the same dataset, else ``None``.

    ``None`` and empty entries are ignored. Use it in ``updateMessages`` and
    at the start of ``execute`` so one output can never silently replace
    another output of the same run.
    """
    seen = {}
    for out in outputs:
        if not out:
            continue
        key = dataset_identity(out)
        if key in seen:
            return seen[key], out
        seen[key] = out
    return None


def refuse_duplicate_outputs(outputs):
    """Raise ``ToolError`` if two outputs are the same dataset."""
    pair = find_duplicate_outputs(outputs)
    if pair:
        raise ToolError(
            "Two outputs are the same dataset: '{0}' and '{1}'.".format(pair[0], pair[1]),
            "Give every output its own name.")


# ==========================================================================
# common/projection.py
# ==========================================================================
# Choose a projected, metric coordinate system for measuring.
#
# Engineering rule 3: lengths, areas and distances are measured in a projected
# metric system chosen from the data extent; degrees are never treated as
# metres. This module is pure: it decides *which* system to use. ``arcio``
# creates the ``arcpy.SpatialReference`` and projects at read time.
#
# Decision rules
# --------------
# 1. Input projected and **not** in the Web Mercator family -> keep it, convert
#    with its ``metersPerUnit``. (Web Mercator distorts distances: about x1.15 at
#    30 degrees latitude and x2 at 60.)
# 2. Otherwise use the UTM zone of the data centre: EPSG 326zz (north) or
#    327zz (south) on WGS 84. A geographic input on another datum (NAD27, ED50,
#    Ain el Abd 1970, ...) uses the EPSG UTM system of its OWN datum when one
#    exists for that zone (``DATUM_UTM_SERIES``, e.g. 4204 zone 38N -> 20438),
#    so no datum transformation is needed. Otherwise the WGS 84 zone is used
#    and a warning says that no datum transformation is applied (the result
#    may be offset by the datum shift) and how to avoid it. The centre longitude is the middle of the *smallest*
#    longitude arc that holds all sample longitudes, so data that crosses the
#    antimeridian (e.g. Fiji, 177E..178W) gets zone 60/1 and not zone 31.
#    A warning is issued if the data spans more than 3 UTM zones.
# 3. Polar data (centre latitude above 84N or below 80S, the UTM limits) uses
#    EPSG 3995 (WGS 84 / Arctic Polar Stereographic) or EPSG 3031
#    (WGS 84 / Antarctic Polar Stereographic), with the same datum warning for
#    an input that is not on WGS 84. The decision is marked ``"polar": True``:
#    both systems have their true scale at 71 degrees, so between 80 and 90
#    degrees they measure lengths 2-2.7 % and areas 4-5.4 % short.
#    ``choose_measuring`` (given ``geographic_sr``) therefore measures polar
#    data, and input already in a polar stereographic system (any one: recognised
#    from where the system puts probe points round the pole, ``polar_probe_points``
#    / ``is_polar_stereographic_probe``; ``arcio.sr_info`` adds the result as
#    ``"polar_stereographic"``), feature by feature (``local_tm_rows``: each polar
#    feature on its own polar stereographic projection with true scale at the
#    feature).
# Norway/Svalbard UTM zone exceptions are not applied (standard 6-degree zones).

WEB_MERCATOR_WKIDS = frozenset([3857, 102100, 102113, 3395, 54004, 900913])
ARCTIC_POLAR_WKID = 3995
ANTARCTIC_POLAR_WKID = 3031
# Common polar stereographic systems on WGS 84: EPSG 3995 / 3031, 3413 / 3976 (NSIDC) and
# UPS 32661 / 32761 / 5041 / 5042. Used only to tell their datum from the WKID
# (``gcs_wkid_of``). Whether an input IS polar stereographic is not taken from a WKID
# list (RT8-C-3): see ``is_polar_stereographic_probe``.
POLAR_STEREO_WKIDS = frozenset([3995, 3031, 3413, 3976, 32661, 32761, 5041, 5042])

# Probe of a projected system (RT8-C-3): the points ``polar_probe_points(sign)`` (WGS 84
# degrees, 4 meridians 90 degrees apart on 3 latitudes near one pole) are projected into
# the system (``arcio.sr_info``). A polar stereographic projection about that pole (any
# variant, any true-scale latitude, false origin, axis orientation, unit or ellipsoid of
# about the size of the Earth) puts each latitude on a circle round one centre, the
# meridians 90 degrees apart, and the radii in the ratio of the stereographic formula.
# Polar azimuthal equal-area or equidistant systems differ by 0.25-0.4 % in those ratios.
POLAR_PROBE_LATS = (80.0, 85.0, 89.0)
POLAR_PROBE_LONS = (0.0, 90.0, 180.0, -90.0)
POLAR_PROBE_TOLERANCE = 1e-3
MAX_UTM_ZONES_WITHOUT_WARNING = 3
WGS84_GCS_WKID = 4326

# UTM systems on datums other than WGS 84 (EPSG, not deprecated, standard 6-degree
# zones in metres; GDA94/GDA2020 MGA zones are UTM on that datum). Each row:
# (geographic WKID, hemisphere, first zone, last zone, WKID of the first zone); the
# WKIDs of a row are consecutive. Checked against the EPSG database (pyproj) in the
# tests. Unlisted datums fall back to WGS 84 UTM with a warning.
DATUM_UTM_SERIES = (
    (4131, "N", 48, 49, 3148),  # Indian 1960
    (4146, "N", 42, 47, 24342),  # Kalianpur 1975
    (4152, "N", 4, 5, 3750),  # NAD83(HARN)
    (4152, "N", 10, 19, 3740),  # NAD83(HARN)
    (4152, "S", 2, 2, 2195),  # NAD83(HARN)
    (4154, "N", 38, 41, 2058),  # ED50(ED77)
    (4159, "N", 32, 35, 2077),  # ELD79
    (4170, "N", 17, 22, 31986),  # SIRGAS 1995
    (4170, "S", 17, 25, 31992),  # SIRGAS 1995
    (4189, "N", 18, 20, 2201),  # REGVEN
    (4201, "N", 35, 38, 20135),  # Adindan
    (4204, "N", 36, 40, 20436),  # Ain el Abd
    (4205, "N", 38, 39, 20538),  # Afgooye
    (4209, "S", 34, 36, 20934),  # Arc 1950
    (4210, "N", 35, 37, 21095),  # Arc 1960
    (4210, "S", 35, 37, 21035),  # Arc 1960
    (4211, "S", 48, 50, 21148),  # Batavia
    (4218, "N", 18, 18, 21818),  # Bogota 1975
    (4222, "S", 34, 35, 22234),  # Cape
    (4223, "N", 32, 32, 22332),  # Carthage
    (4225, "S", 21, 25, 22521),  # Corrego Alegre 1970-72
    (4230, "N", 28, 38, 23028),  # ED50
    (4232, "N", 39, 40, 23239),  # Fahud
    (4238, "N", 46, 52, 23846),  # ID74
    (4238, "S", 47, 54, 23887),  # ID74
    (4239, "N", 46, 48, 23946),  # Indian 1954
    (4240, "N", 47, 48, 24047),  # Indian 1975
    (4245, "N", 47, 48, 24547),  # Kertau 1968
    (4247, "N", 18, 20, 24718),  # La Canoa
    (4248, "N", 17, 21, 24817),  # PSAD56
    (4248, "S", 17, 22, 24877),  # PSAD56
    (4258, "N", 28, 37, 25828),  # ETRS89
    (4263, "N", 31, 32, 26331),  # Minna
    (4267, "N", 1, 22, 26701),  # NAD27
    (4267, "N", 59, 60, 3370),  # NAD27
    (4269, "N", 1, 23, 26901),  # NAD83
    (4269, "N", 24, 24, 9712),  # NAD83
    (4269, "N", 59, 60, 3372),  # NAD83
    (4270, "N", 39, 40, 27039),  # Nahrwan 1967
    (4283, "S", 46, 47, 6736),  # GDA94
    (4283, "S", 48, 58, 28348),  # GDA94
    (4283, "S", 59, 59, 6738),  # GDA94
    (4301, "N", 51, 55, 3092),  # Tokyo
    (4307, "N", 29, 32, 30729),  # Nord Sahara 1959
    (4318, "N", 38, 39, 31838),  # NGN
    (4322, "N", 1, 60, 32201),  # WGS 72
    (4322, "S", 1, 60, 32301),  # WGS 72
    (4612, "N", 51, 55, 3097),  # JGD2000
    (4617, "N", 7, 10, 3154),  # NAD83(CSRS)
    (4617, "N", 11, 13, 2955),  # NAD83(CSRS)
    (4617, "N", 14, 16, 3158),  # NAD83(CSRS)
    (4617, "N", 17, 21, 2958),  # NAD83(CSRS)
    (4617, "N", 22, 22, 3761),  # NAD83(CSRS)
    (4617, "N", 23, 23, 9709),  # NAD83(CSRS)
    (4617, "N", 24, 24, 9713),  # NAD83(CSRS)
    (4618, "N", 17, 17, 5463),  # SAD69
    (4618, "N", 18, 22, 29168),  # SAD69
    (4618, "S", 17, 25, 29187),  # SAD69
    (4674, "N", 11, 22, 31965),  # SIRGAS 2000
    (4674, "N", 23, 24, 6210),  # SIRGAS 2000
    (4674, "S", 17, 25, 31977),  # SIRGAS 2000
    (4674, "S", 26, 26, 5396),  # SIRGAS 2000
    (4743, "N", 37, 39, 3391),  # Karbala 1979
    (4744, "N", 37, 39, 7005),  # Nahrwan 1934
    (4755, "N", 46, 52, 23866),  # DGN95
    (4755, "S", 47, 54, 23877),  # DGN95
    (4756, "N", 48, 49, 3405),  # VN-2000
    (4759, "N", 1, 19, 3708),  # NAD83(NSRS2007)
    (4759, "N", 59, 60, 3706),  # NAD83(NSRS2007)
    (6318, "N", 1, 19, 6330),  # NAD83(2011)
    (6318, "N", 59, 60, 6328),  # NAD83(2011)
    (6668, "N", 51, 55, 6688),  # JGD2011
    (7844, "S", 46, 59, 7846),  # GDA2020
)


def utm_zone(lon):
    """Standard 6-degree UTM zone number (1..60) of a longitude in degrees."""
    lon = _projection_wrap(lon)
    zone = int(math.floor((lon + 180.0) / 6.0)) + 1
    return min(max(zone, 1), 60)


def utm_wkid(lon, lat):
    """EPSG code of the WGS 84 UTM zone for a point."""
    return (32600 if lat >= 0 else 32700) + utm_zone(lon)


def _projection_wrap(lon):
    """Longitude in [-180, 180)."""
    return ((float(lon) + 180.0) % 360.0) - 180.0


def longitude_span(longitudes):
    """Smallest arc holding all longitudes: ``(west, east, centre, width)``.

    ``west``/``east``/``centre`` are wrapped to [-180, 180); ``width`` is in
    degrees (0..360). Works across the antimeridian: the arc is the complement
    of the largest gap between sorted longitudes.
    """
    lons = sorted(set(_projection_wrap(x) for x in longitudes))
    if not lons:
        raise ValueError("no longitudes")
    if len(lons) == 1:
        return lons[0], lons[0], lons[0], 0.0
    best_gap, best_i = -1.0, 0
    for i in range(len(lons)):
        nxt = lons[(i + 1) % len(lons)] + (360.0 if i == len(lons) - 1 else 0.0)
        gap = nxt - lons[i]
        if gap > best_gap:
            best_gap, best_i = gap, i
    west = lons[(best_i + 1) % len(lons)]
    east = lons[best_i]
    width = 360.0 - best_gap
    centre = _projection_wrap(west + width / 2.0)
    return west, east, centre, width


def count_utm_zones(west, width):
    """Number of UTM zones touched by an arc starting at ``west``."""
    if width >= 360.0:
        return 60
    first = int(math.floor((_projection_wrap(west) + 180.0) / 6.0))
    last = int(math.floor((_projection_wrap(west) + 180.0 + width) / 6.0))
    return min(last - first + 1, 60)


def is_web_mercator(wkid):
    return wkid is not None and int(wkid) in WEB_MERCATOR_WKIDS


# Equatorial circumference of the Web Mercator family (sphere or ellipsoid with
# a = 6378137 m): the x period of 3857/102100/102113/900913 (+-20,037,508.34 m)
# and of World Mercator 3395/54004.
WEB_MERCATOR_PERIOD_M = 2.0 * math.pi * 6378137.0


def x_period(sr_info):
    """Period of the x coordinate of a coordinate system, or ``None``: 360 for a
    geographic system (longitudes), the equatorial circumference (in the
    system's units) for the Web Mercator family, else ``None``. Coordinates
    ``x`` and ``x +- period`` are then the same place (antimeridian)."""
    sr_info = sr_info or {}
    if str(sr_info.get("type") or "") == "Geographic":
        return 360.0
    if is_web_mercator(sr_info.get("wkid")):
        return WEB_MERCATOR_PERIOD_M / float(sr_info.get("meters_per_unit") or 1.0)
    return None


def datum_utm_wkid(gcs_wkid, lon, lat):
    """WKID of the UTM zone of ``(lon, lat)`` on the datum of geographic system
    ``gcs_wkid``, or ``None`` when that datum has no EPSG UTM system there."""
    if not gcs_wkid:
        return None
    gcs_wkid = int(gcs_wkid)
    if gcs_wkid == WGS84_GCS_WKID:
        return utm_wkid(lon, lat)
    zone, hemi = utm_zone(lon), ("N" if lat >= 0 else "S")
    for gcs, h, first, last, code in DATUM_UTM_SERIES:
        if gcs == gcs_wkid and h == hemi and first <= zone <= last:
            return code + zone - first
    return None


def gcs_wkid_of(sr_info):
    """WKID of the geographic system (datum) under ``sr_info``, or ``None`` when it
    cannot be told from the WKID alone (custom or unlisted projected systems)."""
    sr_info = sr_info or {}
    wkid = sr_info.get("wkid")
    if not wkid:
        return None
    wkid = int(wkid)
    if str(sr_info.get("type") or "") == "Geographic":
        return wkid
    if is_web_mercator(wkid) or wkid in POLAR_STEREO_WKIDS \
            or 32601 <= wkid <= 32660 or 32701 <= wkid <= 32760:
        return WGS84_GCS_WKID
    for gcs, _h, first, last, code in DATUM_UTM_SERIES:
        if code <= wkid <= code + last - first:
            return gcs
    return None


def datum_mismatch_warning(label, other_info, decision):
    """Warning text when a further input (``label``) is on another datum than the
    measuring system of ``decision``: it is projected without a datum
    transformation. ``None`` when the datums match or cannot be told."""
    if not decision:
        return None
    target = decision.get("gcs_wkid")
    other = gcs_wkid_of(other_info)
    if target is None or other is None or target == other:
        return None
    return ("{0} ({1}) is on another datum than the measuring coordinate system (WKID {2}); "
            "it is projected to it without a datum transformation, so it may be offset "
            "from the other input by the datum shift (about 1 m between modern datums, up to "
            "several hundred metres for older ones). Project both inputs to the same projected "
            "metric coordinate system first (Project tool, with the right geographic "
            "transformation).".format(label, (other_info or {}).get("name") or other,
                                      decision.get("wkid")))


def sr_is_unknown(sr_info):
    """True for a dataset without a coordinate system (e.g. a shapefile with no
    .prj): type neither Projected nor Geographic and no WKID."""
    sr_info = sr_info or {}
    return (str(sr_info.get("type") or "") not in ("Projected", "Geographic")
            and not sr_info.get("wkid"))


def further_input_sr_check(label, other_info, decision, main_name=None):
    """Check the coordinate system of a further input (``label``) against the
    measuring ``decision`` of the main input.

    A cursor cannot project data whose system is unknown (audit gotcha 3), so
    its coordinates stay as they are. When the main input is projected for
    measuring, they would be compared with it in other units: ``ToolError``.
    When the main input is used in its own system, the further input is
    assumed to be in that system: returns a warning. ``None`` when the further
    input's system is known.
    """
    if not sr_is_unknown(other_info):
        return None
    fix = ("Define the coordinate system of {0} (Define Projection tool) and run the tool "
           "again.".format(label))
    if decision and decision.get("reproject"):
        raise ToolError(
            "{0} has an unknown coordinate system, so it cannot be projected to the measuring "
            "coordinate system (WKID {1}); its coordinates would be compared with the input "
            "in other units.".format(label, decision.get("wkid")), fix)
    return ("{0} has an unknown coordinate system; its coordinates are used as if they were "
            "in the coordinate system of the input ({1}). If they are not, {2}".format(
                label, main_name or "unknown", fix[0].lower() + fix[1:]))


def _projection_datum_warning(name, target_text):
    return ("The input coordinate system ({0}) is not on the WGS 84 datum and has no UTM "
            "system on its own datum for this area, so it is projected to {1} WITHOUT a datum "
            "transformation. Positions may be offset by the datum shift: about 1 m for modern "
            "datums (NAD83, ETRS89, GDA94), up to several hundred metres for older ones "
            "(NAD27, ED50, Ain el Abd 1970, Pulkovo 1942). For exact positions project the "
            "input to a projected metric coordinate system first (Project tool, with the right "
            "geographic transformation).".format(name, target_text))


def choose_metric_sr(sr_info, lonlat_samples=None):
    """Decide the measuring coordinate system.

    ``sr_info`` describes the input system: ``{"wkid": int or None,
    "type": "Projected" | "Geographic" | ..., "meters_per_unit": float or None,
    "name": str}``. ``lonlat_samples`` is an iterable of ``(lon, lat)`` in
    degrees (WGS 84) and is only needed when the input is not usable as is.

    Returns ``{"wkid", "meters_per_unit", "reproject", "gcs_wkid", "reason",
    "warnings"}`` (``gcs_wkid``: the datum of the measuring system, ``None`` if
    unknown), plus ``"utm_zones"`` (number of UTM zones the data spans) when a
    UTM zone is chosen and ``"datum_warnings"`` (the subset of ``warnings``
    about projecting without a datum transformation) when a new system is
    chosen. That warning only matters to a tool that compares positions with
    other data or writes measured positions in another system; a tool that
    writes its results back through the same projection may show it as
    information instead (``choose_measuring(..., datum_as_info=True)``);
    ``reproject`` is False when the input system is kept. An unknown system
    (type neither Projected nor Geographic and no WKID) is kept as is with a
    warning: it cannot be projected.
    Raises ``ToolError`` when a new system is needed but there are no samples.
    """
    sr_info = sr_info or {}
    wkid = sr_info.get("wkid")
    sr_type = str(sr_info.get("type") or "")
    mpu = sr_info.get("meters_per_unit")
    name = sr_info.get("name") or ("WKID {0}".format(wkid) if wkid else "unknown")

    if sr_type not in ("Projected", "Geographic") and not wkid:
        # Unknown coordinate system: a cursor cannot project it (coordinates stay as
        # they are, audit gotcha 3), so measuring "in UTM" would be a false claim.
        return {"wkid": None, "meters_per_unit": 1.0, "reproject": False, "gcs_wkid": None,
                "reason": "The input coordinate system is unknown; coordinates are used as "
                          "they are.",
                "warnings": ["The coordinate system of the input is unknown, so lengths, areas "
                             "and distances are in the data's own units and are reported as if "
                             "they were metres. Define the projection of the input (Define "
                             "Projection tool) for correct values."]}
    if sr_type == "Projected" and not is_web_mercator(wkid) and mpu:
        return {"wkid": wkid, "meters_per_unit": float(mpu), "reproject": False,
                "gcs_wkid": gcs_wkid_of(sr_info),
                "reason": "The input is already projected ({0}); it is used as is.".format(name),
                "warnings": []}

    samples = [(float(x), float(y)) for (x, y) in (lonlat_samples or [])
               if x is not None and y is not None
               and math.isfinite(float(x)) and math.isfinite(float(y))]
    if not samples:
        raise ToolError(
            "Cannot choose a metric coordinate system: the input has no usable coordinates.",
            "Check that the input contains features with geometry.")

    lats = [lat for (_lon, lat) in samples]
    centre_lat = (min(lats) + max(lats)) / 2.0
    why_not = ("is in the Web Mercator family, which distorts distances"
               if is_web_mercator(wkid) else "is not a projected system")
    warnings = []
    source_gcs = gcs_wkid_of(sr_info)
    foreign = source_gcs != WGS84_GCS_WKID      # None (custom datum) counts as foreign
    if centre_lat > 84.0 or centre_lat < -80.0:
        north = centre_lat > 84.0
        target = ARCTIC_POLAR_WKID if north else ANTARCTIC_POLAR_WKID
        label = "WGS 84 / {0} Polar Stereographic (EPSG {1})".format(
            "Arctic" if north else "Antarctic", target)
        if foreign:
            warnings.append(_projection_datum_warning(name, label))
        return {"wkid": target, "meters_per_unit": 1.0, "reproject": True, "polar": True,
                "gcs_wkid": WGS84_GCS_WKID, "datum_warnings": list(warnings),
                "reason": "The input ({0}) {1}; polar data {2} is measured in {3}.".format(
                    name, why_not, "north of 84N" if north else "south of 80S", label),
                "warnings": warnings}

    west, _east, centre_lon, width = longitude_span(lon for (lon, _lat) in samples)
    zones = count_utm_zones(west, width)
    target = utm_wkid(centre_lon, centre_lat)
    hemi = "N" if centre_lat >= 0 else "S"
    zone_text = "UTM zone {0}{1}".format(utm_zone(centre_lon), hemi)
    target_gcs = WGS84_GCS_WKID
    target_text = "WGS 84 / {0}".format(zone_text)
    if foreign:
        own = datum_utm_wkid(source_gcs, centre_lon, centre_lat)
        if own is not None:
            target, target_gcs = own, source_gcs
            target_text = "{0} on the input's own datum, so no datum transformation is " \
                          "needed".format(zone_text)
        else:
            warnings.append(_projection_datum_warning(
                name, "WGS 84 / {0} (EPSG {1})".format(zone_text, target)))
    datum_warnings = list(warnings)
    if zones > MAX_UTM_ZONES_WITHOUT_WARNING:
        warnings.append(
            "The data spans {0} UTM zones ({1:.1f} degrees of longitude); distances far from "
            "the centre zone are less accurate. Project the data to a suitable "
            "equidistant or equal-area system first for best results.".format(zones, width))
    return {"wkid": target, "meters_per_unit": 1.0, "reproject": True, "gcs_wkid": target_gcs,
            "reason": "The input ({0}) {1}; measuring in {2} (EPSG {3}).".format(
                name, why_not, target_text, target),
            "warnings": warnings, "utm_zones": zones, "datum_warnings": datum_warnings}


# --------------------------------------------------------------------------
# Per-feature local Transverse Mercator (wide geographic data)
# --------------------------------------------------------------------------
# One UTM zone cannot measure data that spans many zones: Transverse Mercator
# scale error grows with the square of the distance from the central meridian
# (about +0.1 % in area at 3 degrees, +40 % at 40 degrees on the equator, and
# far worse beyond). For such data each feature is projected on its own
# Transverse Mercator with the central meridian at the feature's centre and
# scale factor 1 (true scale on that meridian), in pure Python. The formulas
# are Krueger's series to order n**6 (C. F. F. Karney, "Transverse Mercator
# with an accuracy of a few nanometers", J. Geodesy 85, 2011, eqs. 6-11 and
# 35-36); within 3900 km of the central meridian they agree with an exact
# projection to well below a millimetre (checked against PROJ in the tests).
# The WGS 84 ellipsoid is used for every geographic system: other ellipsoids
# differ by less than 0.01 %, far below what a map-scale check can see.

TM_WGS84_A = 6378137.0
TM_WGS84_F = 1.0 / 298.257223563
# A feature reaching farther than this from its own central meridian (metres on
# its local Transverse Mercator) is measured with more than about 1 % area error
# even on that projection (warning). The scale error grows with the distance
# from the central meridian (k - 1 ~ x**2 / 2R**2), not with the longitude
# difference, which shrinks with cos(latitude): 9 degrees of longitude on the
# equator (a feature 18 degrees wide) is about 1,000 km, at 79 N only 190 km.
TM_MAX_FEATURE_OFFSET_M = TM_WGS84_A * math.pi / 20.0


def _projection_tm_constants(a=TM_WGS84_A, f=TM_WGS84_F):
    n = f / (2.0 - f)
    n2, n3 = n * n, n * n * n
    n4, n5, n6 = n2 * n2, n2 * n3, n3 * n3
    big_a = a / (1.0 + n) * (1.0 + n2 / 4.0 + n4 / 64.0 + n6 / 256.0)
    alpha = (
        n / 2.0 - 2.0 * n2 / 3.0 + 5.0 * n3 / 16.0 + 41.0 * n4 / 180.0 - 127.0 * n5 / 288.0
        + 7891.0 * n6 / 37800.0,
        13.0 * n2 / 48.0 - 3.0 * n3 / 5.0 + 557.0 * n4 / 1440.0 + 281.0 * n5 / 630.0
        - 1983433.0 * n6 / 1935360.0,
        61.0 * n3 / 240.0 - 103.0 * n4 / 140.0 + 15061.0 * n5 / 26880.0
        + 167603.0 * n6 / 181440.0,
        49561.0 * n4 / 161280.0 - 179.0 * n5 / 168.0 + 6601661.0 * n6 / 7257600.0,
        34729.0 * n5 / 80640.0 - 3418889.0 * n6 / 1995840.0,
        212378941.0 * n6 / 319334400.0)
    beta = (
        n / 2.0 - 2.0 * n2 / 3.0 + 37.0 * n3 / 96.0 - n4 / 360.0 - 81.0 * n5 / 512.0
        + 96199.0 * n6 / 604800.0,
        n2 / 48.0 + n3 / 15.0 - 437.0 * n4 / 1440.0 + 46.0 * n5 / 105.0
        - 1118711.0 * n6 / 3870720.0,
        17.0 * n3 / 480.0 - 37.0 * n4 / 840.0 - 209.0 * n5 / 4480.0 + 5569.0 * n6 / 90720.0,
        4397.0 * n4 / 161280.0 - 11.0 * n5 / 504.0 - 830251.0 * n6 / 7257600.0,
        4583.0 * n5 / 161280.0 - 108847.0 * n6 / 3991680.0,
        20648693.0 * n6 / 638668800.0)
    e = math.sqrt(f * (2.0 - f))
    return {"A": big_a, "alpha": alpha, "beta": beta, "e": e}


_PROJECTION_TM = _projection_tm_constants()


def tm_forward(lon, lat, lon0):
    """Transverse Mercator ``(x, y)`` in metres of ``(lon, lat)`` (degrees) on the
    WGS 84 ellipsoid, central meridian ``lon0``, scale factor 1, origin at the
    equator. Longitudes more than about 89 degrees from ``lon0`` are clamped
    (Transverse Mercator is not defined at 90 degrees on the equator)."""
    c = _PROJECTION_TM
    e = c["e"]
    lam = math.radians(_projection_wrap(float(lon) - float(lon0)))
    lam = max(min(lam, math.radians(89.999)), -math.radians(89.999))
    phi = math.radians(max(min(float(lat), 90.0), -90.0))
    sin_phi = math.sin(phi)
    if abs(sin_phi) >= 1.0:
        tau_c = math.copysign(1e300, sin_phi)
        xi_p, eta_p = math.copysign(math.pi / 2.0, sin_phi), 0.0
    else:
        tau_c = math.sinh(math.atanh(sin_phi) - e * math.atanh(e * sin_phi))
        xi_p = math.atan2(tau_c, math.cos(lam))
        eta_p = math.asinh(math.sin(lam) / math.hypot(tau_c, math.cos(lam)))
    xi, eta = xi_p, eta_p
    for j, a_j in enumerate(c["alpha"], 1):
        xi += a_j * math.sin(2 * j * xi_p) * math.cosh(2 * j * eta_p)
        eta += a_j * math.cos(2 * j * xi_p) * math.sinh(2 * j * eta_p)
    return c["A"] * eta, c["A"] * xi


def _projection_lat_from_conformal(tau_p):
    """Geodetic tan(latitude) from conformal tan(latitude) (Newton, Karney eq. 19-21)."""
    e = _PROJECTION_TM["e"]
    e2m = 1.0 - e * e
    tau = tau_p / e2m
    for _ in range(8):
        sigma = math.sinh(e * math.atanh(e * tau / math.sqrt(1.0 + tau * tau)))
        tau_pi = tau * math.sqrt(1.0 + sigma * sigma) - sigma * math.sqrt(1.0 + tau * tau)
        step = (tau_p - tau_pi) * (1.0 + e2m * tau * tau) / (
            e2m * math.sqrt(1.0 + tau_pi * tau_pi) * math.sqrt(1.0 + tau * tau))
        tau += step
        if abs(step) < 1e-14 * max(1.0, abs(tau)):
            break
    return tau


def tm_inverse(x, y, lon0):
    """Inverse of ``tm_forward``: ``(lon, lat)`` in degrees, ``lon`` near ``lon0``
    (``lon0`` plus an offset in -90..90, not wrapped)."""
    c = _PROJECTION_TM
    xi, eta = float(y) / c["A"], float(x) / c["A"]
    xi_p, eta_p = xi, eta
    for j, b_j in enumerate(c["beta"], 1):
        xi_p -= b_j * math.sin(2 * j * xi) * math.cosh(2 * j * eta)
        eta_p -= b_j * math.cos(2 * j * xi) * math.sinh(2 * j * eta)
    lam = math.atan2(math.sinh(eta_p), math.cos(xi_p))
    tau_p = math.sin(xi_p) / math.hypot(math.sinh(eta_p), math.cos(xi_p))
    tau = _projection_lat_from_conformal(tau_p)
    return float(lon0) + math.degrees(lam), math.degrees(math.atan(tau))


# Per-feature polar stereographic (features near a pole). Ellipsoidal formulas of
# J. P. Snyder, "Map Projections - A Working Manual" (USGS PP 1395, 1987), eqs. 15-9,
# 21-33 to 21-40, with scale 1 at the pole; ``local_tm_rows`` then divides the
# coordinates by the scale at the feature, so the feature is at true scale.
_PS_E = _PROJECTION_TM["e"]
_PS_C = math.sqrt((1.0 + _PS_E) ** (1.0 + _PS_E) * (1.0 - _PS_E) ** (1.0 - _PS_E))


def _projection_ps_rho(lat_toward_pole):
    """Distance from the pole (metres, scale 1 at the pole) of latitude ``lat``
    (degrees, positive toward the projection's pole)."""
    phi = math.radians(max(min(float(lat_toward_pole), 90.0), -89.999))
    s = math.sin(phi)
    t = math.tan(math.pi / 4.0 - phi / 2.0) / ((1.0 - _PS_E * s) / (1.0 + _PS_E * s)) ** (
        _PS_E / 2.0)
    return 2.0 * TM_WGS84_A * t / _PS_C


def _projection_ps_lat(rho):
    """Inverse of ``_projection_ps_rho``: latitude in degrees (toward the pole)."""
    t = float(rho) * _PS_C / (2.0 * TM_WGS84_A)
    phi = math.pi / 2.0 - 2.0 * math.atan(t)
    for _ in range(30):
        s = math.sin(phi)
        new = math.pi / 2.0 - 2.0 * math.atan(
            t * ((1.0 - _PS_E * s) / (1.0 + _PS_E * s)) ** (_PS_E / 2.0))
        if abs(new - phi) < 1e-15:
            phi = new
            break
        phi = new
    return math.degrees(phi)


def ps_scale(lat_toward_pole):
    """Linear scale of the polar stereographic (scale 1 at the pole) at a latitude."""
    phi = math.radians(min(abs(float(lat_toward_pole)), 90.0))
    if phi >= math.pi / 2.0 - 1e-12:
        return 1.0
    s = math.sin(phi)
    m = math.cos(phi) / math.sqrt(1.0 - _PS_E * _PS_E * s * s)
    return _projection_ps_rho(math.degrees(phi)) / (TM_WGS84_A * m)


def ps_forward(lon, lat, lon0, sign, k_ref=1.0):
    """Polar stereographic ``(x, y)`` in metres of ``(lon, lat)`` (degrees): pole
    ``sign`` (+1 north, -1 south), meridian ``lon0`` along the y axis with east
    +x and north +y on it (so ring orientation is kept), coordinates divided by
    ``k_ref`` (true scale where the scale equals ``k_ref``)."""
    rho = _projection_ps_rho(sign * float(lat)) / float(k_ref)
    lam = math.radians(_projection_wrap(float(lon) - float(lon0)))
    return rho * math.sin(lam), -sign * rho * math.cos(lam)


def ps_inverse(x, y, lon0, sign, k_ref=1.0):
    """Inverse of ``ps_forward``: ``(lon, lat)`` in degrees, ``lon`` within 180 of ``lon0``."""
    x, y = float(x) * float(k_ref), float(y) * float(k_ref)
    rho = math.hypot(x, y)
    lat = sign * _projection_ps_lat(rho)
    lam = math.atan2(x, -sign * y) if rho > 0.0 else 0.0
    return float(lon0) + math.degrees(lam), lat


def polar_probe_points(sign):
    """``[(lon, lat)]`` (WGS 84 degrees) to project into a system to test whether it is
    polar stereographic about the North (``sign`` 1) or South (-1) Pole: for each
    latitude of ``POLAR_PROBE_LATS``, the 4 longitudes of ``POLAR_PROBE_LONS``."""
    return [(lon, sign * lat) for lat in POLAR_PROBE_LATS for lon in POLAR_PROBE_LONS]


def is_polar_stereographic_probe(projected):
    """True when ``projected`` (the points of ``polar_probe_points`` in the same order,
    as ``(x, y)`` in the system tested; ``None`` or non-finite entries where a point
    could not be projected) is what a polar stereographic projection about that pole
    gives: every latitude on a circle round one common centre (the pole), the
    meridians 90 degrees apart, and the radii of the latitudes in the ratio of the
    stereographic formula (tolerance ``POLAR_PROBE_TOLERANCE``, relative)."""
    n = len(POLAR_PROBE_LONS)
    if projected is None or len(projected) != n * len(POLAR_PROBE_LATS):
        return False
    pts = []
    for p in projected:
        try:
            x, y = float(p[0]), float(p[1])
        except (TypeError, ValueError, IndexError):
            return False
        if not (math.isfinite(x) and math.isfinite(y)):
            return False
        pts.append((x, y))
    groups = [pts[i * n:(i + 1) * n] for i in range(len(POLAR_PROBE_LATS))]
    # Centre: midpoint of the opposite meridians (0 and 180, 90 and -90) of each latitude.
    mids = [((g[a][0] + g[a + 2][0]) / 2.0, (g[a][1] + g[a + 2][1]) / 2.0)
            for g in groups for a in (0, 1)]
    cx = sum(m[0] for m in mids) / len(mids)
    cy = sum(m[1] for m in mids) / len(mids)
    radii = []
    for g in groups:
        rs = [math.hypot(x - cx, y - cy) for x, y in g]
        r = sum(rs) / len(rs)
        if not r > 0.0 or any(abs(v - r) > POLAR_PROBE_TOLERANCE * r for v in rs):
            return False
        # Meridians 0 and 90 at a right angle round the pole.
        (x0, y0), (x1, y1) = g[0], g[1]
        dot = (x0 - cx) * (x1 - cx) + (y0 - cy) * (y1 - cy)
        if abs(dot) > POLAR_PROBE_TOLERANCE * rs[0] * rs[1]:
            return False
        radii.append(r)
    tol = POLAR_PROBE_TOLERANCE * radii[0]
    if any(math.hypot(m[0] - cx, m[1] - cy) > tol for m in mids):
        return False
    rho0 = _projection_ps_rho(POLAR_PROBE_LATS[0])
    for lat, r in zip(POLAR_PROBE_LATS[1:], radii[1:]):
        expected = _projection_ps_rho(lat) / rho0
        if abs((r / radii[0]) / expected - 1.0) > POLAR_PROBE_TOLERANCE:
            return False
    return True


def _projection_polar_sign(lats, width):
    """+1 / -1 when a feature is measured on a polar stereographic projection (all
    of it in one hemisphere and reaching beyond the UTM limits, 84N / 80S, or
    going round the pole above 60 degrees: more than 180 degrees of longitude),
    else 0."""
    if not lats:
        return 0
    if min(lats) >= 0.0 and (max(lats) > 84.0 or (width > 180.0 and min(lats) >= 60.0)):
        return 1
    if max(lats) <= 0.0 and (min(lats) < -80.0 or (width > 180.0 and max(lats) <= -60.0)):
        return -1
    return 0


def _projection_ps_node(node, lon0, sign, k_ref):
    if isinstance(node[0], (int, float)):
        x, y = ps_forward(node[0], node[1], lon0, sign, k_ref)
        return [x, y]
    return [_projection_ps_node(item, lon0, sign, k_ref) for item in node]


def _projection_lats(node, out):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            out.append(float(node[1]))
        else:
            for item in node:
                _projection_lats(item, out)


def local_ps_geometry(geom, lon0, sign):
    """Project a core geometry in degrees on the polar stereographic of pole
    ``sign`` with true scale at the feature: ``(geometry, k_ref, spread)``.

    ``k_ref`` is the geometric mean of the smallest and largest scale (scale 1 at
    the pole) over the vertices and the centre of the feature's extent (the pole
    itself for a feature around it); ``spread`` = largest / smallest scale, so
    the measures are within about ``spread - 1`` (area) of the truth."""
    lats = []
    _projection_lats(geom, lats)
    scales = [ps_scale(sign * lat) for lat in lats]
    raw = _projection_ps_node(geom, lon0, sign, 1.0)
    xs, ys = [], []
    _projection_xy(raw, xs, ys)
    cx, cy = (min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0
    scales.append(ps_scale(_projection_ps_lat(math.hypot(cx, cy))))
    k_min, k_max = min(scales), max(scales)
    k_ref = math.sqrt(k_min * k_max)
    return _projection_ps_node(geom, lon0, sign, k_ref), k_ref, k_max / k_min


def _projection_xy(node, xs, ys):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            xs.append(float(node[0]))
            ys.append(float(node[1]))
        else:
            for item in node:
                _projection_xy(item, xs, ys)


# A polar feature whose scale varies by more than this factor over it (largest /
# smallest, on its own polar stereographic) is measured with more than about 1 %
# area error: warning. 1.01 is reached by a feature from the pole to about 78 degrees.
PS_MAX_FEATURE_SPREAD = 1.01


def _projection_lonlats(node, out):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            out.append(float(node[0]))
        else:
            for item in node:
                _projection_lonlats(item, out)


def _projection_tm_node(node, lon0):
    if isinstance(node[0], (int, float)):
        x, y = tm_forward(node[0], node[1], lon0)
        return [x, y]
    return [_projection_tm_node(item, lon0) for item in node]


def local_tm_geometry(geom):
    """Project a core geometry in geographic degrees (a point ``[lon, lat]`` or
    nested lists of them) to the local Transverse Mercator of its own centre.

    Returns ``(projected geometry, lon0, width)``: ``lon0`` is the centre of the
    smallest longitude arc holding all vertices (works across the
    antimeridian), ``width`` that arc in degrees. ``(None, None, 0.0)`` for an
    empty geometry.
    """
    lons = []
    if geom:
        _projection_lonlats(geom, lons)
    if not lons:
        return None, None, 0.0
    _west, _east, lon0, width = longitude_span(lons)
    return _projection_tm_node(geom, lon0), lon0, width


def local_tm_point_to_lonlat(point, lon0, near_lon=None):
    """``[lon, lat]`` of a point ``(x, y)`` of ``local_tm_geometry``; the
    longitude is shifted by whole turns to be nearest ``near_lon`` (the
    feature's own longitudes, so data stored in 0..360 stays there)."""
    lon, lat = tm_inverse(point[0], point[1], lon0)
    if near_lon is not None:
        lon += 360.0 * round((float(near_lon) - lon) / 360.0)
    return [lon, lat]


# --------------------------------------------------------------------------
# Measuring plan of a tool (one UTM zone, or per-feature local TM)
# --------------------------------------------------------------------------

def choose_measuring(desc, metric_sr_for, collector, what, geographic_sr=None,
                     datum_as_info=False):
    """How to measure an input: ``{"read_sr", "wkid", "mpu", "local"}``.

    ``metric_sr_for`` is ``arcio.metric_sr_or_native`` (or ``arcio.metric_sr_for``,
    or any function ``desc -> (decision, spatial reference or None)``);
    ``collector`` a ``MessageCollector``. Pure: arcpy is only reached through
    the functions passed in.
    An input with no coordinates at all (empty, empty selection, only null
    geometries) keeps its own system: there is nothing to measure. A projected
    input keeps its own system (other inputs are projected into it by the
    cursor); otherwise a UTM zone is chosen from the data. An unknown system
    gives a warning and native units (``wkid`` ``None``, 1 metre per unit).

    Wide data (``local`` True): when the data needs projecting and spans more
    than ``MAX_UTM_ZONES_WITHOUT_WARNING`` UTM zones, one zone would measure
    features far from it with gross errors (area +100 % at 40 degrees from the
    central meridian). If ``geographic_sr`` (``arcpy.SpatialReference``) is
    given, the input is then read in geographic degrees (its own geographic
    system, or WGS 84 for Web Mercator) and every feature is measured on its
    own local Transverse Mercator (``local_tm_rows``); ``wkid`` is then the
    system of the degrees read, used to write points back.

    ``datum_as_info``: the decision's ``datum_warnings`` are shown as
    information, not warnings (for tools whose results go back through the
    same projection, so a datum shift cannot offset them).
    """
    sr_type = (desc["sr"] or {}).get("type")
    if sr_type not in ("Projected", "Geographic"):
        collector.warning(
            "The {0} has an unknown coordinate system, so it is read in its native "
            "coordinates and its units are taken as metres. Define the coordinate system "
            "(Define Projection) for reliable measurements.".format(what))
        return {"read_sr": desc["sr_object"], "wkid": None, "mpu": 1.0, "local": False}
    sr_name = (desc["sr"] or {}).get("name") or "unknown"
    # Polar stereographic input of any WKID (or none): recognised by ``arcio.sr_info``.
    polar_input = sr_type == "Projected" and bool((desc["sr"] or {}).get("polar_stereographic"))
    if geographic_sr is not None and polar_input:
        # Its own scale is not 1 near the pole (EPSG 3031/3995: 0.973 at 90 degrees; 3032:
        # true scale at 71S; 9354 IBCSO: 65S).
        collector.info(
            "The {0} is in a polar stereographic system ({1}) whose scale is not 1 near the "
            "pole, so it is read in WGS 84 geographic coordinates and each feature is measured "
            "on its own projection: polar stereographic with true scale at the feature for "
            "features beyond 84N / 80S, Transverse Mercator centred on the feature otherwise "
            "(WGS 84 ellipsoid).".format(what, sr_name))
        return {"read_sr": geographic_sr(WGS84_GCS_WKID), "wkid": WGS84_GCS_WKID, "mpu": 1.0,
                "local": True}
    decision, read_sr = metric_sr_for(desc)
    zones = decision.get("utm_zones") or 0
    polar = bool(decision.get("polar")) and decision.get("reproject")
    if geographic_sr is not None and decision.get("reproject") \
            and (zones > MAX_UTM_ZONES_WITHOUT_WARNING or polar):
        if sr_type == "Geographic":
            read_sr, wkid = desc["sr_object"], (desc["sr"] or {}).get("wkid")
            source = "its own geographic coordinates"
        else:
            read_sr, wkid = geographic_sr(WGS84_GCS_WKID), WGS84_GCS_WKID
            source = "WGS 84 geographic coordinates"
        if polar:
            collector.info(
                "The {0} ({1}) is not in a projected metric system and is polar data (centre "
                "{2}). The polar stereographic systems (EPSG 3995/3031) have their true scale at "
                "71 degrees and measure 2-3 % short near the pole, so the {0} is read in {3} and "
                "each feature is measured on its own projection: polar stereographic with true "
                "scale at the feature for features beyond 84N / 80S, Transverse Mercator "
                "centred on the feature otherwise (WGS 84 ellipsoid).".format(
                    what, sr_name, "north of 84N" if decision["wkid"] == ARCTIC_POLAR_WKID
                    else "south of 80S", source))
        else:
            collector.info(
                "The {0} ({1}) is not in a projected metric system and spans {2} UTM zones, too "
                "wide for one zone to measure accurately. It is read in {3} and each feature is "
                "measured on its own Transverse Mercator projection centred on the feature (WGS "
                "84 ellipsoid, true scale on its central meridian).".format(
                    what, sr_name, zones, source))
        return {"read_sr": read_sr, "wkid": wkid, "mpu": 1.0, "local": True}
    collector.info(decision["reason"])
    if polar:  # no per-feature measuring possible here: say what the bias is
        collector.warning(
            "Polar data is measured in {0} (EPSG {1}), whose true scale is at 71 degrees: "
            "lengths near the pole are up to 2.7 % and areas up to 5.4 % short.".format(
                "WGS 84 / Arctic Polar Stereographic" if decision["wkid"] == ARCTIC_POLAR_WKID
                else "WGS 84 / Antarctic Polar Stereographic", decision["wkid"]))
    as_info = (decision.get("datum_warnings") or []) if datum_as_info else []
    for text in decision["warnings"]:
        if text in as_info:
            collector.info(text.replace(
                " For exact positions project the input to a projected metric coordinate "
                "system first (Project tool, with the right geographic transformation).",
                " The results are written back through the same projection, so they are not "
                "offset."))
        else:
            collector.warning(text)
    if read_sr is None:
        read_sr = desc["sr_object"]
    return {"read_sr": read_sr, "wkid": decision["wkid"],
            "mpu": decision["meters_per_unit"], "local": False}


def local_tm_rows(rows, collector):
    """Rows ``{"oid", "shape", ...}`` in geographic degrees -> the same rows with
    ``shape`` projected on each feature's own local Transverse Mercator (metres).

    Returns ``(rows, frames)``; ``frames[oid] = (lon0, (lo, hi))`` turns a point of
    that feature back into degrees (``local_tm_point_back``): ``lo``/``hi`` are the
    smallest and largest longitude the feature stores, so points go back in the
    input's own longitude convention (-180..180 or 0..360). A feature with a
    vertex farther than ``TM_MAX_FEATURE_OFFSET_M`` from its central meridian
    (about 1,000 km) cannot be measured accurately on one projection: warning
    with its ObjectIDs.

    A feature near a pole (``_projection_polar_sign``: beyond 84N / 80S, or round
    the pole) is projected on a polar stereographic instead (``local_ps_geometry``,
    true scale at the feature); its frame is ``(lon0, (lo, hi), sign, k_ref)``. A
    polar feature whose scale varies by more than ``PS_MAX_FEATURE_SPREAD`` over
    it gets a warning.
    """
    out, frames, wide, polar_wide = [], {}, [], []
    for row in rows:
        new = dict(row)
        lons, lats = [], []
        if row["shape"]:
            _projection_lonlats(row["shape"], lons)
            _projection_lats(row["shape"], lats)
        if not lons:
            new["shape"] = None
            out.append(new)
            continue
        _west, _east, lon0, width = longitude_span(lons)
        stored = (min(lons), max(lons))  # stored range: the input's longitude convention
        sign = _projection_polar_sign(lats, width)
        if sign:
            shape, k_ref, spread = local_ps_geometry(row["shape"], lon0, sign)
            frames[row["oid"]] = (lon0, stored, sign, k_ref)
            if spread > PS_MAX_FEATURE_SPREAD:
                polar_wide.append(row["oid"])
        else:
            shape = _projection_tm_node(row["shape"], lon0)
            frames[row["oid"]] = (lon0, stored)
            if _projection_max_abs_x(shape) > TM_MAX_FEATURE_OFFSET_M:
                wide.append(row["oid"])
        new["shape"] = shape
        out.append(new)
    if polar_wide:
        collector.warning(
            "{0} polar feature(s) span too many degrees of latitude for one polar stereographic "
            "projection to measure them within about 1 % (ObjectIDs {1}). Split them, or "
            "project the input to an equal-area or equidistant system suited to them first."
            .format(len(polar_wide), ", ".join(str(o) for o in sorted(polar_wide)[:20]) +
                    (", ..." if len(polar_wide) > 20 else "")))
    if wide:
        collector.warning(
            "{0} feature(s) reach more than {1:,.0f} km from the central meridian of their own "
            "Transverse Mercator projection (ObjectIDs {2}); even on that projection their "
            "measures can be off by more than 1 %. Split them, or project the input to an "
            "equal-area or equidistant system suited to them first."
            .format(len(wide), TM_MAX_FEATURE_OFFSET_M / 1000.0, ", ".join(
                str(o) for o in sorted(wide)[:20]) + (", ..." if len(wide) > 20 else "")))
    return out, frames


def _projection_max_abs_x(node):
    """Largest ``|x|`` of the vertices of a projected core geometry (0 if empty)."""
    if not isinstance(node, (list, tuple)) or not node:
        return 0.0
    if isinstance(node[0], (int, float)):
        return abs(float(node[0]))
    return max(_projection_max_abs_x(item) for item in node)


def _projection_lon_into_range(lon, stored, lon0=None):
    """Shift ``lon`` by whole turns into the longitudes the feature stores.

    ``stored`` is ``(lo, hi)``, the smallest and largest stored longitude of the
    feature (a single number is taken as ``(x, x)``). The shift that puts ``lon``
    inside ``[lo, hi]``, or nearest to it, wins (RT7-A-1 / RT8-C-4: a point used
    to be wrapped toward the feature's first vertex, so a part across the
    antimeridian from it came back 360 degrees away). Ties (a point exactly on
    the antimeridian) keep the input's convention: -180..180 when every stored
    longitude is in it, else 0..360 when every one is in that, then the side of
    the feature's central meridian ``lon0`` (the point as projected back), then
    the shift nearest the middle of the stored range."""
    if isinstance(stored, (int, float)):
        lo = hi = float(stored)
    else:
        lo, hi = float(stored[0]), float(stored[1])
    if -180.0 <= lo and hi <= 180.0:
        window = (-180.0, 180.0)
    elif 0.0 <= lo and hi <= 360.0:
        window = (0.0, 360.0)
    else:
        window = None
    mid = (lo + hi) / 2.0
    base = float(lon) + 360.0 * round((mid - float(lon)) / 360.0)
    best, best_key = base, None
    for cand in (base - 360.0, base, base + 360.0):
        gap = max(lo - cand, cand - hi, 0.0)
        outside = 0 if window is None or window[0] - 1e-9 <= cand <= window[1] + 1e-9 else 1
        side = 0.0 if lon0 is None else round(abs(cand - float(lon)), 9)
        key = (round(gap, 9), outside, side, abs(cand - mid))
        if best_key is None or key < best_key:
            best, best_key = cand, key
    return best


def local_tm_point_back(point, frame):
    """A point of ``local_tm_rows`` back in the degrees read (``frame`` from it).

    The longitude is put in the range of the feature's own stored longitudes
    (``_projection_lon_into_range``), so it stays in the input's convention
    whichever part of a multipart or antimeridian-crossing feature it is on."""
    if point is None or frame is None:
        return point
    if len(frame) > 2:  # polar stereographic frame (lon0, (lo, hi), sign, k_ref)
        lon, lat = ps_inverse(point[0], point[1], frame[0], frame[2], frame[3])
    else:
        lon, lat = tm_inverse(point[0], point[1], frame[0])
    return [_projection_lon_into_range(lon, frame[1], frame[0]), lat]


def local_tm_point_to_frame(point, frame):
    """A point ``(lon, lat)`` in the degrees read projected on the plane of one
    feature of ``local_tm_rows`` (``frame`` from it): the inverse of
    ``local_tm_point_back``. Used to measure another input (e.g. points)
    against that feature on the feature's own projection."""
    if point is None or frame is None:
        return point
    if len(frame) > 2:  # polar stereographic frame (lon0, (lo, hi), sign, k_ref)
        x, y = ps_forward(point[0], point[1], frame[0], frame[2], frame[3])
    else:
        x, y = tm_forward(point[0], point[1], frame[0])
    return [x, y]


# ==========================================================================
# common/geom.py
# ==========================================================================
# Pure-Python planar geometry on the toolkit's core representation.
#
# Core representation (see ARCHITECTURE)::
#
#     point       (x, y)
#     multipoint  [(x, y), ...]
#     polyline    [path, ...]            path = [(x, y), ...]
#     polygon     [ring, ...]            ring = [(x, y), ..., first point again]
#     null/empty  None
#
# Polygon rings follow the Esri convention: outer rings clockwise, holes
# counter-clockwise. All measures are planar, in the units of the coordinates;
# project to a metric system first (see ``projection``).
#
# The geometry *kind* is one of ``"point"``, ``"multipoint"``, ``"polyline"``,
# ``"polygon"`` (lower case, as used in Esri JSON helpers below).

GEOM_POINT = "point"
GEOM_MULTIPOINT = "multipoint"
GEOM_POLYLINE = "polyline"
GEOM_POLYGON = "polygon"

_GEOM_SHAPE_TYPES = {"point": GEOM_POINT, "multipoint": GEOM_MULTIPOINT,
                     "polyline": GEOM_POLYLINE, "polygon": GEOM_POLYGON}


def kind_from_shape_type(shape_type):
    """Map a Describe ``shapeType`` (``"Polygon"``...) to a core kind.

    Returns ``None`` for unsupported types such as ``"MultiPatch"``.
    """
    return _GEOM_SHAPE_TYPES.get(str(shape_type or "").casefold())


# --------------------------------------------------------------------------
# Basic measures
# --------------------------------------------------------------------------

def iter_points(kind, geom):
    """Yield every vertex of a core geometry."""
    if geom is None:
        return
    if kind == GEOM_POINT:
        yield geom
    elif kind == GEOM_MULTIPOINT:
        for p in geom:
            yield p
    else:
        for part in geom:
            for p in part:
                yield p


def geometry_bbox(kind, geom):
    """``(xmin, ymin, xmax, ymax)`` or ``None`` for an empty geometry."""
    xs, ys = [], []
    for x, y in iter_points(kind, geom):
        xs.append(x)
        ys.append(y)
    if not xs:
        return None
    return (min(xs), min(ys), max(xs), max(ys))


def bbox_intersects(a, b, tolerance=0.0):
    """True if two bboxes overlap or touch (within ``tolerance``)."""
    if a is None or b is None:
        return False
    return not (a[2] + tolerance < b[0] or b[2] + tolerance < a[0]
                or a[3] + tolerance < b[1] or b[3] + tolerance < a[1])


def point_distance(a, b):
    return math.hypot(b[0] - a[0], b[1] - a[1])


def path_length(path):
    """Length of one path (or ring)."""
    return sum(point_distance(path[i], path[i + 1]) for i in range(len(path) - 1))


def polyline_length(paths):
    """Total length of a polyline (all parts)."""
    if not paths:
        return 0.0
    return sum(path_length(p) for p in paths)


def ring_signed_area(ring):
    """Shoelace signed area: positive for counter-clockwise rings.

    Coordinates are shifted to the first vertex first, which keeps full
    precision for data far from the origin (e.g. UTM northings near 10^7).
    """
    n = len(ring)
    if n < 3:
        return 0.0
    x0, y0 = ring[0]
    total = 0.0
    for i in range(n - 1):
        x1, y1 = ring[i][0] - x0, ring[i][1] - y0
        x2, y2 = ring[i + 1][0] - x0, ring[i + 1][1] - y0
        total += x1 * y2 - x2 * y1
    # An unclosed ring needs no extra term: after the shift its closing
    # segment ends at the origin, whose cross product is zero.
    return total / 2.0


def ring_is_clockwise(ring):
    """True for clockwise rings (Esri outer rings)."""
    return ring_signed_area(ring) < 0


def close_ring(ring):
    """Copy of ``ring`` with the first vertex repeated at the end if needed."""
    ring = [tuple(p) for p in ring]
    if ring and ring[0] != ring[-1]:
        ring.append(ring[0])
    return ring


def polygon_area(rings):
    """Area of a polygon (all parts, holes subtracted), always >= 0."""
    total = 0.0
    for outer, holes in group_rings(rings):
        total += abs(ring_signed_area(outer)) - sum(abs(ring_signed_area(h)) for h in holes)
    return max(total, 0.0)


def polygon_perimeter(rings):
    """Length of all rings (outer and holes), like ``SHAPE@LENGTH`` for polygons."""
    return sum(path_length(r) for r in (rings or []))


def geometry_length(kind, geom):
    """Length for lines, perimeter for polygons, 0 for points."""
    if geom is None:
        return 0.0
    if kind == GEOM_POLYLINE:
        return polyline_length(geom)
    if kind == GEOM_POLYGON:
        return polygon_perimeter(geom)
    return 0.0


def part_count(kind, geom):
    """Number of parts (points of a multipoint, paths, or outer rings)."""
    if geom is None:
        return 0
    if kind == GEOM_POINT:
        return 1
    if kind == GEOM_POLYGON:
        return len(group_rings(geom))
    return len(geom)


# --------------------------------------------------------------------------
# Rings, containment
# --------------------------------------------------------------------------

def point_on_segment(p, a, b, tolerance=1e-9):
    """True if ``p`` lies on segment ``a``-``b`` (within ``tolerance``)."""
    return point_segment_distance(p, a, b)[0] <= tolerance


def point_in_ring(p, ring, tolerance=1e-9):
    """``"in"``, ``"out"`` or ``"boundary"`` for a point and one ring (ray casting)."""
    x, y = p
    inside = False
    n = len(ring)
    for i in range(n - 1 if ring and ring[0] == ring[-1] else n):
        a = ring[i]
        b = ring[(i + 1) % n]
        if point_on_segment(p, a, b, tolerance):
            return "boundary"
        if (a[1] > y) != (b[1] > y):
            x_cross = a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
            if x < x_cross:
                inside = not inside
    return "in" if inside else "out"


class _GeomRingProbe(object):
    """``point_in_ring`` for many points against one large ring.

    The ring's edges are filed in horizontal bands, so a query only looks at
    the edges whose y range reaches the point (a ray crossing or a boundary
    hit needs exactly those). Same answers as ``point_in_ring``, at about
    the cost of the edges in one band instead of every edge.
    """

    def __init__(self, ring, tolerance=1e-9):
        self.ring = ring
        self.tolerance = tolerance
        n = len(ring)
        self.count = n - 1 if ring and ring[0] == ring[-1] else n
        ys = [p[1] for p in ring]
        self.y0, self.y1 = min(ys), max(ys)
        self.bands = max(1, self.count // 4)
        span = self.y1 - self.y0
        self.height = span / self.bands if span > 0 and math.isfinite(span) else 0.0
        if self.height <= 0:
            self.bands = 1
        self.edges = [[] for _ in range(self.bands)]
        for i in range(self.count):
            a, b = ring[i], ring[(i + 1) % n]
            lo, hi = self._band(min(a[1], b[1])), self._band(max(a[1], b[1]))
            for k in range(lo, hi + 1):
                self.edges[k].append(i)

    def _band(self, y):
        if self.height <= 0:
            return 0
        k = int(math.floor((y - self.y0) / self.height))
        return min(max(k, 0), self.bands - 1)

    def locate(self, p):
        """``"in"``, ``"out"`` or ``"boundary"`` (see ``point_in_ring``)."""
        x, y = p
        tol = self.tolerance
        if y < self.y0 - tol or y > self.y1 + tol:
            return "out"
        lo, hi = self._band(y - tol), self._band(y + tol)
        if lo == hi:
            candidates = self.edges[lo]
        else:
            seen = set()
            for k in range(lo, hi + 1):
                seen.update(self.edges[k])
            candidates = sorted(seen)
        ring, n = self.ring, len(self.ring)
        inside = False
        for i in candidates:
            a, b = ring[i], ring[(i + 1) % n]
            if (min(a[0], b[0]) - tol <= x <= max(a[0], b[0]) + tol
                    and min(a[1], b[1]) - tol <= y <= max(a[1], b[1]) + tol
                    and point_on_segment(p, a, b, tol)):
                return "boundary"
            if (a[1] > y) != (b[1] > y):
                x_cross = a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
                if x < x_cross:
                    inside = not inside
        return "in" if inside else "out"


# Rings with more vertices than this get a _GeomRingProbe in group_rings.
_GEOM_PROBE_MIN_VERTICES = 64


def _geom_ring_inside(inner, outer, probe=None):
    """True if ring ``inner`` lies inside ring ``outer`` (vertex test).

    Uses the first vertex that is not on the boundary of ``outer``; rings that
    share every vertex are treated as inside. ``probe`` is an optional
    ``_GeomRingProbe`` of ``outer`` (same answers, faster for large rings).
    """
    for p in inner:
        state = probe.locate(p) if probe is not None else point_in_ring(p, outer)
        if state != "boundary":
            return state == "in"
    return True


def group_rings(rings):
    """Group rings into polygons: ``[(outer, [holes...]), ...]``.

    Clockwise rings are outers and counter-clockwise rings are holes (Esri
    convention). Each hole is assigned to the smallest outer that contains it.
    A hole contained by no outer is kept as its own outer (bad orientation in
    the source), so no ring is ever lost. Degenerate rings (area 0) are
    treated as outers. Output order follows input order.

    Candidate outers for a hole come from a ``GridIndex`` of ring bboxes, so a
    multipart polygon with many parts and holes is not parts x holes ring
    tests (a ring can only contain a vertex of the hole if their bboxes meet,
    so the result is the same as testing every outer).
    """
    rings = [close_ring(r) for r in (rings or []) if len(r) >= 3]
    outers, holes = [], []
    for r in rings:
        (holes if ring_signed_area(r) > 0 else outers).append(r)
    groups = [(o, []) for o in outers]
    if not holes:
        return groups
    boxes = [_geom_ring_bbox(r) for r in rings]
    width = max(b[2] for b in boxes) - min(b[0] for b in boxes)
    height = max(b[3] for b in boxes) - min(b[1] for b in boxes)
    # About one grid cell per ring over the extent of all rings.
    cell = max(math.sqrt(width * height / len(rings)), max(width, height) / len(rings))
    index = GridIndex(cell if cell > 0 and math.isfinite(cell) else 1.0)
    areas = []
    for idx, o in enumerate(outers):
        index.insert(idx, _geom_ring_bbox(o))
        areas.append(abs(ring_signed_area(o)))
    # Banded edge index per large candidate ring, built on first use: one
    # outer with thousands of vertices and hundreds of holes (a coastline
    # with lakes) is then not holes x vertices segment tests (RT4-A-2).
    probes = {}
    for h in holes:
        box = _geom_ring_bbox(h)
        best, best_area = None, None
        for idx in index.query(box):  # ascending: ties keep the first outer
            outer = groups[idx][0]
            probe = probes.get(idx)
            if probe is None and len(outer) > _GEOM_PROBE_MIN_VERTICES:
                probe = probes[idx] = _GeomRingProbe(outer)
            if _geom_ring_inside(h, outer, probe):
                area = areas[idx]
                if best is None or area < best_area:
                    best, best_area = idx, area
        if best is None:
            index.insert(len(groups), box)
            areas.append(abs(ring_signed_area(h)))
            groups.append((h, []))
        else:
            groups[best][1].append(h)
    return groups


def _geom_ring_bbox(ring):
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    return (min(xs), min(ys), max(xs), max(ys))


def point_in_polygon(p, rings, include_boundary=True):
    """True if ``p`` is inside the polygon (holes excluded)."""
    for outer, holes in group_rings(rings):
        state = point_in_ring(p, outer)
        if state == "boundary":
            return include_boundary
        if state == "out":
            continue
        in_hole = False
        for h in holes:
            hs = point_in_ring(p, h)
            if hs == "boundary":
                return include_boundary
            if hs == "in":
                in_hole = True
                break
        if not in_hole:
            return True
    return False


# --------------------------------------------------------------------------
# Segments
# --------------------------------------------------------------------------

def point_segment_distance(p, a, b):
    """``(distance, closest_point, t)`` from ``p`` to segment ``a``-``b``.

    ``t`` is the position of the closest point along the segment (0..1).
    """
    ax, ay = a
    dx, dy = b[0] - ax, b[1] - ay
    seg2 = dx * dx + dy * dy
    if seg2 == 0.0:
        return point_distance(p, a), (ax, ay), 0.0
    t = ((p[0] - ax) * dx + (p[1] - ay) * dy) / seg2
    t = min(1.0, max(0.0, t))
    c = (ax + t * dx, ay + t * dy)
    return point_distance(p, c), c, t


def _geom_cross(o, a, b):
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])


def segment_intersection(a, b, c, d, tolerance=1e-12):
    """Intersection of segments ``a``-``b`` and ``c``-``d``.

    Returns ``None``, ``("point", (x, y))`` or ``("overlap", (p, q))`` for
    collinear overlapping segments (``p``-``q`` is the shared piece).
    """
    r = (b[0] - a[0], b[1] - a[1])
    s = (d[0] - c[0], d[1] - c[1])
    denom = r[0] * s[1] - r[1] * s[0]
    qp = (c[0] - a[0], c[1] - a[1])
    scale = max(1.0, abs(r[0]), abs(r[1]), abs(s[0]), abs(s[1]))
    if abs(denom) <= tolerance * scale * scale:
        # Parallel. Collinear?
        if abs(qp[0] * r[1] - qp[1] * r[0]) > tolerance * scale * scale:
            return None
        rr = r[0] * r[0] + r[1] * r[1]
        if rr == 0.0:
            if point_on_segment(a, c, d, tolerance * scale):
                return ("point", (a[0], a[1]))
            return None
        t0 = (qp[0] * r[0] + qp[1] * r[1]) / rr
        t1 = t0 + (s[0] * r[0] + s[1] * r[1]) / rr
        lo, hi = max(0.0, min(t0, t1)), min(1.0, max(t0, t1))
        if lo > hi + tolerance:
            return None
        p = (a[0] + lo * r[0], a[1] + lo * r[1])
        q = (a[0] + hi * r[0], a[1] + hi * r[1])
        if abs(hi - lo) <= tolerance:
            return ("point", p)
        return ("overlap", (p, q))
    t = (qp[0] * s[1] - qp[1] * s[0]) / denom
    u = (qp[0] * r[1] - qp[1] * r[0]) / denom
    eps = tolerance
    if -eps <= t <= 1 + eps and -eps <= u <= 1 + eps:
        return ("point", (a[0] + t * r[0], a[1] + t * r[1]))
    return None


def densify_path(path, max_segment):
    """Copy of ``path`` with extra vertices so no segment exceeds ``max_segment``."""
    if max_segment <= 0:
        raise ValueError("max_segment must be positive")
    if not path:
        return []
    out = [tuple(path[0])]
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        n = int(math.ceil(point_distance(a, b) / max_segment))
        for k in range(1, n):
            f = float(k) / n
            out.append((a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1])))
        out.append(tuple(b))
    return out


def densify_path_segments(path, max_segment, wrap_longitude=False):
    """Copy of ``path`` with extra vertices so no segment exceeds ``max_segment``,
    each segment densified on its own (original vertices kept).

    ``wrap_longitude`` (geographic data, x = longitude in degrees): a segment
    spanning more than 180 degrees of longitude is taken to cross the
    antimeridian the short way; its new vertices are interpolated on the
    unwrapped longitude and wrapped back into [-180, 180).
    """
    if max_segment <= 0:
        raise ValueError("max_segment must be positive")
    if not path:
        return []
    out = [tuple(path[0])]
    for i in range(len(path) - 1):
        a, b = tuple(path[i]), tuple(path[i + 1])
        bx = b[0]
        if wrap_longitude and abs(bx - a[0]) > 180.0:
            bx += -360.0 if bx > a[0] else 360.0
        n = int(math.ceil(math.hypot(bx - a[0], b[1] - a[1]) / max_segment))
        for k in range(1, n):
            f = float(k) / n
            x = a[0] + f * (bx - a[0])
            if wrap_longitude:
                x = ((x + 180.0) % 360.0) - 180.0
            out.append((x, a[1] + f * (b[1] - a[1])))
        out.append(b)
    return out


# --------------------------------------------------------------------------
# Spatial index
# --------------------------------------------------------------------------

class GridIndex(object):
    """Uniform grid of bounding boxes for fast candidate-pair search.

    ``insert(key, box)`` registers a bbox; ``query(box)`` returns keys whose
    bbox intersects ``box``; ``candidate_pairs()`` returns all ``(k1, k2)``
    with ``k1 < k2`` and intersecting bboxes, sorted. Keys must be orderable.
    Choose ``cell_size`` around the typical feature size (plus any search
    tolerance, which can be passed to ``query``/``candidate_pairs``).
    """

    def __init__(self, cell_size):
        if not cell_size or cell_size <= 0:
            raise ValueError("cell_size must be positive")
        self.cell_size = float(cell_size)
        self.cells = {}
        self.boxes = {}

    def _cells_for(self, box, tolerance=0.0):
        cs = self.cell_size
        x0 = int(math.floor((box[0] - tolerance) / cs))
        y0 = int(math.floor((box[1] - tolerance) / cs))
        x1 = int(math.floor((box[2] + tolerance) / cs))
        y1 = int(math.floor((box[3] + tolerance) / cs))
        for gx in range(x0, x1 + 1):
            for gy in range(y0, y1 + 1):
                yield (gx, gy)

    def insert(self, key, box):
        if box is None:
            return
        self.boxes[key] = box
        for cell in self._cells_for(box):
            self.cells.setdefault(cell, []).append(key)

    def query(self, box, tolerance=0.0):
        found = set()
        for cell in self._cells_for(box, tolerance):
            for key in self.cells.get(cell, ()):
                if key not in found and bbox_intersects(self.boxes[key], box, tolerance):
                    found.add(key)
        return sorted(found)

    def candidate_pairs(self, tolerance=0.0):
        pairs = set()
        for keys in self.cells.values():
            for i in range(len(keys)):
                for j in range(i + 1, len(keys)):
                    k1, k2 = keys[i], keys[j]
                    if k1 == k2:
                        continue
                    if k2 < k1:
                        k1, k2 = k2, k1
                    if (k1, k2) not in pairs and bbox_intersects(
                            self.boxes[k1], self.boxes[k2], tolerance):
                        pairs.add((k1, k2))
        if tolerance > 0:
            # Boxes closer than the tolerance may sit in non-adjacent-by-content cells.
            for k1, box in self.boxes.items():
                for k2 in self.query(box, tolerance):
                    if k1 < k2:
                        pairs.add((k1, k2))
        return sorted(pairs)


# --------------------------------------------------------------------------
# Esri JSON <-> core
# --------------------------------------------------------------------------

def esri_json_has_curves(data):
    """True if an Esri JSON geometry dict contains true curves."""
    return isinstance(data, dict) and ("curvePaths" in data or "curveRings" in data)


def esri_json_zm(data):
    """``(has_z, has_m)`` of an Esri JSON geometry dict.

    Esri JSON marks Z and M with ``"hasZ": true`` / ``"hasM": true``. When neither key is
    present a coordinate with three numbers is read as Z. ``esri_json_to_core`` drops both."""
    if not isinstance(data, dict):
        return False, False
    has_z, has_m = data.get("hasZ") is True, data.get("hasM") is True
    if "hasZ" in data or "hasM" in data:
        return has_z, has_m
    first = None
    for key in ("rings", "paths"):
        parts = data.get(key)
        if parts and parts[0]:
            first = parts[0][0]
            break
    if first is None and data.get("points"):
        first = data["points"][0]
    return (first is not None and len(first) >= 3), False


def _geom_xy(coord):
    return (float(coord[0]), float(coord[1]))


def _geom_is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def esri_json_to_core(data):
    """Convert an Esri JSON geometry dict to ``(kind, geom)``.

    Z and M values are dropped. Empty geometries give ``(kind, None)``.
    Raises ``ValueError`` for curves (handle them before calling) and for
    unknown structures.
    """
    if data is None:
        return None, None
    if esri_json_has_curves(data):
        raise ValueError("true curves must be densified before conversion")
    if "x" in data:
        x, y = data.get("x"), data.get("y")
        if not (_geom_is_number(x) and _geom_is_number(y)):
            return GEOM_POINT, None
        return GEOM_POINT, (float(x), float(y))
    if "points" in data:
        pts = [_geom_xy(c) for c in data["points"]]
        return GEOM_MULTIPOINT, (pts or None)
    if "paths" in data:
        paths = [[_geom_xy(c) for c in path] for path in data["paths"]]
        paths = [p for p in paths if p]
        return GEOM_POLYLINE, (paths or None)
    if "rings" in data:
        rings = [close_ring([_geom_xy(c) for c in ring]) for ring in data["rings"]]
        rings = [r for r in rings if r]
        return GEOM_POLYGON, (rings or None)
    raise ValueError("unsupported Esri JSON geometry: keys {0}".format(sorted(data)))


def core_to_esri_json(kind, geom, wkid=None):
    """Convert a core geometry to an Esri JSON dict (for ``arcpy.AsShape(d, True)``).

    Returns ``None`` for a null geometry.
    """
    if geom is None:
        return None
    if kind == GEOM_POINT:
        data = {"x": float(geom[0]), "y": float(geom[1])}
    elif kind == GEOM_MULTIPOINT:
        data = {"points": [[float(x), float(y)] for (x, y) in geom]}
    elif kind == GEOM_POLYLINE:
        data = {"paths": [[[float(x), float(y)] for (x, y) in path] for path in geom]}
    elif kind == GEOM_POLYGON:
        data = {"rings": [[[float(x), float(y)] for (x, y) in close_ring(r)] for r in geom]}
    else:
        raise ValueError("unknown geometry kind: {0}".format(kind))
    if wkid:
        data["spatialReference"] = {"wkid": int(wkid)}
    return data


# --------------------------------------------------------------------------
# Vertex angles, segment lengths, spikes
# --------------------------------------------------------------------------

def _geom_distinct_ring(path):
    """Ring vertices without the closing duplicate."""
    pts = [tuple(p) for p in path]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    return pts


def vertex_angle(a, b, c):
    """Interior angle at ``b`` between legs ``b->a`` and ``b->c`` in degrees
    (0..180). ``None`` if a leg has zero length. 0 = spike (the line turns
    back on itself), 180 = straight."""
    v1 = (a[0] - b[0], a[1] - b[1])
    v2 = (c[0] - b[0], c[1] - b[1])
    if (v1[0] == 0.0 and v1[1] == 0.0) or (v2[0] == 0.0 and v2[1] == 0.0):
        return None
    cross = v1[0] * v2[1] - v1[1] * v2[0]
    dot = v1[0] * v2[0] + v1[1] * v2[1]
    return math.degrees(math.atan2(abs(cross), dot))


def turn_angle(a, b, c):
    """Signed change of direction at ``b`` in degrees, in (-180, 180]:
    positive = left (counter-clockwise) turn, 0 = straight on.
    ``None`` if a leg has zero length."""
    d1 = (b[0] - a[0], b[1] - a[1])
    d2 = (c[0] - b[0], c[1] - b[1])
    if (d1[0] == 0.0 and d1[1] == 0.0) or (d2[0] == 0.0 and d2[1] == 0.0):
        return None
    cross = d1[0] * d2[1] - d1[1] * d2[0]
    dot = d1[0] * d2[0] + d1[1] * d2[1]
    ang = math.degrees(math.atan2(cross, dot))
    return 180.0 if ang == -180.0 else ang


def path_is_closed(path):
    """True if the path has at least 4 points and first == last."""
    return len(path) >= 4 and tuple(path[0]) == tuple(path[-1])


def path_vertex_angles(path, closed=None, signed=False):
    """Angle at every vertex: ``vertex_angle`` (or ``turn_angle`` if ``signed``).

    ``closed=None`` detects rings (``path_is_closed``). Open path: one value
    per vertex, ``None`` at both ends. Ring: one value per *distinct*
    vertex (the closing duplicate is not repeated); the first vertex uses
    the last distinct vertex as its predecessor. Zero-length legs give
    ``None`` (remove duplicate vertices first if needed).
    """
    fn = turn_angle if signed else vertex_angle
    if closed is None:
        closed = path_is_closed(path)
    if closed:
        pts = _geom_distinct_ring(path)
        n = len(pts)
        if n < 3:
            return [None] * n
        return [fn(pts[i - 1], pts[i], pts[(i + 1) % n]) for i in range(n)]
    pts = [tuple(p) for p in path]
    n = len(pts)
    out = [None] * n
    for i in range(1, n - 1):
        out[i] = fn(pts[i - 1], pts[i], pts[i + 1])
    return out


def segment_lengths(path):
    """Length of every segment of ``path`` (``len(path) - 1`` values)."""
    return [point_distance(path[i], path[i + 1]) for i in range(len(path) - 1)]


def segment_length_stats(path):
    """``{"count", "min", "max", "mean", "total"}`` of the segment lengths
    (``None`` values for a path with no segment)."""
    lengths = segment_lengths(path)
    if not lengths:
        return {"count": 0, "min": None, "max": None, "mean": None, "total": 0.0}
    total = sum(lengths)
    return {"count": len(lengths), "min": min(lengths), "max": max(lengths),
            "mean": total / len(lengths), "total": total}


def find_spikes(path, max_angle, closed=None):
    """Vertex indices whose interior angle is below ``max_angle`` degrees.

    Indices refer to ``path`` (for rings: distinct vertices, index 0 = the
    start/closing vertex). Zero-length legs are not spikes (see
    ``near_duplicate_vertices``).
    """
    return [i for i, ang in enumerate(path_vertex_angles(path, closed))
            if ang is not None and ang < max_angle]


def near_duplicate_vertices(path, tolerance):
    """Indices ``i`` where vertex ``i`` and the next vertex are at most
    ``tolerance`` apart (exact duplicates included). For a ring the closing
    duplicate itself is not reported, but the pair (last distinct, first)
    is checked and reported as the last distinct index."""
    closed = path_is_closed(path)
    pts = _geom_distinct_ring(path) if closed else [tuple(p) for p in path]
    n = len(pts)
    out = [i for i in range(n - 1) if point_distance(pts[i], pts[i + 1]) <= tolerance]
    if closed and n > 1 and point_distance(pts[-1], pts[0]) <= tolerance:
        out.append(n - 1)
    return out


def remove_repeated_vertices(path, tolerance=0.0):
    """Copy of ``path`` without vertices within ``tolerance`` of the previous
    kept vertex. The first and last vertex are always kept (the last one
    replaces a kept vertex that is too close to it)."""
    pts = [tuple(p) for p in path]
    if len(pts) < 2:
        return pts
    out = [pts[0]]
    for p in pts[1:]:
        if point_distance(out[-1], p) > tolerance:
            out.append(p)
    if len(out) == 1:
        out.append(pts[-1])
    elif out[-1] != pts[-1]:
        out[-1] = pts[-1]
    return out


# --------------------------------------------------------------------------
# Measures along a path, interpolation, splitting
# --------------------------------------------------------------------------

def path_measures(path):
    """Cumulative distance at every vertex (first = 0; empty path -> [])."""
    if not path:
        return []
    out = [0.0]
    for i in range(len(path) - 1):
        out.append(out[-1] + point_distance(path[i], path[i + 1]))
    return out


def path_point_at(path, distance):
    """Point at ``distance`` along ``path``, clamped to [0, length].
    ``None`` for an empty path."""
    if not path:
        return None
    if distance <= 0 or len(path) == 1:
        return tuple(path[0])
    run = 0.0
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        seg = point_distance(a, b)
        if seg > 0 and run + seg >= distance:
            f = (distance - run) / seg
            return (a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1]))
        run += seg
    return tuple(path[-1])


def path_midpoint(path):
    """Point at half the length of ``path``."""
    return path_point_at(path, path_length(path) / 2.0)


def locate_point_on_path(p, path):
    """Project ``p`` onto ``path``.

    Returns ``{"measure", "offset", "side", "segment", "point"}``: distance
    along the path of the closest point, distance from ``p`` to it, side
    ``"L"`` or ``"R"`` of the digitising direction (``""`` when on the line),
    the segment index and the closest point. The first closest segment wins
    on ties. ``None`` for a path with fewer than 2 vertices.
    """
    if len(path) < 2:
        return None
    best = None
    run = 0.0
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        d, c, t = point_segment_distance(p, a, b)
        seg = point_distance(a, b)
        if best is None or d < best[0]:
            cross = _geom_cross(a, b, p)
            side = "" if d == 0.0 or cross == 0.0 else ("L" if cross > 0 else "R")
            best = (d, run + t * seg, side, i, c)
        run += seg
    return {"offset": best[0], "measure": best[1], "side": best[2], "segment": best[3],
            "point": best[4]}


def split_path_at_distances(path, distances, min_length=0.0):
    """Split ``path`` at the given distances along it.

    Distances outside (0, length) are ignored and duplicates merged. Each
    piece keeps the original vertices between its cut points; the first and
    last piece end exactly on the original end vertices. Pieces not longer
    than ``min_length`` (default: zero-length pieces) are dropped.
    """
    pts = [tuple(p) for p in path]
    if len(pts) < 2:
        return []
    total = path_length(pts)
    cuts = sorted(set(float(d) for d in distances if 0.0 < d < total))
    measures = path_measures(pts)
    bounds = [0.0] + cuts + [total]
    pieces = []
    last = len(bounds) - 2
    for k in range(len(bounds) - 1):
        lo, hi = bounds[k], bounds[k + 1]
        piece = [pts[0] if k == 0 else path_point_at(pts, lo)]
        for i in range(1, len(pts) - 1):
            if lo < measures[i] < hi:
                piece.append(pts[i])
        piece.append(pts[-1] if k == last else path_point_at(pts, hi))
        if path_length(piece) > min_length:
            pieces.append(piece)
    return pieces


def split_path_at_vertices(path, min_length=0.0):
    """One two-point piece per segment; pieces not longer than ``min_length``
    (default: zero-length segments) are dropped."""
    pts = [tuple(p) for p in path]
    return [[pts[i], pts[i + 1]] for i in range(len(pts) - 1)
            if point_distance(pts[i], pts[i + 1]) > min_length]


def split_distances(length, max_length, mode="fixed"):
    """Cut distances so that no piece exceeds ``max_length``.

    ``"fixed"``: cuts at ``max_length``, ``2*max_length``, ... (the last piece
    is the remainder); ``"equal"``: ``ceil(length / max_length)`` equal
    pieces. A remainder shorter than 1e-9 * ``max_length`` is not cut off.
    """
    if max_length <= 0:
        raise ValueError("max_length must be positive")
    if mode not in ("fixed", "equal"):
        raise ValueError("mode must be 'fixed' or 'equal'")
    if length <= max_length * (1 + 1e-9):
        return []
    if mode == "equal":
        n = int(math.ceil(length / max_length - 1e-9))
        return [length * k / n for k in range(1, n)]
    eps = 1e-9 * max_length
    out = []
    k = 1
    while k * max_length < length - eps:
        out.append(k * max_length)
        k += 1
    return out


# ==========================================================================
# common/clip.py
# ==========================================================================
# Convex clipping and polygon centroids (pure Python).
#
# * Half-plane clipping of one ring (one Sutherland-Hodgman stage), the
#   bisector half-plane of two sites (Voronoi cells by successive clipping),
#   clipping against an axis-aligned rectangle or any convex ring.
# * Cyrus-Beck clipping of a segment against a convex ring (interior overlap
#   tests: a segment that only runs along the boundary has zero inside length
#   only if callers use ``strict=True``).
# * Ring / polygon centroids (area-weighted, holes subtracted).
#
# Deliberately **no general polygon-polygon overlay**. The subject ring may be
# concave when the clip region is convex; a concave subject can then produce
# zero-width "bridges" along the clip boundary (standard Sutherland-Hodgman
# behaviour): area and centroid stay correct, the vertex list is not
# simplified. Output rings are closed (first == last) and keep the
# orientation of the input ring; ``[]`` means nothing is left.
#
# A half-plane ``(a, b, c)`` is the set of points with ``a*x + b*y <= c``.

# Relative tolerance for "on the clip line" decisions.
CLIP_EPSILON = 1e-12


def _clip_open(ring):
    pts = [tuple(p) for p in ring]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    return pts


def _clip_finish(pts):
    """Drop consecutive duplicates; close; ``[]`` if fewer than 3 vertices."""
    out = []
    for p in pts:
        if not out or p != out[-1]:
            out.append(p)
    if len(out) > 1 and out[0] == out[-1]:
        out.pop()
    if len(out) < 3:
        return []
    return close_ring(out)


def clip_ring_halfplane(ring, a, b, c):
    """Keep the part of ``ring`` with ``a*x + b*y <= c`` (one Sutherland-Hodgman stage).

    Vertices within a relative tolerance of the line count as inside.
    Returns a closed ring or ``[]``.
    """
    pts = _clip_open(ring)
    if not pts:
        return []
    scale = max(1.0, abs(c), max(abs(a * x) + abs(b * y) for x, y in pts))
    eps = CLIP_EPSILON * scale
    vals = [a * x + b * y - c for x, y in pts]
    out = []
    n = len(pts)
    for i in range(n):
        p, q = pts[i], pts[(i + 1) % n]
        vp, vq = vals[i], vals[(i + 1) % n]
        p_in, q_in = vp <= eps, vq <= eps
        if p_in:
            out.append(p)
        if p_in != q_in and abs(vp - vq) > 0:
            t = vp / (vp - vq)
            if 0.0 < t < 1.0:
                out.append((p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])))
    return _clip_finish(out)


def bisector_halfplane(site, other):
    """Half-plane of points at least as close to ``site`` as to ``other``.

    ``|x - s|^2 <= |x - o|^2``  <=>  ``2(o - s) . x <= |o|^2 - |s|^2``.
    Raises ``ValueError`` for identical sites.
    """
    sx, sy = site
    ox, oy = other
    if sx == ox and sy == oy:
        raise ValueError("identical sites have no bisector")
    a = 2.0 * (ox - sx)
    b = 2.0 * (oy - sy)
    c = (ox * ox + oy * oy) - (sx * sx + sy * sy)
    return a, b, c


def rect_ring(xmin, ymin, xmax, ymax, clockwise=True):
    """Closed rectangle ring (clockwise = Esri outer ring by default)."""
    if clockwise:
        pts = [(xmin, ymin), (xmin, ymax), (xmax, ymax), (xmax, ymin)]
    else:
        pts = [(xmin, ymin), (xmax, ymin), (xmax, ymax), (xmin, ymax)]
    return close_ring(pts)


def clip_ring_rect(ring, xmin, ymin, xmax, ymax):
    """Sutherland-Hodgman clip of ``ring`` against an axis-aligned rectangle."""
    if xmin > xmax or ymin > ymax:
        raise ValueError("empty rectangle")
    out = ring
    for a, b, c in ((-1.0, 0.0, -xmin), (1.0, 0.0, xmax), (0.0, -1.0, -ymin), (0.0, 1.0, ymax)):
        out = clip_ring_halfplane(out, a, b, c)
        if not out:
            return []
    return out


def ring_is_convex(ring, tolerance=1e-9):
    """True if ``ring`` is convex (collinear vertices allowed, any orientation).

    Degenerate rings (fewer than 3 distinct vertices or zero area) are not convex.

    A vertex counts as collinear (no turn) only if the sine of its turn angle
    is at most ``tolerance`` (``|cross| <= tolerance * |e1| * |e2|``), plus a
    floating-point floor of ``CLIP_EPSILON * max|coordinate| * (|e1| + |e2|)``
    (a vertex within about 1e-12 of the coordinate size of the line through its
    neighbours). The test is relative to the edge lengths, not to the square
    of the coordinates: a densified edge that is slightly concave (a parallel
    projected to UTM, with a vertex every few hundred metres) turns by a tiny
    angle at each vertex but is still concave, and must be refused, however
    finely it is densified.
    """
    pts = _clip_open(ring)
    n = len(pts)
    if n < 3 or ring_signed_area(close_ring(pts)) == 0.0:
        return False
    floor = CLIP_EPSILON * max(1.0, max(max(abs(x), abs(y)) for x, y in pts))
    sign = 0
    for i in range(n):
        o, p, q = pts[i], pts[(i + 1) % n], pts[(i + 2) % n]
        ux, uy = p[0] - o[0], p[1] - o[1]
        vx, vy = q[0] - p[0], q[1] - p[1]
        cross = ux * vy - uy * vx
        lu, lv = math.hypot(ux, uy), math.hypot(vx, vy)
        if abs(cross) <= tolerance * lu * lv + floor * (lu + lv):
            continue
        s = 1 if cross > 0 else -1
        if sign == 0:
            sign = s
        elif s != sign:
            return False
    # A star polygon turns the same way at every vertex but winds twice.
    total = 0.0
    for i in range(n):
        o, p, q = pts[i - 1], pts[i], pts[(i + 1) % n]
        a1 = math.atan2(p[1] - o[1], p[0] - o[0])
        a2 = math.atan2(q[1] - p[1], q[0] - p[0])
        d = a2 - a1
        while d <= -math.pi:
            d += 2 * math.pi
        while d > math.pi:
            d -= 2 * math.pi
        total += d
    return abs(abs(total) - 2 * math.pi) < 1e-6


def _clip_hull_indexes(pts):
    """Indexes of the strict convex hull of ``pts`` (Andrew's monotone chain),
    counter-clockwise, collinear and duplicate points left out."""
    order = sorted(range(len(pts)), key=lambda i: pts[i])

    def cross(o, a, b):
        return ((pts[a][0] - pts[o][0]) * (pts[b][1] - pts[o][1]) -
                (pts[a][1] - pts[o][1]) * (pts[b][0] - pts[o][0]))

    lower, upper = [], []
    for i in order:
        while len(lower) >= 2 and cross(lower[-2], lower[-1], i) <= 0:
            lower.pop()
        lower.append(i)
    for i in reversed(order):
        while len(upper) >= 2 and cross(upper[-2], upper[-1], i) <= 0:
            upper.pop()
        upper.append(i)
    hull = lower[:-1] + upper[:-1]
    out = []
    for i in hull:  # duplicates of the first point can survive at both ends
        if not out or pts[i] != pts[out[-1]]:
            out.append(i)
    if len(out) > 1 and pts[out[0]] == pts[out[-1]]:
        out.pop()
    return out


def convex_hull_points(points):
    """Strict convex hull of ``points`` (``(x, y)`` tuples), counter-clockwise,
    open (first point not repeated); fewer than 3 points when they are collinear."""
    pts = sorted(set(tuple(p) for p in points))
    return [pts[i] for i in _clip_hull_indexes(pts)]


def near_convex_ring(ring, tolerance):
    """The convex hull of ``ring`` when the ring is convex up to ``tolerance``, else ``None``.

    ``tolerance`` is an absolute distance (coordinate units). The ring is accepted
    when (a) it runs around its convex hull in the hull's order (no star polygon, no
    loop) and (b) every vertex lies at most ``tolerance`` inside the hull edge of the
    stretch it belongs to. So the region between the ring and its hull is never
    deeper than ``tolerance``, however finely an edge is densified: a densified edge
    that bows inwards by more than ``tolerance`` anywhere is refused, while
    vertices on a straight edge that were rounded to the geodatabase resolution
    (a few 0.01 mm off the line) are accepted. The returned ring is the hull,
    closed, in the orientation of the input ring; it is exactly convex, so
    clipping with its half-planes is exact; its vertices are the hull vertices in
    the ring's own order, starting with the first of them in the ring (a strictly
    convex ring comes back unchanged, closed). Degenerate rings (fewer than 3
    distinct vertices, zero area) give ``None``.
    """
    pts = []
    for p in _clip_open(ring):
        if not pts or p != pts[-1]:
            pts.append(p)
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts.pop()
    n = len(pts)
    if n < 3:
        return None
    area = ring_signed_area(close_ring(pts))
    if area == 0.0:
        return None
    hull = _clip_hull_indexes(pts)
    if len(hull) < 3:
        return None
    # Position of every vertex along the ring, walked counter-clockwise (as the hull).
    if area > 0:
        pos = list(range(n))
    else:
        pos = [n - 1 - i for i in range(n)]
    walk = sorted(range(n), key=lambda i: pos[i])
    hpos = [pos[i] for i in hull]
    descents = sum(1 for k in range(len(hull)) if hpos[(k + 1) % len(hull)] < hpos[k])
    if descents != 1:
        return None  # the ring does not go round its hull once, in order
    for k in range(len(hull)):
        a, b = pts[hull[k]], pts[hull[(k + 1) % len(hull)]]
        ex, ey = b[0] - a[0], b[1] - a[1]
        length = math.hypot(ex, ey)
        if length == 0.0:
            continue
        start, end = hpos[k], hpos[(k + 1) % len(hull)]
        steps = (end - start) % n
        for s in range(1, steps):
            p = pts[walk[(start + s) % n]]
            # Left of a counter-clockwise hull edge = inside; depth below the edge.
            depth = (ex * (p[1] - a[1]) - ey * (p[0] - a[0])) / length
            if depth > tolerance:
                return None
    # Hull vertices in the ring's own order, starting at the first one met along the
    # ring, so a ring that is already strictly convex comes back unchanged.
    keep = sorted(hull)
    return close_ring([pts[i] for i in keep])


def convex_halfplanes(convex_ring):
    """The half-planes ``(a, b, c)`` whose intersection is ``convex_ring``
    (either orientation; zero-length edges skipped)."""
    pts = _clip_open(convex_ring)
    ccw = ring_signed_area(close_ring(pts)) > 0
    planes = []
    n = len(pts)
    for i in range(n):
        p, q = pts[i], pts[(i + 1) % n]
        dx, dy = q[0] - p[0], q[1] - p[1]
        if dx == 0.0 and dy == 0.0:
            continue
        # Inside is to the left of each edge for a CCW ring: cross(d, x - p) >= 0
        # <=> dy*x - dx*y <= dy*px - dx*py.
        a, b = dy, -dx
        if not ccw:
            a, b = -a, -b
        planes.append((a, b, a * p[0] + b * p[1]))
    return planes


def clip_ring_convex(ring, convex_ring):
    """Clip ``ring`` against a convex ring (``ValueError`` if not convex)."""
    if not ring_is_convex(convex_ring):
        raise ValueError("clip ring is not convex")
    out = ring
    for a, b, c in convex_halfplanes(convex_ring):
        out = clip_ring_halfplane(out, a, b, c)
        if not out:
            return []
    return out


def clip_segment_convex(p, q, convex_ring, strict=False):
    """Cyrus-Beck: the part of segment ``p``-``q`` inside a convex ring.

    Returns ``(t0, t1)`` parameters along the segment (0..1) or ``None``.
    ``strict=True`` uses the open interior: a segment lying on the boundary
    (or touching it at one point) gives ``None``. Tolerance is relative to
    the coordinate scale.
    """
    planes = convex_halfplanes(convex_ring)
    if not planes:
        return None
    dx, dy = q[0] - p[0], q[1] - p[1]
    scale = max(1.0, abs(p[0]), abs(p[1]), abs(q[0]), abs(q[1]))
    t0, t1 = 0.0, 1.0
    for a, b, c in planes:
        norm = math.hypot(a, b)
        eps = CLIP_EPSILON * scale * norm * 1e3
        num = c - (a * p[0] + b * p[1])     # >= 0 when p is inside
        den = a * dx + b * dy
        if strict:
            num -= eps
        else:
            num += eps
        if den == 0.0:
            if num < 0:
                return None
            continue
        t = num / den
        if den > 0:
            t1 = min(t1, t)
        else:
            t0 = max(t0, t)
        if t0 > t1:
            return None
    if strict and t1 - t0 <= 0.0:
        return None
    return (t0, t1)


def segment_inside_length(p, q, convex_ring, strict=True):
    """Length of segment ``p``-``q`` inside a convex ring (0.0 if none);
    ``strict`` as in ``clip_segment_convex``."""
    hit = clip_segment_convex(p, q, convex_ring, strict)
    if hit is None:
        return 0.0
    return (hit[1] - hit[0]) * math.hypot(q[0] - p[0], q[1] - p[1])


# --------------------------------------------------------------------------
# Centroids
# --------------------------------------------------------------------------

def ring_centroid(ring):
    """``(cx, cy, signed_area)`` of a ring (shoelace, shifted to the first
    vertex for precision). A zero-area ring gives the mean of its distinct
    vertices and area 0; an empty ring ``None``."""
    pts = _clip_open(ring)
    if not pts:
        return None
    x0, y0 = pts[0]
    n = len(pts)
    a2 = 0.0
    cx = cy = 0.0
    for i in range(n):
        x1, y1 = pts[i][0] - x0, pts[i][1] - y0
        x2, y2 = pts[(i + 1) % n][0] - x0, pts[(i + 1) % n][1] - y0
        cross = x1 * y2 - x2 * y1
        a2 += cross
        cx += (x1 + x2) * cross
        cy += (y1 + y2) * cross
    if a2 == 0.0:
        return (sum(p[0] for p in pts) / n, sum(p[1] for p in pts) / n, 0.0)
    return (x0 + cx / (3.0 * a2), y0 + cy / (3.0 * a2), a2 / 2.0)


def polygon_centroid(rings):
    """Area-weighted centroid ``(x, y)`` of a polygon (all parts, holes
    subtracted; ring orientation is taken from ``group_rings``, not from
    the sign of each ring). ``None`` for an empty polygon; a polygon of
    zero area gives the mean of its outer-ring vertices."""
    groups = group_rings(rings)
    if not groups:
        return None
    sx = sy = total = 0.0
    for outer, holes in groups:
        for ring, sign in [(outer, 1.0)] + [(h, -1.0) for h in holes]:
            cx, cy, a = ring_centroid(ring)
            w = sign * abs(a)
            sx += cx * w
            sy += cy * w
            total += w
    if total == 0.0:
        pts = [p for outer, _h in groups for p in _clip_open(outer)]
        return (sum(p[0] for p in pts) / len(pts), sum(p[1] for p in pts) / len(pts))
    return (sx / total, sy / total)


# ==========================================================================
# common/anchor.py
# ==========================================================================
# Pole of inaccessibility (label anchor) for polygons, pure Python.
#
# The pole of inaccessibility is the interior point farthest from the polygon
# boundary (holes included); its distance to the boundary is the radius of the
# largest inscribed circle. Implemented from the published description of the
# "polylabel" algorithm (Agafonkin, Mapbox blog, 2016): cover the bounding box
# with square cells, keep them in a priority queue ordered by the best distance
# any point of the cell could reach (centre distance + half diagonal), split the
# most promising cell into four, and stop exploring a cell once it cannot beat
# the best point found by more than ``precision``. No code was copied.
#
# Guarantee: the returned distance is within the *effective* precision of the
# true maximum (up to the cell budget, see ``ANCHOR_MAX_CELLS``). The effective
# precision is ``max(precision, ANCHOR_REL_PRECISION x the larger bbox side)``
# (``effective_precision``), so long strips cannot exhaust the cell budget;
# the first cells are never smaller than that precision, so thin slivers do not
# start with length / width cells either.
# Polygons with many edges measure distances through a ``SegmentGrid`` (same
# results as a full scan, without scanning every edge for every cell). The
# returned point is always inside the polygon when the polygon has an interior.
#
# Multipart polygons (``polygon_anchor``): the pole of the **largest part by
# area** (outer ring minus its holes) is returned; ties keep the first part in
# input order. This is decided once for every feature, so labels of multipart
# features always sit in their main part.

# Safety cap on the number of cells examined (precision far below the polygon
# size would otherwise explode); when reached, the best point so far is
# returned and ``polygon_anchor`` reports ``"capped": True``.
ANCHOR_MAX_CELLS = 200000


# Relative precision floor: the search never works finer than this fraction of
# the polygon's larger bbox side. A long strip (road, canal, river polygon) has a
# plateau of near-equal distances along its medial line; without a floor every
# cell of that plateau would be refined to ``precision`` and the search would
# run into ``ANCHOR_MAX_CELLS``. 1e-4 is 0.1 m on a 1 km polygon.
ANCHOR_REL_PRECISION = 1e-4

# Polygons with more edges than this use ``SegmentGrid`` for distances.
ANCHOR_GRID_MIN_SEGMENTS = 24


def effective_precision(precision, width, height):
    """Precision actually used: ``max(precision, ANCHOR_REL_PRECISION * max(width, height))``."""
    return max(float(precision), ANCHOR_REL_PRECISION * max(width, height))


class SegmentGrid(object):
    """Uniform grid over the segments of closed rings (or open paths).

    * ``nearest_distance(p)``: exact distance to the nearest segment, searched
      ring by ring of grid cells outwards (stops once no farther cell can be
      closer);
    * ``inside(p)``: even-odd ray-casting test using only the segments of the
      point's grid row (same crossing rule as a full scan, so the same answer);
    * ``signed_distance(p)``: positive inside, negative outside, 0 on an edge.

    Building is linear in the number of segments (plus the cells long segments
    cover); each query touches only nearby segments, so testing many points
    against a large polygon is not points x vertices.
    """

    def __init__(self, segments):
        self.segs = [(tuple(a), tuple(b)) for a, b in segments]
        xs = [p[0] for s in self.segs for p in s] or [0.0]
        ys = [p[1] for s in self.segs for p in s] or [0.0]
        self.x0, self.y0 = min(xs), min(ys)
        width, height = max(xs) - self.x0, max(ys) - self.y0
        n = max(len(self.segs), 1)
        size = max(width, height, 1e-300)
        cell = math.sqrt(max(width * height, size * size / n) / n)
        self.cell = max(cell, size / 4096.0, 1e-300)
        self.cols = int(width / self.cell) + 1
        self.rows = int(height / self.cell) + 1
        self.cells = {}
        self.bands = {}
        for idx, (a, b) in enumerate(self.segs):
            c0, c1 = sorted((self._col(a[0]), self._col(b[0])))
            r0, r1 = sorted((self._row(a[1]), self._row(b[1])))
            for r in range(r0, r1 + 1):
                self.bands.setdefault(r, []).append(idx)
                for c in range(c0, c1 + 1):
                    self.cells.setdefault((c, r), []).append(idx)

    def _col(self, x):
        return min(max(int((x - self.x0) / self.cell), 0), self.cols - 1)

    def _row(self, y):
        return min(max(int((y - self.y0) / self.cell), 0), self.rows - 1)

    def inside(self, p):
        x, y = p
        if y < self.y0 or y > self.y0 + self.rows * self.cell:
            return False
        inside = False
        for idx in self.bands.get(self._row(y), ()):
            a, b = self.segs[idx]
            if (a[1] > y) != (b[1] > y):
                if x < a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1]):
                    inside = not inside
        return inside

    def nearest_distance(self, p):
        if not self.segs:
            return float("inf")
        x, y = p
        cx = int(math.floor((x - self.x0) / self.cell))
        cy = int(math.floor((y - self.y0) / self.cell))
        best = float("inf")
        seen = set()
        # Rings that do not reach the grid yet are empty: start at the first one that does.
        start = max(0, cx - (self.cols - 1), -cx, cy - (self.rows - 1), -cy)
        limit = start + max(self.cols, self.rows) + 1
        for r in range(start, limit + 1):
            for gx in range(cx - r, cx + r + 1):
                for gy in ((cy - r, cy + r) if 0 < r else (cy,)):
                    best = self._scan(gx, gy, p, best, seen)
            for gy in range(cy - r + 1, cy + r):
                if r > 0:
                    best = self._scan(cx - r, gy, p, best, seen)
                    best = self._scan(cx + r, gy, p, best, seen)
            # Every segment not yet seen lies in a cell at least r rings away.
            if best <= r * self.cell:
                break
        return best

    def _scan(self, gx, gy, p, best, seen):
        for idx in self.cells.get((gx, gy), ()):
            if idx in seen:
                continue
            seen.add(idx)
            a, b = self.segs[idx]
            d = point_segment_distance(p, a, b)[0]
            if d < best:
                best = d
        return best

    def signed_distance(self, p):
        d = self.nearest_distance(p)
        if d == 0.0:
            return 0.0
        return d if self.inside(p) else -d


def _anchor_segments(rings):
    segs = []
    for ring in rings:
        pts = [tuple(p) for p in ring]
        if len(pts) > 1 and pts[0] != pts[-1]:
            pts.append(pts[0])
        for i in range(len(pts) - 1):
            segs.append((pts[i], pts[i + 1]))
    return segs


def signed_distance_to_rings(p, rings):
    """Distance from ``p`` to the nearest ring edge; positive inside the
    polygon formed by ``rings`` (even-odd rule, so holes count as outside),
    negative outside, 0 on the boundary."""
    segs = _anchor_segments(rings)
    if not segs:
        return float("-inf")
    return _anchor_signed(p, segs)


def _anchor_signed(p, segs):
    x, y = p
    inside = False
    best = float("inf")
    hypot = math.hypot
    for a, b in segs:
        ax, ay = a
        bx, by = b
        if (ay > y) != (by > y):
            x_cross = ax + (y - ay) * (bx - ax) / (by - ay)
            if x < x_cross:
                inside = not inside
        # Same arithmetic as common.geom.point_segment_distance, inlined: this
        # loop runs for every cell of the search (it dominates the run time).
        dx, dy = bx - ax, by - ay
        seg2 = dx * dx + dy * dy
        if seg2 == 0.0:
            d = hypot(ax - x, ay - y)
        else:
            t = ((x - ax) * dx + (y - ay) * dy) / seg2
            if t < 0.0:
                t = 0.0
            elif t > 1.0:
                t = 1.0
            d = hypot(ax + t * dx - x, ay + t * dy - y)
        if d < best:
            best = d
    if best == 0.0:
        return 0.0
    return best if inside else -best


def pole_of_inaccessibility(rings, precision=1.0):
    """``(x, y, distance)`` of the pole of inaccessibility of ``rings``.

    ``rings``: one polygon part (outer ring and its holes; orientation does
    not matter, even-odd rule). ``precision``: absolute tolerance on the
    distance, in coordinate units (must be > 0). Degenerate input (zero
    width or height) returns the bbox centre with distance 0; empty input
    returns ``None``.
    """
    result = _anchor_pole(rings, precision)
    return None if result is None else result[:3]


def pole_with_status(rings, precision=1.0, max_cells=None):
    """``(x, y, distance, capped, error_bound)`` for one polygon part (outer ring and
    its holes): like ``pole_of_inaccessibility`` plus whether the cell budget
    (``max_cells``, default ``ANCHOR_MAX_CELLS``) was reached. ``error_bound`` is an
    upper bound of how far ``distance`` can be below the true maximum: the effective
    precision when the search finished, the largest remaining cell potential minus
    ``distance`` when it was capped. Empty input gives ``(0.0, 0.0, 0.0, False, 0.0)``."""
    result = _anchor_pole(rings, precision, max_cells, True)
    return (0.0, 0.0, 0.0, False, 0.0) if result is None else result


def _anchor_pole(rings, precision, max_cells=None, with_bound=False):
    if not precision or precision <= 0:
        raise ValueError("precision must be positive")
    max_cells = ANCHOR_MAX_CELLS if max_cells is None else int(max_cells)

    def done(x, y, d, capped, bound):
        return (x, y, d, capped, bound) if with_bound else (x, y, d, capped)

    segs = _anchor_segments(rings)
    if not segs:
        return None
    xs = [p[0] for s in segs for p in s]
    ys = [p[1] for s in segs for p in s]
    xmin, ymin, xmax, ymax = min(xs), min(ys), max(xs), max(ys)
    width, height = xmax - xmin, ymax - ymin
    cell = min(width, height)
    if cell == 0.0:
        return done((xmin + xmax) / 2.0, (ymin + ymax) / 2.0, 0.0, False, 0.0)
    if all(ring_signed_area(list(r)) == 0.0 for r in rings):
        # No interior at all (e.g. a ring that runs out and back along a line):
        # nothing to search, and the search for a positive distance would only
        # run into the cell budget.
        return done((xmin + xmax) / 2.0, (ymin + ymax) / 2.0, 0.0, False, 0.0)
    precision = effective_precision(precision, width, height)
    # A tolerance above the larger bbox side says nothing more (no inscribed circle has a
    # radius above half the shorter side), but it made the first cell far larger than the
    # part, with its centre far outside: when the first guesses lie in a hole or notch the
    # search then split such cells with slow distance queries from far away (152 s for a
    # 1.7 m blob with a hole at a precision of 458,000 units).
    precision = min(precision, max(width, height))
    # First cells are never finer than the precision (a 3 km x 1 mm sliver would
    # otherwise start with 3,000,000 cells of side 1 mm, before any budget check),
    # and never so many that they alone use up a quarter of the cell budget.
    cell = max(cell, precision)
    first = math.ceil(width / cell) * math.ceil(height / cell)
    if first > max_cells // 4:
        cell *= math.sqrt(first / float(max(max_cells // 4, 1))) * 1.01
    if len(segs) > ANCHOR_GRID_MIN_SEGMENTS:
        signed = SegmentGrid(segs).signed_distance
    else:
        def signed(q):
            return _anchor_signed(q, segs)
    h = cell / 2.0
    heap = []
    counter = [0]

    def push(cx, cy, half):
        d = signed((cx, cy))
        potential = d + half * math.sqrt(2.0)
        counter[0] += 1
        # max-heap on potential; counter keeps the order deterministic
        heapq.heappush(heap, (-potential, counter[0], cx, cy, half, d))
        return d

    x = xmin
    while x < xmax:
        y = ymin
        while y < ymax:
            push(x + h, y + h, h)
            y += cell
        x += cell

    # Initial guesses: area centroid, then bbox centre.
    best = None
    cen = polygon_centroid([list(r) for r in rings])
    for gx, gy in ([cen] if cen else []) + [((xmin + xmax) / 2.0, (ymin + ymax) / 2.0)]:
        d = signed((gx, gy))
        if best is None or d > best[2]:
            best = (gx, gy, d)

    capped = False
    bound = precision
    # A first guess exactly on an edge gives a distance of float noise (~1e-15), not a
    # point inside: treat a distance this small as "nothing found yet" (comb case).
    on_edge = 1e-9 * max(width, height)
    while heap:
        neg_pot, _n, cx, cy, half, d = heapq.heappop(heap)
        if d > best[2]:
            best = (cx, cy, d)
        if -neg_pot <= 0.0:
            continue  # no point of this cell can be inside the polygon
        # While no interior point has been found (best distance <= 0, e.g. the
        # centroid of a U shape lies in its notch), keep splitting even when the
        # precision is coarser than the inscribed radius: an anchor must be inside.
        if best[2] > on_edge and -neg_pot - best[2] <= precision:
            continue
        if counter[0] >= max_cells:
            capped = True
            bound = max(-neg_pot - best[2], precision)
            break
        half2 = half / 2.0
        for ox, oy in ((-half2, -half2), (half2, -half2), (-half2, half2), (half2, half2)):
            push(cx + ox, cy + oy, half2)
    return done(best[0], best[1], max(best[2], 0.0), capped, bound)


def polygon_anchor(rings, precision=1.0, groups=None):
    """Pole of inaccessibility of a (multipart) polygon in the core representation.

    Returns ``{"point": (x, y), "distance", "part", "parts", "capped"}``:
    the pole of the largest part (index ``part`` in ``group_rings`` order),
    the inscribed-circle radius, the number of parts and whether the cell
    budget was reached. ``None`` for an empty polygon. ``groups``: the
    ``group_rings(rings)`` result when the caller already has it (the rings
    are then not grouped a second time).
    """
    if groups is None:
        groups = group_rings(rings)
    if not groups:
        return None
    best_idx, best_area = 0, None
    for idx, (outer, holes) in enumerate(groups):
        area = abs(ring_signed_area(outer)) - sum(abs(ring_signed_area(h)) for h in holes)
        if best_area is None or area > best_area:
            best_idx, best_area = idx, area
    outer, holes = groups[best_idx]
    x, y, d, capped = _anchor_pole([outer] + list(holes), precision)
    return {"point": (x, y), "distance": d, "part": best_idx, "parts": len(groups),
            "capped": capped}


# ==========================================================================
# common/linegraph.py
# ==========================================================================
# Planar line network from polylines: endpoint nodes, degree, dangles,
# pseudo-nodes, connected components (pure Python).
#
# Input: ``[(key, paths), ...]`` where ``paths`` is a polyline in the core
# representation (list of paths, path = list of ``(x, y)``). Every path (part)
# is one **edge** from its first to its last vertex. Interior vertices are not
# nodes (a line crossing another without a shared endpoint is not connected).
#
# Endpoint clustering (``cluster_points``): endpoints closer than or equal to
# ``tolerance`` are merged with a grid hash (cell = tolerance) and union-find.
# Clustering is **transitive**: if A-B and B-C are within tolerance, A, B and C
# form one node even when A-C is farther apart (a chain of points each within
# tolerance of the next can span more than the tolerance). ``tolerance == 0``
# merges only identical coordinates. The node location is the first member
# point in input order (an actual endpoint, deterministic), not an average.
#
# Degree = number of edge ends at a node; a closed path (both ends in the same
# node) contributes 2. Dangles are nodes of degree 1. Pseudo-nodes are nodes of
# degree 2 where two **different** edges meet (the start of a single closed loop
# is not a pseudo-node); whether they are reportable (equal attributes) is the
# caller's decision.

class DisjointSet(object):
    """Union-find with path halving and union by size; elements are 0..n-1."""

    def __init__(self, n):
        self.parent = list(range(n))
        self.size = [1] * n

    def find(self, i):
        parent = self.parent
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    def union(self, i, j):
        ri, rj = self.find(i), self.find(j)
        if ri == rj:
            return ri
        if self.size[ri] < self.size[rj] or (self.size[ri] == self.size[rj] and rj < ri):
            ri, rj = rj, ri
        self.parent[rj] = ri
        self.size[ri] += self.size[rj]
        return ri


def cluster_points(points, tolerance):
    """Cluster labels for ``points`` (transitive, see module docstring).

    Returns a list of cluster ids, one per point, numbered 0, 1, 2 ... in
    order of first appearance.
    """
    n = len(points)
    ds = DisjointSet(n)
    if tolerance is None or tolerance <= 0:
        first = {}
        for i, p in enumerate(points):
            key = (float(p[0]), float(p[1]))
            if key in first:
                ds.union(first[key], i)
            else:
                first[key] = i
    else:
        if not math.isfinite(tolerance):
            raise ValueError("cluster_points: the tolerance must be a finite number")
        # Cells of half the tolerance: two points in one cell are always within the
        # tolerance (diagonal 0.71 x tolerance), so a cell is one cluster without any
        # distance test; points within the tolerance are at most 2 cells apart. Each
        # pair of neighbouring cells is compared only while they are still separate
        # clusters, with an early exit, so dense data (or a tolerance much larger
        # than the data) no longer costs one distance test per pair of points.
        cell = float(tolerance) / 2.0
        grid = {}
        for i, p in enumerate(points):
            try:
                key = (int(math.floor(p[0] / cell)), int(math.floor(p[1] / cell)))
            except (OverflowError, ZeroDivisionError, ValueError):
                # a tolerance such as 1e-320 (cell 0 or p / cell = inf), or a NaN coordinate
                raise ValueError("cluster_points: the tolerance {0!r} is too small for the "
                                 "coordinates (or a coordinate is not finite)".format(tolerance))
            members = grid.get(key)
            if members is None:
                grid[key] = [i]
            else:
                ds.union(members[0], i)
                members.append(i)
        offsets = [(dx, dy) for dx in range(-2, 3) for dy in range(-2, 3) if (dx, dy) > (0, 0)]
        for (gx, gy), members in grid.items():
            for dx, dy in offsets:
                other = grid.get((gx + dx, gy + dy))
                if other is None or ds.find(members[0]) == ds.find(other[0]):
                    continue
                if _linegraph_any_close(points, members, other, tolerance):
                    ds.union(members[0], other[0])
    labels = []
    seen = {}
    for i in range(n):
        root = ds.find(i)
        if root not in seen:
            seen[root] = len(seen)
        labels.append(seen[root])
    return labels


def _linegraph_any_close(points, a_idx, b_idx, tolerance):
    """True if some point of ``a_idx`` is within ``tolerance`` of some point of ``b_idx``."""
    for i in a_idx:
        p = points[i]
        for j in b_idx:
            if point_distance(points[j], p) <= tolerance:
                return True
    return False


def build_line_graph(lines, tolerance=0.0):
    """Build the endpoint graph of ``lines`` (``[(key, paths), ...]``).

    Returns ``{"nodes": [...], "edges": [...]}``:

    * edge: ``{"id", "key", "part", "from", "to", "length", "closed"}``
      (``from``/``to`` are node ids; ``closed`` when both ends share a node);
    * node: ``{"id", "xy", "degree", "ends", "members"}`` where ``ends`` is
      a list of ``(edge_id, "from"|"to")`` in edge order and ``members`` the
      number of endpoints merged into the node.

    Parts with fewer than 2 vertices and null geometries are skipped.
    """
    edges = []
    points = []
    for key, paths in lines:
        for part_idx, path in enumerate(paths or []):
            if len(path) < 2:
                continue
            edges.append({"id": len(edges), "key": key, "part": part_idx,
                          "length": path_length(path)})
            points.append(tuple(path[0]))
            points.append(tuple(path[-1]))
    labels = cluster_points(points, tolerance)
    nodes = []
    for idx, label in enumerate(labels):
        if label == len(nodes):
            nodes.append({"id": label, "xy": points[idx], "degree": 0, "ends": [], "members": 0})
        nodes[label]["members"] += 1
    for edge in edges:
        f, t = labels[2 * edge["id"]], labels[2 * edge["id"] + 1]
        edge["from"], edge["to"], edge["closed"] = f, t, f == t
        nodes[f]["degree"] += 1
        nodes[f]["ends"].append((edge["id"], "from"))
        nodes[t]["degree"] += 1
        nodes[t]["ends"].append((edge["id"], "to"))
    return {"nodes": nodes, "edges": edges}


def node_degrees(graph):
    """``{node_id: degree}``."""
    return dict((n["id"], n["degree"]) for n in graph["nodes"])


def find_dangles(graph):
    """Nodes of degree 1 (free line ends), in node order."""
    return [n for n in graph["nodes"] if n["degree"] == 1]


def find_pseudo_nodes(graph):
    """Nodes where exactly two different edges meet (degree 2, not the start
    of a single closed loop). Returns ``[(node, edge_a, edge_b), ...]``."""
    edges = graph["edges"]
    out = []
    for n in graph["nodes"]:
        if n["degree"] != 2:
            continue
        (e1, _s1), (e2, _s2) = n["ends"]
        if e1 == e2:
            continue
        out.append((n, edges[e1], edges[e2]))
    return out


def connected_components(graph, join_parts=True):
    """Connected groups of edges.

    With ``join_parts`` (default) all parts of one feature key belong to the
    same component even if they do not touch (a multipart feature is one
    feature). Returns a list of ``{"edges": [ids], "keys": [keys], "nodes":
    [ids]}`` sorted by the smallest edge id; keys keep first-seen order.
    """
    edges = graph["edges"]
    nodes = graph["nodes"]
    ds = DisjointSet(len(nodes))
    first_node_of_key = {}
    for e in edges:
        ds.union(e["from"], e["to"])
        if join_parts:
            if e["key"] in first_node_of_key:
                ds.union(first_node_of_key[e["key"]], e["from"])
            else:
                first_node_of_key[e["key"]] = e["from"]
    groups = {}
    order = []
    for e in edges:
        root = ds.find(e["from"])
        if root not in groups:
            groups[root] = {"edges": [], "keys": [], "key_set": set(), "nodes": set()}
            order.append(root)
        g = groups[root]
        g["edges"].append(e["id"])
        if e["key"] not in g["key_set"]:   # set lookup: O(1), not O(len(keys))
            g["key_set"].add(e["key"])
            g["keys"].append(e["key"])
        g["nodes"].update((e["from"], e["to"]))
    out = []
    for root in order:
        g = groups[root]
        out.append({"edges": g["edges"], "keys": g["keys"], "nodes": sorted(g["nodes"])})
    return out


# ==========================================================================
# common/report.py
# ==========================================================================
# Reports: Excel workbook with Summary + Detail sheets, CSV fallback.
#
# Engineering rule 11: choose a writable report path **before** the main work
# (a workbook open in Excel is locked), write Excel via openpyxl when it is
# available and fall back to two CSV files when it is not.
#
# * ``choose_report_path(requested, inputs)`` -> target dict, raises
#   ``ToolError`` if the location is not writable, a file it would write is
#   one of the tool's inputs, or a file it would write already exists while
#   ``arcpy.env.overwriteOutput`` is off (engineering rule 13; RT7-P-4).
# * ``write_report(target, summary, detail_header, detail_rows)`` -> list of
#   written file paths.
#
# Text fidelity (to be stated on every tool page that offers a report):
#
# * Excel: control characters a cell cannot hold (U+0000-U+0008, U+000B, U+000C,
#   U+000E-U+001F) are written as a visible ``<U+XXXX>``; nothing is dropped
#   silently. Text cells are stored as text, never as formulas.
# * CSV: every character is kept as it is (control characters included); text
#   that a spreadsheet would run as a formula gets a leading apostrophe
#   (``neutralize_formula``).
# * Both: a lone UTF-16 surrogate (U+D800-U+DFFF, half of a pair; it cannot be
#   written as UTF-8) becomes U+FFFD.
#
# Every file is opened through ``_open_for_write`` so tests can simulate a
# locked file without touching the operating system.

REPORT_FORMAT_XLSX = "xlsx"
REPORT_FORMAT_CSV = "csv"

# Rows in one Excel worksheet (.xlsx), header included.
_REPORT_XLSX_MAX_ROWS = 1048576

# Excel rejects these control characters in cell text (XML 1.0: U+0000-U+0008, U+000B, U+000C,
# U+000E-U+001F; tab, line feed and carriage return are allowed). They are written as a visible
# "<U+XXXX>" instead of being dropped, so a value such as "Riyadh" + U+0001 never looks equal to
# "Riyadh" in an Excel report (NearMissVocabularyChecker round-5 review, D2; the same review
# finding exists for NormalisedKeyDiagnostics). Accepted ambiguity: a text that really contains
# "<U+0001>" looks the same; each tool's output table keeps the exact value.
_REPORT_ILLEGAL = dict((c, u"<U+{0:04X}>".format(c))
                       for c in list(range(0, 9)) + [11, 12] + list(range(14, 32)))
# A lone UTF-16 surrogate (half of a pair, U+D800-U+DFFF) cannot be encoded as UTF-8: the xlsx and
# csv writers raise UnicodeEncodeError on it (MojibakeDetector round 5, R5-1). It becomes U+FFFD in
# both formats (merged shared fix, round 6).
_REPORT_LONE_SURROGATES = dict.fromkeys(range(0xD800, 0xE000), u"\ufffd")
_REPORT_ILLEGAL.update(_REPORT_LONE_SURROGATES)


# A plain number such as "-5" or "+1.5e3" is not a formula and is left as is.
_REPORT_PLAIN_NUMBER = re.compile(r"^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$")


def neutralize_formula(value):
    """Text that a spreadsheet would run as a formula, made inert (CSV injection).

    Text starting with ``=``, ``@``, tab or carriage return, or with ``+``/``-``
    followed by something that is not a plain number, gets a leading
    apostrophe, so Excel shows it as text instead of evaluating it (OWASP
    "CSV injection" guidance). Other values are returned unchanged. Used for
    every CSV report cell; the Excel writer stores text cells as text instead.

    This CHANGES the text in the CSV file: ``-Riyadh`` is written as
    ``'-Riyadh`` and ``=1+1`` as ``'=1+1`` (a plain number such as ``-5`` or
    ``+1.5e3`` is kept). Kept on purpose: without it a value could run as a
    formula when the CSV is opened in Excel. Every tool page that offers a CSV
    report should say so; a program that reads the CSV must strip the
    apostrophe.
    """
    if not isinstance(value, str) or not value:
        return value
    first = value[0]
    if first in ("=", "@", "\t", "\r"):
        return "'" + value
    if first in "+-" and len(value) > 1 and not _REPORT_PLAIN_NUMBER.match(value):
        return "'" + value
    return value


def _open_for_write(path, mode, **kwargs):
    """Single place where report files are opened (test hook)."""
    return open(path, mode, **kwargs)


def _report_import_openpyxl():
    """Import openpyxl lazily; ``None`` when it is not installed."""
    try:
        import openpyxl
    except ImportError:
        return None
    return openpyxl


def _report_check_writable(path):
    """Raise ``ToolError`` if ``path`` cannot be written; leaves no new file behind."""
    folder = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(folder):
        raise ToolError("The report folder '{0}' does not exist.".format(folder),
                        "Choose an existing folder for the report.")
    existed = os.path.exists(path)
    try:
        handle = _open_for_write(path, "ab")
        handle.close()
    except (IOError, OSError):
        raise ToolError(
            "The report file '{0}' cannot be written; it is probably open in Excel "
            "or another program, or it is read-only.".format(path),
            "Close the file (or choose a different report name) and run the tool again.")
    if not existed:
        try:
            os.remove(path)
        except OSError:
            pass


def csv_report_paths(path):
    """``(summary_csv, detail_csv)`` for a requested report path."""
    base = os.path.splitext(path)[0]
    return base + "_summary.csv", base + "_detail.csv"


def _report_keys(path):
    """Comparison keys of a path: as given and absolute, plus its dataset identity."""
    text = str(path).strip().strip("'\"")
    keys = set([normalize_catalog_path(text), dataset_identity(text)])
    if text and not text.startswith("\\\\"):
        absolute = os.path.abspath(text)
        keys.update([normalize_catalog_path(absolute), dataset_identity(absolute)])
    keys.discard("")
    return keys


def refuse_report_on_inputs(paths, inputs):
    """Raise ``ToolError`` if a report file would replace (or contain) an input.

    ``paths`` are the files the report will really write (after extension
    normalisation and the CSV fallback names); ``inputs`` are input files,
    datasets or layer texts (anything that is not a path never matches).
    Paths are compared with ``paths.normalize_catalog_path`` and
    ``paths.dataset_identity``; an input inside the report file (e.g. a sheet
    ``book.xlsx\\Sheet1$``) also counts. During a guarded run every input the
    tool registered (``paths.registered_inputs``) is compared as well, and a
    report file named like a table joined to an input layer
    (``paths.registered_joined_tables``) is refused.
    """
    inputs = list(inputs or ()) + registered_inputs()
    refuse_joined_table_outputs(paths, registered_joined_tables())
    for out in paths:
        out_keys = _report_keys(out)
        for value in inputs:
            if not value:
                continue
            in_keys = _report_keys(value)
            inside = any(k.startswith(o + "\\") for k in in_keys for o in out_keys)
            if out_keys & in_keys or inside:
                raise ToolError(
                    "The report file '{0}' would replace the input '{1}'.".format(out, value),
                    "Choose another report name or folder; the tool never overwrites its "
                    "input.")


def _report_overwrite_allowed():
    """``arcpy.env.overwriteOutput`` as a bool (False when it cannot be read)."""
    try:
        return bool(arcpy.env.overwriteOutput)
    except Exception:
        return False


def refuse_existing_report_files(paths, overwrite):
    """Raise ``ToolError`` if a report file exists and overwriting is off.

    Pro's own output check only sees the parameter value; the files really
    written can differ (``book.xls`` -> ``book.xlsx``, ``audit.csv`` ->
    ``audit_summary.csv`` + ``audit_detail.csv``), so every one is checked
    here (engineering rule 13, RT7-P-4).
    """
    if overwrite:
        return
    for path in paths:
        if os.path.exists(path):
            raise ToolError(
                "The report file '{0}' already exists and overwriting outputs is off, so "
                "it was not replaced.".format(path),
                "Choose another report name or folder, or allow geoprocessing tools to "
                "overwrite existing outputs (arcpy.env.overwriteOutput) and run the tool "
                "again.")


def choose_report_path(requested, inputs=(), overwrite=None):
    """Decide the report format and check the target is writable.

    ``requested`` ends in ``.xlsx`` or ``.csv`` (anything else is treated as
    ``.xlsx``). If openpyxl is missing, or ``.csv`` was requested, two CSV
    files ``<name>_summary.csv`` and ``<name>_detail.csv`` are used instead.
    Returns ``{"format", "paths", "note"}``; ``note`` explains a fallback.
    Returns ``None`` when no report was requested. ``inputs`` (input files,
    datasets or parameter texts) are refused as report files, after the
    extension change (``book`` / ``book.xls`` -> ``book.xlsx``) and for both CSV
    fallback files (``refuse_report_on_inputs``). With overwriting off
    (``overwrite``; ``None`` reads ``arcpy.env.overwriteOutput``) an existing
    report file is refused (``refuse_existing_report_files``).
    """
    if not requested:
        return None
    requested = str(requested)
    note = None
    ext = os.path.splitext(requested)[1].casefold()
    if ext != ".csv" and _report_import_openpyxl() is not None:
        if ext != ".xlsx":
            requested = os.path.splitext(requested)[0] + ".xlsx"
        target = {"format": REPORT_FORMAT_XLSX, "paths": [requested], "note": None}
    else:
        if ext != ".csv":
            note = ("openpyxl is not available, so the report is written as two CSV files "
                    "instead of an Excel workbook.")
        target = {"format": REPORT_FORMAT_CSV, "paths": list(csv_report_paths(requested)),
                  "note": note}
    # The name as asked for counts too: 'attr.csv' writes attr_summary.csv, but a
    # report named like a table joined to an input layer is refused either way.
    refuse_joined_table_outputs([requested], registered_joined_tables())
    refuse_report_on_inputs(target["paths"], inputs)
    for path in target["paths"]:
        _report_check_writable(path)
    if overwrite is None:
        overwrite = _report_overwrite_allowed()
    refuse_existing_report_files(target["paths"], overwrite)
    return target


# An Excel cell holds at most 32,767 characters (counted in UTF-16 units). openpyxl writes longer
# text without complaint and Excel then cuts or "repairs" it silently. The cut is made AFTER the
# <U+XXXX> expansion above, so the expansion can never push a cell over the limit, and the cut cell
# ends with a visible marker (NearMissVocabularyChecker R6-D2, BilingualNameQA R6-1).
_REPORT_XLSX_MAX_CELL = 32767
_REPORT_XLSX_CUT_MARKER = u" ...[cut: an Excel cell holds 32,767 characters; choose a .csv report for the full text]"


def _report_utf16_units(text):
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def _report_fit_excel_cell(text):
    """``text`` cut to fit one Excel cell, with a visible marker when cut."""
    if len(text) <= _REPORT_XLSX_MAX_CELL // 2 or _report_utf16_units(text) <= _REPORT_XLSX_MAX_CELL:
        return text
    room = _REPORT_XLSX_MAX_CELL - len(_REPORT_XLSX_CUT_MARKER)
    kept, used = [], 0
    for ch in text:
        size = 2 if ord(ch) > 0xFFFF else 1
        if used + size > room:
            break
        kept.append(ch)
        used += size
    return u"".join(kept) + _REPORT_XLSX_CUT_MARKER


def _report_cell(value):
    """Cell value safe for openpyxl (control characters as ``<U+XXXX>``, see
    ``_REPORT_ILLEGAL``)."""
    if isinstance(value, str):
        return _report_fit_excel_cell(value.translate(_REPORT_ILLEGAL))
    if value is None or isinstance(value, (bool, int, float)):
        return value
    return str(value)


def _report_write_xlsx(path, summary, summary_header, detail_header, detail_rows, openpyxl):
    workbook = openpyxl.Workbook()
    sheets = ((workbook.active, "Summary", summary_header, summary),
              (workbook.create_sheet(), "Detail", detail_header, detail_rows))
    bold = openpyxl.styles.Font(bold=True)
    for sheet, title, header, rows in sheets:
        sheet.title = title
        sheet.append([_report_cell(h) for h in header])
        for cell in sheet[1]:
            cell.font = bold
        widths = [len(str(h)) for h in header]
        # Excel holds at most _REPORT_XLSX_MAX_ROWS rows; openpyxl would write
        # more without complaint and Excel would then drop or "repair" them.
        room = _REPORT_XLSX_MAX_ROWS - 2
        if len(rows) > room + 1:
            dropped = len(rows) - room
            rows = rows[:room] + [["{0} more rows not shown: an Excel sheet holds at most {1} "
                                   "rows. Choose a .csv report path to get every row."
                                   .format(dropped, _REPORT_XLSX_MAX_ROWS)]]
        # Track the row number ourselves: openpyxl's Worksheet.max_row scans
        # every cell written so far, which made long reports quadratic (RT4-A-4).
        row_index = 1
        for row in rows:
            values = [_report_cell(v) for v in row]
            sheet.append(values)
            row_index += 1
            for column, value in enumerate(values, 1):
                if isinstance(value, str):
                    # never let text such as "=x" become a formula
                    sheet.cell(row=row_index, column=column).data_type = "s"
            for i, v in enumerate(values[:len(widths)]):
                widths[i] = max(widths[i], len(str(v)) if v is not None else 0)
        sheet.freeze_panes = "A2"
        for i, width in enumerate(widths):
            sheet.column_dimensions[openpyxl.utils.get_column_letter(i + 1)].width = min(width + 2, 80)
    with _open_for_write(path, "wb") as handle:
        workbook.save(handle)


def _report_csv_text(value):
    """CSV cell text: control characters kept exactly, only lone surrogates become U+FFFD."""
    if isinstance(value, str):
        return value.translate(_REPORT_LONE_SURROGATES)
    return value


def _report_write_csv(path, header, rows):
    # utf-8-sig so Excel shows Arabic and other non-Latin text correctly.
    with _open_for_write(path, "w", newline="", encoding="utf-8-sig") as handle:
        writer = csv.writer(handle)
        writer.writerow([neutralize_formula(_report_csv_text(h)) for h in header])
        for row in rows:
            writer.writerow(["" if v is None else neutralize_formula(_report_csv_text(v)) for v in row])


def write_report(target, summary, detail_header, detail_rows, summary_header=("Item", "Value"), xlsx_builder=None):
    """Write the report chosen by ``choose_report_path``.

    ``summary`` is a list of rows (usually ``(item, value)`` pairs);
    ``detail_rows`` a list of rows matching ``detail_header``.
    ``xlsx_builder`` (optional) is a function ``builder(openpyxl) -> workbook`` that replaces the plain
    two-sheet Excel layout with the tool's own formatted workbook; this module opens the file and saves it
    (same error handling, same ``_open_for_write`` hook). The CSV fallback is unaffected: it always gets
    ``summary`` and ``detail_rows``.
    Returns the list of written paths. Raises ``ToolError`` if a file became
    unwritable after it was checked.
    """
    if target is None:
        return []
    # Inputs read after the report was chosen (lookup tables, vocabularies ...) are
    # registered by then: never replace one of them (quality review D1/D2).
    refuse_report_on_inputs(target["paths"], ())
    summary = [list(r) for r in summary]
    detail_rows = [list(r) for r in detail_rows]
    try:
        if target["format"] == REPORT_FORMAT_XLSX:
            openpyxl = _report_import_openpyxl()
            if xlsx_builder is not None:
                workbook = xlsx_builder(openpyxl)
                with _open_for_write(target["paths"][0], "wb") as handle:
                    workbook.save(handle)
            else:
                _report_write_xlsx(target["paths"][0], summary, list(summary_header),
                                   list(detail_header), detail_rows, openpyxl)
        else:
            _report_write_csv(target["paths"][0], list(summary_header), summary)
            _report_write_csv(target["paths"][1], list(detail_header), detail_rows)
    except (IOError, OSError) as exc:
        raise ToolError("The report could not be written: {0}".format(exc),
                        "Close the report file if it is open and run the tool again.")
    return list(target["paths"])


def choose_output_file(requested, extension, inputs=(), overwrite=None):
    """Check the target of a single output file (an HTML page, a PNG ...) before the work.

    ``extension`` is the wanted one with its dot (``".html"``): a path without extension gets
    it, a path with another extension has it replaced. Refused (``ToolError``): a folder that
    does not exist, a file that is one of ``inputs`` (or a registered input of the run), a
    file that cannot be opened for writing (open in a program, read-only), and an existing
    file while overwriting is off. Returns the path to write, or ``None`` when nothing was
    requested.
    """
    if not requested or not str(requested).strip():
        return None
    path = str(requested).strip()
    if os.path.splitext(path)[1].casefold() != extension.casefold():
        path = os.path.splitext(path)[0] + extension
    refuse_joined_table_outputs([path], registered_joined_tables())
    refuse_report_on_inputs([path], inputs)
    _report_check_writable(path)
    if overwrite is None:
        overwrite = _report_overwrite_allowed()
    refuse_existing_report_files([path], overwrite)
    return path


def write_text_file(path, text, encoding="utf-8"):
    """Write ``text`` to ``path`` (UTF-8, ``\\n`` line ends) through the same open hook as the
    reports. Raises ``ToolError`` when the file cannot be written."""
    refuse_report_on_inputs([path], ())
    try:
        with _open_for_write(path, "w", encoding=encoding, newline="\n") as handle:
            handle.write(text)
    except (IOError, OSError) as exc:
        raise ToolError("The file '{0}' could not be written: {1}".format(path, exc),
                        "Close the file if it is open and run the tool again.")
    return path


# ==========================================================================
# common/params.py
# ==========================================================================
# Consistent construction and reading of ``arcpy.Parameter`` objects.

def make_param(name, label, datatype, direction="Input", required=True, multi_value=False,
               default=None, value_list=None, category=None, depends_on=None, enabled=True,
               filter_type=None):
    """Create an ``arcpy.Parameter``.

    ``required`` may be True (``"Required"``), False (``"Optional"``) or the
    string ``"Derived"``. ``value_list`` fills ``filter.list`` (a value list
    for strings/numbers, field types for ``Field``, extensions for ``DEFile``);
    ``filter_type`` sets ``filter.type`` (e.g. ``"Range"``) before the list.
    ``depends_on`` is a parameter name or list of names.
    """
    if required == "Derived":
        parameter_type = "Derived"
        direction = "Output"
    else:
        parameter_type = "Required" if required else "Optional"
    param = arcpy.Parameter(
        name=name,
        displayName=label,
        direction=direction,
        datatype=datatype,
        parameterType=parameter_type,
        enabled=enabled,
        category=category,
        multiValue=multi_value)
    if filter_type is not None:
        param.filter.type = filter_type
    if value_list is not None:
        param.filter.list = list(value_list)
    if depends_on:
        param.parameterDependencies = [depends_on] if isinstance(depends_on, str) else list(depends_on)
    if default is not None:
        param.value = default
    return param


def derived_output(name, label, datatype):
    """Derived output parameter (set with ``arcpy.SetParameterAsText``)."""
    return make_param(name, label, datatype, required="Derived")


def param_map(parameters):
    """``{name: parameter}`` for a parameter list."""
    return dict((p.name, p) for p in parameters)


def param_index(parameters, name):
    """Index of the parameter called ``name``."""
    for i, p in enumerate(parameters):
        if p.name == name:
            return i
    raise KeyError(name)


def param_text(param):
    """``valueAsText`` or ``None`` when empty."""
    text = param.valueAsText
    if text is None or text == "":
        return None
    return text


def param_bool(param, default=False):
    """Boolean value of a ``GPBoolean`` parameter."""
    value = param.value
    if value is None:
        return default
    if isinstance(value, str):
        return value.strip().casefold() in ("true", "1", "yes")
    return bool(value)


def param_number(param, default=None):
    """Numeric value (float) of a parameter, or ``default`` when empty."""
    value = param.value
    if value is None or value == "":
        return default
    return float(value)


def split_multivalue(text):
    """Values of a multivalue parameter given as geoprocessing text, quote-aware.

    Values are separated by ``;``. A value that starts with a single or double quote runs to the
    matching closing quote that is followed by ``;`` or the end of the text, so a folder named
    ``inv;2026`` written as ``'C:\\data\\inv;2026'`` stays one value; inside quotes the quote character
    written twice is one literal quote. A quote that is never closed counts as part of a plain
    value (the old behaviour: split on ``;``, quotes stripped)."""
    if not text:
        return []
    text = str(text)
    values = []
    n, i = len(text), 0
    while i < n:
        while i < n and text[i] in " \t":
            i += 1
        if i >= n:
            break
        if text[i] in "'\"":
            quote, j, buf, closed = text[i], i + 1, [], False
            while j < n:
                ch = text[j]
                if ch == quote:
                    if j + 1 < n and text[j + 1] == quote:
                        buf.append(quote)
                        j += 2
                        continue
                    k = j + 1
                    while k < n and text[k] in " \t":
                        k += 1
                    if k >= n or text[k] == ";":
                        closed = True
                        j = k
                        break
                buf.append(ch)
                j += 1
            if closed:
                value = "".join(buf).strip()
                if value:
                    values.append(value)
                i = j + 1
                continue
        end = text.find(";", i)
        if end < 0:
            end = n
        value = text[i:end].strip().strip("'\"")
        if value:
            values.append(value)
        i = end + 1
    return values


def param_list(param):
    """Values of a multivalue parameter as a list of strings (quote-aware, ``split_multivalue``)."""
    return split_multivalue(param_text(param))


def parse_value_table_text(text):
    """Rows of a value table given as geoprocessing text.

    Rows are separated by ``;`` and cells by spaces; a cell containing spaces
    is wrapped in single quotes (or double quotes, for example around a path that holds an
    apostrophe) and an empty cell is written ``#``
    (e.g. ``"NAME ASC;'Lot No' DESC"``). Inside quotes the quote character written twice is
    one literal quote. Returns a list of lists of strings,
    with ``None`` for empty cells. Separators inside quotes are kept.
    """
    if text is None:
        return []
    rows, row, cell = [], [], []
    quote = None
    in_cell = False

    def end_cell():
        value = "".join(cell)
        row.append(None if (value == "#" or value == "") else value)
        del cell[:]

    chars = str(text)
    n = 0
    while n < len(chars):
        ch = chars[n]
        n += 1
        if quote:
            if ch == quote:
                if n < len(chars) and chars[n] == quote:
                    cell.append(ch)
                    n += 1
                else:
                    quote = None
            else:
                cell.append(ch)
            continue
        if ch in ("'", '"') and not cell:
            quote = ch
            in_cell = True
        elif ch == " ":
            if in_cell:
                end_cell()
                in_cell = False
        elif ch == ";":
            if in_cell:
                end_cell()
                in_cell = False
            if row:
                rows.append(list(row))
            del row[:]
        else:
            cell.append(ch)
            in_cell = True
    if in_cell:
        end_cell()
    if row:
        rows.append(list(row))
    return rows


def _params_vt_cell(cell):
    """Plain Python value of one value-table cell (``None`` when empty)."""
    if cell is None:
        return None
    if isinstance(cell, str):
        text = cell.strip()
        return None if text in ("", "#") else text
    if isinstance(cell, (bool, int, float)):
        return cell
    name = getattr(cell, "name", None)  # e.g. a Field object in a Field column
    if isinstance(name, str):
        return name
    return str(cell)


def param_value_table(param, columns=None):
    """Rows of a ``GPValueTable`` parameter as lists of plain values.

    Uses ``Parameter.values`` (a list of lists); rows given as text (for
    example when a script passes a string) are parsed with
    ``parse_value_table_text``. Empty cells (``#``, ``''``, empty text, or empty in
    ``valueAsText``: ArcGIS Pro returns an empty number cell as 0) become ``None``; rows whose
    cells are all empty are dropped. ``columns`` pads/cuts each row to that
    many cells.
    """
    raw = param.values
    if not raw:
        return []
    parsed_rows = []
    for item in raw:
        if isinstance(item, str):
            parsed_rows.extend(parse_value_table_text(item))
        elif isinstance(item, (list, tuple)):
            parsed_rows.append(list(item))
        else:
            parsed_rows.append([item])
    # ArcGIS Pro returns an empty numeric cell as 0 in ``values`` while the text shows
    # ``#`` (Pro session 1): a cell that is empty in ``valueAsText`` is empty (None).
    try:
        text_rows = parse_value_table_text(param.valueAsText)
    except Exception:  # an unreadable text never hides the values
        text_rows = []
    if len(text_rows) != len(parsed_rows):
        text_rows = []
    rows = []
    for k, row in enumerate(parsed_rows):
        values = [_params_vt_cell(c) for c in row]
        if text_rows:
            text = text_rows[k]
            values = [None if (i < len(text) and text[i] is None) or i >= len(text) else v
                      for i, v in enumerate(values)]
        if columns is not None:
            values = (values + [None] * columns)[:columns]
        if any(v is not None for v in values):
            rows.append(values)
    return rows


def input_texts(parameters):
    """Every value of the tool's Input parameters as text (multivalues split).

    ``parameters`` is the parameter list or a ``param_map`` dict. Used to
    refuse a report file that would replace an input
    (``report.choose_report_path(requested, inputs=input_texts(...))``).
    """
    params = parameters.values() if isinstance(parameters, dict) else parameters
    out = []
    for param in params:
        if param.direction != "Input":
            continue
        text = param_text(param)
        if text:
            out.extend(split_multivalue(text))
    return out


# ==========================================================================
# common/arcio.py
# ==========================================================================
# The only common module that touches arcpy: reading, writing, editing.
#
# Every arcpy name used here is listed in ARCHITECTURE.md and must be in the
# API audit. Geometry crosses the arcpy boundary as Esri JSON only:
# ``SHAPE@JSON`` + ``json.loads`` on read, ``arcpy.AsShape(esri_json, True)`` on
# write (decision D-003). Rows are plain dicts::
#
#     {"oid": 12, "shape": <core geometry or None>, "attrs": {"NAME": "A", ...}}

LAYER_DATA_TYPES = ("FeatureLayer", "TableView", "Layer")
GEOMETRY_KEYWORDS = {"point": "POINT", "multipoint": "MULTIPOINT",
                     "polyline": "POLYLINE", "polygon": "POLYGON"}
SHAPEFILE_MAX_TEXT = 254

# Curves are densified with Geometry.densify("ANGLE", distance, deviation):
# distance = geometry extent diagonal / _ARCIO_CURVE_DIVISIONS, deviation in radians.
_ARCIO_CURVE_DIVISIONS = 50.0
_ARCIO_CURVE_DEVIATION = math.radians(1.0)

# Depth of open edit sessions; deletes are refused while > 0 (ERROR 000496).
_ARCIO_EDIT_STATE = {"depth": 0}


# --------------------------------------------------------------------------
# ObjectID output fields (SRC_OID, REMOVED_BY, SITE_OID, ...)
# --------------------------------------------------------------------------

# ArcGIS Pro 3.2 and later can have 64-bit ObjectIDs, which a LONG field refuses on insert.
OID_LONG_MIN, OID_LONG_MAX = -2 ** 31, 2 ** 31 - 1
# REPORTED (ArcGIS Pro 3.3.2, job_410 BilingualNameQA section 5): inserting 2^53 + 1 into a
# BIGINTEGER field of a file geodatabase was refused with "Big integer values are currently
# limited to 53 bits."; the "ArcGIS field data types" page gives -(2^53 - 1) to 2^53 - 1.
OID_BIG_MAX = 2 ** 53 - 1
# REPORTED (job_410): a DOUBLE field of a dBASE table stored 1099511627783 (2^40 + 7) as
# 1099511627780.0 and kept 3000000001; job_403 stored 25030864197623.8 as 25030864197600.0.
# Both keep 12 significant digits, so a folder output takes a DOUBLE only while every ObjectID has
# at most 12 significant digits.
OID_DBF_DOUBLE_DIGITS = 12
# TEXT width for ObjectIDs in a folder output: a signed 64-bit integer has at most 19 digits + sign.
OID_TEXT_LENGTH = 20


def _arcio_oid_values(oids):
    return [int(o) for o in oids if o is not None and not isinstance(o, bool)]


def oid_significant_digits(value):
    """Significant decimal digits of the whole number ``value`` (0 has 1; trailing zeros do not
    count: 3000000000 has 1)."""
    text = str(abs(int(value))).rstrip("0")
    return max(1, len(text))


def oid_field_type(oids, workspace_is_folder):
    """``(AddField keyword, text length or None)`` for a field that holds the ObjectIDs ``oids``.

    * LONG while every id fits 32 bits (any workspace);
    * a geodatabase (or GeoPackage / memory) output: BIGINTEGER; an id beyond 2^53 - 1 in size
      raises ``ToolError`` (ArcGIS Pro refuses it: "Big integer values are currently limited to
      53 bits");
    * a folder (shapefile / dBASE) output: DOUBLE while every id has at most 12 significant digits
      (and is at most 2^53 - 1 in size), else TEXT of ``OID_TEXT_LENGTH`` characters (or the
      longest id) with every digit kept."""
    values = _arcio_oid_values(oids)
    if all(OID_LONG_MIN <= v <= OID_LONG_MAX for v in values):
        return "LONG", None
    if not workspace_is_folder:
        big = [v for v in values if abs(v) > OID_BIG_MAX]
        if big:
            worst = max(big, key=abs)
            raise ToolError(
                "ObjectID {0} is larger than 2^53 - 1 (9,007,199,254,740,991), the largest whole "
                "number a Big Integer field holds in ArcGIS Pro (\"Big integer values are "
                "currently limited to 53 bits\"), so the output cannot store it.".format(worst),
                "Write the output to a folder (shapefile or dBASE table), where such ObjectIDs are "
                "written as text with every digit kept, or copy the input to a new feature class "
                "or table (its ObjectIDs start at 1) and run the tool on the copy.")
        return "BIGINTEGER", None
    if all(abs(v) <= OID_BIG_MAX and oid_significant_digits(v) <= OID_DBF_DOUBLE_DIGITS
           for v in values):
        return "DOUBLE", None
    return "TEXT", max([OID_TEXT_LENGTH] + [len(str(v)) for v in values])


def oid_field_spec(oids, workspace_is_folder, name="SRC_OID", alias=None, label=None):
    """``(field spec, info message or None)`` for an ObjectID output field (``oid_field_type``).

    The message (None for LONG) says which type the field got and, for TEXT, why. ``label`` names
    the field in the message (default ``name``). Raises ``ToolError`` as ``oid_field_type``."""
    keyword, length = oid_field_type(oids, workspace_is_folder)
    spec = {"name": name, "type": keyword}
    if length:
        spec["length"] = length
    if alias:
        spec["alias"] = alias
    label = label or name
    if keyword == "LONG":
        return spec, None
    text = "Some ObjectIDs do not fit 32 bits (64-bit ObjectIDs); {0} is written as {1}.".format(
        label, keyword)
    if keyword == "TEXT":
        values = _arcio_oid_values(oids)
        many = sum(1 for v in values if abs(v) > OID_BIG_MAX
                   or oid_significant_digits(v) > OID_DBF_DOUBLE_DIGITS)
        text += (" A Double field in a shapefile or dBASE table keeps only {0} significant digits "
                 "and {1} ObjectID(s) have more, so the field is text ({2} characters) with every "
                 "digit kept.".format(OID_DBF_DOUBLE_DIGITS, many, length))
    return spec, text


def oid_output_field(out_path, oids, collector=None, name="SRC_OID", alias=None, label=None):
    """``oid_field_spec`` for a field of the output ``out_path`` (a folder output or not is read
    from the path); the message goes to ``collector.info``. Returns the field spec."""
    spec, note = oid_field_spec(oids, is_folder_workspace(workspace_of(out_path)), name=name,
                                alias=alias, label=label)
    if note and collector is not None:
        collector.info(note)
    return spec


def oid_field_value(spec, oid):
    """``oid`` as written to the field ``spec`` of ``oid_field_spec``: its digits for TEXT."""
    if oid is None or isinstance(oid, bool) or spec.get("type") != "TEXT":
        return oid
    return str(int(oid))


# --------------------------------------------------------------------------
# Describe
# --------------------------------------------------------------------------

def sr_info(sr):
    """Plain dict for a ``SpatialReference`` (``None`` stays ``None``).

    ``"polar_stereographic"``: 1 / -1 when a projected system is polar
    stereographic about the North / South Pole (``polar_stereographic_sign``), else
    ``None``."""
    if sr is None:
        return None
    sr_type = sr.type
    projected = sr_type == "Projected"
    return {"wkid": sr.factoryCode or None, "name": sr.name, "type": sr_type,
            "meters_per_unit": sr.metersPerUnit if projected else None,
            "polar_stereographic": polar_stereographic_sign(sr) if projected else None}


# (factoryCode, name) -> result of polar_stereographic_sign; systems with a WKID only.
_ARCIO_POLAR_CACHE = {}


def polar_stereographic_sign(sr):
    """1 / -1 when the projected system ``sr`` is polar stereographic about the North
    / South Pole, else ``None`` (RT8-C-3: any polar stereographic system, not a WKID
    list). The probe points of ``projection.polar_probe_points`` are projected into
    ``sr`` one by one (``arcpy.AsShape`` in WGS 84, ``Geometry.projectAs``) and tested
    with ``projection.is_polar_stereographic_probe``. A point that cannot be projected
    makes the system "not polar stereographic"."""
    key = (sr.factoryCode, sr.name) if sr.factoryCode else None
    if key is not None and key in _ARCIO_POLAR_CACHE:
        return _ARCIO_POLAR_CACHE[key]
    found = None
    for sign in (1, -1):
        projected = []
        for lon, lat in polar_probe_points(sign):
            try:
                shape = arcpy.AsShape({"x": lon, "y": lat, "spatialReference": {"wkid": 4326}},
                                      True).projectAs(sr)
                data = json.loads(shape.JSON)
                projected.append((float(data["x"]), float(data["y"])))
            except Exception:  # outside the system's domain: not this pole's projection
                projected.append(None)
        if is_polar_stereographic_probe(projected):
            found = sign
            break
    if key is not None:
        _ARCIO_POLAR_CACHE[key] = found
    return found


def field_info(field):
    """Plain dict for an ``arcpy.Field``."""
    return {"name": field.name, "alias": field.aliasName, "type": field.type,
            "length": field.length, "domain": field.domain or None,
            "nullable": field.isNullable, "editable": field.editable,
            "required": field.required}


def describe_dataset(path):
    """Describe a feature class, table or layer.

    Returns ``{"input", "catalog_path", "workspace", "name", "data_type",
    "is_layer", "shape_type", "sr", "sr_object", "oid_field", "fields", "has_z",
    "has_m"}`` (``has_z`` / ``has_m``: the dataset stores Z / M values; ``False`` when the
    describe result does not say).
    For a layer, ``catalog_path`` is the layer's data source, so output/input
    comparisons use the real dataset, while cursors still use ``input`` (so
    selections and definition queries are honoured).
    """
    if not path or not arcpy.Exists(path):
        raise ToolError("The input '{0}' does not exist.".format(path),
                        "Check the path or layer name, or browse to the dataset.")
    desc = arcpy.da.Describe(path)
    catalog = desc["catalogPath"]
    register_inputs([path, catalog])  # every described dataset is an input of the run
    fields = [field_info(f) for f in desc["fields"]]
    register_joined_tables(joined_table_names(fields))  # ... and so is every joined table
    sr = desc["spatialReference"] if "spatialReference" in desc else None
    return {
        "input": path,
        "catalog_path": catalog,
        "workspace": workspace_of(catalog),
        "name": split_catalog_path(catalog)[1],
        "data_type": desc["dataType"],
        "is_layer": desc["dataType"] in LAYER_DATA_TYPES,
        "shape_type": desc["shapeType"] if "shapeType" in desc else None,
        "sr": sr_info(sr),
        "sr_object": sr,
        "oid_field": desc["OIDFieldName"] if ("hasOID" in desc and desc["hasOID"]) else None,
        "fields": fields,
        "has_z": bool(desc["hasZ"]) if "hasZ" in desc else False,
        "has_m": bool(desc["hasM"]) if "hasM" in desc else False,
    }


# --------------------------------------------------------------------------
# Read
# --------------------------------------------------------------------------

def _arcio_densify_curve(shape):
    """Esri JSON dict of a curved geometry after densification."""
    ext = shape.extent
    diag = math.hypot(ext.width, ext.height) or 1.0
    dense = shape.densify("ANGLE", diag / _ARCIO_CURVE_DIVISIONS, _ARCIO_CURVE_DEVIATION)
    data = json.loads(dense.JSON)
    if esri_json_has_curves(data):
        raise ToolError("A true-curve geometry could not be densified.",
                        "Run the Densify tool on the input first, then rerun this tool.")
    return data


def read_features(path, fields=(), sr=None, where=None, geometry=True):
    """Read rows as dicts ``{"oid", "shape", "attrs"}``.

    ``path`` may be a layer (selection and definition query honoured).
    ``sr`` (an ``arcpy.SpatialReference``) projects geometry at read time so
    source ObjectIDs are kept. True curves (``curvePaths``/``curveRings``) are
    re-read with ``SHAPE@`` and densified (decision D-005). Z and M are dropped.
    """
    register_inputs([path])
    fields = list(fields)
    tokens = ["OID@"] + (["SHAPE@JSON"] if geometry else []) + fields
    first = 2 if geometry else 1
    rows, curved = [], {}
    with arcpy.da.SearchCursor(path, tokens, where_clause=where, spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None,
                   "attrs": dict(zip(fields, values[first:]))}
            if geometry and values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    curved[values[0]] = row
                else:
                    row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    if curved:
        with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@"], where_clause=where,
                                   spatial_reference=sr) as cursor:
            for oid, shape in cursor:
                if oid in curved and shape is not None:
                    curved[oid]["shape"] = esri_json_to_core(_arcio_densify_curve(shape))[1]
    return rows


def read_features_skip_curves(path, fields=(), sr=None, where=None, zm=None):
    """Like ``read_features`` but true-curve features are skipped, not densified.

    Returns ``(rows, skipped_oids)``. Tools that report individual vertices or
    segments use this: densified arcs would create artificial vertices.
    Skipped features are not in ``rows``.

    ``zm``: optional dict; when given, ``zm["z"]`` / ``zm["m"]`` are set to the lists of
    ObjectIDs of the features that carry Z / M values (which the core geometry drops).
    """
    register_inputs([path])
    fields = list(fields)
    rows, skipped = [], []
    with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@JSON"] + fields, where_clause=where,
                               spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "attrs": dict(zip(fields, values[2:]))}
            if values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    skipped.append(values[0])
                    continue
                if zm is not None:
                    has_z, has_m = esri_json_zm(data)
                    if has_z:
                        zm.setdefault("z", []).append(values[0])
                    if has_m:
                        zm.setdefault("m", []).append(values[0])
                row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    return rows, skipped


def iter_features(path, fields=(), sr=None, where=None, geometry=True):
    """Like ``read_features`` but a generator: one row at a time, nothing kept in memory.

    Yields ``{"oid", "shape", "attrs", "curved"}``. A true-curve feature is NOT densified
    here: ``shape`` is ``None`` and ``curved`` is True (callers that only draw an outline
    count and skip it). Without ``geometry`` the cursor has no shape token (tables).
    """
    register_inputs([path])
    fields = list(fields)
    tokens = ["OID@"] + (["SHAPE@JSON"] if geometry else []) + fields
    first = 2 if geometry else 1
    with arcpy.da.SearchCursor(path, tokens, where_clause=where, spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "curved": False,
                   "attrs": dict(zip(fields, values[first:]))}
            if geometry and values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    row["curved"] = True
                else:
                    row["shape"] = esri_json_to_core(data)[1]
            yield row


def count_rows(path, where=None):
    """Number of rows of a table, feature class or layer (a layer's selection and definition
    query are honoured). Counted with a cursor on the ObjectID, nothing is kept."""
    register_inputs([path])
    total = 0
    with arcpy.da.SearchCursor(path, ["OID@"], where_clause=where) as cursor:
        for _row in cursor:
            total += 1
    return total


# Straight segments of a geographic (or other non-metric) input are straight in
# THAT system; projecting only their vertices bends them (about 0.02 m off at the
# middle of a 1.5 km segment, 2 m at 15 km). Lines are therefore densified in
# their own system every ~ARCIO_DENSIFY_STEP_M before they are projected.
ARCIO_DENSIFY_STEP_M = 100.0
_ARCIO_METRES_PER_DEGREE = 111320.0


def densify_step_for(desc, decision):
    """Densify distance in the input's own units before reprojecting it, or
    ``None`` when the input is used as is (no projection, nothing bends)."""
    if not decision.get("reproject"):
        return None
    info = desc["sr"] or {}
    if info.get("type") == "Geographic":
        return ARCIO_DENSIFY_STEP_M / _ARCIO_METRES_PER_DEGREE
    mpu = info.get("meters_per_unit")
    if mpu:
        return ARCIO_DENSIFY_STEP_M / float(mpu)
    return None


def read_features_densified(path, fields=(), sr=None, step=None, skip_curves=False,
                            where=None, geographic=False):
    """Read lines/polygons projected to ``sr`` after densifying them in their own
    system, so the projected geometry follows the straight segments of the
    source system. Each segment is densified on its own in pure Python
    (``geom.densify_path_segments``), the result is rebuilt with
    ``arcpy.AsShape`` in the source system and projected with
    ``Geometry.projectAs``. Without a source WKID, ``Geometry.densify``
    ("DISTANCE") is used instead.

    Without ``sr`` or ``step`` this is ``read_features`` (or
    ``read_features_skip_curves`` with ``skip_curves``). True curves are
    skipped (``skip_curves``) or densified by angle first (D-005). Returns
    ``(rows, skipped_oids)``. Adds vertices: use only for measuring and
    snapping, never where the vertices themselves are the result.

    ``geographic``: the input is in a geographic system. A segment spanning
    more than 180 degrees of longitude is taken to cross the antimeridian the
    short way and is densified across it (only that segment is affected).
    """
    register_inputs([path])
    fields = list(fields)
    if sr is None or not step:
        if skip_curves:
            return read_features_skip_curves(path, fields, sr=sr, where=where)
        return read_features(path, fields, sr=sr, where=where), []
    rows, skipped = [], []
    with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@"] + fields, where_clause=where) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "attrs": dict(zip(fields, values[2:]))}
            shape = values[1]
            if shape is not None:
                if shape.hasCurves:
                    if skip_curves:
                        skipped.append(values[0])
                        continue
                    ext = shape.extent
                    diag = math.hypot(ext.width, ext.height) or 1.0
                    shape = shape.densify("ANGLE", diag / _ARCIO_CURVE_DIVISIONS,
                                          _ARCIO_CURVE_DEVIATION)
                source = json.loads(shape.JSON)
                kind, core = esri_json_to_core(source)
                own = shape.spatialReference
                wkid = own.factoryCode if own is not None else None
                if core is None:
                    rows.append(row)
                    continue
                if wkid:
                    dense = [densify_path_segments(part, step, geographic) for part in core]
                    shape = arcpy.AsShape(core_to_esri_json(kind, dense, wkid), True)
                    shape = shape.projectAs(sr)
                else:
                    shape = shape.densify("DISTANCE", step).projectAs(sr)
                data = json.loads(shape.JSON)
                if esri_json_has_curves(data):
                    raise ToolError("A true-curve geometry could not be densified.",
                                    "Run the Densify tool on the input first, then rerun "
                                    "this tool.")
                row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    return rows, skipped


def _arcio_coords(node, out):
    """Collect ``(x, y)`` pairs from any nested Esri JSON coordinate list."""
    if isinstance(node, (list, tuple)):
        if len(node) >= 2 and all(isinstance(v, (int, float)) for v in node[:2]):
            out.append((float(node[0]), float(node[1])))
        else:
            for item in node:
                _arcio_coords(item, out)
    elif isinstance(node, dict):
        for value in node.values():
            _arcio_coords(value, out)


def sample_lonlat(path, where=None, max_samples=5000):
    """Up to ``max_samples`` vertices of the input in WGS 84 degrees."""
    register_inputs([path])
    samples = []
    wgs84 = arcpy.SpatialReference(4326)
    with arcpy.da.SearchCursor(path, ["SHAPE@JSON"], where_clause=where,
                               spatial_reference=wgs84) as cursor:
        for (text,) in cursor:
            if not text:
                continue
            data = json.loads(text)
            if "x" in data:
                if data.get("x") is not None and data.get("y") is not None:
                    samples.append((float(data["x"]), float(data["y"])))
                continue
            data.pop("spatialReference", None)
            _arcio_coords(data, samples)
            if len(samples) > 2 * max_samples:
                samples = samples[::2]
    if len(samples) > max_samples:
        samples = samples[::int(math.ceil(len(samples) / float(max_samples)))]
    return samples


def metric_sr_for(desc, where=None):
    """Choose the measuring coordinate system for a described dataset.

    Returns ``(decision, spatial_reference)``; ``spatial_reference`` is
    ``None`` when the input system is kept (no projection needed). See
    ``projection.choose_metric_sr`` for ``decision``.
    """
    info = desc["sr"]
    try:
        decision = choose_metric_sr(info, None)  # enough when the input system is kept
    except ToolError:
        decision = choose_metric_sr(info, sample_lonlat(desc["input"], where))
    if not decision["reproject"]:
        return decision, None
    return decision, arcpy.SpatialReference(decision["wkid"])


def metric_sr_or_native(desc, where=None):
    """Like ``metric_sr_for``, but an input without any usable coordinates
    (empty, or only null geometries) in a geographic or Web Mercator system
    keeps its own system instead of failing: there is nothing to measure.

    The decision then has ``"empty": True`` and ``meters_per_unit`` 1.0.
    """
    try:
        return metric_sr_for(desc, where)
    except ToolError:
        info = desc["sr"] or {}
        return {"wkid": info.get("wkid"), "meters_per_unit": 1.0, "reproject": False,
                "reason": "The input has no features with coordinates, so nothing is "
                          "measured.", "warnings": [], "empty": True}, None


def read_domains(workspace):
    """``{name: domain dict}`` for all domains of a workspace (see ``domains``).

    The workspace is registered as an input of the run (a domain source)."""
    register_inputs([workspace])
    try:
        return _arcio_list_domains(workspace)
    except (RuntimeError, ValueError, OSError, arcpy.ExecuteError) as exc:
        # ListDomains is documented for geodatabases only; a GeoPackage, a missing or locked
        # geodatabase would otherwise end as a bare Python traceback.
        raise ToolError("The attribute domains of '{0}' could not be read: {1}".format(
            workspace, str(exc).strip() or type(exc).__name__),
            "Attribute domains exist only in geodatabases. Use a file, mobile or enterprise "
            "geodatabase, and check that it is not locked by another application.")


def _arcio_list_domains(workspace):
    result = {}
    if is_folder_workspace(workspace):
        return result
    for dom in arcpy.da.ListDomains(workspace):
        coded = dom.domainType == "CodedValue"
        result[dom.name] = {
            "name": dom.name,
            "domain_type": dom.domainType,
            "field_type": dom.type,
            "codes": dict(dom.codedValues or {}) if coded else {},
            "range": None if coded else tuple(dom.range),
            "description": dom.description,
        }
    return result


def read_output_domains(out_path):
    """Domains of the workspace an output path will be written to (its
    geodatabase, also when the output is in a feature dataset), for
    ``domains.keep_field_domain``. ``{}`` for a folder, or when they cannot be
    listed (e.g. ``memory``, or a location that does not exist yet)."""
    try:
        return _arcio_list_domains(workspace_of(out_path)) or {}
    except Exception:
        return {}


def read_subtypes(path):
    """Subtype structure (see ``domains``); ``{"field": "", "subtypes": {}}`` if none.

    Pass a catalog path (``describe_dataset(...)["catalog_path"]``). Shapefiles
    and other folder datasets have no subtypes and are not queried.
    """
    register_inputs([path])
    empty = {"field": "", "subtypes": {}}
    workspace = workspace_of(path)
    if workspace and (is_folder_workspace(workspace) or workspace.casefold().endswith(".gpkg")):
        return empty  # shapefiles, dBASE tables and GeoPackage tables have no subtypes
    raw = arcpy.da.ListSubtypes(path)
    field = ""
    subtypes = {}
    for code, info in raw.items():
        field = info["SubtypeField"] or field
        domains, defaults = {}, {}
        for name, values in info["FieldValues"].items():
            defaults[name] = values[0]
            domains[name] = values[1].name if values[1] is not None else None
        subtypes[code] = {"name": info["Name"], "default": info["Default"],
                          "domains": domains, "defaults": defaults}
    if not field:
        return empty
    return {"field": field, "subtypes": subtypes}


# Datatype keywords documented for arcpy.da.Walk (walk.html, API audit).
WALK_DATATYPES = ("Any", "CadDrawing", "FeatureClass", "FeatureDataset", "GeometricNetwork",
                  "LasDataset", "Layer", "Locator", "Map", "MosaicDataset", "NetworkDataset",
                  "ParcelDataset", "RasterCatalog", "RasterDataset", "RelationshipClass",
                  "RepresentationClass", "Table", "Terrain", "Tin", "Tool", "Topology",
                  "UtilityNetwork")


def walk_workspace(root, datatypes=("FeatureClass", "Table"), recursive=True):
    """List datasets under a folder or workspace with ``arcpy.da.Walk``.

    Walk is called once per datatype keyword (decided before the loop), so
    every item carries the keyword it was found with; ``type=`` is never
    passed (its effect on tables is undocumented, audit gotcha 41). Folders
    and connection files are not followed (``followlinks=False``).

    Returns ``{"items": [...], "errors": [...]}``: items are
    ``{"path", "name", "dirpath", "data_type"}`` sorted by normalised path,
    without duplicates (first datatype wins); errors are
    ``{"path", "message", "datatype"}`` (the Walk keyword that raised it) for every folder Walk could not read (its
    ``onerror`` callback) or a Walk that stopped with an exception. Errors
    never stop the listing.

    ``recursive=False`` (added for the project toolbox; the default keeps the
    old behaviour): sub-folders of a folder root are not entered, but
    geodatabases directly inside it are listed in full (a geodatabase is a
    workspace of the folder, not a sub-folder). Pruning edits ``dirnames`` in
    place on a top-down walk, so skipped folders are never read.
    """
    bad = [d for d in datatypes if d not in WALK_DATATYPES]
    if bad or not datatypes:
        raise ValueError("unknown Walk datatype(s): {0}".format(", ".join(map(str, bad)) or "none"))
    if not root or not (os.path.isdir(str(root)) or arcpy.Exists(root)):
        raise ToolError("The workspace or folder '{0}' does not exist.".format(root),
                        "Browse to an existing folder or geodatabase.")
    errors = []
    current = [None]            # the datatype keyword of the Walk that is running

    def on_error(err):
        errors.append({"path": getattr(err, "filename", None) or "", "message": str(err),
                       "datatype": current[0]})

    items = {}
    for datatype in datatypes:
        current[0] = datatype
        try:
            for dirpath, dirnames, filenames in arcpy.da.Walk(
                    root, topdown=True, onerror=on_error, followlinks=False, datatype=datatype):
                if not recursive and is_folder_workspace(workspace_of(dirpath) or dirpath):
                    if normalize_catalog_path(dirpath) != normalize_catalog_path(root):
                        dirnames[:] = []
                        continue
                    dirnames[:] = [d for d in dirnames if not is_folder_workspace(d)]
                for name in filenames:
                    path = os.path.join(dirpath, name)
                    key = normalize_catalog_path(path)
                    if key not in items:
                        items[key] = {"path": path, "name": name, "dirpath": dirpath,
                                      "data_type": datatype}
        except (RuntimeError, OSError) as exc:
            errors.append({"path": str(root), "message": "{0} ({1})".format(exc, datatype),
                           "datatype": datatype})
    listed = [items[k] for k in sorted(items)]
    register_inputs([i["path"] for i in listed])
    return {"items": listed, "errors": errors}


# --------------------------------------------------------------------------
# Create and write
# --------------------------------------------------------------------------

def overwrite_output():
    """Value of ``arcpy.env.overwriteOutput`` as a bool."""
    return bool(arcpy.env.overwriteOutput)


def _arcio_existing_outputs(out_path):
    """Existing datasets an output would replace: the path itself and, for a
    folder output without extension, the ``.shp`` / ``.dbf`` Pro would write
    (``paths.folder_dataset_candidates``)."""
    return [p for p in folder_dataset_candidates(out_path) if arcpy.Exists(p)]


def check_output_path(out_path, inputs=()):
    """Every check ``create_table``/``create_feature_class`` make, without side effects.

    Refuses an output equal to an input, a missing output location, an
    existing output when overwriting is off, and an invalid name. Tools that
    edit their input call it for all outputs **before** the backup and the
    edit session (rule 6), so a bad output can never stop the run after the
    input was changed.
    """
    refuse_if_same([out_path], inputs)
    workspace, name = split_catalog_path(out_path)
    if not workspace or not arcpy.Exists(workspace):
        raise ToolError("The output location '{0}' does not exist.".format(workspace),
                        "Choose an existing geodatabase or folder for the output.")
    if _arcio_existing_outputs(out_path) and not overwrite_output():
        raise ToolError("The output '{0}' already exists.".format(out_path),
                        "Choose a new name, or allow geoprocessing tools to overwrite "
                        "existing datasets (Options > Geoprocessing).")
    base = name
    if is_folder_workspace(workspace) and name.casefold().endswith((".shp", ".dbf")):
        base = name[:-4]
    valid = arcpy.ValidateTableName(base, validation_workspace(workspace))
    if valid != base:
        raise ToolError("The output name '{0}' is not valid in '{1}'.".format(name, workspace),
                        "Use a name such as '{0}' (letters, digits and underscores).".format(valid))


def _arcio_prepare_output(out_path, inputs):
    """Checks shared by feature class and table creation; returns ``(ws, name)``."""
    refuse_if_same([out_path], inputs)
    workspace, name = split_catalog_path(out_path)
    if not workspace or not arcpy.Exists(workspace):
        raise ToolError("The output location '{0}' does not exist.".format(workspace),
                        "Choose an existing geodatabase or folder for the output.")
    existing = _arcio_existing_outputs(out_path)
    if existing:
        if not overwrite_output():
            raise ToolError("The output '{0}' already exists.".format(out_path),
                            "Choose a new name, or allow geoprocessing tools to overwrite "
                            "existing datasets (Options > Geoprocessing).")
        for path in existing:
            safe_delete(path, inputs)
    base = name
    if is_folder_workspace(workspace) and name.casefold().endswith((".shp", ".dbf")):
        base = name[:-4]
    valid = arcpy.ValidateTableName(base, validation_workspace(workspace))
    if valid != base:
        raise ToolError("The output name '{0}' is not valid in '{1}'.".format(name, workspace),
                        "Use a name such as '{0}' (letters, digits and underscores).".format(valid))
    return workspace, name


def validation_workspace(workspace):
    """Workspace to pass to ``ValidateTableName`` / ``ValidateFieldName`` for an
    output container: a feature dataset is validated against its geodatabase
    (the Validate functions document file system and geodatabase workspaces);
    a folder or geodatabase is returned unchanged."""
    if workspace and not is_folder_workspace(workspace):
        return workspace_of(workspace) or workspace
    return workspace


def _arcio_folder_name(workspace, name, ext):
    """``name`` with ``ext`` (``.shp`` / ``.dbf``) added in a folder workspace when it has no
    extension: Pro takes an extension-less table name in a folder for an INFO table
    (ERROR 000734 with a space in the path; Pro session 1, S3)."""
    if is_folder_workspace(workspace) and "." not in name:
        return name + ext
    return name


def _arcio_output_path(workspace, name):
    return workspace + "\\" + _arcio_folder_name(workspace, name, ".shp")


# A shapefile/dBASE field name holds at most 10 BYTES in UTF-8, not 10 characters (REPORTED: Pro
# job_403, ThiessenPolygonsConvex log: Arabic names of 12 and 15 letters were stored as 5 letters,
# 10 bytes; one of 4 letters, 8 bytes, was kept whole).
DBF_FIELD_NAME_BYTES = 10


def dbf_field_name_bytes(name):
    """Bytes a shapefile/dBASE field name takes (UTF-8; a character above U+FFFF as 6, like
    ``_arcio_dbf_bytes``)."""
    return _arcio_dbf_bytes(name)


def cut_dbf_field_name(name, limit=DBF_FIELD_NAME_BYTES):
    """``name`` cut at a character boundary to at most ``limit`` bytes (see
    ``dbf_field_name_bytes``): what a dBASE workspace keeps of a field name."""
    kept, used = [], 0
    for ch in str(name):
        size = _arcio_dbf_bytes(ch)
        if used + size > limit:
            break
        kept.append(ch)
        used += size
    return "".join(kept)


_ARCIO_SYSTEM_FIELDS = ("OBJECTID", "FID", "OID", "SHAPE", "SHAPE_LENGTH", "SHAPE_AREA")


def unique_field_specs(out_path, field_specs, fixed=0, reserved=()):
    """Make the output names of ``field_specs`` unique in the output workspace.

    The first ``fixed`` specs (the tool's own fields) keep their names; any
    later spec whose validated name clashes (shapefile/dBASE names are cut to
    10 BYTES in UTF-8, so ROAD_NAME_EN and ROAD_NAME_AR both become ROAD_NAME_,
    and an Arabic name keeps at most 5 letters) is renamed the way Copy Features
    does: shortened and given ``_1``, ``_2``, ... Names of system fields (ObjectID, Shape, ... and ``Id`` in a
    folder) and ``reserved`` names are avoided too. Nothing is created.

    Returns ``(specs, renamed)``: copies of the specs with ``name`` set to the
    final output name (the original name is kept as ``alias`` when no alias
    was given) and a list of ``(original, new)`` pairs.
    """
    workspace = validation_workspace(split_catalog_path(out_path)[0])
    folder = is_folder_workspace(workspace)
    taken = set(n.casefold() for n in _ARCIO_SYSTEM_FIELDS)
    taken.update(str(r).casefold() for r in reserved)
    if folder:
        taken.add("id")
    # A new name must not be the (validated) name of a LATER spec either: with input fields ORIG_X
    # and ORIG_X_1 and ORIG_X reserved, ORIG_X must become ORIG_X_2, not ORIG_X_1 (which would then
    # hold another field's data while the real ORIG_X_1 moved to ORIG_X_1_1). Review R8 F2.
    names_ahead = set(arcpy.ValidateFieldName(sp["name"], workspace).casefold()
                      for sp in field_specs[fixed:])
    out, renamed = [], []
    for k, spec in enumerate(field_specs):
        spec = dict(spec)
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        if k >= fixed and actual.casefold() in taken:
            limit = DBF_FIELD_NAME_BYTES if folder else max(len(actual), 1) + 4
            number = 1
            while True:
                suffix = "_{0}".format(number)
                if folder:
                    # dBASE names are cut to 10 BYTES (UTF-8), not characters (REPORTED: Pro
                    # job_403, Thiessen: an Arabic name kept 5 letters = 10 bytes).
                    base = cut_dbf_field_name(actual, limit - len(suffix))
                else:
                    base = actual[:limit - len(suffix)]
                candidate = arcpy.ValidateFieldName(base + suffix, workspace)
                # A workspace that cuts names by bytes (ArcGIS Pro shapefiles: an Arabic letter
                # takes 2 of the 10 bytes) drops the suffix; shorten the base until it survives,
                # so each number costs a few calls instead of ~10,000 per collision (review R5 O1).
                while base and not candidate.endswith(suffix):
                    base = base[:-1]
                    candidate = arcpy.ValidateFieldName(base + suffix, workspace)
                if candidate.casefold() not in taken and candidate.casefold() not in names_ahead:
                    break
                number += 1
            renamed.append((spec["name"], candidate))
            if not spec.get("alias"):
                spec["alias"] = spec["name"]
            actual = candidate
        taken.add(actual.casefold())
        spec["name"] = actual
        out.append(spec)
    return out, renamed


def _arcio_dbf_bytes(value):
    """Bytes a dBASE text field needs for ``value`` as Pro writes it (UTF-8; characters above U+FFFF as 6)."""
    text = str(value)
    # "surrogatepass": a lone UTF-16 surrogate (U+D800-U+DFFF) counts its 3 bytes instead of
    # raising UnicodeEncodeError (round-6 shared finding; Mojibake/Bilingual inputs can hold one).
    return len(text.encode("utf-8", "surrogatepass")) + 2 * sum(1 for ch in text if ord(ch) > 0xFFFF)


def cut_utf8_bytes(text, folder, counter, marker=""):
    """``text`` as a dBASE/shapefile text field can hold it: at most 254 bytes as Pro writes them
    (UTF-8, an Arabic letter takes 2; characters above U+FFFF count 6, see ``_arcio_dbf_bytes``;
    REPORTED by ArcGIS Pro job_222 for dBASE tables). Longer text is cut at a character boundary
    by the same rule, so a cut value can never make ``_arcio_text_length`` refuse it, and counted
    in ``counter[0]``; outside a folder nothing is cut. ``marker`` (e.g. ``" ...[cut]"``, ASCII)
    is appended to a cut value, and the cut leaves room for it."""
    if not folder or not isinstance(text, str):
        return text
    if _arcio_dbf_bytes(text) <= SHAPEFILE_MAX_TEXT:
        return text
    counter[0] += 1
    limit = SHAPEFILE_MAX_TEXT - _arcio_dbf_bytes(marker)
    kept, used = [], 0
    for ch in text:
        size = _arcio_dbf_bytes(ch)
        if used + size > limit:
            break
        kept.append(ch)
        used += size
    return "".join(kept) + marker


def _arcio_utf16_units(value):
    """Length of ``value`` in UTF-16 code units: a character above U+FFFF counts 2. A file
    geodatabase text field counts its width this way (REPORTED: Pro job_403, MojibakeDetector:
    a DETAIL value as long as the field in characters, with 5 characters above U+FFFF, was
    refused with "Field length exceeded")."""
    text = str(value)
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def _arcio_text_length(spec, actual, folder):
    """Width of the TEXT field ``spec`` (output name ``actual``).

    ``length`` if given, else the longest of ``values``. In a folder
    (shapefile/dBASE, at most 254 characters) a ``length`` that is too wide
    but comes with the ``values`` to be written (e.g. a carried field with
    Pro's default length 255) is narrowed to 254 when every value fits, as
    Copy Features does (rule 8: the values decide). Raises ``ToolError``
    only when a value, or a fixed width without values, really needs more.
    """
    values = spec.get("values")
    length = spec.get("length") or text_field_length(values or ())
    if not folder and not spec.get("length") and values:
        # geodatabase / GeoPackage: the width in UTF-16 units (job_403), never narrower than before
        length = max([length] + [_arcio_utf16_units(v) for v in values if v is not None])
    if folder and values is not None:
        # A dBASE text field written by ArcGIS Pro (UTF-8 code page) holds at most 254 BYTES, not
        # characters (REPORTED: Pro job_251, Thiessen; job_222, another tool): an Arabic letter
        # needs 2. A 97-character name of 130 bytes in a 120-wide field lost its last 10 bytes
        # without any message. The width is raised to the widest value in bytes (capped at 254).
        # Characters above U+FFFF (mathematical letters, emoji) are written by Pro as two 3-byte
        # surrogates (CESU-8: 6 bytes, not 4; CONFIRMED in the bytes of a Pro job 274 dBASE file),
        # so they count 6.
        widest_bytes = max([_arcio_dbf_bytes(v) for v in values if v is not None] or [0])
        if widest_bytes > SHAPEFILE_MAX_TEXT:
            raise ToolError(
                "Field '{0}' holds a value of {1} characters ({2} bytes in UTF-8 as ArcGIS Pro writes them, where a "
                "character above U+FFFF such as an emoji takes 6); shapefiles and dBASE tables allow "
                "{3} bytes.".format(actual, text_field_length(values), widest_bytes,
                                    SHAPEFILE_MAX_TEXT),
                "Write the output to a file geodatabase instead of a folder.")
        return min(max(length, widest_bytes), SHAPEFILE_MAX_TEXT)
    if not folder or length <= SHAPEFILE_MAX_TEXT:
        return length
    if values is not None and spec.get("length"):
        longest = text_field_length(values)
        if longest <= SHAPEFILE_MAX_TEXT:
            return SHAPEFILE_MAX_TEXT
        raise ToolError(
            "Field '{0}' holds a value of {1} characters; shapefiles and dBASE tables allow {2}.".format(
                actual, longest, SHAPEFILE_MAX_TEXT),
            "Write the output to a file geodatabase instead of a folder.")
    raise ToolError(
        "Field '{0}' needs {1} characters; shapefiles and dBASE tables allow {2}.".format(
            actual, length, SHAPEFILE_MAX_TEXT),
        "Write the output to a file geodatabase instead of a folder.")


def plan_field_names(field_specs, workspace, reserved=()):
    """Valid output names for ``field_specs`` without creating anything.

    Returns ``{requested name: actual name}`` (``arcpy.ValidateFieldName``).
    Raises ``ToolError`` when two fields would get the same name, when a name
    equals one of ``reserved`` (e.g. the ObjectID field the new table gets),
    or when a shapefile/dBASE text field would be wider than 254 characters.
    Call it before the output is created so a bad schema never leaves a
    half-built output behind.
    """
    mapping = {}
    used = {}
    taken = set(str(r).casefold() for r in reserved)
    folder = is_folder_workspace(workspace)
    workspace = validation_workspace(workspace)
    for spec in field_specs:
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        key = actual.casefold()
        if key in used:
            raise ToolError("The output fields '{0}' and '{1}' would both be called '{2}'.".format(
                used[key], spec["name"], actual),
                "Give one of them another name{0}.".format(
                    " (dBASE/shapefile field names are cut to 10 bytes in UTF-8)" if folder else ""))
        if key in taken:
            raise ToolError("The output field '{0}' would be called '{1}', a name the new output "
                            "already uses.".format(spec["name"], actual),
                            "Give that field another name.")
        used[key] = spec["name"]
        if folder and spec["type"] == "TEXT":
            _arcio_text_length(spec, actual, folder)
        mapping[spec["name"]] = actual
    return mapping


def plan_output_fields(out_path, field_specs, fixed=0, reserved=()):
    """``unique_field_specs`` then ``plan_field_names`` for one output, before
    anything is created. Returns ``(specs, renamed)`` (see ``unique_field_specs``);
    raises ``ToolError`` for problems renaming cannot solve (e.g. a text field
    wider than a shapefile allows)."""
    specs, renamed = unique_field_specs(out_path, field_specs, fixed, reserved)
    plan_field_names(specs, split_catalog_path(out_path)[0])
    return specs, renamed


def add_fields(table, field_specs, workspace):
    """Add fields; return ``{requested name: actual name}``.

    ``field_specs``: dicts with ``name``, ``type`` (AddField keyword: TEXT,
    SHORT, LONG, DOUBLE, ...), optional ``alias``, ``length``, ``values`` and
    ``domain`` (a domain of the output workspace; AddField ignores unknown ones).
    A TEXT field without ``length`` gets the width of its longest value.
    """
    mapping = {}
    used = set()
    folder = is_folder_workspace(workspace)
    workspace = validation_workspace(workspace)
    for spec in field_specs:
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        if actual.casefold() in used:
            raise ToolError("Two output fields would both be called '{0}'.".format(actual),
                            "Rename one of them (shapefile field names are cut to 10 bytes in UTF-8).")
        used.add(actual.casefold())
        length = None
        if spec["type"] == "TEXT":
            length = _arcio_text_length(spec, actual, folder)
        arcpy.management.AddField(table, actual, spec["type"], field_length=length,
                                  field_alias=spec.get("alias") or None,
                                  field_domain=spec.get("domain") or None)
        mapping[spec["name"]] = actual
    return mapping


def create_feature_class(out_path, kind, sr, field_specs, inputs=(), has_z=False, has_m=False):
    """Create an output feature class; return ``(catalog path, field mapping)``.

    ``has_z`` / ``has_m``: create the output with Z / M values (``has_z="ENABLED"`` of
    Create Feature Class); the call is the same as before when both are False."""
    workspace, name = _arcio_prepare_output(out_path, inputs)
    options = {}
    if has_z:
        options["has_z"] = "ENABLED"
    if has_m:
        options["has_m"] = "ENABLED"
    result = arcpy.management.CreateFeatureclass(
        workspace, _arcio_folder_name(workspace, name, ".shp"),
        geometry_type=GEOMETRY_KEYWORDS[kind], spatial_reference=sr, **options)
    path = _arcio_created_path(result, workspace, _arcio_output_path(workspace, name))
    return path, _arcio_fields_or_delete(path, field_specs, workspace, inputs)


def create_table(out_path, field_specs, inputs=()):
    """Create an output table; return ``(catalog path, field mapping)``."""
    workspace, name = _arcio_prepare_output(out_path, inputs)
    name = _arcio_folder_name(workspace, name, ".dbf")
    result = arcpy.management.CreateTable(workspace, name)
    path = _arcio_created_path(result, workspace, workspace + "\\" + name)
    return path, _arcio_fields_or_delete(path, field_specs, workspace, inputs)


def _arcio_created_path(result, workspace, fallback):
    """Path of a dataset that Create Table / Create Feature Class just made.

    GeoPackage datasets are listed as ``<file>.gpkg\\main.<name>``, so for a GeoPackage the
    path the tool reports is used when it exists; everywhere else (and when the tool
    reports nothing usable) ``fallback`` (``workspace\\name``) is used, as before."""
    if not str(workspace).casefold().endswith(".gpkg"):
        return fallback
    try:
        reported = result.getOutput(0)
    except Exception:  # a result without a readable output keeps the old behaviour
        return fallback
    if isinstance(reported, str) and reported.strip() and arcpy.Exists(reported):
        return reported
    return fallback


def _arcio_fields_or_delete(path, field_specs, workspace, inputs):
    """``add_fields`` on a just-created output; if it fails, the empty output
    is deleted (never leave a half-built output behind) and the error raised."""
    try:
        return add_fields(path, field_specs, workspace)
    except Exception:
        try:
            safe_delete(path, inputs)
        except Exception:
            pass
        raise


def copy_for_output(in_path, out_path, field_specs, inputs=()):
    """Copy a layer/feature class (CopyFeatures) or table view (CopyRows) and add fields.

    ``in_path`` may be a layer: its selection and definition query are
    honoured. Feature inputs keep their geometry; tables are copied with
    CopyRows. The fields are added **outside** any edit session (schema
    changes inside one fail with ERROR 000496). ObjectIDs of the copy are
    new, so callers must match copied rows by attribute values, not by OID.
    Returns ``(catalog path, field mapping)``.
    """
    workspace, name = _arcio_prepare_output(out_path, inputs)
    desc = arcpy.da.Describe(in_path)
    is_features = "shapeType" in desc
    if is_features:
        path = _arcio_output_path(workspace, name)
        arcpy.management.CopyFeatures(in_path, path)
    else:
        path = workspace + "\\" + _arcio_folder_name(workspace, name, ".dbf")
        arcpy.management.CopyRows(in_path, path)
    return path, add_fields(path, field_specs, workspace)


def copy_features(in_path, out_path, inputs=()):
    """Copy features to a new output with ``arcpy.management.CopyFeatures``.

    Same output checks as ``create_feature_class`` (refuse input = output,
    respect ``overwriteOutput``, valid name). A layer input copies only its
    selected / definition-query features. Returns the output catalog path.
    Call it outside any edit session (it creates a dataset).
    """
    workspace, name = _arcio_prepare_output(out_path, inputs)
    path = _arcio_output_path(workspace, name)
    arcpy.management.CopyFeatures(in_path, path)
    return path


# Value written instead of None to a shapefile / dBASE field, by Describe field type.
# ArcGIS Pro refuses None there ("RuntimeError: The field is not nullable. [VALUE]",
# Pro session 1, S3); dates and other types are left as they are.
_ARCIO_FOLDER_DEFAULTS = {"SmallInteger": 0, "Integer": 0, "BigInteger": 0, "Single": 0.0,
                          "Double": 0.0, "String": ""}


def _arcio_folder_defaults(path, field_names):
    """``{index: default}`` for the fields of a folder output that cannot hold None."""
    if not is_folder_workspace(workspace_of(path)):
        return {}
    types = dict((f.name.casefold(), f.type) for f in arcpy.da.Describe(path)["fields"])
    out = {}
    for i, name in enumerate(field_names):
        default = _ARCIO_FOLDER_DEFAULTS.get(types.get(str(name).casefold()))
        if default is not None:
            out[i] = default
    return out


def insert_rows(path, field_names, rows, kind=None, wkid=None, null_fields=None):
    """Insert rows; return the number inserted.

    With ``kind`` each row is ``(core geometry, values)``; without it, ``values``. The
    geometry may also be an Esri JSON dict (passed to ``arcpy.AsShape`` as it is, so Z
    and M in it are kept).
    ``null_fields``: optional set; the names of ``field_names`` that received
    at least one ``None`` are added to it (see ``folder_null_number_warning``).
    In a folder output (shapefile / dBASE) a ``None`` number is written as 0 and
    a ``None`` text as ``""`` (the type default; ArcGIS Pro refuses None there),
    and the field is still added to ``null_fields`` so the tool warns once
    naming it.
    """
    field_names = list(field_names)
    tokens = (["SHAPE@"] if kind else []) + field_names
    defaults = _arcio_folder_defaults(path, field_names)
    count = 0
    with arcpy.da.InsertCursor(path, tokens) as cursor:
        for row in rows:
            if kind:
                geom, values = row
            else:
                geom, values = None, row
            values = list(values)
            if null_fields is not None:
                for name, value in zip(field_names, values):
                    if value is None:
                        null_fields.add(name)
            for i, default in defaults.items():
                if i < len(values) and values[i] is None:
                    values[i] = default
            if kind:
                data = geom if isinstance(geom, dict) else core_to_esri_json(kind, geom, wkid)
                shape = arcpy.AsShape(data, True) if data is not None else None
                cursor.insertRow([shape] + values)
            else:
                cursor.insertRow(values)
            count += 1
    return count


def insert_shaped_rows(path, field_names, rows, null_fields=None):
    """Insert rows whose geometry is an ``arcpy.Geometry`` taken from another dataset.

    Each row is ``(geometry or None, values)``; the geometry is written as it is (a
    true curve stays a curve), so the output must be a feature class of the same
    geometry type and coordinate system. ``null_fields`` and the handling of empty
    numbers in a shapefile / dBASE output are the same as in ``insert_rows``.
    Returns the number of rows inserted.
    """
    field_names = list(field_names)
    defaults = _arcio_folder_defaults(path, field_names)
    count = 0
    with arcpy.da.InsertCursor(path, ["SHAPE@"] + field_names) as cursor:
        for geom, values in rows:
            values = list(values)
            if null_fields is not None:
                for name, value in zip(field_names, values):
                    if value is None:
                        null_fields.add(name)
            for i, default in defaults.items():
                if i < len(values) and values[i] is None:
                    values[i] = default
            cursor.insertRow([geom] + values)
            count += 1
    return count


_ARCIO_NUMBER_TYPES = ("SHORT", "LONG", "BIGINTEGER", "FLOAT", "DOUBLE")


def folder_null_number_warning(path, field_specs, mapping, null_fields, note=""):
    """Warning text, or ``None``, for empty numbers written to a folder output.

    A shapefile or dBASE table cannot store an empty (null) number: Add Field
    documents that nulls are only supported in a geodatabase and that zeros
    are inserted for numeric fields. ``field_specs`` are the specs the output
    was created with, ``mapping`` their ``{name: actual name}`` and
    ``null_fields`` the actual names ``insert_rows`` saw ``None`` in.
    ``note`` (optional) is added to say what the 0 means for those fields.
    """
    if not null_fields or not is_folder_workspace(workspace_of(path)):
        return None
    names, texts = [], []
    for spec in field_specs:
        actual = mapping.get(spec["name"], spec["name"])
        if str(spec.get("type", "")).upper() in _ARCIO_NUMBER_TYPES and actual in null_fields:
            names.append(actual)
        elif str(spec.get("type", "")).upper() == "TEXT" and actual in null_fields:
            texts.append(actual)
    if not names and not texts:
        return None
    parts = []
    if names:
        parts.append("Field(s) {0} of '{1}' have empty values, but a shapefile or dBASE table "
                     "cannot store an empty number: they are stored as 0, so 0 there can also "
                     "mean 'empty'.".format(", ".join(names), path))
    if texts:
        parts.append("Field(s) {0} of '{1}' have empty values, stored as empty text (a "
                     "shapefile or dBASE table cannot store an empty value).".format(
                         ", ".join(texts), path))
    text = " ".join(parts)
    if note:
        text += " " + note.strip()
    return text + (" Write the output to a file geodatabase to keep empty values empty.")


def update_rows(path, field_names, changes, where=None, null_fields=None):
    """Apply ``{oid: {field: value}}``; only rows whose values change are written.

    Returns the number of rows updated. Call inside ``edit_session``.
    ``null_fields``: optional set; the names of ``field_names`` that are set to
    ``None`` in at least one row are added to it (see
    ``folder_null_number_warning``).
    """
    field_names = list(field_names)
    count = 0
    with arcpy.da.UpdateCursor(path, ["OID@"] + field_names, where_clause=where) as cursor:
        for row in cursor:
            change = changes.get(row[0])
            if not change:
                continue
            new = list(row)
            for i, name in enumerate(field_names):
                if name in change:
                    new[i + 1] = change[name]
                    if null_fields is not None and change[name] is None:
                        null_fields.add(name)
            if new != list(row):
                cursor.updateRow(new)
                count += 1
    return count


# --------------------------------------------------------------------------
# Delete, backup, edit session
# --------------------------------------------------------------------------

def safe_delete(path, inputs=()):
    """Delete ``path`` unless it is an input or an edit session is open."""
    if _ARCIO_EDIT_STATE["depth"] > 0:
        raise ToolError("Refusing to delete '{0}' while an edit session is open.".format(path),
                        "This is a bug in the tool: deletes must happen before or after editing.")
    refuse_if_same([path], inputs)
    if arcpy.Exists(path):
        arcpy.management.Delete(path)


def _arcio_name_keys(path):
    """Comparison keys of a path with and without a .shp/.dbf extension."""
    key = normalize_catalog_path(path)
    keys = set([key])
    if key.endswith((".shp", ".dbf")):
        keys.add(key[:-4])
    return keys


def backup_copy(path, avoid=()):
    """Copy ``path`` to ``<name>_backupN`` next to it; return the copy's path.

    ``N`` is the first number whose name neither exists nor is one of the
    paths in ``avoid`` (pass the run's output paths, so an output can never
    replace the backup). Raises ``ToolError`` if the copy fails, so callers
    stop before editing.
    """
    taken = set()
    for other in avoid:
        if other:
            taken |= _arcio_name_keys(other)
    workspace, name = split_catalog_path(path)
    stem, ext = name, ""
    if is_folder_workspace(workspace) and "." in name:
        stem, ext = name.rsplit(".", 1)
        ext = "." + ext
    number = 1
    while True:
        candidate = "{0}\\{1}_backup{2}{3}".format(workspace, stem, number, ext)
        if not arcpy.Exists(candidate) and not (_arcio_name_keys(candidate) & taken):
            break
        number += 1
    try:
        arcpy.management.Copy(path, candidate)
    except (arcpy.ExecuteError, RuntimeError, OSError) as exc:
        raise ToolError("The backup copy of '{0}' failed, so nothing was edited: {1}".format(
            path, exc), "Check free disk space and write permission, then run the tool again.")
    if not arcpy.Exists(candidate):
        raise ToolError("The backup copy '{0}' was not created, so nothing was edited.".format(
            candidate), "Check write permission on the workspace, then run the tool again.")
    return candidate


@contextlib.contextmanager
def edit_session(workspace):
    """One ``arcpy.da.Editor`` session with one operation; rollback on failure.

    On success the operation is stopped and edits saved; on any exception the
    operation is aborted, the session stopped without saving, and the
    exception re-raised. Deletes are refused while the session is open.
    """
    editor = arcpy.da.Editor(workspace)
    editor.startEditing(False, True)
    _ARCIO_EDIT_STATE["depth"] += 1
    try:
        editor.startOperation()
    except BaseException:
        _ARCIO_EDIT_STATE["depth"] -= 1
        editor.stopEditing(False)
        raise
    try:
        yield editor
    except BaseException:
        try:
            editor.abortOperation()
        finally:
            _ARCIO_EDIT_STATE["depth"] -= 1
            editor.stopEditing(False)
        raise
    committed = False
    try:
        editor.stopOperation()
        editor.stopEditing(True)
        committed = True
    finally:
        _ARCIO_EDIT_STATE["depth"] -= 1
        if not committed and editor.isEditing:
            try:
                editor.abortOperation()
            finally:
                editor.stopEditing(False)


# --------------------------------------------------------------------------
# Messages, progress, outputs, environment
# --------------------------------------------------------------------------

def flush_messages(collector):
    """Send a ``MessageCollector``'s messages to ArcGIS Pro and clear it."""
    for level, text in collector.items:
        if level == MESSAGE_ERROR:
            arcpy.AddError(text)
        elif level == MESSAGE_WARNING:
            arcpy.AddWarning(text)
        else:
            arcpy.AddMessage(text)
    collector.clear()


class Progress(object):
    """Step progressor that updates at most ~100 times."""

    def __init__(self, label, total):
        self.total = max(int(total), 0)
        self.step = max(1, self.total // 100)
        self.count = 0
        self._shown = 0
        if self.total > 0:
            arcpy.SetProgressor("step", label, 0, self.total, self.step)
        else:
            arcpy.SetProgressor("default", label)

    def tick(self, amount=1):
        self.count += amount
        if self.total and (self.count - self._shown >= self.step or self.count >= self.total):
            self._shown = self.count
            arcpy.SetProgressorPosition(min(self.count, self.total))

    def label(self, text):
        arcpy.SetProgressorLabel(text)

    def close(self):
        arcpy.ResetProgressor()


# Parameter data types that never name a dataset or file (keywords and the display
# names Pro may report); their values are not resolved with Describe.
_ARCIO_NON_DATA_TYPES = frozenset(t.casefold() for t in (
    "GPBoolean", "Boolean", "GPString", "String", "GPLong", "Long", "GPDouble", "Double",
    "Field", "GPSQLExpression", "SQL Expression", "GPLinearUnit", "Linear Unit",
    "GPDate", "Date", "GPValueTable", "Value Table", "GPCoordinateSystem",
    "Coordinate System", "GPSpatialReference", "Spatial Reference", "GPExtent", "Extent"))


def _arcio_is_data_parameter(param):
    kinds = param.datatype if isinstance(param.datatype, (list, tuple)) else [param.datatype]
    return any(str(k).casefold() not in _ARCIO_NON_DATA_TYPES for k in kinds)


def _arcio_parameter_inputs(parameters):
    """``(paths, joined)`` of every Input parameter value naming a dataset or file
    (multivalues split): each value as typed plus its catalog path (a layer -> its
    data source), and the names of the tables joined to each input layer."""
    params = parameters.values() if isinstance(parameters, dict) else parameters
    paths, joined = [], set()
    for param in params:
        if param.direction != "Input" or not _arcio_is_data_parameter(param):
            continue
        text = param.valueAsText
        if not text:
            continue
        for value in split_multivalue(text):
            paths.append(value)
            try:
                if arcpy.Exists(value):
                    desc = arcpy.da.Describe(value)
                    paths.append(desc["catalogPath"])
                    if "fields" in desc:
                        joined.update(joined_table_names([field_info(f) for f in desc["fields"]]))
            except Exception:  # an unreadable value is still compared as typed
                pass
    return paths, joined


def register_parameter_inputs(parameters):
    """Register every Input parameter value naming a dataset or file (multivalues
    split), as typed and resolved to its catalog path (a layer -> its data source),
    so no output or report of the run can replace it (rule 4; review D1/D2).
    The names of the tables joined to each input layer (qualified field names,
    ``paths.joined_table_names``) are registered too: a layer reports only its
    own table's path, so an output or report named like a joined table is
    refused in any workspace (re-review N1)."""
    paths, joined = _arcio_parameter_inputs(parameters)
    register_inputs(paths)
    register_joined_tables(joined)


def _arcio_inside(path, root):
    """True if ``path`` is ``root`` or lies inside it (normalised catalog paths)."""
    key = normalize_catalog_path(root)
    if not key:
        return False
    for candidate in (normalize_catalog_path(path), normalize_catalog_path(split_catalog_path(path)[0])):
        if candidate == key or candidate.startswith(key.rstrip("\\") + "\\"):
            return True
    return False


def refuse_existing_protected_output(param, protected_paths, scanned_workspaces=(),
                                     refuse_inside=False, joined=()):
    """``updateMessages`` check: set an error on an output parameter that would replace
    a protected dataset or file; return True if it did.

    ArcGIS Pro deletes an existing output before ``execute`` runs when overwriting is
    on, so a refusal in ``execute`` comes too late (Pro session 1, S2: a scanned
    dataset was lost). Only an error set during validation stops the run before the
    delete (a warning does not; ``_work/pro_logs/s2_probe.txt``). Refused:

    * the output is the same dataset as any protected path (``paths.same_dataset``);
    * the output lies inside a scanned workspace (``scanned_workspaces``) and already
      exists, or lies inside it at all when ``refuse_inside`` (decision D-015);
    * the output is named like a table joined to an input layer (``joined``).
    """
    out = param.valueAsText
    if not out or not str(out).strip():
        return False
    out = str(out).strip()
    reason = None
    for path in protected_paths or ():
        if path and same_dataset(out, path):
            reason = ("The output '{0}' is the same dataset as the input '{1}'; ArcGIS Pro would "
                      "delete it before the tool runs. Choose a different output name or "
                      "location.".format(out, path))
            break
    if reason is None:
        for root in scanned_workspaces or ():
            if root and _arcio_inside(out, root) and (refuse_inside or _arcio_existing_outputs(out)):
                reason = ("The output '{0}' is inside '{1}', which is being inventoried or "
                          "audited; an existing item of that name could be replaced. Write the "
                          "output outside the scanned workspace.".format(out, root))
                break
    if reason is None and joined:
        try:
            refuse_joined_table_outputs([out], joined)
        except ToolError as err:
            reason = str(err)
    if reason is None:
        return False
    param.setErrorMessage(reason)
    return True


# Keywords and the display names ArcGIS Pro reports in Parameter.datatype ("Table").
_ARCIO_FOLDER_OUTPUT_EXT = {"detable": ".dbf", "table": ".dbf", "defeatureclass": ".shp",
                            "feature class": ".shp"}


def add_folder_output_extensions(parameters):
    """``updateParameters`` helper: give an extension-less table / feature class output in a
    plain folder its ``.dbf`` / ``.shp``. ArcGIS Pro validates the output before the tool
    runs and takes ``folder\name`` for an INFO table (ERROR 000734 when the path has a
    space; Pro session 1, S3, ``_work/pro_logs/dbf_probe.txt``). Outputs that accept both
    kinds are left alone."""
    for param in parameters:
        if param.direction != "Output" or param.parameterType == "Derived":
            continue
        kinds = param.datatype if isinstance(param.datatype, (list, tuple)) else [param.datatype]
        exts = set(_ARCIO_FOLDER_OUTPUT_EXT.get(str(k).casefold()) for k in kinds)
        if len(exts) != 1 or None in exts:
            continue
        text = param.valueAsText
        if not text or not str(text).strip():
            continue
        workspace, name = split_catalog_path(str(text).strip())
        if workspace and "." not in name and is_folder_workspace(workspace):
            param.value = str(text).strip() + exts.pop()


def folder_output_extensions(update_parameters):
    """Decorator for a tool's ``updateParameters``: runs it, then
    ``add_folder_output_extensions``."""
    def wrapper(self, parameters):
        result = update_parameters(self, parameters)
        add_folder_output_extensions(parameters)
        return result
    wrapper.__name__ = update_parameters.__name__
    wrapper.__doc__ = update_parameters.__doc__
    return wrapper


def protected_outputs(scanned=(), refuse_inside=False):
    """Decorator for a tool's ``updateMessages``: after the tool's own checks, every
    Output parameter that is not derived is checked with
    ``refuse_existing_protected_output`` against every Input data parameter (as typed
    and resolved to its data source, plus joined tables). ``scanned`` names Input
    parameters whose workspaces the tool reads in full."""
    scanned = (scanned,) if isinstance(scanned, str) else tuple(scanned)

    def decorate(update_messages):
        def wrapper(self, parameters):
            result = update_messages(self, parameters)
            outputs = [p for p in parameters if p.direction == "Output"
                       and p.parameterType != "Derived" and p.valueAsText]
            if not outputs:
                return result
            paths, joined = _arcio_parameter_inputs(parameters)
            roots = []
            for param in parameters:
                if param.name in scanned and param.valueAsText:
                    roots.extend(split_multivalue(param.valueAsText))
            for param in outputs:
                refuse_existing_protected_output(param, paths, roots, refuse_inside, joined)
            return result
        wrapper.__name__ = update_messages.__name__
        wrapper.__doc__ = update_messages.__doc__
        return wrapper
    return decorate


def guarded_run(execute):
    """Decorator for a tool's ``execute``: for the length of the run every input
    parameter and every dataset the tool reads through this module
    (``describe_dataset``, ``read_*``, ``walk_workspace``, ``read_domains``) is
    registered, and ``create_table`` / ``create_feature_class`` /
    ``copy_for_output`` / ``check_output_path`` / ``safe_delete`` and the report
    checks refuse to replace any of them, even when the tool did not pass it in
    ``inputs`` (quality review D1/D2: a skipped shapefile input and a lookup table
    were overwritten)."""
    def wrapper(self, parameters, messages):
        begin_input_register()
        try:
            register_parameter_inputs(parameters)
            return execute(self, parameters, messages)
        finally:
            end_input_register()
    wrapper.__name__ = execute.__name__
    wrapper.__doc__ = execute.__doc__
    return wrapper


def set_derived_output(parameters, name, value):
    """Set a derived output parameter so the result is added to the map."""
    arcpy.SetParameterAsText(param_index(parameters, name), value)


def product_info():
    """``{"version": "3.3", "licence": "ArcView"}`` for messages and checks."""
    return {"version": arcpy.GetInstallInfo()["Version"], "licence": arcpy.ProductInfo()}


# ==========================================================================
# carto/pages_core.py
# ==========================================================================
# Page model shared by Map Book Index and Map Series Index Check.
#
# Pure Python. A *region* is a convex polygon (a map series page, or a grid
# cell clipped to a page). Features are assigned to regions with one fixed rule:
#
# * **points** (and every point of a multipoint) are on every region whose
#   interior **or boundary** contains them (a point has no interior);
# * **lines** are on a region only if some part of them runs through the
#   region's **interior** (a line exactly along a shared page edge, or one that
#   only touches a corner, is on no page);
# * **polygons** are on a region only if their overlap with the region has a
#   positive area (holes subtracted); touching along an edge does not count.
#
# Regions must be convex (map series pages made by Grid Index Features or Strip
# Map Index Features are rectangles, possibly rotated). Convex clipping is exact
# and needs no general polygon overlay; non-convex pages are refused by the
# callers with the list of their ObjectIDs. Convexity allows only sub-millimetre
# noise (``common.clip.near_convex_ring``): a page is accepted when no vertex lies
# deeper than ``convex_tolerance`` inside its convex hull (at most
# ``PAGES_CONVEX_REL_TOL`` x the page size, or the caller's absolute floor for
# coordinates rounded to the geodatabase resolution), and the page is then
# replaced by that hull, which is exactly convex. A slightly concave, densified
# page (a projected parallel) bows inwards by far more and is refused, however
# finely it is densified, rather than clipped with half-planes that would cut a
# lens off its concave edge.
#
# Tolerances: the point tests and the length test of a line inside a region are
# relative to the region size (``PAGES_REL_EPS``). The segment clip
# (``common.clip.clip_segment_convex``) uses ``CLIP_EPSILON`` x the larger of 1 and
# the coordinate magnitude, so a line must lie inside a page edge by about
# 1e-9 x its coordinate to count as running through the interior: measured
# 2026-10-30 with this module, 0.5 mm at a coordinate of 1,000, 2.7 mm at northing 2,700,000 m
# and 9 mm at northing 9,000,000 m. A line closer to an edge than that is "touching".

# Relative tolerance: lengths below size * eps and areas below size^2 * eps
# are "no overlap"; points within size * eps of the boundary are on it.
PAGES_REL_EPS = 1e-9

# A page or cell counts as convex when no vertex lies deeper inside its convex hull
# than this fraction of its size (1 mm on a 1 km page, 2 cm on a 20 km sheet; a
# projected 15' graticule sheet bows inwards by about 4e-4 of its size). Callers
# add an absolute floor for coordinates rounded to the geodatabase resolution.
PAGES_CONVEX_REL_TOL = 1e-6

REGION_OK = "ok"
REGION_NULL = "null"
REGION_NOT_CONVEX = "not_convex"

# Why a region is not convex (``not_convex_reason``).
NOT_CONVEX_MULTIPART = "multipart"
NOT_CONVEX_HOLES = "holes"
NOT_CONVEX_CONCAVE = "concave"


# --------------------------------------------------------------------------
# Labels and ranges
# --------------------------------------------------------------------------

def label_text(value):
    """Display text of a page name, page number or grid label; ``None`` if blank.

    Integral floats lose their ``.0`` (``3.0`` -> ``"3"``); text is trimmed.
    """
    if value is None:
        return None
    text = value_to_text(value).strip()
    return text or None


def index_text(value):
    """Display and grouping text of a feature name or per-page value; ``None`` if blank.

    Unicode NFC, control characters and invisible marks (left-to-right/right-to-left
    marks, zero width space, byte order mark, bidi embeddings; NOT the zero width
    (non-)joiners, which change Arabic and Persian shaping) removed, every run of
    spaces, tabs and line breaks folded to one space, trimmed. So ``"Java Cafe"``,
    ``"Java  Cafe"`` and ``"Java Cafe" + U+200E`` are one entry. Case, Arabic letter
    variants (alef forms, teh marbuta) and digits are left as they are.
    """
    if value is None:
        return None
    text = normalize_text(value_to_text(value), trim=True, collapse=True, casefold=False,
                          invisible=True, controls=True, digits=False)
    return text or None


def label_integer(label):
    """Integer value of a label made only of digits (Arabic-Indic digits
    folded), else ``None``. ``"12"`` -> 12, ``"12A"``/``"-1"``/``"1.5"`` -> None."""
    if label is None:
        return None
    text = fold_digits(str(label).strip())
    if text and text.isascii() and text.isdigit():
        return int(text)
    return None


def sort_labels(labels):
    """Distinct non-empty labels in natural order ("2" < "10" < "10A" < "10a")."""
    return sorted(set(l for l in labels if l is not None and l != ""), key=natural_sort_key)


_NEGATIVE_INTEGER = re.compile(r"^-[0-9]+$")


def compress_ranges(labels):
    """Page list text such as ``"1-3, 12"``.

    Labels are de-duplicated and natural-sorted; runs of two or more
    consecutive pure integers become ``first-last`` (ASCII hyphen), even when
    other labels sort between them (``9, 10, 10A, 11`` -> ``"9-11, 10A"``);
    every other label is listed as is. Items are joined with ``", "``. Returns
    ``""`` for no labels.
    """
    items = []  # (sort key of the first label, text)
    run = []

    def flush():
        if len(run) >= 2:
            items.append(((1, natural_sort_key(run[0][0])), "{0}-{1}".format(run[0][0], run[-1][0])))
        elif run:
            items.append(((1, natural_sort_key(run[0][0])), run[0][0]))
        del run[:]

    numbered = []
    for label in sort_labels(labels):
        number = label_integer(label)
        if number is None:
            negative = _NEGATIVE_INTEGER.match(fold_digits(str(label).strip()))
            # A negative whole number ("-1") is listed on its own, before every other
            # label, in numeric order (never joined into a run: "-1-2" would be unreadable).
            key = (0, int(negative.group(0))) if negative else (1, natural_sort_key(label))
            items.append((key, label))
        else:
            numbered.append((label, number))
    # Integers form runs on their own, so "10A" between 10 and 11 does not
    # break the run 9-11; the runs are then merged back in natural order.
    for label, number in numbered:
        if run and number != run[-1][1] + 1:
            flush()
        run.append((label, number))
    flush()
    items.sort(key=lambda item: item[0])
    return ", ".join(text for _key, text in items)


# --------------------------------------------------------------------------
# Regions
# --------------------------------------------------------------------------

def convex_tolerance(ring, floor=0.0):
    """Absolute convexity tolerance of a ring: ``PAGES_CONVEX_REL_TOL`` x its size
    (largest side of its bounding box), at least ``floor``."""
    box = geometry_bbox(GEOM_POLYGON, [ring])
    size = max(box[2] - box[0], box[3] - box[1]) if box else 0.0
    return max(PAGES_CONVEX_REL_TOL * size, floor or 0.0)


def make_region(key, rings, floor=0.0):
    """Region dict for one page or cell, or ``(None, problem)``.

    Returns ``(region, REGION_OK)``, ``(None, REGION_NULL)`` for a null or
    zero-area geometry, ``(None, REGION_NOT_CONVEX)`` for a multipart
    polygon, a polygon with holes or a ring that is not convex within
    ``convex_tolerance(ring, floor)`` (``floor``: absolute tolerance in
    coordinate units, see ``convex_floor``). An accepted ring is replaced by its
    convex hull (it differs from the ring by at most the tolerance).
    """
    if not rings:
        return None, REGION_NULL
    groups = group_rings(rings)
    if not groups:
        return None, REGION_NULL
    if len(groups) != 1 or groups[0][1]:
        return None, REGION_NOT_CONVEX
    ring = groups[0][0]
    if ring_signed_area(ring) == 0.0:
        return None, REGION_NULL
    hull = near_convex_ring(ring, convex_tolerance(ring, floor))
    if hull is None:
        return None, REGION_NOT_CONVEX
    return _pages_region(key, hull), REGION_OK


def not_convex_reason(rings):
    """Why ``make_region`` refused a polygon: ``NOT_CONVEX_MULTIPART``,
    ``NOT_CONVEX_HOLES`` or ``NOT_CONVEX_CONCAVE``."""
    groups = group_rings(rings or [])
    if len(groups) > 1:
        return NOT_CONVEX_MULTIPART
    if groups and groups[0][1]:
        return NOT_CONVEX_HOLES
    return NOT_CONVEX_CONCAVE


def convex_floor(sr):
    """Absolute convexity floor for coordinates in the system ``sr`` (an
    ``arcio.sr_info`` dict): 0.5 mm in a projected system (five times the default
    file-geodatabase XY resolution of 0.1 mm), 5e-9 degrees (about 0.5 mm) in a
    geographic one, 0 when the system is unknown."""
    sr = sr or {}
    if sr.get("type") == "Projected":
        return 0.0005 / (sr.get("meters_per_unit") or 1.0)
    if sr.get("type") == "Geographic":
        return 5e-9
    return 0.0


def not_convex_error(what, items, fix_extra=""):
    """``(cause, fix)`` for polygons that are not single convex polygons.

    ``what``: e.g. ``"page(s) of the index layer"``; ``items``: ``[(oid, rings)]``.
    The OIDs are grouped by reason (concave, multipart, with holes) and the fix
    names the remedy of each reason present.
    """
    groups = {}
    for oid, rings in items:
        groups.setdefault(not_convex_reason(rings), []).append(oid)
    names = ((NOT_CONVEX_CONCAVE, "concave (a vertex lies inside the outline by more than "
                                  "the tolerance)"),
             (NOT_CONVEX_MULTIPART, "multipart"), (NOT_CONVEX_HOLES, "with holes"))
    parts = ["{0}: ObjectIDs {1}".format(label, oid_list_text(groups[key]))
             for key, label in names if key in groups]
    cause = "{0} {1} are not single convex polygons ({2}).".format(
        len(items), what, "; ".join(parts))
    fixes = []
    if NOT_CONVEX_CONCAVE in groups:
        fixes.append("rebuild the concave ones as straight-edged 4-corner rectangles (Grid "
                     "Index Features or Strip Map Index Features) or remove their extra "
                     "vertices (Simplify Polygon); a sheet bounded by parallels and stored "
                     "with densified edges in a projected system is concave and cannot be used")
    if NOT_CONVEX_MULTIPART in groups:
        fixes.append("split the multipart ones (Multipart To Singlepart)")
    if NOT_CONVEX_HOLES in groups:
        fixes.append("remove the holes")
    fix = "; ".join(fixes)
    fix = fix[:1].upper() + fix[1:] + "."
    if fix_extra:
        fix += " " + fix_extra
    return cause, fix


def _pages_region(key, ring):
    bbox = geometry_bbox(GEOM_POLYGON, [ring])
    size = max(bbox[2] - bbox[0], bbox[3] - bbox[1])
    pts = ring[:-1] if len(ring) > 1 and ring[0] == ring[-1] else ring
    # Mean of the vertices: strictly inside a convex region of positive area.
    inner = (sum(q[0] for q in pts) / len(pts), sum(q[1] for q in pts) / len(pts))
    return {"key": key, "ring": ring, "bbox": bbox, "size": size, "inner": inner,
            "area": abs(ring_signed_area(ring)),
            "tol": PAGES_REL_EPS * max(size, 1e-300)}


def shift_region(region, dx):
    """Copy of a region moved by ``dx`` along x (same key)."""
    return _pages_region(region["key"], [(x + dx, y) for x, y in region["ring"]])


def clip_region(key, region, clip):
    """Intersection of two convex regions as a new region (or ``None`` if the
    overlap has no area). Used to cut grid cells to the page they belong to."""
    ring = clip_ring_convex(region["ring"], clip["ring"])
    if not ring:
        return None
    area = abs(ring_signed_area(ring))
    if area <= PAGES_REL_EPS * min(region["area"], clip["area"]):
        return None
    if not ring_is_convex(ring):  # numerically degenerate sliver
        return None
    return _pages_region(key, ring)


def _pages_point_hit(p, region):
    tol = region["tol"]
    x0, y0, x1, y1 = region["bbox"]
    if p[0] < x0 - tol or p[0] > x1 + tol or p[1] < y0 - tol or p[1] > y1 + tol:
        return False
    return point_in_ring(p, region["ring"], tol) != "out"


def _pages_segment_hit(a, b, region):
    if a == b:
        return False
    return segment_inside_length(a, b, region["ring"], strict=True) > region["tol"]


def _pages_edge_contact(a, b, region):
    """True if segment ``a``-``b`` (a point when ``a == b``) meets ``region`` on its boundary:
    the middle of the part of the segment in the closed region lies within 2e-9 x the
    coordinate magnitude (twice the band of ``clip_segment_convex``) of the boundary. A
    zero-length line or a collapsed ring in the middle of a region is not a contact."""
    ring = region["ring"]
    if a == b:
        p = a
    else:
        hit = clip_segment_convex(a, b, ring, False)
        if hit is None:
            return False
        t = (hit[0] + hit[1]) / 2.0
        p = (a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1]))
    scale = max(1.0, abs(a[0]), abs(a[1]), abs(b[0]), abs(b[1]))
    return point_in_ring(p, ring, max(region["tol"], 2e-9 * scale)) == "boundary"


def _pages_shift(kind, geom, dx):
    """Copy of a core geometry moved by ``dx`` along x."""
    if kind == GEOM_POINT:
        return (geom[0] + dx, geom[1])
    if kind == GEOM_MULTIPOINT:
        return [(x + dx, y) for x, y in geom]
    return [[(x + dx, y) for x, y in part] for part in geom]


def _pages_flat_ring(ring):
    """True if every point of ``ring`` lies on one line (a collapsed ring)."""
    a = ring[0]
    b = next((q for q in ring[1:] if q != a), None)
    if b is None:
        return True
    span = max(abs(q[c] - a[c]) for q in ring for c in (0, 1))
    return all(abs((b[0] - a[0]) * (q[1] - a[1]) - (b[1] - a[1]) * (q[0] - a[0]))
               <= 1e-9 * span * span for q in ring)


# Two polygon edges lie on one line when every end point is within this x the coordinate
# magnitude (at least 1) of the other edge's line.
PAGES_COLLINEAR_REL = 1e-9


def _pages_overlap_span(s, t, tol):
    """Part ``(lo, hi)`` of segment ``s`` (as fractions of its length) that segment ``t``
    covers when both lie on one line (within ``tol``), or ``None`` (not on one line, or an
    overlap no longer than ``tol``)."""
    (ax, ay), (bx, by) = s
    (cx, cy), (dx, dy) = t
    ux, uy = bx - ax, by - ay
    vx, vy = dx - cx, dy - cy
    ls = (ux * ux + uy * uy) ** 0.5
    lt = (vx * vx + vy * vy) ** 0.5
    if ls == 0.0 or lt == 0.0:
        return None
    if (abs(ux * (cy - ay) - uy * (cx - ax)) > tol * ls
            or abs(ux * (dy - ay) - uy * (dx - ax)) > tol * ls
            or abs(vx * (ay - cy) - vy * (ax - cx)) > tol * lt
            or abs(vx * (by - cy) - vy * (bx - cx)) > tol * lt):
        return None
    l2 = ls * ls
    tc = (ux * (cx - ax) + uy * (cy - ay)) / l2
    td = (ux * (dx - ax) + uy * (dy - ay)) / l2
    lo, hi = max(0.0, min(tc, td)), min(1.0, max(tc, td))
    if (hi - lo) * ls <= tol:
        return None
    return lo, hi


def _pages_odd_segments(segments):
    """The parts of polygon edges that are boundary under the even-odd rule.

    A stretch of an edge that other edges of the polygon run along (an out-and-back
    "antenna" or spike, a ring traced twice, a hole edge on the outer edge) is boundary
    only where an odd number of edges cover it: two coinciding edges cancel, and the
    polygon has no area on either side of them. Returns ``(pieces, cancelled)``:
    ``pieces`` replaces ``segments``, ``cancelled`` is True when some stretch cancelled
    (else ``pieces`` is ``segments``). Cost: about linear in the edges (a uniform grid);
    only the edges that overlap another edge are split."""
    segs = [(a, b) for a, b in segments if a != b]
    if len(segs) < 2:
        return segs, False
    xs = [p[0] for s in segs for p in s]
    ys = [p[1] for s in segs for p in s]
    x0, y0 = min(xs), min(ys)
    scale = max(1.0, max(abs(v) for v in xs), max(abs(v) for v in ys))
    tol = PAGES_COLLINEAR_REL * scale
    width, height = max(xs) - x0, max(ys) - y0
    n = len(segs)
    size = max(width, height, 1e-300)
    cell = max((max(width * height, size * size / n) / n) ** 0.5, size / 4096.0, 1e-300)

    def span(lo, hi, origin):
        return int((lo - tol - origin) / cell), int((hi + tol - origin) / cell)

    partners = {}

    def pair(k, j):
        if j != k and j not in partners.get(k, ()) and \
                _pages_overlap_span(segs[k], segs[j], tol) is not None:
            partners.setdefault(k, set()).add(j)
            partners.setdefault(j, set()).add(k)

    # Two edges overlap (with a length) only if they have the same end points, or an end
    # point of one lies on the other away from its end points. Edges with the same end
    # points are found by a dictionary, the others through a grid of the end points.
    same, at_vertex, grid = {}, {}, {}
    for k, (a, b) in enumerate(segs):
        same.setdefault((a, b) if a <= b else (b, a), []).append(k)
        for q in (a, b):
            if q not in at_vertex:
                at_vertex[q] = []
                grid.setdefault((int((q[0] - x0) / cell), int((q[1] - y0) / cell)), []).append(q)
            at_vertex[q].append(k)
    for group in same.values():
        for k in group[1:]:
            pair(group[0], k)
            for j in group[1:]:
                if j != k:
                    pair(j, k)
    for j, (a, b) in enumerate(segs):
        ux, uy = b[0] - a[0], b[1] - a[1]
        l2 = ux * ux + uy * uy
        band = tol * l2 ** 0.5
        c0, c1 = span(min(a[0], b[0]), max(a[0], b[0]), x0)
        r0, r1 = span(min(a[1], b[1]), max(a[1], b[1]), y0)
        for c in range(c0, c1 + 1):
            for r in range(r0, r1 + 1):
                for q in grid.get((c, r), ()):
                    if q == a or q == b:
                        continue
                    wx, wy = q[0] - a[0], q[1] - a[1]
                    if abs(ux * wy - uy * wx) > band:
                        continue
                    t = ux * wx + uy * wy
                    if t < -band or t > l2 + band:
                        continue
                    for k in at_vertex[q]:
                        pair(j, k)
    if not partners:
        return segs, False
    pieces, cancelled = [], False
    for k, s in enumerate(segs):
        if k not in partners:
            pieces.append(s)
            continue
        spans = [(j, _pages_overlap_span(s, segs[j], tol)) for j in partners[k]]
        spans = [(j, v) for j, v in spans if v is not None]
        cuts = sorted(set([0.0, 1.0] + [v for _, sp in spans for v in sp]))
        (ax, ay), (bx, by) = s
        start = None
        for lo, hi in zip(cuts[:-1], cuts[1:]):
            mid = (lo + hi) / 2.0
            cover = [j for j, (u, v) in spans if u <= mid <= v]
            odd = len(cover) % 2 == 0          # with this edge: an odd number
            if not odd:
                cancelled = True
            # a stretch covered by several edges is given once, by the lowest edge
            odd = odd and all(j > k for j in cover)
            if odd and start is None:
                start = lo
            if not odd and start is not None:
                pieces.append(((ax + start * (bx - ax), ay + start * (by - ay)),
                               (ax + lo * (bx - ax), ay + lo * (by - ay))))
                start = None
        if start is not None:
            pieces.append(((ax + start * (bx - ax), ay + start * (by - ay)), s[1]))
    if not cancelled:
        return segs, False
    return [p for p in pieces if p[0] != p[1]], True


class RegionIndex(object):
    """Grid-indexed set of convex regions; ``hits`` applies the assignment rule.

    ``wrap``: the x period of the coordinate system (360 for longitudes in a
    geographic system). Features are then also tested shifted by +-``wrap``,
    so 180 and -180 are the same meridian: a point on 180 is on a page that
    ends at -180. ``None`` for projected systems.
    """

    def __init__(self, regions, wrap=None):
        self.regions = list(regions)
        self.wrap = wrap
        boxes = [r["bbox"] for r in self.regions]
        self.extent = (min(b[0] for b in boxes), min(b[1] for b in boxes),
                       max(b[2] for b in boxes), max(b[3] for b in boxes)) if boxes else None
        sizes = sorted(r["size"] for r in self.regions if r["size"] > 0)
        cell = sizes[len(sizes) // 2] if sizes else 1.0
        self.grid = GridIndex(cell)
        for i, region in enumerate(self.regions):
            self.grid.insert(i, region["bbox"])
        # Computed once: recomputing it per query made every lookup O(regions).
        self.tol = max(r["tol"] for r in self.regions) if self.regions else 0.0

    def candidates(self, box):
        if not self.regions or box is None:
            return []
        return self.grid.query(box, self.tol)

    def hits(self, kind, geom):
        """Sorted indexes (into ``regions``) of the regions the geometry is on."""
        if geom is None or not self.regions:
            return []
        found = set(self._hits_one(kind, geom))
        if self.wrap:
            box = geometry_bbox(kind, geom)
            for dx in (self.wrap, -self.wrap):
                moved = (box[0] + dx, box[1], box[2] + dx, box[3])
                if bbox_intersects(moved, self.extent, self.tol):
                    found.update(self._hits_one(kind, _pages_shift(kind, geom, dx)))
        return sorted(found)

    def touches(self, kind, geom):
        """True if a line or polygon touches some region (edge or corner, within the tolerance)
        although it is on none of them. Points are never "touching only": a point on a boundary
        is on the region. Used to tell the user how many unplaced features lie on a page edge."""
        if geom is None or not self.regions or kind not in (GEOM_POLYLINE, GEOM_POLYGON):
            return False
        shifts = [0] + ([self.wrap, -self.wrap] if self.wrap else [])
        for dx in shifts:
            moved = geom if dx == 0 else _pages_shift(kind, geom, dx)
            paths = [close_ring(r) for r in moved] if kind == GEOM_POLYGON else moved
            for path in paths:
                for j in range(len(path) - 1):
                    a, b = path[j], path[j + 1]
                    box = (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1]))
                    for i in self.candidates(box):
                        if _pages_edge_contact(a, b, self.regions[i]):
                            return True
        return False

    def _polygon_hits(self, rings):
        """Regions a polygon overlaps with positive area, without clipping it.

        A region (convex, so connected with a connected interior) overlaps the
        polygon iff (a) some polygon edge runs through the region's interior -
        the polygon's interior lies on one side of every edge - or (b) no edge
        does, so the region is wholly inside or wholly outside the polygon, and
        an interior point of the region is inside it (even-odd rule, holes
        excluded). Edges that coincide with other edges count only where an odd number
        of edges cover them (_pages_odd_segments). Edges are matched to regions through the region grid and
        the inside test uses a ``SegmentGrid``, so the cost is about
        vertices + regions, not vertices x regions. A polygon of zero area is
        on no region.
        """
        rings = [close_ring(r) for r in rings if len(r) >= 3]
        # A ring of zero signed area is on no region only when it is flat (all points on
        # one line); a self-intersecting ring whose parts cancel (a bow-tie) still encloses
        # an area, and the edge and even-odd tests below place it correctly.
        if not rings or all(ring_signed_area(r) == 0.0 and _pages_flat_ring(r) for r in rings):
            return set()
        found = set()
        segments = []
        for ring in rings:
            for j in range(len(ring) - 1):
                a, b = ring[j], ring[j + 1]
                if a != b:
                    segments.append((a, b))
        # Only the even-odd boundary: a stretch that another edge runs back along (a
        # zero-width spike) has no polygon area on either side.
        for a, b in _pages_odd_segments(segments)[0]:
            box = (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1]))
            for i in self.candidates(box):
                if i not in found and _pages_segment_hit(a, b, self.regions[i]):
                    found.add(i)
        grid = None
        for i in self.candidates(geometry_bbox(GEOM_POLYGON, rings)):
            if i in found:
                continue
            if grid is None:
                grid = SegmentGrid(segments)
            if grid.inside(self.regions[i]["inner"]):
                found.add(i)
        return found

    def _hits_one(self, kind, geom):
        found = set()
        if kind == GEOM_POINT:
            for i in self.candidates((geom[0], geom[1], geom[0], geom[1])):
                if _pages_point_hit(geom, self.regions[i]):
                    found.add(i)
        elif kind == GEOM_MULTIPOINT:
            for p in geom:
                for i in self.candidates((p[0], p[1], p[0], p[1])):
                    if i not in found and _pages_point_hit(p, self.regions[i]):
                        found.add(i)
        elif kind == GEOM_POLYLINE:
            for path in geom:
                for j in range(len(path) - 1):
                    a, b = path[j], path[j + 1]
                    box = (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1]))
                    for i in self.candidates(box):
                        if i not in found and _pages_segment_hit(a, b, self.regions[i]):
                            found.add(i)
        elif kind == GEOM_POLYGON:
            found = self._polygon_hits(geom)
        else:
            raise ValueError("unsupported geometry kind: {0}".format(kind))
        return found


def prepare_pages(pages, floor=0.0):
    """Regions for page dicts ``{"oid", "shape", ...}``.

    Returns ``(regions, null_oids, not_convex_oids)``; each region's ``key`` is
    the index of its page in ``pages``. ``floor``: see ``make_region``.
    """
    regions, nulls, bad = [], [], []
    for i, page in enumerate(pages):
        region, state = make_region(i, page.get("shape"), floor)
        if state == REGION_OK:
            regions.append(region)
        elif state == REGION_NULL:
            nulls.append(page["oid"])
        else:
            bad.append(page["oid"])
    return regions, nulls, bad


def oid_list_text(oids, limit=20):
    """``"3, 7, 9"`` (at most ``limit`` items, then ``"and N more"``)."""
    oids = list(oids)
    text = ", ".join(str(o) for o in oids[:limit])
    if len(oids) > limit:
        text += " and {0} more".format(len(oids) - limit)
    return text


# ==========================================================================
# carto/book_index_core.py
# ==========================================================================
# Map Book Index: which map book pages (and grid cells) each named feature is on.
#
# Pure Python. Input pages, grid cells and features are plain dicts with core
# geometry already read in one coordinate system. The assignment rule is the
# one of ``carto.pages_core`` (points: interior or boundary; lines and
# polygons: interior overlap only).
#
# Grid cells use the same rule, with one fallback: a feature that is on a page
# but runs through no cell's interior there (a road exactly on an internal
# grid line) is listed with the cells of that page that meet it where it runs
# along the shared edge of two cells. A feature in a part of a page that no
# cell covers gets no cell there; such pages get a warning (review R11-1).

# Width of the "on the boundary" band, x the coordinate magnitude: twice the band of
# ``common.clip.clip_segment_convex`` (1e-9 x the coordinate), so every line that the
# strict clip calls "not inside" but the closed clip reaches is inside the band.
BOOK_EDGE_REL_BAND = 2e-9

# Two polygon edges lie on one line when every end point is within this x the coordinate
# magnitude (at least 1) of the other edge's line: the boundary band of the edge tests.
BOOK_COLLINEAR_REL = 1e-9

BOOK_GAZETTEER_HEADER = ("NAME", "LAYER", "PAGES", "PAGE_COUNT", "GRID_REFS", "FEATURE_COUNT")
BOOK_UNPLACED_HEADER = ("LAYER", "SRC_OID", "NAME")
STOP_CHECK_EVERY = 500
# Largest run of undecided cells between two pages' ObjectIDs that ``_book_homes`` splits.
BOOK_OID_GAP_MAX = 400


def _book_label(value):
    """Text of a page name, page number or grid cell label; ``None`` if blank or invisible.

    Cleaned like feature names (``index_text``: NFC, control characters and invisible marks
    such as U+200E/U+200F removed, runs of spaces folded, trimmed), so a page "5" and a
    page "5" + U+200F are one label (and the "used by more than one page" warning names
    it) instead of two labels that look the same in PAGES or GRID_REFS (review R13-1).
    """
    text = label_text(value)
    if text is None:
        return None
    return _book_visible(index_text(text))


def _book_page_labels(pages, use_number, messages):
    """Label of every page: its number (if a number field is used) else its name.

    A page with no usable label (no number and a blank name) is listed as ``"OID n"``
    (its ObjectID) and named in a warning of its own; the "page name is used" warning
    counts only pages whose name is actually used (review R14-1).
    """
    labels = []
    fallback = 0
    no_label = []
    blank = []
    for page in pages:
        label = _book_label(page.get("number")) if use_number else None
        if label is None:
            label = _book_label(page.get("name"))
            if label is not None and use_number:
                fallback += 1
        blank.append(label is None)
        if label is None:
            no_label.append(page["oid"])
            label = "OID {0}".format(page["oid"])
        labels.append(label)
    if fallback:
        messages.warning("{0} page(s) have no page number; their page name is used in the "
                         "index instead. Fill the page number field for every page."
                         .format(fallback))
    if no_label:
        messages.warning("{0} page(s) have no page {1}, so they are listed in PAGES as "
                         "'OID n' (n = the page's ObjectID): ObjectIDs {2}. A reader cannot "
                         "find such a page in the map book; fill the page {1} for every page."
                         .format(len(no_label), "name or number" if use_number else "name",
                                 oid_list_text(sorted(no_label))))
    real = set(l for l, k in zip(labels, blank) if not k)
    taken = sorted((o for o in no_label if "OID {0}".format(o) in real))
    if taken:
        messages.warning("The 'OID n' label of these pages with no label is also the real "
                         "label of another page, so their entries are merged: ObjectIDs {0}."
                         .format(oid_list_text(taken)))
    counts = {}
    for label in labels:
        counts[label] = counts.get(label, 0) + 1
    shared = sorted((l for l, n in counts.items() if n > 1), key=natural_sort_key)
    if shared:
        messages.warning("These page labels are used by more than one page, so their entries are "
                         "merged in the index: {0}. Give every page a unique name/number."
                         .format(", ".join(shared[:20])))
    # different labels that are the same whole number ("01" and "1"): readers take them
    # for one page, the index keeps them apart
    by_number = {}
    for label in counts:
        if _BOOK_DIGITS.match(label):
            by_number.setdefault(int(unicodedata.normalize("NFKC", label)), set()).add(label)
    alike = sorted((sorted(v, key=natural_sort_key) for v in by_number.values() if len(v) > 1),
                   key=lambda v: natural_sort_key(v[0]))
    if alike:
        messages.warning("These page labels are different texts for the same number, so the "
                         "index lists them as different pages: {0}. Write every page number "
                         "the same way (for example without leading zeros).".format(
                             "; ".join(" and ".join(v) for v in alike[:20])))
    return labels


_BOOK_DIGITS = re.compile(r"^\d+$")


def _book_perimeter(ring):
    """Length of the outline of a ring."""
    return sum(((ring[k + 1][0] - ring[k][0]) ** 2 + (ring[k + 1][1] - ring[k][1]) ** 2) ** 0.5
               for k in range(len(ring) - 1))


def _book_cells(cells, page_regions, messages, wrap=None, floor=0.0, page_oids=None):
    """Grid cells cut to every page they overlap: ``[(page_index, label, region)]``.

    ``wrap``: 360 for longitudes. A cell is then also cut to the pages it
    overlaps when shifted by +-``wrap`` (a cell at -180..-179 is on a page
    stored as 179..181), and the piece is kept in the page's coordinates.

    Overlapping pages that each have their own grid (a strip map or a map book with
    an overlap margin): the home page of a cell is chosen by ``_book_homes`` (one rule:
    the cells a page owns do not overlap each other). On a page, the piece of a cell
    whose home is another page is left out where it overlaps a cell whose home is this
    page, so a reader of each page is sent to that page's own cells. A grid that covers
    several pages without its cells overlapping each other is not changed.
    ``page_oids``: ObjectID of every page (by page key), for the messages.
    """
    found = []
    bad, nulls, unlabeled = [], 0, 0
    page_index = RegionIndex(page_regions)
    shifts = (0.0, wrap, -wrap) if wrap else (0.0,)
    for cell in cells:
        region, state = make_region(None, cell.get("shape"), floor)
        if state == REGION_NOT_CONVEX:
            bad.append((cell["oid"], cell.get("shape")))
            continue
        if state != REGION_OK:
            nulls += 1
            continue
        label = _book_label(cell.get("label"))
        if label is None:
            unlabeled += 1
            continue
        pieces = []
        for dx in shifts:
            if dx:
                x0, y0, x1, y1 = region["bbox"]
                if not bbox_intersects((x0 + dx, y0, x1 + dx, y1), page_index.extent,
                                       page_index.tol):
                    continue
                cell_region = shift_region(region, dx)
            else:
                cell_region = region
            for i in page_index.candidates(cell_region["bbox"]):
                page = page_regions[i]
                piece = clip_region(None, cell_region, page)
                if piece is not None:
                    piece["key"] = (page["key"], label)
                    pieces.append(piece)
        area_on = {}
        for piece in pieces:
            page_key = piece["key"][0]
            area_on[page_key] = area_on.get(page_key, 0.0) + piece["area"]
        # Length tolerance of the cell: the convexity tolerance of pages and cells (at least
        # ``floor``, 0.5 mm in a projected system), so coordinates rounded to the geodatabase
        # resolution (pages and grid stored or projected separately) are within it.
        ltol = convex_tolerance(region["ring"], floor)
        for piece in pieces:
            piece["ltol"] = ltol
        found.append({"oid": cell["oid"], "label": label, "area": region["area"],
                      "perimeter": _book_perimeter(region["ring"]), "ltol": ltol,
                      "area_on": area_on, "pieces": pieces})
    if bad:
        cause, fix = not_convex_error("cell(s) of the grid", bad,
                                      "Or leave Grid Layer empty.")
        raise ToolError(cause, fix)
    if nulls:
        messages.info("{0} grid cell(s) have no geometry or no area and were ignored.".format(nulls))
    if unlabeled:
        messages.warning("{0} grid cell(s) have no label and were ignored. Fill the grid label "
                         "field for every cell.".format(unlabeled))
    _book_homes(found)
    out = []
    for cell in found:
        for piece in cell["pieces"]:
            piece["home"] = cell["home"]
            piece["cell_oid"] = cell["oid"]
            piece["multi_page"] = len(cell["area_on"]) > 1
            out.append(piece)
    return _book_own_cells(out, messages, page_oids)


def _book_best(candidates, score, rel):
    """The candidates whose ``score`` is within ``rel`` of the best (lowest) one."""
    best = min(score(c) for c in candidates)
    return [c for c in candidates if score(c) - best <= rel]


# Area of a cell overlap (x the smaller cell's area) that counts as "the cells overlap" in
# ``_book_homes`` and ``_book_own_cells``; rounding slivers of rotated grids at UTM
# coordinates stay far below it.
BOOK_CELL_OVERLAP_REL = 1e-6


def _book_cells_overlap(a, b):
    """True if two cell pieces overlap with an area (not just along an edge or corner).

    The overlap must be more than ``BOOK_CELL_OVERLAP_REL`` x the smaller piece's area, and
    wider than the cells' length tolerance ``ltol`` (its width taken as 2 x area /
    perimeter): two neighbouring cells whose shared edge was rounded differently overlap in
    a sliver a fraction of a millimetre wide, and that is not an overlap of the grid.
    """
    ax0, ay0, ax1, ay1 = a["bbox"]
    bx0, by0, bx1, by1 = b["bbox"]
    tol = max(a["tol"], b["tol"], a.get("ltol", 0.0), b.get("ltol", 0.0))
    if min(ax1, bx1) - max(ax0, bx0) <= tol or min(ay1, by1) - max(ay0, by0) <= tol:
        return False
    piece = clip_region(None, a, b)
    if piece is None or piece["area"] <= BOOK_CELL_OVERLAP_REL * min(a["area"], b["area"]):
        return False
    ltol = max(a.get("ltol", 0.0), b.get("ltol", 0.0))
    return 2.0 * piece["area"] > ltol * _book_perimeter(piece["ring"])


def _book_homes(found):
    """Set ``cell["home"]`` for every cell of ``found`` (see ``_book_cells``).

    One rule: **the cells a page owns do not overlap each other.** A cell can only belong
    to a page that holds all of it (more exactly: the largest part of it, within the
    cell's perimeter x its length tolerance ``ltol``, at least 1e-7 of the cell's area, so
    a cell that a rounding of the stored coordinates puts a fraction of a millimetre
    outside its own page is still on it); these pages are its candidates. A cell with one candidate belongs to
    it. The other cells are decided by these consequences of the rule, applied again and
    again until nothing changes (each later one only when the earlier ones decide nothing):

    1. a page is struck from a cell's candidates when, on that page, the cell overlaps
       (with an area) a cell that page already owns; a cell left with one candidate is
       owned by it;
    2. a cell is owned by its one candidate page that does not yet own a cell with the
       same label (each page's grid labelled A, B, ... again);
    3. only when the decided cells show that each page's cells are numbered one after the
       other (sorted by ObjectID, the pages they belong to form one run per page; per-page
       grids are usually made this way): the undecided cells between the last decided cell
       of one page and the first of the next must be split there, the lower ObjectIDs to
       the first page and the higher to the second, so that no page owns two overlapping
       cells. A cell that is on the same page in every such split belongs to that page.

    A cell that is still undecided keeps ``home=None`` (it is then used on every page it is
    on, with a warning where it overlaps another cell). No step uses page or cell centres:
    with a fine grid the cells of both pages lie wholly in the overlap, and which page's
    centre is nearer says nothing about which page's grid a cell is part of.
    """
    pieces, owner, pending = [], [], []
    for n, cell in enumerate(found):
        cands = list(cell["area_on"])
        cell["home"] = None
        cell["cands"] = cands
        if cands:
            slack = max(1e-7 * cell["area"], cell["perimeter"] * cell["ltol"])
            cands = _book_best(cands, lambda k: -cell["area_on"][k], slack)
            cell["cands"] = cands
            if len(cands) == 1:
                cell["home"] = cands[0]
            else:
                pending.append(n)
        for piece in cell["pieces"]:
            pieces.append(piece)
            owner.append(n)
    if not pending:
        return
    # conflicts of every undecided cell: {other cell: pages on which the two overlap}
    index = RegionIndex(pieces)
    conflicts = {}
    for n in pending:
        conf = conflicts[n] = {}
        cands = set(found[n]["cands"])
        for piece in found[n]["pieces"]:
            page = piece["key"][0]
            if page not in cands:
                continue
            for j in index.candidates(piece["bbox"]):
                m = owner[j]
                other = pieces[j]
                if m != n and other["key"][0] == page and _book_cells_overlap(piece, other):
                    conf.setdefault(m, set()).add(page)

    def open_cells():
        return [n for n in pending if found[n]["home"] is None]

    def strike():
        again = True
        while again:
            again = False
            for n in open_cells():
                cell = found[n]
                keep = [k for k in cell["cands"]
                        if not any(found[m]["home"] == k and k in pages
                                   for m, pages in conflicts[n].items())]
                if keep and len(keep) < len(cell["cands"]):
                    cell["cands"] = keep
                    again = True
                if len(cell["cands"]) == 1:
                    cell["home"] = cell["cands"][0]
                    again = True

    def by_label():
        owned = set((c["home"], c["label"]) for c in found if c["home"] is not None)
        decided = []
        for n in open_cells():
            cell = found[n]
            free = [k for k in cell["cands"] if (k, cell["label"]) not in owned]
            if len(free) == 1:
                decided.append((cell, free[0]))
        for cell, page in decided:
            cell["home"] = page
        return bool(decided)

    def by_objectid():
        by_oid = sorted((c["oid"], c["home"]) for c in found
                        if c["home"] is not None and _book_number(c["oid"]))
        runs = sum(1 for k in range(1, len(by_oid)) if by_oid[k][1] != by_oid[k - 1][1])
        if not by_oid or runs + 1 != len(set(h for _, h in by_oid)):
            return False
        oids = [o for o, _ in by_oid]
        gaps = {}
        for n in open_cells():
            if _book_number(found[n]["oid"]):
                gaps.setdefault(bisect.bisect_left(oids, found[n]["oid"]), []).append(n)
        decided = []
        for at, members in gaps.items():
            if len(members) > BOOK_OID_GAP_MAX:
                continue
            members.sort(key=lambda n: found[n]["oid"])
            first = by_oid[at - 1][1] if at > 0 else None
            second = by_oid[at][1] if at < len(by_oid) else None
            agreed = [set() for _ in members]
            for split in range(len(members) + 1):
                pages = [first if k < split else second for k in range(len(members))]
                if _book_split_ok(members, pages, found, conflicts):
                    for k, page in enumerate(pages):
                        agreed[k].add(page)
            for n, pages in zip(members, agreed):
                if len(pages) == 1:
                    decided.append((found[n], pages.pop()))
        for cell, page in decided:
            cell["home"] = page
        return bool(decided)

    while True:
        strike()
        if not open_cells():
            return
        if by_label():
            continue
        if not by_objectid():
            return


def _book_split_ok(members, pages, found, conflicts):
    """True if giving ``members`` (undecided cells) the ``pages`` keeps the rule: each is a
    candidate of its page and overlaps no cell that page owns or is given here."""
    given = dict(zip(members, pages))
    for n, page in given.items():
        if page is None or page not in found[n]["cands"]:
            return False
        for m, on in conflicts[n].items():
            if page in on and (found[m]["home"] == page or given.get(m) == page):
                return False
    return True


def _book_number(value):
    """True for an int or float ObjectID (not a bool)."""
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def _book_own_cells(pieces, messages, page_oids=None):
    """Leave out, on each page, the pieces of another page's cells that overlap this
    page's own cells (see ``_book_cells``); warn about cells that still overlap."""
    if not pieces:
        return pieces
    index = RegionIndex(pieces)
    dropped, dropped_pages = [], set()
    clash_pages, clash_cells = set(), set()
    tie_pages, tie_cells = set(), set()

    def same_page_overlaps(i, keep=None):
        piece = pieces[i]
        for j in index.candidates(piece["bbox"]):
            if j == i or (keep is not None and j not in keep):
                continue
            other = pieces[j]
            if other["key"][0] != piece["key"][0] or other["cell_oid"] == piece["cell_oid"]:
                continue
            if _book_cells_overlap(piece, other):
                yield other

    # first: the pieces of another page's cells that overlap a cell this page owns
    for i, piece in enumerate(pieces):
        page_key = piece["key"][0]
        if piece["home"] is None or piece["home"] == page_key:
            continue
        if any(other["home"] == page_key for other in same_page_overlaps(i)):
            dropped.append(i)
            dropped_pages.add(page_key)
    drop = set(dropped)
    keep = set(k for k in range(len(pieces)) if k not in drop)
    # then: the pieces that are left and still overlap each other
    for i in sorted(keep):
        piece = pieces[i]
        for other in same_page_overlaps(i, keep):
            undecided = [p for p in (piece, other) if p["home"] is None and p["multi_page"]]
            if undecided:
                tie_pages.add(piece["key"][0])
                tie_cells.update(p["cell_oid"] for p in undecided)
            else:
                clash_pages.add(piece["key"][0])
                clash_cells.update((piece["cell_oid"], other["cell_oid"]))

    def page_text(keys):
        oids = sorted(page_oids[k] for k in keys) if page_oids is not None else sorted(keys)
        return oid_list_text(oids)

    if dropped:
        messages.warning("Pages overlap and each has its own grid (as in a strip map): on {0} "
                         "page(s) (ObjectIDs {1}) the cells of a neighbouring page reach into "
                         "this page's own cells. There, each page uses only its own cells, so a "
                         "feature in the overlap is listed on every page with the cell of that "
                         "page's own grid. A cell belongs to a page that holds the largest part "
                         "of it, and the cells of one page do not overlap each other: where a "
                         "cell lies wholly on several pages, a page is ruled out when the cell "
                         "overlaps a cell that page already owns (then: the page with no other "
                         "cell of that label, then, when each page's cells are numbered one "
                         "after the other, the ObjectID order).".format(
                             len(dropped_pages), page_text(dropped_pages)))
    if tie_pages:
        messages.warning("Pages overlap and each has its own grid, but for {0} cell(s) "
                         "(ObjectIDs {1}) the tool cannot tell which page they belong to: "
                         "each lies wholly on overlapping pages (page ObjectIDs {2}), and "
                         "neither the neighbouring cells, the labels nor the ObjectIDs decide "
                         "it. A "
                         "feature there is listed with these cells on each of those pages. "
                         "The grid itself may be correct. Fix: make the page overlap smaller "
                         "than a cell, give each page's grid the same labels (A, B, ...) so the "
                         "tool can tell them apart, or number the cells of each page one after "
                         "the other.".format(
                             len(tie_cells), oid_list_text(sorted(tie_cells)),
                             page_text(tie_pages)))
    if clash_pages:
        messages.warning("Grid cells overlap each other on {0} page(s) (page ObjectIDs {1}; "
                         "cell ObjectIDs {2}), so a feature in the overlap is listed with every "
                         "cell it is in there. Check the grid layer: on a page, cells should "
                         "not overlap.".format(len(clash_pages), page_text(clash_pages),
                                                oid_list_text(sorted(clash_cells))))
    return [p for k, p in enumerate(pieces) if k not in drop]


def _book_overlap_span(s, t, tol):
    """Part ``(lo, hi)`` of segment ``s`` (as fractions of its length) that segment ``t``
    covers when both lie on one line (within ``tol``), or ``None`` (not on one line, or an
    overlap no longer than ``tol``)."""
    (ax, ay), (bx, by) = s
    (cx, cy), (dx, dy) = t
    ux, uy = bx - ax, by - ay
    vx, vy = dx - cx, dy - cy
    ls = (ux * ux + uy * uy) ** 0.5
    lt = (vx * vx + vy * vy) ** 0.5
    if ls == 0.0 or lt == 0.0:
        return None
    if (abs(ux * (cy - ay) - uy * (cx - ax)) > tol * ls
            or abs(ux * (dy - ay) - uy * (dx - ax)) > tol * ls
            or abs(vx * (ay - cy) - vy * (ax - cx)) > tol * lt
            or abs(vx * (by - cy) - vy * (bx - cx)) > tol * lt):
        return None
    l2 = ls * ls
    tc = (ux * (cx - ax) + uy * (cy - ay)) / l2
    td = (ux * (dx - ax) + uy * (dy - ay)) / l2
    lo, hi = max(0.0, min(tc, td)), min(1.0, max(tc, td))
    if (hi - lo) * ls <= tol:
        return None
    return lo, hi


def _book_odd_segments(segments):
    """The parts of polygon edges that are boundary under the even-odd rule.

    A stretch of an edge that other edges of the polygon run along (an out-and-back
    "antenna" or spike, a ring traced twice, a hole edge on the outer edge) is boundary
    only where an odd number of edges cover it: two coinciding edges cancel, and the
    polygon has no area on either side of them. Returns ``(pieces, cancelled)``:
    ``pieces`` replaces ``segments``, ``cancelled`` is True when some stretch cancelled
    (else ``pieces`` is ``segments``). Cost: about linear in the edges (a uniform grid);
    only the edges that overlap another edge are split."""
    segs = [(a, b) for a, b in segments if a != b]
    if len(segs) < 2:
        return segs, False
    xs = [p[0] for s in segs for p in s]
    ys = [p[1] for s in segs for p in s]
    x0, y0 = min(xs), min(ys)
    scale = max(1.0, max(abs(v) for v in xs), max(abs(v) for v in ys))
    tol = BOOK_COLLINEAR_REL * scale
    width, height = max(xs) - x0, max(ys) - y0
    n = len(segs)
    size = max(width, height, 1e-300)
    cell = max((max(width * height, size * size / n) / n) ** 0.5, size / 4096.0, 1e-300)

    def span(lo, hi, origin):
        return int((lo - tol - origin) / cell), int((hi + tol - origin) / cell)

    partners = {}

    def pair(k, j):
        if j != k and j not in partners.get(k, ()) and \
                _book_overlap_span(segs[k], segs[j], tol) is not None:
            partners.setdefault(k, set()).add(j)
            partners.setdefault(j, set()).add(k)

    # Two edges overlap (with a length) only if they have the same end points, or an end
    # point of one lies on the other away from its end points. Edges with the same end
    # points are found by a dictionary, the others through a grid of the end points.
    same, at_vertex, grid = {}, {}, {}
    for k, (a, b) in enumerate(segs):
        same.setdefault((a, b) if a <= b else (b, a), []).append(k)
        for q in (a, b):
            if q not in at_vertex:
                at_vertex[q] = []
                grid.setdefault((int((q[0] - x0) / cell), int((q[1] - y0) / cell)), []).append(q)
            at_vertex[q].append(k)
    for group in same.values():
        for k in group[1:]:
            pair(group[0], k)
            for j in group[1:]:
                if j != k:
                    pair(j, k)
    for j, (a, b) in enumerate(segs):
        ux, uy = b[0] - a[0], b[1] - a[1]
        l2 = ux * ux + uy * uy
        band = tol * l2 ** 0.5
        c0, c1 = span(min(a[0], b[0]), max(a[0], b[0]), x0)
        r0, r1 = span(min(a[1], b[1]), max(a[1], b[1]), y0)
        for c in range(c0, c1 + 1):
            for r in range(r0, r1 + 1):
                for q in grid.get((c, r), ()):
                    if q == a or q == b:
                        continue
                    wx, wy = q[0] - a[0], q[1] - a[1]
                    if abs(ux * wy - uy * wx) > band:
                        continue
                    t = ux * wx + uy * wy
                    if t < -band or t > l2 + band:
                        continue
                    for k in at_vertex[q]:
                        pair(j, k)
    if not partners:
        return segs, False
    pieces, cancelled = [], False
    for k, s in enumerate(segs):
        if k not in partners:
            pieces.append(s)
            continue
        spans = [(j, _book_overlap_span(s, segs[j], tol)) for j in partners[k]]
        spans = [(j, v) for j, v in spans if v is not None]
        cuts = sorted(set([0.0, 1.0] + [v for _, sp in spans for v in sp]))
        (ax, ay), (bx, by) = s
        start = None
        for lo, hi in zip(cuts[:-1], cuts[1:]):
            mid = (lo + hi) / 2.0
            cover = [j for j, (u, v) in spans if u <= mid <= v]
            odd = len(cover) % 2 == 0          # with this edge: an odd number
            if not odd:
                cancelled = True
            # a stretch covered by several edges is given once, by the lowest edge
            odd = odd and all(j > k for j in cover)
            if odd and start is None:
                start = lo
            if not odd and start is not None:
                pieces.append(((ax + start * (bx - ax), ay + start * (by - ay)),
                               (ax + lo * (bx - ax), ay + lo * (by - ay))))
                start = None
        if start is not None:
            pieces.append(((ax + start * (bx - ax), ay + start * (by - ay)), s[1]))
    if not cancelled:
        return segs, False
    return [p for p in pieces if p[0] != p[1]], True


class BookRegionIndex(RegionIndex):
    """``pages_core.RegionIndex`` whose polygon test leaves out edges that cancel.

    The shared test counts a region as soon as a polygon edge runs through its interior,
    because the polygon's interior lies on one side of every edge. That is not true of an
    edge that another edge of the polygon runs back along (a zero-width spike or
    "antenna" of an unrepaired polygon): there the polygon has no area on either side, and
    a page or cell that only the spike reaches was listed. Here only the even-odd boundary
    (``_book_odd_segments``) is used for the edge test; polygons without such edges get
    exactly the shared result. ``spiked`` is set by ``hits`` when a region that a raw
    edge reaches was left out for this reason."""

    _last = None   # (rings, (segments, pieces, cancelled)) of the last polygon tested

    def hits(self, kind, geom):
        self.spiked = False
        return RegionIndex.hits(self, kind, geom)

    def _polygon_hits(self, rings):
        closed = [close_ring(r) for r in rings if len(r) >= 3]
        if not closed or all(ring_signed_area(r) == 0.0 for r in closed):
            return set()
        cached = BookRegionIndex._last
        if cached is not None and cached[0] is rings:
            segments, pieces, cancelled = cached[1]
        else:
            # the page index and the cell index test the same feature one after the other
            segments = [(r[j], r[j + 1]) for r in closed for j in range(len(r) - 1)
                        if r[j] != r[j + 1]]
            pieces, cancelled = _book_odd_segments(segments)
            BookRegionIndex._last = (rings, (segments, pieces, cancelled))
        if not cancelled:
            return RegionIndex._polygon_hits(self, rings)
        found = set()
        for a, b in pieces:
            box = (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1]))
            for i in self.candidates(box):
                if i not in found and segment_inside_length(
                        a, b, self.regions[i]["ring"], strict=True) > self.regions[i]["tol"]:
                    found.add(i)
        # No odd edge runs through the other regions, so the polygon is wholly inside or
        # wholly outside each one (coinciding edges flip the even-odd count twice).
        grid = None
        for i in self.candidates(geometry_bbox(GEOM_POLYGON, closed)):
            if i in found:
                continue
            if grid is None:
                grid = SegmentGrid(segments)
            if grid.inside(self.regions[i]["inner"]):
                found.add(i)
        if not self.spiked:
            for a, b in segments:
                box = (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1]))
                if any(i not in found and segment_inside_length(
                        a, b, self.regions[i]["ring"], strict=True) > self.regions[i]["tol"]
                       for i in self.candidates(box)):
                    self.spiked = True
                    break
        return found


def _book_segments(kind, geom):
    """Segments ``(a, b)`` of a line or of a polygon's rings (``a == b`` kept)."""
    if geom is None:
        return
    if kind == GEOM_POLYLINE:
        paths = geom
    elif kind == GEOM_POLYGON:
        paths = [close_ring(r) for r in geom if r]
    else:
        return
    for path in paths:
        if len(path) == 1:
            yield path[0], path[0]
        for j in range(len(path) - 1):
            yield path[j], path[j + 1]


def _book_shifts(index):
    return (0.0, index.wrap, -index.wrap) if index.wrap else (0.0,)


def _book_shift(kind, geom, dx):
    if not dx:
        return geom
    return [[(x + dx, y) for x, y in part] for part in geom]


def _book_edge_contact(a, b, region):
    """True if segment ``a``-``b`` (a point when ``a == b``) meets ``region`` on its
    boundary: the middle of the part of the segment in the closed region lies within
    the boundary band. A short or zero-length piece in the middle of the region is not
    a boundary contact."""
    ring = region["ring"]
    if a == b:
        p = a
    else:
        hit = clip_segment_convex(a, b, ring, False)
        if hit is None:
            return False
        t = (hit[0] + hit[1]) / 2.0
        p = (a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1]))
    scale = max(1.0, abs(a[0]), abs(a[1]), abs(b[0]), abs(b[1]))
    band = max(region["tol"], BOOK_EDGE_REL_BAND * scale)
    return point_in_ring(p, ring, band) == "boundary"


def _book_touches_edge(index, kind, geom):
    """True if an unplaced line or polygon touches a page on its edge or corner.

    Replaces ``RegionIndex.touches`` here: that one also counts a zero-length line or a
    zero-area polygon lying in the middle of a page (``a == b`` points and collapsed
    rings), which do not touch any edge."""
    if geom is None or not index.regions or kind not in (GEOM_POLYLINE, GEOM_POLYGON):
        return False
    for dx in _book_shifts(index):
        for a, b in _book_segments(kind, _book_shift(kind, geom, dx)):
            box = (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1]))
            for i in index.candidates(box):
                if _book_edge_contact(a, b, index.regions[i]):
                    return True
    return False


def _book_degenerate(kind, geom):
    """True for a line of zero length or a polygon of zero area (a collapsed geometry)."""
    if geom is None:
        return False
    if kind == GEOM_POLYLINE:
        return all(a == b for a, b in _book_segments(kind, geom))
    if kind == GEOM_POLYGON:
        return all(len(r) < 3 or ring_signed_area(close_ring(r)) == 0.0 for r in geom)
    return False


def _book_cancelled_ring(kind, geom):
    """True for a zero-area polygon with a ring that is not flat (its points do not all
    lie on one line): a self-intersecting ring whose parts cancel, such as a bow-tie."""
    if kind != GEOM_POLYGON or geom is None:
        return False
    for ring in geom:
        pts = list(ring)
        if len(pts) < 3:
            continue
        a = pts[0]
        b = None
        for q in pts[1:]:
            if q != a:
                b = q
                break
        if b is None:
            continue
        span = max(abs(q[c] - a[c]) for q in pts for c in (0, 1))
        for q in pts:
            cross = (b[0] - a[0]) * (q[1] - a[1]) - (b[1] - a[1]) * (q[0] - a[0])
            if abs(cross) > 1e-9 * span * span:
                return True
    return False


def _book_visible(name):
    """``name``, or ``None`` when it is only format characters and spaces (a name that
    is only a zero width joiner or non-joiner would be an invisible index entry)."""
    if name is None:
        return None
    if all(c.isspace() or unicodedata.category(c) == "Cf" for c in name):
        return None
    return name


_BOOK_PAGE_RANGE_LIKE = re.compile(r"^\d+\s*-\s*\d+$")


def _book_label_separators(page_labels, cells, messages):
    """Warn about page and cell labels that contain the separators of PAGES and
    GRID_REFS (", " between pages, "; " between pages and ":" / "," in grid refs) or a
    page label such as "1-2" that reads like a page range."""
    pages_bad = sorted(set(l for l in page_labels if any(c in l for c in ",;:")
                           or _BOOK_PAGE_RANGE_LIKE.match(l)), key=natural_sort_key)
    cells_bad = set()
    for cell in cells or ():
        label = _book_label(cell.get("label"))
        if label is not None and any(c in label for c in ",;:"):
            cells_bad.add(label)
    cells_bad = sorted(cells_bad, key=natural_sort_key)
    if pages_bad:
        messages.warning("These page labels contain ',', ';' or ':' or look like a page range "
                         "(such as 1-2), so PAGES and GRID_REFS cannot be read unambiguously: "
                         "{0}. Use page names or numbers without these characters.".format(
                             ", ".join(pages_bad[:20])))
    if cells_bad:
        messages.warning("These grid cell labels contain ',', ';' or ':', the separators of "
                         "GRID_REFS, so GRID_REFS cannot be read unambiguously: {0}. Use cell "
                         "labels without these characters.".format(", ".join(cells_bad[:20])))


def _book_merge(spans, eps):
    """Union of ``(lo, hi)`` intervals (gaps up to ``eps`` closed)."""
    out = []
    for lo, hi in sorted(spans):
        if out and lo <= out[-1][1] + eps:
            out[-1][1] = max(out[-1][1], hi)
        else:
            out.append([lo, hi])
    return out


def _book_grid_line_spans(spans, eps):
    """The stretches ``[lo, hi]`` (fractions of a segment) covered by two or more of the
    cell intervals ``spans`` (each longer than ``eps``): a segment on the shared edge of two
    cells. Cells do not overlap each other, so two cells along one stretch lie on its two
    sides; a stretch along one cell only is on the outer edge of the grid."""
    events = []
    for lo, hi in spans:
        events.append((lo - eps, 1))
        events.append((hi + eps, -1))
    events.sort(key=lambda e: (e[0], -e[1]))
    out, depth, start = [], 0, None
    for at, step in events:
        depth += step
        if depth >= 2 and start is None:
            start = at
        elif depth < 2 and start is not None:
            if at - start > 2.0 * eps:
                out.append((start + eps, at - eps))
            start = None
    return out


def _book_fallback_cells(kind, geom, page, page_shifts, page_cells, cell_regions):
    """Labels of the cells of one page that a feature runs along on a grid line there.

    Used only when the feature is on the page but runs through no cell's interior there.
    Only the parts of the feature inside the page's interior are tested, so a cell that
    the feature touches only on the page's outer edge is not added. A part counts only
    where it runs along the **shared edge of two cells** (review R11-1): a road in a part
    of the page that no cell covers, which only touches a cell at an end point or runs
    along the outer edge of the grid, gets no cell. The cells listed are those that meet
    such a stretch (a cell touched at the end of the stretch, at a grid corner, too)."""
    found = set()
    for dx in page_shifts:
        segments = list(_book_segments(kind, _book_shift(kind, geom, dx)))
        if kind == GEOM_POLYGON:
            # a stretch of a ring that another edge runs back along (a zero-width spike)
            # has no area beside it and touches no cell
            segments = _book_odd_segments(segments)[0]
        for a, b in segments:
            if a == b:
                continue
            hit = clip_segment_convex(a, b, page["ring"], True)
            if hit is None:
                continue
            p = (a[0] + hit[0] * (b[0] - a[0]), a[1] + hit[0] * (b[1] - a[1]))
            q = (a[0] + hit[1] * (b[0] - a[0]), a[1] + hit[1] * (b[1] - a[1]))
            length = ((q[0] - p[0]) ** 2 + (q[1] - p[1]) ** 2) ** 0.5
            if length == 0.0:
                continue
            band = BOOK_EDGE_REL_BAND * max(1.0, abs(p[0]), abs(p[1]), abs(q[0]), abs(q[1]))
            box = (min(p[0], q[0]), min(p[1], q[1]), max(p[0], q[0]), max(p[1], q[1]))
            spans = []
            for i in page_cells:
                cell = cell_regions[i]
                if not bbox_intersects(box, cell["bbox"], cell["tol"] + band):
                    continue
                span = clip_segment_convex(p, q, cell["ring"], False)
                if span is not None:
                    spans.append((span, cell["key"][1], max(cell["tol"], band) / length))
            if not spans:
                continue
            eps = max(e for _, _, e in spans)
            lines = _book_grid_line_spans([s for s, _, e in spans if (s[1] - s[0]) > e], eps)
            for (lo, hi), label, e in spans:
                if any(lo <= g1 + eps and hi >= g0 - eps for g0, g1 in lines):
                    found.add(label)
    return found


def _book_no_cell_error(cells, floor=0.0):
    """Raise the error of a grid layer of which no cell overlaps any page (review R10-1).

    The cause also says how many cells have no geometry (or no area) and how many have no
    label, so a grid of empty shapes is named as such instead of only "check the layer"."""
    fix = ("Choose the grid layer that belongs to these pages (the same area; check its "
           "selection, definition query and coordinate system), or leave Grid Layer empty.")
    if not cells:
        raise ToolError("The grid layer has no cell, so no feature could get a grid "
                        "reference.", fix)
    unlabeled = sum(1 for cell in cells if _book_label(cell.get("label")) is None)
    cause = ("No page has a grid cell: none of the {0} grid cell(s) overlaps a page with an "
             "area, so GRID_REFS would be empty for every entry.".format(len(cells)))
    no_shape = sum(1 for cell in cells
                   if make_region(None, cell.get("shape"), floor)[1] not in (REGION_OK,
                                                                             REGION_NOT_CONVEX))
    if no_shape:
        cause += " {0} of the cells have no geometry or no area and are ignored.".format(no_shape)
    if unlabeled:
        cause += " {0} of the cells have no label and are ignored.".format(unlabeled)
    raise ToolError(cause, fix)


# Area that the cells of a page may miss of it before the page counts as "only partly
# covered", x the page area (rounding of UTM coordinates in the area sums stays far below).
BOOK_COVER_REL = 1e-7


def _book_part_covered(regions, cells_of_page, cell_index):
    """Keys of the pages that have grid cells but whose cells cover less than the page
    (review R11-1): the summed area of the cell pieces on the page is smaller than the page
    area by more than the rounding allowance (each piece's perimeter x its length
    tolerance, the page's perimeter x its tolerance, and ``BOOK_COVER_REL`` x its area).
    Cells that overlap each other on a page add their overlap twice, so such a page may be
    missed; that overlap has its own warning."""
    part = []
    for region in regions:
        members = cells_of_page.get(region["key"])
        if not members:
            continue
        pieces = [cell_index.regions[i] for i in members]
        covered = sum(piece["area"] for piece in pieces)
        slack = (sum(_book_perimeter(piece["ring"]) * max(piece.get("ltol", 0.0), piece["tol"])
                     for piece in pieces)
                 + _book_perimeter(region["ring"]) * region["tol"] + BOOK_COVER_REL * region["area"])
        if region["area"] - covered > slack:
            part.append(region["key"])
    return part


def index_features(pages, layers, cells=None, use_number=False, per_page_fields=None,
                   wrap=None, page_floor=0.0, should_stop=None):
    """Build the gazetteer.

    ``pages``: ``[{"oid", "name", "number", "shape"}]`` (polygon core geometry).
    ``layers``: ``[{"layer": label, "kind": core kind, "rows": [{"oid", "shape",
    "name", "values": [per-page field values] or None}]}]``.
    ``cells``: optional ``[{"oid", "label", "shape"}]``.
    ``per_page_fields``: names of the per-page fields (``None`` = no per-page table);
    a layer's rows carry their values in ``values`` (``None`` if the layer
    lacks the fields and is left out of that table).
    ``wrap``: 360 when coordinates are longitudes (180 and -180 are the same
    meridian), else ``None``; see ``pages_core.RegionIndex``.
    ``page_floor``: absolute convexity tolerance of pages and cells, in
    coordinate units (``pages_core.convex_floor``).
    ``should_stop``: optional callable, called about every ``STOP_CHECK_EVERY``
    features; it raises (the tool passes a cancel check) to end the run.

    Returns ``{"gazetteer": [...], "unplaced": [...], "per_page": [...],
    "counts": {...}, "messages": MessageCollector}``. Gazetteer rows are dicts
    with the keys of ``BOOK_GAZETTEER_HEADER`` in lower case.
    ``counts["pages_without_cells"]``: pages that no grid cell overlaps with an area (``None``
    without ``cells``); they get a warning. ``counts["pages_part_cells"]``: pages that have
    cells, but whose cells cover less than the page (``_book_part_covered``); they get a
    warning too.
    Raises ``ToolError`` if a page is not a single convex polygon, or if ``cells`` is given
    (even empty) and no page has a cell.
    """
    messages = MessageCollector()
    regions, null_pages, bad_pages = prepare_pages(pages, page_floor)
    if bad_pages:
        bad = set(bad_pages)
        cause, fix = not_convex_error("page(s) of the index layer", [
            (page["oid"], page.get("shape")) for page in pages if page["oid"] in bad])
        raise ToolError(cause + " Pages must be simple rectangles or other convex shapes.",
                        fix)
    if null_pages:
        messages.warning("{0} page(s) have no geometry or no area and hold no features "
                         "(ObjectIDs {1}). Fix or delete these pages.".format(
                             len(null_pages), oid_list_text(null_pages)))
    if not regions:
        cause = "The index layer has no page with a usable polygon."
        if null_pages:
            cause += (" {0} page(s) have no geometry or no area (ObjectIDs {1}).".format(
                len(null_pages), oid_list_text(null_pages)))
        raise ToolError(cause, "Check the index layer (and its selection or definition query).")
    labels = _book_page_labels(pages, use_number, messages)
    page_index = BookRegionIndex(regions, wrap)
    _book_label_separators(labels, cells, messages)
    page_oids = [page["oid"] for page in pages]
    cell_index = BookRegionIndex(_book_cells(cells, regions, messages, wrap, page_floor,
                                             page_oids), wrap) if cells else None
    region_of_page = dict((region["key"], region) for region in regions)
    cells_of_page = {}
    if cell_index is not None:
        for i, cell in enumerate(cell_index.regions):
            cells_of_page.setdefault(cell["key"][0], []).append(i)
    # A grid that misses some or all pages (another area, a wrong layer, a selection) would
    # leave GRID_REFS empty there with no sign of it (review R10-1): count those pages.
    pages_without_cells = pages_part_cells = None
    if cells is not None:
        empty = [region["key"] for region in regions if region["key"] not in cells_of_page]
        if len(empty) == len(regions):
            _book_no_cell_error(cells, page_floor)
        if empty:
            unlabeled = sum(1 for cell in cells if _book_label(cell.get("label")) is None)
            messages.warning("{0} of {1} page(s) have no grid cell (page ObjectIDs {2}): no "
                             "cell of the grid layer overlaps them with an area{3}, so GRID_REFS "
                             "lists no cell for these pages (a feature there has the page in "
                             "PAGES only). Check that the grid layer covers every page."
                             .format(len(empty), len(regions),
                                     oid_list_text(sorted(page_oids[k] for k in empty)),
                                     " (cells without a label are not counted)" if unlabeled
                                     else ""))
        pages_without_cells = len(empty)
        part = _book_part_covered(regions, cells_of_page, cell_index)
        if part:
            messages.warning("{0} of {1} page(s) are only partly covered by grid cells (page "
                             "ObjectIDs {2}): a feature in the part of such a page that no "
                             "cell covers has no grid reference for that page (it has the "
                             "page in PAGES; GRID_REFS lists only the cells it is in). Check "
                             "that the grid layer covers every page.".format(
                                 len(part), len(regions),
                                 oid_list_text(sorted(page_oids[k] for k in part))))
        pages_part_cells = len(part)

    # Names (and per-page values) are cleaned with ``index_text`` (NFC, invisible marks
    # and control characters removed, runs of spaces folded), so spellings that look the
    # same ("u" + U+0308 and U+00FC, "Java Cafe" with a trailing U+200E or a double space)
    # are one entry.
    groups = {}
    unplaced = []
    per_page = {}
    counts = {"features": 0, "indexed": 0, "unnamed": 0, "unplaced": 0, "null_geometry": 0,
              "touching": 0, "degenerate": 0, "self_intersecting": 0, "cell_fallback": 0,
              "spiked": 0}
    for layer in layers:
        kind = layer["kind"]
        for row in layer["rows"]:
            counts["features"] += 1
            if should_stop is not None and counts["features"] % STOP_CHECK_EVERY == 0:
                should_stop()
            hits = [regions[i]["key"] for i in page_index.hits(kind, row["shape"])]
            spiked = kind == GEOM_POLYGON and page_index.spiked
            if per_page_fields and row.get("values") is not None:
                texts = tuple(index_text(v) for v in row["values"])
                if any(t is not None for t in texts):
                    for page in hits:
                        per_page.setdefault((labels[page],) + texts, (labels[page],) + texts)
            name = _book_visible(index_text(row.get("name")))
            if name is None:
                counts["unnamed"] += 1
                continue
            if row["shape"] is None:
                counts["null_geometry"] += 1
            if not hits:
                if spiked:
                    counts["spiked"] += 1
                counts["unplaced"] += 1
                unplaced.append({"layer": layer["layer"], "src_oid": row["oid"], "name": name})
                if _book_touches_edge(page_index, kind, row["shape"]):
                    counts["touching"] += 1
                elif _book_degenerate(kind, row["shape"]):
                    if _book_cancelled_ring(kind, row["shape"]):
                        counts["self_intersecting"] += 1
                    else:
                        counts["degenerate"] += 1
                continue
            counts["indexed"] += 1
            group = groups.setdefault((name, layer["layer"]), {"pages": {}, "features": 0})
            group["features"] += 1
            for page in hits:
                group["pages"].setdefault(labels[page], set())
            if cell_index is not None:
                hit_pages = set(hits)
                with_cell = set()
                for i in cell_index.hits(kind, row["shape"]):
                    page, cell_label = cell_index.regions[i]["key"]
                    if page in hit_pages:
                        group["pages"][labels[page]].add(cell_label)
                        with_cell.add(page)
                spiked = spiked or (kind == GEOM_POLYGON and cell_index.spiked)
                fell_back = False
                for page in hits:
                    if page in with_cell or page not in cells_of_page:
                        continue
                    extra = _book_fallback_cells(kind, row["shape"], region_of_page[page],
                                                 _book_shifts(page_index), cells_of_page[page],
                                                 cell_index.regions)
                    if extra:
                        group["pages"][labels[page]].update(extra)
                        fell_back = True
                if fell_back:
                    counts["cell_fallback"] += 1
            if spiked:
                counts["spiked"] += 1

    gazetteer = []
    for (name, layer_label), group in groups.items():
        page_labels = sort_labels(group["pages"])
        refs = []
        for label in page_labels:
            cell_labels = sort_labels(group["pages"][label])
            if cell_labels:
                refs.append("{0}:{1}".format(label, ",".join(cell_labels)))
        gazetteer.append({"name": name, "layer": layer_label,
                          "pages": compress_ranges(page_labels),
                          "page_count": len(page_labels),
                          "grid_refs": "; ".join(refs) if refs else None,
                          "feature_count": group["features"]})
    gazetteer.sort(key=lambda r: (natural_sort_key(r["name"]), natural_sort_key(r["layer"])))
    unplaced.sort(key=lambda r: (natural_sort_key(r["layer"]), r["src_oid"]))
    per_page_rows = sorted(per_page.values(), key=lambda r: tuple(natural_sort_key(v) for v in r))

    if counts["unnamed"]:
        messages.info("{0} feature(s) have no name and are not indexed.".format(counts["unnamed"]))
    if counts["unplaced"]:
        messages.info("{0} named feature(s) are on no page (see the unplaced output).".format(
            counts["unplaced"]))
    if counts["touching"]:
        messages.info("{0} of them only touch a page edge or corner (for example a road exactly on the "
                      "edge between two pages): by the rule, a line or polygon is on a page only if it "
                      "runs through the page's interior, so they are on neither page.".format(
                          counts["touching"]))
    if counts["degenerate"]:
        messages.info("{0} of them have zero length or zero area (a collapsed line or polygon) and "
                      "are on no page. Fix or delete their geometry (Check Geometry / Repair "
                      "Geometry).".format(counts["degenerate"]))
    if counts["self_intersecting"]:
        messages.warning("{0} of them are polygons with a self-intersecting ring whose parts "
                         "cancel out (for example a bow-tie, net area zero although the ring "
                         "encloses an area); they are on no page. Run Check Geometry / Repair "
                         "Geometry on that layer and run the tool again.".format(
                             counts["self_intersecting"]))
    if counts["spiked"]:
        messages.warning("{0} polygon(s) have a ring that runs out and back along itself (a "
                         "zero-width spike or \"antenna\", or edges drawn twice). Such a part "
                         "has no area, so it puts the polygon on no page or grid cell; the "
                         "pages and cells that only the spike reaches are not listed. Run "
                         "Check Geometry / Repair Geometry on that layer.".format(
                             counts["spiked"]))
    if counts["cell_fallback"]:
        messages.info("{0} feature(s) are on a page but run only along grid-cell lines there (for "
                      "example a road exactly on a grid line): they are listed with the cells of "
                      "that page that meet them where they run along the shared edge of two "
                      "cells.".format(counts["cell_fallback"]))
    if counts["null_geometry"]:
        messages.info("{0} named feature(s) have no geometry and are listed as unplaced.".format(
            counts["null_geometry"]))
    counts["names"] = len(gazetteer)
    counts["pages"] = len(regions)
    counts["pages_without_cells"] = pages_without_cells
    counts["pages_part_cells"] = pages_part_cells
    return {"gazetteer": gazetteer, "unplaced": unplaced, "per_page": per_page_rows,
            "counts": counts, "messages": messages}


def gazetteer_tuple(row):
    """Gazetteer row in ``BOOK_GAZETTEER_HEADER`` order."""
    return tuple(row[h.lower()] for h in BOOK_GAZETTEER_HEADER)


def unplaced_tuple(row):
    return (row["layer"], row["src_oid"], row["name"])


# ==========================================================================
# carto/cartoshared_core.py
# ==========================================================================
# Helpers shared by the carto tool adapters (pure Python, no arcpy).
#
# * naming of inputs in outputs, duplicate-output detection;
# * warnings about further layers in another or an unknown coordinate system;
# * ``choose_read_sr`` (the measuring decision itself, with per-feature local
#   Transverse Mercator for wide data, is ``common.projection.choose_measuring``);
# * copying source attributes to a new output (field specs with unique,
#   workspace-valid names and widths from the longest value, rule 8).

# Field.type -> AddField keyword for attributes copied to new outputs.
CARTO_ADDFIELD_KEYWORDS = {
    "SmallInteger": "SHORT", "Integer": "LONG", "BigInteger": "BIGINTEGER", "Single": "FLOAT",
    "Double": "DOUBLE", "String": "TEXT", "Date": "DATE", "DateOnly": "DATEONLY",
    "TimeOnly": "TIMEONLY", "TimestampOffset": "TIMESTAMPOFFSET", "Guid": "GUID"}

# Fields a new output gets on its own (same rule as arcio.unique_field_specs):
# ObjectID and geometry fields, plus "Id" in a folder (shapefile).
CARTO_SYSTEM_FIELDS = ("OBJECTID", "FID", "OID", "SHAPE", "SHAPE_LENGTH", "SHAPE_AREA")


def input_label(text, is_layer, dataset_name):
    """Name of an input as shown in outputs: the layer name (last part of a
    group-layer path), or the dataset name without ``.shp``."""
    if is_layer:
        return split_catalog_path(text)[1] or text
    name = dataset_name
    if name.casefold().endswith(".shp"):
        name = name[:-4]
    return name


def same_dataset_pairs(paths):
    """``[(i, j)]`` (i < j) of the paths that name the same dataset (``same_dataset``)."""
    out = []
    for j in range(len(paths)):
        for i in range(j):
            if paths[i] and paths[j] and same_dataset(paths[i], paths[j]):
                out.append((i, j))
                break
    return out


def first_duplicate(texts):
    """Index of the first non-empty path equal to an earlier one, else ``None``."""
    seen = []
    for i, text in enumerate(texts):
        if not text:
            continue
        if any(same_dataset(text, other) for other in seen):
            return i
        seen.append(text)
    return None


def choose_read_sr(desc, metric_sr_for, collector, what):
    """Coordinate system to read the inputs in: ``(read_sr, wkid, meters_per_unit)``
    (``choose_measuring`` without per-feature measuring)."""
    plan = choose_measuring(desc, metric_sr_for, collector, what)
    return plan["read_sr"], plan["wkid"], plan["mpu"]


def further_layer_sr_warnings(index_sr, others, collector):
    """Warn about further layers that the cursor cannot bring exactly into the
    index layer's coordinate system ``index_sr`` (a known system).

    ``others``: ``[(sr info, label)]``. A layer with an unknown coordinate
    system is read with its coordinates as they are (audit gotcha 3); one on
    another datum is projected without a datum transformation.
    """
    index_sr = index_sr or {}
    target = {"wkid": index_sr.get("wkid"), "gcs_wkid": gcs_wkid_of(index_sr)}
    for sr_info, label in others:
        for text in (further_input_sr_check(label, sr_info, None, index_sr.get("name")),
                     datum_mismatch_warning(label, sr_info, target)):
            if text:
                collector.warning(text)


def copyable_fields(fields):
    """Source fields that can be copied to a new output (no ObjectID, geometry,
    BLOB, raster, GlobalID or other non-editable fields such as Shape_Length)."""
    return [f for f in fields if f.get("type") in CARTO_ADDFIELD_KEYWORDS
            and f.get("editable") is not False]


def _cshared_unique_name(name, used, validate):
    """Workspace-valid name not in ``used`` (casefolded); suffixes ``_1``, ``_2``...
    and shortens the base when the workspace cuts names (shapefiles)."""
    candidate = validate(name)
    if candidate.casefold() not in used:
        return candidate
    for k in range(1, 1000):
        suffix = "_{0}".format(k)
        requested = name + suffix
        candidate = validate(requested)
        if candidate.casefold() not in used:
            return candidate
        if len(candidate) < len(requested):
            # The workspace cut the name (shapefile: 10 characters): shorten the base
            # so the suffix survives.
            candidate = validate(name[:max(len(candidate) - len(suffix), 1)] + suffix)
            if candidate.casefold() not in used:
                return candidate
    raise ValueError("no free field name for {0}".format(name))


def system_field_names(folder):
    """Field names a new output table already has: ObjectID and geometry fields, plus
    ``Id`` and ``Field1`` in a folder (ArcGIS Pro adds ``Id`` to a shapefile and ``Field1``
    to a dBASE table by itself; reported in the Pro runs of this toolkit). A column the
    tool wants to write under one of these names must be renamed first."""
    names = list(CARTO_SYSTEM_FIELDS)
    if folder:
        names += ["Id", "Field1"]
    return names


def count_beyond_bmp(values):
    """How many of the text ``values`` hold a character above U+FFFF (mathematical letters, emoji).

    Pro writes such a character into a dBASE text field as two 3-byte surrogates (CESU-8), which other
    software reads as garbled text (Pro job 274, bytes of the file)."""
    return sum(1 for v in values if v is not None and any(ord(ch) > 0xFFFF for ch in str(v)))


def same_label_groups(labels, twice=()):
    """Layer labels used by more than one layer, ``[(label, count)]`` in input order.

    ``twice``: ``[(i, j)]`` pairs of indexes that read the same dataset (see
    ``same_dataset_pairs``); a label shared only by such pairs is left out, because
    that case has its own warning.
    """
    skip = set()
    for i, j in twice:
        skip.add(i)
        skip.add(j)
    seen, out = {}, []
    for i, label in enumerate(labels):
        seen.setdefault(label, []).append(i)
    for label, members in seen.items():
        if len(members) > 1 and not all(m in skip for m in members):
            out.append((label, len(members)))
    return out


def unique_field_names(names, reserved, validate):
    """Workspace-valid output names for ``names`` that clash neither with
    ``reserved`` (names the tool itself writes) nor with each other; a clash
    gets ``_1``, ``_2`` ... (e.g. a per-page field called PAGE -> PAGE_1)."""
    used = set(validate(r).casefold() for r in reserved)
    out = []
    for name in names:
        actual = _cshared_unique_name(name, used, validate)
        used.add(actual.casefold())
        out.append(actual)
    return out


def attribute_specs(fields, reserved, validate, rows, folder=False, out_domains=None):
    """Field specs (for ``arcio.add_fields``) to copy ``fields`` to an output.

    ``reserved``: output names already taken by the tool (validated).
    System field names of the new output (``CARTO_SYSTEM_FIELDS``, and ``Id``
    when ``folder`` is true, i.e. a shapefile output) are always avoided, so
    an ordinary source field called OBJECTID, Shape_Area or ID becomes
    OBJECTID_1, Shape_Area_1 or ID_1 (alias: the source name).
    ``validate``: ``arcpy.ValidateFieldName`` bound to the output workspace.
    ``rows``: attribute dicts, used for text widths (longest value, at least 1).
    ``out_domains``: the domains of the output workspace (``arcio.read_domains``,
    ``{}`` for a folder). A field-level domain of a copied field is kept
    (``"domain"``) when the output workspace has a domain of that name for the
    same field type, as Copy Features does; otherwise the spec gets
    ``"lost_domain"`` (``common.domains.keep_field_domain``; see
    ``lost_domain_warning``). Subtypes and subtype-level
    domains are not copied.
    Returns ``[{"source", "name", "type", "alias", "values"}]``; ``name`` is
    the final output name (unique, already valid, so ``add_fields`` keeps it).
    """
    used = set(r.casefold() for r in reserved)
    used.update(n.casefold() for n in CARTO_SYSTEM_FIELDS)
    if folder:
        used.add("id")
    specs = []
    for field in fields:
        name = _cshared_unique_name(field["name"], used, validate)
        used.add(name.casefold())
        keyword = CARTO_ADDFIELD_KEYWORDS[field["type"]]
        alias = field.get("alias") or None
        if alias is None and name.casefold() != field["name"].casefold():
            alias = field["name"]
        spec = {"source": field["name"], "name": name, "type": keyword, "alias": alias}
        keep_field_domain(spec, field.get("domain"), out_domains)
        if keyword == "TEXT":
            spec["values"] = [None if r.get(field["name"]) is None
                              else value_to_text(r[field["name"]]) for r in rows]
            spec["length"] = max([1] + [len(v) for v in spec["values"] if v is not None])
        specs.append(spec)
    return specs


def output_domains(read_domains, output):
    """Domains of the workspace (geodatabase, also for a feature dataset path) of
    the output path ``output``: ``read_domains`` is ``arcio.read_domains``. ``{}``
    when they cannot be listed (a folder, or a workspace such as ``memory``
    that has none)."""
    try:
        return read_domains(workspace_of(output)) or {}
    except Exception:
        return {}


def float32_rows(rows, fields):
    """Show FLOAT (single precision) values as typed: in every row dict's
    ``attrs``, values of the FLOAT fields among ``fields`` become the shortest
    decimal with the same 32-bit value (12.300000190734863 -> 12.3). Use it
    before such values are turned into text (page labels, per-page values,
    groups). Returns ``rows`` (changed in place)."""
    names = [f["name"] for f in fields if is_single_field(f)]
    if names:
        for row in rows:
            attrs = row["attrs"]
            for name in names:
                if name in attrs:
                    attrs[name] = float32_shortest(attrs[name])
    return rows


# ==========================================================================
# carto/series_integrity_core.py
# ==========================================================================
# Map Series Index Check: checks of a map series index layer (pure Python).
#
# * page names: null/blank, duplicates (compared as Windows compares file
#   names: case-insensitive, trailing spaces dropped), names that cannot be used
#   as file names;
# * page numbers: duplicates, gaps between the smallest and the largest number,
#   pages without a number;
# * coverage: pages with no data feature, data features on no page (assignment
#   rule of ``carto.pages_core``);
# * adjacency fields (``*_N`` ... ``*_NW``): neighbour missing or ambiguous, and
#   links that are not returned by the neighbour's opposite field;
# * optional page plan (orientation and the standard scale that fits a layout
#   frame) and page ranges per group.

SERIES_ISSUES = ("NULL_NAME", "DUPLICATE_NAME", "ILLEGAL_NAME", "DUPLICATE_NUMBER",
                 "MISSING_NUMBER", "EMPTY_PAGE", "OUTSIDE_ALL_PAGES", "MISSING_NEIGHBOUR",
                 "NON_RECIPROCAL")
SERIES_ISSUE_HEADER = ("PAGE_OID", "PAGE_NAME", "PAGE_NUMBER", "ISSUE", "DETAIL", "LAYER",
                       "SRC_OID")
SERIES_DIRECTIONS = ("N", "NE", "E", "SE", "S", "SW", "W", "NW")
SERIES_OPPOSITE = {"N": "S", "NE": "SW", "E": "W", "SE": "NW", "S": "N", "SW": "NE",
                   "W": "E", "NW": "SE"}
SERIES_DEFAULT_SCALES = "500;1000;1250;1500;2000;2500;5000;10000;25000;50000;100000"
SERIES_ILLEGAL_CHARS = '<>:"/\\|?*'
# Microsoft "Naming Files, Paths, and Namespaces" lists CON, PRN, AUX, NUL, COM1-COM9, LPT1-LPT9
# and the superscript forms COM, LPT followed by U+00B9, U+00B2 or U+00B3; the same names
# followed by an extension are equivalent to the bare name.
SERIES_RESERVED = frozenset(["CON", "PRN", "AUX", "NUL"] +
                            ["COM{0}".format(i) for i in range(1, 10)] +
                            ["LPT{0}".format(i) for i in range(1, 10)] +
                            ["COM" + c for c in u"\u00b9\u00b2\u00b3"] +
                            ["LPT" + c for c in u"\u00b9\u00b2\u00b3"])
# The length of one component of a Windows path is "commonly 255 characters" (Microsoft,
# "Maximum Path Length Limitation"); counted in UTF-16 units, as Windows does.
SERIES_MAX_NAME_LENGTH = 255
# At most this many MISSING_NUMBER gap rows are written (a typo such as 10000
# instead of 100 would otherwise create thousands of rows).
SERIES_MAX_GAP_ROWS = 1000
SERIES_STOP_CHECK_EVERY = 500
_SERIES_INT_RE = re.compile(r"^[+-]?\d+$")
# Plain decimal numbers only: Python float() would also take "1_1" (PEP 515
# digit grouping, = 11), "2E1" (= 20), "inf" and "nan"; such page labels are text.
_SERIES_DECIMAL_RE = re.compile(r"^[+-]?(\d+(\.\d*)?|\.\d+)$")


# --------------------------------------------------------------------------
# Small helpers
# --------------------------------------------------------------------------

def number_key(value):
    """Comparison key of a page number or adjacency value.

    Whole numbers (``3``, ``3.0``, ``"3"``, ``" 03 "``, Arabic-Indic digits)
    give the ``int``; other numbers their ``float``; other text its trimmed,
    case-folded form; null/blank gives ``None``. So a LONG page number and a
    TEXT adjacency field compare correctly.
    """
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, float):
        if value != value:
            return None
        if not math.isfinite(value):
            return value  # infinite: not a whole number (int(inf) would raise)
        return int(value) if value == int(value) else value
    text = fold_digits(str(value)).strip()
    if not text:
        return None
    if _SERIES_INT_RE.match(text):
        return int(text)
    if not _SERIES_DECIMAL_RE.match(text):
        return text.casefold()
    number = float(text)
    if not math.isfinite(number):  # e.g. 400 digits: too large for a float
        return text.casefold()
    return int(number) if number == int(number) else number


def name_key(value):
    """Comparison key of a page name: trimmed and case-folded; ``None`` if blank.
    Used to match adjacency values to page names (lenient on purpose)."""
    text = label_text(value)
    return text.casefold() if text is not None else None


def file_name_key(value):
    """Key under which two page names give the same Windows file name; ``None`` if blank.

    Closer to how Windows (NTFS) compares file names than ``name_key``: only trailing
    ASCII spaces are dropped (Windows removes them at the end of a name; a leading
    space, a no-break space or any other white space is kept), and letters are
    compared by their one-to-one upper case (NTFS compares names through a table that
    maps each character to one upper-case character), so ``"a"`` and ``"A"`` collide
    but ``"\u00df"``/``"SS"`` and ``"\ufb01"``/``"FI"`` (letters whose upper case is several
    letters) do not.
    """
    if label_text(value) is None:
        return None
    text = value if isinstance(value, str) else label_text(value)
    text = text.rstrip(" ")
    out = []
    for ch in text:
        up = ch.upper()
        out.append(up if len(up) == 1 else ch)
    return "".join(out)


def illegal_name_reasons(name):
    """Reasons why ``name`` cannot be used as a Windows file name (``[]`` if fine)."""
    if name is None:
        return []
    text = str(name)
    reasons = []
    bad = sorted(set(ch for ch in text if ch in SERIES_ILLEGAL_CHARS),
                 key=SERIES_ILLEGAL_CHARS.index)
    if bad:
        reasons.append("contains {0}".format(" ".join(bad)))
    # Microsoft "Naming Files, Paths, and Namespaces": "characters whose integer
    # representations are in the range from 1 through 31" (and NUL); DEL (127) is not listed.
    if any(ord(ch) < 32 for ch in text):
        reasons.append("contains control characters")
    if text.endswith(".") or text.endswith(" "):
        reasons.append("ends with a dot or a space")
    # Only ASCII spaces around the stem are ignored: Windows drops trailing ones ("CON .pdf"
    # is CON); a leading one is also ignored here, the cautious side (NOT VERIFIED on
    # Windows). A no-break space or an ideographic space is a real character that Windows
    # keeps, so "CON\u00a0" is a legal name, not the device CON.
    stem = text.split(".", 1)[0].strip(" ").upper()
    if stem in SERIES_RESERVED:
        reasons.append("{0} is a reserved device name".format(stem))
    # "surrogatepass": a lone surrogate (half of an emoji, e.g. from a cut dBASE value)
    # still counts as one UTF-16 unit instead of raising UnicodeEncodeError.
    length = len(text.encode("utf-16-le", "surrogatepass")) // 2
    if length > SERIES_MAX_NAME_LENGTH:
        reasons.append("has {0} characters (a file name is usually limited to {1})".format(
            length, SERIES_MAX_NAME_LENGTH))
    return reasons


def page_label(page, use_number):
    """Label of a page in messages and ranges (number if used, else name)."""
    label = label_text(page.get("number")) if use_number else None
    if label is None:
        label = label_text(page.get("name"))
    return label if label is not None else "OID {0}".format(page["oid"])


def _series_issue(page, issue, detail, layer=None, src_oid=None):
    number = number_key(page.get("number")) if page else None
    return {"page_oid": page["oid"] if page else None,
            "page_name": label_text(page.get("name")) if page else None,
            "page_number": number if isinstance(number, int) else None,
            "issue": issue, "detail": detail, "layer": layer, "src_oid": src_oid}


def issue_tuple(issue):
    """Issue row in ``SERIES_ISSUE_HEADER`` order."""
    return tuple(issue[h.lower()] for h in SERIES_ISSUE_HEADER)


SERIES_MAX_SCALE = 2 ** 31 - 1   # the SCALE field of the page plan is a LONG (32-bit) integer
_SCALE_HINT = ("Separate the scales with semicolons and write each number without a "
               "thousands separator, e.g. 1250;2500;5000.")


def _scale_digits(item):
    return item[2:] if item.startswith("1:") else item


def parse_scales(text):
    """Standard scales from text such as ``"500;1000;1250"`` (also ``,`` or spaces).

    Returns a sorted list of distinct positive whole numbers (``int``); raises
    ``ToolError`` for anything else. A number written with a thousands separator
    (``1,250``, ``1 500``, ``1.250``) is refused instead of being read as two
    scales or as 1.25: inside one ``;`` item, a group of 1-3 digits followed
    by ``,`` or a space and exactly 3 digits is refused, and so is
    ``1.250``. A scale that is not a whole number (``1250.5``, ``0.5``) is
    refused: SCALE is a LONG field, so a fraction would be written rounded and
    could fall below SCALE_NEEDED (``1250.0`` is the whole number 1250). Only
    plain decimal digits are read (no ``1e3``, ``1_000``, ``inf``). Scales must
    be below 2^31 (the SCALE field is a LONG).
    """
    text = str(text or "").strip()
    items = []
    for chunk in text.split(";"):
        chunk = chunk.strip()
        if not chunk:
            continue
        if re.match(r"^(1:)?\d{1,3}([.,\s]\d{3})+$", chunk, re.UNICODE):
            raise ToolError("'{0}' looks like one number written with a thousands separator, "
                            "not a list of scales.".format(chunk), _SCALE_HINT)
        tokens = [t for t in re.split(r"[,\s]+", chunk, flags=re.UNICODE) if t]
        for a, b in zip(tokens, tokens[1:]):
            if re.match(r"^\d{1,3}$", _scale_digits(a)) and re.match(r"^\d{3}$", b):
                raise ToolError("'{0}' is ambiguous: it may be one number with a thousands "
                                "separator ({1}{2}) or two scales.".format(
                                    chunk, _scale_digits(a), b), _SCALE_HINT)
        items.extend(tokens)
    if not items:
        raise ToolError("No standard scales were given.",
                        "List scale denominators separated by semicolons, e.g. 1000;2500;5000.")
    scales = set()
    for item in items:
        digits = fold_digits(_scale_digits(item))
        if re.match(r"^\d{1,3}(\.\d{3})+$", digits):
            raise ToolError("'{0}' looks like a number with a dot as thousands separator."
                            .format(item), _SCALE_HINT)
        whole = re.match(r"^(\d+)(\.0*)?$", digits)
        if not whole:
            if re.match(r"^(\d+\.\d*|\.\d+)$", digits):
                raise ToolError("Scale '{0}' is not a whole number: the SCALE field of the page "
                                "plan is a whole number (LONG), so a fraction would be written "
                                "rounded.".format(item),
                                "List whole scale denominators, e.g. 1250;2500.")
            raise ToolError("'{0}' is not a scale.".format(item),
                            "List scale denominators separated by semicolons, e.g. 1000;2500.")
        value = int(whole.group(1))
        if value <= 0:
            raise ToolError("Scale '{0}' must be a positive number.".format(item),
                            "List positive scale denominators, e.g. 1000;2500.")
        if value > SERIES_MAX_SCALE:
            raise ToolError("Scale '{0}' is too large: the SCALE field of the page plan holds "
                            "at most {1}.".format(item, SERIES_MAX_SCALE),
                            "List scale denominators below 2147483648.")
        scales.add(value)
    return sorted(scales)


def scales_text(scales):
    """``[500, 1250]`` -> ``"1:500, 1:1250"`` (for the message that lists the scales used)."""
    return ", ".join("1:{0}".format(s if isinstance(s, int) else repr(float(s))) for s in scales)


def detect_adjacency_fields(field_names, exclude=()):
    """Guess adjacency fields named ``<prefix>_N`` ... ``<prefix>_NW``.

    Returns ``(mapping {direction: field name}, prefix or None, ambiguous)``.
    A prefix counts only if its directions include at least one opposite
    pair (N/S, E/W, NE/SW or NW/SE), as adjacency fields always do; a lone
    ``X_E`` or a pair such as ``UTM_E``/``UTM_N`` is not adjacency. The
    caller passes only text and integer fields (coordinates are not
    neighbours). The prefix with the most directions wins; ties go to the
    first prefix in natural order and set ``ambiguous``. Fields in
    ``exclude`` are ignored.
    """
    skip = set(n.casefold() for n in exclude if n)
    by_prefix = {}
    for name in field_names:
        if name.casefold() in skip or "_" not in name:
            continue
        prefix, suffix = name.rsplit("_", 1)
        direction = suffix.upper()
        if prefix and direction in SERIES_DIRECTIONS:
            by_prefix.setdefault(prefix.casefold(), {}).setdefault(direction, name)
    by_prefix = dict((p, v) for p, v in by_prefix.items()
                     if any(SERIES_OPPOSITE[d] in v for d in v))
    if not by_prefix:
        return {}, None, False
    best = max(len(v) for v in by_prefix.values())
    prefixes = sorted((p for p, v in by_prefix.items() if len(v) == best), key=natural_sort_key)
    mapping = by_prefix[prefixes[0]]
    return dict(mapping), prefixes[0], len(prefixes) > 1


# --------------------------------------------------------------------------
# Checks
# --------------------------------------------------------------------------

SERIES_PREFIX_SAFE_REASONS = ("is a reserved device name", "ends with a dot or a space")


def _series_prefix_safe(reasons):
    """True if every reason holds only when the page name is the whole file name (a reserved
    device name, a trailing dot or space): with a file name prefix before the page name and an
    extension after it, such a name may be a legal file name."""
    return bool(reasons) and all(any(r.endswith(k) for k in SERIES_PREFIX_SAFE_REASONS)
                                 for r in reasons)


def _series_name_issues(pages, issues, messages=None):
    groups = {}
    prefix_safe = 0
    for page in pages:
        key = file_name_key(page.get("name"))
        if key is None:
            issues.append(_series_issue(page, "NULL_NAME", "The page has no name."))
            continue
        groups.setdefault(key, []).append(page)
        reasons = illegal_name_reasons(page.get("name"))
        if reasons:
            prefix_safe += _series_prefix_safe(reasons)
            issues.append(_series_issue(page, "ILLEGAL_NAME",
                                        "The name cannot be used as a file name: {0}.".format(
                                            "; ".join(reasons))))
    for group in groups.values():
        if len(group) > 1:
            for page in group:
                issues.append(_series_issue(
                    page, "DUPLICATE_NAME", "Name '{0}' is also used by page OID(s) {1}.".format(
                        label_text(page["name"]), _series_others_text(group, page))))
    if prefix_safe and messages is not None:
        messages.info("{0} page name(s) are ILLEGAL_NAME only because the name is a reserved device "
                      "name or ends with a dot or a space. Each page name is judged as a whole file "
                      "name: an export that writes the page name after a file name prefix (as an "
                      "export to multiple files named by page name does) may accept such a name."
                      .format(prefix_safe))


def _series_others_text(group, page, limit=20):
    """``oid_list_text`` of the OIDs of ``group`` other than ``page``, in constant
    time per page (only the first ``limit + 1`` pages of the group are looked at):
    a group of k duplicates costs k, not k x k."""
    head = [p["oid"] for p in group[:limit + 1] if p is not page][:limit]
    text = ", ".join(str(o) for o in head)
    more = len(group) - 1 - limit
    if more > 0:
        text += " and {0} more".format(more)
    return text


def _series_number_issues(pages, issues, messages, gap_pages=None, check_gaps=True):
    groups = {}
    for page in pages:
        key = number_key(page.get("number"))
        if key is None:
            issues.append(_series_issue(page, "MISSING_NUMBER", "The page has no page number."))
            continue
        groups.setdefault(key, []).append(page)
    for key, group in groups.items():
        if len(group) > 1:
            for page in group:
                issues.append(_series_issue(
                    page, "DUPLICATE_NUMBER", "Number {0} is also used by page OID(s) {1}.".format(
                        label_text(page["number"]), _series_others_text(group, page))))
    if not check_gaps:  # a series that skips numbers on purpose
        return
    if gap_pages is not None:  # gaps are judged against the whole index
        keys = set(number_key(p.get("number")) for p in gap_pages)
        keys.discard(None)
    else:
        keys = set(groups)
    numbers = sorted(k for k in keys if isinstance(k, int))
    not_whole = [k for k in keys if not isinstance(k, int)]
    if not_whole:
        messages.info("{0} page number(s) are not whole numbers and are not checked for gaps."
                      .format(len(not_whole)))
    if len(numbers) < 2:
        return
    total = (numbers[-1] - numbers[0] + 1) - len(numbers)
    missing = _series_first_gaps(numbers, SERIES_MAX_GAP_ROWS)
    if total > SERIES_MAX_GAP_ROWS:
        messages.warning("{0} page numbers are missing between {1} and {2}; only the first {3} "
                         "are listed. Check the page numbers for a typing error.".format(
                             total, numbers[0], numbers[-1], SERIES_MAX_GAP_ROWS))
    for n in missing:
        issue = _series_issue(None, "MISSING_NUMBER",
                              "No page has number {0} (numbers run from {1} to {2}).".format(
                                  n, numbers[0], numbers[-1]))
        issue["page_number"] = n
        issues.append(issue)


def _series_first_gaps(numbers, limit):
    """First ``limit`` missing integers between sorted distinct ``numbers``."""
    out = []
    for a, b in zip(numbers, numbers[1:]):
        n = a + 1
        while n < b and len(out) < limit:
            out.append(n)
            n += 1
        if len(out) >= limit:
            break
    return out


SERIES_NO_GEOMETRY_DETAIL = "The page has no geometry."
SERIES_NO_AREA_DETAIL = ("The page has no area (a collapsed polygon), so no data feature can be "
                         "on it.")


def page_has_geometry(shape):
    """True if a page shape holds at least one ring of three or more vertices. A page without
    (``None``, no rings, or only rings of fewer than 3 vertices) is EMPTY_PAGE "The page has
    no geometry." whether or not Data Layers are given (R11-1), and is not planned."""
    return bool(shape) and any(len(ring) >= 3 for ring in shape)


def _series_geometry_issues(pages, issues):
    """EMPTY_PAGE "The page has no geometry." for every page without geometry (R11-1: written
    only by the coverage check before, so without Data Layers such a page was reported nowhere)."""
    for page in pages:
        if not page_has_geometry(page.get("shape")):
            issues.append(_series_issue(page, "EMPTY_PAGE", SERIES_NO_GEOMETRY_DETAIL))


SERIES_MAYBE_LEFT_OUT_DETAIL = ("The feature is on none of the checked pages, but it lies within "
                                "the outline of page(s) OID {0}, which are not convex and were "
                                "left out of the coverage check: it may be on them.")


def _series_left_out_index(pages, oids, wrap, floor):
    """``RegionIndex`` of the convex hulls of the pages ``oids`` (pages outside the selection
    that are not convex and are left out of the coverage check), keyed by page ObjectID;
    ``None`` when no hull has an area. A feature in such a hull may be on that page (R13-1)."""
    regions = []
    for page in pages:
        if page["oid"] not in oids:
            continue
        pts = [(p[0], p[1]) for ring in (page.get("shape") or []) for p in ring]
        hull = convex_hull_points(pts)
        if len(hull) < 3:
            continue
        region, state = make_region(page["oid"], [hull + [hull[0]]], floor)
        if state == REGION_OK:
            regions.append(region)
    return RegionIndex(regions, wrap) if regions else None


def _series_coverage_issues(pages, data_layers, issues, messages, checked=None, wrap=None,
                            floor=0.0, should_stop=None):
    regions, nulls, bad = prepare_pages(pages, floor)
    left_out = None
    if checked is not None:
        ignored = [o for o in bad if o not in checked]
        bad = [o for o in bad if o in checked]
        if ignored:
            messages.info("{0} page(s) outside the checked pages are not convex polygons and "
                          "are left out of the coverage check (ObjectIDs {1}).".format(
                              len(ignored), oid_list_text(ignored)))
            left_out = _series_left_out_index(pages, set(ignored), wrap, floor)
    if bad:
        bad_set = set(bad)
        cause, fix = not_convex_error("page(s)", [(p["oid"], p.get("shape")) for p in pages
                                                  if p["oid"] in bad_set],
                                      "Or clear Data Layers to check names, numbers and "
                                      "adjacency only.")
        raise ToolError(cause + " So data coverage cannot be checked.", fix)
    index = RegionIndex(regions, wrap)
    used = set()
    no_geometry = 0
    touching = 0
    maybe_out = 0
    seen = 0
    for layer in data_layers:
        for row in layer["rows"]:
            seen += 1
            if should_stop is not None and seen % SERIES_STOP_CHECK_EVERY == 0:
                should_stop()
            if row["shape"] is None:
                no_geometry += 1
                continue
            hits = index.hits(layer["kind"], row["shape"])
            maybe = left_out.hits(layer["kind"], row["shape"]) if (left_out and not hits) \
                else []
            if maybe:
                # R13-1: the feature lies within the outline (convex hull) of a page that was
                # left out of the coverage check, so it may be on that page: say so instead of
                # "The feature is on no page."
                maybe_out += 1
                detail = SERIES_MAYBE_LEFT_OUT_DETAIL.format(oid_list_text(
                    sorted(left_out.regions[i]["key"] for i in maybe)))
                issues.append(_series_issue(None, "OUTSIDE_ALL_PAGES", detail, layer["layer"],
                                            row["oid"]))
            elif not hits:
                detail = "The feature is on no page."
                if index.touches(layer["kind"], row["shape"]):
                    touching += 1
                    detail = ("The feature is on no page: it only touches a page edge or corner, "
                              "and a line or polygon counts for a page only if it runs through "
                              "the page.")
                issues.append(_series_issue(None, "OUTSIDE_ALL_PAGES", detail, layer["layer"],
                                            row["oid"]))
            for i in hits:
                used.add(regions[i]["key"])
    if no_geometry:
        messages.info("{0} data feature(s) have no geometry and were not checked.".format(
            no_geometry))
    if maybe_out:
        messages.warning("{0} data feature(s) are on none of the checked pages but lie within "
                         "the outline of a page left out of the coverage check (not convex), so "
                         "they may be on that page. Their OUTSIDE_ALL_PAGES rows name the page; "
                         "check them, or make those pages convex.".format(maybe_out))
    if touching:
        messages.info("{0} data feature(s) only touch a page edge or corner (for example a road "
                      "exactly on the edge between two pages). By the rule they are on no page, "
                      "so they are OUTSIDE_ALL_PAGES and do not count for a page that would "
                      "otherwise be empty.".format(touching))
    null_set = set(nulls)
    for i, page in enumerate(pages):
        if page["oid"] in null_set:
            # A page without geometry already has its row (_series_geometry_issues); a page
            # whose polygon has no area holds no data feature (it is no region of the index).
            if page_has_geometry(page.get("shape")):
                issues.append(_series_issue(page, "EMPTY_PAGE", SERIES_NO_AREA_DETAIL))
        elif i not in used:
            issues.append(_series_issue(page, "EMPTY_PAGE", "No data feature is on this page."))


def adjacency_reference(pages, adjacency, use_number, refers=None, key_field=None):
    """What the adjacency values refer to: ``("number" | "name" | "field", reason)``.

    ``refers == "field"`` (R14-1): every adjacency field is named after an index field
    ``key_field`` that is neither the page name nor the page number field (Calculate
    Adjacent Fields run on that field), so the values are that field's values, with or
    without a page number field. Otherwise, without a page number field they are page
    names (``reason`` names the page name field when the adjacency fields are named after
    it, else ``None``). With one, ``refers``
    (``"name"`` or ``"number"``, decided by the caller from the field names,
    e.g. ``PageName_N`` made by Calculate Adjacent Fields on the page name
    field) wins; otherwise the key that matches more of the non-null values
    is used, numbers on a tie. Decided once, before any value is checked.
    """
    if refers == "field" and key_field:
        return "field", "the adjacency fields are named after the field {0}".format(key_field)
    if not use_number:
        if refers == "name":
            return "name", "the adjacency fields are named after the page name field"
        return "name", None
    if refers in ("name", "number"):
        return refers, "the adjacency fields are named after the page {0} field".format(refers)
    numbers = set(k for k in (number_key(p.get("number")) for p in pages) if k is not None)
    names = set(k for k in (name_key(p.get("name")) for p in pages) if k is not None)
    total = by_number = by_name = 0
    for page in pages:
        for direction in adjacency:
            value = page["adjacent"].get(direction)
            if number_key(value) is None:
                continue
            total += 1
            by_number += number_key(value) in numbers
            by_name += name_key(value) in names
    choice = "name" if by_name > by_number else "number"
    return choice, ("{0} of {1} adjacency value(s) match a page name and {2} a page "
                    "number".format(by_name, total, by_number))


def unique_data_layers(layers):
    """The Data Layers entries with every data feature kept once.

    ``layers``: ``[{"layer", "kind", "rows", "dataset"}]``; ``dataset`` is the identity
    of the dataset the entry reads (``common.paths.dataset_identity``; ``None`` or
    ``""`` when unknown). Two entries can read the same dataset: the same layer
    listed twice, a layer and its data source, or two layers with overlapping
    definition queries or selections. A feature (dataset, ObjectID) read by more
    than one entry is kept only in the first entry that lists it, so it is checked,
    reported (OUTSIDE_ALL_PAGES) and counted once. The rows are not copied.

    Returns ``(layers, repeats)``: the entries in their order with their kept rows
    (``"rows"`` a list; other keys unchanged), and ``[(label, first label, dataset,
    number of rows left out)]`` for each entry that lost rows, in entry order.
    """
    seen = {}
    first = {}
    out, repeats = [], []
    for layer in layers:
        key = layer.get("dataset") or None
        if key is None:
            out.append(dict(layer, rows=list(layer["rows"])))
            continue
        oids = seen.setdefault(key, set())
        first.setdefault(key, layer["layer"])
        kept, dropped = [], 0
        for row in layer["rows"]:
            if row["oid"] in oids:
                dropped += 1
                continue
            oids.add(row["oid"])
            kept.append(row)
        out.append(dict(layer, rows=kept))
        if dropped:
            repeats.append((layer["layer"], first[key], key, dropped))
    return out, repeats


# A numeric neighbour field cannot be empty in a dBASE table (an empty number is stored
# as 0), and a tool that fills a numeric field may write 0 for "no neighbour": a value 0
# that matches no page is read as no neighbour, not as a page that is missing.
SERIES_NO_NEIGHBOUR_NUMBER = 0


def _series_adjacency_issues(pages, adjacency, use_number, issues, messages, refers=None,
                             key_field=None):
    refers, reason = adjacency_reference(pages, adjacency, use_number, refers, key_field)
    by_number = refers == "number"
    by_field = refers == "field"
    if by_field:
        # R14-1: the values of the index field the adjacency fields are named after
        key_of = lambda p: number_key(p.get("adjacency_key"))
        ref_key = number_key
        what = "{0} value".format(key_field)
        text = "Adjacency values are compared with the values of the field {0} ({1})".format(
            key_field, reason)
        if not use_number:
            text += ("; set {0} as Page Number Field to also check the page numbers".format(
                key_field))
        messages.info(text + ".")
    else:
        key_of = (lambda p: number_key(p.get("number"))) if by_number else \
            (lambda p: name_key(p.get("name")))
        ref_key = number_key if by_number else name_key
        what = "page number" if by_number else "page name"
        # R14-1: always say what the values are compared with (also without a page number
        # field, where a numeric neighbour field compared with text names gives a row per link)
        messages.info("Adjacency values are compared with the {0}s ({1}).".format(
            what, reason or "no Page Number Field is set"))
    by_key = {}
    for page in pages:
        key = key_of(page)
        if key is not None:
            by_key.setdefault(key, []).append(page)
    numeric_names = None  # page names that read as numbers, for the hint below
    if not by_number and not by_field:
        numeric_names = {}
        for page in pages:
            folded = number_key(page.get("name"))
            if isinstance(folded, (int, float)) and not isinstance(folded, bool):
                numeric_names.setdefault(folded, page)
    unchecked = set()
    zeros = 0
    for page in pages:
        own = key_of(page)
        for direction in SERIES_DIRECTIONS:
            if direction not in adjacency:
                continue
            value = page["adjacent"].get(direction)
            ref = ref_key(value)
            if ref is None:
                continue
            shown = label_text(value)
            targets = by_key.get(ref, [])
            if not targets and _series_is_zero(value) and \
                    not (numeric_names and SERIES_NO_NEIGHBOUR_NUMBER in numeric_names):
                zeros += 1  # 0 = no neighbour (see SERIES_NO_NEIGHBOUR_NUMBER)
                continue
            if not targets:
                detail = "{0} = {1}: no page has this {2}.".format(direction, shown, what)
                hint = _series_number_hint(value, numeric_names)
                if hint:
                    detail += hint
                issues.append(_series_issue(page, "MISSING_NEIGHBOUR", detail))
                continue
            if len(targets) > 1:
                issues.append(_series_issue(
                    page, "MISSING_NEIGHBOUR",
                    "{0} = {1}: ambiguous, {2} pages have this {3} (OIDs {4}).".format(
                        direction, shown, len(targets), what,
                        oid_list_text(t["oid"] for t in targets))))
                continue
            target = targets[0]
            if target is page:
                issues.append(_series_issue(page, "NON_RECIPROCAL",
                                            "{0} = {1} refers to the page itself.".format(
                                                direction, shown)))
                continue
            opposite = SERIES_OPPOSITE[direction]
            if opposite not in adjacency:
                unchecked.add(opposite)
                continue
            back = target["adjacent"].get(opposite)
            if own is None:
                # R10-1: this page has no key (number or name), so no value can point back to
                # it; saying "page 2 has W = 1" would blame a neighbour that may be right.
                issues.append(_series_issue(
                    page, "NON_RECIPROCAL", "{0} = {1}, but this page has no {2}, so page {3} "
                    "cannot point back to it.".format(direction, shown, what,
                                                      _series_target_text(shown, target))))
            elif ref_key(back) != own:
                issues.append(_series_issue(
                    page, "NON_RECIPROCAL", "{0} = {1}, but page {2} has {3} = {4}.".format(
                        direction, shown, _series_target_text(shown, target), opposite,
                        label_text(back) if label_text(back) is not None else "null")))
    if unchecked:
        messages.info("Links could not be checked in both directions because there is no "
                      "adjacency field for: {0}.".format(
                          ", ".join(d for d in SERIES_DIRECTIONS if d in unchecked)))
    if zeros:
        messages.info("{0} adjacency value(s) are 0 and no page has the {1} 0: they are read "
                      "as 'no neighbour' (a numeric field cannot be empty in a dBASE table, "
                      "and 0 is a common marker for an edge page), not as MISSING_NEIGHBOUR."
                      .format(zeros, what))


def _series_target_text(shown, target):
    """How a DETAIL names the neighbour page: the value as written, plus ``(OID n)`` when the
    value is not the page's ObjectID ("page 4 (OID 3)": page number 4 is ObjectID 3), so a
    reader does not take the value for an ObjectID."""
    if shown == str(target["oid"]):
        return shown
    return "{0} (OID {1})".format(shown, target["oid"])


def _series_is_zero(value):
    """True if a neighbour value is the number 0 (``0``, ``0.0``, ``"0"``, ``" 00 "``,
    Arabic-Indic zero); text such as ``"O"`` or ``"0a"`` is not."""
    key = number_key(value)
    return isinstance(key, (int, float)) and not isinstance(key, bool) and \
        key == SERIES_NO_NEIGHBOUR_NUMBER


def _series_number_hint(value, numeric_names):
    """Hint for a neighbour value that matches no page name as text but the same
    number as a page name (``2`` against ``"02"``): leading zeros or a numeric
    adjacency field next to a text name field. ``""`` when there is none."""
    if not numeric_names:
        return ""
    folded = number_key(value)
    if not isinstance(folded, (int, float)) or isinstance(folded, bool):
        return ""
    page = numeric_names.get(folded)
    if page is None:
        return ""
    return (" Page OID {0} is named '{1}', the same number written differently: check "
            "leading zeros, or a number field holding the neighbours of a text name "
            "field.".format(page["oid"], label_text(page.get("name"))))


def check_series(pages, use_number=False, data_layers=None, adjacency=None, all_pages=None,
                 wrap=None, adjacency_refers=None, page_floor=0.0, should_stop=None,
                 check_gaps=True, adjacency_key_field=None):
    """Run every check.

    ``pages``: ``[{"oid", "name", "number", "shape", "adjacent": {dir: value}}]``.
    ``use_number``: a page number field is used (numbers are checked, and
    adjacency values may refer to page numbers; otherwise they refer to
    names). ``adjacency_refers``: ``"name"``, ``"number"``, ``"field"`` or ``None``
    (decided from the values, see ``adjacency_reference``). ``"field"`` with
    ``adjacency_key_field`` (the name of the index field the adjacency fields are named
    after): the values are compared with each page's ``"adjacency_key"`` (that field's value),
    with or without ``use_number``; ``"name"``/``"number"`` decide only with ``use_number``.
    ``data_layers``: ``[{"layer", "kind", "rows": [{"oid", "shape"}]}]`` or
    ``None`` (no coverage check). ``adjacency``: the directions configured.
    ``all_pages``: the whole index when ``pages`` is only a selection of it.
    Number gaps, neighbours and data coverage are then judged against the
    whole index (a neighbour that is not selected is not "missing"); names,
    duplicates and empty pages are judged among the checked ``pages``, and
    page rows are written only for them.
    ``wrap``: the x period of the index system (``projection.x_period``: 360 for a
    geographic index, the equator length for Web Mercator), or ``None``.
    ``page_floor``: absolute convexity tolerance of the pages in coordinate units
    (``pages_core.convex_floor``).
    ``should_stop``: optional callable, called about every ``SERIES_STOP_CHECK_EVERY`` data
    features; it raises (the tool passes a cancel check) to end the run.
    ``check_gaps``: ``False`` leaves out the MISSING_NUMBER rows for numbers that no page
    has (a series that skips numbers on purpose); pages without a number and duplicate
    numbers are still reported.

    Returns ``(issues, counts, messages)``; issues are sorted by issue type
    (order of ``SERIES_ISSUES``), then page OID, layer and source OID.
    """
    messages = MessageCollector()
    issues = []
    checked = None
    universe = pages
    if all_pages is not None:
        checked = set(p["oid"] for p in pages)
        universe = list(pages) + [p for p in all_pages if p["oid"] not in checked]
    _series_name_issues(pages, issues, messages)
    _series_geometry_issues(pages, issues)
    if use_number:
        _series_number_issues(pages, issues, messages,
                              universe if checked is not None else None, check_gaps)
    if data_layers:
        _series_coverage_issues(universe, data_layers, issues, messages, checked, wrap,
                                page_floor, should_stop)
    if adjacency:
        _series_adjacency_issues(universe, set(adjacency), use_number, issues, messages,
                                 adjacency_refers, adjacency_key_field)
    if checked is not None:
        issues = [i for i in issues if i["page_oid"] is None or i["page_oid"] in checked]
    order = dict((name, i) for i, name in enumerate(SERIES_ISSUES))
    issues.sort(key=lambda r: (order[r["issue"]], r["page_oid"] is not None,
                               r["page_oid"] or 0, natural_sort_key(r["layer"]),
                               r["src_oid"] or 0, r["page_number"] or 0))
    counts = dict((name, 0) for name in SERIES_ISSUES)
    for issue in issues:
        counts[issue["issue"]] += 1
    return issues, counts, messages


# --------------------------------------------------------------------------
# Page plan and page ranges
# --------------------------------------------------------------------------

def same_coordinate_system(a, b):
    """True if two ``arcio.sr_info`` dicts (or ``None``) name the same system: the
    same WKID when both have one, else the same type and name."""
    a, b = a or {}, b or {}
    if a.get("wkid") and b.get("wkid"):
        return a["wkid"] == b["wkid"]
    return (a.get("type"), a.get("name")) == (b.get("type"), b.get("name"))


# The smallest rectangle is used only when it is smaller than the axis-aligned
# extent by more than this fraction (noise in the vertices of a north-up page).
SERIES_ROTATION_REL_TOL = 1e-6


def page_rectangle(rings):
    """Smallest-area rectangle around a page: ``(width, height, rotation)`` or ``None``.

    ``rings``: the page polygon in a metric system (any number of parts). The
    rectangle has one side on an edge of the convex hull of the vertices
    (rotating calipers; a rectangle page gives its own sides). ``rotation`` is the
    angle in degrees, counterclockwise from the system's x axis (grid east), of
    the side measured as ``width``, normalised to (-45, 45]; ``height`` is
    measured at right angles to it. A page whose axis-aligned extent is as small
    (within ``SERIES_ROTATION_REL_TOL``) gets rotation 0 and its extent.
    """
    pts = [p for ring in (rings or []) for p in ring]
    if not pts:
        return None
    xs, ys = [p[0] for p in pts], [p[1] for p in pts]
    width0, height0 = max(xs) - min(xs), max(ys) - min(ys)
    hull = convex_hull_points(pts)
    best = None
    for i in range(len(hull)):
        a, b = hull[i], hull[(i + 1) % len(hull)]
        length = math.hypot(b[0] - a[0], b[1] - a[1])
        if length == 0.0:
            continue
        ux, uy = (b[0] - a[0]) / length, (b[1] - a[1]) / length
        along = [(q[0] - a[0]) * ux + (q[1] - a[1]) * uy for q in hull]
        across = [(q[1] - a[1]) * ux - (q[0] - a[0]) * uy for q in hull]
        w, h = max(along) - min(along), max(across) - min(across)
        if best is None or w * h < best[0]:
            best = (w * h, w, h, math.degrees(math.atan2(uy, ux)))
    if best is None or width0 * height0 <= best[0] * (1.0 + SERIES_ROTATION_REL_TOL):
        return width0, height0, 0.0
    _area, w, h, angle = best
    turns = int(math.floor((angle + 45.0) / 90.0))
    angle -= 90.0 * turns
    if turns % 2:
        w, h = h, w
    if angle <= -45.0:
        angle += 90.0
        w, h = h, w
    return w, h, angle


def plan_rectangle(measured, own=None):
    """``(width, height, rotation)`` of a page for the page plan, or ``None``.

    ``measured``: the page in the metric measuring system; ``own``: the same page
    in the index layer's own system (``None`` when they are the same). A page that
    is axis-aligned in its own system (a north-up sheet of a geographic index, a
    north-up Web Mercator page) gets rotation 0 and is measured along its own
    grid east in the measuring system (``_series_grid_east``), so meridian
    convergence of the measuring projection neither turns nor inflates it; any
    other page gets ``page_rectangle`` in the measuring system.
    """
    if own is not None:
        native = page_rectangle(own)
        if native is not None and native[2] == 0.0:
            pts = [p for ring in (measured or []) for p in ring]
            if not pts:
                return None
            angle = _series_grid_east(measured, own)
            c, s = math.cos(angle), math.sin(angle)
            us = [p[0] * c + p[1] * s for p in pts]
            vs = [p[1] * c - p[0] * s for p in pts]
            return max(us) - min(us), max(vs) - min(vs), 0.0
    return page_rectangle(measured)


def _series_grid_east(measured, own):
    """Angle (radians, counterclockwise from the measuring system's x axis) of the
    own system's grid east at the page, or 0.0 when it cannot be told.

    The page was projected vertex by vertex, so each edge of ``own`` that is
    horizontal (an east-west edge of a north-up page) has a counterpart in
    ``measured``; their summed direction is the local grid convergence between
    the two systems. Measuring the page along it, not along the measuring
    system's axes, keeps a north-up page far from the central meridian of the
    measuring zone from being inflated by that convergence (re-review P1: a Web
    Mercator page 5.8 degrees from the central meridian at 60N was 8.5 % too
    large). With different vertex counts (no vertex-by-vertex correspondence)
    the axes are used.
    """
    vx = vy = 0.0
    if len(measured or []) != len(own or []):
        return 0.0
    for m_ring, o_ring in zip(measured, own):
        if len(m_ring) != len(o_ring):
            return 0.0
        for i in range(len(o_ring) - 1):
            dx = o_ring[i + 1][0] - o_ring[i][0]
            dy = o_ring[i + 1][1] - o_ring[i][1]
            if dx == 0.0 or abs(dy) > 1e-9 * abs(dx):
                continue
            sign = 1.0 if dx > 0 else -1.0
            vx += sign * (m_ring[i + 1][0] - m_ring[i][0])
            vy += sign * (m_ring[i + 1][1] - m_ring[i][1])
    if vx == 0.0 and vy == 0.0:
        return 0.0
    angle = math.atan2(vy, vx)
    return angle if abs(angle) < math.pi / 4 else 0.0


def plan_page(width_m, height_m, frame_w, frame_h, margin_pct, scales):
    """Orientation and scale for one page extent (metres on the ground).

    The frame (metres on paper) is used landscape (long side horizontal) and
    portrait; the usable frame is the frame less ``margin_pct`` percent. The
    scale needed for an orientation is the larger of extent / usable size in
    each direction; the orientation needing the smaller scale wins
    (LANDSCAPE on ties). Returns ``(orient, needed, scale)``; ``scale`` is the
    smallest standard scale >= needed (``None`` if none is large enough); a
    ``needed`` within 1e-12 (relative) above a standard scale is rounding noise and
    is returned as that scale, so ``scale >= needed`` always holds.
    """
    long_side, short_side = max(frame_w, frame_h), min(frame_w, frame_h)
    keep = 1.0 - margin_pct / 100.0
    landscape = max(width_m / (long_side * keep), height_m / (short_side * keep))
    portrait = max(width_m / (short_side * keep), height_m / (long_side * keep))
    if portrait < landscape:
        orient, needed = "PORTRAIT", portrait
    else:
        orient, needed = "LANDSCAPE", landscape
    scale = None
    for candidate in scales:
        if candidate >= needed * (1.0 - 1e-12):
            scale = candidate
            break
    if scale is not None and scale < needed:
        # Within rounding noise of a standard scale (a page that fits it exactly, computed
        # as 1250.0000000000002): report that scale as needed too, so SCALE >= SCALE_NEEDED
        # always holds in the output.
        needed = float(scale)
    return orient, needed, scale


def page_ranges(pages, use_number):
    """``[(group text or None, pages text)]`` with ``compress_ranges`` per group,
    sorted naturally by group (null group first)."""
    groups = {}
    for page in pages:
        groups.setdefault(label_text(page.get("group")), []).append(page_label(page, use_number))
    return [(group, compress_ranges(labels))
            for group, labels in sorted(groups.items(), key=lambda g: natural_sort_key(g[0]))]


# ==========================================================================
# carto/timestep_core.py
# ==========================================================================
# Time Series Layout Export: the pure logic (no arcpy).
#
# * step generation for the four modes (time windows with month-end and leap-year handling,
#   attribute values, layer visibility, bookmarks);
# * label formatting (English or Arabic month names, no locale needed), placeholders in text;
# * SQL clauses for definition queries (verified syntax: file geodatabase, see the tool page);
# * frame names, manifest rows and CSV, per-step feature counts;
# * GIF stitching with Pillow (imported lazily, and only here): one adaptive palette for the
#   whole sequence by default, so colours do not flicker between frames.

TIMESTEP_MODES = ("TIME", "ATTRIBUTE", "LAYER_VISIBILITY", "BOOKMARKS")
TIMESTEP_UNITS = ("HOURS", "DAYS", "WEEKS", "MONTHS", "YEARS")
TIMESTEP_WINDOWS = ("SLIDING", "CUMULATIVE")
TIMESTEP_PALETTES = ("GLOBAL", "PER_FRAME")
TIMESTEP_ORDERS = ("ASCENDING", "DESCENDING")
TIMESTEP_LANGUAGES = ("EN", "AR")
TIMESTEP_PLACEHOLDERS = ("{STEP}", "{FROM}", "{TO}", "{INDEX}", "{COUNT}")

TIMESTEP_DEFAULT_FORMATS = {"HOURS": "%Y-%m-%d %H:%M", "DAYS": "%Y-%m-%d", "WEEKS": "%Y-%m-%d",
                            "MONTHS": "%b %Y", "YEARS": "%Y"}
TIMESTEP_MIN_FRAME_MS = 20
TIMESTEP_MAX_COLOURS = 256
TIMESTEP_GIF_MAX_DELAY_MS = 655350    # a GIF frame delay is 16 bits of 10 ms (65535 cs)

TIMESTEP_MONTHS = {
    "EN": ("January", "February", "March", "April", "May", "June", "July", "August",
           "September", "October", "November", "December"),
    # Gregorian month names as used in Saudi Arabia.
    "AR": (u"يناير", u"فبراير",
           u"مارس", u"أبريل", u"مايو",
           u"يونيو", u"يوليو",
           u"أغسطس", u"سبتمبر",
           u"أكتوبر", u"نوفمبر",
           u"ديسمبر")}
TIMESTEP_SHORT_MONTHS_EN = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct",
                            "Nov", "Dec")

TIMESTEP_MANIFEST_HEADER = ("FRAME", "STEP_LABEL", "RANGE_FROM", "RANGE_TO_EXCLUSIVE", "DETAIL",
                            "FEATURES", "FILE", "BYTES", "SHA256")


# --------------------------------------------------------------------------
# Dates
# --------------------------------------------------------------------------

def timestep_normalise_value(value):
    """A cursor value of a date field as a naive ``datetime`` (or None / unchanged).

    ``datetime.date`` (DateOnly fields) becomes midnight; a time zone aware value
    (TimestampOffset fields) keeps its clock time and loses the offset, like every date the
    tool reads (values are used as stored). Anything else is returned unchanged."""
    if isinstance(value, datetime.datetime):
        return value.replace(tzinfo=None) if value.tzinfo is not None else value
    if isinstance(value, datetime.date):
        return datetime.datetime(value.year, value.month, value.day)
    return value


def _ts_guard(func):
    """Turn calendar overflow (year 1 to 9999) into a user-facing ToolError."""
    @functools.wraps(func)
    def inner(*args, **kwargs):
        try:
            return func(*args, **kwargs)
        except (OverflowError, ValueError) as err:
            raise ToolError(
                "The time range or the step length is outside what the calendar can hold "
                "(years 1 to 9999): {0}.".format(err),
                "Use a smaller step length, and start and end times between the years 1 and 9999.")
    return inner


def timestep_add_months(anchor, months):
    """``anchor`` plus whole months; the day is clamped to the length of the target month
    (31 Jan + 1 month = 28 or 29 Feb)."""
    index = anchor.month - 1 + months
    year = anchor.year + index // 12
    month = index % 12 + 1
    day = min(anchor.day, calendar.monthrange(year, month)[1])
    return anchor.replace(year=year, month=month, day=day)


def timestep_shift(anchor, k, interval, unit):
    """The start of step ``k``: ``anchor + k * interval units``, always computed from the
    anchor, so 31 Jan, 28 Feb, 31 Mar is correct (no drift to the 28th) and 29 Feb 2024 plus
    four years is 29 Feb 2028."""
    n = k * interval
    if unit == "HOURS":
        return anchor + datetime.timedelta(hours=n)
    if unit == "DAYS":
        return anchor + datetime.timedelta(days=n)
    if unit == "WEEKS":
        return anchor + datetime.timedelta(days=7 * n)
    if unit == "MONTHS":
        return timestep_add_months(anchor, n)
    if unit == "YEARS":
        return timestep_add_months(anchor, 12 * n)
    raise ToolError("Unknown time unit '{0}'.".format(unit),
                    "Use one of: {0}.".format(", ".join(TIMESTEP_UNITS)))


def timestep_floor(value, unit):
    """``value`` rounded down to the start of its unit (month start for MONTHS, year start for
    YEARS, midnight for DAYS and WEEKS, the full hour for HOURS)."""
    if unit == "HOURS":
        return value.replace(minute=0, second=0, microsecond=0)
    if unit in ("DAYS", "WEEKS"):
        return value.replace(hour=0, minute=0, second=0, microsecond=0)
    if unit == "MONTHS":
        return value.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    if unit == "YEARS":
        return value.replace(month=1, day=1, hour=0, minute=0, second=0, microsecond=0)
    raise ToolError("Unknown time unit '{0}'.".format(unit))


_TS_DATE_FORMATS = ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d",
                    "%m/%d/%Y %I:%M:%S %p", "%m/%d/%Y %H:%M:%S", "%m/%d/%Y")


def timestep_parse_datetime(value):
    """A ``datetime`` from a datetime, a date or text (ISO, or the US form Pro may show, always month/day/year);
    ``None`` for empty input. Text that fits no form raises ``ToolError``."""
    if value is None or value == "":
        return None
    if isinstance(value, datetime.datetime):
        return value.replace(tzinfo=None)
    if isinstance(value, datetime.date):
        return datetime.datetime(value.year, value.month, value.day)
    text = str(value).strip()
    for form in _TS_DATE_FORMATS:
        try:
            return datetime.datetime.strptime(text, form)
        except ValueError:
            continue
    raise ToolError("Cannot read the date '{0}'.".format(text),
                    "Use the form 2025-01-31 or 2025-01-31 13:45:00.")


@_ts_guard
def timestep_resolve_range(start, end, data_min, data_max, unit):
    """``(start, end_exclusive)`` of the time domain.

    A blank start is the earliest data date rounded down to the unit. An end given as a
    date (midnight) includes that whole day; an end with a time of day includes that second.
    A blank end is the latest data date (whole second included). Seconds are the resolution
    of the definition queries.
    """
    from_data = start is None
    if start is None:
        if data_min is None:
            raise ToolError("No start time was given and the step layers hold no dates.",
                            "Enter a start time, or choose a layer with date values.")
        start = timestep_floor(data_min, unit)
    start = start.replace(microsecond=0)
    if end is None:
        if data_max is None:
            raise ToolError("No end time was given and the step layers hold no dates.",
                            "Enter an end time, or choose a layer with date values.")
        end_excl = data_max.replace(microsecond=0) + datetime.timedelta(seconds=1)
    elif end.hour == 0 and end.minute == 0 and end.second == 0 and end.microsecond == 0:
        end_excl = end + datetime.timedelta(days=1)
    else:
        end_excl = end.replace(microsecond=0) + datetime.timedelta(seconds=1)
    if end_excl <= start:
        if end is None:
            raise ToolError("The start time {0} is after the last date in the data ({1}).".format(
                start, data_max.replace(microsecond=0)),
                "Enter an earlier start time, or leave Start Time blank to start at the first "
                "date in the data.")
        if from_data:
            raise ToolError(
                "The end time {0} is not after the start time {1} (Start Time is blank, so the "
                "start is the first date in the data, {2}, rounded down to the step unit)."
                .format(end, start, data_min.replace(microsecond=0)),
                "Enter a later end time, or a start time before the end time.")
        raise ToolError("The end time {0} is not after the start time {1}.".format(
            end, start), "Enter an end time later than the start time.")
    return start, end_excl


TIMESTEP_FORMAT_TOKENS = "YymdHMSbB%"


def timestep_unknown_tokens(fmt):
    """The ``%x`` tokens of a label format that ``timestep_format`` does not know, in order,
    each once (they are copied to the label as typed, for example ``%A``)."""
    out = []
    i = 0
    text = fmt or ""
    while i < len(text):
        if text[i] == "%" and i + 1 < len(text):
            tok = text[i + 1]
            if tok not in TIMESTEP_FORMAT_TOKENS and ("%" + tok) not in out:
                out.append("%" + tok)
            i += 2
            continue
        i += 1
    return out


def timestep_format(value, fmt, language="EN"):
    """Format a datetime without the locale: tokens %Y %y %m %d %H %M %S %b %B %% (month
    names English or Arabic); any other character is copied. Arabic month names keep Western
    digits."""
    names = TIMESTEP_MONTHS.get(language) or TIMESTEP_MONTHS["EN"]
    out = []
    i = 0
    while i < len(fmt):
        ch = fmt[i]
        if ch != "%" or i + 1 >= len(fmt):
            out.append(ch)
            i += 1
            continue
        tok = fmt[i + 1]
        i += 2
        if tok == "Y":
            out.append("%04d" % value.year)
        elif tok == "y":
            out.append("%02d" % (value.year % 100))
        elif tok == "m":
            out.append("%02d" % value.month)
        elif tok == "d":
            out.append("%02d" % value.day)
        elif tok == "H":
            out.append("%02d" % value.hour)
        elif tok == "M":
            out.append("%02d" % value.minute)
        elif tok == "S":
            out.append("%02d" % value.second)
        elif tok == "B":
            out.append(names[value.month - 1])
        elif tok == "b":
            out.append(TIMESTEP_SHORT_MONTHS_EN[value.month - 1] if language != "AR"
                       else names[value.month - 1])
        elif tok == "%":
            out.append("%")
        else:
            out.append("%" + tok)
    return u"".join(out)


def timestep_iso(value):
    """``2025-01-31 00:00:00`` (the form used in manifests and queries)."""
    # four-digit year also before 1000 (strftime gives '950' on Linux, an invalid literal)
    return timestep_format(value, "%Y-%m-%d %H:%M:%S") if value is not None else ""


# --------------------------------------------------------------------------
# Steps
# --------------------------------------------------------------------------

def _ts_check_window(window, window_steps):
    if window not in TIMESTEP_WINDOWS:
        raise ToolError("Unknown window type '{0}'.".format(window),
                        "Use SLIDING or CUMULATIVE.")
    if int(window_steps) < 1:
        raise ToolError("The window width must be at least 1 step.",
                        "Enter a window width of 1 or more.")


@_ts_guard
def timestep_time_steps(start, end_excl, interval, unit, window="SLIDING", window_steps=1,
                        label_format=None, language="EN", max_steps=300):
    """The steps of TIME mode.

    Step ``k`` begins at ``start + k * interval`` (anchored at ``start``) and ends where the
    next begins, the last one at ``end_excl`` (``partial`` is then True). A SLIDING window
    shows the last ``window_steps`` steps, a CUMULATIVE window everything since ``start``.
    Returns a list of dicts: index (1-based), label ({STEP}: the step start formatted),
    from_text/to_text ({FROM}, {TO}: window start and last included second), window_start,
    window_end (exclusive), partial.
    """
    if int(interval) < 1:
        raise ToolError("The interval must be at least 1.", "Enter a whole number of 1 or more.")
    if unit not in TIMESTEP_UNITS:
        raise ToolError("Unknown time unit '{0}'.".format(unit),
                        "Use one of: {0}.".format(", ".join(TIMESTEP_UNITS)))
    _ts_check_window(window, window_steps)
    fmt = label_format or TIMESTEP_DEFAULT_FORMATS[unit]
    starts = []
    k = 0
    while True:
        s = timestep_shift(start, k, int(interval), unit)
        if s >= end_excl:
            break
        starts.append(s)
        k += 1
        if len(starts) > max_steps:
            raise ToolError(
                "The time range gives more than {0} frames.".format(max_steps),
                "Use a longer interval or a shorter range, or raise Maximum Frames.")
    steps = []
    for k, s in enumerate(starts):
        nxt = timestep_shift(start, k + 1, int(interval), unit)
        end = min(nxt, end_excl)
        first = starts[0] if window == "CUMULATIVE" else starts[max(0, k - int(window_steps) + 1)]
        last_second = end - datetime.timedelta(seconds=1)
        steps.append({"index": k + 1, "label": timestep_format(s, fmt, language),
                      "from_text": timestep_format(first, fmt, language),
                      "to_text": timestep_format(last_second, fmt, language),
                      "window_start": first, "window_end": end, "partial": nxt > end_excl,
                      "detail": ""})
    return steps


def timestep_value_key(value):
    """The value ATTRIBUTE mode steps by: a date is cut to whole seconds (the resolution of
    labels and queries), so 08:00:00.0 and 08:00:00.5 are one value, one frame and one count.
    Other values are returned unchanged."""
    if isinstance(value, datetime.datetime) and value.microsecond:
        return value.replace(microsecond=0)
    return value


# ---- number fields: integer, Double and Single (float32) values ------------------------------

TIMESTEP_NUMBER_TYPES = {"SmallInteger": "integer", "Integer": "integer", "BigInteger": "integer",
                         "OID": "integer", "Double": "double", "Single": "single"}
_TS_F32_TINY = struct.unpack("<f", struct.pack("<I", 1))[0]     # smallest positive float32


def timestep_number_type(field_type):
    """``integer`` / ``double`` / ``single`` for a number Field.type, else None."""
    return TIMESTEP_NUMBER_TYPES.get(field_type)


def _ts_f32(value):
    """``value`` rounded to the nearest float32 (ties to even), as a Python float. Raises
    OverflowError beyond the float32 range."""
    return struct.unpack("<f", struct.pack("<f", value))[0]


def _ts_f32_next(value, direction):
    """The float32 next to the float32 ``value`` towards +inf (``direction`` > 0) or -inf."""
    if value == 0.0:
        return _TS_F32_TINY if direction > 0 else -_TS_F32_TINY
    bits = struct.unpack("<I", struct.pack("<f", value))[0]
    bits += 1 if (value > 0) == (direction > 0) else -1
    return struct.unpack("<f", struct.pack("<I", bits))[0]


def _ts_is_finite_number(value):
    return (isinstance(value, (int, float)) and not isinstance(value, bool)
            and value == value and value not in (float("inf"), float("-inf")))


def _ts_is_non_finite_number(value):
    """True for a float NaN or infinity (a number no definition query can select)."""
    return (isinstance(value, float) and not isinstance(value, bool)
            and (value != value or value in (float("inf"), float("-inf"))))


def timestep_single_value(value):
    """A value read from a Single (float32) field as the shortest decimal that is the same
    float32: the cursor gives 1.100000023841858 for a stored 1.1, this gives 1.1, so labels,
    file names and listed values read as the user typed them. Other values (None, NaN, text,
    values outside the float32 range) are returned unchanged."""
    if not _ts_is_finite_number(value):
        return value
    try:
        f32 = _ts_f32(float(value))
    except OverflowError:
        return value
    for digits in range(1, 10):              # 9 significant digits always identify a float32
        candidate = float("%.*g" % (digits, f32))
        try:
            same = _ts_f32(candidate) == f32
        except OverflowError:                # 3.403e38 (a rounded -3.4028235e38, the usual
            continue                         # float NoData value) is beyond the float32 range
        if same:
            return candidate
    return f32


def _ts_nearest_single(number):
    """The float32 nearest to the exact rational ``number`` (ties to the even float32), or None
    outside the float32 range. Exact: the candidate from the double is checked against its two
    float32 neighbours with Fractions (rounding twice, decimal to double to float32, can be off
    by one float32 on a tie)."""
    try:
        guess = _ts_f32(float(number))
    except OverflowError:
        return None
    best = None
    for cand in (_ts_f32_next(guess, -1), guess, _ts_f32_next(guess, 1)):
        if not _ts_is_finite_number(cand):
            continue
        gap = abs(fractions.Fraction(cand) - number)
        even = struct.unpack("<I", struct.pack("<f", cand))[0] % 2 == 0
        key = (gap, not even)
        if best is None or key < best[0]:
            best = (key, cand)
    return None if best is None else best[1]


def _ts_number_listed_key(text, number_type):
    """The comparison key of a value typed for a number field, or None when the text is not a
    plain number. The typed number is turned into the value the field would store (an integer,
    the nearest Double, the nearest Single) and keyed like the data, so ``2.0``, ``2``, ``+2``
    and ``002`` are one value, ``1.50`` is ``1.5``, and ``1.1`` matches a Single 1.1."""
    s = text.strip() if isinstance(text, str) else value_to_text(text)
    if s is None or not _TS_NUMBER_RE.match(s):
        return None
    if _ts_decimal_magnitude(s) > 400:
        return None                           # beyond every Double and Single (1e999999)
    if _ts_decimal_magnitude(s) < -400:
        # below every Double and Single: the field stores zero. Not built as a Fraction, which
        # takes minutes for an exponent such as 1e-9999999.
        tiny = float(s)                       # +0.0 or -0.0, correctly rounded and fast
        return value_to_text(timestep_single_value(tiny) if number_type == "single" else tiny)
    number = fractions.Fraction(s)
    if number_type == "single":
        nearest = _ts_nearest_single(number)
        return None if nearest is None else value_to_text(timestep_single_value(nearest))
    if number.denominator == 1 and number_type != "double":
        return str(number.numerator)          # integers exactly (no float rounding of big ones)
    try:
        return value_to_text(float(number))
    except OverflowError:
        return None


def _ts_decimal_magnitude(text):
    """The decimal exponent of the leading digit of a plain number text (``_TS_NUMBER_RE``):
    3 for ``1234.5``, -2 for ``0.012``, 7 for ``1e7``; 0 for zero. Read from the text only, so
    a typed exponent such as ``1e999999999`` costs nothing."""
    body = text.lstrip("+-")
    exponent = 0
    for mark in ("e", "E"):
        if mark in body:
            body, exp_text = body.split(mark, 1)
            exponent = int(exp_text)
    whole, _dot, frac = body.partition(".")
    digits = (whole + frac).lstrip("0")
    if not digits:
        return 0
    if whole.lstrip("0"):
        return exponent + len(whole.lstrip("0")) - 1
    return exponent - (len(frac) - len(frac.lstrip("0"))) - 1


_TS_SLASH_DATE_RE = re.compile(r"^\s*(\d{1,2})/(\d{1,2})/\d{4}(\s|$)")


def _ts_is_ambiguous_us_date(text):
    """True for listed text such as ``02/01/2025`` that reads as a different valid date in
    day/month/year order (both numbers 1 to 12 and not equal)."""
    match = _TS_SLASH_DATE_RE.match(text) if isinstance(text, str) else None
    if not match:
        return False
    first, second = int(match.group(1)), int(match.group(2))
    return 1 <= first <= 12 and 1 <= second <= 12 and first != second


def _ts_listed_key(text, kind, number_type=None):
    """The comparison key of one listed value. On a date field the text is read as a date
    (``2025-01-01`` is midnight, the US form Pro shows is accepted too, read month/day/year) and cut to whole
    seconds, so it matches the data whatever form was typed. On a number field the text is
    read as a number (see ``_ts_number_listed_key``). Text that is neither is kept."""
    if kind == "number":
        key = _ts_number_listed_key(text, number_type)
        if key is not None:
            return key
    if kind == "date" and not isinstance(text, datetime.datetime):
        try:
            parsed = timestep_parse_datetime(text)
        except ToolError:
            parsed = None
        if parsed is not None:
            return value_to_text(timestep_value_key(parsed))
    if isinstance(text, datetime.datetime):
        return value_to_text(timestep_value_key(text))
    return value_to_text(text)


def timestep_order_values(values, order="ASCENDING", listed=None, kind=None, number_type=None):
    """``(ordered values, messages)`` for ATTRIBUTE mode.

    ``listed`` (the user's own order, as text) replaces the automatic order: only listed
    values that exist are used, in that order; unlisted values are left out and listed
    values that do not exist are reported. Automatic order: numbers by their numeric value
    (-10 before -2 before 0 before 1.25 before 1.5), text natural (2 before 10) and compared
    case-insensitively; NULL and empty values, and NaN or infinite numbers (no SQL literal
    selects them), are dropped and counted. With
    ``kind="date"`` listed text is read as a date first, with ``kind="number"`` as a number
    (``2.0`` = ``2``; see ``_ts_listed_key``). ``number_type="single"`` (a Single field) keys
    values by their shortest float32 form (``timestep_single_value``).
    """
    messages = []
    seen = {}
    nulls = 0
    non_finite = 0
    for v in values:
        if v is None or (isinstance(v, str) and v.strip() == ""):
            nulls += 1
            continue
        if _ts_is_non_finite_number(v):
            non_finite += 1
            continue
        v = timestep_value_key(v)
        if number_type == "single":
            v = timestep_single_value(v)
        seen.setdefault(value_to_text(v), v)
    if nulls:
        messages.append("{0} feature(s) with an empty value (NULL, or text that is empty or only "
                        "spaces) are not given a frame.".format(nulls))
    if non_finite:
        messages.append("{0} feature(s) with a NaN or infinite value are not given a frame (no "
                        "definition query can select them); they are not counted in any frame."
                        .format(non_finite))
    if listed:
        out = []
        missing = []
        used = set()
        for text in listed:
            key = _ts_listed_key(text, kind, number_type)
            if key in seen and key not in used:
                out.append(seen[key])
                used.add(key)
            elif key not in seen:
                missing.append(text.strip() if isinstance(text, str) else value_to_text(text))
        ambiguous = [text.strip() for text in listed if kind == "date"
                     and _ts_is_ambiguous_us_date(text)]
        if ambiguous:
            first = timestep_parse_datetime(ambiguous[0])
            names = TIMESTEP_MONTHS["EN"]
            messages.append(
                "Listed dates written with slashes are read as month/day/year: {0} is {1} {2} "
                "{3}, not {4} {5} {3} ({6} such value(s)). For day/month/year, type the dates "
                "as YYYY-MM-DD.".format(ambiguous[0], first.day, names[first.month - 1],
                                        first.year, first.month, names[first.day - 1],
                                        len(ambiguous)))
        if missing:
            hint = ""
            if kind == "date" and seen:
                hint = (" Date values are compared to the second, as YYYY-MM-DD HH:MM:SS (for "
                        "example {0}).".format(next(iter(seen))))
            elif kind == "number" and seen:
                hint = (" Numbers are compared by value, typed with a point as the decimal "
                        "separator and no thousands separator (2, 2.0 and +2 are the same "
                        "value); values in the data: {0}.".format(
                            ", ".join(list(seen)[:5]) + (" ..." if len(seen) > 5 else "")))
            messages.append("Listed value(s) not found in the data and skipped: {0}.{1}".format(
                ", ".join(missing[:20]) + (" ..." if len(missing) > 20 else ""), hint))
        extra = [k for k in seen if k not in used]
        if extra:
            messages.append("{0} value(s) in the data are not in your list and get no frame."
                            .format(len(extra)))
        return out, messages
    if _ts_is_numeric(seen.values(), kind):
        sort_key = lambda k: (_ts_number_key(seen[k]), natural_sort_key(k))  # noqa: E731
    else:
        sort_key = natural_sort_key
    keys = sorted(seen, key=sort_key, reverse=(order == "DESCENDING"))
    return [seen[k] for k in keys], messages


def _ts_is_numeric(values, kind):
    """True when ATTRIBUTE values are ordered by their numeric value: a number field, or (no
    field kind given) values that are all int or float (bools are not numbers here)."""
    values = list(values)
    if not values:
        return False
    numbers = all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in values)
    if kind == "number":
        return numbers or all(_ts_number_key(v)[0] < 2 for v in values)
    return kind is None and numbers


def _ts_number_key(value):
    """Numeric sort key: ``(0, value)`` for a number, NaN after every number, and a value that
    cannot be read as a number after that."""
    try:
        number = float(value)
    except (TypeError, ValueError):
        return (2, 0.0)
    if number != number:
        return (1, 0.0)
    return (0, number)


def timestep_item_steps(items, window="SLIDING", window_steps=1, language="EN"):
    """Steps for ATTRIBUTE (values), LAYER_VISIBILITY (layer names) and BOOKMARKS (names):
    ``items`` is a list of display texts in frame order. Window rules as in time mode (a
    bookmark frame is always one bookmark: pass SLIDING and 1)."""
    _ts_check_window(window, window_steps)
    texts = [value_to_text(v) for v in items]
    steps = []
    for k, text in enumerate(texts):
        first = 0 if window == "CUMULATIVE" else max(0, k - int(window_steps) + 1)
        steps.append({"index": k + 1, "label": text, "from_text": texts[first],
                      "to_text": text, "window_start": None, "window_end": None,
                      "partial": False, "detail": text, "members": list(range(first, k + 1))})
    return steps


_TS_PLACEHOLDER_RE = re.compile(r"\{(STEP|FROM|TO|INDEX|COUNT)\}")


def timestep_fill_template(text, step, count):
    """Replace {STEP} {FROM} {TO} {INDEX} {COUNT} in ``text``; other braces stay as they are."""
    if not text:
        return text
    values = {"STEP": step["label"], "FROM": step["from_text"], "TO": step["to_text"],
              "INDEX": str(step["index"]), "COUNT": str(count)}
    # one pass: a label that itself holds "{COUNT}" or "{TO}" is shown as typed, not replaced
    return _TS_PLACEHOLDER_RE.sub(lambda m: values[m.group(1)], text)


def timestep_has_placeholder(text):
    return bool(text) and any(p in text for p in TIMESTEP_PLACEHOLDERS)


# --------------------------------------------------------------------------
# SQL
# --------------------------------------------------------------------------

_TS_IDENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def timestep_check_field_name(name):
    """Refuse field names that need quoting (the tool writes plain names into queries)."""
    if not name or not _TS_IDENT.match(name):
        raise ToolError(
            "The field name '{0}' cannot be used in a generated query (letters, digits and "
            "underscores only).".format(name),
            "Use a field whose name is a plain identifier, or add a copy of the field.")
    return name


def timestep_sql_text(value):
    return u"'" + value_to_text(value).replace(u"'", u"''") + u"'"


def timestep_sql_timestamp(value):
    return u"timestamp '" + timestep_iso(value) + u"'"


def timestep_time_clause(field, window_start, window_end):
    """``F >= timestamp '...' AND F < timestamp '...'`` (the form Pro 3.3.2 accepts on a
    file geodatabase date field; other workspaces are not verified)."""
    timestep_check_field_name(field)
    return u"{0} >= {1} AND {0} < {2}".format(field, timestep_sql_timestamp(window_start),
                                               timestep_sql_timestamp(window_end))


def timestep_single_bounds(value):
    """``(low, high)`` doubles around the float32 nearest to ``value``: a quarter of the way to
    each neighbouring float32. Only that float32 lies in [low, high] whether the database
    compares in double precision (the neighbours are further away) or first rounds the
    literals to float32 (both round to the value itself); None for NaN or infinity."""
    if not _ts_is_finite_number(value):
        return None
    try:
        f32 = _ts_f32(float(value))
    except OverflowError:
        return None
    centre = fractions.Fraction(f32)
    out = []
    for direction in (-1, 1):
        other = _ts_f32_next(f32, direction)
        if _ts_is_finite_number(other):
            out.append(float(centre + (fractions.Fraction(other) - centre) / 4))
        else:                                  # beyond the largest float32: half a step
            out.append(float(centre + (centre - fractions.Fraction(
                _ts_f32_next(f32, -direction))) / 4))
    return out[0], out[1]


def timestep_value_clause(field, kind, values, number_type=None):
    """``F = 'a'`` for one value, ``F IN ('a', 'b')`` for several. ``kind`` is text, number or
    date. A date value selects its whole second, ``F >= timestamp 's' AND F < timestamp
    's+1'`` (the TIME mode syntax), so stored fractions of a second are not missed; several
    dates are joined with OR. A value of a Single field (``number_type="single"``) selects its
    float32 with a narrow range, ``F >= low AND F <= high`` (``timestep_single_bounds``), so
    the clause does not depend on how the database widens float32 values; several are joined
    with OR."""
    timestep_check_field_name(field)
    if kind == "number":
        bad = [v for v in values if _ts_is_non_finite_number(v)]
        if bad:
            raise ToolError("Internal error: a NaN or infinite value cannot be written into a "
                            "definition query ({0}).".format(value_to_text(bad[0])),
                            "Such values are left out of the frames; report this problem.")
    if kind == "number" and number_type == "single":
        parts = []
        for v in values:
            bounds = timestep_single_bounds(v)
            if bounds is None:               # cannot happen for a finite float32 value
                raise ToolError("Internal error: the value {0} cannot be selected in a Single "
                                "field.".format(value_to_text(v)), "Report this problem.")
            else:
                parts.append(u"{0} >= {1} AND {0} <= {2}".format(field, repr(bounds[0]),
                                                                  repr(bounds[1])))
        if len(parts) == 1:
            return parts[0]
        return u" OR ".join(u"(" + p + u")" for p in parts)
    if kind == "date":
        parts = []
        for v in values:
            s = timestep_value_key(v)
            parts.append(u"{0} >= {1} AND {0} < {2}".format(
                field, timestep_sql_timestamp(s),
                timestep_sql_timestamp(s + datetime.timedelta(seconds=1))))
        if len(parts) == 1:
            return parts[0]
        return u" OR ".join(u"(" + p + u")" for p in parts)

    def lit(v):
        if kind == "text":
            return timestep_sql_text(v)
        if kind == "date":
            return timestep_sql_timestamp(v)
        if isinstance(v, bool):
            return u"1" if v else u"0"
        if isinstance(v, int):
            return str(v)
        return repr(float(v))

    lits = [lit(v) for v in values]
    if len(lits) == 1:
        return u"{0} = {1}".format(field, lits[0])
    return u"{0} IN ({1})".format(field, u", ".join(lits))


def timestep_and(base, clause):
    """Combine the layer's own definition query with the step clause."""
    if base and base.strip():
        return u"({0}) AND ({1})".format(base.strip(), clause)
    return clause


def timestep_field_kind(field_type, for_time=False):
    """``text`` / ``number`` / ``date`` for a Field.type, or raise for unusable types."""
    if for_time:
        if field_type in ("Date", "DateOnly", "TimestampOffset"):
            return "date"
        raise ToolError("The time field must be a date field; its type is {0}.".format(field_type),
                        "Choose a field of type Date. Text fields that hold dates are not "
                        "supported; convert them with Convert Time Field first.")
    if field_type == "String":
        return "text"
    if field_type in ("SmallInteger", "Integer", "BigInteger", "Double", "Single", "OID"):
        return "number"
    if field_type in ("Date", "DateOnly", "TimestampOffset"):
        return "date"
    raise ToolError("Fields of type {0} cannot be stepped through.".format(field_type),
                    "Use a text, number or date field.")


# --------------------------------------------------------------------------
# Counts per step
# --------------------------------------------------------------------------

def timestep_count_time(dates, steps):
    """Number of dates inside each step's window ([start, end)). ``dates`` may hold None."""
    ordered = sorted(d for d in dates if d is not None)
    counts = []
    for step in steps:
        lo = bisect.bisect_left(ordered, step["window_start"])
        hi = bisect.bisect_left(ordered, step["window_end"])
        counts.append(hi - lo)
    return counts


def timestep_count_values(values, ordered_values, steps, number_type=None):
    """Number of features per step in ATTRIBUTE mode (window members summed)."""
    per_value = {}
    for v in values:
        if v is None or _ts_is_non_finite_number(v):
            continue
        v = timestep_value_key(v)
        key = value_to_text(timestep_single_value(v) if number_type == "single" else v)
        per_value[key] = per_value.get(key, 0) + 1
    texts = [value_to_text(timestep_value_key(v)) for v in ordered_values]
    return [sum(per_value.get(texts[m], 0) for m in step["members"]) for step in steps]


# --------------------------------------------------------------------------
# Frames and manifest
# --------------------------------------------------------------------------

def timestep_slug(text, limit=40):
    """File-name-safe version of a label (Unicode letters and digits kept)."""
    out = re.sub(r"[^\w\-]+", "_", value_to_text(text), flags=re.UNICODE).strip("_")
    return out[:limit].strip("_")


def timestep_frame_name(index, count, label=None, ext=".png"):
    """``frame_0007_Jul_2025.png``: zero-padded to at least 4 digits, never starts with a
    label, so names sort in frame order and never collide with Windows device names."""
    width = max(4, len(str(count)))
    slug = timestep_slug(label) if label else ""
    name = "frame_" + str(index).zfill(width)
    if slug:
        name += "_" + slug
    return name + ext


def timestep_sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def timestep_manifest_row(step, features, file_name, nbytes, digest):
    """One manifest row (tuple in ``TIMESTEP_MANIFEST_HEADER`` order)."""
    return (step["index"], step["label"], timestep_iso(step.get("window_start")),
            timestep_iso(step.get("window_end")), step.get("detail") or "",
            "" if features is None else features, file_name, nbytes, digest)


_TS_NUMBER_RE = re.compile(r"^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$")
# the CSV guard counts only the digits 0-9 as a plain number (\d also matches Arabic-Indic digits,
# which Excel does not read as a number); listed values keep _TS_NUMBER_RE
_TS_CSV_NUMBER_RE = re.compile(r"^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$")


def timestep_csv_cell(value):
    """A manifest cell that Excel will not run as a formula: text that starts with ``=``,
    ``+``, ``-``, ``@``, a tab or a carriage return gets a leading apostrophe, unless it is a
    plain number such as ``-5`` (labels come from attribute data, so this guards against CSV
    formula injection). Other values are returned unchanged."""
    if isinstance(value, str) and value[:1] in ("=", "+", "-", "@", "\t", "\r") \
            and not _TS_CSV_NUMBER_RE.match(value):
        return "'" + value
    return value


def timestep_write_manifest(path, rows):
    """UTF-8 CSV with a BOM (Excel shows Arabic labels correctly). Text cells that Excel
    would read as a formula are prefixed with an apostrophe (``timestep_csv_cell``)."""
    with open(path, "w", encoding="utf-8-sig", newline="") as handle:
        writer = csv.writer(handle)
        writer.writerow(TIMESTEP_MANIFEST_HEADER)
        for row in rows:
            writer.writerow([timestep_csv_cell(v) for v in row])


# --------------------------------------------------------------------------
# GIF
# --------------------------------------------------------------------------

def timestep_pillow():
    """The Pillow ``Image`` module, imported lazily (ArcGIS Pro ships Pillow; Pro 3.3.2
    has 10.2.0). ``ToolError`` when it is missing."""
    try:
        return importlib.import_module("PIL.Image")
    except ImportError:
        raise ToolError("The Pillow package is not available in this Python environment, so the "
                        "GIF cannot be written.",
                        "Run the tool in ArcGIS Pro's own Python environment (it includes "
                        "Pillow), or set Output Frames Folder to keep the frame images and "
                        "stitch them in another program.")


def _ts_enum(module, group, name, old):
    holder = getattr(module, group, None)
    if holder is not None and hasattr(holder, name):
        return getattr(holder, name)
    return getattr(module, old)


def _ts_load_rgb(Image, path):
    """Open a frame and flatten any transparency onto white; returns an RGB image."""
    im = Image.open(path)
    im.load()
    if im.mode in ("RGBA", "LA") or (im.mode == "P" and "transparency" in im.info):
        im = im.convert("RGBA")
        bg = Image.new("RGB", im.size, (255, 255, 255))
        bg.paste(im, mask=im.getchannel("A"))
        return bg
    return im.convert("RGB")


# ---- palette and colour mapping (numpy; exact integer arithmetic) ----------------------------
#
# Pillow's own Image.quantize(palette=...) merges colours a few levels apart (255 with 254) and
# a plain median cut averages away small saturated features (a 64 pixel blue marker became
# grey in the independent review), so the palette and the mapping are made here:
#   * up to 256 colours in the sequence: the palette is exactly those colours;
#   * more: the 8 most frequent colours (page white, black text ...) are kept exactly, a
#     weighted median cut gives most of the entries, and the last entries are reserved for the
#     colours that the median cut represents worst, weighted by how many pixels use them, so
#     small saturated symbols and legend swatches keep their hue.

TIMESTEP_PALETTE_KEEP_EXACT = 8
TIMESTEP_PALETTE_RESERVE = 32
TIMESTEP_SIGNIFICANT_PIXELS = 10          # a colour used by fewer pixels is not "a feature"
TIMESTEP_NOTICEABLE_SHIFT = 90            # a colour shift above this (of 765) is noticeable
TIMESTEP_SHIFTED_SHARE_WARN = 0.001       # warn when this share of the pixels shifts noticeably
TIMESTEP_BYTES_PER_PIXEL = 48             # peak memory per pixel of one frame (measured ~40)
TIMESTEP_MEMORY_WARN = 1500 * 1024 * 1024
TIMESTEP_MEMORY_REFUSE = 3500 * 1024 * 1024


def _ts_numpy():
    return importlib.import_module("numpy")


def _ts_unpack(np, packed):
    packed = np.asarray(packed, dtype=np.uint32)
    return np.stack([(packed >> 16) & 255, (packed >> 8) & 255, packed & 255],
                    axis=1).astype(np.int32)


def _ts_histogram(np, image):
    """``(sorted packed colours, pixel counts)`` of an RGB image."""
    arr = np.asarray(image, dtype=np.uint8)
    packed = ((arr[:, :, 0].astype(np.uint32) << 16) | (arr[:, :, 1].astype(np.uint32) << 8)
              | arr[:, :, 2]).ravel()
    uniq, counts = np.unique(packed, return_counts=True)
    return uniq, counts.astype(np.int64)


def _ts_merge_histograms(np, a, b):
    if a is None:
        return b
    packed = np.concatenate([a[0], b[0]])
    counts = np.concatenate([a[1], b[1]])
    uniq, inverse = np.unique(packed, return_inverse=True)
    total = np.bincount(np.asarray(inverse).ravel(), weights=counts, minlength=len(uniq))
    return uniq, np.rint(total).astype(np.int64)


def _ts_nearest(np, colours, palette):
    """Index of the nearest palette entry for every row of ``colours`` (squared RGB distance).

    |c - p|^2 = |c|^2 - 2 c.p + |p|^2, and |c|^2 does not change the winner, so the winner is
    the largest 2 c.p - |p|^2. Every product is an integer below 2^24, exact in float32."""
    out = np.empty(len(colours), dtype=np.int64)
    pal = palette.astype(np.float32)
    norm = (pal * pal).sum(axis=1)
    for start in range(0, len(colours), 16384):
        chunk = colours[start:start + 16384].astype(np.float32)
        out[start:start + 16384] = (2.0 * (chunk @ pal.T) - norm[None, :]).argmax(axis=1)
    return out


def _ts_assign(np, uniq, palette):
    """Palette index for every distinct colour (``uniq`` packed, sorted).

    A colour that is in the palette keeps its own entry (exact). Others go to the nearest
    entry, looked up per 6-bit colour cell to keep large photographic sequences fast (the
    cell centre is at most 3 levels from any of its colours)."""
    cols = _ts_unpack(np, uniq)
    cell = ((cols[:, 0] >> 2) << 12) | ((cols[:, 1] >> 2) << 6) | (cols[:, 2] >> 2)
    cells, inverse = np.unique(cell, return_inverse=True)
    centres = np.stack([((cells >> 12) & 63) * 4 + 2, ((cells >> 6) & 63) * 4 + 2,
                        (cells & 63) * 4 + 2], axis=1)
    index = _ts_nearest(np, np.minimum(centres, 255), palette)[np.asarray(inverse).ravel()]
    pal_packed = ((palette[:, 0].astype(np.uint32) << 16) | (palette[:, 1].astype(np.uint32) << 8)
                  | palette[:, 2].astype(np.uint32))
    order = np.argsort(pal_packed, kind="stable")
    sorted_pal = pal_packed[order]
    pos = np.minimum(np.searchsorted(sorted_pal, uniq), len(sorted_pal) - 1)
    hit = sorted_pal[pos] == uniq
    index[hit] = order[pos[hit]]
    return index, cols


def _ts_median_cut(np, cols, counts, n_boxes):
    """Weighted median cut; returns the weighted mean colour of every box (rows of int32)."""
    if len(cols) > 262144:                       # merge into 6-bit cells first (speed)
        cell = ((cols[:, 0] >> 2) << 12) | ((cols[:, 1] >> 2) << 6) | (cols[:, 2] >> 2)
        cells, inverse = np.unique(cell, return_inverse=True)
        inverse = np.asarray(inverse).ravel()
        w = np.bincount(inverse, weights=counts, minlength=len(cells))
        merged = np.stack([np.bincount(inverse, weights=counts * cols[:, k], minlength=len(cells))
                           for k in range(3)], axis=1) / np.maximum(w, 1)[:, None]
        cols = np.rint(merged).astype(np.int32)
        counts = w
    w = counts.astype(np.float64)

    def score(idx):
        c = cols[idx].astype(np.float64)
        ww = w[idx]
        mean = (c * ww[:, None]).sum(axis=0) / ww.sum()
        return float((ww[:, None] * (c - mean) ** 2).sum())

    boxes = [np.arange(len(cols))]
    scores = [score(boxes[0])]
    while len(boxes) < n_boxes:
        best = int(np.argmax(scores))
        if scores[best] <= 0.0:
            break
        idx = boxes.pop(best)
        scores.pop(best)
        c = cols[idx]
        channel = int(np.argmax(c.max(axis=0) - c.min(axis=0)))
        order = idx[np.argsort(c[:, channel], kind="stable")]
        cum = np.cumsum(w[order])
        cut = int(np.searchsorted(cum, cum[-1] / 2.0)) + 1
        cut = min(max(cut, 1), len(order) - 1)
        for part in (order[:cut], order[cut:]):
            boxes.append(part)
            scores.append(score(part))
    out = []
    for idx in boxes:
        ww = w[idx]
        out.append(np.rint((cols[idx] * ww[:, None]).sum(axis=0) / ww.sum()).astype(np.int32))
    return np.array(out, dtype=np.int32)


def _ts_build_palette(np, hist, max_colours):
    """``(palette rows int32 Kx3, exact)`` for a colour histogram ``(packed, counts)``."""
    uniq, counts = hist
    cols = _ts_unpack(np, uniq)
    order = np.argsort(-counts, kind="stable")
    if len(uniq) <= max_colours:
        return cols[order], True
    keep = min(TIMESTEP_PALETTE_KEEP_EXACT, max_colours // 4)
    reserve = min(TIMESTEP_PALETTE_RESERVE, max_colours // 8)
    fixed = cols[order[:keep]]
    rest = np.ones(len(uniq), dtype=bool)
    rest[order[:keep]] = False
    base = _ts_median_cut(np, cols[rest], counts[rest], max_colours - keep - reserve)
    palette = np.concatenate([fixed, base])
    # reserve: colours the palette so far represents worst, weighted by their pixel count
    index, _c = _ts_assign(np, uniq, palette)
    err = ((cols - palette[index]) ** 2).sum(axis=1).astype(np.float64)
    weight = 1.0 + np.log2(counts.astype(np.float64))
    extra = []
    for _k in range(reserve):
        pick = int(np.argmax(err * weight))
        if err[pick] <= 0.0:
            break
        extra.append(cols[pick])
        err = np.minimum(err, ((cols - cols[pick]) ** 2).sum(axis=1))
    if extra:
        palette = np.concatenate([palette, np.array(extra, dtype=np.int32)])
    return palette, False


def _ts_palette_image(Image, palette):
    """A 256-entry palette image. Unused slots repeat the last real colour (not black), so a
    dithered quantize can never pick a colour that is in neither the frames nor the palette."""
    flat = []
    for r in palette:
        flat.extend(int(x) for x in r)
    last = flat[-3:] if len(flat) >= 3 else [0, 0, 0]
    while len(flat) < 768:
        flat.extend(last)
    pal = Image.new("P", (1, 1))
    pal.putpalette(flat)
    return pal


def _ts_map_frame(Image, np, image, palette, hist, stats):
    """Map an RGB frame onto ``palette`` without dithering; collects the colour error."""
    arr = np.asarray(image, dtype=np.uint8)
    height, width = arr.shape[0], arr.shape[1]
    packed = ((arr[:, :, 0].astype(np.uint32) << 16) | (arr[:, :, 1].astype(np.uint32) << 8)
              | arr[:, :, 2]).ravel()
    uniq, counts = hist
    index, cols = _ts_assign(np, uniq, palette)
    diff = np.abs(cols - palette[index]).sum(axis=1)
    big = counts >= TIMESTEP_SIGNIFICANT_PIXELS
    if big.any():
        stats["frequent"] = True
        stats["worst"] = max(stats["worst"], int(diff[big].max()))
    if (~big).any():
        stats["worst_rare"] = max(stats["worst_rare"], int(diff[~big].max()))
    stats["sum"] += float((diff * counts).sum())
    stats["pixels"] += int(counts.sum()) * 3
    # pixel-weighted: a basemap of many rare colours (hillshade, imagery) can shift a large
    # share of the page while every frequent colour is kept exactly
    stats["shifted"] += int(counts[diff > TIMESTEP_NOTICEABLE_SHIFT].sum())
    position = np.searchsorted(uniq, packed)
    out = Image.frombytes("P", (width, height), index[position].astype(np.uint8).tobytes())
    out.putpalette(_ts_palette_image(Image, palette).getpalette())
    return out


def timestep_pixels_per_frame(width, height, units, dpi):
    """Pixels of one exported frame from the layout page size, or None for unknown units."""
    inches = {"INCH": 1.0, "INCHES": 1.0, "IN": 1.0, "CENTIMETER": 1 / 2.54, "CENTIMETERS": 1 / 2.54,
              "CM": 1 / 2.54, "MILLIMETER": 1 / 25.4, "MILLIMETERS": 1 / 25.4, "MM": 1 / 25.4,
              "POINT": 1 / 72.0, "POINTS": 1 / 72.0, "PT": 1 / 72.0, "METER": 1 / 0.0254,
              "METERS": 1 / 0.0254, "FOOT": 12.0, "FEET": 12.0}.get(str(units or "").strip().upper())
    if inches is None or not width or not height:
        return None
    return int(round(float(width) * inches * dpi)) * int(round(float(height) * inches * dpi))


def timestep_check_memory(pixels, frames, dpi=None):
    """Refuse a frame size the GIF stitching cannot hold in memory; returns a warning or None.

    The stitching keeps one frame at a time (about ``TIMESTEP_BYTES_PER_PIXEL`` bytes per
    pixel at the peak: the RGB frame, its colour table, the mapped frame and Pillow's
    comparison with the previous frame)."""
    need = int(pixels) * TIMESTEP_BYTES_PER_PIXEL
    mb = need / (1024.0 * 1024.0)
    if need > TIMESTEP_MEMORY_REFUSE:
        raise ToolError(
            "One frame has {0:,} pixels, which needs about {1:,.0f} MB of memory while the GIF "
            "is written ({2} frames).".format(int(pixels), mb, frames),
            "Lower the Resolution{0} or use a smaller layout page. Frames this large are better "
            "kept as PNG files (Output Frames Folder) and stitched in a video editor.".format(
                "" if dpi is None else " (now {0} dpi)".format(dpi)))
    if need > TIMESTEP_MEMORY_WARN:
        return ("One frame has {0:,} pixels; writing the GIF needs about {1:,.0f} MB of memory "
                "(one frame at a time, estimate). Lower the Resolution if ArcGIS Pro becomes "
                "slow.".format(int(pixels), mb))
    return None


def timestep_stitch_gif(frame_paths, out_path, durations, loop=0, palette_mode="GLOBAL",
                        max_colours=TIMESTEP_MAX_COLOURS, dither=False):
    """Write an animated GIF from PNG frames; returns a dict of facts.

    ``durations`` is one value in milliseconds per frame (the last one is the hold). All
    frames must have the same pixel size. ``palette_mode`` GLOBAL builds one palette for the
    whole sequence (no colour flicker; exact when the sequence has at most ``max_colours``
    colours), PER_FRAME gives every frame its own palette (smaller colour error, colours may
    shift between frames). ``dither`` applies Floyd-Steinberg dithering only to frames whose
    colours do not fit the palette exactly, decided frame by frame in both modes (in GLOBAL
    mode a frame whose colours are all entries of the reduced sequence palette is mapped
    exactly); a frame that fits is never dithered
    (``dithered_frames`` in the facts says how many were). The tool's writer merges identical
    consecutive frames and adds their durations; ``stored_frames`` reports how many frames the
    file holds, and ``capped_delays`` lists ``(stored frame number, wanted ms)`` for each stored
    frame whose summed time is above the GIF maximum delay (655350 ms), which it is capped to. Frames are read two times, one at a time (histogram, then mapping), and each
    mapped frame is written to the file before the next is read (``_ts_write_gif_stream``),
    so memory does not grow with the number of frames. The GIF is written to a temporary file
    and moved into place when complete.
    """
    if not frame_paths:
        raise ToolError("There are no frames to stitch.", "Check the steps and the layout.")
    if len(durations) != len(frame_paths):
        raise ToolError("Internal error: durations and frames differ in number.")
    if palette_mode not in TIMESTEP_PALETTES:
        raise ToolError("Unknown palette mode '{0}'.".format(palette_mode),
                        "Use GLOBAL or PER_FRAME.")
    if not 2 <= int(max_colours) <= TIMESTEP_MAX_COLOURS:
        raise ToolError("Maximum colours must be from 2 to 256.", "Enter a value in that range.")
    max_colours = int(max_colours)
    Image = timestep_pillow()
    np = _ts_numpy()
    size = None
    for p in frame_paths:
        with Image.open(p) as probe:
            this = probe.size
        if size is None:
            size = this
            timestep_check_memory(size[0] * size[1], len(frame_paths))
        elif this != size:
            raise ToolError(
                "Frame '{0}' is {1} pixels but the first frame is {2}.".format(
                    os.path.basename(p), "x".join(str(v) for v in this),
                    "x".join(str(v) for v in size)),
                "All frames of one GIF must have the same size. Do not change the layout page "
                "size between frames.")
    dith = _ts_enum(Image, "Dither", "FLOYDSTEINBERG", "FLOYDSTEINBERG") if dither \
        else _ts_enum(Image, "Dither", "NONE", "NONE")
    facts = {"frames": len(frame_paths), "size": size, "palette_mode": palette_mode,
             "sequence_colours": None, "exact_palette": None, "palette_colours": None,
             "dithered_frames": 0, "capped_delays": [],
             "worst_colour_error": 0, "mean_colour_error": 0.0, "frequent_colours": False,
             "rare_colour_error": 0, "shifted_pixel_share": 0.0}
    stats = {"worst": 0, "sum": 0.0, "pixels": 0, "frequent": False, "worst_rare": 0,
             "shifted": 0}
    global_palette = None
    global_packed = None
    if palette_mode == "GLOBAL":
        total = None
        for p in frame_paths:
            image = _ts_load_rgb(Image, p)
            total = _ts_merge_histograms(np, total, _ts_histogram(np, image))
            del image
        global_palette, exact = _ts_build_palette(np, total, max_colours)
        facts["sequence_colours"] = int(len(total[0]))
        facts["exact_palette"] = exact
        facts["palette_colours"] = int(len(global_palette))
        global_packed = ((global_palette[:, 0].astype(np.uint32) << 16)
                         | (global_palette[:, 1].astype(np.uint32) << 8)
                         | global_palette[:, 2].astype(np.uint32))
        del total

    def mapped_frames():
        for p in frame_paths:
            image = _ts_load_rgb(Image, p)
            hist = _ts_histogram(np, image)
            if global_palette is not None:
                palette = global_palette
                # per frame: a frame whose own colours are all palette entries is mapped
                # exactly (never dithered), even when the sequence palette is reduced
                exact = facts["exact_palette"] or bool(np.isin(hist[0], global_packed).all())
            else:
                palette, exact = _ts_build_palette(np, hist, max_colours)
            if dither and not exact:
                facts["dithered_frames"] += 1
                pal_image = _ts_palette_image(Image, palette)
                yield image.quantize(palette=pal_image, dither=dith)
            else:
                yield _ts_map_frame(Image, np, image, palette, hist, stats)
            del image

    temp_path = out_path + ".tmp_timestep"
    try:
        with open(temp_path, "wb") as handle:
            facts["written_frames"] = _ts_write_gif_stream(
                handle, np, Image, mapped_frames(), durations, int(loop), size,
                capped=facts["capped_delays"])
        os.replace(temp_path, out_path)
    finally:
        if os.path.exists(temp_path):
            try:
                os.remove(temp_path)
            except OSError:
                pass
    facts["worst_colour_error"] = stats["worst"] if not facts["dithered_frames"] else None
    facts["mean_colour_error"] = ((stats["sum"] / stats["pixels"]) if stats["pixels"]
                                  and not facts["dithered_frames"] else None)
    # frequent_colours: some colour is used by TIMESTEP_SIGNIFICANT_PIXELS or more pixels of a
    # frame (worst_colour_error is the worst shift of those); rare_colour_error: the worst
    # shift of the other colours; shifted_pixel_share: the share of all mapped pixels whose
    # colour moved by more than TIMESTEP_NOTICEABLE_SHIFT. None when frames were dithered.
    measured = not facts["dithered_frames"]
    facts["frequent_colours"] = stats["frequent"] if measured else None
    facts["rare_colour_error"] = stats["worst_rare"] if measured else None
    facts["shifted_pixel_share"] = ((3.0 * stats["shifted"] / stats["pixels"])
                                    if measured and stats["pixels"] else None)
    with Image.open(out_path) as check:
        facts["stored_frames"] = getattr(check, "n_frames", 1)
        facts["loop"] = check.info.get("loop")
    facts["bytes"] = os.path.getsize(out_path)
    return facts


# ---- streaming GIF writer ---------------------------------------------------------------------
#
# Pillow's save(save_all=True, append_images=...) keeps every frame (1 byte per pixel) in a list
# until the whole file is written, also when the frames come from a generator (checked in the
# Pillow 10.2.0 source that ArcGIS Pro 3.3.2 ships, and in Pillow 12). So the file is written
# here, one frame at a time: Pillow encodes each frame alone (a one-frame GIF in memory), and its
# image data (LZW) and colour table are copied into the animated file, behind our own frame
# header (delay, disposal 1) and image position. A frame identical to the one before is not
# written; its time is added to that frame, as Pillow does. Only the changed rectangle of a
# frame is stored (disposal 1 leaves the previous frame in place), as Pillow does.

def _ts_gif_blocks(data, pos):
    """Position just after the data sub-blocks that start at ``pos`` (ending in a zero)."""
    while True:
        size = data[pos]
        pos += 1
        if size == 0:
            return pos
        pos += size


def _ts_gif_table_size(packed):
    return 3 * (2 << (packed & 7))


def _ts_parse_single_gif(data):
    """``(colour table bytes, interlace flag, image data)`` of a one-frame GIF written by
    Pillow; the image data runs from the LZW code size through the closing zero block."""
    if data[:6] not in (b"GIF87a", b"GIF89a"):
        raise ToolError("Internal error: Pillow did not write a GIF frame.", "Report this problem.")
    packed = data[10]
    pos = 13
    table = None
    if packed & 0x80:
        size = _ts_gif_table_size(packed)
        table = data[pos:pos + size]
        pos += size
    while pos < len(data):
        marker = data[pos]
        if marker == 0x21:                                   # extension: skip
            pos = _ts_gif_blocks(data, pos + 2)
        elif marker == 0x2C:                                 # the image
            flags = data[pos + 9]
            pos += 10
            if flags & 0x80:
                size = _ts_gif_table_size(flags)
                table = data[pos:pos + size]
                pos += size
            end = _ts_gif_blocks(data, pos + 1)
            if table is None:
                raise ToolError("Internal error: a GIF frame has no colour table.",
                                "Report this problem.")
            return bytes(table), flags & 0x40, bytes(data[pos:end])
        else:
            break
    raise ToolError("Internal error: Pillow wrote a GIF frame without an image.",
                    "Report this problem.")


def _ts_frame_rgb(np, frame):
    """A mapped ("P") frame as packed 24-bit colours (one uint32 per pixel), for comparing
    frames whose palettes may differ."""
    pal = np.frombuffer(bytes(frame.getpalette() or b""), dtype=np.uint8)
    if pal.size < 768:
        pal = np.concatenate([pal, np.zeros(768 - pal.size, dtype=np.uint8)])
    pal = pal[:768].reshape(256, 3).astype(np.uint32)
    lut = (pal[:, 0] << 16) | (pal[:, 1] << 8) | pal[:, 2]
    return lut[np.asarray(frame, dtype=np.uint8)]


def _ts_encode_frame(Image, frame, box):
    """``(table, interlace, data)`` of ``frame`` cropped to ``box`` (Pillow encodes it)."""
    import io
    part = frame if box == (0, 0) + frame.size else frame.crop(box)
    buf = io.BytesIO()
    part.save(buf, format="GIF", optimize=False)
    return _ts_parse_single_gif(buf.getvalue())


def _ts_write_gif_stream(handle, np, Image, frames, durations, loop, size, capped=None):
    """Write the mapped frames (an iterator of "P" images of ``size``) to ``handle`` as an
    animated GIF, holding one frame (and the colours of the previous one) at a time. Returns
    the number of frames stored. A stored frame whose time (with merged identical frames) is
    above the GIF maximum delay is capped to it, and ``(stored frame number, wanted ms)`` is
    appended to ``capped`` when a list is given."""
    width, height = size

    def u16(v):
        return struct.pack("<H", int(v))

    pending = None             # [table, interlace, data, box, duration ms] of the last frame
    previous = None
    global_table = None
    stored = 0

    def flush(item):
        table, interlace, data, box, ms, number = item
        if int(ms / 10) > 65535 and capped is not None:
            capped.append((number, int(ms)))
        delay = min(65535, int(ms / 10))
        handle.write(b"\x21\xf9\x04" + bytes([1 << 2]) + u16(delay) + b"\x00\x00")
        flags = interlace
        local = table != global_table
        if local:
            flags |= 0x80 | ((len(table) // 3).bit_length() - 2)
        handle.write(b"\x2c" + u16(box[0]) + u16(box[1]) + u16(box[2] - box[0])
                     + u16(box[3] - box[1]) + bytes([flags]))
        if local:
            handle.write(table)
        handle.write(data)

    for k, frame in enumerate(frames):
        if frame.size != (width, height):
            raise ToolError("Internal error: a mapped frame changed size.", "Report this problem.")
        current = _ts_frame_rgb(np, frame)
        if previous is None:
            box = (0, 0, width, height)
        else:
            rows = np.nonzero((current != previous).any(axis=1))[0]
            if not len(rows):
                pending[4] += int(durations[k])            # identical: hold the last frame
                continue
            cols = np.nonzero((current[rows[0]:rows[-1] + 1] != previous[rows[0]:rows[-1] + 1])
                              .any(axis=0))[0]
            box = (int(cols[0]), int(rows[0]), int(cols[-1]) + 1, int(rows[-1]) + 1)
        table, interlace, data = _ts_encode_frame(Image, frame, box)
        if global_table is None:
            global_table = table
            handle.write(b"GIF89a" + u16(width) + u16(height)
                         + bytes([0x80 | 0x70 | ((len(table) // 3).bit_length() - 2), 0, 0]))
            handle.write(global_table)
            handle.write(b"\x21\xff\x0bNETSCAPE2.0\x03\x01" + u16(loop) + b"\x00")
        if pending is not None:
            flush(pending)
        stored += 1
        pending = [table, interlace, data, box, int(durations[k]), stored]
        previous = current
        del frame
    if pending is not None:
        flush(pending)
    handle.write(b"\x3b")
    return stored


def timestep_durations(count, frame_ms, last_hold_ms):
    """Per-frame durations: ``frame_ms`` each, the last frame ``last_hold_ms``."""
    if count < 1:
        return []
    return [int(frame_ms)] * (count - 1) + [int(last_hold_ms)]


# --------------------------------------------------------------------------
# Settings check
# --------------------------------------------------------------------------

def timestep_check_settings(mode, frame_ms, last_hold_ms, loop_count, resolution, max_frames,
                            max_colours, palette_mode, language, window="SLIDING",
                            window_steps=1):
    """Raise ``ToolError`` for settings that cannot work; returns a list of warnings."""
    warnings = []
    if mode not in TIMESTEP_MODES:
        raise ToolError("Unknown mode '{0}'.".format(mode),
                        "Use one of: {0}.".format(", ".join(TIMESTEP_MODES)))
    if frame_ms < TIMESTEP_MIN_FRAME_MS or last_hold_ms < TIMESTEP_MIN_FRAME_MS:
        raise ToolError("Frame durations must be at least {0} ms (browsers show shorter "
                        "frames as 100 ms).".format(TIMESTEP_MIN_FRAME_MS),
                        "Enter 20 or more.")
    if frame_ms > 600000 or last_hold_ms > 600000:
        raise ToolError("Frame durations above 600000 ms (10 minutes) are not accepted.",
                        "Enter a smaller duration.")
    if loop_count < 0 or loop_count > 65535:
        raise ToolError("The loop count must be from 0 to 65535 (0 = repeat forever).",
                        "Enter a value in that range.")
    if resolution < 36 or resolution > 600:
        raise ToolError("The resolution must be from 36 to 600 dpi.", "Enter a value in that range.")
    if max_frames < 1 or max_frames > 5000:
        raise ToolError("Maximum frames must be from 1 to 5000.", "Enter a value in that range.")
    if not 2 <= max_colours <= TIMESTEP_MAX_COLOURS:
        raise ToolError("Maximum colours must be from 2 to 256.", "Enter a value in that range.")
    if palette_mode not in TIMESTEP_PALETTES:
        raise ToolError("Unknown palette mode '{0}'.".format(palette_mode),
                        "Use GLOBAL or PER_FRAME.")
    if language not in TIMESTEP_LANGUAGES:
        raise ToolError("Unknown label language '{0}'.".format(language), "Use EN or AR.")
    if mode == "BOOKMARKS" and (window != "SLIDING" or int(window_steps) != 1):
        warnings.append("The window settings do not apply to bookmarks; every frame shows one "
                        "bookmark.")
    return warnings


# ==========================================================================
# carto/book_index_tool.py
# ==========================================================================
# Map Book Index: a street/feature index (gazetteer) for a map book.

_BOOK_OUTPUTS = ("out_table", "out_unplaced", "out_per_page", "out_report")
_BOOK_NAME_GUESSES = ("name", "street_name", "full_name", "fullname", "feature_name", "name_en", "name_ar")


def _book_stop_if_cancelled():
    """End the run when the user has cancelled it (``execute`` sets ``autoCancelling`` to
    False, so a cancellation does not end the script by itself and the tool can still
    delete the outputs it has created)."""
    if arcpy.env.isCancelled:
        raise ToolError("The tool was cancelled.",
                        "No output was kept (outputs created so far were deleted). Run it again "
                        "when you are ready.")


class MapBookFeatureIndex(object):
    """Index of named features by map book page, with page ranges and grid references."""

    DOC = {
        "summary": "Builds the index (gazetteer) of a map book: for every named feature in one or "
                   "more layers, the pages it appears on as compact ranges such as \"1-3, 12\", "
                   "the grid cells per page, and the number of features with that name in that "
                   "layer that are on a page (one row per name and layer). Also lists named features that fall on "
                   "no page and, optionally, a de-duplicated table of chosen field values per "
                   "page. Read-only.",
        "usage": "Quick start: choose the Index Layer (the pages of the map series) and its "
                 "Page Name Field, add one or more Feature Layers, check the Name Field (it is "
                 "suggested from the first layer when that has a field called name) and give an "
                 "Output Index Table. Everything else is optional: a page number field, a grid "
                 "layer, a table of named features on no page, a table of values per page and an "
                 "Excel report.\n\n"
                 "NOT VERIFIED: use with a Basic licence, the Name Field suggestion in the "
                 "dialog and the Cancel button.\n\n"
                 "Notes. "
                 "Pages come from the index layer of a map series (Grid Index Features or Strip "
                 "Map Index Features); every page must be a single convex polygon (rectangles, "
                 "rotated or not). Other pages are refused with their ObjectIDs, grouped by "
                 "cause (concave, multipart, with holes). A page counts as convex when no vertex "
                 "lies deeper inside its convex hull than one millionth of the page size (at "
                 "least 0.5 mm, or 5e-9 degrees in a geographic index), so extra vertices on "
                 "straight edges and coordinates rounded to the geodatabase resolution are "
                 "accepted; the page is then used as its convex hull. Anything more concave is "
                 "refused: in particular a sheet bounded by meridians and parallels and stored "
                 "with densified edges in a projected system (a projected parallel is a curve), "
                 "however finely densified, and rotated pages whose extra vertices were moved "
                 "off the straight edge. Workaround: rebuild the pages as straight-edged "
                 "4-corner polygons (Grid Index Features or Strip Map Index Features), or keep "
                 "graticule sheets in a geographic index. Grid cells follow the same rule, and "
                 "one refused cell stops the run.\n\n"
                 "Assignment rule: a line or polygon is on a page only if it runs through the "
                 "page's interior (a road exactly along the edge between two pages is on "
                 "neither; a polygon touching a page along an edge is not on it. The run counts "
                 "such features among the unplaced ones, says so in a message and in the "
                 "report Summary, so you can see the size of the effect). A point is on "
                 "every page whose interior or boundary contains it, so a point on a shared edge "
                 "is listed on both pages. Grid cells use the same rule, within the part of each "
                 "cell that lies on the page, with one fallback: a feature that is on a page but "
                 "runs through no cell's interior there (a road exactly on an internal grid line) "
                 "is listed with the cells that meet it where it runs along the shared edge of "
                 "two cells, and a message counts such features. A feature in a part of the "
                 "page that no cell covers gets no cell there, even where it touches a cell "
                 "at an end or runs along the outer edge of the grid. The fallback applies only when the feature crosses no cell interior "
                 "on that page: a road that runs along a grid line and then dips a little into "
                 "one cell is listed with that cell only. Overlapping pages that each have their "
                 "own grid (strip maps; Strip Map Index Features overlaps pages by 10% by "
                 "default): one rule decides which page a cell belongs to: the cells a page "
                 "owns do not overlap each other. A cell can belong only to a page that holds "
                 "the largest part of it; where cells lie wholly in the overlap, a page is "
                 "ruled out when the cell overlaps a cell that page already owns, then a cell "
                 "goes to its one page that has no other cell of that label, then (only when "
                 "each page's cells are numbered one after the other) the cells between two "
                 "pages' ObjectIDs are split there so that no page owns two overlapping cells. "
                 "Page and cell centres are not used. On each page only that page's own cells "
                 "are used where a neighbouring page's cells reach into them, with a warning. "
                 "A cell that the rule cannot place (it coincides with a cell of a neighbouring "
                 "page, its label is unique and the ObjectIDs are not numbered page by page) "
                 "is used on every page it is on, with a warning that names it; cells that "
                 "overlap each other on a page "
                 "are listed with a warning to check the grid. A zero-length line or zero-area polygon "
                 "is on no page; it is counted separately, not as touching a page edge. A "
                 "self-intersecting polygon whose parts cancel out (a bow-tie, net area zero) "
                 "is also on no page and gets a warning to run Repair Geometry. Page and cell "
                 "labels that contain ',', ';' or ':' (or page labels such as 1-2) make PAGES "
                 "and GRID_REFS ambiguous and get a warning.\n\n"
                 "Features are grouped by layer and trimmed name, so a street split into many "
                 "segments gives one entry; FEATURE_COUNT is the number of features with that "
                 "name in that layer that are on a page (those on no page are not counted; "
                 "they are listed in the unplaced output). Canonically equivalent spellings (Unicode NFC, for "
                 "example u + combining diaeresis and the single letter \u00fc) are the same "
                 "name, shown as first met. Page lists are in natural order (2 before 10); runs "
                 "of two or more consecutive whole page numbers become ranges. Features without "
                 "a name are counted, not indexed, but they do appear in the per-page table. "
                 "A dataset given twice in Feature Layers (or two layers of one dataset with "
                 "overlapping definition queries) is read twice, so its features count twice; "
                 "the run warns when two feature layers read the same dataset. Nothing is "
                 "measured: all inputs are read in the index layer's own coordinate system "
                 "(degrees for a geographic index), so page edges stay exactly as stored; in a "
                 "geographic index 180 and -180 degrees are the same meridian, and in a Web "
                 "Mercator index x and x +- 40,075,016.69 m (one turn of the equator), so pages "
                 "drawn across the antimeridian work. Features in another coordinate system are "
                 "projected vertex by vertex into the index's system, so a long segment becomes "
                 "a straight chord there (this matters only for long segments close to a page "
                 "edge; densify such features first). A feature or grid layer with an unknown "
                 "coordinate system (read with its coordinates as they are) or on another datum "
                 "than the index (projected without a datum transformation) gets a warning. "
                 "True curves are densified.\n\n"
                 "Names and per-page values are cleaned before they are grouped: Unicode NFC, "
                 "control characters and invisible marks (left-to-right and right-to-left "
                 "marks, zero width space, byte order mark) removed, runs of spaces and line "
                 "breaks folded to one space, ends trimmed. \"Java Cafe\", \"Java  Cafe\" and a "
                 "copy with a hidden mark are one entry. Page names, page numbers and grid "
                 "cell labels are cleaned the same way, so a page \"5\" and a page \"5\" with "
                 "a hidden mark are one page label (the warning about page labels used by "
                 "more than one page names it), and two such cells are one cell in GRID_REFS. "
                 "The zero width joiner and non-joiner "
                 "are kept (they change Arabic and Persian letter shapes), but a name made only "
                 "of such marks and spaces counts as no name; case and Arabic "
                 "letter variants (alef forms, teh marbuta) are not unified. Entries sort by "
                 "code point, not by Arabic collation. In the per-page table a field whose "
                 "name the output already has (ObjectID, and Id or Field1 that ArcGIS Pro adds "
                 "to a shapefile or dBASE table) is renamed with a number and keeps its "
                 "original name as the alias; the run says so. Two feature layers with the "
                 "same layer name are listed under one LAYER value, with a warning. The "
                 "Cancel button is honoured between steps and after every 500 features: the "
                 "tool stops, deletes the outputs it created and reports that it was "
                 "cancelled.\n\n"
                 "Selections and definition queries on layer inputs are honoured. The inputs are "
                 "never modified. Existing outputs are replaced only when geoprocessing is "
                 "allowed to overwrite outputs. An output that is one of the inputs is refused. "
                 "Tables joined to an input layer are not known by their path (a layer reports "
                 "only its own table), so any output named like a table of a joined layer is "
                 "refused, in any workspace; still, never write an output over a joined table.",
        "params": {
            "index_layer": "Polygon layer of the map book pages (the map series index layer).",
            "page_name_field": "Field with the page name.",
            "page_number_field": "Optional field with the page number. When set, pages are "
                                 "listed by number (whole numbers compress to ranges); otherwise "
                                 "by name (names that are whole numbers compress too).",
            "feature_layers": "One or more layers of features to index (points, lines or "
                              "polygons).",
            "name_field": "Name of the field that holds the feature name. It is looked up in "
                          "every feature layer by exact name first (then the exact name "
                          "ignoring case), then by alias, then by a loose name match "
                          "(Unicode NFKC, ignoring case, spaces, dashes, underscores and the Arabic "
                          "tatweel). When empty, the first text "
                          "field of the first feature layer called name, street_name, full_name, "
                          "fullname, feature_name, name_en or name_ar is suggested.",
            "grid_layer": "Optional polygon layer of grid cells (for example A1, B1 ...). Cells "
                          "must be convex polygons (same rule as the pages). A cell may cover "
                          "several pages. Pages that no cell overlaps with an area, and pages "
                          "that the cells cover only in part, are named in a warning and "
                          "counted in the report Summary; a grid with no cell "
                          "on any page stops the run with an error. When pages overlap and "
                          "each has its own cells, each "
                          "page uses its own cells in the overlap (one rule: the cells a page "
                          "owns do not overlap each other; then the labels, then the "
                          "ObjectIDs decide).",
            "grid_label_field": "Field with the cell label. Required when a grid layer is set.",
            "per_page_fields": "Optional field names (looked up in each feature layer like the "
                               "name field) for the per-page table. Layers without all of them "
                               "are left out of that table with a warning.",
            "out_table": "Output gazetteer table: NAME, LAYER, PAGES, PAGE_COUNT, GRID_REFS "
                         "(page:cells, pages separated by '; '), FEATURE_COUNT (features with "
                         "that name in that layer that are on a page), sorted naturally by name, then layer. "
                         "A page with no page name (and no page number, when a number field is "
                         "set) is listed in PAGES as 'OID n' (its ObjectID), with a warning "
                         "that names those ObjectIDs.",
            "out_unplaced": "Optional output table of named features that are on no page: "
                            "LAYER, SRC_OID, NAME.",
            "out_per_page": "Optional output table with PAGE plus the per-page fields (as text), "
                            "one row per distinct combination, features without a name "
                            "included (a feature whose per-page values are all empty adds "
                            "no row). Requires Per-Page Fields.",
            "out_report": "Optional Excel (.xlsx) report: Summary (counts) and Detail (the "
                          "gazetteer). Two CSV files are written instead when .csv is chosen or "
                          "openpyxl is not available.",
        },
        "tags": ["map book", "map series", "index", "gazetteer", "street index", "grid"],
    }

    def __init__(self):
        self.label = "Map Book Index"
        self.description = ("Builds a map book index: the pages and grid cells each named "
                            "feature is on, as compact page ranges (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("index_layer", "Index Layer (Pages)", "GPFeatureLayer",
                       value_list=["Polygon"]),
            make_param("page_name_field", "Page Name Field", "Field", depends_on="index_layer"),
            make_param("page_number_field", "Page Number Field", "Field", required=False,
                       depends_on="index_layer",
                       value_list=["Short", "Long", "BigInteger", "Float", "Double", "Text"]),
            make_param("feature_layers", "Feature Layers", "GPFeatureLayer", multi_value=True),
            make_param("name_field", "Name Field", "GPString"),
            make_param("grid_layer", "Grid Layer", "GPFeatureLayer", required=False,
                       value_list=["Polygon"]),
            make_param("grid_label_field", "Grid Label Field", "Field", required=False,
                       depends_on="grid_layer"),
            make_param("per_page_fields", "Per-Page Fields", "GPString", required=False,
                       multi_value=True),
            make_param("out_table", "Output Index Table", "DETable", direction="Output"),
            make_param("out_unplaced", "Output Unplaced Features Table", "DETable",
                       direction="Output", required=False),
            make_param("out_per_page", "Output Per-Page Table", "DETable", direction="Output",
                       required=False),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        # Name Field is typed text. Suggest a value when the user has not typed one: the first
        # field of the first feature layer that is called like a name (never raises).
        try:
            p = param_map(parameters)
            layers = param_list(p["feature_layers"])
            if layers and not p["name_field"].altered and not param_text(p["name_field"]):
                names = [f.name for f in arcpy.ListFields(layers[0]) if f.type == "String"]
                for wanted in _BOOK_NAME_GUESSES:
                    for name in names:
                        if name.casefold() == wanted:
                            p["name_field"].value = name
                            return
        except Exception:
            return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        if param_text(p["grid_layer"]) and not param_text(p["grid_label_field"]):
            p["grid_label_field"].setErrorMessage("Choose the field with the grid cell labels.")
        fields = param_list(p["per_page_fields"])
        if fields and not param_text(p["out_per_page"]):
            p["out_per_page"].setErrorMessage(
                "Per-Page Fields are set: choose an output per-page table, or clear the fields.")
        if param_text(p["out_per_page"]) and not fields:
            p["per_page_fields"].setErrorMessage(
                "Choose at least one field for the per-page table, or clear its output.")
        if len(set(f.casefold() for f in fields)) != len(fields):
            p["per_page_fields"].setErrorMessage("A field is listed twice; list each field once.")
        pair = find_duplicate_outputs([param_text(p[n]) for n in _BOOK_OUTPUTS])
        if pair:
            dup = [n for n in _BOOK_OUTPUTS if param_text(p[n]) == pair[1]][-1]
            p[dup].setErrorMessage("This output is the same as another output; choose a "
                                   "different name.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        # Esri: with autoCancelling True (the default) a cancellation ends the script on the
        # current line and "there is no opportunity to run any code after the cancellation",
        # so a cancel while the outputs are written would leave them half-built. With False,
        # arcpy.env.isCancelled is set instead and _book_stop_if_cancelled() ends the run between
        # the steps, after the tool has deleted what it created.
        previous = arcpy.env.autoCancelling
        arcpy.env.autoCancelling = False
        try:
            self._run(p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            # An arcpy error (e.g. while writing): show what was collected (field
            # matches, coordinate system warnings) before the error itself.
            flush_messages(collector)
            raise
        finally:
            arcpy.env.autoCancelling = previous

    def _run(self, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        refuse_duplicate_outputs([param_text(p[n]) for n in _BOOK_OUTPUTS])

        index = describe_dataset(param_text(p["index_layer"]))
        if kind_from_shape_type(index["shape_type"]) != GEOM_POLYGON:
            raise ToolError("The index layer must contain polygons; it has {0} geometry.".format(
                index["shape_type"] or "no"), "Choose the polygon index layer of the map series.")
        inputs = [index["catalog_path"]]
        name_field, how = match_field(index["fields"], param_text(p["page_name_field"]),
                                      label="page name field", exact_name_first=True)
        collector.info(match_message(param_text(p["page_name_field"]), name_field, how))
        page_fields = [name_field["name"]]
        number_field = None
        if param_text(p["page_number_field"]):
            number_field, how = match_field(index["fields"], param_text(p["page_number_field"]),
                                            label="page number field", exact_name_first=True)
            collector.info(match_message(param_text(p["page_number_field"]), number_field, how))
            page_fields.append(number_field["name"])

        wanted_name = param_text(p["name_field"])
        extra = param_list(p["per_page_fields"])
        layers = []
        for text in param_list(p["feature_layers"]):
            desc = describe_dataset(text)
            kind = kind_from_shape_type(desc["shape_type"])
            if kind is None:
                raise ToolError("The feature layer '{0}' has no supported geometry ({1}).".format(
                    text, desc["shape_type"]), "Use point, multipoint, line or polygon layers.")
            label = input_label(text, desc["is_layer"], desc["name"])
            # An exact field name wins over another field that only carries it as alias.
            field, how = match_field(desc["fields"], wanted_name, required=False,
                                     label="name field", exact_name_first=True)
            if field is None:
                raise ToolError(
                    "Layer '{0}' has no field '{1}' (looked up by exact name, then alias, then a "
                    "loose name match: Unicode NFKC, ignoring case, spaces, dashes, underscores and the "
                    "Arabic tatweel).".format(
                        label, wanted_name),
                    "Give the name field the same name or alias in every feature layer, or "
                    "run the tool once per layer. Fields of '{0}': {1}.".format(
                        label, ", ".join(f["name"] for f in desc["fields"])))
            collector.info(match_message(wanted_name, field, how) + " ({0})".format(label))
            extra_names = []
            for wanted in extra:
                found, _how = match_field(desc["fields"], wanted, required=False,
                                          exact_name_first=True)
                if found is None:
                    extra_names = None
                    collector.warning(
                        "Layer '{0}' has no field '{1}', so it is left out of the per-page "
                        "table. Add the field or remove the layer.".format(label, wanted))
                    break
                extra_names.append(found["name"])
            layers.append({"desc": desc, "kind": kind, "label": label, "name": field["name"],
                           "extra": extra_names})
            inputs.append(desc["catalog_path"])
        if not layers:
            raise ToolError("No feature layer was given.", "Add one or more feature layers.")
        twice = same_dataset_pairs([layer["desc"]["catalog_path"] for layer in layers])
        if twice:
            collector.warning(
                "These feature layers read the same dataset, so features in both are counted "
                "twice in FEATURE_COUNT: {0}. Give each dataset once (or make their definition "
                "queries exclusive).".format("; ".join("'{0}' and '{1}'".format(
                    layers[i]["label"], layers[j]["label"]) for i, j in twice)))

        same_label = same_label_groups([layer["label"] for layer in layers], twice)
        if same_label:
            collector.warning(
                "These feature layers have the same name, so their features are listed "
                "together under one LAYER value in the index and the unplaced table: {0}. "
                "Rename one of them (Layer Properties, General) to keep them apart.".format(
                    "; ".join("'{0}' ({1} layers)".format(label, count)
                              for label, count in same_label)))

        grid = None
        if param_text(p["grid_layer"]):
            grid = describe_dataset(param_text(p["grid_layer"]))
            if kind_from_shape_type(grid["shape_type"]) != GEOM_POLYGON:
                raise ToolError("The grid layer must contain polygons.",
                                "Choose a polygon grid layer, or leave Grid Layer empty.")
            grid_field, how = match_field(grid["fields"], param_text(p["grid_label_field"]),
                                          label="grid label field", exact_name_first=True)
            collector.info(match_message(param_text(p["grid_label_field"]), grid_field, how))
            inputs.append(grid["catalog_path"])

        # Every output is checked before anything is read or written; tables joined to
        # an input layer are not in `inputs`, so outputs named like them are refused.
        joined = joined_table_names(index["fields"])
        for layer in layers:
            joined |= joined_table_names(layer["desc"]["fields"])
        if grid is not None:
            joined |= joined_table_names(grid["fields"])
        refuse_joined_table_outputs([param_text(p[n]) for n in ("out_table", "out_unplaced",
                                                                 "out_per_page")], joined)
        for name in ("out_table", "out_unplaced", "out_per_page"):
            if param_text(p[name]):
                check_output_path(param_text(p[name]), inputs)

        # Page assignment is topological, so it is done in the index layer's own
        # coordinate system: page edges stay exactly where they are (a parallel stays a
        # straight edge of a geographic index). Other layers are projected into it.
        read_sr = index["sr_object"]
        if (index["sr"] or {}).get("type") not in ("Projected", "Geographic"):
            collector.warning("The index layer has an unknown coordinate system, so all inputs "
                              "are read in their native coordinates and must already be in one "
                              "system. Define the coordinate system (Define Projection).")
            read_sr = None
        else:
            collector.info("Features are assigned to pages in the coordinate system of the "
                           "index layer ({0}).".format((index["sr"] or {}).get("name")))
            others = [(layer["desc"]["sr"], "The feature layer '{0}'".format(layer["label"]))
                      for layer in layers]
            if grid is not None:
                others.append((grid["sr"], "The grid layer '{0}'".format(input_label(
                    param_text(p["grid_layer"]), grid["is_layer"], grid["name"]))))
            further_layer_sr_warnings(index["sr"], others, collector)
        progress = Progress("Reading the pages", 0)
        pages = [{"oid": r["oid"], "shape": r["shape"], "name": r["attrs"][name_field["name"]],
                  "number": r["attrs"][number_field["name"]] if number_field else None}
                 for r in float32_rows(read_features(index["input"], page_fields, sr=read_sr),
                                       index["fields"])]
        _book_stop_if_cancelled()
        cells = None
        if grid is not None:
            progress.label("Reading the grid")
            cells = [{"oid": r["oid"], "shape": r["shape"],
                      "label": r["attrs"][grid_field["name"]]}
                     for r in float32_rows(read_features(grid["input"], [grid_field["name"]],
                                                        sr=read_sr), grid["fields"])]
        core_layers = []
        for layer in layers:
            progress.label("Reading {0}".format(layer["label"]))
            names = [layer["name"]] + [n for n in (layer["extra"] or []) if n != layer["name"]]
            rows = float32_rows(read_features(layer["desc"]["input"], names, sr=read_sr),
                                layer["desc"]["fields"])
            _book_stop_if_cancelled()
            core_layers.append({"layer": layer["label"], "kind": layer["kind"], "rows": [
                {"oid": r["oid"], "shape": r["shape"], "name": r["attrs"][layer["name"]],
                 "values": None if layer["extra"] is None else
                 [r["attrs"][n] for n in layer["extra"]]} for r in rows]})
        progress.label("Assigning features to pages")
        result = index_features(pages, core_layers, cells, use_number=number_field is not None,
                                per_page_fields=extra or None,
                                wrap=x_period(index["sr"]),
                                page_floor=convex_floor(index["sr"]),
                                should_stop=_book_stop_if_cancelled)
        collector.extend(result["messages"])
        gazetteer = [gazetteer_tuple(r) for r in result["gazetteer"]]

        # Plan every output schema (names, dBASE widths) before the first output is created.
        jobs = [(param_text(p["out_table"]), [
            {"name": "NAME", "type": "TEXT", "values": [g[0] for g in gazetteer]},
            {"name": "LAYER", "type": "TEXT", "values": [g[1] for g in gazetteer]},
            {"name": "PAGES", "type": "TEXT", "values": [g[2] for g in gazetteer]},
            {"name": "PAGE_COUNT", "type": "SHORT"},
            {"name": "GRID_REFS", "type": "TEXT", "values": [g[4] for g in gazetteer]},
            {"name": "FEATURE_COUNT", "type": "LONG"}], gazetteer, "Index")]
        if param_text(p["out_unplaced"]):
            rows = [unplaced_tuple(r) for r in result["unplaced"]]
            # SRC_OID: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``)
            oid_spec = oid_output_field(param_text(p["out_unplaced"]), [r[1] for r in rows],
                                        collector)
            rows = [(r[0], oid_field_value(oid_spec, r[1])) + tuple(r[2:]) for r in rows]
            jobs.append((param_text(p["out_unplaced"]), [
                {"name": "LAYER", "type": "TEXT", "values": [r[0] for r in rows]},
                oid_spec,
                {"name": "NAME", "type": "TEXT", "values": [r[2] for r in rows]}], rows,
                "Unplaced features"))
        if param_text(p["out_per_page"]):
            rows = result["per_page"]
            out = param_text(p["out_per_page"])
            workspace = split_catalog_path(out)[0]
            columns = unique_field_names(extra, ["PAGE"] + system_field_names(
                is_folder_workspace(workspace)), lambda n: arcpy.ValidateFieldName(n, workspace))
            renamed = [(a, b) for a, b in zip(extra, columns) if a != b]
            if renamed:
                collector.info("Per-page columns renamed to stay unique: {0}.".format(
                    ", ".join("{0} -> {1}".format(a, b) for a, b in renamed)))
            specs = [{"name": "PAGE", "type": "TEXT", "values": [r[0] for r in rows]}]
            for i, column in enumerate(columns):
                specs.append({"name": column, "type": "TEXT", "alias": extra[i],
                              "values": [r[i + 1] for r in rows]})
            jobs.append((out, specs, rows, "Per-page table"))
        for out, specs, _rows, _what in jobs:
            mapping = plan_field_names(specs, split_catalog_path(out)[0])
            cut = [(a, b) for a, b in mapping.items() if a != b]
            if cut:
                collector.info("Field names in {0} are written as: {1}.".format(
                    out, ", ".join("{0} -> {1}".format(a, b) for a, b in cut)))
            if is_folder_workspace(split_catalog_path(out)[0]):
                beyond = sum(count_beyond_bmp(spec.get("values") or ()) for spec in specs if spec["type"] == "TEXT")
                if beyond:
                    collector.warning(
                        "{0} text value(s) written to {1} hold characters above U+FFFF (for example mathematical "
                        "letters or emoji). ArcGIS Pro stores them in a dBASE table as two 3-byte halves, which other "
                        "software shows as garbled text and Pro may read back changed. Write the output to a file "
                        "geodatabase or a GeoPackage to keep them.".format(beyond, out))

        progress.label("Writing the outputs")
        created, zero_notes = [], []
        try:
            for out, specs, rows, what in jobs:
                _book_stop_if_cancelled()
                table, names = create_table(out, specs, inputs=inputs)
                created.append(table)
                nulls = set()
                insert_rows(table, [names[s["name"]] for s in specs], rows, null_fields=nulls)
                _book_stop_if_cancelled()
                text = folder_null_number_warning(table, specs, names, nulls)
                if text:
                    zero_notes.append(text)
                collector.info("{0} written to {1} ({2} row(s)).".format(what, table, len(rows)))
        except Exception:
            for path in created:  # never leave part of the outputs behind
                try:
                    safe_delete(path, inputs)
                except Exception:
                    pass
            raise
        for text in zero_notes:
            collector.warning(text)
        progress.close()

        counts = result["counts"]
        no_cell = counts.get("pages_without_cells")
        summary = [("Index layer", index["catalog_path"]), ("Pages", counts["pages"]),
                   ("Pages with no grid cell", "no grid layer" if no_cell is None else no_cell),
                   ("Pages only partly covered by grid cells",
                    "no grid layer" if no_cell is None else counts["pages_part_cells"]),
                   ("Feature layers", ", ".join(layer["label"] for layer in layers)),
                   ("Features read", counts["features"]), ("Features indexed", counts["indexed"]),
                   ("Features without a name", counts["unnamed"]),
                   ("Named features on no page", counts["unplaced"]),
                   ("  of which only touch a page edge", counts["touching"]),
                   ("  of which have zero length or zero area", counts["degenerate"]),
                   ("  of which are self-intersecting polygons (net area zero)",
                    counts["self_intersecting"]),
                   ("Features listed with the grid cells they touch (on a grid line)",
                    counts["cell_fallback"]),
                   ("Polygons with a zero-width spike (left out where only the spike reaches)",
                    counts["spiked"]),
                   ("Index entries (names)", counts["names"])]
        for path in write_report(report, summary, BOOK_GAZETTEER_HEADER, gazetteer):
            collector.info("Report written to {0}.".format(path))
        flush_messages(collector)


# ==========================================================================
# carto/series_integrity_tool.py
# ==========================================================================
# Map Series Index Check: pre-flight checks of a map series index layer.

_SERIES_OUTPUTS = ("out_table", "out_plan", "out_ranges", "out_report")


def _series_active_outputs(plan):
    """The outputs this run writes: Output Page Plan only with Plan Pages."""
    return tuple(n for n in _SERIES_OUTPUTS if n != "out_plan" or plan)


_SERIES_PLAN_PARAMS = ("frame_width_m", "frame_height_m", "margin_pct", "standard_scales",
                       "out_plan")


def _series_stop_if_cancelled():
    """End the run when the user has cancelled it (``execute`` sets ``autoCancelling`` to
    False, so a cancellation does not end the script by itself and the tool can still
    delete the outputs it has created)."""
    if arcpy.env.isCancelled:
        raise ToolError("The tool was cancelled.",
                        "No output was kept (outputs created so far were deleted). Run it again "
                        "when you are ready.")


# Pages rotated by at least this many degrees against the measuring grid get a warning.
SERIES_ROTATED_WARNING_DEG = 1.0

# A projected index kept in its own system is measured in its map units only while every
# page's size in map units (times metres per unit) is within this fraction of its size on
# the ground (each page on its own Transverse Mercator); otherwise every page is measured
# on the ground (map units are +9 % in Equal Earth, +15 % in Mollweide at 60N).
SERIES_GROUND_REL_TOL = 0.01

# A frame side above this many metres is larger than any paper sheet (A0 is 1.189 m):
# most likely centimetres or millimetres typed as metres.
SERIES_FRAME_MAX_M = 2.0


def _series_frame_unit_warning(width, height):
    """Warning text when a frame side looks like centimetres or millimetres, else ``""``."""
    big = [v for v in (width, height) if v is not None and v > SERIES_FRAME_MAX_M]
    if not big:
        return ""
    return ("The map frame is {0:g} x {1:g} metres on paper, larger than any paper sheet "
            "(A0 is 1.189 m long). Frame Width and Frame Height are in metres: 25 cm is 0.25 "
            "and 180 mm is 0.18. Values typed in centimetres give a SCALE 100 times too "
            "small.".format(width, height))


def _series_size_ratio(own, ground, mpu):
    """Largest relative difference between a page's plan rectangle in its own map units
    (``own``, times ``mpu``) and on the ground (``ground``); ``None`` if either is
    missing or has no area."""
    if own is None or ground is None or not _series_has_area(own) or \
            not _series_has_area(ground):
        return None
    # Long side with long side: the rectangles may be normalised to different sides when
    # the grid convergence turns a page across 45 degrees.
    own_sides = sorted((own[0] * mpu, own[1] * mpu))
    ground_sides = sorted((ground[0], ground[1]))
    return max(abs(o / g - 1.0) for o, g in zip(own_sides, ground_sides))


def _series_ground_sr(sr_object):
    """Geographic system to read a projected index in: its own GCS, else WGS 84."""
    try:
        gcs = sr_object.GCS
        if gcs is not None and gcs.type == "Geographic":
            return gcs
    except (AttributeError, RuntimeError, ValueError):
        pass
    return arcpy.SpatialReference(WGS84_GCS_WKID)


# Field types that can hold a neighbour's page name or number (detection only).
SERIES_ADJACENCY_TYPES = ("String", "SmallInteger", "Integer", "BigInteger")


def _series_adjacency_rows(param):
    """``[(direction, field name)]`` from the value table (directions upper-cased)."""
    rows = []
    for row in param_value_table(param, 2):
        rows.append(((row[0] or "").strip().upper(), (row[1] or "").strip()))
    return rows


def _series_plan_container_check(out_plan, index):
    """Refuse an Output Page Plan inside a feature dataset whose coordinate system
    differs from the index layer's: the new feature class would take the feature
    dataset's system while the page geometry is in the index's system."""
    container = split_catalog_path(out_plan)[0]
    if not container or is_folder_workspace(container) or not arcpy.Exists(container):
        return
    desc = arcpy.da.Describe(container)
    if desc["dataType"] != "FeatureDataset":
        return
    sr = sr_info(desc["spatialReference"]) if "spatialReference" in desc else None
    if not same_coordinate_system(sr, index["sr"]):
        raise ToolError(
            "Output Page Plan is in the feature dataset '{0}', whose coordinate system ({1}) "
            "differs from the index layer's ({2}); the page plan keeps the index's "
            "geometry.".format(container, (sr or {}).get("name") or "unknown",
                               (index["sr"] or {}).get("name") or "unknown"),
            "Write the page plan to the geodatabase itself (outside any feature dataset) or "
            "to a feature dataset in the index layer's coordinate system.")


# Types of an index field whose values adjacency fields named after it can hold (R14-1).
SERIES_KEY_TYPES = SERIES_ADJACENCY_TYPES + ("Single", "Double")


def _series_adjacency_refers(adjacency, name_field, number_field, fields=()):
    """``(refers, key field)``: ``("name", None)`` or ``("number", None)`` when every
    adjacency field is named ``<page name field>_<direction>`` or ``<page number
    field>_<direction>`` (as Calculate Adjacent Fields names them); ``("field", field)``
    when they are all named after another field of ``fields`` (text or number), e.g.
    ``PageNumber_E`` with no Page Number Field chosen (R14-1: comparing such values with
    the page names reported every link of a correct series); else ``(None, None)``
    (decided from the values)."""
    prefixes = set(f.rsplit("_", 1)[0].casefold() for f in adjacency.values() if "_" in f)
    if len(prefixes) != 1 or len(adjacency) != sum(1 for f in adjacency.values() if "_" in f):
        return None, None
    prefix = prefixes.pop()
    if prefix == name_field["name"].casefold():
        return "name", None
    if number_field and prefix == number_field["name"].casefold():
        return "number", None
    used = set(f.casefold() for f in adjacency.values())
    for field in fields:
        if field["name"].casefold() == prefix and field.get("type") in SERIES_KEY_TYPES and \
                field["name"].casefold() not in used:
            return "field", field
    return None, None


SERIES_CUT_MARK = " ...[cut]"
_SERIES_LONE_SURROGATE = re.compile(u"[\ud800-\udfff]")


def _series_mend_surrogates(rows, collector):
    """Issue rows whose text holds no lone surrogate (half of a character above U+FFFF, which
    a cut dBASE value can leave in a page name): UTF-8 (dBASE, the Excel report) cannot encode
    one, so each is written as U+FFFD, and one warning counts the values. The checks
    themselves ran on the names as read."""
    count = [0]

    def mend(value):
        if isinstance(value, str) and _SERIES_LONE_SURROGATE.search(value):
            count[0] += 1
            return _SERIES_LONE_SURROGATE.sub(u"\ufffd", value)
        return value
    out = [tuple(mend(v) for v in r) for r in rows]
    if count[0]:
        collector.warning(
            "{0} text value(s) of the issue table hold half of a character above U+FFFF (a lone "
            "surrogate, for example an emoji cut in two); they are written with the replacement "
            "character U+FFFD. Check those page names in the index layer.".format(count[0]))
    return out



def _series_folder_rows(rows, out_table, collector):
    """Issue rows as a dBASE table in a folder can hold them: PAGE_NAME, DETAIL and LAYER
    longer than 254 bytes (UTF-8, as Pro writes dBASE text; an Arabic letter takes 2) are cut
    at a letter boundary and end with " ...[cut]", and a warning counts them. Without the cut
    a long DETAIL (for example a NON_RECIPROCAL row between pages with long Arabic names)
    made the whole run refuse. Outside a folder, and in the Excel report, nothing is cut."""
    if not out_table or not is_folder_workspace(split_catalog_path(out_table)[0]):
        return rows
    cut = [0]
    out = [(r[0], cut_utf8_bytes(r[1], True, cut, SERIES_CUT_MARK), r[2], r[3],
            cut_utf8_bytes(r[4], True, cut, SERIES_CUT_MARK),
            cut_utf8_bytes(r[5], True, cut, SERIES_CUT_MARK)) + tuple(r[6:]) for r in rows]
    if cut[0]:
        collector.warning(
            "{0} text value(s) of the issue table were longer than the 254 bytes a dBASE "
            "table in a folder holds (UTF-8; an Arabic letter takes 2 bytes) and were cut, "
            "ending with '{1}'. The Excel report keeps them whole; or write the issue table "
            "to a file geodatabase or a GeoPackage.".format(cut[0], SERIES_CUT_MARK.strip()))
    return out


def _series_adjacency_mapping(rows, fields, collector):
    """``{direction: field name}`` for the typed Adjacency Fields rows.

    A typed text that is exactly the name of a field (then the name ignoring case) is
    that field, even when another field carries the same text as its alias (an older
    copy ``OLD_E`` with alias ``ADJ_E`` must not stand in for the field ``ADJ_E``).
    Only a text that names no field exactly is looked up by alias, then by name
    ignoring case, spaces, dashes and underscores (``common.fields.match_field``)."""
    adjacency = {}
    for direction, wanted in rows:
        if direction not in SERIES_DIRECTIONS:
            raise ToolError("Unknown adjacency direction '{0}'.".format(direction),
                            "Use N, NE, E, SE, S, SW, W or NW.")
        field, how = match_field(fields, wanted, label="adjacency field", exact_name_first=True)
        collector.info(match_message(wanted, field, how))
        adjacency[direction] = field["name"]
    return adjacency


# A page whose smallest rectangle is narrower than this fraction of its length has no
# area (a collapsed polygon); it is not planned.
SERIES_NO_AREA_REL = 1e-9


def _series_has_area(rect):
    """True if the plan rectangle ``(width, height, rotation)`` has an area."""
    longest = max(rect[0], rect[1])
    return longest > 0.0 and min(rect[0], rect[1]) > SERIES_NO_AREA_REL * longest


def _series_data_labels(data):
    """LAYER value of each Data Layers entry (``[(describe dict, kind, label)]``): its
    label, but the catalog path of its dataset when two entries reading different
    datasets would carry the same label (``roads`` from two geodatabases), so that LAYER
    and SRC_OID always name one feature."""
    datasets = {}
    for desc, _kind, label in data:
        datasets.setdefault(label.casefold(), set()).add(dataset_identity(desc["catalog_path"]))
    return [desc["catalog_path"] if len(datasets[label.casefold()]) > 1 else label
            for desc, _kind, label in data]


def _series_repeated_data_layer(texts):
    """Index of the first Data Layers entry equal to an earlier one (case and
    surrounding spaces ignored), else ``None``."""
    seen = set()
    for i, text in enumerate(texts):
        key = (text or "").strip().casefold()
        if key and key in seen:
            return i
        seen.add(key)
    return None


class MapSeriesIndexIntegrity(object):
    """Checks page names, numbers, coverage and adjacency of a map series index layer."""

    DOC = {
        "summary": "Checks the index layer of a map series before export: page names that are "
                   "missing, duplicated or unusable as file names, duplicated or missing page "
                   "numbers, pages with no data and data on no page, and adjacency fields "
                   "(N, NE ... NW) that point to missing pages or are not returned by the "
                   "neighbour. Optionally proposes page orientation and a standard scale per "
                   "page, and lists page ranges per group (for example per district). Read-only.",
        "usage": "Quick start: choose the Index Layer (the pages of the map series), its Page "
                 "Name Field and an Output Issue Table. Add the Page Number Field to check "
                 "numbers and the Data Layers to find empty pages and data on no page. "
                 "Neighbour fields named like PageName_N ... PageName_NW (as Calculate Adjacent "
                 "Fields writes them) are found by themselves. The page plan, the page ranges "
                 "and the Excel report are optional. Read-only: the inputs are never modified.\n\n"
                 "Licence: the Basic licence is NOT VERIFIED. Outputs in an "
                 "enterprise geodatabase need a Standard licence (Esri licence levels: creating "
                 "tables or feature classes there is Standard); at Basic write to a file "
                 "geodatabase, a GeoPackage or a folder.\n\n"
                 "Names: DUPLICATE_NAME compares names as Windows compares file names (case "
                 "ignored, trailing spaces dropped; a leading space or a no-break space is kept). "
                 "ILLEGAL_NAME: < > : \" / \\ | ? *, control characters (codes 1-31), a trailing dot or "
                 "space, "
                 "more than 255 characters, or a reserved device name (CON, PRN, AUX, NUL, "
                 "COM1-9, LPT1-9, also with an extension; a no-break space after it makes a "
                 "legal name). In a folder (dBASE) issue table, text over 254 bytes is cut and "
                 "ends with ...[cut] (the Excel report keeps it whole).\n\n"
                 "Numbers: duplicates, pages without a number and every whole number missing "
                 "between the smallest and the largest (switch Check for Gaps in Page Numbers off "
                 "for a series that skips numbers on purpose). Numbers compare by value (\"3\", 3 "
                 "and 3.0 are the same); text page numbers compare trimmed and ignoring case "
                 "(\"1a\" and \"1A\" are DUPLICATE_NUMBER).\n\n"
                 "Coverage: a line or polygon counts on a page only if it runs through the page's "
                 "interior (a road exactly on a page edge is OUTSIDE_ALL_PAGES, and the detail "
                 "says so); a point counts on the boundary too; a multipoint counts if any of its "
                 "points is on a page. Pages must be single convex polygons (rectangles).\n\n"
                 "Adjacency: if page X has E = Y, page Y must exist once (else MISSING_NEIGHBOUR) "
                 "and Y's W field must point back to X (else NON_RECIPROCAL). Values refer to page "
                 "names, or to page numbers when a page number field is set and the fields or "
                 "values say so, or to another index field the fields are named after "
                 "(PageNumber_E; a message tells which). A value 0 that matches no page means "
                 "no neighbour (a numeric field cannot be empty in a dBASE table).\n\n"
                 "Selections and definition queries are honoured; with a selection on the index "
                 "layer only the selected pages get rows. A page outside the selection that is "
                 "not convex is left out of the coverage check (a message lists it); a data "
                 "feature on none of the checked pages but within the outline of such a page is "
                 "OUTSIDE_ALL_PAGES with a DETAIL naming that page (it may be on it), with a "
                 "warning. The page plan, the measuring systems, "
                 "folder (dBASE) outputs and every limit are described on the tool's page "
                 "docs/tools/MapSeriesIndexIntegrity.md.",
        "params": {
            "index_layer": "Polygon index layer of the map series.",
            "page_name_field": "Field with the page name.",
            "page_number_field": "Optional field with the page number. Enables the number "
                                 "checks; adjacency values may then refer to page numbers "
                                 "(see the usage).",
            "check_number_gaps": "Report every whole number missing between the smallest and the "
                                 "largest page number (default on). Turn it off for a series "
                                 "that skips numbers on purpose; duplicate numbers and pages "
                                 "without a number are still reported. Needs a Page Number Field.",
            "data_layers": "Optional layers whose features must be covered by the pages "
                           "(EMPTY_PAGE for a page with no data feature, OUTSIDE_ALL_PAGES). A "
                           "page with no geometry is EMPTY_PAGE also without Data Layers. Each "
                           "feature is checked "
                           "once: a layer listed twice, or next to its data source, gives one "
                           "row per feature (a warning says so).",
            "adjacency_fields": "Optional table of Direction (N, NE, E, SE, S, SW, W, NW) and "
                                "the field holding the neighbour in that direction. Leave empty "
                                "to detect text or integer fields named <prefix>_N ... <prefix>_NW "
                                "(a prefix needs at least one opposite pair, e.g. _N and _S). "
                                "A typed exact field name always means that field; other text "
                                "is looked up by alias, then by name.",
            "plan_pages": "Propose orientation and scale per page (writes Output Page Plan).",
            "frame_width_m": "Width of the layout map frame on paper, in metres (e.g. 0.25; "
                             "a side above 2 m gets a warning: 25 cm is 0.25).",
            "frame_height_m": "Height of the layout map frame on paper, in metres (e.g. 0.18). "
                              "Width and height may be given in either order; both orientations "
                              "are tried.",
            "margin_pct": "Margin kept free inside the frame, in percent of the frame "
                          "(default 10).",
            "standard_scales": "Scale denominators to choose from, separated by semicolons "
                               "(e.g. 1250;2500;5000). Whole numbers only (SCALE is a whole "
                               "number), written without a thousands separator: 1250.5, 1,250 "
                               "or 1 500 is refused. The run lists the scales it used.",
            "group_field": "Optional index field (for example DISTRICT) for the page-range "
                           "table. Groups show the stored values (codes for a coded-value "
                           "domain).",
            "out_table": "Output issue table: PAGE_OID, PAGE_NAME, PAGE_NUMBER, ISSUE, DETAIL, "
                         "LAYER, SRC_OID. One row per page (or data feature, or missing number) "
                         "and issue. In a dBASE table (folder output) empty numbers are "
                         "stored as 0; the run then says so.",
            "out_plan": "Output copy of the pages with PAGE_OID, their attributes, ORIENT "
                        "(PORTRAIT/LANDSCAPE), SCALE_NEEDED, SCALE and ROTATION (degrees "
                        "counterclockwise from grid east of the measuring system). Required "
                        "with Plan Pages. Not in a feature dataset with another coordinate "
                        "system than the index layer.",
            "out_ranges": "Output table GROUP_NAME, PAGES (for example \"1-2, 5\") per value of the "
                          "group field. Required with a group field.",
            "out_report": "Optional Excel (.xlsx) report: Summary (counts per issue; with Plan "
                          "Pages also the pages planned with a SCALE, with no fitting standard "
                          "scale and not planned) and Detail (the issues). Two CSV files are written instead when .csv is chosen "
                          "or openpyxl is not available.",
        },
        "tags": ["map series", "map book", "index", "QA", "page names", "adjacency"],
    }

    def __init__(self):
        self.label = "Map Series Index Check"
        self.description = ("Checks a map series index layer: page names, numbers, coverage and "
                            "adjacency fields; optional page plan and ranges (v" + __version__ +
                            ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        adjacency = make_param("adjacency_fields", "Adjacency Fields", "GPValueTable",
                               required=False)
        adjacency.columns = [["GPString", "Direction"], ["GPString", "Field"]]
        adjacency.filters[0].type = "ValueList"
        adjacency.filters[0].list = list(SERIES_DIRECTIONS)
        return [
            make_param("index_layer", "Index Layer (Pages)", "GPFeatureLayer",
                       value_list=["Polygon"]),
            make_param("page_name_field", "Page Name Field", "Field", depends_on="index_layer"),
            make_param("page_number_field", "Page Number Field", "Field", required=False,
                       depends_on="index_layer",
                       value_list=["Short", "Long", "BigInteger", "Float", "Double", "Text"]),
            make_param("check_number_gaps", "Check for Gaps in Page Numbers", "GPBoolean",
                       required=False, default=True),
            make_param("data_layers", "Data Layers", "GPFeatureLayer", required=False,
                       multi_value=True),
            adjacency,
            make_param("plan_pages", "Plan Page Orientation and Scale", "GPBoolean",
                       required=False, default=False),
            make_param("frame_width_m", "Frame Width (meters on paper)", "GPDouble",
                       required=False, category="Page Plan"),
            make_param("frame_height_m", "Frame Height (meters on paper)", "GPDouble",
                       required=False, category="Page Plan"),
            make_param("margin_pct", "Margin (percent)", "GPDouble", required=False, default=10,
                       category="Page Plan"),
            make_param("standard_scales", "Standard Scales", "GPString", required=False,
                       default=SERIES_DEFAULT_SCALES, category="Page Plan"),
            make_param("group_field", "Group Field", "Field", required=False,
                       depends_on="index_layer"),
            make_param("out_table", "Output Issue Table", "DETable", direction="Output"),
            make_param("out_plan", "Output Page Plan", "DEFeatureClass", direction="Output",
                       required=False, category="Page Plan"),
            make_param("out_ranges", "Output Page Ranges Table", "DETable", direction="Output",
                       required=False),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        p = param_map(parameters)
        plan = param_bool(p["plan_pages"], False)
        for name in _SERIES_PLAN_PARAMS:
            p[name].enabled = plan
        p["check_number_gaps"].enabled = bool(param_text(p["page_number_field"]))
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        if param_bool(p["plan_pages"], False):
            for name in ("frame_width_m", "frame_height_m"):
                value = p[name].value
                if value is None or value == "":
                    p[name].setErrorMessage("Required to plan pages: the map frame size on "
                                            "paper in metres (for example 0.25 x 0.18).")
                elif float(value) <= 0:
                    p[name].setErrorMessage("The frame size must be greater than zero.")
                elif float(value) > SERIES_FRAME_MAX_M:
                    p[name].setWarningMessage(
                        "Larger than any paper sheet: this size is in metres (25 cm is "
                        "0.25, 180 mm is 0.18).")
            margin = p["margin_pct"].value
            if margin is not None and margin != "" and not 0 <= float(margin) < 100:
                p["margin_pct"].setErrorMessage("The margin must be from 0 to less than 100.")
            try:
                parse_scales(param_text(p["standard_scales"]) or SERIES_DEFAULT_SCALES)
            except ToolError as err:
                p["standard_scales"].setErrorMessage(str(err))
            if not param_text(p["out_plan"]):
                p["out_plan"].setErrorMessage("Choose the output page plan feature class, or "
                                              "uncheck Plan Page Orientation and Scale.")
        if param_text(p["group_field"]) and not param_text(p["out_ranges"]):
            p["out_ranges"].setErrorMessage("A group field is set: choose an output page "
                                            "ranges table, or clear the group field.")
        if param_text(p["out_ranges"]) and not param_text(p["group_field"]):
            p["group_field"].setErrorMessage("Choose the field that groups the pages, or clear "
                                             "the output page ranges table.")
        if p["adjacency_fields"].values:
            rows = _series_adjacency_rows(p["adjacency_fields"])
            dirs = [d for d, _f in rows]
            bad = [d for d in dirs if d not in SERIES_DIRECTIONS]
            if bad:
                p["adjacency_fields"].setErrorMessage(
                    "Unknown direction(s): {0}. Use N, NE, E, SE, S, SW, W or NW.".format(
                        ", ".join(d or "(empty)" for d in bad)))
            elif len(set(dirs)) != len(dirs):
                p["adjacency_fields"].setErrorMessage("A direction is listed twice.")
            elif any(not f for _d, f in rows):
                p["adjacency_fields"].setErrorMessage("Every direction needs a field.")
        repeated = _series_repeated_data_layer(param_list(p["data_layers"]))
        if repeated is not None:
            p["data_layers"].setWarningMessage(
                "'{0}' is listed more than once in Data Layers. Each feature is checked and "
                "reported once; remove the repeated entry.".format(
                    param_list(p["data_layers"])[repeated]))
        # A disabled Output Page Plan (Plan Pages off) is not written, so it is not compared.
        active = _series_active_outputs(param_bool(p["plan_pages"], False))
        pair = find_duplicate_outputs([param_text(p[n]) for n in active])
        if pair:
            dup = [n for n in active if param_text(p[n]) == pair[1]][-1]
            p[dup].setErrorMessage("This output is the same as another output; choose a "
                                   "different name.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        # Esri: with autoCancelling True (the default) a cancellation ends the script on the
        # current line and "there is no opportunity to run any code after the cancellation",
        # so a cancel while the outputs are written would leave them half-built. With False,
        # arcpy.env.isCancelled is set instead and _series_stop_if_cancelled() ends the run between
        # the steps, after the tool has deleted what it created.
        previous = arcpy.env.autoCancelling
        arcpy.env.autoCancelling = False
        try:
            self._run(p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            # An arcpy error (e.g. while writing): show what was collected (field
            # matches, coordinate system warnings) before the error itself.
            flush_messages(collector)
            raise
        finally:
            arcpy.env.autoCancelling = previous

    def _match(self, fields, wanted, label, collector):
        # Values of Field parameters are names picked from a list: the exact name wins.
        field, how = match_field(fields, wanted, label=label, exact_name_first=True)
        collector.info(match_message(wanted, field, how))
        return field

    def _run(self, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        plan = param_bool(p["plan_pages"], False)
        refuse_duplicate_outputs([param_text(p[n]) for n in _series_active_outputs(plan)])
        if plan and not param_text(p["out_plan"]):
            raise ToolError("Plan Pages is checked but no output page plan was given.",
                            "Choose Output Page Plan, or uncheck Plan Pages.")
        group_wanted = param_text(p["group_field"])
        if bool(group_wanted) != bool(param_text(p["out_ranges"])):
            raise ToolError("The group field and the output page ranges table go together.",
                            "Set both, or clear both.")

        index = describe_dataset(param_text(p["index_layer"]))
        if kind_from_shape_type(index["shape_type"]) != GEOM_POLYGON:
            raise ToolError("The index layer must contain polygons; it has {0} geometry.".format(
                index["shape_type"] or "no"), "Choose the polygon index layer of the map series.")
        fields = index["fields"]
        inputs = [index["catalog_path"]]
        name_field = self._match(fields, param_text(p["page_name_field"]), "page name field",
                                 collector)
        number_field = None
        if param_text(p["page_number_field"]):
            number_field = self._match(fields, param_text(p["page_number_field"]),
                                       "page number field", collector)
        group_field = self._match(fields, group_wanted, "group field", collector) \
            if group_wanted else None

        rows = _series_adjacency_rows(p["adjacency_fields"]) if p["adjacency_fields"].values \
            else []
        if rows:
            adjacency = _series_adjacency_mapping(rows, fields, collector)
        else:
            exclude = [name_field["name"]] + ([number_field["name"]] if number_field else [])
            adjacency, prefix, ambiguous = detect_adjacency_fields(
                [f["name"] for f in fields if f.get("type") in SERIES_ADJACENCY_TYPES], exclude)
            if adjacency:
                collector.info("Adjacency fields detected: {0}.".format(", ".join(
                    "{0}={1}".format(d, adjacency[d]) for d in SERIES_DIRECTIONS
                    if d in adjacency)))
                if ambiguous:
                    collector.warning(
                        "Several field groups look like adjacency fields; '{0}_*' was used. "
                        "List the fields in Adjacency Fields to choose another group.".format(
                            prefix))
            else:
                collector.info("No adjacency fields were found, so adjacency is not checked.")

        refers, key_field = _series_adjacency_refers(adjacency, name_field, number_field, fields)

        data = []
        for text in param_list(p["data_layers"]):
            desc = describe_dataset(text)
            kind = kind_from_shape_type(desc["shape_type"])
            if kind is None:
                raise ToolError("The data layer '{0}' has no supported geometry ({1}).".format(
                    text, desc["shape_type"]), "Use point, multipoint, line or polygon layers.")
            data.append((desc, kind, input_label(text, desc["is_layer"], desc["name"])))
            inputs.append(desc["catalog_path"])

        scales = parse_scales(param_text(p["standard_scales"]) or SERIES_DEFAULT_SCALES) \
            if plan else None
        if plan:
            collector.info("Standard scales used for the page plan: {0}.".format(
                scales_text(scales)))
        frame = None
        if plan:
            frame = (param_number(p["frame_width_m"]), param_number(p["frame_height_m"]),
                     param_number(p["margin_pct"], 10.0))
            if not frame[0] or not frame[1] or frame[0] <= 0 or frame[1] <= 0:
                raise ToolError("The frame width and height must be greater than zero.",
                                "Enter the map frame size on paper in metres, e.g. 0.25 and "
                                "0.18.")
            if not 0 <= frame[2] < 100:
                raise ToolError("The margin must be from 0 to less than 100 percent.",
                                "Enter a margin such as 10.")
            text = _series_frame_unit_warning(frame[0], frame[1])
            if text:
                collector.warning(text)

        # Every output is checked before anything is read or written; tables joined to
        # an input layer are not in `inputs`, so outputs named like them are refused.
        joined = joined_table_names(fields)
        for desc, _kind, _label in data:
            joined |= joined_table_names(desc["fields"])
        refuse_joined_table_outputs([param_text(p[n]) for n in ("out_table", "out_plan",
                                                                 "out_ranges")
                                     if n != "out_plan" or plan], joined)
        if plan:
            _series_plan_container_check(param_text(p["out_plan"]), index)
        for name in ("out_table", "out_plan", "out_ranges"):
            if param_text(p[name]) and (name != "out_plan" or plan):
                check_output_path(param_text(p[name]), inputs)

        # Coverage is topological: pages and data are compared in the index layer's own
        # coordinate system, so page edges stay exactly where they are. Only the page plan
        # measures, in a metric system of its own (below).
        read_sr = index["sr_object"]
        if (index["sr"] or {}).get("type") not in ("Projected", "Geographic"):
            if data:
                collector.warning("The index layer has an unknown coordinate system, so the "
                                  "data layers are read in their native coordinates and must "
                                  "already be in the same system. Define the coordinate system "
                                  "(Define Projection).")
            read_sr = None
        else:
            further_layer_sr_warnings(index["sr"], [
                (desc["sr"], "The data layer '{0}'".format(label)) for desc, _kind, label in data],
                collector)
        progress = Progress("Reading the pages", 0)
        page_fields = [name_field["name"]] + ([number_field["name"]] if number_field else []) + \
            ([group_field["name"]] if group_field else [])
        page_fields += [f for f in sorted(set(adjacency.values())) if f not in page_fields]
        if key_field is not None and key_field["name"] not in page_fields:
            page_fields.append(key_field["name"])

        def page_dicts(source, where=None):
            out = []
            for r in float32_rows(read_features(source, page_fields, sr=read_sr, where=where),
                                  fields):
                attrs = r["attrs"]
                out.append({"oid": r["oid"], "shape": r["shape"],
                            "name": attrs[name_field["name"]],
                            "number": attrs[number_field["name"]] if number_field else None,
                            "group": attrs[group_field["name"]] if group_field else None,
                            "adjacent": dict((d, attrs[f]) for d, f in adjacency.items()),
                            "adjacency_key": attrs[key_field["name"]] if key_field else None})
            return out

        pages = page_dicts(index["input"])
        _series_stop_if_cancelled()
        collector.info("{0} page(s) read.".format(len(pages)))
        all_pages = None
        if index["is_layer"]:
            layer_desc = arcpy.da.Describe(index["input"])
            selection = layer_desc["FIDSet"] if "FIDSet" in layer_desc else None
            if selection:
                where = layer_desc["whereClause"] if "whereClause" in layer_desc else None
                all_pages = page_dicts(index["catalog_path"], where or None)
                collector.info("The index layer has a selection: only the {0} selected page(s) "
                               "are reported. Neighbours, number gaps and data coverage are "
                               "judged against all {1} page(s) of the index; names and "
                               "duplicate names/numbers are judged among the selected pages."
                               .format(len(pages), len(all_pages)))
        data_layers = []
        for (desc, kind, _label), label in zip(data, _series_data_labels(data)):
            progress.label("Reading {0}".format(label))
            data_layers.append({"layer": label, "kind": kind,
                                "dataset": dataset_identity(desc["catalog_path"]),
                                "rows": read_features(desc["input"], [], sr=read_sr)})
            _series_stop_if_cancelled()
        data_layers, repeats = unique_data_layers(data_layers)
        for label, first, _dataset, dropped in repeats:
            collector.warning(
                "The data layer '{0}' reads the same dataset as '{1}' (listed earlier in Data "
                "Layers): {2} of its feature(s) are also in '{1}' and are checked and reported "
                "once, under '{1}'. Remove the repeated entry from Data Layers.".format(
                    label, first, dropped))

        progress.label("Checking the pages")
        issues, counts, core_messages = check_series(
            pages, use_number=number_field is not None, data_layers=data_layers or None,
            adjacency=list(adjacency), all_pages=all_pages,
            wrap=x_period(index["sr"]), page_floor=convex_floor(index["sr"]),
            adjacency_refers=refers,
            adjacency_key_field=key_field["name"] if key_field else None,
            should_stop=_series_stop_if_cancelled,
            check_gaps=param_bool(p["check_number_gaps"], True))
        collector.extend(core_messages)
        if number_field is not None and not param_bool(p["check_number_gaps"], True):
            collector.info("Gaps in the page numbers were not checked (Check for Gaps in Page "
                           "Numbers is off); duplicate numbers and pages without a number were.")
        rows = _series_mend_surrogates([issue_tuple(i) for i in issues], collector)
        table_rows = _series_folder_rows(rows, param_text(p["out_table"]), collector)
        numbers = [r[2] for r in rows if r[2] is not None]
        # LONG holds +-2^31; larger (BigInteger) page numbers are written as DOUBLE (exact
        # up to 2^53, the BigInteger range).
        number_type = "LONG" if all(-2 ** 31 < n < 2 ** 31 for n in numbers) else "DOUBLE"
        # PAGE_OID, SRC_OID: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``)
        page_oid = oid_output_field(param_text(p["out_table"]), [r[0] for r in table_rows],
                                    collector, name="PAGE_OID")
        src_oid = oid_output_field(param_text(p["out_table"]), [r[6] for r in table_rows],
                                   collector)
        table_rows = [(oid_field_value(page_oid, r[0]),) + tuple(r[1:6]) +
                      (oid_field_value(src_oid, r[6]),) + tuple(r[7:]) for r in table_rows]
        jobs = [(param_text(p["out_table"]), None, [
            page_oid,
            {"name": "PAGE_NAME", "type": "TEXT", "values": [r[1] for r in table_rows]},
            {"name": "PAGE_NUMBER", "type": number_type},
            {"name": "ISSUE", "type": "TEXT", "length": max(len(i) for i in SERIES_ISSUES)},
            {"name": "DETAIL", "type": "TEXT", "values": [r[4] for r in table_rows]},
            {"name": "LAYER", "type": "TEXT", "values": [r[5] for r in table_rows]},
            src_oid], table_rows, "Issue table",
            "Here PAGE_OID 0 means a row about no single page (a missing page number), "
            "PAGE_NUMBER 0 a page without a whole page number (unless 0 is one of the page "
            "numbers) and SRC_OID 0 a row about a page, not a data feature.")]
        plan_rows = []
        if plan:
            progress.label("Planning the pages")
            _series_stop_if_cancelled()
            specs, plan_rows, plan_counts = self._plan(p, index, pages, frame, scales, collector)
            jobs.append((param_text(p["out_plan"]), GEOM_POLYGON, specs, plan_rows, "Page plan",
                         "Here SCALE 0 means that no standard scale fits (or the page has no "
                         "geometry or no area) and SCALE_NEEDED 0 that the page has no "
                         "geometry or no area."))
        if group_field:
            ranges = page_ranges(pages, number_field is not None)
            jobs.append((param_text(p["out_ranges"]), None, [
                {"name": "GROUP_NAME", "type": "TEXT", "values": [r[0] for r in ranges]},
                {"name": "PAGES", "type": "TEXT", "values": [r[1] for r in ranges]}], ranges,
                "Page ranges", ""))
        for out, _kind, specs, _rows, _what, _note in jobs:
            mapping = plan_field_names(specs, split_catalog_path(out)[0])
            cut = [(a, b) for a, b in mapping.items() if a != b]
            if cut:
                collector.info("Field names in {0} are written as: {1}.".format(
                    out, ", ".join("{0} -> {1}".format(a, b) for a, b in cut)))
            if is_folder_workspace(split_catalog_path(out)[0]):
                beyond = sum(count_beyond_bmp(spec.get("values") or ()) for spec in specs if spec["type"] == "TEXT")
                if beyond:
                    collector.warning(
                        "{0} text value(s) written to {1} hold characters above U+FFFF (for example mathematical "
                        "letters or emoji). ArcGIS Pro stores them in a dBASE table as two 3-byte halves, which other "
                        "software shows as garbled text and Pro may read back changed. Write the output to a file "
                        "geodatabase or a GeoPackage to keep them.".format(beyond, out))

        progress.label("Writing the outputs")
        created, zero_notes = [], []
        try:
            for out, kind, specs, out_rows, what, note in jobs:
                _series_stop_if_cancelled()
                if kind:
                    path, names = create_feature_class(out, kind, index["sr_object"], specs,
                                                       inputs=inputs)
                else:
                    path, names = create_table(out, specs, inputs=inputs)
                created.append(path)
                nulls = set()
                # The page plan geometry carries the index's system, so a feature class
                # in another system projects it instead of storing it unprojected.
                insert_rows(path, [names[s["name"]] for s in specs], out_rows, kind=kind,
                            wkid=(index["sr"] or {}).get("wkid") if kind else None,
                            null_fields=nulls)
                text = folder_null_number_warning(path, specs, names, nulls, note)
                if text:
                    zero_notes.append(text)
                _series_stop_if_cancelled()
                collector.info("{0} written to {1} ({2} row(s)).".format(what, path,
                                                                        len(out_rows)))
        except Exception:
            for path in created:  # never leave part of the outputs behind
                try:
                    safe_delete(path, inputs)
                except Exception:
                    pass
            raise
        for text in zero_notes:
            collector.warning(text)
        progress.close()
        found = ", ".join("{0} {1}".format(counts[k], k) for k in SERIES_ISSUES if counts[k])
        collector.info("Issues found: {0}.".format(found or "none"))

        summary = [("Index layer", index["catalog_path"]), ("Pages", len(pages)),
                   ("Data layers", ", ".join(d["layer"] for d in data_layers) or "(none)"),
                   ("Adjacency directions", ", ".join(d for d in SERIES_DIRECTIONS
                                                      if d in adjacency) or "(none)")]
        summary += [(k, counts[k]) for k in SERIES_ISSUES]
        if plan:
            # R11-2: "Pages planned" counted every page of the plan output, also the pages
            # that got no SCALE; each outcome now has its own row.
            summary += [("Pages planned (with a SCALE)", plan_counts["planned"]),
                        ("Pages with no fitting standard scale", plan_counts["too_large"]),
                        ("Pages not planned (no geometry, no area or not measured)",
                         plan_counts["not_planned"])]
        for path in write_report(report, summary, SERIES_ISSUE_HEADER, rows):
            collector.info("Report written to {0}.".format(path))
        flush_messages(collector)

    def _ground_check(self, index, measured, own, mpu, collector):
        """A projected index kept in its own system: compare each page's size in map
        units with its size on the ground (the page read in geographic coordinates and
        measured on its own Transverse Mercator). Within ``SERIES_GROUND_REL_TOL`` the
        map-unit measurement is kept; otherwise every page is measured on the ground.
        Returns ``(measured rows, metres per unit)``."""
        try:
            geo = read_features(index["input"], [], sr=_series_ground_sr(index["sr_object"]))
        except (RuntimeError, ValueError, TypeError, ToolError, arcpy.ExecuteError) as exc:
            collector.warning("The pages could not be read in geographic coordinates ({0}), so "
                              "their size on the ground was not checked: they are measured in "
                              "the map units of the index layer.".format(
                                  str(exc).strip() or type(exc).__name__))
            return measured, mpu
        probe = MessageCollector()
        ground = local_tm_rows(geo, probe)[0]
        worst, worst_oid, missing = 0.0, None, False
        for row in ground:
            if own.get(row["oid"]) is None:
                continue
            if row["shape"] is None:
                missing = True
                continue
            ratio = _series_size_ratio(plan_rectangle(own[row["oid"]]),
                                       plan_rectangle(row["shape"], own[row["oid"]]), mpu)
            if ratio is not None and ratio > worst:
                worst, worst_oid = ratio, row["oid"]
        if missing:
            collector.warning("Some pages could not be projected to geographic coordinates, so "
                              "their size on the ground was not checked.")
        if worst <= SERIES_GROUND_REL_TOL:
            return measured, mpu
        name = (index["sr"] or {}).get("name") or "its own system"
        collector.extend(probe)
        collector.warning(
            "The index layer is in {0}, whose map units differ from metres on the ground by "
            "up to {1:.1f} % at the pages (page OID {2}): the system is not true to scale "
            "there (for example an equal-area world projection). Every page is therefore "
            "measured on the ground, each on its own Transverse Mercator projection, so "
            "SCALE_NEEDED and SCALE are true-scale values and ROTATION is measured from grid "
            "east of that projection (about true east at the page). A map frame drawn in {0} "
            "shows the pages at a different size and may need another scale.".format(
                name, worst * 100.0, worst_oid))
        return ground, 1.0

    def _plan(self, p, index, pages, frame, scales, collector):
        """Plan every page; returns ``(field specs, rows, counts)`` for the page plan output;
        ``counts``: ``{"planned", "too_large", "not_planned"}`` (pages with a SCALE, pages that
        no standard scale fits, pages with no geometry, no area or no measured shape).

        Page extents are measured in metres (the index's own system if projected,
        otherwise a UTM zone, or each page on its own Transverse Mercator when the
        index spans many zones); the output keeps the index's own geometry.
        """
        measuring = choose_measuring(index, metric_sr_or_native, collector, "index layer",
                                     geographic_sr=arcpy.SpatialReference)
        metric_sr, mpu = measuring["read_sr"], measuring["mpu"]
        if metric_sr is index["sr_object"] or metric_sr is None:
            measured = [{"oid": page["oid"], "shape": page["shape"]} for page in pages]
        else:
            measured = read_features(index["input"], [], sr=metric_sr)
        if measuring["local"]:  # wide geographic index: each page on its own projection
            measured = local_tm_rows(measured, collector)[0]
        own = dict((page["oid"], page["shape"]) for page in pages)
        projected_kept = not measuring["local"] and (
            metric_sr is index["sr_object"] or metric_sr is None) and \
            (index["sr"] or {}).get("type") == "Projected"
        if projected_kept:
            measured, mpu = self._ground_check(index, measured, own, mpu, collector)
        shapes = dict((r["oid"], r["shape"]) for r in measured)
        plan = {}
        too_large, rotated, flat = [], [], []
        # R11-1: a page without geometry was skipped here without a message
        no_geometry = sorted(oid for oid, shape in own.items() if not page_has_geometry(shape))
        unmeasured = []
        for oid in sorted(own):
            if oid in no_geometry:
                continue
            shape = shapes.get(oid)
            rect = plan_rectangle(shape, own.get(oid)) if page_has_geometry(shape) else None
            if rect is None:
                unmeasured.append(oid)
                continue
            if not _series_has_area(rect):
                flat.append(oid)
                continue
            orient, needed, scale = plan_page(rect[0] * mpu, rect[1] * mpu,
                                              frame[0], frame[1], frame[2], scales)
            if scale is None:
                too_large.append(oid)
            rotation = round(rect[2], 6)
            if abs(rotation) >= SERIES_ROTATED_WARNING_DEG:
                rotated.append(oid)
            # parse_scales gives whole numbers only, so SCALE is the listed scale itself.
            plan[oid] = (orient, needed, int(scale) if scale is not None else None, rotation)
        collector.info("Page plan: SCALE assumes the map is drawn at true scale at the page "
                       "(page sizes in ground metres, within 1 %). A map frame in Web Mercator, "
                       "or in another system with a large scale factor at the page, shows the "
                       "page larger and may need a larger scale.")
        if rotated:
            collector.warning(
                "{0} page(s) are rotated against the grid of the measuring system (ROTATION, "
                "degrees counterclockwise from grid east): OIDs {1}. Their ORIENT, SCALE_NEEDED "
                "and SCALE assume the map frame is rotated so the page edges are horizontal "
                "and vertical; drawn north-up, these pages need a larger scale. Use ROTATION "
                "for the map series rotation (check the sign on one page).".format(
                    len(rotated), ", ".join(str(o) for o in sorted(rotated)[:20]) +
                    (" and {0} more".format(len(rotated) - 20) if len(rotated) > 20 else "")))
        if flat:
            collector.warning("{0} page(s) have no area (a collapsed polygon, for example all "
                              "vertices on one line): OIDs {1}. They are not planned (ORIENT, "
                              "SCALE_NEEDED, SCALE and ROTATION left empty); fix their "
                              "geometry.".format(len(flat), ", ".join(
                                  str(o) for o in sorted(flat)[:20]) +
                                  (" and {0} more".format(len(flat) - 20) if len(flat) > 20
                                   else "")))
        if no_geometry:
            collector.warning("{0} page(s) have no geometry: OIDs {1}. They are not planned (ORIENT, "
                              "SCALE_NEEDED, SCALE and ROTATION left empty) and are EMPTY_PAGE in "
                              "the issue table; fix or delete them.".format(
                                  len(no_geometry), oid_list_text(no_geometry)))
        if unmeasured:
            collector.warning("{0} page(s) could not be measured in the measuring system (their "
                              "shape was lost when projected): OIDs {1}. They are not planned "
                              "(ORIENT, SCALE_NEEDED, SCALE and ROTATION left empty).".format(
                                  len(unmeasured), oid_list_text(unmeasured)))
        if too_large:
            collector.warning("{0} page(s) need a scale larger than the largest standard scale "
                              "(SCALE left empty): OIDs {1}. Add a larger scale or make these "
                              "pages smaller.".format(len(too_large), ", ".join(
                                  str(o) for o in sorted(too_large)[:20]) +
                                  (" and {0} more".format(len(too_large) - 20)
                                   if len(too_large) > 20 else "")))
        # The copy keeps the index's own geometry (read without projection).
        attrs_fields = copyable_fields(index["fields"])
        native = read_features(index["input"], [f["name"] for f in attrs_fields])
        out_plan = param_text(p["out_plan"])
        workspace = split_catalog_path(out_plan)[0]
        tool_fields = ["PAGE_OID", "ORIENT", "SCALE_NEEDED", "SCALE", "ROTATION"]
        reserved = [arcpy.ValidateFieldName(n, workspace) for n in tool_fields]
        attr_specs = attribute_specs(attrs_fields, reserved, lambda n: arcpy.ValidateFieldName(
            n, workspace), [r["attrs"] for r in native], folder=is_folder_workspace(workspace),
            out_domains=output_domains(read_domains, out_plan))
        renamed = [(s["source"], s["name"]) for s in attr_specs if s["name"] != s["source"]]
        if renamed:
            collector.info("Page plan: {0} copied page field(s) are written under another name, "
                           "because the page plan's own fields (PAGE_OID, ORIENT, SCALE_NEEDED, "
                           "SCALE, ROTATION), its system fields or the output workspace need the "
                           "name: {1}.".format(len(renamed), ", ".join(
                               "{0} -> {1}".format(a, b) for a, b in renamed)))
        text = lost_domain_warning(attr_specs, out_plan)
        if text:
            collector.warning(text)
        page_oid = oid_output_field(out_plan, [r["oid"] for r in native], collector,
                                    name="PAGE_OID")
        specs = [page_oid] + attr_specs + [
            {"name": "ORIENT", "type": "TEXT", "length": 9},
            {"name": "SCALE_NEEDED", "type": "DOUBLE"},
            {"name": "SCALE", "type": "LONG"},
            {"name": "ROTATION", "type": "DOUBLE"}]
        rows = []
        for r in native:
            orient, needed, scale, rotation = plan.get(r["oid"], (None, None, None, None))
            values = [oid_field_value(page_oid, r["oid"])] + \
                [r["attrs"][s["source"]] for s in attr_specs] + \
                [orient, needed, scale, rotation]
            rows.append((r["shape"], values))
        counts = {"planned": sum(1 for v in plan.values() if v[2] is not None),
                  "too_large": len(too_large),
                  "not_planned": len(no_geometry) + len(unmeasured) + len(flat)}
        return specs, rows, counts


# ==========================================================================
# carto/timestep_tool.py
# ==========================================================================
# Time Series Layout Export: exports a layout once per step and stitches an animated GIF.
#
# Pro-only (arcpy.mp). The run never saves the project and restores every property it changes
# (definition queries, layer visibility, text elements, map frame extent), also after an error.

TIMESTEP_TIME_PARAMS = ("start_time", "end_time", "interval", "interval_unit", "label_format",
                        "label_language")
TIMESTEP_WINDOW_MODES = ("TIME", "ATTRIBUTE", "LAYER_VISIBILITY")


# --------------------------------------------------------------------------
# arcpy.mp adapter (thin; the logic is in timestep_core)
# --------------------------------------------------------------------------

def _ts_open_project(path):
    """The project object: the file at ``path`` (read through ArcGISProject, never saved) or,
    when ``path`` is empty, the current project (only inside ArcGIS Pro)."""
    if path:
        if not os.path.isfile(path) or not path.casefold().endswith(".aprx"):
            raise ToolError("The project '{0}' is not an existing .aprx file.".format(path),
                            "Choose a saved ArcGIS Pro project (.aprx), or leave the project "
                            "empty to use the current project.")
        try:
            return arcpy.mp.ArcGISProject(path)
        except Exception as err:
            raise ToolError("ArcGIS Pro could not open the project '{0}' ({1}).".format(path, err),
                            "Check that the file is a valid project of this ArcGIS Pro version.")
    try:
        return arcpy.mp.ArcGISProject("CURRENT")
    except Exception:
        raise ToolError("There is no current project: this run is not inside ArcGIS Pro, or no "
                        "project is open.",
                        "Run the tool from ArcGIS Pro, or choose a project (.aprx) file.")


def _ts_names(items, limit=15):
    names = [str(i) for i in items]
    return ", ".join(names[:limit]) + (" ..." if len(names) > limit else "")


def _ts_pick_layout(project, wanted):
    layouts = list(project.listLayouts())
    if not layouts:
        raise ToolError("The project has no layout.", "Create a layout with a map frame first.")
    if wanted:
        for lay in layouts:
            if lay.name.casefold() == wanted.casefold():
                return lay
        raise ToolError("The project has no layout called '{0}'.".format(wanted),
                        "Layouts in the project: {0}.".format(_ts_names(l.name for l in layouts)))
    if len(layouts) == 1:
        return layouts[0]
    raise ToolError("The project has {0} layouts and none was chosen.".format(len(layouts)),
                    "Enter the Layout Name: {0}.".format(_ts_names(l.name for l in layouts)))


def _ts_pick_frame(layout, wanted):
    frames = list(layout.listElements("MAPFRAME_ELEMENT"))
    if not frames:
        raise ToolError("The layout '{0}' has no map frame.".format(layout.name),
                        "Add a map frame to the layout.")
    if wanted:
        for fr in frames:
            if fr.name.casefold() == wanted.casefold():
                return fr
        raise ToolError("The layout has no map frame called '{0}'.".format(wanted),
                        "Map frames: {0}.".format(_ts_names(f.name for f in frames)))
    if len(frames) == 1:
        return frames[0]
    raise ToolError("The layout has {0} map frames and none was chosen.".format(len(frames)),
                    "Enter the Map Frame Name: {0}.".format(_ts_names(f.name for f in frames)))


def _ts_find_layer(the_map, wanted, allow_groups=False):
    """The one layer whose name (or group path) equals ``wanted`` (ignoring case).

    Group layers are matched only with ``allow_groups`` (LAYER_VISIBILITY switches a group on
    and off); elsewhere a name that only matches a group is refused with a message that says so.
    """
    key = wanted.strip().casefold()
    found = []
    groups = []
    for lyr in the_map.listLayers():
        if lyr.name.casefold() == key or lyr.longName.casefold() == key:
            if lyr.isGroupLayer and not allow_groups:
                groups.append(lyr)
            else:
                found.append(lyr)
    if not found and groups:
        children = [l.longName for l in the_map.listLayers()
                    if not l.isGroupLayer and l.longName.casefold().startswith(
                        groups[0].longName.casefold() + "\\")]
        raise ToolError("'{0}' is a group layer; Step Layers needs a layer with a field.".format(
            wanted), "List one of the layers in the group: {0}.".format(
                _ts_names(children) if children else "(the group is empty)"))
    if not found:
        names = [l.longName for l in the_map.listLayers()
                 if allow_groups or not l.isGroupLayer]
        raise ToolError("The map '{0}' has no layer called '{1}'.".format(the_map.name, wanted),
                        "Layers in the map: {0}.".format(_ts_names(names)))
    if len(found) > 1:
        raise ToolError("{0} layers are called '{1}'.".format(len(found), wanted),
                        "Use the full name with the group path: {0}.".format(
                            _ts_names(l.longName for l in found)))
    return found[0]


def _ts_find_bookmark(all_bm, wanted):
    """The one bookmark called ``wanted``: an exact (case-sensitive) name first, then a name
    that differs only in case. Two bookmarks that both match (same name, or names that differ
    only in case when neither is exact) are refused instead of picking one silently."""
    exact = [b for b in all_bm if b.name == wanted]
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        raise ToolError("{0} bookmarks are called '{1}'.".format(len(exact), wanted),
                        "Rename the bookmarks in the map so each name is used once.")
    folded = [b for b in all_bm if b.name.casefold() == wanted.casefold()]
    if len(folded) == 1:
        return folded[0]
    if len(folded) > 1:
        raise ToolError("{0} bookmarks match '{1}' when case is ignored: {2}.".format(
            len(folded), wanted, _ts_names(b.name for b in folded)),
            "Type the bookmark name with its exact upper and lower case.")
    raise ToolError("The map has no bookmark called '{0}'.".format(wanted),
                    "Bookmarks: {0}.".format(_ts_names(b.name for b in all_bm)))


def _ts_is_gdb_path(source):
    """True when a path goes through a file geodatabase folder (``x.gdb\\`` or ending ``.gdb``),
    not merely a folder whose name contains ".gdb" (such as ``old.gdb_backup``)."""
    return re.search(r"\.gdb([\\/]|$)", source or "", re.IGNORECASE) is not None


def _ts_layer_source(lyr):
    if not lyr.isFeatureLayer or not lyr.supports("DATASOURCE"):
        raise ToolError("The layer '{0}' is not a feature layer with a data source.".format(
            lyr.name), "Choose a feature layer.")
    return lyr.dataSource


def _ts_field_info(source, field):
    """``(name, type)`` of the field in the layer's data source (looked up ignoring case)."""
    names = []
    for f in arcpy.ListFields(source):
        names.append(f.name)
        if f.name.casefold() == field.casefold():
            return f.name, f.type
    raise ToolError("The field '{0}' does not exist in '{1}'.".format(field, source),
                    "Fields: {0}.".format(_ts_names(names, 25)))


def _ts_read_values(source, field, where):
    """Every value of ``field`` (rows matching the layer's own definition query)."""
    with arcpy.da.SearchCursor(source, [field], where_clause=where or None) as cursor:
        return [row[0] for row in cursor]


def _ts_export_png(layout, path, dpi):
    """Export the layout to PNG; returns the name of the method used.

    ``Layout.export`` exists from ArcGIS Pro 3.4 (written from the Esri pages, not run); on
    3.3 the legacy ``exportToPNG`` is used."""
    if hasattr(layout, "export"):
        try:
            fmt = arcpy.mp.CreateExportFormat("PNG", path)
            fmt.resolution = int(dpi)
            fmt.colorMode = "24-BIT_TRUE_COLOR"
            layout.export(fmt)
            return "Layout.export"
        except Exception:
            pass  # fall through to the legacy method
    try:
        layout.exportToPNG(path, resolution=int(dpi), color_mode="24-BIT_TRUE_COLOR")
    except Exception:
        layout.exportToPNG(path, resolution=int(dpi))
    return "Layout.exportToPNG"


def _ts_legends_of(cim):
    """The legend elements of a layout CIM whose 'show only visible layers' setting is on."""
    out = []
    for el in getattr(cim, "elements", None) or []:
        if type(el).__name__ == "CIMLegend" and getattr(el, "autoVisibility", False):
            out.append(el)
    return out


def _ts_item_flag(item):
    return "isVisible" if hasattr(item, "isVisible") else "visible"


def _ts_legend_prepare(layout, the_map):
    """LAYER_VISIBILITY: ArcGIS Pro 3.3.2 was seen not to refresh a legend set to show only
    visible layers when arcpy switched layers between exports: inside one run the legend kept
    the entries of the first frame, so the same layer state drew a different legend depending
    on the run. Returns what _ts_legend_sync needs (None when the layout has no such legend or
    no CIM access): the original item flags and the map layers by CIM URI."""
    if not hasattr(layout, "getDefinition") or not hasattr(layout, "setDefinition"):
        return None
    try:
        cim = layout.getDefinition("V3")
        legends = _ts_legends_of(cim)
        if not legends:
            return None
        originals = [[getattr(i, _ts_item_flag(i)) for i in (getattr(el, "items", None) or [])]
                     for el in legends]
        by_uri = {}
        for lyr in the_map.listLayers():
            try:
                uri = lyr.getDefinition("V3").uRI
            except Exception:
                continue
            if uri:
                by_uri[uri] = lyr
    except Exception:
        return None
    return {"originals": originals, "by_uri": by_uri, "the_map": the_map,
            "count": len(legends)}


def _ts_shown(lyr, by_long):
    """A layer is drawn only when it and every group above it are visible."""
    if not lyr.visible:
        return False
    parts = (getattr(lyr, "longName", None) or lyr.name).split("\\")
    for k in range(1, len(parts)):
        parent = by_long.get("\\".join(parts[:k]))
        if parent is not None and not parent.visible:
            return False
    return True


def _ts_hidden_groups(lyr, by_long):
    """The group layers above ``lyr`` that are switched off, outermost first (their long
    names). A layer inside a switched-off group is not drawn, even when it is visible itself."""
    parts = (getattr(lyr, "longName", None) or lyr.name).split("\\")
    out = []
    for k in range(1, len(parts)):
        name = "\\".join(parts[:k])
        parent = by_long.get(name)
        if parent is not None and not parent.visible:
            out.append(name)
    return out


def _ts_layers_by_long(the_map):
    return dict(((getattr(l, "longName", None) or l.name), l) for l in the_map.listLayers())


def _ts_legend_apply(layout, legend, restore=False):
    """Set every legend item of a layer to (its original flag AND the layer is drawn), or back
    to the original flag when ``restore``; then write the layout CIM so Pro lays the legend out
    again. Items whose layer is not found keep their flag."""
    cim = layout.getDefinition("V3")
    by_long = dict(((getattr(l, "longName", None) or l.name), l)
                   for l in legend["the_map"].listLayers())
    for el, flags in zip(_ts_legends_of(cim), legend["originals"]):
        for item, original in zip(getattr(el, "items", None) or [], flags):
            want = original
            if not restore:
                lyr = legend["by_uri"].get(getattr(item, "layerURI", None))
                if lyr is not None:
                    want = bool(original) and _ts_shown(lyr, by_long)
            setattr(item, _ts_item_flag(item), want)
    layout.setDefinition(cim)


def _ts_snapshot_layer(lyr):
    rec = {"layer": lyr, "base": "", "queries": None, "visible": None}
    try:
        rec["base"] = lyr.definitionQuery or ""
    except Exception:
        rec["base"] = ""
    if hasattr(lyr, "listDefinitionQueries"):
        try:
            rec["queries"] = [dict(q) for q in lyr.listDefinitionQueries()]
        except Exception:
            rec["queries"] = None
    try:
        rec["visible"] = lyr.visible
    except Exception:
        rec["visible"] = None
    return rec


def _ts_query_key(queries):
    return [(q["sql"], bool(q["isActive"])) for q in queries]


def _ts_clear_queries_with_cim(lyr):
    """Last resort for an empty original list: clear the definition filters in the layer CIM."""
    cim = lyr.getDefinition("V3")
    table = cim.featureTable
    table.definitionExpression = ""
    for attribute, value in (("definitionExpressionName", ""), ("definitionFilterChoices", [])):
        try:
            setattr(table, attribute, value)
        except Exception:
            pass
    lyr.setDefinition(cim)


def _ts_put_queries_back(lyr, want, name, problems):
    """Write the original list of definition queries back and verify it by reading it again.

    Seen in ArcGIS Pro 3.3.2: setting ``definitionQuery = ""`` only deactivates the
    queries (the list keeps every query added by the run), and a non-empty list written with
    ``updateDefinitionQueries`` replaces the list. Whether an empty list clears it is checked
    here by reading back, then the layer CIM is tried, and anything still different is reported.
    """
    failure = None
    try:
        lyr.updateDefinitionQueries([dict(q) for q in want])
    except Exception as err:
        failure = err
    now = lyr.listDefinitionQueries()
    if _ts_query_key(now) != _ts_query_key(want) and not want and hasattr(lyr, "getDefinition"):
        try:
            _ts_clear_queries_with_cim(lyr)
        except Exception as err:
            failure = failure or err
        now = lyr.listDefinitionQueries()
    if _ts_query_key(now) == _ts_query_key(want):
        return
    if failure is not None:
        problems.append("The definition queries of layer '{0}' could not be restored with "
                        "updateDefinitionQueries ({1}).".format(name, failure))
    wanted = set(_ts_query_key(want))
    stray_active = any(key[1] and key not in wanted for key in _ts_query_key(now))
    problems.append(
        "Layer '{0}' has {1} definition queries in memory instead of {2}{3} (the project file "
        "was not saved, so it is unchanged).".format(
            name, len(now), len(want),
            "" if stray_active else "; none of the extra ones is active"))


def _ts_restore_layer(rec, queries_touched, problems):
    """Put the definition queries and the visibility of a layer back; verify; record problems."""
    lyr = rec["layer"]
    name = getattr(lyr, "name", "?")
    if queries_touched:
        try:
            lyr.definitionQuery = ""   # deactivates every query (Pro 3.3.2 keeps them in the list)
        except Exception as err:
            problems.append("The definition query of layer '{0}' could not be cleared ({1}).".format(
                name, err))
        try:
            if rec["queries"] is not None and hasattr(lyr, "updateDefinitionQueries"):
                _ts_put_queries_back(lyr, rec["queries"], name, problems)
            if (lyr.definitionQuery or "") != rec["base"]:
                lyr.definitionQuery = rec["base"]
            if (lyr.definitionQuery or "") != rec["base"]:
                problems.append("The definition query of layer '{0}' is not back to its "
                                "original value.".format(name))
        except Exception as err:
            problems.append("The definition queries of layer '{0}' could not be checked "
                            "({1}).".format(name, err))
    if rec["visible"] is not None:
        try:
            lyr.visible = rec["visible"]
            if lyr.visible != rec["visible"]:
                problems.append("The visibility of layer '{0}' was not restored.".format(name))
        except Exception as err:
            problems.append("The visibility of layer '{0}' could not be restored ({1}).".format(
                name, err))


def _ts_restore(state):
    """Restore everything the run touched; returns a list of problems (never raises)."""
    problems = []
    for rec in state["layers"]:
        _ts_restore_layer(rec, state["queries_touched"], problems)
    for element, original in state["texts"]:
        try:
            element.text = original
            if element.text != original:
                problems.append("The text of element '{0}' was not restored exactly.".format(
                    getattr(element, "name", "?")))
        except Exception as err:
            problems.append("The text of element '{0}' could not be restored ({1}).".format(
                getattr(element, "name", "?"), err))
    if state["camera"] is not None:
        _ts_restore_camera(state["camera"], problems)
    return problems


def _ts_snapshot_camera(frame):
    """What BOOKMARKS mode changes in the map frame: ``zoomToBookmark`` applies the view stored
    with the bookmark, which holds a rotation (``heading``) besides the extent (Esri: Camera has
    heading and scale; a bookmark camera stores Heading). Every value is read separately; one
    that cannot be read is None and is then not restored."""
    camera = frame.camera
    snap = {"frame": frame, "extent": camera.getExtent(), "heading": None, "scale": None}
    for name in ("heading", "scale"):
        try:
            value = getattr(camera, name)
        except Exception:
            value = None
        snap[name] = float(value) if isinstance(value, (int, float)) and not isinstance(
            value, bool) else None
    return snap


def _ts_close(a, b):
    return abs(float(a) - float(b)) <= 1e-9 * max(1.0, abs(float(a)), abs(float(b)))


def _ts_restore_camera(snap, problems):
    """Put the map frame view back: rotation first (an extent is read and set in the rotated
    view), then the extent, then the scale; the rotation and the scale are read back and
    compared. ``snap`` is from ``_ts_snapshot_camera`` (a ``(frame, extent)`` pair is accepted
    too)."""
    if not isinstance(snap, dict):
        snap = {"frame": snap[0], "extent": snap[1], "heading": None, "scale": None}
    camera = snap["frame"].camera
    if snap["heading"] is not None:
        try:
            camera.heading = snap["heading"]
        except Exception as err:
            problems.append("The map frame rotation could not be restored ({0}).".format(err))
    try:
        camera.setExtent(snap["extent"])
    except Exception as err:
        problems.append("The map frame extent could not be restored ({0}).".format(err))
    for name, label in (("scale", "scale"), ("heading", "rotation")):
        want = snap[name]
        if want is None:
            continue
        try:
            if not _ts_close(getattr(camera, name), want):
                setattr(camera, name, want)
            now = getattr(camera, name)
            if not _ts_close(now, want):
                problems.append("The map frame {0} is {1}, not its original {2}.".format(
                    label, now, want))
        except Exception as err:
            problems.append("The map frame {0} could not be restored ({1}).".format(label, err))


def _ts_check_output_paths(cfg, project_path):
    """Refuse outputs that clash with each other, with the project, or with existing files."""
    outs = [("Output GIF", cfg["out_gif"]), ("Output Manifest", cfg["manifest"])]
    seen = {}
    for label, path in outs + ([("Project", project_path)] if project_path else []):
        if not path:
            continue
        key = os.path.normcase(os.path.abspath(path))
        if key in seen:
            raise ToolError("{0} and {1} are the same file ({2}).".format(seen[key], label, path),
                            "Choose different output files. The tool never overwrites the "
                            "project.")
        seen[key] = label
    if not cfg["out_gif"].casefold().endswith(".gif"):
        raise ToolError("The output GIF '{0}' must end in .gif.".format(cfg["out_gif"]),
                        "Add the .gif extension.")
    if cfg["manifest"] and not cfg["manifest"].casefold().endswith(".csv"):
        raise ToolError("The manifest '{0}' must end in .csv.".format(cfg["manifest"]),
                        "Add the .csv extension.")
    for label, path in outs:
        if not path:
            continue
        folder = os.path.dirname(os.path.abspath(path))
        if not os.path.isdir(folder):
            raise ToolError("The folder of {0} does not exist: {1}.".format(label, folder),
                            "Create the folder or choose another location.")
        if os.path.exists(path) and not cfg["overwrite"]:
            raise ToolError("{0} '{1}' already exists.".format(label, path),
                            "Choose a new name, or allow geoprocessing tools to overwrite "
                            "existing datasets (Options > Geoprocessing).")
    if cfg["frames_dir"] and os.path.isfile(cfg["frames_dir"]):
        raise ToolError("The frames folder '{0}' is a file.".format(cfg["frames_dir"]),
                        "Choose a folder.")


def _ts_frames_folder_message(param):
    """The Output Frames Folder is an Input folder (so ArcGIS Pro never deletes it before a
    run); a folder that does not exist yet is allowed, because the tool creates it. Clears the
    "does not exist" error of Pro's own validation for such a folder; a path that is a file
    gets an error."""
    folder = param_text(param)
    if not folder:
        return
    if os.path.isfile(folder):
        param.setErrorMessage("This is a file. Choose a folder.")
    elif not os.path.exists(folder) and param.hasError():
        param.clearMessage()


def timestep_run(project, cfg, collector, reader=None, field_info=None, exporter=None):
    """Plan, export, restore, stitch. ``project`` is an ArcGISProject-like object; the three
    callables stand in for the arcpy parts so the loop is testable. Returns a dict."""
    reader = reader or _ts_read_values
    field_info = field_info or _ts_field_info
    exporter = exporter or _ts_export_png
    mode = cfg["mode"]
    for text in timestep_check_settings(mode, cfg["frame_ms"], cfg["last_hold_ms"], cfg["loop"],
                                        cfg["dpi"], cfg["max_frames"], cfg["max_colours"],
                                        cfg["palette"], cfg["language"], cfg["window"],
                                        cfg["window_steps"]):
        collector.warning(text)

    layout = _ts_pick_layout(project, cfg["layout_name"])
    frame = _ts_pick_frame(layout, cfg["frame_name"])
    the_map = frame.map
    if the_map is None:
        raise ToolError("The map frame '{0}' shows no map.".format(frame.name),
                        "Set the map of the map frame.")
    collector.info("Layout '{0}', map frame '{1}', map '{2}'.".format(
        layout.name, frame.name, the_map.name))

    by_long = _ts_layers_by_long(the_map)
    recs = []          # layers whose definition queries are changed
    vis_recs = []      # layers whose visibility is changed
    counts = None
    values_for_clause = None
    bookmarks = None
    rows = cfg["rows"]
    if mode in ("TIME", "ATTRIBUTE"):
        if not rows:
            raise ToolError("No step layer and field were given.",
                            "Add at least one row (layer name, field name) to Step Layers.")
        if mode == "ATTRIBUTE" and len(rows) != 1:
            raise ToolError("ATTRIBUTE mode needs exactly one row in Step Layers.",
                            "Keep one layer and field.")
        used_layers = {}
        for layer_name, field in rows:
            if not layer_name or not field:
                raise ToolError("Every Step Layers row needs a layer name and a field name.",
                                "Complete or remove the incomplete row.")
            lyr = _ts_find_layer(the_map, layer_name)
            layer_key = getattr(lyr, "longName", None) or lyr.name
            if layer_key in used_layers:
                raise ToolError(
                    "Layer '{0}' is listed more than once in Step Layers (fields '{1}' and "
                    "'{2}').".format(lyr.name, used_layers[layer_key], field),
                    "A layer can be filtered through one field only. Keep one row per layer.")
            used_layers[layer_key] = field
            source = _ts_layer_source(lyr)
            if not _ts_is_gdb_path(source):
                collector.warning(
                    "Layer '{0}' is not stored in a file geodatabase ({1}). The query syntax "
                    "of the steps was verified only on file geodatabase date fields; check "
                    "the frames.".format(lyr.name, source))
            if not lyr.visible:
                collector.warning("Layer '{0}' is switched off in the map, so the frames will "
                                  "not show it.".format(lyr.name))
            else:
                hidden = _ts_hidden_groups(lyr, by_long)
                if hidden:
                    collector.warning(
                        "Layer '{0}' is inside the group '{1}', which is switched off in the "
                        "map, so the frames will not show it.".format(
                            getattr(lyr, "longName", None) or lyr.name, hidden[0]))
            fname, ftype = field_info(source, field)
            kind = timestep_field_kind(ftype, for_time=(mode == "TIME"))
            if ftype in ("DateOnly", "TimestampOffset"):
                collector.warning(
                    "Field '{0}' is of type {1}. The step queries were verified in ArcGIS Pro "
                    "only on Date fields; values are used as stored (a date at midnight, a time "
                    "stamp without its offset). Check the frames and the feature counts in the "
                    "manifest.".format(fname, ftype))
            rec = _ts_snapshot_layer(lyr)
            rec.update({"field": fname, "kind": kind, "source": source,
                        "number_type": timestep_number_type(ftype) if kind == "number" else None})
            values = reader(source, fname, rec["base"] or None)
            if rec["number_type"] == "single":
                # the cursor widens float32 to double: 1.1 is read as 1.100000023841858
                values = [timestep_single_value(v) for v in values]
                collector.info(
                    "Field '{0}' is of type Single (float32). Its values are shown in their "
                    "shortest form (1.1, not 1.100000023841858), and each frame selects its "
                    "value with a narrow range ({0} >= low AND {0} <= high) that holds only that "
                    "float32 value (confirmed on a file geodatabase; on other sources compare "
                    "the frames with the feature counts in the manifest).".format(fname))
            if kind == "date":
                values = [timestep_normalise_value(v) for v in values]
                odd = [v for v in values if v is not None and not isinstance(v, datetime.datetime)]
                if odd:
                    raise ToolError(
                        "Field '{0}' of layer '{1}' returned a value that is not a date: "
                        "{2!r}.".format(fname, lyr.name, odd[0]),
                        "Choose a field whose values are dates.")
            rec["values"] = values
            recs.append(rec)
    if mode == "TIME":
        dates = [d for rec in recs for d in rec["values"] if d is not None]
        none_count = sum(1 for rec in recs for d in rec["values"] if d is None)
        if none_count:
            collector.info("{0} feature(s) have no date and appear in no frame.".format(none_count))
        start = timestep_parse_datetime(cfg["start"])
        end = timestep_parse_datetime(cfg["end"])
        start, end_excl = timestep_resolve_range(start, end, min(dates) if dates else None,
                                                 max(dates) if dates else None, cfg["unit"])
        steps = timestep_time_steps(start, end_excl, cfg["interval"], cfg["unit"], cfg["window"],
                                    cfg["window_steps"], cfg["label_format"], cfg["language"],
                                    cfg["max_frames"])
        odd_tokens = timestep_unknown_tokens(cfg["label_format"])
        if odd_tokens:
            collector.warning(
                "Label Format holds {0}, which the tool does not know; it is copied into the "
                "label as typed. Known tokens: %Y %y %m %d %H %M %S %b %B %%.".format(
                    " ".join(odd_tokens)))
        counts = [0] * len(steps)
        for rec in recs:
            per = timestep_count_time(rec["values"], steps)
            counts = [a + b for a, b in zip(counts, per)]
        collector.info("Time range {0} to {1} (end exclusive), {2} step(s) of {3} {4}.".format(
            timestep_iso(start), timestep_iso(end_excl), len(steps), cfg["interval"],
            cfg["unit"].lower()))
        if any(s["partial"] for s in steps):
            collector.info("The last step is shorter than the others (the range ends inside it).")
            last = steps[-1]
            if (end is not None and end == end.replace(hour=0, minute=0, second=0, microsecond=0)
                    and len(steps) > 1
                    and timestep_shift(start, len(steps) - 1, cfg["interval"], cfg["unit"]) == end):
                collector.info(
                    "End Time {0} is a date, so that whole day is included and makes the last "
                    "frame ({1}) on its own. To end with the frame before it, type End Time "
                    "as {2}.".format(timestep_iso(end)[:10], last["label"],
                                     timestep_iso(end - datetime.timedelta(days=1))[:10]))
    elif mode == "ATTRIBUTE":
        rec = recs[0]
        ordered, msgs = timestep_order_values(rec["values"], cfg["order"], cfg["listed_values"],
                                              kind=rec["kind"], number_type=rec["number_type"])
        for text in msgs:
            if text.startswith("Listed value(s) not found"):
                collector.warning(text)
            else:
                collector.info(text)
        if not ordered:
            raise ToolError("The field '{0}' has no values to step through.".format(rec["field"]),
                            "Choose a field with values, or check the listed values.")
        if len(ordered) > cfg["max_frames"]:
            raise ToolError("The field has {0} distinct values, more than the {1} frames "
                            "allowed.".format(len(ordered), cfg["max_frames"]),
                            "List the values you want, or raise Maximum Frames.")
        labels = [timestep_iso(v) if rec["kind"] == "date" else value_to_text(v)
                  for v in ordered]
        steps = timestep_item_steps(labels, cfg["window"], cfg["window_steps"], cfg["language"])
        counts = timestep_count_values(rec["values"], ordered, steps, rec["number_type"])
        values_for_clause = ordered
        collector.info("{0} distinct value(s) of {1}: {2} frame(s).".format(
            len(ordered), rec["field"], len(steps)))
    elif mode == "LAYER_VISIBILITY":
        names = cfg["items"]
        if len(names) < 1:
            raise ToolError("No layers were listed.", "List the layers to show one after another.")
        by_key = {}
        for position, name in enumerate(names):
            lyr = _ts_find_layer(the_map, name, allow_groups=True)
            layer_key = (getattr(lyr, "longName", None) or lyr.name).casefold()
            if layer_key not in by_key:
                # one record per layer: a layer listed twice is visible in both of its frames
                rec = _ts_snapshot_layer(lyr)
                rec["positions"] = []
                by_key[layer_key] = rec
                vis_recs.append(rec)
            by_key[layer_key]["positions"].append(position)
        for key_a in by_key:
            for key_b in by_key:
                if key_b != key_a and key_b.startswith(key_a + "\\"):
                    collector.warning(
                        "'{0}' is inside the listed group '{1}': it shows only in frames where "
                        "the group is shown too.".format(by_key[key_b]["layer"].longName,
                                                         by_key[key_a]["layer"].longName))
        listed = set(by_key)
        for key, rec in by_key.items():
            # groups that are listed are switched by the run; an unlisted group that is off
            # keeps the layer from being drawn in every frame
            hidden = [g for g in _ts_hidden_groups(rec["layer"], by_long)
                      if g.casefold() not in listed]
            if hidden:
                collector.warning(
                    "Layer '{0}' is inside the group '{1}', which is switched off in the map "
                    "and not listed, so the frames will not show it.".format(
                        rec["layer"].longName, hidden[0]))
        if len(names) > cfg["max_frames"]:
            raise ToolError("{0} layers give more than {1} frames.".format(
                len(names), cfg["max_frames"]), "List fewer layers or raise Maximum Frames.")
        steps = timestep_item_steps(names, cfg["window"], cfg["window_steps"], cfg["language"])
    else:  # BOOKMARKS
        all_bm = list(the_map.listBookmarks())
        if cfg["items"]:
            bookmarks = [_ts_find_bookmark(all_bm, name) for name in cfg["items"]]
        else:
            bookmarks = all_bm
        if not bookmarks:
            raise ToolError("The map has no bookmarks.", "Create bookmarks, or use another mode.")
        if len(bookmarks) > cfg["max_frames"]:
            raise ToolError("{0} bookmarks give more than {1} frames.".format(
                len(bookmarks), cfg["max_frames"]), "List fewer bookmarks or raise Maximum Frames.")
        steps = timestep_item_steps([b.name for b in bookmarks])
    if not steps:
        raise ToolError("The settings give no frame.", "Check the range or the lists.")
    if counts is not None:
        empty = [s["index"] for s, c in zip(steps, counts) if c == 0]
        if empty:
            collector.warning("{0} of {1} frame(s) contain no features of the step layer(s) "
                              "(frames {2}).".format(len(empty), len(steps), _ts_names(empty)))

    pixels = timestep_pixels_per_frame(getattr(layout, "pageWidth", None),
                                       getattr(layout, "pageHeight", None),
                                       getattr(layout, "pageUnits", None), cfg["dpi"])
    if pixels is not None:
        text = timestep_check_memory(pixels, len(steps), cfg["dpi"])
        if text:
            collector.warning(text)

    texts = []
    for element in layout.listElements("TEXT_ELEMENT"):
        if cfg["text_name"] and element.name.casefold() != cfg["text_name"].casefold():
            continue
        if timestep_has_placeholder(element.text):
            texts.append((element, element.text))
    if not texts:
        collector.warning(
            "No text element in layout '{0}' contains {{STEP}}, {{FROM}}, {{TO}}, {{INDEX}} or "
            "{{COUNT}}{1}, so the frames show no step label.".format(
                layout.name, " (element '{0}')".format(cfg["text_name"]) if cfg["text_name"]
                else ""))
    names_out = [timestep_frame_name(s["index"], len(steps), s["label"]) for s in steps]
    keep = bool(cfg["frames_dir"])
    gif_ok = True
    try:
        timestep_pillow()
    except ToolError:
        if not keep:
            raise     # nothing to deliver without Pillow: refuse before any export
        gif_ok = False
        collector.warning(
            "The Pillow package is not available in this Python environment, so no GIF will be "
            "written. The frames and the manifest are still produced in '{0}'; stitch the "
            "frames in another program or run the tool in ArcGIS Pro's own Python.".format(
                cfg["frames_dir"]))
    if keep:
        frames_dir = cfg["frames_dir"]
        if not os.path.isdir(frames_dir):
            os.makedirs(frames_dir)
        if not cfg["overwrite"]:
            clash = [n for n in names_out if os.path.exists(os.path.join(frames_dir, n))]
            if clash:
                raise ToolError("{0} frame file(s) already exist in '{1}' (for example {2}).".format(
                    len(clash), frames_dir, clash[0]),
                    "Choose an empty folder, or allow geoprocessing tools to overwrite existing "
                    "datasets (Options > Geoprocessing).")
        wanted = set(n.casefold() for n in names_out)
        stale = sorted(n for n in os.listdir(frames_dir)
                       if re.match(r"frame_\d{4,}.*\.png$", n, re.IGNORECASE)
                       and n.casefold() not in wanted)
        if stale:
            collector.warning(
                "The frames folder '{0}' already holds {1} other frame file(s) (for example "
                "{2}), probably from an earlier run. The tool leaves them in place; they are "
                "not part of this GIF or manifest.".format(frames_dir, len(stale), stale[0]))
    else:
        frames_dir = tempfile.mkdtemp(prefix="timestep_frames_")

    try:
        state = {"layers": recs + [r for r in vis_recs], "texts": texts, "camera": None,
                 "queries_touched": mode in ("TIME", "ATTRIBUTE")}
        if mode == "BOOKMARKS":
            state["camera"] = _ts_snapshot_camera(frame)
        frame_rows = []
        paths = []
        method = None
        progress = Progress("Exporting frames", len(steps))
        problems = []
        legend = _ts_legend_prepare(layout, the_map) if mode == "LAYER_VISIBILITY" else None
        legend_touched = False
        legend_live = legend is not None
        try:
            if legend is not None:
                collector.info("{0} legend(s) set to show only visible layers: their entries "
                               "are matched to the layers shown before each frame.".format(
                                   legend["count"]))
            for k, step in enumerate(steps):
                if mode == "TIME":
                    for rec in recs:
                        clause = timestep_time_clause(rec["field"], step["window_start"],
                                                      step["window_end"])
                        rec["layer"].definitionQuery = timestep_and(rec["base"], clause)
                elif mode == "ATTRIBUTE":
                    rec = recs[0]
                    members = [values_for_clause[m] for m in step["members"]]
                    clause = timestep_value_clause(rec["field"], rec["kind"], members,
                                                   rec["number_type"])
                    rec["layer"].definitionQuery = timestep_and(rec["base"], clause)
                elif mode == "LAYER_VISIBILITY":
                    for rec in vis_recs:
                        rec["layer"].visible = any(j in step["members"] for j in rec["positions"])
                    if legend_live:
                        try:
                            legend_touched = True
                            _ts_legend_apply(layout, legend)
                        except Exception as err:
                            collector.warning(
                                "The legend could not be matched to the visible layers ({0}); "
                                "the frames show the legend as ArcGIS Pro draws it, which can "
                                "lag behind the layer switches.".format(err))
                            legend_live = False
                else:
                    frame.zoomToBookmark(bookmarks[k])
                for element, original in texts:
                    element.text = timestep_fill_template(original, step, len(steps))
                path = os.path.join(frames_dir, names_out[k])
                method = exporter(layout, path, cfg["dpi"])
                if not os.path.isfile(path) or os.path.getsize(path) == 0:
                    raise ToolError("The layout export produced no file for frame {0}.".format(
                        step["index"]), "Check that the layout opens and exports in ArcGIS Pro.")
                paths.append(path)
                frame_rows.append(timestep_manifest_row(
                    step, None if counts is None else counts[k],
                    names_out[k] if keep else "(not kept)", os.path.getsize(path),
                    timestep_sha256(path)))
                progress.tick()
                progress.label("Frame {0} of {1}: {2}".format(step["index"], len(steps), step["label"]))
        finally:
            legend_problems = []
            if legend is not None and legend_touched:
                try:
                    _ts_legend_apply(layout, legend, restore=True)
                except Exception as err:
                    legend_problems.append("The legend entries could not be restored "
                                           "({0}).".format(err))
            problems = legend_problems + _ts_restore(state)
            progress.close()
            for text in problems:
                collector.warning(text)
            if problems == [] and (state["layers"] or texts):
                collector.info("Project state restored (definition queries, visibility, text, "
                               "map frame extent and rotation). The project was not saved.")
        collector.info("Frames exported with {0}.".format(method))
        facts = None
        if gif_ok:
            progress = Progress("Writing the GIF", 0)
            facts = timestep_stitch_gif(paths, cfg["out_gif"],
                                        timestep_durations(len(paths), cfg["frame_ms"],
                                                           cfg["last_hold_ms"]),
                                        cfg["loop"], cfg["palette"], cfg["max_colours"],
                                        cfg["dither"])
            progress.close()
        if cfg["manifest"]:
            timestep_write_manifest(cfg["manifest"], frame_rows)
    finally:
        if not keep:
            shutil.rmtree(frames_dir, ignore_errors=True)
    if facts is None:
        if cfg["manifest"]:
            collector.info("Manifest written to {0}.".format(cfg["manifest"]))
        collector.info("Frames kept in {0}. No GIF was written.".format(frames_dir))
        return {"steps": steps, "rows": frame_rows, "facts": None, "problems": problems,
                "method": method}
    collector.info("GIF written to {0}: {1} frame(s) of {2} x {3} pixels, {4:,} bytes.".format(
        cfg["out_gif"], facts["frames"], facts["size"][0], facts["size"][1], facts["bytes"]))
    if facts["stored_frames"] != facts["frames"]:
        collector.warning(
            "The GIF stores {0} frames, not {1}: the tool merges identical consecutive frames "
            "and adds their durations. The manifest lists all {1}.".format(
                facts["stored_frames"], facts["frames"]))
    for stored_index, wanted_ms in facts.get("capped_delays") or []:
        collector.warning(
            "Frame {0} of the GIF should show for {1} ms (identical frames merged), but a GIF "
            "frame delay is at most {2} ms, so it shows for {2} ms.".format(
                stored_index, wanted_ms, TIMESTEP_GIF_MAX_DELAY_MS))
    if facts["palette_mode"] == "GLOBAL":
        collector.info("One palette for the whole sequence: {0} colour(s) in the frames, {1}.".format(
            facts["sequence_colours"],
            "kept exactly" if facts["exact_palette"] else
            "reduced to {0}".format(facts.get("palette_colours") or cfg["max_colours"])))
    if cfg["dither"]:
        if facts["dithered_frames"] == 0:
            collector.info("Dithering was not applied: the colours of each frame fit the "
                           "palette exactly, and dithering would only add noise.")
        else:
            collector.info("Dithering was applied to {0} of {1} frame(s) whose colours did "
                           "not fit the palette.".format(facts["dithered_frames"],
                                                        facts["frames"]))
    for kind, text in _ts_colour_lines(facts, cfg["max_colours"]):
        (collector.warning if kind == "warning" else collector.info)(text)
    if cfg["manifest"]:
        collector.info("Manifest written to {0}.".format(cfg["manifest"]))
    if keep:
        collector.info("Frames kept in {0}.".format(frames_dir))
    return {"steps": steps, "rows": frame_rows, "facts": facts, "problems": problems,
            "method": method}


def _ts_share_text(share):
    if not share:
        return "no pixel"
    if share < 0.001:
        return "under 0.1% of the pixels"
    return "{0:.1f}% of the pixels".format(100.0 * share)


def _ts_colour_lines(facts, max_colours):
    """``[(kind, text)]`` of the colour-reduction report: one info line, and a warning when a
    colour used by TIMESTEP_SIGNIFICANT_PIXELS or more pixels shifted by more than
    TIMESTEP_NOTICEABLE_SHIFT (of 765), or when TIMESTEP_SHIFTED_SHARE_WARN or more of all
    pixels did. Empty for an exact palette or dithered frames (nothing measured)."""
    mean = facts.get("mean_colour_error")
    if not mean:
        return []
    worst = facts.get("worst_colour_error") or 0
    rare = facts.get("rare_colour_error") or 0
    share = facts.get("shifted_pixel_share") or 0.0
    head = "Colour reduction: mean error {0:.1f} of 255 per channel; ".format(mean)
    if worst:
        body = ("the worst shift of a colour used by {0} or more pixels is {1} (sum over R, G "
                "and B, 0 to 765)".format(TIMESTEP_SIGNIFICANT_PIXELS, worst))
    elif facts.get("frequent_colours"):
        body = ("every colour used by {0} or more pixels was kept exactly; colours used by "
                "fewer pixels shifted by up to {1} (sum over R, G and B, 0 to 765)".format(
                    TIMESTEP_SIGNIFICANT_PIXELS, rare))
    else:
        body = ("no colour is used by {0} or more pixels (very noisy frames), so no worst shift "
                "of such a colour is reported; colours shifted by up to {1} (sum over R, G and "
                "B, 0 to 765)".format(TIMESTEP_SIGNIFICANT_PIXELS, rare))
    lines = [("info", "{0}{1}; {2} shifted by more than {3}.".format(
        head, body, _ts_share_text(share), TIMESTEP_NOTICEABLE_SHIFT))]
    if worst > TIMESTEP_NOTICEABLE_SHIFT or share >= TIMESTEP_SHIFTED_SHARE_WARN:
        hint = ("Fewer basemap colours, a lower Resolution, a higher Maximum Colours or the "
                "PER_FRAME palette can help." if facts.get("palette_mode") == "GLOBAL" else
                "Fewer basemap colours, a lower Resolution or a higher Maximum Colours can "
                "help.")
        lines.append(("warning",
                      "Some colours changed noticeably when the frames were reduced to {0} "
                      "colours (worst shift of a colour used by {1} or more pixels: {2} of 765; "
                      "{3} shifted by more than {4} of 765): check legend swatches, small "
                      "symbols and shaded or image basemaps in the GIF. {5}".format(
                          max_colours, TIMESTEP_SIGNIFICANT_PIXELS, worst, _ts_share_text(share),
                          TIMESTEP_NOTICEABLE_SHIFT, hint)))
    return lines


# --------------------------------------------------------------------------
# The tool
# --------------------------------------------------------------------------

def _ts_number(param, default):
    value = param_number(param, default)
    return default if value is None else value


class TimeStepLayoutExporter(object):
    """Exports a layout once per step and stitches the frames into an animated GIF."""

    DOC = {
        "summary": "Exports a layout once per step and stitches the frames into an animated GIF: "
                   "month by month (or any hour, day, week, month or year step) through a date "
                   "field, one frame per value of an attribute, one frame per layer, or one "
                   "frame per bookmark. A layout text element with {STEP} in its text shows the "
                   "step label in every frame. Frames can be kept with a manifest CSV. The "
                   "project is never saved and everything the tool changes (definition queries, "
                   "visibility, text, map frame extent and rotation) is restored.",
        "usage": "NOT VERIFIED: the Basic licence, starting the tool from the Pro GUI, and "
                 "the memory guard on a real page. "
                 "Needs ArcGIS Pro (arcpy.mp) and, for the GIF only, Pillow (both are in "
                 "ArcGIS Pro's Python; without Pillow the frames and manifest are still written "
                 "when Output Frames Folder is set). No MP4 output is offered: no video encoder "
                 "was found in the Pro 3.3.2 Python environment.\n\n"
                 "Time steps are made with a definition query on the date field of each step "
                 "layer (the project's own Map Time settings are not used: MapFrame.time was "
                 "None after enabling layer time in an arcpy-built project in ArcGIS Pro "
                 "3.3.2, and also in a saved and reopened project; a GUI-built project was "
                 "not tried). The layer's own "
                 "definition query is kept and combined with the step query.\n\n"
                 "In the layout, type a text such as 'Deliveries - {STEP}'. {STEP} is the step "
                 "label, {FROM} and {TO} the first and last time (or value) of the window, "
                 "{INDEX} and {COUNT} the frame number and the number of frames. Every text "
                 "element that contains one of them is changed per frame and restored. In TIME "
                 "mode {STEP} is the start of the step, not the period the frame shows: use "
                 "{TO} (or {FROM} - {TO}) for that period, for example 'cumulative to {TO}' "
                 "(quarterly steps of 2025, last frame: {STEP} = October 2025, {TO} = December "
                 "2025).",
        "params": {
            "project": "The project (.aprx) to use. Leave empty to use the current project when "
                       "the tool runs inside ArcGIS Pro. The tool never saves the project. "
                       "Working on a saved copy is the safest choice.",
            "layout_name": "Name of the layout. Optional when the project has only one layout.",
            "map_frame_name": "Name of the map frame. Optional when the layout has only one.",
            "mode": "TIME (steps through a date field), ATTRIBUTE (one frame per value of a "
                    "field), LAYER_VISIBILITY (one frame per listed layer) or BOOKMARKS (one "
                    "frame per bookmark).",
            "step_layers": "Rows of layer name and field name. TIME: one or more layers with a "
                           "date field. ATTRIBUTE: exactly one layer and field. A layer that is "
                           "switched off, or inside a group that is switched off, is not drawn "
                           "(the run warns).",
            "start_time": "TIME: first instant. Empty = earliest date in the data, rounded down "
                          "to the step unit (to midnight for DAYS and WEEKS: a week step starts "
                          "on the day of the earliest date, not on a fixed weekday).",
            "end_time": "TIME: last instant, included. A date without a time includes that whole "
                        "day. Empty = latest date in the data.",
            "interval": "TIME: length of one step, in units (1 = every month).",
            "interval_unit": "TIME: HOURS, DAYS, WEEKS, MONTHS or YEARS. Month and year steps "
                             "follow the calendar (31 Jan, 28 Feb, 31 Mar).",
            "window_type": "SLIDING shows the last Window Steps steps; CUMULATIVE shows everything "
                           "from the start up to the current step.",
            "window_steps": "Width of a sliding window, in steps (1 = only the current step).",
            "label_format": "TIME: format of the step label. Tokens %Y %y %m %d %H %M %S %b %B. "
                            "Default depends on the unit (for months: %b %Y). The same format "
                            "is used for {STEP} (the start of the step), {FROM} (the start of "
                            "the window) and {TO} (the last second of the window); use {TO} "
                            "to name the period a frame shows. Any other % token is copied as "
                            "typed (the run warns).",
            "label_language": "EN or AR: language of month names in labels (digits stay "
                              "Western).",
            "value_order": "ATTRIBUTE: ASCENDING or DESCENDING. Number fields are ordered by "
                           "value (-10, -2, 0, 1.25, 1.5, 10); text in natural order (2 before "
                           "10), ignoring case. Values of a Single (float32) field are shown in "
                           "their shortest form (1.1, not 1.100000023841858).",
            "step_values": "ATTRIBUTE: your own list of values in the order you want; values not "
                           "listed get no frame. On a date field a value is read as a date "
                           "(2025-01-01 = midnight; 02/01/2025 is month/day/year, 1 February) and "
                           "matched to the second. On a number field "
                           "a value is read as a number with a point as the decimal separator "
                           "and matched by value (2, 2.0 and +2 are the same; 1.1 matches a "
                           "Single field holding 1.1). A listed value that is not in the data "
                           "gives a warning that names the form to use.",
            "visibility_items": "LAYER_VISIBILITY: layer or group layer names; a name listed "
                                "twice is shown in both of its frames. BOOKMARKS: bookmark names "
                                "(empty = all bookmarks); an exact name is matched first, and a "
                                "name that matches two bookmarks only when case is ignored is "
                                "refused.",
            "text_element_name": "Optional: change only the text element with this name. "
                                 "Empty = every text element that contains a placeholder.",
            "resolution": "Export resolution in dpi (default 96).",
            "frame_ms": "Duration of each frame in milliseconds (at least 20). The GIF stores "
                        "delays in steps of 10 ms, so 25 is written as 20.",
            "last_hold_ms": "Duration of the last frame in milliseconds (the hold at the end).",
            "loop_count": "0 = repeat forever. Other values are written as the GIF loop count; "
                          "viewers differ in whether 1 means one or two plays.",
            "palette_mode": "GLOBAL: one palette for the whole sequence (no colour flicker). "
                            "PER_FRAME: each frame has its own palette.",
            "max_colours": "Colours in the GIF palette, 2 to 256. Up to this number of colours "
                           "in the whole sequence the palette is exact. With more colours the "
                           "most frequent colours (page white, black text) are kept exactly "
                           "and part of the palette is reserved for small saturated colours "
                           "(legend swatches, symbols).",
            "dither": "Floyd-Steinberg dithering for frames whose colours do not fit the palette "
                      "(off by default; dithering can make static areas flicker). It is never "
                      "applied to a frame that fits the palette exactly: that would only add "
                      "noise and turn the white page grey.",
            "max_frames": "Safety limit on the number of frames (default 300).",
            "out_gif": "Output animated GIF.",
            "out_frames_folder": "Optional folder in which the PNG frames are kept (created "
                                 "if missing). Other files in it are never deleted; frame "
                                 "files of an earlier run that this run does not replace are "
                                 "left in place and warned about. Without it the frames are "
                                 "deleted after the GIF is written.",
            "out_manifest": "Optional CSV with one row per frame: number, label, time range, "
                            "detail, feature count, file, bytes and SHA-256. Text that Excel "
                            "would run as a formula (starting with =, +, -, @) gets a leading "
                            "apostrophe.",
        },
        "tags": ["layout", "animation", "GIF", "time", "export", "map series"],
    }

    def __init__(self):
        self.label = "Time Series Layout Export"
        self.description = ("Exports a layout once per time step, attribute value, layer or "
                            "bookmark and stitches an animated GIF (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        steps = make_param("step_layers", "Step Layers (layer, field)", "GPValueTable",
                           required=False)
        steps.columns = [["GPString", "Layer"], ["GPString", "Field"]]
        return [
            make_param("project", "Project (empty = current project)", "DEFile", required=False,
                       value_list=["aprx"]),
            make_param("layout_name", "Layout Name", "GPString", required=False),
            make_param("map_frame_name", "Map Frame Name", "GPString", required=False),
            make_param("mode", "Mode", "GPString", default="TIME",
                       value_list=list(TIMESTEP_MODES)),
            steps,
            make_param("start_time", "Start Time", "GPDate", required=False, category="Time"),
            make_param("end_time", "End Time", "GPDate", required=False, category="Time"),
            make_param("interval", "Step Length", "GPLong", required=False, default=1,
                       category="Time"),
            make_param("interval_unit", "Step Unit", "GPString", required=False,
                       default="MONTHS", value_list=list(TIMESTEP_UNITS), category="Time"),
            make_param("window_type", "Window Type", "GPString", required=False,
                       default="SLIDING", value_list=list(TIMESTEP_WINDOWS), category="Steps"),
            make_param("window_steps", "Window Steps", "GPLong", required=False, default=1,
                       category="Steps"),
            make_param("label_format", "Label Format", "GPString", required=False,
                       category="Time"),
            make_param("label_language", "Label Language", "GPString", required=False,
                       default="EN", value_list=list(TIMESTEP_LANGUAGES), category="Time"),
            make_param("value_order", "Value Order", "GPString", required=False,
                       default="ASCENDING", value_list=list(TIMESTEP_ORDERS),
                       category="Steps"),
            make_param("step_values", "Values in Your Order", "GPString", required=False,
                       multi_value=True, category="Steps"),
            make_param("visibility_items", "Layers or Bookmarks", "GPString", required=False,
                       multi_value=True, category="Steps"),
            make_param("text_element_name", "Text Element Name", "GPString", required=False),
            make_param("resolution", "Resolution (dpi)", "GPLong", required=False, default=96,
                       category="Animation"),
            make_param("frame_ms", "Frame Duration (ms)", "GPLong", required=False, default=500,
                       category="Animation"),
            make_param("last_hold_ms", "Last Frame Hold (ms)", "GPLong", required=False,
                       default=2000, category="Animation"),
            make_param("loop_count", "Loop Count (0 = forever)", "GPLong", required=False,
                       default=0, category="Animation"),
            make_param("palette_mode", "Palette", "GPString", required=False, default="GLOBAL",
                       value_list=list(TIMESTEP_PALETTES), category="Animation"),
            make_param("max_colours", "Maximum Colours", "GPLong", required=False, default=256,
                       category="Animation"),
            make_param("dither", "Dither", "GPBoolean", required=False, default=False,
                       category="Animation"),
            make_param("max_frames", "Maximum Frames", "GPLong", required=False, default=300,
                       category="Animation"),
            make_param("out_gif", "Output GIF", "DEFile", direction="Output",
                       value_list=["gif"]),
            # an INPUT folder on purpose (round 15): ArcGIS Pro deletes an existing OUTPUT
            # folder before the run when overwriting is allowed (the frame of an earlier run
            # was gone after the second run of a Pro test), so a folder chosen here could lose
            # every file in it. The tool creates the folder itself when it is missing.
            make_param("out_frames_folder", "Output Frames Folder", "DEFolder",
                       direction="Input", required=False),
            make_param("out_manifest", "Output Manifest (CSV)", "DEFile", direction="Output",
                       required=False, value_list=["csv"]),
        ]

    def isLicensed(self):
        return True

    def updateParameters(self, parameters):
        p = param_map(parameters)
        mode = param_text(p["mode"]) or "TIME"
        for name in TIMESTEP_TIME_PARAMS:
            p[name].enabled = mode == "TIME"
        p["step_layers"].enabled = mode in ("TIME", "ATTRIBUTE")
        p["value_order"].enabled = mode == "ATTRIBUTE"
        p["step_values"].enabled = mode == "ATTRIBUTE"
        p["visibility_items"].enabled = mode in ("LAYER_VISIBILITY", "BOOKMARKS")
        p["window_type"].enabled = mode in TIMESTEP_WINDOW_MODES
        p["window_steps"].enabled = mode in TIMESTEP_WINDOW_MODES
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        mode = param_text(p["mode"]) or "TIME"
        if mode in ("TIME", "ATTRIBUTE"):
            rows = param_value_table(p["step_layers"], 2) if p["step_layers"].values else []
            if not rows:
                p["step_layers"].setErrorMessage("Add at least one row: a layer name and a field "
                                                 "name.")
            elif mode == "ATTRIBUTE" and len(rows) != 1:
                p["step_layers"].setErrorMessage("ATTRIBUTE mode needs exactly one row.")
            elif any(not r[0] or not r[1] for r in rows):
                p["step_layers"].setErrorMessage("Every row needs a layer name and a field name.")
        if mode == "LAYER_VISIBILITY" and not param_list(p["visibility_items"]):
            p["visibility_items"].setErrorMessage("List the layers to show, one frame each.")
        if mode == "TIME":
            try:
                start = timestep_parse_datetime(p["start_time"].value)
                end = timestep_parse_datetime(p["end_time"].value)
            except ToolError as err:
                p["start_time"].setErrorMessage(str(err))
            else:
                if start and end:
                    # the run's own rule: an End Time without a time of day includes that day,
                    # so Start 2025-03-01 with End 2025-03-01 is the whole of 1 March
                    try:
                        timestep_resolve_range(start, end, None, None,
                                               param_text(p["interval_unit"]) or "MONTHS")
                    except ToolError as err:
                        p["end_time"].setErrorMessage(str(err))
            interval = p["interval"].value
            if interval is not None and interval != "" and int(interval) < 1:
                p["interval"].setErrorMessage("The step length must be at least 1.")
        for name, low, high in (("resolution", 36, 600), ("max_frames", 1, 5000),
                                ("max_colours", 2, 256), ("loop_count", 0, 65535)):
            value = p[name].value
            if value is not None and value != "" and not low <= int(value) <= high:
                p[name].setErrorMessage("Enter a value from {0} to {1}.".format(low, high))
        for name in ("frame_ms", "last_hold_ms"):
            value = p[name].value
            if value is not None and value != "" and int(value) < 20:
                p[name].setErrorMessage("At least 20 milliseconds.")
        gif = param_text(p["out_gif"])
        if gif and not gif.casefold().endswith(".gif"):
            p["out_gif"].setErrorMessage("The file name must end in .gif.")
        manifest = param_text(p["out_manifest"])
        if manifest and not manifest.casefold().endswith(".csv"):
            p["out_manifest"].setErrorMessage("The file name must end in .csv.")
        project = param_text(p["project"])
        if project and not project.casefold().endswith(".aprx"):
            p["project"].setErrorMessage("Choose a project file (.aprx), or leave empty.")
        outs = [os.path.normcase(os.path.abspath(t)) for t in (gif, manifest, project) if t]
        if len(set(outs)) != len(outs):
            p["out_gif"].setErrorMessage("Two of the project and the outputs are the same file.")
        _ts_frames_folder_message(p["out_frames_folder"])
        return

    def _config(self, p):
        rows = []
        if p["step_layers"].values:
            rows = [(str(r[0]).strip() if r[0] else "", str(r[1]).strip() if r[1] else "")
                    for r in param_value_table(p["step_layers"], 2)]
        return {
            "project": param_text(p["project"]),
            "layout_name": param_text(p["layout_name"]),
            "frame_name": param_text(p["map_frame_name"]),
            "mode": param_text(p["mode"]) or "TIME",
            "rows": rows,
            "start": p["start_time"].value,
            "end": p["end_time"].value,
            "interval": int(_ts_number(p["interval"], 1)),
            "unit": param_text(p["interval_unit"]) or "MONTHS",
            "window": param_text(p["window_type"]) or "SLIDING",
            "window_steps": int(_ts_number(p["window_steps"], 1)),
            "label_format": param_text(p["label_format"]),
            "language": param_text(p["label_language"]) or "EN",
            "order": param_text(p["value_order"]) or "ASCENDING",
            "listed_values": param_list(p["step_values"]),
            "items": param_list(p["visibility_items"]),
            "text_name": param_text(p["text_element_name"]),
            "dpi": int(_ts_number(p["resolution"], 96)),
            "frame_ms": int(_ts_number(p["frame_ms"], 500)),
            "last_hold_ms": int(_ts_number(p["last_hold_ms"], 2000)),
            "loop": int(_ts_number(p["loop_count"], 0)),
            "palette": param_text(p["palette_mode"]) or "GLOBAL",
            "max_colours": int(_ts_number(p["max_colours"], 256)),
            "dither": param_bool(p["dither"], False),
            "max_frames": int(_ts_number(p["max_frames"], 300)),
            "out_gif": param_text(p["out_gif"]),
            "frames_dir": param_text(p["out_frames_folder"]),
            "manifest": param_text(p["out_manifest"]),
            "overwrite": overwrite_output(),
        }

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            cfg = self._config(p)
            if not cfg["out_gif"]:
                raise ToolError("No output GIF was given.", "Choose the Output GIF.")
            _ts_check_output_paths(cfg, cfg["project"])
            project = _ts_open_project(cfg["project"])
            timestep_run(project, cfg, collector)
            flush_messages(collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            flush_messages(collector)
            raise


# ==========================================================================
# Toolbox (generated)
# ==========================================================================

class Toolbox(object):
    """Cartography & Layout"""

    def __init__(self):
        self.label = "Cartography & Layout"
        self.alias = "cartoqa"
        self.description = "Map book feature index and map series index integrity; attribute and geometry checks only, never rendering. Added since the first list: Time Series Layout Export. All tools run in the foreground (background geoprocessing is not used)." + " (v" + __version__ + ")"
        self.tools = [MapBookFeatureIndex, MapSeriesIndexIntegrity, TimeStepLayoutExporter]
