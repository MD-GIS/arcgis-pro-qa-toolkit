# ==========================================================================
# common/errors.py
# ==========================================================================
# Error type used by every tool: a failure always states its cause and its fix.

class ToolError(Exception):
    """A user-facing failure.

    ``cause`` says what went wrong, ``fix`` says what the user can do about it.
    ``str(err)`` gives one readable sentence pair suitable for ``arcpy.AddError``.
    """

    def __init__(self, cause, fix=None):
        Exception.__init__(self, cause)
        self.cause = cause
        self.fix = fix

    def __str__(self):
        if self.fix:
            return "{0} Fix: {1}".format(self.cause, self.fix)
        return str(self.cause)


# ==========================================================================
# common/numeric.py
# ==========================================================================
# Numbers as ArcGIS stores them: single-precision (FLOAT) values.
#
# FLOAT fields hold 32-bit floats (fieldtypes.html), so a value typed as 0.1
# reads back from a cursor as 0.10000000149011612. Comparing that with the text
# "0.1" or with a DOUBLE 0.1 fails although the user sees the same number.
#
# * ``float32_shortest(value)``: the shortest decimal float that rounds to the
#   same 32-bit value (0.10000000149011612 -> 0.1); non-floats unchanged.
# * ``float32_equal(a, b)``: True when two numbers are the same 32-bit float.
# * ``is_single_field(field)``: True for a FLOAT field dict (``Field.type`` "Single").
# * ``exact_number(value)``: a number for comparisons and dictionary keys that
#   keeps integers exact (BigInteger values above 2**53 stay distinct) while
#   1, 1.0 and "1" stay equal.
#
# Pure Python (``struct``), no arcpy. Shared by every toolbox: reuse these
# instead of adding another copy.

_NUMERIC_SINGLE_TYPES = frozenset(["single", "float"])
# Integer text as ArcGIS writes it: ASCII digits only, optional sign.
_NUMERIC_INT_TEXT = re.compile(r"^[+-]?[0-9]+$")


def _numeric_pack(value):
    """4-byte single-precision form of ``value`` or ``None`` (overflow, not a number)."""
    try:
        return struct.pack("<f", value)
    except (OverflowError, struct.error, TypeError):
        return None


def float32_shortest(value):
    """Shortest decimal float with the same single-precision value as ``value``.

    Non-floats, NaN, infinities and values outside the single range are
    returned unchanged.
    """
    if not isinstance(value, float) or value != value or value in (float("inf"), float("-inf")):
        return value
    target = _numeric_pack(value)
    if target is None:
        return value
    for digits in range(1, 10):
        candidate = float("{0:.{1}g}".format(value, digits))
        if _numeric_pack(candidate) == target:
            return candidate
    return value


def float32_equal(a, b):
    """True if numbers ``a`` and ``b`` are the same single-precision value."""
    if isinstance(a, bool) or isinstance(b, bool):
        return False
    try:
        fa, fb = float(a), float(b)
    except (TypeError, ValueError):
        return False
    pa, pb = _numeric_pack(fa), _numeric_pack(fb)
    return pa is not None and pa == pb


def is_single_field(field):
    """True for a FLOAT (single-precision) field dict."""
    return str(field.get("type") or "").casefold() in _NUMERIC_SINGLE_TYPES


def exact_number(value):
    """``value`` as an exact number (``int`` or ``float``), or ``None``.

    ``float()`` loses the last digits of integers above 2**53 (BigInteger
    fields, 16+ digit identifiers), so two different keys or codes would
    compare equal. Integers stay ``int`` here, integer text ("0012",
    "9007199254740993") becomes ``int``, other numbers and numeric text become
    ``float``. Python's ``int`` and ``float`` compare and hash exactly, so 1,
    1.0 and "1" still give equal keys. NaN and values that are not numbers
    give ``None``.
    """
    if value is None:
        return None
    if isinstance(value, int):
        return int(value)  # bool -> 0 / 1, as float() gave
    if isinstance(value, float):
        return None if value != value else value
    if isinstance(value, str):
        text = value.strip()
        if _NUMERIC_INT_TEXT.match(text):
            try:
                return int(text)
            except ValueError:  # over Python's integer text limit
                return None
    try:
        number = float(value)
    except (TypeError, ValueError, OverflowError):
        return None
    return None if number != number else number


# ==========================================================================
# common/messages.py
# ==========================================================================
# Message collector so pure cores can report progress without importing arcpy.
#
# A core appends messages to a ``MessageCollector``; the tool adapter later sends
# them to ArcGIS Pro (see ``arcio.flush_messages``). Levels follow the toolkit
# rule: ``info`` for normal progress, ``warning`` only for things the user must
# act on, ``error`` only for real failure.

MESSAGE_INFO = "info"
MESSAGE_WARNING = "warning"
MESSAGE_ERROR = "error"


class MessageCollector(object):
    """Ordered list of ``(level, text)`` pairs."""

    def __init__(self):
        self.items = []

    def info(self, text):
        self.items.append((MESSAGE_INFO, str(text)))

    def warning(self, text):
        self.items.append((MESSAGE_WARNING, str(text)))

    def error(self, text):
        self.items.append((MESSAGE_ERROR, str(text)))

    def extend(self, other):
        """Append all messages of another collector, keeping their order."""
        self.items.extend(other.items)

    def texts(self, level=None):
        """Message texts, optionally only those of one level."""
        return [t for (lvl, t) in self.items if level is None or lvl == level]

    def has_errors(self):
        return any(lvl == MESSAGE_ERROR for (lvl, _t) in self.items)

    def counts(self):
        """Number of messages per level, e.g. ``{"info": 3, "warning": 1, "error": 0}``."""
        result = {MESSAGE_INFO: 0, MESSAGE_WARNING: 0, MESSAGE_ERROR: 0}
        for lvl, _t in self.items:
            result[lvl] = result.get(lvl, 0) + 1
        return result

    def clear(self):
        self.items = []

    def __len__(self):
        return len(self.items)


# ==========================================================================
# common/text.py
# ==========================================================================
# Text normalisation, placeholder detection, scripts, edit distance, natural sort.
#
# Pure Python (stdlib only). Every character set is a fixed, documented constant
# so results never depend on the Python or Unicode database version for the
# characters that matter here.
#
# Main entry points:
#
# * ``to_nfc(text)``: Unicode canonical composition (NFC). ``normalize_text``
#   and ``arabic_normalize`` always apply it first, so a decomposed spelling
#   (macOS export, PDF copy: "u" + combining diaeresis, Arabic yeh + combining
#   hamza) gets the same result as the precomposed one.
# * ``normalize_text(value, ...)``: options-driven cleaning (whitespace,
#   invisible marks, control characters, digits, case, Arabic folding).
# * ``arabic_normalize(text, ...)``: Arabic-aware folding (tashkeel, tatweel,
#   alef forms, alef maqsura / teh marbuta options, Persian letters, digits).
# * ``is_placeholder(value, ...)``: "N/A", "-", "null", "none", "0000" ...
# * ``script_of(text)`` / ``script_profile(text)``: Arabic / Latin / mixed / digits.
# * ``levenshtein`` / ``damerau_levenshtein``: bounded edit distances.
# * ``natural_sort_key``: "Lot 2" before "Lot 10".
#
# ``None`` is passed through unchanged by every normaliser (a null is not an
# empty string; callers decide how to report it).

# --------------------------------------------------------------------------
# Character sets (fixed lists)
# --------------------------------------------------------------------------

# Whitespace that is folded to an ordinary space: ASCII space and tab, NBSP,
# U+1680, U+2000-U+200A, U+202F, U+205F, U+3000. Line breaks are separate.
TEXT_SPACES = frozenset(
    [u" ", u"\u0009", u" ", u" ", u" ", u" ", u"　"]
    + [chr(c) for c in range(0x2000, 0x200B)])

# Line breaks: LF, CR, VT, FF, NEL, LINE SEPARATOR, PARAGRAPH SEPARATOR.
TEXT_LINE_BREAKS = frozenset([u"\n", u"\r", u"\x0b", u"\x0c", u"\x85", u" ", u" "])

# Invisible format characters removed by ``remove_invisible``: zero width
# space, BOM / zero width no-break space, word joiner, soft hyphen, LRM, RLM,
# Arabic letter mark, bidi embeddings/overrides (U+202A-202E) and isolates
# (U+2066-2069).
TEXT_INVISIBLE = frozenset(
    [u"​", u"﻿", u"⁠", u"­", u"‎", u"‏", u"؜"]
    + [chr(c) for c in range(0x202A, 0x202F)]
    + [chr(c) for c in range(0x2066, 0x206A)])

# Zero width non-joiner / joiner. They change Arabic and Persian shaping, so
# they are removed only when asked (``joiners=True``).
TEXT_JOINERS = frozenset([u"‌", u"‍"])

# Arabic harakat / tashkeel: U+064B-U+065F, superscript alef U+0670,
# Quranic marks U+06D6-U+06ED (excluding U+06DD/U+06DE symbols) and U+0610-061A.
TEXT_ARABIC_TASHKEEL = frozenset(
    [chr(c) for c in range(0x064B, 0x0660)] + [u"ٰ"]
    + [chr(c) for c in range(0x0610, 0x061B)]
    + [chr(c) for c in range(0x06D6, 0x06EE) if c not in (0x06DD, 0x06DE, 0x06E5, 0x06E6)])
TEXT_ARABIC_TATWEEL = u"ـ"

# Alef with madda / hamza above / hamza below / wasla -> bare alef.
TEXT_ALEF_FORMS = {u"آ": u"ا", u"أ": u"ا", u"إ": u"ا",
                   u"ٱ": u"ا"}
TEXT_ALEF_MAQSURA = {u"ى": u"ي"}      # alef maqsura -> yeh
TEXT_TEH_MARBUTA = {u"ة": u"ه"}       # teh marbuta -> heh
# Persian / Urdu letters -> Arabic equivalents (keheh -> kaf, farsi yeh -> yeh).
TEXT_PERSIAN_LETTERS = {u"ک": u"ك", u"ی": u"ي"}

# Arabic-Indic (U+0660-0669) and extended / Persian (U+06F0-06F9) digits -> ASCII.
TEXT_DIGIT_MAP = dict([(chr(0x0660 + i), str(i)) for i in range(10)]
                      + [(chr(0x06F0 + i), str(i)) for i in range(10)])
# Arabic decimal separator and thousands separator (only with separators=True).
TEXT_ARABIC_SEPARATORS = {u"٫": u".", u"٬": u","}

# Default placeholder spellings (compared after trim, whitespace collapse and
# casefold). All-zero strings are handled separately (``zero_run``).
TEXT_DEFAULT_PLACEHOLDERS = frozenset([
    u"n/a", u"n.a.", u"na", u"n\\a", u"-", u"--", u"---", u"null", u"<null>", u"none",
    u"nil", u"?", u"??", u".", u"unknown", u"tbd", u"#n/a", u"x"])


# --------------------------------------------------------------------------
# Small building blocks
# --------------------------------------------------------------------------

def collapse_whitespace(text, keep_line_breaks=False):
    """Fold every ``TEXT_SPACES`` character (and line breaks, unless
    ``keep_line_breaks``) to one space, collapse runs and trim the ends."""
    if text is None:
        return None
    out = []
    pending = False
    for ch in text:
        if ch in TEXT_SPACES or (not keep_line_breaks and ch in TEXT_LINE_BREAKS):
            pending = True
            continue
        if ch in TEXT_LINE_BREAKS:
            # keep the break itself; drop spaces around it
            out.append(ch)
            pending = False
            continue
        if pending and out and out[-1] not in TEXT_LINE_BREAKS:
            out.append(u" ")
        pending = False
        out.append(ch)
    return u"".join(out).strip(u" ")


def has_line_breaks(text):
    """True if ``text`` contains any ``TEXT_LINE_BREAKS`` character."""
    return bool(text) and any(ch in TEXT_LINE_BREAKS for ch in text)


def is_control_char(ch):
    """True for C0/C1 control characters other than line breaks and tab."""
    if ch in TEXT_LINE_BREAKS or ch == u"\t":
        return False
    return unicodedata.category(ch) == "Cc"


def has_control_chars(text):
    """True if ``text`` contains a control character (see ``is_control_char``)."""
    return bool(text) and any(is_control_char(ch) for ch in text)


def strip_control_chars(text, line_breaks=False):
    """Remove control characters; with ``line_breaks=True`` also line breaks and tabs."""
    if text is None:
        return None
    return u"".join(ch for ch in text if not is_control_char(ch)
                    and not (line_breaks and (ch in TEXT_LINE_BREAKS or ch == u"\t")))


def remove_invisible(text, joiners=False):
    """Remove ``TEXT_INVISIBLE`` marks (and ZWNJ/ZWJ when ``joiners``)."""
    if text is None:
        return None
    return u"".join(ch for ch in text if ch not in TEXT_INVISIBLE
                    and not (joiners and ch in TEXT_JOINERS))


def has_invisible(text, joiners=True):
    """True if ``text`` contains an invisible mark (ZWNJ/ZWJ count unless ``joiners=False``)."""
    return bool(text) and any(ch in TEXT_INVISIBLE or (joiners and ch in TEXT_JOINERS)
                              for ch in text)


def fold_digits(text, separators=False):
    """Arabic-Indic and Persian digits -> ASCII; with ``separators`` also
    U+066B -> "." and U+066C -> ","."""
    if text is None:
        return None
    out = []
    for ch in text:
        if ch in TEXT_DIGIT_MAP:
            out.append(TEXT_DIGIT_MAP[ch])
        elif separators and ch in TEXT_ARABIC_SEPARATORS:
            out.append(TEXT_ARABIC_SEPARATORS[ch])
        else:
            out.append(ch)
    return u"".join(out)


def to_nfc(text):
    """Unicode canonical composition (NFC) of a text; anything else (``None``,
    numbers, dates) is returned unchanged.

    Canonically equivalent spellings look identical and must compare equal:
    "u" + U+0308 becomes U+00FC, Arabic yeh + combining hamza above
    (U+064A U+0654) becomes U+0626. Only canonical equivalence is applied
    (not NFKC), so ligatures, superscripts and full-width forms are kept.
    """
    if isinstance(text, str):
        return unicodedata.normalize("NFC", text)
    return text


def _text_is_presentation_form(ch):
    c = ord(ch)
    return (0xFB50 <= c <= 0xFDFF) or (0xFE70 <= c <= 0xFEFE)


def _text_presentation_nfkc(ch):
    """NFKC of one presentation form. The isolated tashkeel forms (U+FE70-FE7E) and the
    shadda ligatures (U+FC5E-FC63) decompose into SPACE + mark(s); the space only carries
    the sign, so it is dropped (otherwise removing the mark as tashkeel leaves a space)."""
    comp = unicodedata.normalize("NFKC", ch)
    if len(comp) > 1 and comp[0] == u" " and all(unicodedata.combining(c) for c in comp[1:]):
        return comp[1:]
    return comp


def arabic_normalize(text, tashkeel=True, tatweel=True, alef=True, alef_maqsura=True,
                     teh_marbuta=False, persian=True, digits=True, presentation=True,
                     marks=True):
    """Arabic-aware folding; each step is an option.

    Unicode NFC is always applied first (``to_nfc``): without it a combining
    hamza (U+0654) of a decomposed spelling would be removed as tashkeel,
    while its precomposed equivalent U+0626 is kept.

    * ``presentation``: Arabic presentation forms (U+FB50-FDFF, U+FE70-FEFE)
      are decomposed with NFKC, applied to those code points only;
    * ``tashkeel``: remove ``TEXT_ARABIC_TASHKEEL``; ``tatweel``: remove U+0640;
    * ``alef``: U+0622/0623/0625/0671 -> U+0627;
    * ``alef_maqsura``: U+0649 -> U+064A (on by default);
    * ``teh_marbuta``: U+0629 -> U+0647 (off by default: it changes meaning);
    * ``persian``: U+06A9 -> U+0643, U+06CC -> U+064A;
    * ``digits``: Arabic-Indic / Persian digits -> ASCII;
    * ``marks``: remove invisible marks including ZWNJ/ZWJ, LRM/RLM, ALM.
    """
    if text is None:
        return None
    text = to_nfc(text)
    if presentation:
        text = u"".join(_text_presentation_nfkc(ch) if _text_is_presentation_form(ch) else ch
                        for ch in text)
    out = []
    for ch in text:
        if tashkeel and ch in TEXT_ARABIC_TASHKEEL:
            continue
        if tatweel and ch == TEXT_ARABIC_TATWEEL:
            continue
        if marks and (ch in TEXT_INVISIBLE or ch in TEXT_JOINERS):
            continue
        if alef and ch in TEXT_ALEF_FORMS:
            ch = TEXT_ALEF_FORMS[ch]
        elif alef_maqsura and ch in TEXT_ALEF_MAQSURA:
            ch = TEXT_ALEF_MAQSURA[ch]
        elif teh_marbuta and ch in TEXT_TEH_MARBUTA:
            ch = TEXT_TEH_MARBUTA[ch]
        elif persian and ch in TEXT_PERSIAN_LETTERS:
            ch = TEXT_PERSIAN_LETTERS[ch]
        elif digits and ch in TEXT_DIGIT_MAP:
            ch = TEXT_DIGIT_MAP[ch]
        out.append(ch)
    return u"".join(out)


def strip_leading_zeros(text):
    """``"007"`` -> ``"7"`` and ``"000"`` -> ``"0"`` for ASCII-digit-only strings;
    anything else is returned unchanged."""
    if text and text.isascii() and text.isdigit():
        return text.lstrip(u"0") or u"0"
    return text


def date_text(value):
    """ISO text of a date/time value; a datetime at exactly 00:00:00 is written as
    the date only ("2024-01-05"), so a DATE field value at midnight, a DATEONLY
    value and an ISO date typed as text give the same text. Other values: ``None``.
    """
    if isinstance(value, datetime.datetime):
        if value.time() == datetime.time(0, 0):
            return value.date().isoformat()
        return value.isoformat(" ")
    if isinstance(value, (datetime.date, datetime.time)):
        return value.isoformat()
    return None


def value_to_text(value):
    """Text form of a cell value for key comparison.

    ``None`` stays ``None``; integral floats lose ``.0`` (``1.0`` -> ``"1"``);
    other numbers use ``repr``-exact ``str``; bools become ``"True"``/``"False"``.
    """
    if value is None:
        return None
    if isinstance(value, bool):
        return str(value)
    if isinstance(value, float):
        if value != value or value in (float("inf"), float("-inf")):
            return str(value)
        if value == int(value):
            return str(int(value))
        return repr(value)
    if isinstance(value, bytes):
        return value.decode("utf-8", "replace")
    return value if isinstance(value, str) else str(value)


def normalize_text(value, trim=True, collapse=True, casefold=False, invisible=True,
                   controls=True, digits=True, leading_zeros=False, arabic=None):
    """Options-driven normalisation of one value (``None`` stays ``None``).

    Order: ``value_to_text`` -> Unicode NFC (always, ``to_nfc``) -> controls
    (removed, line breaks kept for ``collapse``) -> invisible marks -> Arabic (``arabic`` is ``None`` for
    off, ``True`` for defaults, or a dict of ``arabic_normalize`` options)
    -> digits -> whitespace (``collapse`` folds all spaces and line breaks
    to one space; else only ``trim``) -> casefold -> leading zeros.
    """
    text = value_to_text(value)
    if text is None:
        return None
    text = to_nfc(text)
    if controls:
        text = strip_control_chars(text)
    if invisible:
        text = remove_invisible(text)
    if arabic:
        text = arabic_normalize(text, **(arabic if isinstance(arabic, dict) else {}))
    if digits:
        text = fold_digits(text)
    if collapse:
        text = collapse_whitespace(text)
    elif trim:
        text = text.strip(u"".join(sorted(TEXT_SPACES | TEXT_LINE_BREAKS)))
    if casefold:
        text = text.casefold()
    if leading_zeros:
        text = strip_leading_zeros(text)
    return text


def is_blank(value):
    """True for ``None`` and for text that is empty after removing whitespace,
    line breaks and invisible marks."""
    if value is None:
        return True
    if not isinstance(value, str):
        return False
    return collapse_whitespace(remove_invisible(value, joiners=True)) == u""


def is_placeholder(value, placeholders=None, zero_run=3, blank=False):
    """True if ``value`` is a placeholder such as "N/A", "-", "null", "none".

    The value is compared after invisible-mark removal, digit folding,
    whitespace collapse and casefold with ``placeholders`` (an iterable of
    spellings, compared casefolded; default ``TEXT_DEFAULT_PLACEHOLDERS``).
    ``zero_run``: strings of at least this many zeros and nothing else
    ("000", "0000") count; ``None``/0 disables. ``blank``: empty/whitespace
    counts as a placeholder too (default False: report blanks separately).
    Non-text values (numbers, dates, ``None``) are never placeholders.
    """
    if not isinstance(value, str):
        return False
    text = collapse_whitespace(fold_digits(remove_invisible(value, joiners=True))).casefold()
    if text == u"":
        return bool(blank)
    pool = TEXT_DEFAULT_PLACEHOLDERS if placeholders is None else \
        frozenset(collapse_whitespace(str(p)).casefold() for p in placeholders)
    if text in pool:
        return True
    if zero_run and len(text) >= zero_run and text.strip(u"0") == u"":
        return True
    return False


# --------------------------------------------------------------------------
# Scripts
# --------------------------------------------------------------------------

SCRIPT_ARABIC = "arabic"
SCRIPT_LATIN = "latin"
SCRIPT_MIXED = "mixed"
SCRIPT_DIGITS = "digits"
SCRIPT_OTHER = "other"
SCRIPT_EMPTY = "empty"

_TEXT_ARABIC_BLOCKS = ((0x0600, 0x06FF), (0x0750, 0x077F), (0x08A0, 0x08FF),
                       (0xFB50, 0xFDFF), (0xFE70, 0xFEFF))


def _text_in_arabic_block(c):
    for lo, hi in _TEXT_ARABIC_BLOCKS:
        if lo <= c <= hi:
            return True
    return False


def script_profile(text):
    """Character counts: ``{"arabic", "latin", "other_letters", "ascii_digits",
    "arabic_digits", "other_digits", "other"}``.

    Letters are Unicode category L*; Arabic = letters in the Arabic blocks;
    Latin = letters whose Unicode name starts with "LATIN". Combining marks
    (tashkeel), spaces and punctuation count as "other".
    """
    counts = {"arabic": 0, "latin": 0, "other_letters": 0, "ascii_digits": 0,
              "arabic_digits": 0, "other_digits": 0, "other": 0}
    for ch in text or u"":
        cat = unicodedata.category(ch)
        c = ord(ch)
        if cat == "Nd":
            if u"0" <= ch <= u"9":
                counts["ascii_digits"] += 1
            elif ch in TEXT_DIGIT_MAP:
                counts["arabic_digits"] += 1
            else:
                counts["other_digits"] += 1
        elif cat.startswith("L"):
            if _text_in_arabic_block(c):
                counts["arabic"] += 1
            elif unicodedata.name(ch, "").startswith("LATIN"):
                counts["latin"] += 1
            else:
                counts["other_letters"] += 1
        else:
            counts["other"] += 1
    return counts


def script_of(text):
    """Dominant script of ``text``.

    ``"empty"`` (no letters or digits), ``"digits"`` (digits only, any
    script), ``"arabic"``, ``"latin"``, ``"other"`` (letters of one other
    script family) or ``"mixed"`` (letters of more than one of Arabic /
    Latin / other). Digits never make a text mixed.
    """
    p = script_profile(text)
    families = [k for k in ("arabic", "latin", "other_letters") if p[k]]
    if not families:
        if p["ascii_digits"] or p["arabic_digits"] or p["other_digits"]:
            return SCRIPT_DIGITS
        return SCRIPT_EMPTY
    if len(families) > 1:
        return SCRIPT_MIXED
    return {"arabic": SCRIPT_ARABIC, "latin": SCRIPT_LATIN,
            "other_letters": SCRIPT_OTHER}[families[0]]


def has_mixed_digits(text):
    """True if ``text`` mixes ASCII digits with Arabic-Indic/Persian digits."""
    p = script_profile(text)
    return bool(p["ascii_digits"] and p["arabic_digits"])


# --------------------------------------------------------------------------
# Edit distance
# --------------------------------------------------------------------------

def levenshtein(a, b, max_distance=None):
    """Levenshtein distance (insert, delete, substitute; each cost 1).

    With ``max_distance`` the computation stops early and returns
    ``max_distance + 1`` as soon as the distance is known to exceed it.
    ``None`` inputs are treated as empty strings.
    """
    a = a or u""
    b = b or u""
    if a == b:
        return 0
    if len(a) < len(b):
        a, b = b, a
    if max_distance is not None and len(a) - len(b) > max_distance:
        return max_distance + 1
    if not b:
        return len(a)
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i] + [0] * len(b)
        row_min = i
        for j, cb in enumerate(b, 1):
            cost = 0 if ca == cb else 1
            v = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            cur[j] = v
            if v < row_min:
                row_min = v
        if max_distance is not None and row_min > max_distance:
            return max_distance + 1
        prev = cur
    d = prev[-1]
    if max_distance is not None and d > max_distance:
        return max_distance + 1
    return d


def damerau_levenshtein(a, b, max_distance=None):
    """Optimal-string-alignment distance: Levenshtein plus transposition of
    two adjacent characters (cost 1). A substring is never edited twice, so
    ``("CA", "ABC")`` is 3 (the unrestricted Damerau distance would be 2).

    ``max_distance`` bounds as in ``levenshtein``.
    """
    a = a or u""
    b = b or u""
    if a == b:
        return 0
    if max_distance is not None and abs(len(a) - len(b)) > max_distance:
        return max_distance + 1
    if not a or not b:
        return max(len(a), len(b))
    n = len(b)
    two_back = None
    prev = list(range(n + 1))
    prev_min = 0
    for i in range(1, len(a) + 1):
        cur = [i] + [0] * n
        row_min = i
        for j in range(1, n + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            v = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            if (two_back is not None and j > 1 and a[i - 1] == b[j - 2]
                    and a[i - 2] == b[j - 1]):
                v = min(v, two_back[j - 2] + 1)
            cur[j] = v
            if v < row_min:
                row_min = v
        # Later cells come from this row or, by a transposition, from the
        # previous row plus 1: both minima bound the final distance.
        if max_distance is not None and min(row_min, prev_min + 1) > max_distance:
            return max_distance + 1
        two_back, prev, prev_min = prev, cur, row_min
    d = prev[-1]
    if max_distance is not None and d > max_distance:
        return max_distance + 1
    return d


# --------------------------------------------------------------------------
# Natural sort
# --------------------------------------------------------------------------

def natural_sort_key(value):
    """Sort key that orders digit runs numerically: "Lot 2" < "Lot 10".

    Digits are folded to ASCII first (Arabic-Indic digits sort as numbers),
    text chunks are compared casefolded, and the raw text is the last
    tie-break, so the order is total and deterministic ("7" < "007" < "07"
    is decided by the raw strings). ``None`` sorts before every text;
    non-text values are converted with ``value_to_text``. Signs and decimal
    points are not interpreted ("1.5" is 1, ".", 5).
    """
    if value is None:
        return (0, (), u"")
    raw = value_to_text(value)
    text = fold_digits(raw)
    chunks = []
    i = 0
    n = len(text)
    while i < n:
        j = i
        if text[i].isascii() and text[i].isdigit():
            while j < n and text[j].isascii() and text[j].isdigit():
                j += 1
            chunks.append((0, int(text[i:j]), u""))
        else:
            while j < n and not (text[j].isascii() and text[j].isdigit()):
                j += 1
            chunks.append((1, 0, text[i:j].casefold()))
        i = j
    return (1, tuple(chunks), raw)


# ==========================================================================
# common/issues.py
# ==========================================================================
# Unified QC issue schema and the adapters that fill it (pure Python, no arcpy).
#
# The QC Scorecard Report reads the Detail outputs of the toolkit's quality tools and
# turns every row into one *issue*, a plain dict with the keys of
# ``UNI_FIELDS`` (``RUN_ID`` is added by the caller)::
#
#     TOOL, RULE_ID, SOURCE, SRC_OID, SEVERITY, X, Y, MESSAGE, FIELD, VALUE
#
# There is **one adapter function per tool**; none of the tools is changed. The column
# names an adapter expects are the REAL names ArcGIS Pro wrote in the captured
# outputs (``tests/fixtures/pro/<Tool>/<case>/``), not names taken from documents:
#
# =========================  =======================================================
# GeometryQualityChecker     SRC_OID, CHECK, PART, VERTEX, VALUE, UNIT, DETAIL
#                            (point feature class; location = the point)
# DomainConformanceAudit     SRC_TABLE, SRC_OID, FIELD, SUBTYPE_CODE, DOMAIN, VALUE,
#                            ISSUE, SUGGESTED (table: no location of its own)
# LineNetworkRules           RULE, LAYER, SRC_OID, NODE_ID, DEGREE, VALUE, DETAIL
#                            (point feature class; location = the point)
# unified table              RULE_ID, SEVERITY, MESSAGE and SRC_OID (or OID); optional
#                            RUN_ID, TOOL, SOURCE, X, Y, FIELD, VALUE
# =========================  =======================================================
#
# A row given to an adapter is a dict ``{column name: value}`` plus the special keys
# ``"_xy"`` (``(x, y)`` taken from the row's geometry, or ``None``). Columns an
# adapter does not know are not lost: they are appended to MESSAGE as ``NAME=value``.
#
# The tools write no severity. ``UNI_SEVERITY_BY_RULE`` is this toolkit's own default
# classification (a judgement, not a standard); the Atlas lets a threshold table
# override it per rule.

UNI_TOOL_GEOMETRY = "GeometryQualityChecker"
UNI_TOOL_DOMAIN = "DomainConformanceAudit"
UNI_TOOL_NETWORK = "LineNetworkRules"
UNI_TOOL_UNIFIED = "UNIFIED"
UNI_TOOLS = (UNI_TOOL_GEOMETRY, UNI_TOOL_DOMAIN, UNI_TOOL_NETWORK, UNI_TOOL_UNIFIED)
UNI_TOOL_AUTO = "AUTO"

UNI_ERROR = "ERROR"
UNI_WARNING = "WARNING"
UNI_INFO = "INFO"
UNI_SEVERITIES = (UNI_ERROR, UNI_WARNING, UNI_INFO)

# Column order of the unified issue table. The handoff calls the object id column OID;
# the toolkit's own outputs all call it SRC_OID and OID is not used as a field name here.
UNI_FIELDS = ("RUN_ID", "TOOL", "RULE_ID", "SOURCE", "SRC_OID", "SEVERITY", "X", "Y",
              "MESSAGE", "FIELD", "VALUE")

UNI_MESSAGE_MAX = 1000   # characters kept in MESSAGE
UNI_VALUE_MAX = 254      # characters kept in VALUE / FIELD / SOURCE / RULE_ID

# Default severity per rule (the tools write none). Unknown rules: UNI_DEFAULT_SEVERITY.
UNI_DEFAULT_SEVERITY = UNI_WARNING
UNI_SEVERITY_BY_RULE = {
    # GeometryQualityChecker
    "SPIKE": UNI_ERROR,
    "NEAR_DUP_VERTEX": UNI_ERROR,
    "SHORT_SEGMENT": UNI_WARNING,
    "SLIVER": UNI_WARNING,
    "TINY_AREA": UNI_WARNING,
    "TINY_PART": UNI_WARNING,
    "REMOTE_PART": UNI_WARNING,
    # DomainConformanceAudit: the stored value is not a valid code of its domain
    "OUT_OF_DOMAIN": UNI_ERROR,
    "OUT_OF_RANGE": UNI_ERROR,
    "DESCRIPTION_AS_CODE": UNI_ERROR,
    "CASE_OR_SPACE_VARIANT": UNI_ERROR,
    "AMBIGUOUS_DESCRIPTION": UNI_ERROR,
    "INVALID_SUBTYPE": UNI_ERROR,
    "NULL_VALUE": UNI_WARNING,
    # LineNetworkRules
    "DANGLE": UNI_ERROR,
    "PSEUDO_NODE": UNI_WARNING,
    "T_MISS": UNI_ERROR,
    "WIDE_NODE_CLUSTER": UNI_WARNING,
    "POINT_NOT_ON_LINE": UNI_ERROR,
    "POINT_NOT_ON_ENDPOINT": UNI_ERROR,
}

# Columns that belong to the table itself, never to the issue.
_UNI_SYSTEM_COLUMNS = frozenset(["OBJECTID", "FID", "SHAPE", "SHAPE_LENGTH", "SHAPE_AREA",
                                 "SHAPE_LEN", "GLOBALID", "OID@", "SHAPE@", "SHAPE@JSON"])

# Required columns (upper case) per tool; a table is recognised as the first whose
# required columns are all present (unified first, then the others).
_UNI_REQUIRED = (
    (UNI_TOOL_UNIFIED, ("RULE_ID", "SEVERITY", "MESSAGE")),
    (UNI_TOOL_GEOMETRY, ("SRC_OID", "CHECK", "DETAIL")),
    (UNI_TOOL_DOMAIN, ("SRC_TABLE", "SRC_OID", "FIELD", "DOMAIN", "VALUE", "ISSUE")),
    (UNI_TOOL_NETWORK, ("RULE", "LAYER", "SRC_OID", "DETAIL")),
)
# Known (consumed) columns per tool; everything else goes to MESSAGE.
_UNI_KNOWN = {
    UNI_TOOL_GEOMETRY: ("SRC_OID", "CHECK", "PART", "VERTEX", "VALUE", "UNIT", "DETAIL"),
    UNI_TOOL_DOMAIN: ("SRC_TABLE", "SRC_OID", "FIELD", "SUBTYPE_CODE", "DOMAIN", "VALUE",
                      "ISSUE", "SUGGESTED"),
    UNI_TOOL_NETWORK: ("RULE", "LAYER", "SRC_OID", "NODE_ID", "DEGREE", "VALUE", "DETAIL"),
    UNI_TOOL_UNIFIED: ("RUN_ID", "TOOL", "RULE_ID", "SOURCE", "SRC_OID", "OID", "SEVERITY",
                       "X", "Y", "MESSAGE", "FIELD", "VALUE"),
}
# The hygiene table of DomainConformanceAudit (out_domain_table) is a different output.
_UNI_DOMAIN_HYGIENE = ("DOMAIN", "RECORD_TYPE", "ISSUE")


def uni_clean_text(value, limit=None):
    """Text for a table or an HTML page: ``None`` stays ``None``; control characters
    (except tab and line breaks, which become spaces) are removed; the text is cut to
    ``limit`` characters with an ellipsis."""
    if value is None:
        return None
    if isinstance(value, float):
        text = uni_format_number(value)
    else:
        text = str(value)
    out = []
    for ch in text:
        if ch in "\t\r\n":
            out.append(" ")
        elif ord(ch) < 32 or ord(ch) in (127, 0xFFFE, 0xFFFF) or 0xD800 <= ord(ch) <= 0xDFFF:
            continue
        else:
            out.append(ch)
    text = "".join(out).strip()
    if limit is not None and len(text) > limit:
        text = text[:max(limit - 3, 0)] + "..."
    return text


def uni_format_number(value):
    """Short text of a number (6 significant digits); other values as text."""
    if isinstance(value, bool):
        return str(value)
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        if math.isnan(value) or math.isinf(value):
            return ""
        return "{0:.6g}".format(value)
    return str(value)


def uni_normalise_severity(value, default=UNI_DEFAULT_SEVERITY):
    """``ERROR`` / ``WARNING`` / ``INFO`` from any capitalisation (``WARN`` too);
    ``(severity, recognised)`` where ``recognised`` is False when ``default`` was used."""
    text = str(value).strip().upper() if value is not None else ""
    aliases = {"ERR": UNI_ERROR, "CRITICAL": UNI_ERROR, "WARN": UNI_WARNING,
               "INFORMATION": UNI_INFO, "NOTE": UNI_INFO}
    text = aliases.get(text, text)
    if text in UNI_SEVERITIES:
        return text, True
    return default, False


def uni_severity_for(rule_id):
    """Default severity of a rule id (``UNI_DEFAULT_SEVERITY`` for an unknown rule)."""
    return UNI_SEVERITY_BY_RULE.get(str(rule_id).strip().upper(), UNI_DEFAULT_SEVERITY)


def _uni_upper_row(row):
    """``{UPPER NAME: value}`` of the attribute columns of a row (special keys dropped)."""
    return dict((str(k).upper(), v) for k, v in row.items() if not str(k).startswith("_"))


def uni_detect_tool(columns):
    """Which tool's Detail output (or the unified schema) a table with these column
    names is; ``None`` when none matches. Names are compared in upper case."""
    names = set(str(c).upper() for c in columns)
    if "OID" in names and "SRC_OID" not in names:
        names.add("SRC_OID")   # the unified schema as the handoff spells it
    for tool, required in _UNI_REQUIRED:
        if all(name in names for name in required):
            return tool
    return None


def uni_missing_columns(tool, columns):
    """Required columns (upper case) of ``tool`` that a table with ``columns`` lacks."""
    names = set(str(c).upper() for c in columns)
    if "OID" in names and "SRC_OID" not in names:
        names.add("SRC_OID")
    for name, required in _UNI_REQUIRED:
        if name == tool:
            return [c for c in required if c not in names]
    return []


def uni_is_domain_hygiene_table(columns):
    """True for the usage / hygiene table of DomainConformanceAudit (not an issue table)."""
    names = set(str(c).upper() for c in columns)
    return all(name in names for name in _UNI_DOMAIN_HYGIENE) and "SRC_OID" not in names


def uni_describe_columns_needed():
    """Text for an error message: the columns each supported table must have."""
    parts = []
    for tool, required in _UNI_REQUIRED:
        parts.append("{0}: {1}".format("unified issue table" if tool == UNI_TOOL_UNIFIED else tool,
                                       ", ".join(required)))
    return "; ".join(parts)


def _uni_extras(upper_row, tool):
    """Text ``NAME=value`` of the columns the adapter does not know (empty values skipped)."""
    known = set(_UNI_KNOWN[tool])
    parts = []
    for name in sorted(upper_row):
        if name in known or name in _UNI_SYSTEM_COLUMNS:
            continue
        value = upper_row[name]
        if value is None or (isinstance(value, str) and not value.strip()):
            continue
        parts.append("{0}={1}".format(name, uni_clean_text(value, 80)))
    return "; ".join(parts)


def _uni_message(text, extras, rule_id):
    text = uni_clean_text(text) or ""
    if not text:
        text = str(rule_id)
    if extras:
        text = "{0} [{1}]".format(text, extras)
    return uni_clean_text(text, UNI_MESSAGE_MAX)


def _uni_xy(row):
    xy = row.get("_xy")
    if xy is None:
        return None, None
    try:
        x, y = float(xy[0]), float(xy[1])
    except (TypeError, ValueError, IndexError):
        return None, None
    if math.isnan(x) or math.isnan(y) or math.isinf(x) or math.isinf(y):
        return None, None
    return x, y


def _uni_int(value):
    try:
        if value is None or (isinstance(value, str) and not value.strip()):
            return None
        if isinstance(value, int) and not isinstance(value, bool):
            return value
        if isinstance(value, str):
            try:
                # a text ObjectID field (``arcio.oid_field_spec`` in a folder) keeps every digit;
                # float() would round ids of more than 15 digits
                return int(value.strip())
            except ValueError:
                pass
        return int(float(value))
    except (TypeError, ValueError, OverflowError):
        return None


def _uni_issue(tool, rule_id, source, oid, severity, x, y, message, field, value,
               sev_from="default"):
    """One issue. ``_sev_from`` says where the severity came from: ``default`` (the toolkit's
    default for the rule; the source tools write none), ``table`` (a unified table's own
    SEVERITY column) or ``guess`` (an unrecognised value, taken as WARNING)."""
    return {"_sev_from": sev_from, "TOOL": tool,
            "RULE_ID": uni_clean_text(rule_id, UNI_VALUE_MAX) or "UNKNOWN",
            "SOURCE": uni_clean_text(source, UNI_VALUE_MAX),
            "SRC_OID": oid, "SEVERITY": severity, "X": x, "Y": y,
            "MESSAGE": message,
            "FIELD": uni_clean_text(field, UNI_VALUE_MAX),
            "VALUE": uni_clean_text(value, UNI_VALUE_MAX)}


def adapt_geometry_quality(rows, source=None):
    """GeometryQualityChecker ``out_features`` rows -> issues.

    RULE_ID = CHECK; SOURCE = ``source`` (the checked dataset; the tool's output carries no
    dataset name); SRC_OID = SRC_OID; X, Y = the error point; MESSAGE = DETAIL;
    VALUE = VALUE + UNIT (for example ``2.29153 deg``). PART and VERTEX are only in DETAIL.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("CHECK")
        severity = uni_severity_for(rule)
        x, y = _uni_xy(row)
        value = r.get("VALUE")
        value_text = None
        if value is not None and uni_format_number(value) != "":
            value_text = uni_format_number(value)
            if r.get("UNIT"):
                value_text += " " + str(r["UNIT"])
        message = _uni_message(r.get("DETAIL"), _uni_extras(r, UNI_TOOL_GEOMETRY), rule)
        out.append(_uni_issue(UNI_TOOL_GEOMETRY, rule, source, _uni_int(r.get("SRC_OID")),
                              severity, x, y, message, None, value_text))
    return out


_UNI_DOMAIN_TEXT = {
    "OUT_OF_DOMAIN": "is not a code of domain {domain}",
    "OUT_OF_RANGE": "is outside the range of domain {domain}",
    "DESCRIPTION_AS_CODE": "is the description of a code of domain {domain}, not the code",
    "CASE_OR_SPACE_VARIANT": "differs from a code of domain {domain} only by case or spaces",
    "AMBIGUOUS_DESCRIPTION": "matches more than one description of domain {domain}",
    "INVALID_SUBTYPE": "is not a defined subtype",
    "NULL_VALUE": "is empty although domain {domain} applies",
}


def adapt_domain_conformance(rows, source=None):
    """DomainConformanceAudit ``out_table`` rows (violations) -> issues.

    RULE_ID = ISSUE; SOURCE = SRC_TABLE (``source`` only when that is empty); SRC_OID = SRC_OID;
    FIELD = FIELD; VALUE = VALUE; MESSAGE is built from the columns (field, value, domain,
    subtype, suggestion). The table has no geometry, so X and Y are empty unless the caller
    locates the feature later (``QcScorecardAtlas`` does, from the checked dataset).
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("ISSUE")
        field = r.get("FIELD")
        value = r.get("VALUE")
        domain = r.get("DOMAIN")
        template = _UNI_DOMAIN_TEXT.get(str(rule).strip().upper() if rule is not None else "",
                                        "has the issue " + str(rule))
        shown = "empty" if value is None else "'{0}'".format(uni_clean_text(value, 120))
        text = "Field {0}: value {1} {2}".format(field, shown,
                                                 template.format(domain=domain or "(none)"))
        if r.get("SUBTYPE_CODE") is not None and uni_format_number(r["SUBTYPE_CODE"]) != "":
            text += " (subtype {0})".format(uni_format_number(r["SUBTYPE_CODE"]))
        if r.get("SUGGESTED") not in (None, ""):
            text += "; suggested: {0}".format(uni_clean_text(r["SUGGESTED"], 80))
        message = _uni_message(text + ".", _uni_extras(r, UNI_TOOL_DOMAIN), rule)
        table = r.get("SRC_TABLE")
        x, y = _uni_xy(row)
        out.append(_uni_issue(UNI_TOOL_DOMAIN, rule, table if table not in (None, "") else source,
                              _uni_int(r.get("SRC_OID")), uni_severity_for(rule), x, y, message,
                              field, value))
    return out


def adapt_line_network_rules(rows, source=None):
    """LineNetworkRules ``out_errors`` rows -> issues.

    RULE_ID = RULE; SOURCE = LAYER (``source`` only when that is empty; point-rule rows name
    the rule-point layer); SRC_OID = SRC_OID; X, Y = the error point; MESSAGE = DETAIL;
    VALUE = VALUE (metres) when present. NODE_ID and DEGREE are not carried.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("RULE")
        x, y = _uni_xy(row)
        value = r.get("VALUE")
        value_text = None
        if value is not None and uni_format_number(value) != "":
            value_text = uni_format_number(value) + " m"
        layer = r.get("LAYER")
        message = _uni_message(r.get("DETAIL"), _uni_extras(r, UNI_TOOL_NETWORK), rule)
        out.append(_uni_issue(UNI_TOOL_NETWORK, rule, layer if layer not in (None, "") else source,
                              _uni_int(r.get("SRC_OID")), uni_severity_for(rule), x, y, message,
                              None, value_text))
    return out


def adapt_unified(rows, source=None):
    """Rows already in the unified schema -> issues.

    SEVERITY is normalised (an unrecognised one becomes WARNING and the issue gets
    ``"_severity_guess": True``). X and Y come from the columns X and Y, else from the row's
    geometry. TOOL defaults to ``UNIFIED``; SOURCE to ``source``. RUN_ID is not carried.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("RULE_ID")
        severity, recognised = uni_normalise_severity(r.get("SEVERITY"))
        x, y = None, None
        try:
            if r.get("X") is not None and r.get("Y") is not None:
                x, y = float(r["X"]), float(r["Y"])
                if math.isnan(x) or math.isnan(y) or math.isinf(x) or math.isinf(y):
                    x, y = None, None
        except (TypeError, ValueError):
            x, y = None, None
        if x is None:
            x, y = _uni_xy(row)
        oid = _uni_int(r.get("SRC_OID") if r.get("SRC_OID") is not None else r.get("OID"))
        tool = uni_clean_text(r.get("TOOL"), UNI_VALUE_MAX) or UNI_TOOL_UNIFIED
        extras = _uni_extras(r, UNI_TOOL_UNIFIED)
        message = _uni_message(r.get("MESSAGE"), extras, rule)
        src = r.get("SOURCE")
        issue = _uni_issue(tool, rule, src if src not in (None, "") else source, oid, severity,
                           x, y, message, r.get("FIELD"), r.get("VALUE"),
                           "table" if recognised else "guess")
        if not recognised:
            issue["_severity_guess"] = True
        out.append(issue)
    return out


UNI_ADAPTERS = {UNI_TOOL_GEOMETRY: adapt_geometry_quality,
                UNI_TOOL_DOMAIN: adapt_domain_conformance,
                UNI_TOOL_NETWORK: adapt_line_network_rules,
                UNI_TOOL_UNIFIED: adapt_unified}


def uni_adapt(tool, rows, source=None):
    """Issues of ``rows`` with the adapter of ``tool`` (one of ``UNI_TOOLS``)."""
    return UNI_ADAPTERS[tool](rows, source)


def uni_issue_row(issue, run_id):
    """Values of one issue in ``UNI_FIELDS`` order (for the output table)."""
    values = dict(issue)
    values["RUN_ID"] = run_id
    return [values.get(name) for name in UNI_FIELDS]


# ==========================================================================
# common/fields.py
# ==========================================================================
# Field lookup that tolerates the way people actually type field names.
#
# Rule (toolkit engineering rule 1): match the **alias first, then the name**,
# ignoring case, spaces, dashes and underscores. The caller is told which one
# matched so it can report it. Two or more candidates is an error that lists them;
# the tool never guesses.
#
# Fields are plain dicts as returned by ``arcio.describe_dataset``::
#
#     {"name": "NAME_EN", "alias": "Name (English)", "type": "String",
#      "length": 50, "domain": None, ...}

# Characters ignored when comparing field names (besides all Unicode whitespace).
_FIELDS_IGNORED = frozenset("-_‐‑‒–—ـ")  # dashes, underscore, Arabic tatweel

MATCHED_BY_ALIAS = "alias"
MATCHED_BY_NAME = "name"


def normalize_field_name(text):
    """Comparison key for a field name or alias.

    NFKC-normalises (so Arabic presentation forms and full-width Latin compare
    equal to their plain forms), case-folds, and drops whitespace, dashes,
    underscores and the Arabic tatweel.
    """
    if text is None:
        return ""
    text = unicodedata.normalize("NFKC", str(text)).casefold()
    return "".join(ch for ch in text if not ch.isspace() and ch not in _FIELDS_IGNORED)


def describe_field(field):
    """Human readable ``NAME (alias: Alias)`` label for messages."""
    alias = field.get("alias")
    if alias and alias != field["name"]:
        return "{0} (alias: {1})".format(field["name"], alias)
    return field["name"]


def match_field(fields, wanted, required=True, label=None, exact_name_first=False):
    """Find the field the user means by ``wanted``.

    Returns ``(field, matched_by)`` where ``matched_by`` is ``"alias"`` or
    ``"name"``; returns ``(None, None)`` when nothing matches and ``required``
    is False. Raises ``ToolError`` for an ambiguous match, or for no match when
    ``required`` is True. ``label`` names the parameter in messages.

    ``exact_name_first``: use it when ``wanted`` comes from a ``Field``
    parameter (a field *name* picked from the list). A field whose name equals
    ``wanted`` exactly (then ignoring case only) wins before any alias, so a
    different field that merely carries that text as its alias is never used.
    Rule 1 (alias first, tolerant comparison) still applies when nothing has
    that exact name, e.g. for typed or configured names.
    """
    if exact_name_first and wanted:
        for same in (lambda n: n == wanted, lambda n: n.casefold() == str(wanted).casefold()):
            hits = [f for f in fields if f.get("name") is not None and same(f["name"])]
            if len(hits) == 1:
                return hits[0], MATCHED_BY_NAME
    key = normalize_field_name(wanted)
    what = label or "field"
    if not key:
        if required:
            raise ToolError("No {0} was given.".format(what),
                            "Choose a field from the list.")
        return None, None

    for matched_by, attr in ((MATCHED_BY_ALIAS, "alias"), (MATCHED_BY_NAME, "name")):
        hits = [f for f in fields if normalize_field_name(f.get(attr)) == key]
        if len(hits) == 1:
            return hits[0], matched_by
        if len(hits) > 1:
            raise ToolError(
                "The {0} '{1}' is ambiguous: it matches the {2} of {3} fields: {4}.".format(
                    what, wanted, attr, len(hits), ", ".join(describe_field(f) for f in hits)),
                "Type the exact field name instead, or rename one of the fields or aliases.")

    if required:
        available = ", ".join(describe_field(f) for f in fields) or "(none)"
        raise ToolError(
            "The {0} '{1}' was not found by alias or by name.".format(what, wanted),
            "Choose one of the available fields: {0}.".format(available))
    return None, None


def match_fields(fields, wanted_names, label=None, exact_name_first=False):
    """Resolve several required fields at once.

    Returns a list of ``(wanted, field, matched_by)`` in the given order.
    """
    return [(w,) + match_field(fields, w, True, label, exact_name_first) for w in wanted_names]


def match_message(wanted, field, matched_by):
    """Message text reporting how a field was resolved."""
    return "Field '{0}' matched {1} by {2}.".format(wanted, describe_field(field), matched_by)


def text_field_length(values, minimum=1):
    """Width for a text field that must hold every value in ``values``.

    ``None`` values are ignored; other values are measured as ``str(value)``.
    Engineering rule 8: text widths are derived from the longest value written.
    """
    longest = 0
    for value in values:
        if value is not None:
            longest = max(longest, len(str(value)))
    return max(int(minimum), longest)


# ==========================================================================
# common/domains.py
# ==========================================================================
# Coded-value and range domains, at field AND subtype level, as plain dicts.
#
# Engineering rule 2: read domains at field and subtype level, never guess a
# code, and when a needed value is not in the domain stop with a message that
# lists the accepted values.
#
# Structures (built by ``arcio.read_domains`` / ``arcio.read_subtypes``, or by
# hand in tests)::
#
#     domains = {"D_Status": {"name": "D_Status", "domain_type": "CodedValue",
#                             "field_type": "Short",
#                             "codes": {1: "Active", 2: "Retired"},
#                             "range": None}}
#
#     subtypes = {"field": "ROAD_CLASS",          # "" when the table has no subtypes
#                 "subtypes": {1: {"name": "Primary",
#                                  "domains": {"SURFACE": "D_Surface_Primary"}}}}
#
# Field-level domains come from the field dicts (``field["domain"]``).

_DOMAINS_NUMERIC_TYPES = frozenset(
    ["short", "long", "smallinteger", "integer", "biginteger", "float", "single", "double"])


def domain_for_field(field_name, field_domain, subtypes=None, subtype_code=None):
    """Name of the domain that applies to ``field_name`` for one row.

    If the table has a subtype field and ``subtype_code`` is one of its
    subtypes that lists this field, the subtype-level domain wins (``None``
    there means the subtype deliberately has no domain). Otherwise the
    field-level domain ``field_domain`` applies.
    """
    if subtypes and subtypes.get("field") and subtype_code is not None:
        entry = _domains_find_subtype(subtypes, subtype_code)
        if entry is not None:
            per_field = entry.get("domains") or {}
            for name, dom in per_field.items():
                if name.casefold() == str(field_name).casefold():
                    return dom or None
    return field_domain or None


def _domains_find_subtype(subtypes, code):
    table = subtypes.get("subtypes") or {}
    if code in table:
        return table[code]
    for key, entry in table.items():
        if _domains_same_value(key, code, numeric=True):
            return entry
    return None


def _domains_is_numeric(domain):
    return str(domain.get("field_type") or "").casefold() in _DOMAINS_NUMERIC_TYPES


def _domains_same_value(a, b, numeric):
    """Equality that treats 1, 1.0 and "1" as equal for numeric domains only."""
    if a is None or b is None:
        return a is b
    if numeric:
        # exact_number, not float(): BigInteger codes above 2**53 stay distinct.
        na, nb = exact_number(a), exact_number(b)
        return na is not None and na == nb
    return str(a) == str(b)


def accepted_values_text(domain, limit=50):
    """``code = description`` list for messages (truncated after ``limit``)."""
    if domain.get("domain_type") == "Range":
        low, high = domain.get("range") or (None, None)
        return "a value from {0} to {1}".format(low, high)
    pairs = ["{0} = {1}".format(c, d) for c, d in (domain.get("codes") or {}).items()]
    if len(pairs) > limit:
        pairs = pairs[:limit] + ["... ({0} more)".format(len(pairs) - limit)]
    return "; ".join(pairs) if pairs else "(the domain has no codes)"


class CodedValueIndex(object):
    """Set of the codes of one coded-value domain, built once.

    ``value in index`` gives the same answer as ``value_in_domain`` (numbers
    compared exactly for numeric domains, so "1", 1 and 1.0 are equal; text
    compared as text) in constant time instead of a scan over every code.
    """

    def __init__(self, domain):
        self.numeric = _domains_is_numeric(domain)
        self.keys = set()
        for code in (domain.get("codes") or {}):
            key = self._key(code)
            if key is not None:
                self.keys.add(key)

    def _key(self, value):
        if value is None:
            return None
        return exact_number(value) if self.numeric else str(value)

    def __contains__(self, value):
        key = self._key(value)
        return key is not None and key in self.keys


def value_in_domain(domain, value, index=None):
    """True if ``value`` is allowed by ``domain``. Nulls are not violations.

    ``index`` (a ``CodedValueIndex`` of a coded-value ``domain``) makes the
    test a dictionary lookup; pass it when testing many values.
    """
    if value is None or domain is None:
        return True
    numeric = _domains_is_numeric(domain)
    if domain.get("domain_type") == "Range":
        low, high = domain.get("range") or (None, None)
        lo, hi, number = exact_number(low), exact_number(high), exact_number(value)
        if lo is None or hi is None or number is None:
            return False
        return lo <= number <= hi
    if index is not None:
        return value in index
    return any(_domains_same_value(code, value, numeric) for code in (domain.get("codes") or {}))


def code_description(domain, code):
    """Description of ``code`` or ``None`` if it is not in the domain."""
    numeric = _domains_is_numeric(domain)
    for key, desc in (domain.get("codes") or {}).items():
        if _domains_same_value(key, code, numeric):
            return desc
    return None


def require_code(domain, value, field_name=None):
    """Return the stored code for ``value``, which may be a code or a description.

    Codes are tried first (exact type-aware match), then descriptions
    (case-insensitive). Raises ``ToolError`` listing the accepted values when
    there is no match, or when a description matches more than one code.
    """
    where = " for field '{0}'".format(field_name) if field_name else ""
    name = domain.get("name", "?")
    if domain.get("domain_type") == "Range":
        if value_in_domain(domain, value) and value is not None:
            return value
        raise ToolError(
            "The value '{0}'{1} is outside the range domain '{2}'.".format(value, where, name),
            "Use {0}.".format(accepted_values_text(domain)))
    numeric = _domains_is_numeric(domain)
    codes = domain.get("codes") or {}
    for code in codes:
        if _domains_same_value(code, value, numeric):
            return code
    wanted = str(value).strip().casefold()
    hits = [code for code, desc in codes.items() if str(desc).strip().casefold() == wanted]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        raise ToolError(
            "The description '{0}'{1} matches several codes in domain '{2}': {3}.".format(
                value, where, name, ", ".join(str(h) for h in hits)),
            "Give the code itself instead of the description.")
    raise ToolError(
        "The value '{0}'{1} is not in the coded-value domain '{2}'.".format(value, where, name),
        "Use one of the accepted values: {0}.".format(accepted_values_text(domain)))


# --------------------------------------------------------------------------
# Domains of fields copied to a new output
# --------------------------------------------------------------------------

def domain_fits_field_type(domain, keyword):
    """True when an output-workspace domain (``arcio.read_domains`` entry) can be
    assigned to a field of AddField type ``keyword`` (same field type, or a type
    that is not reported)."""
    field_type = str((domain or {}).get("field_type") or "")
    return not field_type or field_type.casefold() == str(keyword).casefold()


def keep_field_domain(spec, domain_name, out_domains):
    """Carry the field-level domain ``domain_name`` of a copied field to its
    output field spec (for ``arcio.add_fields``), as Copy Features does.

    ``out_domains``: the domains of the output workspace (``arcio.read_domains``
    / ``arcio.read_output_domains``; ``{}`` for a folder). The spec gets
    ``"domain"`` when that workspace has a domain of that name for the spec's
    field type, else ``"lost_domain"`` (see ``lost_domain_warning``). No domain:
    the spec is unchanged. Subtypes and subtype-level domains are not carried.
    Returns ``spec``.
    """
    if domain_name:
        if out_domains is not None and domain_name in out_domains and \
                domain_fits_field_type(out_domains[domain_name], spec["type"]):
            spec["domain"] = domain_name
        else:
            spec["lost_domain"] = domain_name
    return spec


def lost_domain_warning(specs, output):
    """Warning text, or ``None``, naming the copied fields of ``specs``
    (``keep_field_domain``) whose domain the output workspace of ``output`` does
    not have (same rule and wording as the datamgmt tools)."""
    lost = ["{0} ({1})".format(s["name"], s["lost_domain"]) for s in specs
            if s.get("lost_domain")]
    if not lost:
        return None
    return ("The workspace of {0} does not have the domain(s) of these copied fields (or has "
            "one of that name for another field type), so they have no domain there and show "
            "codes instead of descriptions: {1}. Add the domains to the output geodatabase and "
            "assign them (Assign Domain To Field), or write the output to the input's "
            "geodatabase.".format(output, ", ".join(lost)))


# ==========================================================================
# common/paths.py
# ==========================================================================
# Catalog path handling that never relies on the host operating system.
#
# Engineering rule 4: never destroy input. Before any delete or overwrite the
# tool compares normalised catalog paths and refuses if an output equals an
# input. ``os.path.normcase`` does nothing outside Windows, so normalisation is
# done by hand: separators, duplicate separators, trailing separators, ``.`` and
# ``..`` segments, Unicode form and case.

# Path components that end a workspace (everything after them is inside it).
_PATHS_WORKSPACE_EXTS = (".gdb", ".sde", ".gpkg", ".geodatabase", ".mdb")


def normalize_catalog_path(path):
    """Comparison key for a catalog path; not meant to be shown to users.

    ``C:/Data//City.GDB/Roads/`` and ``c:\\data\\city.gdb\\roads`` give the same key.
    """
    if path is None:
        return ""
    text = unicodedata.normalize("NFC", str(path).strip()).replace("/", "\\")
    unc = text.startswith("\\\\")
    parts = []
    for part in text.split("\\"):
        if part in ("", "."):
            continue
        if part == ".." and parts and parts[-1] != "..":
            parts.pop()
            continue
        parts.append(part)
    joined = "\\".join(parts)
    if unc:
        joined = "\\\\" + joined
    return joined.casefold()


# Files that belong to one shapefile / dBASE table in a folder workspace. In a
# folder, ``name``, ``name.shp`` and ``name.dbf`` (and every sidecar) are one
# dataset: Pro writes a table ``folder\name`` as ``name.dbf`` and a feature
# class as ``name.shp`` + ``name.shx`` + ``name.dbf`` + ...
FOLDER_DATASET_EXTS = (".shp", ".dbf", ".shx", ".prj", ".cpg", ".sbn", ".sbx", ".qix", ".fbn",
                       ".fbx", ".ain", ".aih", ".atx", ".ixs", ".mxs", ".xml")


def _paths_folder_stem(name):
    """Base name without shapefile/dBASE extensions (``roads.shp.xml`` -> ``roads``)."""
    text = str(name)
    while True:
        dot = text.rfind(".")
        if dot <= 0 or text[dot:].casefold() not in FOLDER_DATASET_EXTS:
            return text
        text = text[:dot]


def dataset_identity(path):
    """Canonical identity of the dataset a catalog path names (comparison key).

    * Geodatabase (and memory) datasets: ``<workspace>\\<name>``, ignoring case
      and separators; feature datasets are transparent (names are unique in a
      geodatabase), so ``a.gdb\\fds\\roads`` == ``a.gdb\\roads``.
    * Folder workspaces: ``<folder>\\<base name>`` without shapefile/dBASE
      extensions, so ``t``, ``t.dbf``, ``T.DBF``, ``t.shp`` and ``t.shx`` are the
      same dataset (they share one file set, and Pro resolves ``t`` to
      ``t.dbf`` / ``t.shp``). Other files (``t.csv``) keep their extension.
    * GeoPackage: ``x.gpkg\\main.roads`` (the way ArcGIS Pro lists it) and ``x.gpkg\\roads``
      are the same dataset.
    * A workspace path itself is its own identity.
    Returns ``""`` for an empty path.
    """
    if path is None or not str(path).strip():
        return ""
    text = str(path).strip()
    workspace = workspace_of(text)
    key = normalize_catalog_path(text)
    if not workspace or normalize_catalog_path(workspace) == key:
        return key
    name = split_catalog_path(text)[1]
    if is_folder_workspace(workspace):
        name = _paths_folder_stem(name)
    elif normalize_catalog_path(workspace).endswith(".gpkg") and name.casefold().startswith("main."):
        name = name[len("main."):]  # GeoPackage datasets are listed as <file>.gpkg\\main.<name>
    return normalize_catalog_path(workspace + "\\" + name)


def folder_dataset_candidates(path):
    """Paths an output may really occupy: for a folder output without a
    shapefile/dBASE extension, also ``.shp`` and ``.dbf`` (Pro adds one)."""
    text = str(path)
    workspace, name = split_catalog_path(text)
    if workspace and is_folder_workspace(workspace) and _paths_folder_stem(name) == name \
            and "." not in name:
        return [text, text + ".shp", text + ".dbf"]
    return [text]


def same_dataset(a, b):
    """True if two catalog paths name the same dataset (``dataset_identity``)."""
    key_a = dataset_identity(a)
    return bool(key_a) and key_a == dataset_identity(b)


# Run-scoped register of every dataset/file the running tool reads (quality review
# D1/D2: an input that a tool forgot to pass in ``inputs`` was overwritten). While a
# run is active (``arcio.guarded_run`` around ``execute``), ``refuse_if_same`` and the
# report checks compare outputs with these paths too, so a forgotten input can no
# longer be replaced. Outside a run (dialog validation) nothing is registered.
#
# Tables joined to an input layer are registered too, by NAME only: a layer reports
# the catalog path of its own table, never of the tables joined to it, so an
# output or report named like a joined table is refused in any workspace
# (conservative; re-review N1 of LineNetworkRules, first done in carto only).
_PATHS_RUN = {"active": False, "inputs": [], "joined": set()}

# Extensions of file tables a join can read (a qualifier such as ``valves.csv``).
_PATHS_JOIN_FILE_EXTS = ("csv", "txt", "tab", "dbf", "shp", "xls", "xlsx")


def begin_input_register():
    """Start a run: clear and activate the register of read datasets."""
    _PATHS_RUN["active"] = True
    _PATHS_RUN["inputs"] = []
    _PATHS_RUN["joined"] = set()


def end_input_register():
    """End a run: clear and deactivate the register."""
    _PATHS_RUN["active"] = False
    _PATHS_RUN["inputs"] = []
    _PATHS_RUN["joined"] = set()


def joined_table_names(fields):
    """Case-folded names of the tables a layer reads through joins.

    With a join, a layer's fields are qualified ``<table>.<field>`` (an enterprise
    table ``db.owner.table.field``); the table name is the last part before the
    field. The layer's own table is listed too (its fields are qualified as well).
    For a file table (``valves.csv.FIELD``) the file name and its stem are listed
    as well. A layer without qualified field names gives an empty set. ``fields``
    are dicts with a ``"name"`` (``arcio.field_info``) or objects with ``.name``.
    """
    names = set()
    for field in fields or []:
        name = (field.get("name") if isinstance(field, dict) else getattr(field, "name", "")) or ""
        if "." in name:
            qualifier = name.rsplit(".", 1)[0]
            pieces = qualifier.split(".")
            table = pieces[-1].strip()
            if table:
                names.add(table.casefold())
            if len(pieces) > 1 and table.casefold() in _PATHS_JOIN_FILE_EXTS and pieces[-2].strip():
                names.add((pieces[-2].strip() + "." + table).casefold())
                names.add(pieces[-2].strip().casefold())
    return names


def register_joined_tables(names):
    """Record names of tables joined to an input layer (ignored outside a run)."""
    if not _PATHS_RUN["active"]:
        return
    _PATHS_RUN["joined"].update(n.casefold() for n in names or () if n)


def registered_joined_tables():
    """Names registered by ``register_joined_tables`` (empty outside a run)."""
    return set(_PATHS_RUN["joined"]) if _PATHS_RUN["active"] else set()


def _paths_output_base(path):
    """Case-folded output name without a ``.shp`` / ``.dbf`` extension."""
    name = split_catalog_path(path)[1]
    if name.casefold().endswith((".dbf", ".shp")):
        name = name[:-4]
    return name.casefold()


def refuse_joined_table_outputs(outputs, joined):
    """Raise ``ToolError`` if an output has the name of a table read through a join.

    The output==input check compares catalog paths, and a layer reports only the
    path of its own table, not of the tables joined to it. So an output named
    like any table of a joined layer (``joined_table_names``) is refused, whatever
    its workspace (conservative: the joined table's workspace is not known).
    A report file is matched by its file name and by its name without extension.
    """
    if not joined:
        return
    for out in outputs:
        if not out:
            continue
        name = split_catalog_path(out)[1].casefold()
        candidates = set([_paths_output_base(out), name])
        if "." in name:
            candidates.add(name.rsplit(".", 1)[0])
        hit = sorted(candidates & set(joined))
        if hit:
            raise ToolError(
                "The output '{0}' has the name of a table that an input layer reads through "
                "a join ({1}); it could replace that table.".format(out, hit[0]),
                "Choose another output name, or remove the join from the layer.")


def register_inputs(paths):
    """Record datasets/files the running tool reads (ignored outside a run)."""
    if not _PATHS_RUN["active"]:
        return
    for path in paths or ():
        if path and str(path).strip() and path not in _PATHS_RUN["inputs"]:
            _PATHS_RUN["inputs"].append(path)


def registered_inputs():
    """Datasets/files registered by the running tool (empty outside a run)."""
    return list(_PATHS_RUN["inputs"]) if _PATHS_RUN["active"] else []


def refuse_if_same(outputs, inputs):
    """Raise ``ToolError`` if any output path equals any input path.

    ``None`` and empty entries are ignored. Inputs must already be resolved to
    catalog paths (a layer name is not a path; see ``arcio.describe_dataset``).
    During a guarded run every registered input (``registered_inputs``) is
    compared as well, whether or not the caller listed it, and an output named
    like a registered joined table (``registered_joined_tables``) is refused.
    """
    inputs = list(inputs or ()) + registered_inputs()
    refuse_joined_table_outputs(outputs, registered_joined_tables())
    for out in outputs:
        if not out:
            continue
        for inp in inputs:
            if inp and same_dataset(out, inp):
                raise ToolError(
                    "The output '{0}' is the same dataset as the input '{1}'.".format(out, inp),
                    "Choose a different output name or location; this tool never overwrites its input.")


def split_catalog_path(path):
    """Split into ``(parent, name)`` on the last ``\\`` or ``/``."""
    text = str(path).rstrip("\\/")
    cut = max(text.rfind("\\"), text.rfind("/"))
    if cut < 0:
        return "", text
    return text[:cut], text[cut + 1:]


def workspace_of(catalog_path):
    """Workspace that contains a dataset.

    The workspace is the path up to the last component ending in ``.gdb``,
    ``.sde``, ``.gpkg``, ``.geodatabase`` or ``.mdb`` (so a feature class
    inside a feature dataset still maps to its geodatabase); ``memory`` and
    ``in_memory`` are workspaces too. Otherwise (shapefiles, dBASE tables) it
    is the parent folder. The original spelling is kept.
    """
    text = str(catalog_path).rstrip("\\/")
    pieces = text.replace("/", "\\").split("\\")
    for i in range(len(pieces) - 1, -1, -1):
        low = pieces[i].casefold()
        if low.endswith(_PATHS_WORKSPACE_EXTS) or (i == 0 and low in ("memory", "in_memory")):
            if i == len(pieces) - 1:
                return text  # the path is itself a workspace
            return _paths_rejoin(text, i + 1)
    return split_catalog_path(text)[0]


def _paths_rejoin(text, count):
    """First ``count`` components of ``text`` with its original separators."""
    seen = 0
    for pos, ch in enumerate(text):
        if ch in "\\/":
            seen += 1
            if seen == count:
                return text[:pos]
    return text


def is_folder_workspace(workspace):
    """True if the workspace is a plain folder (shapefiles, dBASE).

    A container inside a geodatabase is not a folder: a feature dataset
    (``C:\\QA\\city.gdb\\Checks``, the parent ``split_catalog_path`` gives for an
    output in it) follows the rules of its geodatabase, so any component
    ending in ``.gdb``, ``.sde``, ``.gpkg``, ``.geodatabase`` or ``.mdb`` (or a
    leading ``memory`` / ``in_memory``) makes this False (RT7-Q-2).
    """
    pieces = str(workspace).rstrip("\\/").replace("/", "\\").split("\\")
    for i, piece in enumerate(pieces):
        low = piece.casefold()
        if low.endswith(_PATHS_WORKSPACE_EXTS) or (i == 0 and low in ("memory", "in_memory")):
            return False
    return True


def find_duplicate_outputs(outputs):
    """First pair ``(a, b)`` of outputs that name the same dataset, else ``None``.

    ``None`` and empty entries are ignored. Use it in ``updateMessages`` and
    at the start of ``execute`` so one output can never silently replace
    another output of the same run.
    """
    seen = {}
    for out in outputs:
        if not out:
            continue
        key = dataset_identity(out)
        if key in seen:
            return seen[key], out
        seen[key] = out
    return None


def refuse_duplicate_outputs(outputs):
    """Raise ``ToolError`` if two outputs are the same dataset."""
    pair = find_duplicate_outputs(outputs)
    if pair:
        raise ToolError(
            "Two outputs are the same dataset: '{0}' and '{1}'.".format(pair[0], pair[1]),
            "Give every output its own name.")


# ==========================================================================
# common/projection.py
# ==========================================================================
# Choose a projected, metric coordinate system for measuring.
#
# Engineering rule 3: lengths, areas and distances are measured in a projected
# metric system chosen from the data extent; degrees are never treated as
# metres. This module is pure: it decides *which* system to use. ``arcio``
# creates the ``arcpy.SpatialReference`` and projects at read time.
#
# Decision rules
# --------------
# 1. Input projected and **not** in the Web Mercator family -> keep it, convert
#    with its ``metersPerUnit``. (Web Mercator distorts distances: about x1.15 at
#    30 degrees latitude and x2 at 60.)
# 2. Otherwise use the UTM zone of the data centre: EPSG 326zz (north) or
#    327zz (south) on WGS 84. A geographic input on another datum (NAD27, ED50,
#    Ain el Abd 1970, ...) uses the EPSG UTM system of its OWN datum when one
#    exists for that zone (``DATUM_UTM_SERIES``, e.g. 4204 zone 38N -> 20438),
#    so no datum transformation is needed. Otherwise the WGS 84 zone is used
#    and a warning says that no datum transformation is applied (the result
#    may be offset by the datum shift) and how to avoid it. The centre longitude is the middle of the *smallest*
#    longitude arc that holds all sample longitudes, so data that crosses the
#    antimeridian (e.g. Fiji, 177E..178W) gets zone 60/1 and not zone 31.
#    A warning is issued if the data spans more than 3 UTM zones.
# 3. Polar data (centre latitude above 84N or below 80S, the UTM limits) uses
#    EPSG 3995 (WGS 84 / Arctic Polar Stereographic) or EPSG 3031
#    (WGS 84 / Antarctic Polar Stereographic), with the same datum warning for
#    an input that is not on WGS 84. The decision is marked ``"polar": True``:
#    both systems have their true scale at 71 degrees, so between 80 and 90
#    degrees they measure lengths 2-2.7 % and areas 4-5.4 % short.
#    ``choose_measuring`` (given ``geographic_sr``) therefore measures polar
#    data, and input already in a polar stereographic system (any one: recognised
#    from where the system puts probe points round the pole, ``polar_probe_points``
#    / ``is_polar_stereographic_probe``; ``arcio.sr_info`` adds the result as
#    ``"polar_stereographic"``), feature by feature (``local_tm_rows``: each polar
#    feature on its own polar stereographic projection with true scale at the
#    feature).
# Norway/Svalbard UTM zone exceptions are not applied (standard 6-degree zones).

WEB_MERCATOR_WKIDS = frozenset([3857, 102100, 102113, 3395, 54004, 900913])
ARCTIC_POLAR_WKID = 3995
ANTARCTIC_POLAR_WKID = 3031
# Common polar stereographic systems on WGS 84: EPSG 3995 / 3031, 3413 / 3976 (NSIDC) and
# UPS 32661 / 32761 / 5041 / 5042. Used only to tell their datum from the WKID
# (``gcs_wkid_of``). Whether an input IS polar stereographic is not taken from a WKID
# list (RT8-C-3): see ``is_polar_stereographic_probe``.
POLAR_STEREO_WKIDS = frozenset([3995, 3031, 3413, 3976, 32661, 32761, 5041, 5042])

# Probe of a projected system (RT8-C-3): the points ``polar_probe_points(sign)`` (WGS 84
# degrees, 4 meridians 90 degrees apart on 3 latitudes near one pole) are projected into
# the system (``arcio.sr_info``). A polar stereographic projection about that pole (any
# variant, any true-scale latitude, false origin, axis orientation, unit or ellipsoid of
# about the size of the Earth) puts each latitude on a circle round one centre, the
# meridians 90 degrees apart, and the radii in the ratio of the stereographic formula.
# Polar azimuthal equal-area or equidistant systems differ by 0.25-0.4 % in those ratios.
POLAR_PROBE_LATS = (80.0, 85.0, 89.0)
POLAR_PROBE_LONS = (0.0, 90.0, 180.0, -90.0)
POLAR_PROBE_TOLERANCE = 1e-3
MAX_UTM_ZONES_WITHOUT_WARNING = 3
WGS84_GCS_WKID = 4326

# UTM systems on datums other than WGS 84 (EPSG, not deprecated, standard 6-degree
# zones in metres; GDA94/GDA2020 MGA zones are UTM on that datum). Each row:
# (geographic WKID, hemisphere, first zone, last zone, WKID of the first zone); the
# WKIDs of a row are consecutive. Checked against the EPSG database (pyproj) in the
# tests. Unlisted datums fall back to WGS 84 UTM with a warning.
DATUM_UTM_SERIES = (
    (4131, "N", 48, 49, 3148),  # Indian 1960
    (4146, "N", 42, 47, 24342),  # Kalianpur 1975
    (4152, "N", 4, 5, 3750),  # NAD83(HARN)
    (4152, "N", 10, 19, 3740),  # NAD83(HARN)
    (4152, "S", 2, 2, 2195),  # NAD83(HARN)
    (4154, "N", 38, 41, 2058),  # ED50(ED77)
    (4159, "N", 32, 35, 2077),  # ELD79
    (4170, "N", 17, 22, 31986),  # SIRGAS 1995
    (4170, "S", 17, 25, 31992),  # SIRGAS 1995
    (4189, "N", 18, 20, 2201),  # REGVEN
    (4201, "N", 35, 38, 20135),  # Adindan
    (4204, "N", 36, 40, 20436),  # Ain el Abd
    (4205, "N", 38, 39, 20538),  # Afgooye
    (4209, "S", 34, 36, 20934),  # Arc 1950
    (4210, "N", 35, 37, 21095),  # Arc 1960
    (4210, "S", 35, 37, 21035),  # Arc 1960
    (4211, "S", 48, 50, 21148),  # Batavia
    (4218, "N", 18, 18, 21818),  # Bogota 1975
    (4222, "S", 34, 35, 22234),  # Cape
    (4223, "N", 32, 32, 22332),  # Carthage
    (4225, "S", 21, 25, 22521),  # Corrego Alegre 1970-72
    (4230, "N", 28, 38, 23028),  # ED50
    (4232, "N", 39, 40, 23239),  # Fahud
    (4238, "N", 46, 52, 23846),  # ID74
    (4238, "S", 47, 54, 23887),  # ID74
    (4239, "N", 46, 48, 23946),  # Indian 1954
    (4240, "N", 47, 48, 24047),  # Indian 1975
    (4245, "N", 47, 48, 24547),  # Kertau 1968
    (4247, "N", 18, 20, 24718),  # La Canoa
    (4248, "N", 17, 21, 24817),  # PSAD56
    (4248, "S", 17, 22, 24877),  # PSAD56
    (4258, "N", 28, 37, 25828),  # ETRS89
    (4263, "N", 31, 32, 26331),  # Minna
    (4267, "N", 1, 22, 26701),  # NAD27
    (4267, "N", 59, 60, 3370),  # NAD27
    (4269, "N", 1, 23, 26901),  # NAD83
    (4269, "N", 24, 24, 9712),  # NAD83
    (4269, "N", 59, 60, 3372),  # NAD83
    (4270, "N", 39, 40, 27039),  # Nahrwan 1967
    (4283, "S", 46, 47, 6736),  # GDA94
    (4283, "S", 48, 58, 28348),  # GDA94
    (4283, "S", 59, 59, 6738),  # GDA94
    (4301, "N", 51, 55, 3092),  # Tokyo
    (4307, "N", 29, 32, 30729),  # Nord Sahara 1959
    (4318, "N", 38, 39, 31838),  # NGN
    (4322, "N", 1, 60, 32201),  # WGS 72
    (4322, "S", 1, 60, 32301),  # WGS 72
    (4612, "N", 51, 55, 3097),  # JGD2000
    (4617, "N", 7, 10, 3154),  # NAD83(CSRS)
    (4617, "N", 11, 13, 2955),  # NAD83(CSRS)
    (4617, "N", 14, 16, 3158),  # NAD83(CSRS)
    (4617, "N", 17, 21, 2958),  # NAD83(CSRS)
    (4617, "N", 22, 22, 3761),  # NAD83(CSRS)
    (4617, "N", 23, 23, 9709),  # NAD83(CSRS)
    (4617, "N", 24, 24, 9713),  # NAD83(CSRS)
    (4618, "N", 17, 17, 5463),  # SAD69
    (4618, "N", 18, 22, 29168),  # SAD69
    (4618, "S", 17, 25, 29187),  # SAD69
    (4674, "N", 11, 22, 31965),  # SIRGAS 2000
    (4674, "N", 23, 24, 6210),  # SIRGAS 2000
    (4674, "S", 17, 25, 31977),  # SIRGAS 2000
    (4674, "S", 26, 26, 5396),  # SIRGAS 2000
    (4743, "N", 37, 39, 3391),  # Karbala 1979
    (4744, "N", 37, 39, 7005),  # Nahrwan 1934
    (4755, "N", 46, 52, 23866),  # DGN95
    (4755, "S", 47, 54, 23877),  # DGN95
    (4756, "N", 48, 49, 3405),  # VN-2000
    (4759, "N", 1, 19, 3708),  # NAD83(NSRS2007)
    (4759, "N", 59, 60, 3706),  # NAD83(NSRS2007)
    (6318, "N", 1, 19, 6330),  # NAD83(2011)
    (6318, "N", 59, 60, 6328),  # NAD83(2011)
    (6668, "N", 51, 55, 6688),  # JGD2011
    (7844, "S", 46, 59, 7846),  # GDA2020
)


def utm_zone(lon):
    """Standard 6-degree UTM zone number (1..60) of a longitude in degrees."""
    lon = _projection_wrap(lon)
    zone = int(math.floor((lon + 180.0) / 6.0)) + 1
    return min(max(zone, 1), 60)


def utm_wkid(lon, lat):
    """EPSG code of the WGS 84 UTM zone for a point."""
    return (32600 if lat >= 0 else 32700) + utm_zone(lon)


def _projection_wrap(lon):
    """Longitude in [-180, 180)."""
    return ((float(lon) + 180.0) % 360.0) - 180.0


def longitude_span(longitudes):
    """Smallest arc holding all longitudes: ``(west, east, centre, width)``.

    ``west``/``east``/``centre`` are wrapped to [-180, 180); ``width`` is in
    degrees (0..360). Works across the antimeridian: the arc is the complement
    of the largest gap between sorted longitudes.
    """
    lons = sorted(set(_projection_wrap(x) for x in longitudes))
    if not lons:
        raise ValueError("no longitudes")
    if len(lons) == 1:
        return lons[0], lons[0], lons[0], 0.0
    best_gap, best_i = -1.0, 0
    for i in range(len(lons)):
        nxt = lons[(i + 1) % len(lons)] + (360.0 if i == len(lons) - 1 else 0.0)
        gap = nxt - lons[i]
        if gap > best_gap:
            best_gap, best_i = gap, i
    west = lons[(best_i + 1) % len(lons)]
    east = lons[best_i]
    width = 360.0 - best_gap
    centre = _projection_wrap(west + width / 2.0)
    return west, east, centre, width


def count_utm_zones(west, width):
    """Number of UTM zones touched by an arc starting at ``west``."""
    if width >= 360.0:
        return 60
    first = int(math.floor((_projection_wrap(west) + 180.0) / 6.0))
    last = int(math.floor((_projection_wrap(west) + 180.0 + width) / 6.0))
    return min(last - first + 1, 60)


def is_web_mercator(wkid):
    return wkid is not None and int(wkid) in WEB_MERCATOR_WKIDS


# Equatorial circumference of the Web Mercator family (sphere or ellipsoid with
# a = 6378137 m): the x period of 3857/102100/102113/900913 (+-20,037,508.34 m)
# and of World Mercator 3395/54004.
WEB_MERCATOR_PERIOD_M = 2.0 * math.pi * 6378137.0


def x_period(sr_info):
    """Period of the x coordinate of a coordinate system, or ``None``: 360 for a
    geographic system (longitudes), the equatorial circumference (in the
    system's units) for the Web Mercator family, else ``None``. Coordinates
    ``x`` and ``x +- period`` are then the same place (antimeridian)."""
    sr_info = sr_info or {}
    if str(sr_info.get("type") or "") == "Geographic":
        return 360.0
    if is_web_mercator(sr_info.get("wkid")):
        return WEB_MERCATOR_PERIOD_M / float(sr_info.get("meters_per_unit") or 1.0)
    return None


def datum_utm_wkid(gcs_wkid, lon, lat):
    """WKID of the UTM zone of ``(lon, lat)`` on the datum of geographic system
    ``gcs_wkid``, or ``None`` when that datum has no EPSG UTM system there."""
    if not gcs_wkid:
        return None
    gcs_wkid = int(gcs_wkid)
    if gcs_wkid == WGS84_GCS_WKID:
        return utm_wkid(lon, lat)
    zone, hemi = utm_zone(lon), ("N" if lat >= 0 else "S")
    for gcs, h, first, last, code in DATUM_UTM_SERIES:
        if gcs == gcs_wkid and h == hemi and first <= zone <= last:
            return code + zone - first
    return None


def gcs_wkid_of(sr_info):
    """WKID of the geographic system (datum) under ``sr_info``, or ``None`` when it
    cannot be told from the WKID alone (custom or unlisted projected systems)."""
    sr_info = sr_info or {}
    wkid = sr_info.get("wkid")
    if not wkid:
        return None
    wkid = int(wkid)
    if str(sr_info.get("type") or "") == "Geographic":
        return wkid
    if is_web_mercator(wkid) or wkid in POLAR_STEREO_WKIDS \
            or 32601 <= wkid <= 32660 or 32701 <= wkid <= 32760:
        return WGS84_GCS_WKID
    for gcs, _h, first, last, code in DATUM_UTM_SERIES:
        if code <= wkid <= code + last - first:
            return gcs
    return None


def datum_mismatch_warning(label, other_info, decision):
    """Warning text when a further input (``label``) is on another datum than the
    measuring system of ``decision``: it is projected without a datum
    transformation. ``None`` when the datums match or cannot be told."""
    if not decision:
        return None
    target = decision.get("gcs_wkid")
    other = gcs_wkid_of(other_info)
    if target is None or other is None or target == other:
        return None
    return ("{0} ({1}) is on another datum than the measuring coordinate system (WKID {2}); "
            "it is projected to it without a datum transformation, so it may be offset "
            "from the other input by the datum shift (about 1 m between modern datums, up to "
            "several hundred metres for older ones). Project both inputs to the same projected "
            "metric coordinate system first (Project tool, with the right geographic "
            "transformation).".format(label, (other_info or {}).get("name") or other,
                                      decision.get("wkid")))


def sr_is_unknown(sr_info):
    """True for a dataset without a coordinate system (e.g. a shapefile with no
    .prj): type neither Projected nor Geographic and no WKID."""
    sr_info = sr_info or {}
    return (str(sr_info.get("type") or "") not in ("Projected", "Geographic")
            and not sr_info.get("wkid"))


def further_input_sr_check(label, other_info, decision, main_name=None):
    """Check the coordinate system of a further input (``label``) against the
    measuring ``decision`` of the main input.

    A cursor cannot project data whose system is unknown (audit gotcha 3), so
    its coordinates stay as they are. When the main input is projected for
    measuring, they would be compared with it in other units: ``ToolError``.
    When the main input is used in its own system, the further input is
    assumed to be in that system: returns a warning. ``None`` when the further
    input's system is known.
    """
    if not sr_is_unknown(other_info):
        return None
    fix = ("Define the coordinate system of {0} (Define Projection tool) and run the tool "
           "again.".format(label))
    if decision and decision.get("reproject"):
        raise ToolError(
            "{0} has an unknown coordinate system, so it cannot be projected to the measuring "
            "coordinate system (WKID {1}); its coordinates would be compared with the input "
            "in other units.".format(label, decision.get("wkid")), fix)
    return ("{0} has an unknown coordinate system; its coordinates are used as if they were "
            "in the coordinate system of the input ({1}). If they are not, {2}".format(
                label, main_name or "unknown", fix[0].lower() + fix[1:]))


def _projection_datum_warning(name, target_text):
    return ("The input coordinate system ({0}) is not on the WGS 84 datum and has no UTM "
            "system on its own datum for this area, so it is projected to {1} WITHOUT a datum "
            "transformation. Positions may be offset by the datum shift: about 1 m for modern "
            "datums (NAD83, ETRS89, GDA94), up to several hundred metres for older ones "
            "(NAD27, ED50, Ain el Abd 1970, Pulkovo 1942). For exact positions project the "
            "input to a projected metric coordinate system first (Project tool, with the right "
            "geographic transformation).".format(name, target_text))


def choose_metric_sr(sr_info, lonlat_samples=None):
    """Decide the measuring coordinate system.

    ``sr_info`` describes the input system: ``{"wkid": int or None,
    "type": "Projected" | "Geographic" | ..., "meters_per_unit": float or None,
    "name": str}``. ``lonlat_samples`` is an iterable of ``(lon, lat)`` in
    degrees (WGS 84) and is only needed when the input is not usable as is.

    Returns ``{"wkid", "meters_per_unit", "reproject", "gcs_wkid", "reason",
    "warnings"}`` (``gcs_wkid``: the datum of the measuring system, ``None`` if
    unknown), plus ``"utm_zones"`` (number of UTM zones the data spans) when a
    UTM zone is chosen and ``"datum_warnings"`` (the subset of ``warnings``
    about projecting without a datum transformation) when a new system is
    chosen. That warning only matters to a tool that compares positions with
    other data or writes measured positions in another system; a tool that
    writes its results back through the same projection may show it as
    information instead (``choose_measuring(..., datum_as_info=True)``);
    ``reproject`` is False when the input system is kept. An unknown system
    (type neither Projected nor Geographic and no WKID) is kept as is with a
    warning: it cannot be projected.
    Raises ``ToolError`` when a new system is needed but there are no samples.
    """
    sr_info = sr_info or {}
    wkid = sr_info.get("wkid")
    sr_type = str(sr_info.get("type") or "")
    mpu = sr_info.get("meters_per_unit")
    name = sr_info.get("name") or ("WKID {0}".format(wkid) if wkid else "unknown")

    if sr_type not in ("Projected", "Geographic") and not wkid:
        # Unknown coordinate system: a cursor cannot project it (coordinates stay as
        # they are, audit gotcha 3), so measuring "in UTM" would be a false claim.
        return {"wkid": None, "meters_per_unit": 1.0, "reproject": False, "gcs_wkid": None,
                "reason": "The input coordinate system is unknown; coordinates are used as "
                          "they are.",
                "warnings": ["The coordinate system of the input is unknown, so lengths, areas "
                             "and distances are in the data's own units and are reported as if "
                             "they were metres. Define the projection of the input (Define "
                             "Projection tool) for correct values."]}
    if sr_type == "Projected" and not is_web_mercator(wkid) and mpu:
        return {"wkid": wkid, "meters_per_unit": float(mpu), "reproject": False,
                "gcs_wkid": gcs_wkid_of(sr_info),
                "reason": "The input is already projected ({0}); it is used as is.".format(name),
                "warnings": []}

    samples = [(float(x), float(y)) for (x, y) in (lonlat_samples or [])
               if x is not None and y is not None
               and math.isfinite(float(x)) and math.isfinite(float(y))]
    if not samples:
        raise ToolError(
            "Cannot choose a metric coordinate system: the input has no usable coordinates.",
            "Check that the input contains features with geometry.")

    lats = [lat for (_lon, lat) in samples]
    centre_lat = (min(lats) + max(lats)) / 2.0
    why_not = ("is in the Web Mercator family, which distorts distances"
               if is_web_mercator(wkid) else "is not a projected system")
    warnings = []
    source_gcs = gcs_wkid_of(sr_info)
    foreign = source_gcs != WGS84_GCS_WKID      # None (custom datum) counts as foreign
    if centre_lat > 84.0 or centre_lat < -80.0:
        north = centre_lat > 84.0
        target = ARCTIC_POLAR_WKID if north else ANTARCTIC_POLAR_WKID
        label = "WGS 84 / {0} Polar Stereographic (EPSG {1})".format(
            "Arctic" if north else "Antarctic", target)
        if foreign:
            warnings.append(_projection_datum_warning(name, label))
        return {"wkid": target, "meters_per_unit": 1.0, "reproject": True, "polar": True,
                "gcs_wkid": WGS84_GCS_WKID, "datum_warnings": list(warnings),
                "reason": "The input ({0}) {1}; polar data {2} is measured in {3}.".format(
                    name, why_not, "north of 84N" if north else "south of 80S", label),
                "warnings": warnings}

    west, _east, centre_lon, width = longitude_span(lon for (lon, _lat) in samples)
    zones = count_utm_zones(west, width)
    target = utm_wkid(centre_lon, centre_lat)
    hemi = "N" if centre_lat >= 0 else "S"
    zone_text = "UTM zone {0}{1}".format(utm_zone(centre_lon), hemi)
    target_gcs = WGS84_GCS_WKID
    target_text = "WGS 84 / {0}".format(zone_text)
    if foreign:
        own = datum_utm_wkid(source_gcs, centre_lon, centre_lat)
        if own is not None:
            target, target_gcs = own, source_gcs
            target_text = "{0} on the input's own datum, so no datum transformation is " \
                          "needed".format(zone_text)
        else:
            warnings.append(_projection_datum_warning(
                name, "WGS 84 / {0} (EPSG {1})".format(zone_text, target)))
    datum_warnings = list(warnings)
    if zones > MAX_UTM_ZONES_WITHOUT_WARNING:
        warnings.append(
            "The data spans {0} UTM zones ({1:.1f} degrees of longitude); distances far from "
            "the centre zone are less accurate. Project the data to a suitable "
            "equidistant or equal-area system first for best results.".format(zones, width))
    return {"wkid": target, "meters_per_unit": 1.0, "reproject": True, "gcs_wkid": target_gcs,
            "reason": "The input ({0}) {1}; measuring in {2} (EPSG {3}).".format(
                name, why_not, target_text, target),
            "warnings": warnings, "utm_zones": zones, "datum_warnings": datum_warnings}


# --------------------------------------------------------------------------
# Per-feature local Transverse Mercator (wide geographic data)
# --------------------------------------------------------------------------
# One UTM zone cannot measure data that spans many zones: Transverse Mercator
# scale error grows with the square of the distance from the central meridian
# (about +0.1 % in area at 3 degrees, +40 % at 40 degrees on the equator, and
# far worse beyond). For such data each feature is projected on its own
# Transverse Mercator with the central meridian at the feature's centre and
# scale factor 1 (true scale on that meridian), in pure Python. The formulas
# are Krueger's series to order n**6 (C. F. F. Karney, "Transverse Mercator
# with an accuracy of a few nanometers", J. Geodesy 85, 2011, eqs. 6-11 and
# 35-36); within 3900 km of the central meridian they agree with an exact
# projection to well below a millimetre (checked against PROJ in the tests).
# The WGS 84 ellipsoid is used for every geographic system: other ellipsoids
# differ by less than 0.01 %, far below what a map-scale check can see.

TM_WGS84_A = 6378137.0
TM_WGS84_F = 1.0 / 298.257223563
# A feature reaching farther than this from its own central meridian (metres on
# its local Transverse Mercator) is measured with more than about 1 % area error
# even on that projection (warning). The scale error grows with the distance
# from the central meridian (k - 1 ~ x**2 / 2R**2), not with the longitude
# difference, which shrinks with cos(latitude): 9 degrees of longitude on the
# equator (a feature 18 degrees wide) is about 1,000 km, at 79 N only 190 km.
TM_MAX_FEATURE_OFFSET_M = TM_WGS84_A * math.pi / 20.0


def _projection_tm_constants(a=TM_WGS84_A, f=TM_WGS84_F):
    n = f / (2.0 - f)
    n2, n3 = n * n, n * n * n
    n4, n5, n6 = n2 * n2, n2 * n3, n3 * n3
    big_a = a / (1.0 + n) * (1.0 + n2 / 4.0 + n4 / 64.0 + n6 / 256.0)
    alpha = (
        n / 2.0 - 2.0 * n2 / 3.0 + 5.0 * n3 / 16.0 + 41.0 * n4 / 180.0 - 127.0 * n5 / 288.0
        + 7891.0 * n6 / 37800.0,
        13.0 * n2 / 48.0 - 3.0 * n3 / 5.0 + 557.0 * n4 / 1440.0 + 281.0 * n5 / 630.0
        - 1983433.0 * n6 / 1935360.0,
        61.0 * n3 / 240.0 - 103.0 * n4 / 140.0 + 15061.0 * n5 / 26880.0
        + 167603.0 * n6 / 181440.0,
        49561.0 * n4 / 161280.0 - 179.0 * n5 / 168.0 + 6601661.0 * n6 / 7257600.0,
        34729.0 * n5 / 80640.0 - 3418889.0 * n6 / 1995840.0,
        212378941.0 * n6 / 319334400.0)
    beta = (
        n / 2.0 - 2.0 * n2 / 3.0 + 37.0 * n3 / 96.0 - n4 / 360.0 - 81.0 * n5 / 512.0
        + 96199.0 * n6 / 604800.0,
        n2 / 48.0 + n3 / 15.0 - 437.0 * n4 / 1440.0 + 46.0 * n5 / 105.0
        - 1118711.0 * n6 / 3870720.0,
        17.0 * n3 / 480.0 - 37.0 * n4 / 840.0 - 209.0 * n5 / 4480.0 + 5569.0 * n6 / 90720.0,
        4397.0 * n4 / 161280.0 - 11.0 * n5 / 504.0 - 830251.0 * n6 / 7257600.0,
        4583.0 * n5 / 161280.0 - 108847.0 * n6 / 3991680.0,
        20648693.0 * n6 / 638668800.0)
    e = math.sqrt(f * (2.0 - f))
    return {"A": big_a, "alpha": alpha, "beta": beta, "e": e}


_PROJECTION_TM = _projection_tm_constants()


def tm_forward(lon, lat, lon0):
    """Transverse Mercator ``(x, y)`` in metres of ``(lon, lat)`` (degrees) on the
    WGS 84 ellipsoid, central meridian ``lon0``, scale factor 1, origin at the
    equator. Longitudes more than about 89 degrees from ``lon0`` are clamped
    (Transverse Mercator is not defined at 90 degrees on the equator)."""
    c = _PROJECTION_TM
    e = c["e"]
    lam = math.radians(_projection_wrap(float(lon) - float(lon0)))
    lam = max(min(lam, math.radians(89.999)), -math.radians(89.999))
    phi = math.radians(max(min(float(lat), 90.0), -90.0))
    sin_phi = math.sin(phi)
    if abs(sin_phi) >= 1.0:
        tau_c = math.copysign(1e300, sin_phi)
        xi_p, eta_p = math.copysign(math.pi / 2.0, sin_phi), 0.0
    else:
        tau_c = math.sinh(math.atanh(sin_phi) - e * math.atanh(e * sin_phi))
        xi_p = math.atan2(tau_c, math.cos(lam))
        eta_p = math.asinh(math.sin(lam) / math.hypot(tau_c, math.cos(lam)))
    xi, eta = xi_p, eta_p
    for j, a_j in enumerate(c["alpha"], 1):
        xi += a_j * math.sin(2 * j * xi_p) * math.cosh(2 * j * eta_p)
        eta += a_j * math.cos(2 * j * xi_p) * math.sinh(2 * j * eta_p)
    return c["A"] * eta, c["A"] * xi


def _projection_lat_from_conformal(tau_p):
    """Geodetic tan(latitude) from conformal tan(latitude) (Newton, Karney eq. 19-21)."""
    e = _PROJECTION_TM["e"]
    e2m = 1.0 - e * e
    tau = tau_p / e2m
    for _ in range(8):
        sigma = math.sinh(e * math.atanh(e * tau / math.sqrt(1.0 + tau * tau)))
        tau_pi = tau * math.sqrt(1.0 + sigma * sigma) - sigma * math.sqrt(1.0 + tau * tau)
        step = (tau_p - tau_pi) * (1.0 + e2m * tau * tau) / (
            e2m * math.sqrt(1.0 + tau_pi * tau_pi) * math.sqrt(1.0 + tau * tau))
        tau += step
        if abs(step) < 1e-14 * max(1.0, abs(tau)):
            break
    return tau


def tm_inverse(x, y, lon0):
    """Inverse of ``tm_forward``: ``(lon, lat)`` in degrees, ``lon`` near ``lon0``
    (``lon0`` plus an offset in -90..90, not wrapped)."""
    c = _PROJECTION_TM
    xi, eta = float(y) / c["A"], float(x) / c["A"]
    xi_p, eta_p = xi, eta
    for j, b_j in enumerate(c["beta"], 1):
        xi_p -= b_j * math.sin(2 * j * xi) * math.cosh(2 * j * eta)
        eta_p -= b_j * math.cos(2 * j * xi) * math.sinh(2 * j * eta)
    lam = math.atan2(math.sinh(eta_p), math.cos(xi_p))
    tau_p = math.sin(xi_p) / math.hypot(math.sinh(eta_p), math.cos(xi_p))
    tau = _projection_lat_from_conformal(tau_p)
    return float(lon0) + math.degrees(lam), math.degrees(math.atan(tau))


# Per-feature polar stereographic (features near a pole). Ellipsoidal formulas of
# J. P. Snyder, "Map Projections - A Working Manual" (USGS PP 1395, 1987), eqs. 15-9,
# 21-33 to 21-40, with scale 1 at the pole; ``local_tm_rows`` then divides the
# coordinates by the scale at the feature, so the feature is at true scale.
_PS_E = _PROJECTION_TM["e"]
_PS_C = math.sqrt((1.0 + _PS_E) ** (1.0 + _PS_E) * (1.0 - _PS_E) ** (1.0 - _PS_E))


def _projection_ps_rho(lat_toward_pole):
    """Distance from the pole (metres, scale 1 at the pole) of latitude ``lat``
    (degrees, positive toward the projection's pole)."""
    phi = math.radians(max(min(float(lat_toward_pole), 90.0), -89.999))
    s = math.sin(phi)
    t = math.tan(math.pi / 4.0 - phi / 2.0) / ((1.0 - _PS_E * s) / (1.0 + _PS_E * s)) ** (
        _PS_E / 2.0)
    return 2.0 * TM_WGS84_A * t / _PS_C


def _projection_ps_lat(rho):
    """Inverse of ``_projection_ps_rho``: latitude in degrees (toward the pole)."""
    t = float(rho) * _PS_C / (2.0 * TM_WGS84_A)
    phi = math.pi / 2.0 - 2.0 * math.atan(t)
    for _ in range(30):
        s = math.sin(phi)
        new = math.pi / 2.0 - 2.0 * math.atan(
            t * ((1.0 - _PS_E * s) / (1.0 + _PS_E * s)) ** (_PS_E / 2.0))
        if abs(new - phi) < 1e-15:
            phi = new
            break
        phi = new
    return math.degrees(phi)


def ps_scale(lat_toward_pole):
    """Linear scale of the polar stereographic (scale 1 at the pole) at a latitude."""
    phi = math.radians(min(abs(float(lat_toward_pole)), 90.0))
    if phi >= math.pi / 2.0 - 1e-12:
        return 1.0
    s = math.sin(phi)
    m = math.cos(phi) / math.sqrt(1.0 - _PS_E * _PS_E * s * s)
    return _projection_ps_rho(math.degrees(phi)) / (TM_WGS84_A * m)


def ps_forward(lon, lat, lon0, sign, k_ref=1.0):
    """Polar stereographic ``(x, y)`` in metres of ``(lon, lat)`` (degrees): pole
    ``sign`` (+1 north, -1 south), meridian ``lon0`` along the y axis with east
    +x and north +y on it (so ring orientation is kept), coordinates divided by
    ``k_ref`` (true scale where the scale equals ``k_ref``)."""
    rho = _projection_ps_rho(sign * float(lat)) / float(k_ref)
    lam = math.radians(_projection_wrap(float(lon) - float(lon0)))
    return rho * math.sin(lam), -sign * rho * math.cos(lam)


def ps_inverse(x, y, lon0, sign, k_ref=1.0):
    """Inverse of ``ps_forward``: ``(lon, lat)`` in degrees, ``lon`` within 180 of ``lon0``."""
    x, y = float(x) * float(k_ref), float(y) * float(k_ref)
    rho = math.hypot(x, y)
    lat = sign * _projection_ps_lat(rho)
    lam = math.atan2(x, -sign * y) if rho > 0.0 else 0.0
    return float(lon0) + math.degrees(lam), lat


def polar_probe_points(sign):
    """``[(lon, lat)]`` (WGS 84 degrees) to project into a system to test whether it is
    polar stereographic about the North (``sign`` 1) or South (-1) Pole: for each
    latitude of ``POLAR_PROBE_LATS``, the 4 longitudes of ``POLAR_PROBE_LONS``."""
    return [(lon, sign * lat) for lat in POLAR_PROBE_LATS for lon in POLAR_PROBE_LONS]


def is_polar_stereographic_probe(projected):
    """True when ``projected`` (the points of ``polar_probe_points`` in the same order,
    as ``(x, y)`` in the system tested; ``None`` or non-finite entries where a point
    could not be projected) is what a polar stereographic projection about that pole
    gives: every latitude on a circle round one common centre (the pole), the
    meridians 90 degrees apart, and the radii of the latitudes in the ratio of the
    stereographic formula (tolerance ``POLAR_PROBE_TOLERANCE``, relative)."""
    n = len(POLAR_PROBE_LONS)
    if projected is None or len(projected) != n * len(POLAR_PROBE_LATS):
        return False
    pts = []
    for p in projected:
        try:
            x, y = float(p[0]), float(p[1])
        except (TypeError, ValueError, IndexError):
            return False
        if not (math.isfinite(x) and math.isfinite(y)):
            return False
        pts.append((x, y))
    groups = [pts[i * n:(i + 1) * n] for i in range(len(POLAR_PROBE_LATS))]
    # Centre: midpoint of the opposite meridians (0 and 180, 90 and -90) of each latitude.
    mids = [((g[a][0] + g[a + 2][0]) / 2.0, (g[a][1] + g[a + 2][1]) / 2.0)
            for g in groups for a in (0, 1)]
    cx = sum(m[0] for m in mids) / len(mids)
    cy = sum(m[1] for m in mids) / len(mids)
    radii = []
    for g in groups:
        rs = [math.hypot(x - cx, y - cy) for x, y in g]
        r = sum(rs) / len(rs)
        if not r > 0.0 or any(abs(v - r) > POLAR_PROBE_TOLERANCE * r for v in rs):
            return False
        # Meridians 0 and 90 at a right angle round the pole.
        (x0, y0), (x1, y1) = g[0], g[1]
        dot = (x0 - cx) * (x1 - cx) + (y0 - cy) * (y1 - cy)
        if abs(dot) > POLAR_PROBE_TOLERANCE * rs[0] * rs[1]:
            return False
        radii.append(r)
    tol = POLAR_PROBE_TOLERANCE * radii[0]
    if any(math.hypot(m[0] - cx, m[1] - cy) > tol for m in mids):
        return False
    rho0 = _projection_ps_rho(POLAR_PROBE_LATS[0])
    for lat, r in zip(POLAR_PROBE_LATS[1:], radii[1:]):
        expected = _projection_ps_rho(lat) / rho0
        if abs((r / radii[0]) / expected - 1.0) > POLAR_PROBE_TOLERANCE:
            return False
    return True


def _projection_polar_sign(lats, width):
    """+1 / -1 when a feature is measured on a polar stereographic projection (all
    of it in one hemisphere and reaching beyond the UTM limits, 84N / 80S, or
    going round the pole above 60 degrees: more than 180 degrees of longitude),
    else 0."""
    if not lats:
        return 0
    if min(lats) >= 0.0 and (max(lats) > 84.0 or (width > 180.0 and min(lats) >= 60.0)):
        return 1
    if max(lats) <= 0.0 and (min(lats) < -80.0 or (width > 180.0 and max(lats) <= -60.0)):
        return -1
    return 0


def _projection_ps_node(node, lon0, sign, k_ref):
    if isinstance(node[0], (int, float)):
        x, y = ps_forward(node[0], node[1], lon0, sign, k_ref)
        return [x, y]
    return [_projection_ps_node(item, lon0, sign, k_ref) for item in node]


def _projection_lats(node, out):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            out.append(float(node[1]))
        else:
            for item in node:
                _projection_lats(item, out)


def local_ps_geometry(geom, lon0, sign):
    """Project a core geometry in degrees on the polar stereographic of pole
    ``sign`` with true scale at the feature: ``(geometry, k_ref, spread)``.

    ``k_ref`` is the geometric mean of the smallest and largest scale (scale 1 at
    the pole) over the vertices and the centre of the feature's extent (the pole
    itself for a feature around it); ``spread`` = largest / smallest scale, so
    the measures are within about ``spread - 1`` (area) of the truth."""
    lats = []
    _projection_lats(geom, lats)
    scales = [ps_scale(sign * lat) for lat in lats]
    raw = _projection_ps_node(geom, lon0, sign, 1.0)
    xs, ys = [], []
    _projection_xy(raw, xs, ys)
    cx, cy = (min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0
    scales.append(ps_scale(_projection_ps_lat(math.hypot(cx, cy))))
    k_min, k_max = min(scales), max(scales)
    k_ref = math.sqrt(k_min * k_max)
    return _projection_ps_node(geom, lon0, sign, k_ref), k_ref, k_max / k_min


def _projection_xy(node, xs, ys):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            xs.append(float(node[0]))
            ys.append(float(node[1]))
        else:
            for item in node:
                _projection_xy(item, xs, ys)


# A polar feature whose scale varies by more than this factor over it (largest /
# smallest, on its own polar stereographic) is measured with more than about 1 %
# area error: warning. 1.01 is reached by a feature from the pole to about 78 degrees.
PS_MAX_FEATURE_SPREAD = 1.01


def _projection_lonlats(node, out):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            out.append(float(node[0]))
        else:
            for item in node:
                _projection_lonlats(item, out)


def _projection_tm_node(node, lon0):
    if isinstance(node[0], (int, float)):
        x, y = tm_forward(node[0], node[1], lon0)
        return [x, y]
    return [_projection_tm_node(item, lon0) for item in node]


def local_tm_geometry(geom):
    """Project a core geometry in geographic degrees (a point ``[lon, lat]`` or
    nested lists of them) to the local Transverse Mercator of its own centre.

    Returns ``(projected geometry, lon0, width)``: ``lon0`` is the centre of the
    smallest longitude arc holding all vertices (works across the
    antimeridian), ``width`` that arc in degrees. ``(None, None, 0.0)`` for an
    empty geometry.
    """
    lons = []
    if geom:
        _projection_lonlats(geom, lons)
    if not lons:
        return None, None, 0.0
    _west, _east, lon0, width = longitude_span(lons)
    return _projection_tm_node(geom, lon0), lon0, width


def local_tm_point_to_lonlat(point, lon0, near_lon=None):
    """``[lon, lat]`` of a point ``(x, y)`` of ``local_tm_geometry``; the
    longitude is shifted by whole turns to be nearest ``near_lon`` (the
    feature's own longitudes, so data stored in 0..360 stays there)."""
    lon, lat = tm_inverse(point[0], point[1], lon0)
    if near_lon is not None:
        lon += 360.0 * round((float(near_lon) - lon) / 360.0)
    return [lon, lat]


# --------------------------------------------------------------------------
# Measuring plan of a tool (one UTM zone, or per-feature local TM)
# --------------------------------------------------------------------------

def choose_measuring(desc, metric_sr_for, collector, what, geographic_sr=None,
                     datum_as_info=False):
    """How to measure an input: ``{"read_sr", "wkid", "mpu", "local"}``.

    ``metric_sr_for`` is ``arcio.metric_sr_or_native`` (or ``arcio.metric_sr_for``,
    or any function ``desc -> (decision, spatial reference or None)``);
    ``collector`` a ``MessageCollector``. Pure: arcpy is only reached through
    the functions passed in.
    An input with no coordinates at all (empty, empty selection, only null
    geometries) keeps its own system: there is nothing to measure. A projected
    input keeps its own system (other inputs are projected into it by the
    cursor); otherwise a UTM zone is chosen from the data. An unknown system
    gives a warning and native units (``wkid`` ``None``, 1 metre per unit).

    Wide data (``local`` True): when the data needs projecting and spans more
    than ``MAX_UTM_ZONES_WITHOUT_WARNING`` UTM zones, one zone would measure
    features far from it with gross errors (area +100 % at 40 degrees from the
    central meridian). If ``geographic_sr`` (``arcpy.SpatialReference``) is
    given, the input is then read in geographic degrees (its own geographic
    system, or WGS 84 for Web Mercator) and every feature is measured on its
    own local Transverse Mercator (``local_tm_rows``); ``wkid`` is then the
    system of the degrees read, used to write points back.

    ``datum_as_info``: the decision's ``datum_warnings`` are shown as
    information, not warnings (for tools whose results go back through the
    same projection, so a datum shift cannot offset them).
    """
    sr_type = (desc["sr"] or {}).get("type")
    if sr_type not in ("Projected", "Geographic"):
        collector.warning(
            "The {0} has an unknown coordinate system, so it is read in its native "
            "coordinates and its units are taken as metres. Define the coordinate system "
            "(Define Projection) for reliable measurements.".format(what))
        return {"read_sr": desc["sr_object"], "wkid": None, "mpu": 1.0, "local": False}
    sr_name = (desc["sr"] or {}).get("name") or "unknown"
    # Polar stereographic input of any WKID (or none): recognised by ``arcio.sr_info``.
    polar_input = sr_type == "Projected" and bool((desc["sr"] or {}).get("polar_stereographic"))
    if geographic_sr is not None and polar_input:
        # Its own scale is not 1 near the pole (EPSG 3031/3995: 0.973 at 90 degrees; 3032:
        # true scale at 71S; 9354 IBCSO: 65S).
        collector.info(
            "The {0} is in a polar stereographic system ({1}) whose scale is not 1 near the "
            "pole, so it is read in WGS 84 geographic coordinates and each feature is measured "
            "on its own projection: polar stereographic with true scale at the feature for "
            "features beyond 84N / 80S, Transverse Mercator centred on the feature otherwise "
            "(WGS 84 ellipsoid).".format(what, sr_name))
        return {"read_sr": geographic_sr(WGS84_GCS_WKID), "wkid": WGS84_GCS_WKID, "mpu": 1.0,
                "local": True}
    decision, read_sr = metric_sr_for(desc)
    zones = decision.get("utm_zones") or 0
    polar = bool(decision.get("polar")) and decision.get("reproject")
    if geographic_sr is not None and decision.get("reproject") \
            and (zones > MAX_UTM_ZONES_WITHOUT_WARNING or polar):
        if sr_type == "Geographic":
            read_sr, wkid = desc["sr_object"], (desc["sr"] or {}).get("wkid")
            source = "its own geographic coordinates"
        else:
            read_sr, wkid = geographic_sr(WGS84_GCS_WKID), WGS84_GCS_WKID
            source = "WGS 84 geographic coordinates"
        if polar:
            collector.info(
                "The {0} ({1}) is not in a projected metric system and is polar data (centre "
                "{2}). The polar stereographic systems (EPSG 3995/3031) have their true scale at "
                "71 degrees and measure 2-3 % short near the pole, so the {0} is read in {3} and "
                "each feature is measured on its own projection: polar stereographic with true "
                "scale at the feature for features beyond 84N / 80S, Transverse Mercator "
                "centred on the feature otherwise (WGS 84 ellipsoid).".format(
                    what, sr_name, "north of 84N" if decision["wkid"] == ARCTIC_POLAR_WKID
                    else "south of 80S", source))
        else:
            collector.info(
                "The {0} ({1}) is not in a projected metric system and spans {2} UTM zones, too "
                "wide for one zone to measure accurately. It is read in {3} and each feature is "
                "measured on its own Transverse Mercator projection centred on the feature (WGS "
                "84 ellipsoid, true scale on its central meridian).".format(
                    what, sr_name, zones, source))
        return {"read_sr": read_sr, "wkid": wkid, "mpu": 1.0, "local": True}
    collector.info(decision["reason"])
    if polar:  # no per-feature measuring possible here: say what the bias is
        collector.warning(
            "Polar data is measured in {0} (EPSG {1}), whose true scale is at 71 degrees: "
            "lengths near the pole are up to 2.7 % and areas up to 5.4 % short.".format(
                "WGS 84 / Arctic Polar Stereographic" if decision["wkid"] == ARCTIC_POLAR_WKID
                else "WGS 84 / Antarctic Polar Stereographic", decision["wkid"]))
    as_info = (decision.get("datum_warnings") or []) if datum_as_info else []
    for text in decision["warnings"]:
        if text in as_info:
            collector.info(text.replace(
                " For exact positions project the input to a projected metric coordinate "
                "system first (Project tool, with the right geographic transformation).",
                " The results are written back through the same projection, so they are not "
                "offset."))
        else:
            collector.warning(text)
    if read_sr is None:
        read_sr = desc["sr_object"]
    return {"read_sr": read_sr, "wkid": decision["wkid"],
            "mpu": decision["meters_per_unit"], "local": False}


def local_tm_rows(rows, collector):
    """Rows ``{"oid", "shape", ...}`` in geographic degrees -> the same rows with
    ``shape`` projected on each feature's own local Transverse Mercator (metres).

    Returns ``(rows, frames)``; ``frames[oid] = (lon0, (lo, hi))`` turns a point of
    that feature back into degrees (``local_tm_point_back``): ``lo``/``hi`` are the
    smallest and largest longitude the feature stores, so points go back in the
    input's own longitude convention (-180..180 or 0..360). A feature with a
    vertex farther than ``TM_MAX_FEATURE_OFFSET_M`` from its central meridian
    (about 1,000 km) cannot be measured accurately on one projection: warning
    with its ObjectIDs.

    A feature near a pole (``_projection_polar_sign``: beyond 84N / 80S, or round
    the pole) is projected on a polar stereographic instead (``local_ps_geometry``,
    true scale at the feature); its frame is ``(lon0, (lo, hi), sign, k_ref)``. A
    polar feature whose scale varies by more than ``PS_MAX_FEATURE_SPREAD`` over
    it gets a warning.
    """
    out, frames, wide, polar_wide = [], {}, [], []
    for row in rows:
        new = dict(row)
        lons, lats = [], []
        if row["shape"]:
            _projection_lonlats(row["shape"], lons)
            _projection_lats(row["shape"], lats)
        if not lons:
            new["shape"] = None
            out.append(new)
            continue
        _west, _east, lon0, width = longitude_span(lons)
        stored = (min(lons), max(lons))  # stored range: the input's longitude convention
        sign = _projection_polar_sign(lats, width)
        if sign:
            shape, k_ref, spread = local_ps_geometry(row["shape"], lon0, sign)
            frames[row["oid"]] = (lon0, stored, sign, k_ref)
            if spread > PS_MAX_FEATURE_SPREAD:
                polar_wide.append(row["oid"])
        else:
            shape = _projection_tm_node(row["shape"], lon0)
            frames[row["oid"]] = (lon0, stored)
            if _projection_max_abs_x(shape) > TM_MAX_FEATURE_OFFSET_M:
                wide.append(row["oid"])
        new["shape"] = shape
        out.append(new)
    if polar_wide:
        collector.warning(
            "{0} polar feature(s) span too many degrees of latitude for one polar stereographic "
            "projection to measure them within about 1 % (ObjectIDs {1}). Split them, or "
            "project the input to an equal-area or equidistant system suited to them first."
            .format(len(polar_wide), ", ".join(str(o) for o in sorted(polar_wide)[:20]) +
                    (", ..." if len(polar_wide) > 20 else "")))
    if wide:
        collector.warning(
            "{0} feature(s) reach more than {1:,.0f} km from the central meridian of their own "
            "Transverse Mercator projection (ObjectIDs {2}); even on that projection their "
            "measures can be off by more than 1 %. Split them, or project the input to an "
            "equal-area or equidistant system suited to them first."
            .format(len(wide), TM_MAX_FEATURE_OFFSET_M / 1000.0, ", ".join(
                str(o) for o in sorted(wide)[:20]) + (", ..." if len(wide) > 20 else "")))
    return out, frames


def _projection_max_abs_x(node):
    """Largest ``|x|`` of the vertices of a projected core geometry (0 if empty)."""
    if not isinstance(node, (list, tuple)) or not node:
        return 0.0
    if isinstance(node[0], (int, float)):
        return abs(float(node[0]))
    return max(_projection_max_abs_x(item) for item in node)


def _projection_lon_into_range(lon, stored, lon0=None):
    """Shift ``lon`` by whole turns into the longitudes the feature stores.

    ``stored`` is ``(lo, hi)``, the smallest and largest stored longitude of the
    feature (a single number is taken as ``(x, x)``). The shift that puts ``lon``
    inside ``[lo, hi]``, or nearest to it, wins (RT7-A-1 / RT8-C-4: a point used
    to be wrapped toward the feature's first vertex, so a part across the
    antimeridian from it came back 360 degrees away). Ties (a point exactly on
    the antimeridian) keep the input's convention: -180..180 when every stored
    longitude is in it, else 0..360 when every one is in that, then the side of
    the feature's central meridian ``lon0`` (the point as projected back), then
    the shift nearest the middle of the stored range."""
    if isinstance(stored, (int, float)):
        lo = hi = float(stored)
    else:
        lo, hi = float(stored[0]), float(stored[1])
    if -180.0 <= lo and hi <= 180.0:
        window = (-180.0, 180.0)
    elif 0.0 <= lo and hi <= 360.0:
        window = (0.0, 360.0)
    else:
        window = None
    mid = (lo + hi) / 2.0
    base = float(lon) + 360.0 * round((mid - float(lon)) / 360.0)
    best, best_key = base, None
    for cand in (base - 360.0, base, base + 360.0):
        gap = max(lo - cand, cand - hi, 0.0)
        outside = 0 if window is None or window[0] - 1e-9 <= cand <= window[1] + 1e-9 else 1
        side = 0.0 if lon0 is None else round(abs(cand - float(lon)), 9)
        key = (round(gap, 9), outside, side, abs(cand - mid))
        if best_key is None or key < best_key:
            best, best_key = cand, key
    return best


def local_tm_point_back(point, frame):
    """A point of ``local_tm_rows`` back in the degrees read (``frame`` from it).

    The longitude is put in the range of the feature's own stored longitudes
    (``_projection_lon_into_range``), so it stays in the input's convention
    whichever part of a multipart or antimeridian-crossing feature it is on."""
    if point is None or frame is None:
        return point
    if len(frame) > 2:  # polar stereographic frame (lon0, (lo, hi), sign, k_ref)
        lon, lat = ps_inverse(point[0], point[1], frame[0], frame[2], frame[3])
    else:
        lon, lat = tm_inverse(point[0], point[1], frame[0])
    return [_projection_lon_into_range(lon, frame[1], frame[0]), lat]


def local_tm_point_to_frame(point, frame):
    """A point ``(lon, lat)`` in the degrees read projected on the plane of one
    feature of ``local_tm_rows`` (``frame`` from it): the inverse of
    ``local_tm_point_back``. Used to measure another input (e.g. points)
    against that feature on the feature's own projection."""
    if point is None or frame is None:
        return point
    if len(frame) > 2:  # polar stereographic frame (lon0, (lo, hi), sign, k_ref)
        x, y = ps_forward(point[0], point[1], frame[0], frame[2], frame[3])
    else:
        x, y = tm_forward(point[0], point[1], frame[0])
    return [x, y]


# ==========================================================================
# common/geom.py
# ==========================================================================
# Pure-Python planar geometry on the toolkit's core representation.
#
# Core representation (see ARCHITECTURE)::
#
#     point       (x, y)
#     multipoint  [(x, y), ...]
#     polyline    [path, ...]            path = [(x, y), ...]
#     polygon     [ring, ...]            ring = [(x, y), ..., first point again]
#     null/empty  None
#
# Polygon rings follow the Esri convention: outer rings clockwise, holes
# counter-clockwise. All measures are planar, in the units of the coordinates;
# project to a metric system first (see ``projection``).
#
# The geometry *kind* is one of ``"point"``, ``"multipoint"``, ``"polyline"``,
# ``"polygon"`` (lower case, as used in Esri JSON helpers below).

GEOM_POINT = "point"
GEOM_MULTIPOINT = "multipoint"
GEOM_POLYLINE = "polyline"
GEOM_POLYGON = "polygon"

_GEOM_SHAPE_TYPES = {"point": GEOM_POINT, "multipoint": GEOM_MULTIPOINT,
                     "polyline": GEOM_POLYLINE, "polygon": GEOM_POLYGON}


def kind_from_shape_type(shape_type):
    """Map a Describe ``shapeType`` (``"Polygon"``...) to a core kind.

    Returns ``None`` for unsupported types such as ``"MultiPatch"``.
    """
    return _GEOM_SHAPE_TYPES.get(str(shape_type or "").casefold())


# --------------------------------------------------------------------------
# Basic measures
# --------------------------------------------------------------------------

def iter_points(kind, geom):
    """Yield every vertex of a core geometry."""
    if geom is None:
        return
    if kind == GEOM_POINT:
        yield geom
    elif kind == GEOM_MULTIPOINT:
        for p in geom:
            yield p
    else:
        for part in geom:
            for p in part:
                yield p


def geometry_bbox(kind, geom):
    """``(xmin, ymin, xmax, ymax)`` or ``None`` for an empty geometry."""
    xs, ys = [], []
    for x, y in iter_points(kind, geom):
        xs.append(x)
        ys.append(y)
    if not xs:
        return None
    return (min(xs), min(ys), max(xs), max(ys))


def bbox_intersects(a, b, tolerance=0.0):
    """True if two bboxes overlap or touch (within ``tolerance``)."""
    if a is None or b is None:
        return False
    return not (a[2] + tolerance < b[0] or b[2] + tolerance < a[0]
                or a[3] + tolerance < b[1] or b[3] + tolerance < a[1])


def point_distance(a, b):
    return math.hypot(b[0] - a[0], b[1] - a[1])


def path_length(path):
    """Length of one path (or ring)."""
    return sum(point_distance(path[i], path[i + 1]) for i in range(len(path) - 1))


def polyline_length(paths):
    """Total length of a polyline (all parts)."""
    if not paths:
        return 0.0
    return sum(path_length(p) for p in paths)


def ring_signed_area(ring):
    """Shoelace signed area: positive for counter-clockwise rings.

    Coordinates are shifted to the first vertex first, which keeps full
    precision for data far from the origin (e.g. UTM northings near 10^7).
    """
    n = len(ring)
    if n < 3:
        return 0.0
    x0, y0 = ring[0]
    total = 0.0
    for i in range(n - 1):
        x1, y1 = ring[i][0] - x0, ring[i][1] - y0
        x2, y2 = ring[i + 1][0] - x0, ring[i + 1][1] - y0
        total += x1 * y2 - x2 * y1
    # An unclosed ring needs no extra term: after the shift its closing
    # segment ends at the origin, whose cross product is zero.
    return total / 2.0


def ring_is_clockwise(ring):
    """True for clockwise rings (Esri outer rings)."""
    return ring_signed_area(ring) < 0


def close_ring(ring):
    """Copy of ``ring`` with the first vertex repeated at the end if needed."""
    ring = [tuple(p) for p in ring]
    if ring and ring[0] != ring[-1]:
        ring.append(ring[0])
    return ring


def polygon_area(rings):
    """Area of a polygon (all parts, holes subtracted), always >= 0."""
    total = 0.0
    for outer, holes in group_rings(rings):
        total += abs(ring_signed_area(outer)) - sum(abs(ring_signed_area(h)) for h in holes)
    return max(total, 0.0)


def polygon_perimeter(rings):
    """Length of all rings (outer and holes), like ``SHAPE@LENGTH`` for polygons."""
    return sum(path_length(r) for r in (rings or []))


def geometry_length(kind, geom):
    """Length for lines, perimeter for polygons, 0 for points."""
    if geom is None:
        return 0.0
    if kind == GEOM_POLYLINE:
        return polyline_length(geom)
    if kind == GEOM_POLYGON:
        return polygon_perimeter(geom)
    return 0.0


def part_count(kind, geom):
    """Number of parts (points of a multipoint, paths, or outer rings)."""
    if geom is None:
        return 0
    if kind == GEOM_POINT:
        return 1
    if kind == GEOM_POLYGON:
        return len(group_rings(geom))
    return len(geom)


# --------------------------------------------------------------------------
# Rings, containment
# --------------------------------------------------------------------------

def point_on_segment(p, a, b, tolerance=1e-9):
    """True if ``p`` lies on segment ``a``-``b`` (within ``tolerance``)."""
    return point_segment_distance(p, a, b)[0] <= tolerance


def point_in_ring(p, ring, tolerance=1e-9):
    """``"in"``, ``"out"`` or ``"boundary"`` for a point and one ring (ray casting)."""
    x, y = p
    inside = False
    n = len(ring)
    for i in range(n - 1 if ring and ring[0] == ring[-1] else n):
        a = ring[i]
        b = ring[(i + 1) % n]
        if point_on_segment(p, a, b, tolerance):
            return "boundary"
        if (a[1] > y) != (b[1] > y):
            x_cross = a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
            if x < x_cross:
                inside = not inside
    return "in" if inside else "out"


class _GeomRingProbe(object):
    """``point_in_ring`` for many points against one large ring.

    The ring's edges are filed in horizontal bands, so a query only looks at
    the edges whose y range reaches the point (a ray crossing or a boundary
    hit needs exactly those). Same answers as ``point_in_ring``, at about
    the cost of the edges in one band instead of every edge.
    """

    def __init__(self, ring, tolerance=1e-9):
        self.ring = ring
        self.tolerance = tolerance
        n = len(ring)
        self.count = n - 1 if ring and ring[0] == ring[-1] else n
        ys = [p[1] for p in ring]
        self.y0, self.y1 = min(ys), max(ys)
        self.bands = max(1, self.count // 4)
        span = self.y1 - self.y0
        self.height = span / self.bands if span > 0 and math.isfinite(span) else 0.0
        if self.height <= 0:
            self.bands = 1
        self.edges = [[] for _ in range(self.bands)]
        for i in range(self.count):
            a, b = ring[i], ring[(i + 1) % n]
            lo, hi = self._band(min(a[1], b[1])), self._band(max(a[1], b[1]))
            for k in range(lo, hi + 1):
                self.edges[k].append(i)

    def _band(self, y):
        if self.height <= 0:
            return 0
        k = int(math.floor((y - self.y0) / self.height))
        return min(max(k, 0), self.bands - 1)

    def locate(self, p):
        """``"in"``, ``"out"`` or ``"boundary"`` (see ``point_in_ring``)."""
        x, y = p
        tol = self.tolerance
        if y < self.y0 - tol or y > self.y1 + tol:
            return "out"
        lo, hi = self._band(y - tol), self._band(y + tol)
        if lo == hi:
            candidates = self.edges[lo]
        else:
            seen = set()
            for k in range(lo, hi + 1):
                seen.update(self.edges[k])
            candidates = sorted(seen)
        ring, n = self.ring, len(self.ring)
        inside = False
        for i in candidates:
            a, b = ring[i], ring[(i + 1) % n]
            if (min(a[0], b[0]) - tol <= x <= max(a[0], b[0]) + tol
                    and min(a[1], b[1]) - tol <= y <= max(a[1], b[1]) + tol
                    and point_on_segment(p, a, b, tol)):
                return "boundary"
            if (a[1] > y) != (b[1] > y):
                x_cross = a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
                if x < x_cross:
                    inside = not inside
        return "in" if inside else "out"


# Rings with more vertices than this get a _GeomRingProbe in group_rings.
_GEOM_PROBE_MIN_VERTICES = 64


def _geom_ring_inside(inner, outer, probe=None):
    """True if ring ``inner`` lies inside ring ``outer`` (vertex test).

    Uses the first vertex that is not on the boundary of ``outer``; rings that
    share every vertex are treated as inside. ``probe`` is an optional
    ``_GeomRingProbe`` of ``outer`` (same answers, faster for large rings).
    """
    for p in inner:
        state = probe.locate(p) if probe is not None else point_in_ring(p, outer)
        if state != "boundary":
            return state == "in"
    return True


def group_rings(rings):
    """Group rings into polygons: ``[(outer, [holes...]), ...]``.

    Clockwise rings are outers and counter-clockwise rings are holes (Esri
    convention). Each hole is assigned to the smallest outer that contains it.
    A hole contained by no outer is kept as its own outer (bad orientation in
    the source), so no ring is ever lost. Degenerate rings (area 0) are
    treated as outers. Output order follows input order.

    Candidate outers for a hole come from a ``GridIndex`` of ring bboxes, so a
    multipart polygon with many parts and holes is not parts x holes ring
    tests (a ring can only contain a vertex of the hole if their bboxes meet,
    so the result is the same as testing every outer).
    """
    rings = [close_ring(r) for r in (rings or []) if len(r) >= 3]
    outers, holes = [], []
    for r in rings:
        (holes if ring_signed_area(r) > 0 else outers).append(r)
    groups = [(o, []) for o in outers]
    if not holes:
        return groups
    boxes = [_geom_ring_bbox(r) for r in rings]
    width = max(b[2] for b in boxes) - min(b[0] for b in boxes)
    height = max(b[3] for b in boxes) - min(b[1] for b in boxes)
    # About one grid cell per ring over the extent of all rings.
    cell = max(math.sqrt(width * height / len(rings)), max(width, height) / len(rings))
    index = GridIndex(cell if cell > 0 and math.isfinite(cell) else 1.0)
    areas = []
    for idx, o in enumerate(outers):
        index.insert(idx, _geom_ring_bbox(o))
        areas.append(abs(ring_signed_area(o)))
    # Banded edge index per large candidate ring, built on first use: one
    # outer with thousands of vertices and hundreds of holes (a coastline
    # with lakes) is then not holes x vertices segment tests (RT4-A-2).
    probes = {}
    for h in holes:
        box = _geom_ring_bbox(h)
        best, best_area = None, None
        for idx in index.query(box):  # ascending: ties keep the first outer
            outer = groups[idx][0]
            probe = probes.get(idx)
            if probe is None and len(outer) > _GEOM_PROBE_MIN_VERTICES:
                probe = probes[idx] = _GeomRingProbe(outer)
            if _geom_ring_inside(h, outer, probe):
                area = areas[idx]
                if best is None or area < best_area:
                    best, best_area = idx, area
        if best is None:
            index.insert(len(groups), box)
            areas.append(abs(ring_signed_area(h)))
            groups.append((h, []))
        else:
            groups[best][1].append(h)
    return groups


def _geom_ring_bbox(ring):
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    return (min(xs), min(ys), max(xs), max(ys))


def point_in_polygon(p, rings, include_boundary=True):
    """True if ``p`` is inside the polygon (holes excluded)."""
    for outer, holes in group_rings(rings):
        state = point_in_ring(p, outer)
        if state == "boundary":
            return include_boundary
        if state == "out":
            continue
        in_hole = False
        for h in holes:
            hs = point_in_ring(p, h)
            if hs == "boundary":
                return include_boundary
            if hs == "in":
                in_hole = True
                break
        if not in_hole:
            return True
    return False


# --------------------------------------------------------------------------
# Segments
# --------------------------------------------------------------------------

def point_segment_distance(p, a, b):
    """``(distance, closest_point, t)`` from ``p`` to segment ``a``-``b``.

    ``t`` is the position of the closest point along the segment (0..1).
    """
    ax, ay = a
    dx, dy = b[0] - ax, b[1] - ay
    seg2 = dx * dx + dy * dy
    if seg2 == 0.0:
        return point_distance(p, a), (ax, ay), 0.0
    t = ((p[0] - ax) * dx + (p[1] - ay) * dy) / seg2
    t = min(1.0, max(0.0, t))
    c = (ax + t * dx, ay + t * dy)
    return point_distance(p, c), c, t


def _geom_cross(o, a, b):
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])


def segment_intersection(a, b, c, d, tolerance=1e-12):
    """Intersection of segments ``a``-``b`` and ``c``-``d``.

    Returns ``None``, ``("point", (x, y))`` or ``("overlap", (p, q))`` for
    collinear overlapping segments (``p``-``q`` is the shared piece).
    """
    r = (b[0] - a[0], b[1] - a[1])
    s = (d[0] - c[0], d[1] - c[1])
    denom = r[0] * s[1] - r[1] * s[0]
    qp = (c[0] - a[0], c[1] - a[1])
    scale = max(1.0, abs(r[0]), abs(r[1]), abs(s[0]), abs(s[1]))
    if abs(denom) <= tolerance * scale * scale:
        # Parallel. Collinear?
        if abs(qp[0] * r[1] - qp[1] * r[0]) > tolerance * scale * scale:
            return None
        rr = r[0] * r[0] + r[1] * r[1]
        if rr == 0.0:
            if point_on_segment(a, c, d, tolerance * scale):
                return ("point", (a[0], a[1]))
            return None
        t0 = (qp[0] * r[0] + qp[1] * r[1]) / rr
        t1 = t0 + (s[0] * r[0] + s[1] * r[1]) / rr
        lo, hi = max(0.0, min(t0, t1)), min(1.0, max(t0, t1))
        if lo > hi + tolerance:
            return None
        p = (a[0] + lo * r[0], a[1] + lo * r[1])
        q = (a[0] + hi * r[0], a[1] + hi * r[1])
        if abs(hi - lo) <= tolerance:
            return ("point", p)
        return ("overlap", (p, q))
    t = (qp[0] * s[1] - qp[1] * s[0]) / denom
    u = (qp[0] * r[1] - qp[1] * r[0]) / denom
    eps = tolerance
    if -eps <= t <= 1 + eps and -eps <= u <= 1 + eps:
        return ("point", (a[0] + t * r[0], a[1] + t * r[1]))
    return None


def densify_path(path, max_segment):
    """Copy of ``path`` with extra vertices so no segment exceeds ``max_segment``."""
    if max_segment <= 0:
        raise ValueError("max_segment must be positive")
    if not path:
        return []
    out = [tuple(path[0])]
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        n = int(math.ceil(point_distance(a, b) / max_segment))
        for k in range(1, n):
            f = float(k) / n
            out.append((a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1])))
        out.append(tuple(b))
    return out


def densify_path_segments(path, max_segment, wrap_longitude=False):
    """Copy of ``path`` with extra vertices so no segment exceeds ``max_segment``,
    each segment densified on its own (original vertices kept).

    ``wrap_longitude`` (geographic data, x = longitude in degrees): a segment
    spanning more than 180 degrees of longitude is taken to cross the
    antimeridian the short way; its new vertices are interpolated on the
    unwrapped longitude and wrapped back into [-180, 180).
    """
    if max_segment <= 0:
        raise ValueError("max_segment must be positive")
    if not path:
        return []
    out = [tuple(path[0])]
    for i in range(len(path) - 1):
        a, b = tuple(path[i]), tuple(path[i + 1])
        bx = b[0]
        if wrap_longitude and abs(bx - a[0]) > 180.0:
            bx += -360.0 if bx > a[0] else 360.0
        n = int(math.ceil(math.hypot(bx - a[0], b[1] - a[1]) / max_segment))
        for k in range(1, n):
            f = float(k) / n
            x = a[0] + f * (bx - a[0])
            if wrap_longitude:
                x = ((x + 180.0) % 360.0) - 180.0
            out.append((x, a[1] + f * (b[1] - a[1])))
        out.append(b)
    return out


# --------------------------------------------------------------------------
# Spatial index
# --------------------------------------------------------------------------

class GridIndex(object):
    """Uniform grid of bounding boxes for fast candidate-pair search.

    ``insert(key, box)`` registers a bbox; ``query(box)`` returns keys whose
    bbox intersects ``box``; ``candidate_pairs()`` returns all ``(k1, k2)``
    with ``k1 < k2`` and intersecting bboxes, sorted. Keys must be orderable.
    Choose ``cell_size`` around the typical feature size (plus any search
    tolerance, which can be passed to ``query``/``candidate_pairs``).
    """

    def __init__(self, cell_size):
        if not cell_size or cell_size <= 0:
            raise ValueError("cell_size must be positive")
        self.cell_size = float(cell_size)
        self.cells = {}
        self.boxes = {}

    def _cells_for(self, box, tolerance=0.0):
        cs = self.cell_size
        x0 = int(math.floor((box[0] - tolerance) / cs))
        y0 = int(math.floor((box[1] - tolerance) / cs))
        x1 = int(math.floor((box[2] + tolerance) / cs))
        y1 = int(math.floor((box[3] + tolerance) / cs))
        for gx in range(x0, x1 + 1):
            for gy in range(y0, y1 + 1):
                yield (gx, gy)

    def insert(self, key, box):
        if box is None:
            return
        self.boxes[key] = box
        for cell in self._cells_for(box):
            self.cells.setdefault(cell, []).append(key)

    def query(self, box, tolerance=0.0):
        found = set()
        for cell in self._cells_for(box, tolerance):
            for key in self.cells.get(cell, ()):
                if key not in found and bbox_intersects(self.boxes[key], box, tolerance):
                    found.add(key)
        return sorted(found)

    def candidate_pairs(self, tolerance=0.0):
        pairs = set()
        for keys in self.cells.values():
            for i in range(len(keys)):
                for j in range(i + 1, len(keys)):
                    k1, k2 = keys[i], keys[j]
                    if k1 == k2:
                        continue
                    if k2 < k1:
                        k1, k2 = k2, k1
                    if (k1, k2) not in pairs and bbox_intersects(
                            self.boxes[k1], self.boxes[k2], tolerance):
                        pairs.add((k1, k2))
        if tolerance > 0:
            # Boxes closer than the tolerance may sit in non-adjacent-by-content cells.
            for k1, box in self.boxes.items():
                for k2 in self.query(box, tolerance):
                    if k1 < k2:
                        pairs.add((k1, k2))
        return sorted(pairs)


# --------------------------------------------------------------------------
# Esri JSON <-> core
# --------------------------------------------------------------------------

def esri_json_has_curves(data):
    """True if an Esri JSON geometry dict contains true curves."""
    return isinstance(data, dict) and ("curvePaths" in data or "curveRings" in data)


def esri_json_zm(data):
    """``(has_z, has_m)`` of an Esri JSON geometry dict.

    Esri JSON marks Z and M with ``"hasZ": true`` / ``"hasM": true``. When neither key is
    present a coordinate with three numbers is read as Z. ``esri_json_to_core`` drops both."""
    if not isinstance(data, dict):
        return False, False
    has_z, has_m = data.get("hasZ") is True, data.get("hasM") is True
    if "hasZ" in data or "hasM" in data:
        return has_z, has_m
    first = None
    for key in ("rings", "paths"):
        parts = data.get(key)
        if parts and parts[0]:
            first = parts[0][0]
            break
    if first is None and data.get("points"):
        first = data["points"][0]
    return (first is not None and len(first) >= 3), False


def _geom_xy(coord):
    return (float(coord[0]), float(coord[1]))


def _geom_is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def esri_json_to_core(data):
    """Convert an Esri JSON geometry dict to ``(kind, geom)``.

    Z and M values are dropped. Empty geometries give ``(kind, None)``.
    Raises ``ValueError`` for curves (handle them before calling) and for
    unknown structures.
    """
    if data is None:
        return None, None
    if esri_json_has_curves(data):
        raise ValueError("true curves must be densified before conversion")
    if "x" in data:
        x, y = data.get("x"), data.get("y")
        if not (_geom_is_number(x) and _geom_is_number(y)):
            return GEOM_POINT, None
        return GEOM_POINT, (float(x), float(y))
    if "points" in data:
        pts = [_geom_xy(c) for c in data["points"]]
        return GEOM_MULTIPOINT, (pts or None)
    if "paths" in data:
        paths = [[_geom_xy(c) for c in path] for path in data["paths"]]
        paths = [p for p in paths if p]
        return GEOM_POLYLINE, (paths or None)
    if "rings" in data:
        rings = [close_ring([_geom_xy(c) for c in ring]) for ring in data["rings"]]
        rings = [r for r in rings if r]
        return GEOM_POLYGON, (rings or None)
    raise ValueError("unsupported Esri JSON geometry: keys {0}".format(sorted(data)))


def core_to_esri_json(kind, geom, wkid=None):
    """Convert a core geometry to an Esri JSON dict (for ``arcpy.AsShape(d, True)``).

    Returns ``None`` for a null geometry.
    """
    if geom is None:
        return None
    if kind == GEOM_POINT:
        data = {"x": float(geom[0]), "y": float(geom[1])}
    elif kind == GEOM_MULTIPOINT:
        data = {"points": [[float(x), float(y)] for (x, y) in geom]}
    elif kind == GEOM_POLYLINE:
        data = {"paths": [[[float(x), float(y)] for (x, y) in path] for path in geom]}
    elif kind == GEOM_POLYGON:
        data = {"rings": [[[float(x), float(y)] for (x, y) in close_ring(r)] for r in geom]}
    else:
        raise ValueError("unknown geometry kind: {0}".format(kind))
    if wkid:
        data["spatialReference"] = {"wkid": int(wkid)}
    return data


# --------------------------------------------------------------------------
# Vertex angles, segment lengths, spikes
# --------------------------------------------------------------------------

def _geom_distinct_ring(path):
    """Ring vertices without the closing duplicate."""
    pts = [tuple(p) for p in path]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    return pts


def vertex_angle(a, b, c):
    """Interior angle at ``b`` between legs ``b->a`` and ``b->c`` in degrees
    (0..180). ``None`` if a leg has zero length. 0 = spike (the line turns
    back on itself), 180 = straight."""
    v1 = (a[0] - b[0], a[1] - b[1])
    v2 = (c[0] - b[0], c[1] - b[1])
    if (v1[0] == 0.0 and v1[1] == 0.0) or (v2[0] == 0.0 and v2[1] == 0.0):
        return None
    cross = v1[0] * v2[1] - v1[1] * v2[0]
    dot = v1[0] * v2[0] + v1[1] * v2[1]
    return math.degrees(math.atan2(abs(cross), dot))


def turn_angle(a, b, c):
    """Signed change of direction at ``b`` in degrees, in (-180, 180]:
    positive = left (counter-clockwise) turn, 0 = straight on.
    ``None`` if a leg has zero length."""
    d1 = (b[0] - a[0], b[1] - a[1])
    d2 = (c[0] - b[0], c[1] - b[1])
    if (d1[0] == 0.0 and d1[1] == 0.0) or (d2[0] == 0.0 and d2[1] == 0.0):
        return None
    cross = d1[0] * d2[1] - d1[1] * d2[0]
    dot = d1[0] * d2[0] + d1[1] * d2[1]
    ang = math.degrees(math.atan2(cross, dot))
    return 180.0 if ang == -180.0 else ang


def path_is_closed(path):
    """True if the path has at least 4 points and first == last."""
    return len(path) >= 4 and tuple(path[0]) == tuple(path[-1])


def path_vertex_angles(path, closed=None, signed=False):
    """Angle at every vertex: ``vertex_angle`` (or ``turn_angle`` if ``signed``).

    ``closed=None`` detects rings (``path_is_closed``). Open path: one value
    per vertex, ``None`` at both ends. Ring: one value per *distinct*
    vertex (the closing duplicate is not repeated); the first vertex uses
    the last distinct vertex as its predecessor. Zero-length legs give
    ``None`` (remove duplicate vertices first if needed).
    """
    fn = turn_angle if signed else vertex_angle
    if closed is None:
        closed = path_is_closed(path)
    if closed:
        pts = _geom_distinct_ring(path)
        n = len(pts)
        if n < 3:
            return [None] * n
        return [fn(pts[i - 1], pts[i], pts[(i + 1) % n]) for i in range(n)]
    pts = [tuple(p) for p in path]
    n = len(pts)
    out = [None] * n
    for i in range(1, n - 1):
        out[i] = fn(pts[i - 1], pts[i], pts[i + 1])
    return out


def segment_lengths(path):
    """Length of every segment of ``path`` (``len(path) - 1`` values)."""
    return [point_distance(path[i], path[i + 1]) for i in range(len(path) - 1)]


def segment_length_stats(path):
    """``{"count", "min", "max", "mean", "total"}`` of the segment lengths
    (``None`` values for a path with no segment)."""
    lengths = segment_lengths(path)
    if not lengths:
        return {"count": 0, "min": None, "max": None, "mean": None, "total": 0.0}
    total = sum(lengths)
    return {"count": len(lengths), "min": min(lengths), "max": max(lengths),
            "mean": total / len(lengths), "total": total}


def find_spikes(path, max_angle, closed=None):
    """Vertex indices whose interior angle is below ``max_angle`` degrees.

    Indices refer to ``path`` (for rings: distinct vertices, index 0 = the
    start/closing vertex). Zero-length legs are not spikes (see
    ``near_duplicate_vertices``).
    """
    return [i for i, ang in enumerate(path_vertex_angles(path, closed))
            if ang is not None and ang < max_angle]


def near_duplicate_vertices(path, tolerance):
    """Indices ``i`` where vertex ``i`` and the next vertex are at most
    ``tolerance`` apart (exact duplicates included). For a ring the closing
    duplicate itself is not reported, but the pair (last distinct, first)
    is checked and reported as the last distinct index."""
    closed = path_is_closed(path)
    pts = _geom_distinct_ring(path) if closed else [tuple(p) for p in path]
    n = len(pts)
    out = [i for i in range(n - 1) if point_distance(pts[i], pts[i + 1]) <= tolerance]
    if closed and n > 1 and point_distance(pts[-1], pts[0]) <= tolerance:
        out.append(n - 1)
    return out


def remove_repeated_vertices(path, tolerance=0.0):
    """Copy of ``path`` without vertices within ``tolerance`` of the previous
    kept vertex. The first and last vertex are always kept (the last one
    replaces a kept vertex that is too close to it)."""
    pts = [tuple(p) for p in path]
    if len(pts) < 2:
        return pts
    out = [pts[0]]
    for p in pts[1:]:
        if point_distance(out[-1], p) > tolerance:
            out.append(p)
    if len(out) == 1:
        out.append(pts[-1])
    elif out[-1] != pts[-1]:
        out[-1] = pts[-1]
    return out


# --------------------------------------------------------------------------
# Measures along a path, interpolation, splitting
# --------------------------------------------------------------------------

def path_measures(path):
    """Cumulative distance at every vertex (first = 0; empty path -> [])."""
    if not path:
        return []
    out = [0.0]
    for i in range(len(path) - 1):
        out.append(out[-1] + point_distance(path[i], path[i + 1]))
    return out


def path_point_at(path, distance):
    """Point at ``distance`` along ``path``, clamped to [0, length].
    ``None`` for an empty path."""
    if not path:
        return None
    if distance <= 0 or len(path) == 1:
        return tuple(path[0])
    run = 0.0
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        seg = point_distance(a, b)
        if seg > 0 and run + seg >= distance:
            f = (distance - run) / seg
            return (a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1]))
        run += seg
    return tuple(path[-1])


def path_midpoint(path):
    """Point at half the length of ``path``."""
    return path_point_at(path, path_length(path) / 2.0)


def locate_point_on_path(p, path):
    """Project ``p`` onto ``path``.

    Returns ``{"measure", "offset", "side", "segment", "point"}``: distance
    along the path of the closest point, distance from ``p`` to it, side
    ``"L"`` or ``"R"`` of the digitising direction (``""`` when on the line),
    the segment index and the closest point. The first closest segment wins
    on ties. ``None`` for a path with fewer than 2 vertices.
    """
    if len(path) < 2:
        return None
    best = None
    run = 0.0
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        d, c, t = point_segment_distance(p, a, b)
        seg = point_distance(a, b)
        if best is None or d < best[0]:
            cross = _geom_cross(a, b, p)
            side = "" if d == 0.0 or cross == 0.0 else ("L" if cross > 0 else "R")
            best = (d, run + t * seg, side, i, c)
        run += seg
    return {"offset": best[0], "measure": best[1], "side": best[2], "segment": best[3],
            "point": best[4]}


def split_path_at_distances(path, distances, min_length=0.0):
    """Split ``path`` at the given distances along it.

    Distances outside (0, length) are ignored and duplicates merged. Each
    piece keeps the original vertices between its cut points; the first and
    last piece end exactly on the original end vertices. Pieces not longer
    than ``min_length`` (default: zero-length pieces) are dropped.
    """
    pts = [tuple(p) for p in path]
    if len(pts) < 2:
        return []
    total = path_length(pts)
    cuts = sorted(set(float(d) for d in distances if 0.0 < d < total))
    measures = path_measures(pts)
    bounds = [0.0] + cuts + [total]
    pieces = []
    last = len(bounds) - 2
    for k in range(len(bounds) - 1):
        lo, hi = bounds[k], bounds[k + 1]
        piece = [pts[0] if k == 0 else path_point_at(pts, lo)]
        for i in range(1, len(pts) - 1):
            if lo < measures[i] < hi:
                piece.append(pts[i])
        piece.append(pts[-1] if k == last else path_point_at(pts, hi))
        if path_length(piece) > min_length:
            pieces.append(piece)
    return pieces


def split_path_at_vertices(path, min_length=0.0):
    """One two-point piece per segment; pieces not longer than ``min_length``
    (default: zero-length segments) are dropped."""
    pts = [tuple(p) for p in path]
    return [[pts[i], pts[i + 1]] for i in range(len(pts) - 1)
            if point_distance(pts[i], pts[i + 1]) > min_length]


def split_distances(length, max_length, mode="fixed"):
    """Cut distances so that no piece exceeds ``max_length``.

    ``"fixed"``: cuts at ``max_length``, ``2*max_length``, ... (the last piece
    is the remainder); ``"equal"``: ``ceil(length / max_length)`` equal
    pieces. A remainder shorter than 1e-9 * ``max_length`` is not cut off.
    """
    if max_length <= 0:
        raise ValueError("max_length must be positive")
    if mode not in ("fixed", "equal"):
        raise ValueError("mode must be 'fixed' or 'equal'")
    if length <= max_length * (1 + 1e-9):
        return []
    if mode == "equal":
        n = int(math.ceil(length / max_length - 1e-9))
        return [length * k / n for k in range(1, n)]
    eps = 1e-9 * max_length
    out = []
    k = 1
    while k * max_length < length - eps:
        out.append(k * max_length)
        k += 1
    return out


# ==========================================================================
# common/clip.py
# ==========================================================================
# Convex clipping and polygon centroids (pure Python).
#
# * Half-plane clipping of one ring (one Sutherland-Hodgman stage), the
#   bisector half-plane of two sites (Voronoi cells by successive clipping),
#   clipping against an axis-aligned rectangle or any convex ring.
# * Cyrus-Beck clipping of a segment against a convex ring (interior overlap
#   tests: a segment that only runs along the boundary has zero inside length
#   only if callers use ``strict=True``).
# * Ring / polygon centroids (area-weighted, holes subtracted).
#
# Deliberately **no general polygon-polygon overlay**. The subject ring may be
# concave when the clip region is convex; a concave subject can then produce
# zero-width "bridges" along the clip boundary (standard Sutherland-Hodgman
# behaviour): area and centroid stay correct, the vertex list is not
# simplified. Output rings are closed (first == last) and keep the
# orientation of the input ring; ``[]`` means nothing is left.
#
# A half-plane ``(a, b, c)`` is the set of points with ``a*x + b*y <= c``.

# Relative tolerance for "on the clip line" decisions.
CLIP_EPSILON = 1e-12


def _clip_open(ring):
    pts = [tuple(p) for p in ring]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    return pts


def _clip_finish(pts):
    """Drop consecutive duplicates; close; ``[]`` if fewer than 3 vertices."""
    out = []
    for p in pts:
        if not out or p != out[-1]:
            out.append(p)
    if len(out) > 1 and out[0] == out[-1]:
        out.pop()
    if len(out) < 3:
        return []
    return close_ring(out)


def clip_ring_halfplane(ring, a, b, c):
    """Keep the part of ``ring`` with ``a*x + b*y <= c`` (one Sutherland-Hodgman stage).

    Vertices within a relative tolerance of the line count as inside.
    Returns a closed ring or ``[]``.
    """
    pts = _clip_open(ring)
    if not pts:
        return []
    scale = max(1.0, abs(c), max(abs(a * x) + abs(b * y) for x, y in pts))
    eps = CLIP_EPSILON * scale
    vals = [a * x + b * y - c for x, y in pts]
    out = []
    n = len(pts)
    for i in range(n):
        p, q = pts[i], pts[(i + 1) % n]
        vp, vq = vals[i], vals[(i + 1) % n]
        p_in, q_in = vp <= eps, vq <= eps
        if p_in:
            out.append(p)
        if p_in != q_in and abs(vp - vq) > 0:
            t = vp / (vp - vq)
            if 0.0 < t < 1.0:
                out.append((p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])))
    return _clip_finish(out)


def bisector_halfplane(site, other):
    """Half-plane of points at least as close to ``site`` as to ``other``.

    ``|x - s|^2 <= |x - o|^2``  <=>  ``2(o - s) . x <= |o|^2 - |s|^2``.
    Raises ``ValueError`` for identical sites.
    """
    sx, sy = site
    ox, oy = other
    if sx == ox and sy == oy:
        raise ValueError("identical sites have no bisector")
    a = 2.0 * (ox - sx)
    b = 2.0 * (oy - sy)
    c = (ox * ox + oy * oy) - (sx * sx + sy * sy)
    return a, b, c


def rect_ring(xmin, ymin, xmax, ymax, clockwise=True):
    """Closed rectangle ring (clockwise = Esri outer ring by default)."""
    if clockwise:
        pts = [(xmin, ymin), (xmin, ymax), (xmax, ymax), (xmax, ymin)]
    else:
        pts = [(xmin, ymin), (xmax, ymin), (xmax, ymax), (xmin, ymax)]
    return close_ring(pts)


def clip_ring_rect(ring, xmin, ymin, xmax, ymax):
    """Sutherland-Hodgman clip of ``ring`` against an axis-aligned rectangle."""
    if xmin > xmax or ymin > ymax:
        raise ValueError("empty rectangle")
    out = ring
    for a, b, c in ((-1.0, 0.0, -xmin), (1.0, 0.0, xmax), (0.0, -1.0, -ymin), (0.0, 1.0, ymax)):
        out = clip_ring_halfplane(out, a, b, c)
        if not out:
            return []
    return out


def ring_is_convex(ring, tolerance=1e-9):
    """True if ``ring`` is convex (collinear vertices allowed, any orientation).

    Degenerate rings (fewer than 3 distinct vertices or zero area) are not convex.

    A vertex counts as collinear (no turn) only if the sine of its turn angle
    is at most ``tolerance`` (``|cross| <= tolerance * |e1| * |e2|``), plus a
    floating-point floor of ``CLIP_EPSILON * max|coordinate| * (|e1| + |e2|)``
    (a vertex within about 1e-12 of the coordinate size of the line through its
    neighbours). The test is relative to the edge lengths, not to the square
    of the coordinates: a densified edge that is slightly concave (a parallel
    projected to UTM, with a vertex every few hundred metres) turns by a tiny
    angle at each vertex but is still concave, and must be refused, however
    finely it is densified.
    """
    pts = _clip_open(ring)
    n = len(pts)
    if n < 3 or ring_signed_area(close_ring(pts)) == 0.0:
        return False
    floor = CLIP_EPSILON * max(1.0, max(max(abs(x), abs(y)) for x, y in pts))
    sign = 0
    for i in range(n):
        o, p, q = pts[i], pts[(i + 1) % n], pts[(i + 2) % n]
        ux, uy = p[0] - o[0], p[1] - o[1]
        vx, vy = q[0] - p[0], q[1] - p[1]
        cross = ux * vy - uy * vx
        lu, lv = math.hypot(ux, uy), math.hypot(vx, vy)
        if abs(cross) <= tolerance * lu * lv + floor * (lu + lv):
            continue
        s = 1 if cross > 0 else -1
        if sign == 0:
            sign = s
        elif s != sign:
            return False
    # A star polygon turns the same way at every vertex but winds twice.
    total = 0.0
    for i in range(n):
        o, p, q = pts[i - 1], pts[i], pts[(i + 1) % n]
        a1 = math.atan2(p[1] - o[1], p[0] - o[0])
        a2 = math.atan2(q[1] - p[1], q[0] - p[0])
        d = a2 - a1
        while d <= -math.pi:
            d += 2 * math.pi
        while d > math.pi:
            d -= 2 * math.pi
        total += d
    return abs(abs(total) - 2 * math.pi) < 1e-6


def _clip_hull_indexes(pts):
    """Indexes of the strict convex hull of ``pts`` (Andrew's monotone chain),
    counter-clockwise, collinear and duplicate points left out."""
    order = sorted(range(len(pts)), key=lambda i: pts[i])

    def cross(o, a, b):
        return ((pts[a][0] - pts[o][0]) * (pts[b][1] - pts[o][1]) -
                (pts[a][1] - pts[o][1]) * (pts[b][0] - pts[o][0]))

    lower, upper = [], []
    for i in order:
        while len(lower) >= 2 and cross(lower[-2], lower[-1], i) <= 0:
            lower.pop()
        lower.append(i)
    for i in reversed(order):
        while len(upper) >= 2 and cross(upper[-2], upper[-1], i) <= 0:
            upper.pop()
        upper.append(i)
    hull = lower[:-1] + upper[:-1]
    out = []
    for i in hull:  # duplicates of the first point can survive at both ends
        if not out or pts[i] != pts[out[-1]]:
            out.append(i)
    if len(out) > 1 and pts[out[0]] == pts[out[-1]]:
        out.pop()
    return out


def convex_hull_points(points):
    """Strict convex hull of ``points`` (``(x, y)`` tuples), counter-clockwise,
    open (first point not repeated); fewer than 3 points when they are collinear."""
    pts = sorted(set(tuple(p) for p in points))
    return [pts[i] for i in _clip_hull_indexes(pts)]


def near_convex_ring(ring, tolerance):
    """The convex hull of ``ring`` when the ring is convex up to ``tolerance``, else ``None``.

    ``tolerance`` is an absolute distance (coordinate units). The ring is accepted
    when (a) it runs around its convex hull in the hull's order (no star polygon, no
    loop) and (b) every vertex lies at most ``tolerance`` inside the hull edge of the
    stretch it belongs to. So the region between the ring and its hull is never
    deeper than ``tolerance``, however finely an edge is densified: a densified edge
    that bows inwards by more than ``tolerance`` anywhere is refused, while
    vertices on a straight edge that were rounded to the geodatabase resolution
    (a few 0.01 mm off the line) are accepted. The returned ring is the hull,
    closed, in the orientation of the input ring; it is exactly convex, so
    clipping with its half-planes is exact; its vertices are the hull vertices in
    the ring's own order, starting with the first of them in the ring (a strictly
    convex ring comes back unchanged, closed). Degenerate rings (fewer than 3
    distinct vertices, zero area) give ``None``.
    """
    pts = []
    for p in _clip_open(ring):
        if not pts or p != pts[-1]:
            pts.append(p)
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts.pop()
    n = len(pts)
    if n < 3:
        return None
    area = ring_signed_area(close_ring(pts))
    if area == 0.0:
        return None
    hull = _clip_hull_indexes(pts)
    if len(hull) < 3:
        return None
    # Position of every vertex along the ring, walked counter-clockwise (as the hull).
    if area > 0:
        pos = list(range(n))
    else:
        pos = [n - 1 - i for i in range(n)]
    walk = sorted(range(n), key=lambda i: pos[i])
    hpos = [pos[i] for i in hull]
    descents = sum(1 for k in range(len(hull)) if hpos[(k + 1) % len(hull)] < hpos[k])
    if descents != 1:
        return None  # the ring does not go round its hull once, in order
    for k in range(len(hull)):
        a, b = pts[hull[k]], pts[hull[(k + 1) % len(hull)]]
        ex, ey = b[0] - a[0], b[1] - a[1]
        length = math.hypot(ex, ey)
        if length == 0.0:
            continue
        start, end = hpos[k], hpos[(k + 1) % len(hull)]
        steps = (end - start) % n
        for s in range(1, steps):
            p = pts[walk[(start + s) % n]]
            # Left of a counter-clockwise hull edge = inside; depth below the edge.
            depth = (ex * (p[1] - a[1]) - ey * (p[0] - a[0])) / length
            if depth > tolerance:
                return None
    # Hull vertices in the ring's own order, starting at the first one met along the
    # ring, so a ring that is already strictly convex comes back unchanged.
    keep = sorted(hull)
    return close_ring([pts[i] for i in keep])


def convex_halfplanes(convex_ring):
    """The half-planes ``(a, b, c)`` whose intersection is ``convex_ring``
    (either orientation; zero-length edges skipped)."""
    pts = _clip_open(convex_ring)
    ccw = ring_signed_area(close_ring(pts)) > 0
    planes = []
    n = len(pts)
    for i in range(n):
        p, q = pts[i], pts[(i + 1) % n]
        dx, dy = q[0] - p[0], q[1] - p[1]
        if dx == 0.0 and dy == 0.0:
            continue
        # Inside is to the left of each edge for a CCW ring: cross(d, x - p) >= 0
        # <=> dy*x - dx*y <= dy*px - dx*py.
        a, b = dy, -dx
        if not ccw:
            a, b = -a, -b
        planes.append((a, b, a * p[0] + b * p[1]))
    return planes


def clip_ring_convex(ring, convex_ring):
    """Clip ``ring`` against a convex ring (``ValueError`` if not convex)."""
    if not ring_is_convex(convex_ring):
        raise ValueError("clip ring is not convex")
    out = ring
    for a, b, c in convex_halfplanes(convex_ring):
        out = clip_ring_halfplane(out, a, b, c)
        if not out:
            return []
    return out


def clip_segment_convex(p, q, convex_ring, strict=False):
    """Cyrus-Beck: the part of segment ``p``-``q`` inside a convex ring.

    Returns ``(t0, t1)`` parameters along the segment (0..1) or ``None``.
    ``strict=True`` uses the open interior: a segment lying on the boundary
    (or touching it at one point) gives ``None``. Tolerance is relative to
    the coordinate scale.
    """
    planes = convex_halfplanes(convex_ring)
    if not planes:
        return None
    dx, dy = q[0] - p[0], q[1] - p[1]
    scale = max(1.0, abs(p[0]), abs(p[1]), abs(q[0]), abs(q[1]))
    t0, t1 = 0.0, 1.0
    for a, b, c in planes:
        norm = math.hypot(a, b)
        eps = CLIP_EPSILON * scale * norm * 1e3
        num = c - (a * p[0] + b * p[1])     # >= 0 when p is inside
        den = a * dx + b * dy
        if strict:
            num -= eps
        else:
            num += eps
        if den == 0.0:
            if num < 0:
                return None
            continue
        t = num / den
        if den > 0:
            t1 = min(t1, t)
        else:
            t0 = max(t0, t)
        if t0 > t1:
            return None
    if strict and t1 - t0 <= 0.0:
        return None
    return (t0, t1)


def segment_inside_length(p, q, convex_ring, strict=True):
    """Length of segment ``p``-``q`` inside a convex ring (0.0 if none);
    ``strict`` as in ``clip_segment_convex``."""
    hit = clip_segment_convex(p, q, convex_ring, strict)
    if hit is None:
        return 0.0
    return (hit[1] - hit[0]) * math.hypot(q[0] - p[0], q[1] - p[1])


# --------------------------------------------------------------------------
# Centroids
# --------------------------------------------------------------------------

def ring_centroid(ring):
    """``(cx, cy, signed_area)`` of a ring (shoelace, shifted to the first
    vertex for precision). A zero-area ring gives the mean of its distinct
    vertices and area 0; an empty ring ``None``."""
    pts = _clip_open(ring)
    if not pts:
        return None
    x0, y0 = pts[0]
    n = len(pts)
    a2 = 0.0
    cx = cy = 0.0
    for i in range(n):
        x1, y1 = pts[i][0] - x0, pts[i][1] - y0
        x2, y2 = pts[(i + 1) % n][0] - x0, pts[(i + 1) % n][1] - y0
        cross = x1 * y2 - x2 * y1
        a2 += cross
        cx += (x1 + x2) * cross
        cy += (y1 + y2) * cross
    if a2 == 0.0:
        return (sum(p[0] for p in pts) / n, sum(p[1] for p in pts) / n, 0.0)
    return (x0 + cx / (3.0 * a2), y0 + cy / (3.0 * a2), a2 / 2.0)


def polygon_centroid(rings):
    """Area-weighted centroid ``(x, y)`` of a polygon (all parts, holes
    subtracted; ring orientation is taken from ``group_rings``, not from
    the sign of each ring). ``None`` for an empty polygon; a polygon of
    zero area gives the mean of its outer-ring vertices."""
    groups = group_rings(rings)
    if not groups:
        return None
    sx = sy = total = 0.0
    for outer, holes in groups:
        for ring, sign in [(outer, 1.0)] + [(h, -1.0) for h in holes]:
            cx, cy, a = ring_centroid(ring)
            w = sign * abs(a)
            sx += cx * w
            sy += cy * w
            total += w
    if total == 0.0:
        pts = [p for outer, _h in groups for p in _clip_open(outer)]
        return (sum(p[0] for p in pts) / len(pts), sum(p[1] for p in pts) / len(pts))
    return (sx / total, sy / total)


# ==========================================================================
# common/anchor.py
# ==========================================================================
# Pole of inaccessibility (label anchor) for polygons, pure Python.
#
# The pole of inaccessibility is the interior point farthest from the polygon
# boundary (holes included); its distance to the boundary is the radius of the
# largest inscribed circle. Implemented from the published description of the
# "polylabel" algorithm (Agafonkin, Mapbox blog, 2016): cover the bounding box
# with square cells, keep them in a priority queue ordered by the best distance
# any point of the cell could reach (centre distance + half diagonal), split the
# most promising cell into four, and stop exploring a cell once it cannot beat
# the best point found by more than ``precision``. No code was copied.
#
# Guarantee: the returned distance is within the *effective* precision of the
# true maximum (up to the cell budget, see ``ANCHOR_MAX_CELLS``). The effective
# precision is ``max(precision, ANCHOR_REL_PRECISION x the larger bbox side)``
# (``effective_precision``), so long strips cannot exhaust the cell budget;
# the first cells are never smaller than that precision, so thin slivers do not
# start with length / width cells either.
# Polygons with many edges measure distances through a ``SegmentGrid`` (same
# results as a full scan, without scanning every edge for every cell). The
# returned point is always inside the polygon when the polygon has an interior.
#
# Multipart polygons (``polygon_anchor``): the pole of the **largest part by
# area** (outer ring minus its holes) is returned; ties keep the first part in
# input order. This is decided once for every feature, so labels of multipart
# features always sit in their main part.

# Safety cap on the number of cells examined (precision far below the polygon
# size would otherwise explode); when reached, the best point so far is
# returned and ``polygon_anchor`` reports ``"capped": True``.
ANCHOR_MAX_CELLS = 200000


# Relative precision floor: the search never works finer than this fraction of
# the polygon's larger bbox side. A long strip (road, canal, river polygon) has a
# plateau of near-equal distances along its medial line; without a floor every
# cell of that plateau would be refined to ``precision`` and the search would
# run into ``ANCHOR_MAX_CELLS``. 1e-4 is 0.1 m on a 1 km polygon.
ANCHOR_REL_PRECISION = 1e-4

# Polygons with more edges than this use ``SegmentGrid`` for distances.
ANCHOR_GRID_MIN_SEGMENTS = 24


def effective_precision(precision, width, height):
    """Precision actually used: ``max(precision, ANCHOR_REL_PRECISION * max(width, height))``."""
    return max(float(precision), ANCHOR_REL_PRECISION * max(width, height))


class SegmentGrid(object):
    """Uniform grid over the segments of closed rings (or open paths).

    * ``nearest_distance(p)``: exact distance to the nearest segment, searched
      ring by ring of grid cells outwards (stops once no farther cell can be
      closer);
    * ``inside(p)``: even-odd ray-casting test using only the segments of the
      point's grid row (same crossing rule as a full scan, so the same answer);
    * ``signed_distance(p)``: positive inside, negative outside, 0 on an edge.

    Building is linear in the number of segments (plus the cells long segments
    cover); each query touches only nearby segments, so testing many points
    against a large polygon is not points x vertices.
    """

    def __init__(self, segments):
        self.segs = [(tuple(a), tuple(b)) for a, b in segments]
        xs = [p[0] for s in self.segs for p in s] or [0.0]
        ys = [p[1] for s in self.segs for p in s] or [0.0]
        self.x0, self.y0 = min(xs), min(ys)
        width, height = max(xs) - self.x0, max(ys) - self.y0
        n = max(len(self.segs), 1)
        size = max(width, height, 1e-300)
        cell = math.sqrt(max(width * height, size * size / n) / n)
        self.cell = max(cell, size / 4096.0, 1e-300)
        self.cols = int(width / self.cell) + 1
        self.rows = int(height / self.cell) + 1
        self.cells = {}
        self.bands = {}
        for idx, (a, b) in enumerate(self.segs):
            c0, c1 = sorted((self._col(a[0]), self._col(b[0])))
            r0, r1 = sorted((self._row(a[1]), self._row(b[1])))
            for r in range(r0, r1 + 1):
                self.bands.setdefault(r, []).append(idx)
                for c in range(c0, c1 + 1):
                    self.cells.setdefault((c, r), []).append(idx)

    def _col(self, x):
        return min(max(int((x - self.x0) / self.cell), 0), self.cols - 1)

    def _row(self, y):
        return min(max(int((y - self.y0) / self.cell), 0), self.rows - 1)

    def inside(self, p):
        x, y = p
        if y < self.y0 or y > self.y0 + self.rows * self.cell:
            return False
        inside = False
        for idx in self.bands.get(self._row(y), ()):
            a, b = self.segs[idx]
            if (a[1] > y) != (b[1] > y):
                if x < a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1]):
                    inside = not inside
        return inside

    def nearest_distance(self, p):
        if not self.segs:
            return float("inf")
        x, y = p
        cx = int(math.floor((x - self.x0) / self.cell))
        cy = int(math.floor((y - self.y0) / self.cell))
        best = float("inf")
        seen = set()
        # Rings that do not reach the grid yet are empty: start at the first one that does.
        start = max(0, cx - (self.cols - 1), -cx, cy - (self.rows - 1), -cy)
        limit = start + max(self.cols, self.rows) + 1
        for r in range(start, limit + 1):
            for gx in range(cx - r, cx + r + 1):
                for gy in ((cy - r, cy + r) if 0 < r else (cy,)):
                    best = self._scan(gx, gy, p, best, seen)
            for gy in range(cy - r + 1, cy + r):
                if r > 0:
                    best = self._scan(cx - r, gy, p, best, seen)
                    best = self._scan(cx + r, gy, p, best, seen)
            # Every segment not yet seen lies in a cell at least r rings away.
            if best <= r * self.cell:
                break
        return best

    def _scan(self, gx, gy, p, best, seen):
        for idx in self.cells.get((gx, gy), ()):
            if idx in seen:
                continue
            seen.add(idx)
            a, b = self.segs[idx]
            d = point_segment_distance(p, a, b)[0]
            if d < best:
                best = d
        return best

    def signed_distance(self, p):
        d = self.nearest_distance(p)
        if d == 0.0:
            return 0.0
        return d if self.inside(p) else -d


def _anchor_segments(rings):
    segs = []
    for ring in rings:
        pts = [tuple(p) for p in ring]
        if len(pts) > 1 and pts[0] != pts[-1]:
            pts.append(pts[0])
        for i in range(len(pts) - 1):
            segs.append((pts[i], pts[i + 1]))
    return segs


def signed_distance_to_rings(p, rings):
    """Distance from ``p`` to the nearest ring edge; positive inside the
    polygon formed by ``rings`` (even-odd rule, so holes count as outside),
    negative outside, 0 on the boundary."""
    segs = _anchor_segments(rings)
    if not segs:
        return float("-inf")
    return _anchor_signed(p, segs)


def _anchor_signed(p, segs):
    x, y = p
    inside = False
    best = float("inf")
    hypot = math.hypot
    for a, b in segs:
        ax, ay = a
        bx, by = b
        if (ay > y) != (by > y):
            x_cross = ax + (y - ay) * (bx - ax) / (by - ay)
            if x < x_cross:
                inside = not inside
        # Same arithmetic as common.geom.point_segment_distance, inlined: this
        # loop runs for every cell of the search (it dominates the run time).
        dx, dy = bx - ax, by - ay
        seg2 = dx * dx + dy * dy
        if seg2 == 0.0:
            d = hypot(ax - x, ay - y)
        else:
            t = ((x - ax) * dx + (y - ay) * dy) / seg2
            if t < 0.0:
                t = 0.0
            elif t > 1.0:
                t = 1.0
            d = hypot(ax + t * dx - x, ay + t * dy - y)
        if d < best:
            best = d
    if best == 0.0:
        return 0.0
    return best if inside else -best


def pole_of_inaccessibility(rings, precision=1.0):
    """``(x, y, distance)`` of the pole of inaccessibility of ``rings``.

    ``rings``: one polygon part (outer ring and its holes; orientation does
    not matter, even-odd rule). ``precision``: absolute tolerance on the
    distance, in coordinate units (must be > 0). Degenerate input (zero
    width or height) returns the bbox centre with distance 0; empty input
    returns ``None``.
    """
    result = _anchor_pole(rings, precision)
    return None if result is None else result[:3]


def pole_with_status(rings, precision=1.0, max_cells=None):
    """``(x, y, distance, capped, error_bound)`` for one polygon part (outer ring and
    its holes): like ``pole_of_inaccessibility`` plus whether the cell budget
    (``max_cells``, default ``ANCHOR_MAX_CELLS``) was reached. ``error_bound`` is an
    upper bound of how far ``distance`` can be below the true maximum: the effective
    precision when the search finished, the largest remaining cell potential minus
    ``distance`` when it was capped. Empty input gives ``(0.0, 0.0, 0.0, False, 0.0)``."""
    result = _anchor_pole(rings, precision, max_cells, True)
    return (0.0, 0.0, 0.0, False, 0.0) if result is None else result


def _anchor_pole(rings, precision, max_cells=None, with_bound=False):
    if not precision or precision <= 0:
        raise ValueError("precision must be positive")
    max_cells = ANCHOR_MAX_CELLS if max_cells is None else int(max_cells)

    def done(x, y, d, capped, bound):
        return (x, y, d, capped, bound) if with_bound else (x, y, d, capped)

    segs = _anchor_segments(rings)
    if not segs:
        return None
    xs = [p[0] for s in segs for p in s]
    ys = [p[1] for s in segs for p in s]
    xmin, ymin, xmax, ymax = min(xs), min(ys), max(xs), max(ys)
    width, height = xmax - xmin, ymax - ymin
    cell = min(width, height)
    if cell == 0.0:
        return done((xmin + xmax) / 2.0, (ymin + ymax) / 2.0, 0.0, False, 0.0)
    if all(ring_signed_area(list(r)) == 0.0 for r in rings):
        # No interior at all (e.g. a ring that runs out and back along a line):
        # nothing to search, and the search for a positive distance would only
        # run into the cell budget.
        return done((xmin + xmax) / 2.0, (ymin + ymax) / 2.0, 0.0, False, 0.0)
    precision = effective_precision(precision, width, height)
    # A tolerance above the larger bbox side says nothing more (no inscribed circle has a
    # radius above half the shorter side), but it made the first cell far larger than the
    # part, with its centre far outside: when the first guesses lie in a hole or notch the
    # search then split such cells with slow distance queries from far away (152 s for a
    # 1.7 m blob with a hole at a precision of 458,000 units).
    precision = min(precision, max(width, height))
    # First cells are never finer than the precision (a 3 km x 1 mm sliver would
    # otherwise start with 3,000,000 cells of side 1 mm, before any budget check),
    # and never so many that they alone use up a quarter of the cell budget.
    cell = max(cell, precision)
    first = math.ceil(width / cell) * math.ceil(height / cell)
    if first > max_cells // 4:
        cell *= math.sqrt(first / float(max(max_cells // 4, 1))) * 1.01
    if len(segs) > ANCHOR_GRID_MIN_SEGMENTS:
        signed = SegmentGrid(segs).signed_distance
    else:
        def signed(q):
            return _anchor_signed(q, segs)
    h = cell / 2.0
    heap = []
    counter = [0]

    def push(cx, cy, half):
        d = signed((cx, cy))
        potential = d + half * math.sqrt(2.0)
        counter[0] += 1
        # max-heap on potential; counter keeps the order deterministic
        heapq.heappush(heap, (-potential, counter[0], cx, cy, half, d))
        return d

    x = xmin
    while x < xmax:
        y = ymin
        while y < ymax:
            push(x + h, y + h, h)
            y += cell
        x += cell

    # Initial guesses: area centroid, then bbox centre.
    best = None
    cen = polygon_centroid([list(r) for r in rings])
    for gx, gy in ([cen] if cen else []) + [((xmin + xmax) / 2.0, (ymin + ymax) / 2.0)]:
        d = signed((gx, gy))
        if best is None or d > best[2]:
            best = (gx, gy, d)

    capped = False
    bound = precision
    # A first guess exactly on an edge gives a distance of float noise (~1e-15), not a
    # point inside: treat a distance this small as "nothing found yet" (comb case).
    on_edge = 1e-9 * max(width, height)
    while heap:
        neg_pot, _n, cx, cy, half, d = heapq.heappop(heap)
        if d > best[2]:
            best = (cx, cy, d)
        if -neg_pot <= 0.0:
            continue  # no point of this cell can be inside the polygon
        # While no interior point has been found (best distance <= 0, e.g. the
        # centroid of a U shape lies in its notch), keep splitting even when the
        # precision is coarser than the inscribed radius: an anchor must be inside.
        if best[2] > on_edge and -neg_pot - best[2] <= precision:
            continue
        if counter[0] >= max_cells:
            capped = True
            bound = max(-neg_pot - best[2], precision)
            break
        half2 = half / 2.0
        for ox, oy in ((-half2, -half2), (half2, -half2), (-half2, half2), (half2, half2)):
            push(cx + ox, cy + oy, half2)
    return done(best[0], best[1], max(best[2], 0.0), capped, bound)


def polygon_anchor(rings, precision=1.0, groups=None):
    """Pole of inaccessibility of a (multipart) polygon in the core representation.

    Returns ``{"point": (x, y), "distance", "part", "parts", "capped"}``:
    the pole of the largest part (index ``part`` in ``group_rings`` order),
    the inscribed-circle radius, the number of parts and whether the cell
    budget was reached. ``None`` for an empty polygon. ``groups``: the
    ``group_rings(rings)`` result when the caller already has it (the rings
    are then not grouped a second time).
    """
    if groups is None:
        groups = group_rings(rings)
    if not groups:
        return None
    best_idx, best_area = 0, None
    for idx, (outer, holes) in enumerate(groups):
        area = abs(ring_signed_area(outer)) - sum(abs(ring_signed_area(h)) for h in holes)
        if best_area is None or area > best_area:
            best_idx, best_area = idx, area
    outer, holes = groups[best_idx]
    x, y, d, capped = _anchor_pole([outer] + list(holes), precision)
    return {"point": (x, y), "distance": d, "part": best_idx, "parts": len(groups),
            "capped": capped}


# ==========================================================================
# common/linegraph.py
# ==========================================================================
# Planar line network from polylines: endpoint nodes, degree, dangles,
# pseudo-nodes, connected components (pure Python).
#
# Input: ``[(key, paths), ...]`` where ``paths`` is a polyline in the core
# representation (list of paths, path = list of ``(x, y)``). Every path (part)
# is one **edge** from its first to its last vertex. Interior vertices are not
# nodes (a line crossing another without a shared endpoint is not connected).
#
# Endpoint clustering (``cluster_points``): endpoints closer than or equal to
# ``tolerance`` are merged with a grid hash (cell = tolerance) and union-find.
# Clustering is **transitive**: if A-B and B-C are within tolerance, A, B and C
# form one node even when A-C is farther apart (a chain of points each within
# tolerance of the next can span more than the tolerance). ``tolerance == 0``
# merges only identical coordinates. The node location is the first member
# point in input order (an actual endpoint, deterministic), not an average.
#
# Degree = number of edge ends at a node; a closed path (both ends in the same
# node) contributes 2. Dangles are nodes of degree 1. Pseudo-nodes are nodes of
# degree 2 where two **different** edges meet (the start of a single closed loop
# is not a pseudo-node); whether they are reportable (equal attributes) is the
# caller's decision.

class DisjointSet(object):
    """Union-find with path halving and union by size; elements are 0..n-1."""

    def __init__(self, n):
        self.parent = list(range(n))
        self.size = [1] * n

    def find(self, i):
        parent = self.parent
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    def union(self, i, j):
        ri, rj = self.find(i), self.find(j)
        if ri == rj:
            return ri
        if self.size[ri] < self.size[rj] or (self.size[ri] == self.size[rj] and rj < ri):
            ri, rj = rj, ri
        self.parent[rj] = ri
        self.size[ri] += self.size[rj]
        return ri


def cluster_points(points, tolerance):
    """Cluster labels for ``points`` (transitive, see module docstring).

    Returns a list of cluster ids, one per point, numbered 0, 1, 2 ... in
    order of first appearance.
    """
    n = len(points)
    ds = DisjointSet(n)
    if tolerance is None or tolerance <= 0:
        first = {}
        for i, p in enumerate(points):
            key = (float(p[0]), float(p[1]))
            if key in first:
                ds.union(first[key], i)
            else:
                first[key] = i
    else:
        if not math.isfinite(tolerance):
            raise ValueError("cluster_points: the tolerance must be a finite number")
        # Cells of half the tolerance: two points in one cell are always within the
        # tolerance (diagonal 0.71 x tolerance), so a cell is one cluster without any
        # distance test; points within the tolerance are at most 2 cells apart. Each
        # pair of neighbouring cells is compared only while they are still separate
        # clusters, with an early exit, so dense data (or a tolerance much larger
        # than the data) no longer costs one distance test per pair of points.
        cell = float(tolerance) / 2.0
        grid = {}
        for i, p in enumerate(points):
            try:
                key = (int(math.floor(p[0] / cell)), int(math.floor(p[1] / cell)))
            except (OverflowError, ZeroDivisionError, ValueError):
                # a tolerance such as 1e-320 (cell 0 or p / cell = inf), or a NaN coordinate
                raise ValueError("cluster_points: the tolerance {0!r} is too small for the "
                                 "coordinates (or a coordinate is not finite)".format(tolerance))
            members = grid.get(key)
            if members is None:
                grid[key] = [i]
            else:
                ds.union(members[0], i)
                members.append(i)
        offsets = [(dx, dy) for dx in range(-2, 3) for dy in range(-2, 3) if (dx, dy) > (0, 0)]
        for (gx, gy), members in grid.items():
            for dx, dy in offsets:
                other = grid.get((gx + dx, gy + dy))
                if other is None or ds.find(members[0]) == ds.find(other[0]):
                    continue
                if _linegraph_any_close(points, members, other, tolerance):
                    ds.union(members[0], other[0])
    labels = []
    seen = {}
    for i in range(n):
        root = ds.find(i)
        if root not in seen:
            seen[root] = len(seen)
        labels.append(seen[root])
    return labels


def _linegraph_any_close(points, a_idx, b_idx, tolerance):
    """True if some point of ``a_idx`` is within ``tolerance`` of some point of ``b_idx``."""
    for i in a_idx:
        p = points[i]
        for j in b_idx:
            if point_distance(points[j], p) <= tolerance:
                return True
    return False


def build_line_graph(lines, tolerance=0.0):
    """Build the endpoint graph of ``lines`` (``[(key, paths), ...]``).

    Returns ``{"nodes": [...], "edges": [...]}``:

    * edge: ``{"id", "key", "part", "from", "to", "length", "closed"}``
      (``from``/``to`` are node ids; ``closed`` when both ends share a node);
    * node: ``{"id", "xy", "degree", "ends", "members"}`` where ``ends`` is
      a list of ``(edge_id, "from"|"to")`` in edge order and ``members`` the
      number of endpoints merged into the node.

    Parts with fewer than 2 vertices and null geometries are skipped.
    """
    edges = []
    points = []
    for key, paths in lines:
        for part_idx, path in enumerate(paths or []):
            if len(path) < 2:
                continue
            edges.append({"id": len(edges), "key": key, "part": part_idx,
                          "length": path_length(path)})
            points.append(tuple(path[0]))
            points.append(tuple(path[-1]))
    labels = cluster_points(points, tolerance)
    nodes = []
    for idx, label in enumerate(labels):
        if label == len(nodes):
            nodes.append({"id": label, "xy": points[idx], "degree": 0, "ends": [], "members": 0})
        nodes[label]["members"] += 1
    for edge in edges:
        f, t = labels[2 * edge["id"]], labels[2 * edge["id"] + 1]
        edge["from"], edge["to"], edge["closed"] = f, t, f == t
        nodes[f]["degree"] += 1
        nodes[f]["ends"].append((edge["id"], "from"))
        nodes[t]["degree"] += 1
        nodes[t]["ends"].append((edge["id"], "to"))
    return {"nodes": nodes, "edges": edges}


def node_degrees(graph):
    """``{node_id: degree}``."""
    return dict((n["id"], n["degree"]) for n in graph["nodes"])


def find_dangles(graph):
    """Nodes of degree 1 (free line ends), in node order."""
    return [n for n in graph["nodes"] if n["degree"] == 1]


def find_pseudo_nodes(graph):
    """Nodes where exactly two different edges meet (degree 2, not the start
    of a single closed loop). Returns ``[(node, edge_a, edge_b), ...]``."""
    edges = graph["edges"]
    out = []
    for n in graph["nodes"]:
        if n["degree"] != 2:
            continue
        (e1, _s1), (e2, _s2) = n["ends"]
        if e1 == e2:
            continue
        out.append((n, edges[e1], edges[e2]))
    return out


def connected_components(graph, join_parts=True):
    """Connected groups of edges.

    With ``join_parts`` (default) all parts of one feature key belong to the
    same component even if they do not touch (a multipart feature is one
    feature). Returns a list of ``{"edges": [ids], "keys": [keys], "nodes":
    [ids]}`` sorted by the smallest edge id; keys keep first-seen order.
    """
    edges = graph["edges"]
    nodes = graph["nodes"]
    ds = DisjointSet(len(nodes))
    first_node_of_key = {}
    for e in edges:
        ds.union(e["from"], e["to"])
        if join_parts:
            if e["key"] in first_node_of_key:
                ds.union(first_node_of_key[e["key"]], e["from"])
            else:
                first_node_of_key[e["key"]] = e["from"]
    groups = {}
    order = []
    for e in edges:
        root = ds.find(e["from"])
        if root not in groups:
            groups[root] = {"edges": [], "keys": [], "key_set": set(), "nodes": set()}
            order.append(root)
        g = groups[root]
        g["edges"].append(e["id"])
        if e["key"] not in g["key_set"]:   # set lookup: O(1), not O(len(keys))
            g["key_set"].add(e["key"])
            g["keys"].append(e["key"])
        g["nodes"].update((e["from"], e["to"]))
    out = []
    for root in order:
        g = groups[root]
        out.append({"edges": g["edges"], "keys": g["keys"], "nodes": sorted(g["nodes"])})
    return out


# ==========================================================================
# common/report.py
# ==========================================================================
# Reports: Excel workbook with Summary + Detail sheets, CSV fallback.
#
# Engineering rule 11: choose a writable report path **before** the main work
# (a workbook open in Excel is locked), write Excel via openpyxl when it is
# available and fall back to two CSV files when it is not.
#
# * ``choose_report_path(requested, inputs)`` -> target dict, raises
#   ``ToolError`` if the location is not writable, a file it would write is
#   one of the tool's inputs, or a file it would write already exists while
#   ``arcpy.env.overwriteOutput`` is off (engineering rule 13; RT7-P-4).
# * ``write_report(target, summary, detail_header, detail_rows)`` -> list of
#   written file paths.
#
# Text fidelity (to be stated on every tool page that offers a report):
#
# * Excel: control characters a cell cannot hold (U+0000-U+0008, U+000B, U+000C,
#   U+000E-U+001F) are written as a visible ``<U+XXXX>``; nothing is dropped
#   silently. Text cells are stored as text, never as formulas.
# * CSV: every character is kept as it is (control characters included); text
#   that a spreadsheet would run as a formula gets a leading apostrophe
#   (``neutralize_formula``).
# * Both: a lone UTF-16 surrogate (U+D800-U+DFFF, half of a pair; it cannot be
#   written as UTF-8) becomes U+FFFD.
#
# Every file is opened through ``_open_for_write`` so tests can simulate a
# locked file without touching the operating system.

REPORT_FORMAT_XLSX = "xlsx"
REPORT_FORMAT_CSV = "csv"

# Rows in one Excel worksheet (.xlsx), header included.
_REPORT_XLSX_MAX_ROWS = 1048576

# Excel rejects these control characters in cell text (XML 1.0: U+0000-U+0008, U+000B, U+000C,
# U+000E-U+001F; tab, line feed and carriage return are allowed). They are written as a visible
# "<U+XXXX>" instead of being dropped, so a value such as "Riyadh" + U+0001 never looks equal to
# "Riyadh" in an Excel report (NearMissVocabularyChecker round-5 review, D2; the same review
# finding exists for NormalisedKeyDiagnostics). Accepted ambiguity: a text that really contains
# "<U+0001>" looks the same; each tool's output table keeps the exact value.
_REPORT_ILLEGAL = dict((c, u"<U+{0:04X}>".format(c))
                       for c in list(range(0, 9)) + [11, 12] + list(range(14, 32)))
# A lone UTF-16 surrogate (half of a pair, U+D800-U+DFFF) cannot be encoded as UTF-8: the xlsx and
# csv writers raise UnicodeEncodeError on it (MojibakeDetector round 5, R5-1). It becomes U+FFFD in
# both formats (merged shared fix, round 6).
_REPORT_LONE_SURROGATES = dict.fromkeys(range(0xD800, 0xE000), u"\ufffd")
_REPORT_ILLEGAL.update(_REPORT_LONE_SURROGATES)


# A plain number such as "-5" or "+1.5e3" is not a formula and is left as is.
_REPORT_PLAIN_NUMBER = re.compile(r"^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$")


def neutralize_formula(value):
    """Text that a spreadsheet would run as a formula, made inert (CSV injection).

    Text starting with ``=``, ``@``, tab or carriage return, or with ``+``/``-``
    followed by something that is not a plain number, gets a leading
    apostrophe, so Excel shows it as text instead of evaluating it (OWASP
    "CSV injection" guidance). Other values are returned unchanged. Used for
    every CSV report cell; the Excel writer stores text cells as text instead.

    This CHANGES the text in the CSV file: ``-Riyadh`` is written as
    ``'-Riyadh`` and ``=1+1`` as ``'=1+1`` (a plain number such as ``-5`` or
    ``+1.5e3`` is kept). Kept on purpose: without it a value could run as a
    formula when the CSV is opened in Excel. Every tool page that offers a CSV
    report should say so; a program that reads the CSV must strip the
    apostrophe.
    """
    if not isinstance(value, str) or not value:
        return value
    first = value[0]
    if first in ("=", "@", "\t", "\r"):
        return "'" + value
    if first in "+-" and len(value) > 1 and not _REPORT_PLAIN_NUMBER.match(value):
        return "'" + value
    return value


def _open_for_write(path, mode, **kwargs):
    """Single place where report files are opened (test hook)."""
    return open(path, mode, **kwargs)


def _report_import_openpyxl():
    """Import openpyxl lazily; ``None`` when it is not installed."""
    try:
        import openpyxl
    except ImportError:
        return None
    return openpyxl


def _report_check_writable(path):
    """Raise ``ToolError`` if ``path`` cannot be written; leaves no new file behind."""
    folder = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(folder):
        raise ToolError("The report folder '{0}' does not exist.".format(folder),
                        "Choose an existing folder for the report.")
    existed = os.path.exists(path)
    try:
        handle = _open_for_write(path, "ab")
        handle.close()
    except (IOError, OSError):
        raise ToolError(
            "The report file '{0}' cannot be written; it is probably open in Excel "
            "or another program, or it is read-only.".format(path),
            "Close the file (or choose a different report name) and run the tool again.")
    if not existed:
        try:
            os.remove(path)
        except OSError:
            pass


def csv_report_paths(path):
    """``(summary_csv, detail_csv)`` for a requested report path."""
    base = os.path.splitext(path)[0]
    return base + "_summary.csv", base + "_detail.csv"


def _report_keys(path):
    """Comparison keys of a path: as given and absolute, plus its dataset identity."""
    text = str(path).strip().strip("'\"")
    keys = set([normalize_catalog_path(text), dataset_identity(text)])
    if text and not text.startswith("\\\\"):
        absolute = os.path.abspath(text)
        keys.update([normalize_catalog_path(absolute), dataset_identity(absolute)])
    keys.discard("")
    return keys


def refuse_report_on_inputs(paths, inputs):
    """Raise ``ToolError`` if a report file would replace (or contain) an input.

    ``paths`` are the files the report will really write (after extension
    normalisation and the CSV fallback names); ``inputs`` are input files,
    datasets or layer texts (anything that is not a path never matches).
    Paths are compared with ``paths.normalize_catalog_path`` and
    ``paths.dataset_identity``; an input inside the report file (e.g. a sheet
    ``book.xlsx\\Sheet1$``) also counts. During a guarded run every input the
    tool registered (``paths.registered_inputs``) is compared as well, and a
    report file named like a table joined to an input layer
    (``paths.registered_joined_tables``) is refused.
    """
    inputs = list(inputs or ()) + registered_inputs()
    refuse_joined_table_outputs(paths, registered_joined_tables())
    for out in paths:
        out_keys = _report_keys(out)
        for value in inputs:
            if not value:
                continue
            in_keys = _report_keys(value)
            inside = any(k.startswith(o + "\\") for k in in_keys for o in out_keys)
            if out_keys & in_keys or inside:
                raise ToolError(
                    "The report file '{0}' would replace the input '{1}'.".format(out, value),
                    "Choose another report name or folder; the tool never overwrites its "
                    "input.")


def _report_overwrite_allowed():
    """``arcpy.env.overwriteOutput`` as a bool (False when it cannot be read)."""
    try:
        return bool(arcpy.env.overwriteOutput)
    except Exception:
        return False


def refuse_existing_report_files(paths, overwrite):
    """Raise ``ToolError`` if a report file exists and overwriting is off.

    Pro's own output check only sees the parameter value; the files really
    written can differ (``book.xls`` -> ``book.xlsx``, ``audit.csv`` ->
    ``audit_summary.csv`` + ``audit_detail.csv``), so every one is checked
    here (engineering rule 13, RT7-P-4).
    """
    if overwrite:
        return
    for path in paths:
        if os.path.exists(path):
            raise ToolError(
                "The report file '{0}' already exists and overwriting outputs is off, so "
                "it was not replaced.".format(path),
                "Choose another report name or folder, or allow geoprocessing tools to "
                "overwrite existing outputs (arcpy.env.overwriteOutput) and run the tool "
                "again.")


def choose_report_path(requested, inputs=(), overwrite=None):
    """Decide the report format and check the target is writable.

    ``requested`` ends in ``.xlsx`` or ``.csv`` (anything else is treated as
    ``.xlsx``). If openpyxl is missing, or ``.csv`` was requested, two CSV
    files ``<name>_summary.csv`` and ``<name>_detail.csv`` are used instead.
    Returns ``{"format", "paths", "note"}``; ``note`` explains a fallback.
    Returns ``None`` when no report was requested. ``inputs`` (input files,
    datasets or parameter texts) are refused as report files, after the
    extension change (``book`` / ``book.xls`` -> ``book.xlsx``) and for both CSV
    fallback files (``refuse_report_on_inputs``). With overwriting off
    (``overwrite``; ``None`` reads ``arcpy.env.overwriteOutput``) an existing
    report file is refused (``refuse_existing_report_files``).
    """
    if not requested:
        return None
    requested = str(requested)
    note = None
    ext = os.path.splitext(requested)[1].casefold()
    if ext != ".csv" and _report_import_openpyxl() is not None:
        if ext != ".xlsx":
            requested = os.path.splitext(requested)[0] + ".xlsx"
        target = {"format": REPORT_FORMAT_XLSX, "paths": [requested], "note": None}
    else:
        if ext != ".csv":
            note = ("openpyxl is not available, so the report is written as two CSV files "
                    "instead of an Excel workbook.")
        target = {"format": REPORT_FORMAT_CSV, "paths": list(csv_report_paths(requested)),
                  "note": note}
    # The name as asked for counts too: 'attr.csv' writes attr_summary.csv, but a
    # report named like a table joined to an input layer is refused either way.
    refuse_joined_table_outputs([requested], registered_joined_tables())
    refuse_report_on_inputs(target["paths"], inputs)
    for path in target["paths"]:
        _report_check_writable(path)
    if overwrite is None:
        overwrite = _report_overwrite_allowed()
    refuse_existing_report_files(target["paths"], overwrite)
    return target


# An Excel cell holds at most 32,767 characters (counted in UTF-16 units). openpyxl writes longer
# text without complaint and Excel then cuts or "repairs" it silently. The cut is made AFTER the
# <U+XXXX> expansion above, so the expansion can never push a cell over the limit, and the cut cell
# ends with a visible marker (NearMissVocabularyChecker R6-D2, BilingualNameQA R6-1).
_REPORT_XLSX_MAX_CELL = 32767
_REPORT_XLSX_CUT_MARKER = u" ...[cut: an Excel cell holds 32,767 characters; choose a .csv report for the full text]"


def _report_utf16_units(text):
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def _report_fit_excel_cell(text):
    """``text`` cut to fit one Excel cell, with a visible marker when cut."""
    if len(text) <= _REPORT_XLSX_MAX_CELL // 2 or _report_utf16_units(text) <= _REPORT_XLSX_MAX_CELL:
        return text
    room = _REPORT_XLSX_MAX_CELL - len(_REPORT_XLSX_CUT_MARKER)
    kept, used = [], 0
    for ch in text:
        size = 2 if ord(ch) > 0xFFFF else 1
        if used + size > room:
            break
        kept.append(ch)
        used += size
    return u"".join(kept) + _REPORT_XLSX_CUT_MARKER


def _report_cell(value):
    """Cell value safe for openpyxl (control characters as ``<U+XXXX>``, see
    ``_REPORT_ILLEGAL``)."""
    if isinstance(value, str):
        return _report_fit_excel_cell(value.translate(_REPORT_ILLEGAL))
    if value is None or isinstance(value, (bool, int, float)):
        return value
    return str(value)


def _report_write_xlsx(path, summary, summary_header, detail_header, detail_rows, openpyxl):
    workbook = openpyxl.Workbook()
    sheets = ((workbook.active, "Summary", summary_header, summary),
              (workbook.create_sheet(), "Detail", detail_header, detail_rows))
    bold = openpyxl.styles.Font(bold=True)
    for sheet, title, header, rows in sheets:
        sheet.title = title
        sheet.append([_report_cell(h) for h in header])
        for cell in sheet[1]:
            cell.font = bold
        widths = [len(str(h)) for h in header]
        # Excel holds at most _REPORT_XLSX_MAX_ROWS rows; openpyxl would write
        # more without complaint and Excel would then drop or "repair" them.
        room = _REPORT_XLSX_MAX_ROWS - 2
        if len(rows) > room + 1:
            dropped = len(rows) - room
            rows = rows[:room] + [["{0} more rows not shown: an Excel sheet holds at most {1} "
                                   "rows. Choose a .csv report path to get every row."
                                   .format(dropped, _REPORT_XLSX_MAX_ROWS)]]
        # Track the row number ourselves: openpyxl's Worksheet.max_row scans
        # every cell written so far, which made long reports quadratic (RT4-A-4).
        row_index = 1
        for row in rows:
            values = [_report_cell(v) for v in row]
            sheet.append(values)
            row_index += 1
            for column, value in enumerate(values, 1):
                if isinstance(value, str):
                    # never let text such as "=x" become a formula
                    sheet.cell(row=row_index, column=column).data_type = "s"
            for i, v in enumerate(values[:len(widths)]):
                widths[i] = max(widths[i], len(str(v)) if v is not None else 0)
        sheet.freeze_panes = "A2"
        for i, width in enumerate(widths):
            sheet.column_dimensions[openpyxl.utils.get_column_letter(i + 1)].width = min(width + 2, 80)
    with _open_for_write(path, "wb") as handle:
        workbook.save(handle)


def _report_csv_text(value):
    """CSV cell text: control characters kept exactly, only lone surrogates become U+FFFD."""
    if isinstance(value, str):
        return value.translate(_REPORT_LONE_SURROGATES)
    return value


def _report_write_csv(path, header, rows):
    # utf-8-sig so Excel shows Arabic and other non-Latin text correctly.
    with _open_for_write(path, "w", newline="", encoding="utf-8-sig") as handle:
        writer = csv.writer(handle)
        writer.writerow([neutralize_formula(_report_csv_text(h)) for h in header])
        for row in rows:
            writer.writerow(["" if v is None else neutralize_formula(_report_csv_text(v)) for v in row])


def write_report(target, summary, detail_header, detail_rows, summary_header=("Item", "Value"), xlsx_builder=None):
    """Write the report chosen by ``choose_report_path``.

    ``summary`` is a list of rows (usually ``(item, value)`` pairs);
    ``detail_rows`` a list of rows matching ``detail_header``.
    ``xlsx_builder`` (optional) is a function ``builder(openpyxl) -> workbook`` that replaces the plain
    two-sheet Excel layout with the tool's own formatted workbook; this module opens the file and saves it
    (same error handling, same ``_open_for_write`` hook). The CSV fallback is unaffected: it always gets
    ``summary`` and ``detail_rows``.
    Returns the list of written paths. Raises ``ToolError`` if a file became
    unwritable after it was checked.
    """
    if target is None:
        return []
    # Inputs read after the report was chosen (lookup tables, vocabularies ...) are
    # registered by then: never replace one of them (quality review D1/D2).
    refuse_report_on_inputs(target["paths"], ())
    summary = [list(r) for r in summary]
    detail_rows = [list(r) for r in detail_rows]
    try:
        if target["format"] == REPORT_FORMAT_XLSX:
            openpyxl = _report_import_openpyxl()
            if xlsx_builder is not None:
                workbook = xlsx_builder(openpyxl)
                with _open_for_write(target["paths"][0], "wb") as handle:
                    workbook.save(handle)
            else:
                _report_write_xlsx(target["paths"][0], summary, list(summary_header),
                                   list(detail_header), detail_rows, openpyxl)
        else:
            _report_write_csv(target["paths"][0], list(summary_header), summary)
            _report_write_csv(target["paths"][1], list(detail_header), detail_rows)
    except (IOError, OSError) as exc:
        raise ToolError("The report could not be written: {0}".format(exc),
                        "Close the report file if it is open and run the tool again.")
    return list(target["paths"])


def choose_output_file(requested, extension, inputs=(), overwrite=None):
    """Check the target of a single output file (an HTML page, a PNG ...) before the work.

    ``extension`` is the wanted one with its dot (``".html"``): a path without extension gets
    it, a path with another extension has it replaced. Refused (``ToolError``): a folder that
    does not exist, a file that is one of ``inputs`` (or a registered input of the run), a
    file that cannot be opened for writing (open in a program, read-only), and an existing
    file while overwriting is off. Returns the path to write, or ``None`` when nothing was
    requested.
    """
    if not requested or not str(requested).strip():
        return None
    path = str(requested).strip()
    if os.path.splitext(path)[1].casefold() != extension.casefold():
        path = os.path.splitext(path)[0] + extension
    refuse_joined_table_outputs([path], registered_joined_tables())
    refuse_report_on_inputs([path], inputs)
    _report_check_writable(path)
    if overwrite is None:
        overwrite = _report_overwrite_allowed()
    refuse_existing_report_files([path], overwrite)
    return path


def write_text_file(path, text, encoding="utf-8"):
    """Write ``text`` to ``path`` (UTF-8, ``\\n`` line ends) through the same open hook as the
    reports. Raises ``ToolError`` when the file cannot be written."""
    refuse_report_on_inputs([path], ())
    try:
        with _open_for_write(path, "w", encoding=encoding, newline="\n") as handle:
            handle.write(text)
    except (IOError, OSError) as exc:
        raise ToolError("The file '{0}' could not be written: {1}".format(path, exc),
                        "Close the file if it is open and run the tool again.")
    return path


# ==========================================================================
# common/params.py
# ==========================================================================
# Consistent construction and reading of ``arcpy.Parameter`` objects.

def make_param(name, label, datatype, direction="Input", required=True, multi_value=False,
               default=None, value_list=None, category=None, depends_on=None, enabled=True,
               filter_type=None):
    """Create an ``arcpy.Parameter``.

    ``required`` may be True (``"Required"``), False (``"Optional"``) or the
    string ``"Derived"``. ``value_list`` fills ``filter.list`` (a value list
    for strings/numbers, field types for ``Field``, extensions for ``DEFile``);
    ``filter_type`` sets ``filter.type`` (e.g. ``"Range"``) before the list.
    ``depends_on`` is a parameter name or list of names.
    """
    if required == "Derived":
        parameter_type = "Derived"
        direction = "Output"
    else:
        parameter_type = "Required" if required else "Optional"
    param = arcpy.Parameter(
        name=name,
        displayName=label,
        direction=direction,
        datatype=datatype,
        parameterType=parameter_type,
        enabled=enabled,
        category=category,
        multiValue=multi_value)
    if filter_type is not None:
        param.filter.type = filter_type
    if value_list is not None:
        param.filter.list = list(value_list)
    if depends_on:
        param.parameterDependencies = [depends_on] if isinstance(depends_on, str) else list(depends_on)
    if default is not None:
        param.value = default
    return param


def derived_output(name, label, datatype):
    """Derived output parameter (set with ``arcpy.SetParameterAsText``)."""
    return make_param(name, label, datatype, required="Derived")


def param_map(parameters):
    """``{name: parameter}`` for a parameter list."""
    return dict((p.name, p) for p in parameters)


def param_index(parameters, name):
    """Index of the parameter called ``name``."""
    for i, p in enumerate(parameters):
        if p.name == name:
            return i
    raise KeyError(name)


def param_text(param):
    """``valueAsText`` or ``None`` when empty."""
    text = param.valueAsText
    if text is None or text == "":
        return None
    return text


def param_bool(param, default=False):
    """Boolean value of a ``GPBoolean`` parameter."""
    value = param.value
    if value is None:
        return default
    if isinstance(value, str):
        return value.strip().casefold() in ("true", "1", "yes")
    return bool(value)


def param_number(param, default=None):
    """Numeric value (float) of a parameter, or ``default`` when empty."""
    value = param.value
    if value is None or value == "":
        return default
    return float(value)


def split_multivalue(text):
    """Values of a multivalue parameter given as geoprocessing text, quote-aware.

    Values are separated by ``;``. A value that starts with a single or double quote runs to the
    matching closing quote that is followed by ``;`` or the end of the text, so a folder named
    ``inv;2026`` written as ``'C:\\data\\inv;2026'`` stays one value; inside quotes the quote character
    written twice is one literal quote. A quote that is never closed counts as part of a plain
    value (the old behaviour: split on ``;``, quotes stripped)."""
    if not text:
        return []
    text = str(text)
    values = []
    n, i = len(text), 0
    while i < n:
        while i < n and text[i] in " \t":
            i += 1
        if i >= n:
            break
        if text[i] in "'\"":
            quote, j, buf, closed = text[i], i + 1, [], False
            while j < n:
                ch = text[j]
                if ch == quote:
                    if j + 1 < n and text[j + 1] == quote:
                        buf.append(quote)
                        j += 2
                        continue
                    k = j + 1
                    while k < n and text[k] in " \t":
                        k += 1
                    if k >= n or text[k] == ";":
                        closed = True
                        j = k
                        break
                buf.append(ch)
                j += 1
            if closed:
                value = "".join(buf).strip()
                if value:
                    values.append(value)
                i = j + 1
                continue
        end = text.find(";", i)
        if end < 0:
            end = n
        value = text[i:end].strip().strip("'\"")
        if value:
            values.append(value)
        i = end + 1
    return values


def param_list(param):
    """Values of a multivalue parameter as a list of strings (quote-aware, ``split_multivalue``)."""
    return split_multivalue(param_text(param))


def parse_value_table_text(text):
    """Rows of a value table given as geoprocessing text.

    Rows are separated by ``;`` and cells by spaces; a cell containing spaces
    is wrapped in single quotes (or double quotes, for example around a path that holds an
    apostrophe) and an empty cell is written ``#``
    (e.g. ``"NAME ASC;'Lot No' DESC"``). Inside quotes the quote character written twice is
    one literal quote. Returns a list of lists of strings,
    with ``None`` for empty cells. Separators inside quotes are kept.
    """
    if text is None:
        return []
    rows, row, cell = [], [], []
    quote = None
    in_cell = False

    def end_cell():
        value = "".join(cell)
        row.append(None if (value == "#" or value == "") else value)
        del cell[:]

    chars = str(text)
    n = 0
    while n < len(chars):
        ch = chars[n]
        n += 1
        if quote:
            if ch == quote:
                if n < len(chars) and chars[n] == quote:
                    cell.append(ch)
                    n += 1
                else:
                    quote = None
            else:
                cell.append(ch)
            continue
        if ch in ("'", '"') and not cell:
            quote = ch
            in_cell = True
        elif ch == " ":
            if in_cell:
                end_cell()
                in_cell = False
        elif ch == ";":
            if in_cell:
                end_cell()
                in_cell = False
            if row:
                rows.append(list(row))
            del row[:]
        else:
            cell.append(ch)
            in_cell = True
    if in_cell:
        end_cell()
    if row:
        rows.append(list(row))
    return rows


def _params_vt_cell(cell):
    """Plain Python value of one value-table cell (``None`` when empty)."""
    if cell is None:
        return None
    if isinstance(cell, str):
        text = cell.strip()
        return None if text in ("", "#") else text
    if isinstance(cell, (bool, int, float)):
        return cell
    name = getattr(cell, "name", None)  # e.g. a Field object in a Field column
    if isinstance(name, str):
        return name
    return str(cell)


def param_value_table(param, columns=None):
    """Rows of a ``GPValueTable`` parameter as lists of plain values.

    Uses ``Parameter.values`` (a list of lists); rows given as text (for
    example when a script passes a string) are parsed with
    ``parse_value_table_text``. Empty cells (``#``, ``''``, empty text, or empty in
    ``valueAsText``: ArcGIS Pro returns an empty number cell as 0) become ``None``; rows whose
    cells are all empty are dropped. ``columns`` pads/cuts each row to that
    many cells.
    """
    raw = param.values
    if not raw:
        return []
    parsed_rows = []
    for item in raw:
        if isinstance(item, str):
            parsed_rows.extend(parse_value_table_text(item))
        elif isinstance(item, (list, tuple)):
            parsed_rows.append(list(item))
        else:
            parsed_rows.append([item])
    # ArcGIS Pro returns an empty numeric cell as 0 in ``values`` while the text shows
    # ``#`` (Pro session 1): a cell that is empty in ``valueAsText`` is empty (None).
    try:
        text_rows = parse_value_table_text(param.valueAsText)
    except Exception:  # an unreadable text never hides the values
        text_rows = []
    if len(text_rows) != len(parsed_rows):
        text_rows = []
    rows = []
    for k, row in enumerate(parsed_rows):
        values = [_params_vt_cell(c) for c in row]
        if text_rows:
            text = text_rows[k]
            values = [None if (i < len(text) and text[i] is None) or i >= len(text) else v
                      for i, v in enumerate(values)]
        if columns is not None:
            values = (values + [None] * columns)[:columns]
        if any(v is not None for v in values):
            rows.append(values)
    return rows


def input_texts(parameters):
    """Every value of the tool's Input parameters as text (multivalues split).

    ``parameters`` is the parameter list or a ``param_map`` dict. Used to
    refuse a report file that would replace an input
    (``report.choose_report_path(requested, inputs=input_texts(...))``).
    """
    params = parameters.values() if isinstance(parameters, dict) else parameters
    out = []
    for param in params:
        if param.direction != "Input":
            continue
        text = param_text(param)
        if text:
            out.extend(split_multivalue(text))
    return out


# ==========================================================================
# common/arcio.py
# ==========================================================================
# The only common module that touches arcpy: reading, writing, editing.
#
# Every arcpy name used here is listed in ARCHITECTURE.md and must be in the
# API audit. Geometry crosses the arcpy boundary as Esri JSON only:
# ``SHAPE@JSON`` + ``json.loads`` on read, ``arcpy.AsShape(esri_json, True)`` on
# write (decision D-003). Rows are plain dicts::
#
#     {"oid": 12, "shape": <core geometry or None>, "attrs": {"NAME": "A", ...}}

LAYER_DATA_TYPES = ("FeatureLayer", "TableView", "Layer")
GEOMETRY_KEYWORDS = {"point": "POINT", "multipoint": "MULTIPOINT",
                     "polyline": "POLYLINE", "polygon": "POLYGON"}
SHAPEFILE_MAX_TEXT = 254

# Curves are densified with Geometry.densify("ANGLE", distance, deviation):
# distance = geometry extent diagonal / _ARCIO_CURVE_DIVISIONS, deviation in radians.
_ARCIO_CURVE_DIVISIONS = 50.0
_ARCIO_CURVE_DEVIATION = math.radians(1.0)

# Depth of open edit sessions; deletes are refused while > 0 (ERROR 000496).
_ARCIO_EDIT_STATE = {"depth": 0}


# --------------------------------------------------------------------------
# ObjectID output fields (SRC_OID, REMOVED_BY, SITE_OID, ...)
# --------------------------------------------------------------------------

# ArcGIS Pro 3.2 and later can have 64-bit ObjectIDs, which a LONG field refuses on insert.
OID_LONG_MIN, OID_LONG_MAX = -2 ** 31, 2 ** 31 - 1
# REPORTED (ArcGIS Pro 3.3.2, job_410 BilingualNameQA section 5): inserting 2^53 + 1 into a
# BIGINTEGER field of a file geodatabase was refused with "Big integer values are currently
# limited to 53 bits."; the "ArcGIS field data types" page gives -(2^53 - 1) to 2^53 - 1.
OID_BIG_MAX = 2 ** 53 - 1
# REPORTED (job_410): a DOUBLE field of a dBASE table stored 1099511627783 (2^40 + 7) as
# 1099511627780.0 and kept 3000000001; job_403 stored 25030864197623.8 as 25030864197600.0.
# Both keep 12 significant digits, so a folder output takes a DOUBLE only while every ObjectID has
# at most 12 significant digits.
OID_DBF_DOUBLE_DIGITS = 12
# TEXT width for ObjectIDs in a folder output: a signed 64-bit integer has at most 19 digits + sign.
OID_TEXT_LENGTH = 20


def _arcio_oid_values(oids):
    return [int(o) for o in oids if o is not None and not isinstance(o, bool)]


def oid_significant_digits(value):
    """Significant decimal digits of the whole number ``value`` (0 has 1; trailing zeros do not
    count: 3000000000 has 1)."""
    text = str(abs(int(value))).rstrip("0")
    return max(1, len(text))


def oid_field_type(oids, workspace_is_folder):
    """``(AddField keyword, text length or None)`` for a field that holds the ObjectIDs ``oids``.

    * LONG while every id fits 32 bits (any workspace);
    * a geodatabase (or GeoPackage / memory) output: BIGINTEGER; an id beyond 2^53 - 1 in size
      raises ``ToolError`` (ArcGIS Pro refuses it: "Big integer values are currently limited to
      53 bits");
    * a folder (shapefile / dBASE) output: DOUBLE while every id has at most 12 significant digits
      (and is at most 2^53 - 1 in size), else TEXT of ``OID_TEXT_LENGTH`` characters (or the
      longest id) with every digit kept."""
    values = _arcio_oid_values(oids)
    if all(OID_LONG_MIN <= v <= OID_LONG_MAX for v in values):
        return "LONG", None
    if not workspace_is_folder:
        big = [v for v in values if abs(v) > OID_BIG_MAX]
        if big:
            worst = max(big, key=abs)
            raise ToolError(
                "ObjectID {0} is larger than 2^53 - 1 (9,007,199,254,740,991), the largest whole "
                "number a Big Integer field holds in ArcGIS Pro (\"Big integer values are "
                "currently limited to 53 bits\"), so the output cannot store it.".format(worst),
                "Write the output to a folder (shapefile or dBASE table), where such ObjectIDs are "
                "written as text with every digit kept, or copy the input to a new feature class "
                "or table (its ObjectIDs start at 1) and run the tool on the copy.")
        return "BIGINTEGER", None
    if all(abs(v) <= OID_BIG_MAX and oid_significant_digits(v) <= OID_DBF_DOUBLE_DIGITS
           for v in values):
        return "DOUBLE", None
    return "TEXT", max([OID_TEXT_LENGTH] + [len(str(v)) for v in values])


def oid_field_spec(oids, workspace_is_folder, name="SRC_OID", alias=None, label=None):
    """``(field spec, info message or None)`` for an ObjectID output field (``oid_field_type``).

    The message (None for LONG) says which type the field got and, for TEXT, why. ``label`` names
    the field in the message (default ``name``). Raises ``ToolError`` as ``oid_field_type``."""
    keyword, length = oid_field_type(oids, workspace_is_folder)
    spec = {"name": name, "type": keyword}
    if length:
        spec["length"] = length
    if alias:
        spec["alias"] = alias
    label = label or name
    if keyword == "LONG":
        return spec, None
    text = "Some ObjectIDs do not fit 32 bits (64-bit ObjectIDs); {0} is written as {1}.".format(
        label, keyword)
    if keyword == "TEXT":
        values = _arcio_oid_values(oids)
        many = sum(1 for v in values if abs(v) > OID_BIG_MAX
                   or oid_significant_digits(v) > OID_DBF_DOUBLE_DIGITS)
        text += (" A Double field in a shapefile or dBASE table keeps only {0} significant digits "
                 "and {1} ObjectID(s) have more, so the field is text ({2} characters) with every "
                 "digit kept.".format(OID_DBF_DOUBLE_DIGITS, many, length))
    return spec, text


def oid_output_field(out_path, oids, collector=None, name="SRC_OID", alias=None, label=None):
    """``oid_field_spec`` for a field of the output ``out_path`` (a folder output or not is read
    from the path); the message goes to ``collector.info``. Returns the field spec."""
    spec, note = oid_field_spec(oids, is_folder_workspace(workspace_of(out_path)), name=name,
                                alias=alias, label=label)
    if note and collector is not None:
        collector.info(note)
    return spec


def oid_field_value(spec, oid):
    """``oid`` as written to the field ``spec`` of ``oid_field_spec``: its digits for TEXT."""
    if oid is None or isinstance(oid, bool) or spec.get("type") != "TEXT":
        return oid
    return str(int(oid))


# --------------------------------------------------------------------------
# Describe
# --------------------------------------------------------------------------

def sr_info(sr):
    """Plain dict for a ``SpatialReference`` (``None`` stays ``None``).

    ``"polar_stereographic"``: 1 / -1 when a projected system is polar
    stereographic about the North / South Pole (``polar_stereographic_sign``), else
    ``None``."""
    if sr is None:
        return None
    sr_type = sr.type
    projected = sr_type == "Projected"
    return {"wkid": sr.factoryCode or None, "name": sr.name, "type": sr_type,
            "meters_per_unit": sr.metersPerUnit if projected else None,
            "polar_stereographic": polar_stereographic_sign(sr) if projected else None}


# (factoryCode, name) -> result of polar_stereographic_sign; systems with a WKID only.
_ARCIO_POLAR_CACHE = {}


def polar_stereographic_sign(sr):
    """1 / -1 when the projected system ``sr`` is polar stereographic about the North
    / South Pole, else ``None`` (RT8-C-3: any polar stereographic system, not a WKID
    list). The probe points of ``projection.polar_probe_points`` are projected into
    ``sr`` one by one (``arcpy.AsShape`` in WGS 84, ``Geometry.projectAs``) and tested
    with ``projection.is_polar_stereographic_probe``. A point that cannot be projected
    makes the system "not polar stereographic"."""
    key = (sr.factoryCode, sr.name) if sr.factoryCode else None
    if key is not None and key in _ARCIO_POLAR_CACHE:
        return _ARCIO_POLAR_CACHE[key]
    found = None
    for sign in (1, -1):
        projected = []
        for lon, lat in polar_probe_points(sign):
            try:
                shape = arcpy.AsShape({"x": lon, "y": lat, "spatialReference": {"wkid": 4326}},
                                      True).projectAs(sr)
                data = json.loads(shape.JSON)
                projected.append((float(data["x"]), float(data["y"])))
            except Exception:  # outside the system's domain: not this pole's projection
                projected.append(None)
        if is_polar_stereographic_probe(projected):
            found = sign
            break
    if key is not None:
        _ARCIO_POLAR_CACHE[key] = found
    return found


def field_info(field):
    """Plain dict for an ``arcpy.Field``."""
    return {"name": field.name, "alias": field.aliasName, "type": field.type,
            "length": field.length, "domain": field.domain or None,
            "nullable": field.isNullable, "editable": field.editable,
            "required": field.required}


def describe_dataset(path):
    """Describe a feature class, table or layer.

    Returns ``{"input", "catalog_path", "workspace", "name", "data_type",
    "is_layer", "shape_type", "sr", "sr_object", "oid_field", "fields", "has_z",
    "has_m"}`` (``has_z`` / ``has_m``: the dataset stores Z / M values; ``False`` when the
    describe result does not say).
    For a layer, ``catalog_path`` is the layer's data source, so output/input
    comparisons use the real dataset, while cursors still use ``input`` (so
    selections and definition queries are honoured).
    """
    if not path or not arcpy.Exists(path):
        raise ToolError("The input '{0}' does not exist.".format(path),
                        "Check the path or layer name, or browse to the dataset.")
    desc = arcpy.da.Describe(path)
    catalog = desc["catalogPath"]
    register_inputs([path, catalog])  # every described dataset is an input of the run
    fields = [field_info(f) for f in desc["fields"]]
    register_joined_tables(joined_table_names(fields))  # ... and so is every joined table
    sr = desc["spatialReference"] if "spatialReference" in desc else None
    return {
        "input": path,
        "catalog_path": catalog,
        "workspace": workspace_of(catalog),
        "name": split_catalog_path(catalog)[1],
        "data_type": desc["dataType"],
        "is_layer": desc["dataType"] in LAYER_DATA_TYPES,
        "shape_type": desc["shapeType"] if "shapeType" in desc else None,
        "sr": sr_info(sr),
        "sr_object": sr,
        "oid_field": desc["OIDFieldName"] if ("hasOID" in desc and desc["hasOID"]) else None,
        "fields": fields,
        "has_z": bool(desc["hasZ"]) if "hasZ" in desc else False,
        "has_m": bool(desc["hasM"]) if "hasM" in desc else False,
    }


# --------------------------------------------------------------------------
# Read
# --------------------------------------------------------------------------

def _arcio_densify_curve(shape):
    """Esri JSON dict of a curved geometry after densification."""
    ext = shape.extent
    diag = math.hypot(ext.width, ext.height) or 1.0
    dense = shape.densify("ANGLE", diag / _ARCIO_CURVE_DIVISIONS, _ARCIO_CURVE_DEVIATION)
    data = json.loads(dense.JSON)
    if esri_json_has_curves(data):
        raise ToolError("A true-curve geometry could not be densified.",
                        "Run the Densify tool on the input first, then rerun this tool.")
    return data


def read_features(path, fields=(), sr=None, where=None, geometry=True):
    """Read rows as dicts ``{"oid", "shape", "attrs"}``.

    ``path`` may be a layer (selection and definition query honoured).
    ``sr`` (an ``arcpy.SpatialReference``) projects geometry at read time so
    source ObjectIDs are kept. True curves (``curvePaths``/``curveRings``) are
    re-read with ``SHAPE@`` and densified (decision D-005). Z and M are dropped.
    """
    register_inputs([path])
    fields = list(fields)
    tokens = ["OID@"] + (["SHAPE@JSON"] if geometry else []) + fields
    first = 2 if geometry else 1
    rows, curved = [], {}
    with arcpy.da.SearchCursor(path, tokens, where_clause=where, spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None,
                   "attrs": dict(zip(fields, values[first:]))}
            if geometry and values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    curved[values[0]] = row
                else:
                    row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    if curved:
        with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@"], where_clause=where,
                                   spatial_reference=sr) as cursor:
            for oid, shape in cursor:
                if oid in curved and shape is not None:
                    curved[oid]["shape"] = esri_json_to_core(_arcio_densify_curve(shape))[1]
    return rows


def read_features_skip_curves(path, fields=(), sr=None, where=None, zm=None):
    """Like ``read_features`` but true-curve features are skipped, not densified.

    Returns ``(rows, skipped_oids)``. Tools that report individual vertices or
    segments use this: densified arcs would create artificial vertices.
    Skipped features are not in ``rows``.

    ``zm``: optional dict; when given, ``zm["z"]`` / ``zm["m"]`` are set to the lists of
    ObjectIDs of the features that carry Z / M values (which the core geometry drops).
    """
    register_inputs([path])
    fields = list(fields)
    rows, skipped = [], []
    with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@JSON"] + fields, where_clause=where,
                               spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "attrs": dict(zip(fields, values[2:]))}
            if values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    skipped.append(values[0])
                    continue
                if zm is not None:
                    has_z, has_m = esri_json_zm(data)
                    if has_z:
                        zm.setdefault("z", []).append(values[0])
                    if has_m:
                        zm.setdefault("m", []).append(values[0])
                row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    return rows, skipped


def iter_features(path, fields=(), sr=None, where=None, geometry=True):
    """Like ``read_features`` but a generator: one row at a time, nothing kept in memory.

    Yields ``{"oid", "shape", "attrs", "curved"}``. A true-curve feature is NOT densified
    here: ``shape`` is ``None`` and ``curved`` is True (callers that only draw an outline
    count and skip it). Without ``geometry`` the cursor has no shape token (tables).
    """
    register_inputs([path])
    fields = list(fields)
    tokens = ["OID@"] + (["SHAPE@JSON"] if geometry else []) + fields
    first = 2 if geometry else 1
    with arcpy.da.SearchCursor(path, tokens, where_clause=where, spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "curved": False,
                   "attrs": dict(zip(fields, values[first:]))}
            if geometry and values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    row["curved"] = True
                else:
                    row["shape"] = esri_json_to_core(data)[1]
            yield row


def count_rows(path, where=None):
    """Number of rows of a table, feature class or layer (a layer's selection and definition
    query are honoured). Counted with a cursor on the ObjectID, nothing is kept."""
    register_inputs([path])
    total = 0
    with arcpy.da.SearchCursor(path, ["OID@"], where_clause=where) as cursor:
        for _row in cursor:
            total += 1
    return total


# Straight segments of a geographic (or other non-metric) input are straight in
# THAT system; projecting only their vertices bends them (about 0.02 m off at the
# middle of a 1.5 km segment, 2 m at 15 km). Lines are therefore densified in
# their own system every ~ARCIO_DENSIFY_STEP_M before they are projected.
ARCIO_DENSIFY_STEP_M = 100.0
_ARCIO_METRES_PER_DEGREE = 111320.0


def densify_step_for(desc, decision):
    """Densify distance in the input's own units before reprojecting it, or
    ``None`` when the input is used as is (no projection, nothing bends)."""
    if not decision.get("reproject"):
        return None
    info = desc["sr"] or {}
    if info.get("type") == "Geographic":
        return ARCIO_DENSIFY_STEP_M / _ARCIO_METRES_PER_DEGREE
    mpu = info.get("meters_per_unit")
    if mpu:
        return ARCIO_DENSIFY_STEP_M / float(mpu)
    return None


def read_features_densified(path, fields=(), sr=None, step=None, skip_curves=False,
                            where=None, geographic=False):
    """Read lines/polygons projected to ``sr`` after densifying them in their own
    system, so the projected geometry follows the straight segments of the
    source system. Each segment is densified on its own in pure Python
    (``geom.densify_path_segments``), the result is rebuilt with
    ``arcpy.AsShape`` in the source system and projected with
    ``Geometry.projectAs``. Without a source WKID, ``Geometry.densify``
    ("DISTANCE") is used instead.

    Without ``sr`` or ``step`` this is ``read_features`` (or
    ``read_features_skip_curves`` with ``skip_curves``). True curves are
    skipped (``skip_curves``) or densified by angle first (D-005). Returns
    ``(rows, skipped_oids)``. Adds vertices: use only for measuring and
    snapping, never where the vertices themselves are the result.

    ``geographic``: the input is in a geographic system. A segment spanning
    more than 180 degrees of longitude is taken to cross the antimeridian the
    short way and is densified across it (only that segment is affected).
    """
    register_inputs([path])
    fields = list(fields)
    if sr is None or not step:
        if skip_curves:
            return read_features_skip_curves(path, fields, sr=sr, where=where)
        return read_features(path, fields, sr=sr, where=where), []
    rows, skipped = [], []
    with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@"] + fields, where_clause=where) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "attrs": dict(zip(fields, values[2:]))}
            shape = values[1]
            if shape is not None:
                if shape.hasCurves:
                    if skip_curves:
                        skipped.append(values[0])
                        continue
                    ext = shape.extent
                    diag = math.hypot(ext.width, ext.height) or 1.0
                    shape = shape.densify("ANGLE", diag / _ARCIO_CURVE_DIVISIONS,
                                          _ARCIO_CURVE_DEVIATION)
                source = json.loads(shape.JSON)
                kind, core = esri_json_to_core(source)
                own = shape.spatialReference
                wkid = own.factoryCode if own is not None else None
                if core is None:
                    rows.append(row)
                    continue
                if wkid:
                    dense = [densify_path_segments(part, step, geographic) for part in core]
                    shape = arcpy.AsShape(core_to_esri_json(kind, dense, wkid), True)
                    shape = shape.projectAs(sr)
                else:
                    shape = shape.densify("DISTANCE", step).projectAs(sr)
                data = json.loads(shape.JSON)
                if esri_json_has_curves(data):
                    raise ToolError("A true-curve geometry could not be densified.",
                                    "Run the Densify tool on the input first, then rerun "
                                    "this tool.")
                row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    return rows, skipped


def _arcio_coords(node, out):
    """Collect ``(x, y)`` pairs from any nested Esri JSON coordinate list."""
    if isinstance(node, (list, tuple)):
        if len(node) >= 2 and all(isinstance(v, (int, float)) for v in node[:2]):
            out.append((float(node[0]), float(node[1])))
        else:
            for item in node:
                _arcio_coords(item, out)
    elif isinstance(node, dict):
        for value in node.values():
            _arcio_coords(value, out)


def sample_lonlat(path, where=None, max_samples=5000):
    """Up to ``max_samples`` vertices of the input in WGS 84 degrees."""
    register_inputs([path])
    samples = []
    wgs84 = arcpy.SpatialReference(4326)
    with arcpy.da.SearchCursor(path, ["SHAPE@JSON"], where_clause=where,
                               spatial_reference=wgs84) as cursor:
        for (text,) in cursor:
            if not text:
                continue
            data = json.loads(text)
            if "x" in data:
                if data.get("x") is not None and data.get("y") is not None:
                    samples.append((float(data["x"]), float(data["y"])))
                continue
            data.pop("spatialReference", None)
            _arcio_coords(data, samples)
            if len(samples) > 2 * max_samples:
                samples = samples[::2]
    if len(samples) > max_samples:
        samples = samples[::int(math.ceil(len(samples) / float(max_samples)))]
    return samples


def metric_sr_for(desc, where=None):
    """Choose the measuring coordinate system for a described dataset.

    Returns ``(decision, spatial_reference)``; ``spatial_reference`` is
    ``None`` when the input system is kept (no projection needed). See
    ``projection.choose_metric_sr`` for ``decision``.
    """
    info = desc["sr"]
    try:
        decision = choose_metric_sr(info, None)  # enough when the input system is kept
    except ToolError:
        decision = choose_metric_sr(info, sample_lonlat(desc["input"], where))
    if not decision["reproject"]:
        return decision, None
    return decision, arcpy.SpatialReference(decision["wkid"])


def metric_sr_or_native(desc, where=None):
    """Like ``metric_sr_for``, but an input without any usable coordinates
    (empty, or only null geometries) in a geographic or Web Mercator system
    keeps its own system instead of failing: there is nothing to measure.

    The decision then has ``"empty": True`` and ``meters_per_unit`` 1.0.
    """
    try:
        return metric_sr_for(desc, where)
    except ToolError:
        info = desc["sr"] or {}
        return {"wkid": info.get("wkid"), "meters_per_unit": 1.0, "reproject": False,
                "reason": "The input has no features with coordinates, so nothing is "
                          "measured.", "warnings": [], "empty": True}, None


def read_domains(workspace):
    """``{name: domain dict}`` for all domains of a workspace (see ``domains``).

    The workspace is registered as an input of the run (a domain source)."""
    register_inputs([workspace])
    try:
        return _arcio_list_domains(workspace)
    except (RuntimeError, ValueError, OSError, arcpy.ExecuteError) as exc:
        # ListDomains is documented for geodatabases only; a GeoPackage, a missing or locked
        # geodatabase would otherwise end as a bare Python traceback.
        raise ToolError("The attribute domains of '{0}' could not be read: {1}".format(
            workspace, str(exc).strip() or type(exc).__name__),
            "Attribute domains exist only in geodatabases. Use a file, mobile or enterprise "
            "geodatabase, and check that it is not locked by another application.")


def _arcio_list_domains(workspace):
    result = {}
    if is_folder_workspace(workspace):
        return result
    for dom in arcpy.da.ListDomains(workspace):
        coded = dom.domainType == "CodedValue"
        result[dom.name] = {
            "name": dom.name,
            "domain_type": dom.domainType,
            "field_type": dom.type,
            "codes": dict(dom.codedValues or {}) if coded else {},
            "range": None if coded else tuple(dom.range),
            "description": dom.description,
        }
    return result


def read_output_domains(out_path):
    """Domains of the workspace an output path will be written to (its
    geodatabase, also when the output is in a feature dataset), for
    ``domains.keep_field_domain``. ``{}`` for a folder, or when they cannot be
    listed (e.g. ``memory``, or a location that does not exist yet)."""
    try:
        return _arcio_list_domains(workspace_of(out_path)) or {}
    except Exception:
        return {}


def read_subtypes(path):
    """Subtype structure (see ``domains``); ``{"field": "", "subtypes": {}}`` if none.

    Pass a catalog path (``describe_dataset(...)["catalog_path"]``). Shapefiles
    and other folder datasets have no subtypes and are not queried.
    """
    register_inputs([path])
    empty = {"field": "", "subtypes": {}}
    workspace = workspace_of(path)
    if workspace and (is_folder_workspace(workspace) or workspace.casefold().endswith(".gpkg")):
        return empty  # shapefiles, dBASE tables and GeoPackage tables have no subtypes
    raw = arcpy.da.ListSubtypes(path)
    field = ""
    subtypes = {}
    for code, info in raw.items():
        field = info["SubtypeField"] or field
        domains, defaults = {}, {}
        for name, values in info["FieldValues"].items():
            defaults[name] = values[0]
            domains[name] = values[1].name if values[1] is not None else None
        subtypes[code] = {"name": info["Name"], "default": info["Default"],
                          "domains": domains, "defaults": defaults}
    if not field:
        return empty
    return {"field": field, "subtypes": subtypes}


# Datatype keywords documented for arcpy.da.Walk (walk.html, API audit).
WALK_DATATYPES = ("Any", "CadDrawing", "FeatureClass", "FeatureDataset", "GeometricNetwork",
                  "LasDataset", "Layer", "Locator", "Map", "MosaicDataset", "NetworkDataset",
                  "ParcelDataset", "RasterCatalog", "RasterDataset", "RelationshipClass",
                  "RepresentationClass", "Table", "Terrain", "Tin", "Tool", "Topology",
                  "UtilityNetwork")


def walk_workspace(root, datatypes=("FeatureClass", "Table"), recursive=True):
    """List datasets under a folder or workspace with ``arcpy.da.Walk``.

    Walk is called once per datatype keyword (decided before the loop), so
    every item carries the keyword it was found with; ``type=`` is never
    passed (its effect on tables is undocumented, audit gotcha 41). Folders
    and connection files are not followed (``followlinks=False``).

    Returns ``{"items": [...], "errors": [...]}``: items are
    ``{"path", "name", "dirpath", "data_type"}`` sorted by normalised path,
    without duplicates (first datatype wins); errors are
    ``{"path", "message", "datatype"}`` (the Walk keyword that raised it) for every folder Walk could not read (its
    ``onerror`` callback) or a Walk that stopped with an exception. Errors
    never stop the listing.

    ``recursive=False`` (added for the project toolbox; the default keeps the
    old behaviour): sub-folders of a folder root are not entered, but
    geodatabases directly inside it are listed in full (a geodatabase is a
    workspace of the folder, not a sub-folder). Pruning edits ``dirnames`` in
    place on a top-down walk, so skipped folders are never read.
    """
    bad = [d for d in datatypes if d not in WALK_DATATYPES]
    if bad or not datatypes:
        raise ValueError("unknown Walk datatype(s): {0}".format(", ".join(map(str, bad)) or "none"))
    if not root or not (os.path.isdir(str(root)) or arcpy.Exists(root)):
        raise ToolError("The workspace or folder '{0}' does not exist.".format(root),
                        "Browse to an existing folder or geodatabase.")
    errors = []
    current = [None]            # the datatype keyword of the Walk that is running

    def on_error(err):
        errors.append({"path": getattr(err, "filename", None) or "", "message": str(err),
                       "datatype": current[0]})

    items = {}
    for datatype in datatypes:
        current[0] = datatype
        try:
            for dirpath, dirnames, filenames in arcpy.da.Walk(
                    root, topdown=True, onerror=on_error, followlinks=False, datatype=datatype):
                if not recursive and is_folder_workspace(workspace_of(dirpath) or dirpath):
                    if normalize_catalog_path(dirpath) != normalize_catalog_path(root):
                        dirnames[:] = []
                        continue
                    dirnames[:] = [d for d in dirnames if not is_folder_workspace(d)]
                for name in filenames:
                    path = os.path.join(dirpath, name)
                    key = normalize_catalog_path(path)
                    if key not in items:
                        items[key] = {"path": path, "name": name, "dirpath": dirpath,
                                      "data_type": datatype}
        except (RuntimeError, OSError) as exc:
            errors.append({"path": str(root), "message": "{0} ({1})".format(exc, datatype),
                           "datatype": datatype})
    listed = [items[k] for k in sorted(items)]
    register_inputs([i["path"] for i in listed])
    return {"items": listed, "errors": errors}


# --------------------------------------------------------------------------
# Create and write
# --------------------------------------------------------------------------

def overwrite_output():
    """Value of ``arcpy.env.overwriteOutput`` as a bool."""
    return bool(arcpy.env.overwriteOutput)


def _arcio_existing_outputs(out_path):
    """Existing datasets an output would replace: the path itself and, for a
    folder output without extension, the ``.shp`` / ``.dbf`` Pro would write
    (``paths.folder_dataset_candidates``)."""
    return [p for p in folder_dataset_candidates(out_path) if arcpy.Exists(p)]


def check_output_path(out_path, inputs=()):
    """Every check ``create_table``/``create_feature_class`` make, without side effects.

    Refuses an output equal to an input, a missing output location, an
    existing output when overwriting is off, and an invalid name. Tools that
    edit their input call it for all outputs **before** the backup and the
    edit session (rule 6), so a bad output can never stop the run after the
    input was changed.
    """
    refuse_if_same([out_path], inputs)
    workspace, name = split_catalog_path(out_path)
    if not workspace or not arcpy.Exists(workspace):
        raise ToolError("The output location '{0}' does not exist.".format(workspace),
                        "Choose an existing geodatabase or folder for the output.")
    if _arcio_existing_outputs(out_path) and not overwrite_output():
        raise ToolError("The output '{0}' already exists.".format(out_path),
                        "Choose a new name, or allow geoprocessing tools to overwrite "
                        "existing datasets (Options > Geoprocessing).")
    base = name
    if is_folder_workspace(workspace) and name.casefold().endswith((".shp", ".dbf")):
        base = name[:-4]
    valid = arcpy.ValidateTableName(base, validation_workspace(workspace))
    if valid != base:
        raise ToolError("The output name '{0}' is not valid in '{1}'.".format(name, workspace),
                        "Use a name such as '{0}' (letters, digits and underscores).".format(valid))


def _arcio_prepare_output(out_path, inputs):
    """Checks shared by feature class and table creation; returns ``(ws, name)``."""
    refuse_if_same([out_path], inputs)
    workspace, name = split_catalog_path(out_path)
    if not workspace or not arcpy.Exists(workspace):
        raise ToolError("The output location '{0}' does not exist.".format(workspace),
                        "Choose an existing geodatabase or folder for the output.")
    existing = _arcio_existing_outputs(out_path)
    if existing:
        if not overwrite_output():
            raise ToolError("The output '{0}' already exists.".format(out_path),
                            "Choose a new name, or allow geoprocessing tools to overwrite "
                            "existing datasets (Options > Geoprocessing).")
        for path in existing:
            safe_delete(path, inputs)
    base = name
    if is_folder_workspace(workspace) and name.casefold().endswith((".shp", ".dbf")):
        base = name[:-4]
    valid = arcpy.ValidateTableName(base, validation_workspace(workspace))
    if valid != base:
        raise ToolError("The output name '{0}' is not valid in '{1}'.".format(name, workspace),
                        "Use a name such as '{0}' (letters, digits and underscores).".format(valid))
    return workspace, name


def validation_workspace(workspace):
    """Workspace to pass to ``ValidateTableName`` / ``ValidateFieldName`` for an
    output container: a feature dataset is validated against its geodatabase
    (the Validate functions document file system and geodatabase workspaces);
    a folder or geodatabase is returned unchanged."""
    if workspace and not is_folder_workspace(workspace):
        return workspace_of(workspace) or workspace
    return workspace


def _arcio_folder_name(workspace, name, ext):
    """``name`` with ``ext`` (``.shp`` / ``.dbf``) added in a folder workspace when it has no
    extension: Pro takes an extension-less table name in a folder for an INFO table
    (ERROR 000734 with a space in the path; Pro session 1, S3)."""
    if is_folder_workspace(workspace) and "." not in name:
        return name + ext
    return name


def _arcio_output_path(workspace, name):
    return workspace + "\\" + _arcio_folder_name(workspace, name, ".shp")


# A shapefile/dBASE field name holds at most 10 BYTES in UTF-8, not 10 characters (REPORTED: Pro
# job_403, ThiessenPolygonsConvex log: Arabic names of 12 and 15 letters were stored as 5 letters,
# 10 bytes; one of 4 letters, 8 bytes, was kept whole).
DBF_FIELD_NAME_BYTES = 10


def dbf_field_name_bytes(name):
    """Bytes a shapefile/dBASE field name takes (UTF-8; a character above U+FFFF as 6, like
    ``_arcio_dbf_bytes``)."""
    return _arcio_dbf_bytes(name)


def cut_dbf_field_name(name, limit=DBF_FIELD_NAME_BYTES):
    """``name`` cut at a character boundary to at most ``limit`` bytes (see
    ``dbf_field_name_bytes``): what a dBASE workspace keeps of a field name."""
    kept, used = [], 0
    for ch in str(name):
        size = _arcio_dbf_bytes(ch)
        if used + size > limit:
            break
        kept.append(ch)
        used += size
    return "".join(kept)


_ARCIO_SYSTEM_FIELDS = ("OBJECTID", "FID", "OID", "SHAPE", "SHAPE_LENGTH", "SHAPE_AREA")


def unique_field_specs(out_path, field_specs, fixed=0, reserved=()):
    """Make the output names of ``field_specs`` unique in the output workspace.

    The first ``fixed`` specs (the tool's own fields) keep their names; any
    later spec whose validated name clashes (shapefile/dBASE names are cut to
    10 BYTES in UTF-8, so ROAD_NAME_EN and ROAD_NAME_AR both become ROAD_NAME_,
    and an Arabic name keeps at most 5 letters) is renamed the way Copy Features
    does: shortened and given ``_1``, ``_2``, ... Names of system fields (ObjectID, Shape, ... and ``Id`` in a
    folder) and ``reserved`` names are avoided too. Nothing is created.

    Returns ``(specs, renamed)``: copies of the specs with ``name`` set to the
    final output name (the original name is kept as ``alias`` when no alias
    was given) and a list of ``(original, new)`` pairs.
    """
    workspace = validation_workspace(split_catalog_path(out_path)[0])
    folder = is_folder_workspace(workspace)
    taken = set(n.casefold() for n in _ARCIO_SYSTEM_FIELDS)
    taken.update(str(r).casefold() for r in reserved)
    if folder:
        taken.add("id")
    # A new name must not be the (validated) name of a LATER spec either: with input fields ORIG_X
    # and ORIG_X_1 and ORIG_X reserved, ORIG_X must become ORIG_X_2, not ORIG_X_1 (which would then
    # hold another field's data while the real ORIG_X_1 moved to ORIG_X_1_1). Review R8 F2.
    names_ahead = set(arcpy.ValidateFieldName(sp["name"], workspace).casefold()
                      for sp in field_specs[fixed:])
    out, renamed = [], []
    for k, spec in enumerate(field_specs):
        spec = dict(spec)
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        if k >= fixed and actual.casefold() in taken:
            limit = DBF_FIELD_NAME_BYTES if folder else max(len(actual), 1) + 4
            number = 1
            while True:
                suffix = "_{0}".format(number)
                if folder:
                    # dBASE names are cut to 10 BYTES (UTF-8), not characters (REPORTED: Pro
                    # job_403, Thiessen: an Arabic name kept 5 letters = 10 bytes).
                    base = cut_dbf_field_name(actual, limit - len(suffix))
                else:
                    base = actual[:limit - len(suffix)]
                candidate = arcpy.ValidateFieldName(base + suffix, workspace)
                # A workspace that cuts names by bytes (ArcGIS Pro shapefiles: an Arabic letter
                # takes 2 of the 10 bytes) drops the suffix; shorten the base until it survives,
                # so each number costs a few calls instead of ~10,000 per collision (review R5 O1).
                while base and not candidate.endswith(suffix):
                    base = base[:-1]
                    candidate = arcpy.ValidateFieldName(base + suffix, workspace)
                if candidate.casefold() not in taken and candidate.casefold() not in names_ahead:
                    break
                number += 1
            renamed.append((spec["name"], candidate))
            if not spec.get("alias"):
                spec["alias"] = spec["name"]
            actual = candidate
        taken.add(actual.casefold())
        spec["name"] = actual
        out.append(spec)
    return out, renamed


def _arcio_dbf_bytes(value):
    """Bytes a dBASE text field needs for ``value`` as Pro writes it (UTF-8; characters above U+FFFF as 6)."""
    text = str(value)
    # "surrogatepass": a lone UTF-16 surrogate (U+D800-U+DFFF) counts its 3 bytes instead of
    # raising UnicodeEncodeError (round-6 shared finding; Mojibake/Bilingual inputs can hold one).
    return len(text.encode("utf-8", "surrogatepass")) + 2 * sum(1 for ch in text if ord(ch) > 0xFFFF)


def cut_utf8_bytes(text, folder, counter, marker=""):
    """``text`` as a dBASE/shapefile text field can hold it: at most 254 bytes as Pro writes them
    (UTF-8, an Arabic letter takes 2; characters above U+FFFF count 6, see ``_arcio_dbf_bytes``;
    REPORTED by ArcGIS Pro job_222 for dBASE tables). Longer text is cut at a character boundary
    by the same rule, so a cut value can never make ``_arcio_text_length`` refuse it, and counted
    in ``counter[0]``; outside a folder nothing is cut. ``marker`` (e.g. ``" ...[cut]"``, ASCII)
    is appended to a cut value, and the cut leaves room for it."""
    if not folder or not isinstance(text, str):
        return text
    if _arcio_dbf_bytes(text) <= SHAPEFILE_MAX_TEXT:
        return text
    counter[0] += 1
    limit = SHAPEFILE_MAX_TEXT - _arcio_dbf_bytes(marker)
    kept, used = [], 0
    for ch in text:
        size = _arcio_dbf_bytes(ch)
        if used + size > limit:
            break
        kept.append(ch)
        used += size
    return "".join(kept) + marker


def _arcio_utf16_units(value):
    """Length of ``value`` in UTF-16 code units: a character above U+FFFF counts 2. A file
    geodatabase text field counts its width this way (REPORTED: Pro job_403, MojibakeDetector:
    a DETAIL value as long as the field in characters, with 5 characters above U+FFFF, was
    refused with "Field length exceeded")."""
    text = str(value)
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def _arcio_text_length(spec, actual, folder):
    """Width of the TEXT field ``spec`` (output name ``actual``).

    ``length`` if given, else the longest of ``values``. In a folder
    (shapefile/dBASE, at most 254 characters) a ``length`` that is too wide
    but comes with the ``values`` to be written (e.g. a carried field with
    Pro's default length 255) is narrowed to 254 when every value fits, as
    Copy Features does (rule 8: the values decide). Raises ``ToolError``
    only when a value, or a fixed width without values, really needs more.
    """
    values = spec.get("values")
    length = spec.get("length") or text_field_length(values or ())
    if not folder and not spec.get("length") and values:
        # geodatabase / GeoPackage: the width in UTF-16 units (job_403), never narrower than before
        length = max([length] + [_arcio_utf16_units(v) for v in values if v is not None])
    if folder and values is not None:
        # A dBASE text field written by ArcGIS Pro (UTF-8 code page) holds at most 254 BYTES, not
        # characters (REPORTED: Pro job_251, Thiessen; job_222, another tool): an Arabic letter
        # needs 2. A 97-character name of 130 bytes in a 120-wide field lost its last 10 bytes
        # without any message. The width is raised to the widest value in bytes (capped at 254).
        # Characters above U+FFFF (mathematical letters, emoji) are written by Pro as two 3-byte
        # surrogates (CESU-8: 6 bytes, not 4; CONFIRMED in the bytes of a Pro job 274 dBASE file),
        # so they count 6.
        widest_bytes = max([_arcio_dbf_bytes(v) for v in values if v is not None] or [0])
        if widest_bytes > SHAPEFILE_MAX_TEXT:
            raise ToolError(
                "Field '{0}' holds a value of {1} characters ({2} bytes in UTF-8 as ArcGIS Pro writes them, where a "
                "character above U+FFFF such as an emoji takes 6); shapefiles and dBASE tables allow "
                "{3} bytes.".format(actual, text_field_length(values), widest_bytes,
                                    SHAPEFILE_MAX_TEXT),
                "Write the output to a file geodatabase instead of a folder.")
        return min(max(length, widest_bytes), SHAPEFILE_MAX_TEXT)
    if not folder or length <= SHAPEFILE_MAX_TEXT:
        return length
    if values is not None and spec.get("length"):
        longest = text_field_length(values)
        if longest <= SHAPEFILE_MAX_TEXT:
            return SHAPEFILE_MAX_TEXT
        raise ToolError(
            "Field '{0}' holds a value of {1} characters; shapefiles and dBASE tables allow {2}.".format(
                actual, longest, SHAPEFILE_MAX_TEXT),
            "Write the output to a file geodatabase instead of a folder.")
    raise ToolError(
        "Field '{0}' needs {1} characters; shapefiles and dBASE tables allow {2}.".format(
            actual, length, SHAPEFILE_MAX_TEXT),
        "Write the output to a file geodatabase instead of a folder.")


def plan_field_names(field_specs, workspace, reserved=()):
    """Valid output names for ``field_specs`` without creating anything.

    Returns ``{requested name: actual name}`` (``arcpy.ValidateFieldName``).
    Raises ``ToolError`` when two fields would get the same name, when a name
    equals one of ``reserved`` (e.g. the ObjectID field the new table gets),
    or when a shapefile/dBASE text field would be wider than 254 characters.
    Call it before the output is created so a bad schema never leaves a
    half-built output behind.
    """
    mapping = {}
    used = {}
    taken = set(str(r).casefold() for r in reserved)
    folder = is_folder_workspace(workspace)
    workspace = validation_workspace(workspace)
    for spec in field_specs:
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        key = actual.casefold()
        if key in used:
            raise ToolError("The output fields '{0}' and '{1}' would both be called '{2}'.".format(
                used[key], spec["name"], actual),
                "Give one of them another name{0}.".format(
                    " (dBASE/shapefile field names are cut to 10 bytes in UTF-8)" if folder else ""))
        if key in taken:
            raise ToolError("The output field '{0}' would be called '{1}', a name the new output "
                            "already uses.".format(spec["name"], actual),
                            "Give that field another name.")
        used[key] = spec["name"]
        if folder and spec["type"] == "TEXT":
            _arcio_text_length(spec, actual, folder)
        mapping[spec["name"]] = actual
    return mapping


def plan_output_fields(out_path, field_specs, fixed=0, reserved=()):
    """``unique_field_specs`` then ``plan_field_names`` for one output, before
    anything is created. Returns ``(specs, renamed)`` (see ``unique_field_specs``);
    raises ``ToolError`` for problems renaming cannot solve (e.g. a text field
    wider than a shapefile allows)."""
    specs, renamed = unique_field_specs(out_path, field_specs, fixed, reserved)
    plan_field_names(specs, split_catalog_path(out_path)[0])
    return specs, renamed


def add_fields(table, field_specs, workspace):
    """Add fields; return ``{requested name: actual name}``.

    ``field_specs``: dicts with ``name``, ``type`` (AddField keyword: TEXT,
    SHORT, LONG, DOUBLE, ...), optional ``alias``, ``length``, ``values`` and
    ``domain`` (a domain of the output workspace; AddField ignores unknown ones).
    A TEXT field without ``length`` gets the width of its longest value.
    """
    mapping = {}
    used = set()
    folder = is_folder_workspace(workspace)
    workspace = validation_workspace(workspace)
    for spec in field_specs:
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        if actual.casefold() in used:
            raise ToolError("Two output fields would both be called '{0}'.".format(actual),
                            "Rename one of them (shapefile field names are cut to 10 bytes in UTF-8).")
        used.add(actual.casefold())
        length = None
        if spec["type"] == "TEXT":
            length = _arcio_text_length(spec, actual, folder)
        arcpy.management.AddField(table, actual, spec["type"], field_length=length,
                                  field_alias=spec.get("alias") or None,
                                  field_domain=spec.get("domain") or None)
        mapping[spec["name"]] = actual
    return mapping


def create_feature_class(out_path, kind, sr, field_specs, inputs=(), has_z=False, has_m=False):
    """Create an output feature class; return ``(catalog path, field mapping)``.

    ``has_z`` / ``has_m``: create the output with Z / M values (``has_z="ENABLED"`` of
    Create Feature Class); the call is the same as before when both are False."""
    workspace, name = _arcio_prepare_output(out_path, inputs)
    options = {}
    if has_z:
        options["has_z"] = "ENABLED"
    if has_m:
        options["has_m"] = "ENABLED"
    result = arcpy.management.CreateFeatureclass(
        workspace, _arcio_folder_name(workspace, name, ".shp"),
        geometry_type=GEOMETRY_KEYWORDS[kind], spatial_reference=sr, **options)
    path = _arcio_created_path(result, workspace, _arcio_output_path(workspace, name))
    return path, _arcio_fields_or_delete(path, field_specs, workspace, inputs)


def create_table(out_path, field_specs, inputs=()):
    """Create an output table; return ``(catalog path, field mapping)``."""
    workspace, name = _arcio_prepare_output(out_path, inputs)
    name = _arcio_folder_name(workspace, name, ".dbf")
    result = arcpy.management.CreateTable(workspace, name)
    path = _arcio_created_path(result, workspace, workspace + "\\" + name)
    return path, _arcio_fields_or_delete(path, field_specs, workspace, inputs)


def _arcio_created_path(result, workspace, fallback):
    """Path of a dataset that Create Table / Create Feature Class just made.

    GeoPackage datasets are listed as ``<file>.gpkg\\main.<name>``, so for a GeoPackage the
    path the tool reports is used when it exists; everywhere else (and when the tool
    reports nothing usable) ``fallback`` (``workspace\\name``) is used, as before."""
    if not str(workspace).casefold().endswith(".gpkg"):
        return fallback
    try:
        reported = result.getOutput(0)
    except Exception:  # a result without a readable output keeps the old behaviour
        return fallback
    if isinstance(reported, str) and reported.strip() and arcpy.Exists(reported):
        return reported
    return fallback


def _arcio_fields_or_delete(path, field_specs, workspace, inputs):
    """``add_fields`` on a just-created output; if it fails, the empty output
    is deleted (never leave a half-built output behind) and the error raised."""
    try:
        return add_fields(path, field_specs, workspace)
    except Exception:
        try:
            safe_delete(path, inputs)
        except Exception:
            pass
        raise


def copy_for_output(in_path, out_path, field_specs, inputs=()):
    """Copy a layer/feature class (CopyFeatures) or table view (CopyRows) and add fields.

    ``in_path`` may be a layer: its selection and definition query are
    honoured. Feature inputs keep their geometry; tables are copied with
    CopyRows. The fields are added **outside** any edit session (schema
    changes inside one fail with ERROR 000496). ObjectIDs of the copy are
    new, so callers must match copied rows by attribute values, not by OID.
    Returns ``(catalog path, field mapping)``.
    """
    workspace, name = _arcio_prepare_output(out_path, inputs)
    desc = arcpy.da.Describe(in_path)
    is_features = "shapeType" in desc
    if is_features:
        path = _arcio_output_path(workspace, name)
        arcpy.management.CopyFeatures(in_path, path)
    else:
        path = workspace + "\\" + _arcio_folder_name(workspace, name, ".dbf")
        arcpy.management.CopyRows(in_path, path)
    return path, add_fields(path, field_specs, workspace)


def copy_features(in_path, out_path, inputs=()):
    """Copy features to a new output with ``arcpy.management.CopyFeatures``.

    Same output checks as ``create_feature_class`` (refuse input = output,
    respect ``overwriteOutput``, valid name). A layer input copies only its
    selected / definition-query features. Returns the output catalog path.
    Call it outside any edit session (it creates a dataset).
    """
    workspace, name = _arcio_prepare_output(out_path, inputs)
    path = _arcio_output_path(workspace, name)
    arcpy.management.CopyFeatures(in_path, path)
    return path


# Value written instead of None to a shapefile / dBASE field, by Describe field type.
# ArcGIS Pro refuses None there ("RuntimeError: The field is not nullable. [VALUE]",
# Pro session 1, S3); dates and other types are left as they are.
_ARCIO_FOLDER_DEFAULTS = {"SmallInteger": 0, "Integer": 0, "BigInteger": 0, "Single": 0.0,
                          "Double": 0.0, "String": ""}


def _arcio_folder_defaults(path, field_names):
    """``{index: default}`` for the fields of a folder output that cannot hold None."""
    if not is_folder_workspace(workspace_of(path)):
        return {}
    types = dict((f.name.casefold(), f.type) for f in arcpy.da.Describe(path)["fields"])
    out = {}
    for i, name in enumerate(field_names):
        default = _ARCIO_FOLDER_DEFAULTS.get(types.get(str(name).casefold()))
        if default is not None:
            out[i] = default
    return out


def insert_rows(path, field_names, rows, kind=None, wkid=None, null_fields=None):
    """Insert rows; return the number inserted.

    With ``kind`` each row is ``(core geometry, values)``; without it, ``values``. The
    geometry may also be an Esri JSON dict (passed to ``arcpy.AsShape`` as it is, so Z
    and M in it are kept).
    ``null_fields``: optional set; the names of ``field_names`` that received
    at least one ``None`` are added to it (see ``folder_null_number_warning``).
    In a folder output (shapefile / dBASE) a ``None`` number is written as 0 and
    a ``None`` text as ``""`` (the type default; ArcGIS Pro refuses None there),
    and the field is still added to ``null_fields`` so the tool warns once
    naming it.
    """
    field_names = list(field_names)
    tokens = (["SHAPE@"] if kind else []) + field_names
    defaults = _arcio_folder_defaults(path, field_names)
    count = 0
    with arcpy.da.InsertCursor(path, tokens) as cursor:
        for row in rows:
            if kind:
                geom, values = row
            else:
                geom, values = None, row
            values = list(values)
            if null_fields is not None:
                for name, value in zip(field_names, values):
                    if value is None:
                        null_fields.add(name)
            for i, default in defaults.items():
                if i < len(values) and values[i] is None:
                    values[i] = default
            if kind:
                data = geom if isinstance(geom, dict) else core_to_esri_json(kind, geom, wkid)
                shape = arcpy.AsShape(data, True) if data is not None else None
                cursor.insertRow([shape] + values)
            else:
                cursor.insertRow(values)
            count += 1
    return count


def insert_shaped_rows(path, field_names, rows, null_fields=None):
    """Insert rows whose geometry is an ``arcpy.Geometry`` taken from another dataset.

    Each row is ``(geometry or None, values)``; the geometry is written as it is (a
    true curve stays a curve), so the output must be a feature class of the same
    geometry type and coordinate system. ``null_fields`` and the handling of empty
    numbers in a shapefile / dBASE output are the same as in ``insert_rows``.
    Returns the number of rows inserted.
    """
    field_names = list(field_names)
    defaults = _arcio_folder_defaults(path, field_names)
    count = 0
    with arcpy.da.InsertCursor(path, ["SHAPE@"] + field_names) as cursor:
        for geom, values in rows:
            values = list(values)
            if null_fields is not None:
                for name, value in zip(field_names, values):
                    if value is None:
                        null_fields.add(name)
            for i, default in defaults.items():
                if i < len(values) and values[i] is None:
                    values[i] = default
            cursor.insertRow([geom] + values)
            count += 1
    return count


_ARCIO_NUMBER_TYPES = ("SHORT", "LONG", "BIGINTEGER", "FLOAT", "DOUBLE")


def folder_null_number_warning(path, field_specs, mapping, null_fields, note=""):
    """Warning text, or ``None``, for empty numbers written to a folder output.

    A shapefile or dBASE table cannot store an empty (null) number: Add Field
    documents that nulls are only supported in a geodatabase and that zeros
    are inserted for numeric fields. ``field_specs`` are the specs the output
    was created with, ``mapping`` their ``{name: actual name}`` and
    ``null_fields`` the actual names ``insert_rows`` saw ``None`` in.
    ``note`` (optional) is added to say what the 0 means for those fields.
    """
    if not null_fields or not is_folder_workspace(workspace_of(path)):
        return None
    names, texts = [], []
    for spec in field_specs:
        actual = mapping.get(spec["name"], spec["name"])
        if str(spec.get("type", "")).upper() in _ARCIO_NUMBER_TYPES and actual in null_fields:
            names.append(actual)
        elif str(spec.get("type", "")).upper() == "TEXT" and actual in null_fields:
            texts.append(actual)
    if not names and not texts:
        return None
    parts = []
    if names:
        parts.append("Field(s) {0} of '{1}' have empty values, but a shapefile or dBASE table "
                     "cannot store an empty number: they are stored as 0, so 0 there can also "
                     "mean 'empty'.".format(", ".join(names), path))
    if texts:
        parts.append("Field(s) {0} of '{1}' have empty values, stored as empty text (a "
                     "shapefile or dBASE table cannot store an empty value).".format(
                         ", ".join(texts), path))
    text = " ".join(parts)
    if note:
        text += " " + note.strip()
    return text + (" Write the output to a file geodatabase to keep empty values empty.")


def update_rows(path, field_names, changes, where=None, null_fields=None):
    """Apply ``{oid: {field: value}}``; only rows whose values change are written.

    Returns the number of rows updated. Call inside ``edit_session``.
    ``null_fields``: optional set; the names of ``field_names`` that are set to
    ``None`` in at least one row are added to it (see
    ``folder_null_number_warning``).
    """
    field_names = list(field_names)
    count = 0
    with arcpy.da.UpdateCursor(path, ["OID@"] + field_names, where_clause=where) as cursor:
        for row in cursor:
            change = changes.get(row[0])
            if not change:
                continue
            new = list(row)
            for i, name in enumerate(field_names):
                if name in change:
                    new[i + 1] = change[name]
                    if null_fields is not None and change[name] is None:
                        null_fields.add(name)
            if new != list(row):
                cursor.updateRow(new)
                count += 1
    return count


# --------------------------------------------------------------------------
# Delete, backup, edit session
# --------------------------------------------------------------------------

def safe_delete(path, inputs=()):
    """Delete ``path`` unless it is an input or an edit session is open."""
    if _ARCIO_EDIT_STATE["depth"] > 0:
        raise ToolError("Refusing to delete '{0}' while an edit session is open.".format(path),
                        "This is a bug in the tool: deletes must happen before or after editing.")
    refuse_if_same([path], inputs)
    if arcpy.Exists(path):
        arcpy.management.Delete(path)


def _arcio_name_keys(path):
    """Comparison keys of a path with and without a .shp/.dbf extension."""
    key = normalize_catalog_path(path)
    keys = set([key])
    if key.endswith((".shp", ".dbf")):
        keys.add(key[:-4])
    return keys


def backup_copy(path, avoid=()):
    """Copy ``path`` to ``<name>_backupN`` next to it; return the copy's path.

    ``N`` is the first number whose name neither exists nor is one of the
    paths in ``avoid`` (pass the run's output paths, so an output can never
    replace the backup). Raises ``ToolError`` if the copy fails, so callers
    stop before editing.
    """
    taken = set()
    for other in avoid:
        if other:
            taken |= _arcio_name_keys(other)
    workspace, name = split_catalog_path(path)
    stem, ext = name, ""
    if is_folder_workspace(workspace) and "." in name:
        stem, ext = name.rsplit(".", 1)
        ext = "." + ext
    number = 1
    while True:
        candidate = "{0}\\{1}_backup{2}{3}".format(workspace, stem, number, ext)
        if not arcpy.Exists(candidate) and not (_arcio_name_keys(candidate) & taken):
            break
        number += 1
    try:
        arcpy.management.Copy(path, candidate)
    except (arcpy.ExecuteError, RuntimeError, OSError) as exc:
        raise ToolError("The backup copy of '{0}' failed, so nothing was edited: {1}".format(
            path, exc), "Check free disk space and write permission, then run the tool again.")
    if not arcpy.Exists(candidate):
        raise ToolError("The backup copy '{0}' was not created, so nothing was edited.".format(
            candidate), "Check write permission on the workspace, then run the tool again.")
    return candidate


@contextlib.contextmanager
def edit_session(workspace):
    """One ``arcpy.da.Editor`` session with one operation; rollback on failure.

    On success the operation is stopped and edits saved; on any exception the
    operation is aborted, the session stopped without saving, and the
    exception re-raised. Deletes are refused while the session is open.
    """
    editor = arcpy.da.Editor(workspace)
    editor.startEditing(False, True)
    _ARCIO_EDIT_STATE["depth"] += 1
    try:
        editor.startOperation()
    except BaseException:
        _ARCIO_EDIT_STATE["depth"] -= 1
        editor.stopEditing(False)
        raise
    try:
        yield editor
    except BaseException:
        try:
            editor.abortOperation()
        finally:
            _ARCIO_EDIT_STATE["depth"] -= 1
            editor.stopEditing(False)
        raise
    committed = False
    try:
        editor.stopOperation()
        editor.stopEditing(True)
        committed = True
    finally:
        _ARCIO_EDIT_STATE["depth"] -= 1
        if not committed and editor.isEditing:
            try:
                editor.abortOperation()
            finally:
                editor.stopEditing(False)


# --------------------------------------------------------------------------
# Messages, progress, outputs, environment
# --------------------------------------------------------------------------

def flush_messages(collector):
    """Send a ``MessageCollector``'s messages to ArcGIS Pro and clear it."""
    for level, text in collector.items:
        if level == MESSAGE_ERROR:
            arcpy.AddError(text)
        elif level == MESSAGE_WARNING:
            arcpy.AddWarning(text)
        else:
            arcpy.AddMessage(text)
    collector.clear()


class Progress(object):
    """Step progressor that updates at most ~100 times."""

    def __init__(self, label, total):
        self.total = max(int(total), 0)
        self.step = max(1, self.total // 100)
        self.count = 0
        self._shown = 0
        if self.total > 0:
            arcpy.SetProgressor("step", label, 0, self.total, self.step)
        else:
            arcpy.SetProgressor("default", label)

    def tick(self, amount=1):
        self.count += amount
        if self.total and (self.count - self._shown >= self.step or self.count >= self.total):
            self._shown = self.count
            arcpy.SetProgressorPosition(min(self.count, self.total))

    def label(self, text):
        arcpy.SetProgressorLabel(text)

    def close(self):
        arcpy.ResetProgressor()


# Parameter data types that never name a dataset or file (keywords and the display
# names Pro may report); their values are not resolved with Describe.
_ARCIO_NON_DATA_TYPES = frozenset(t.casefold() for t in (
    "GPBoolean", "Boolean", "GPString", "String", "GPLong", "Long", "GPDouble", "Double",
    "Field", "GPSQLExpression", "SQL Expression", "GPLinearUnit", "Linear Unit",
    "GPDate", "Date", "GPValueTable", "Value Table", "GPCoordinateSystem",
    "Coordinate System", "GPSpatialReference", "Spatial Reference", "GPExtent", "Extent"))


def _arcio_is_data_parameter(param):
    kinds = param.datatype if isinstance(param.datatype, (list, tuple)) else [param.datatype]
    return any(str(k).casefold() not in _ARCIO_NON_DATA_TYPES for k in kinds)


def _arcio_parameter_inputs(parameters):
    """``(paths, joined)`` of every Input parameter value naming a dataset or file
    (multivalues split): each value as typed plus its catalog path (a layer -> its
    data source), and the names of the tables joined to each input layer."""
    params = parameters.values() if isinstance(parameters, dict) else parameters
    paths, joined = [], set()
    for param in params:
        if param.direction != "Input" or not _arcio_is_data_parameter(param):
            continue
        text = param.valueAsText
        if not text:
            continue
        for value in split_multivalue(text):
            paths.append(value)
            try:
                if arcpy.Exists(value):
                    desc = arcpy.da.Describe(value)
                    paths.append(desc["catalogPath"])
                    if "fields" in desc:
                        joined.update(joined_table_names([field_info(f) for f in desc["fields"]]))
            except Exception:  # an unreadable value is still compared as typed
                pass
    return paths, joined


def register_parameter_inputs(parameters):
    """Register every Input parameter value naming a dataset or file (multivalues
    split), as typed and resolved to its catalog path (a layer -> its data source),
    so no output or report of the run can replace it (rule 4; review D1/D2).
    The names of the tables joined to each input layer (qualified field names,
    ``paths.joined_table_names``) are registered too: a layer reports only its
    own table's path, so an output or report named like a joined table is
    refused in any workspace (re-review N1)."""
    paths, joined = _arcio_parameter_inputs(parameters)
    register_inputs(paths)
    register_joined_tables(joined)


def _arcio_inside(path, root):
    """True if ``path`` is ``root`` or lies inside it (normalised catalog paths)."""
    key = normalize_catalog_path(root)
    if not key:
        return False
    for candidate in (normalize_catalog_path(path), normalize_catalog_path(split_catalog_path(path)[0])):
        if candidate == key or candidate.startswith(key.rstrip("\\") + "\\"):
            return True
    return False


def refuse_existing_protected_output(param, protected_paths, scanned_workspaces=(),
                                     refuse_inside=False, joined=()):
    """``updateMessages`` check: set an error on an output parameter that would replace
    a protected dataset or file; return True if it did.

    ArcGIS Pro deletes an existing output before ``execute`` runs when overwriting is
    on, so a refusal in ``execute`` comes too late (Pro session 1, S2: a scanned
    dataset was lost). Only an error set during validation stops the run before the
    delete (a warning does not; ``_work/pro_logs/s2_probe.txt``). Refused:

    * the output is the same dataset as any protected path (``paths.same_dataset``);
    * the output lies inside a scanned workspace (``scanned_workspaces``) and already
      exists, or lies inside it at all when ``refuse_inside`` (decision D-015);
    * the output is named like a table joined to an input layer (``joined``).
    """
    out = param.valueAsText
    if not out or not str(out).strip():
        return False
    out = str(out).strip()
    reason = None
    for path in protected_paths or ():
        if path and same_dataset(out, path):
            reason = ("The output '{0}' is the same dataset as the input '{1}'; ArcGIS Pro would "
                      "delete it before the tool runs. Choose a different output name or "
                      "location.".format(out, path))
            break
    if reason is None:
        for root in scanned_workspaces or ():
            if root and _arcio_inside(out, root) and (refuse_inside or _arcio_existing_outputs(out)):
                reason = ("The output '{0}' is inside '{1}', which is being inventoried or "
                          "audited; an existing item of that name could be replaced. Write the "
                          "output outside the scanned workspace.".format(out, root))
                break
    if reason is None and joined:
        try:
            refuse_joined_table_outputs([out], joined)
        except ToolError as err:
            reason = str(err)
    if reason is None:
        return False
    param.setErrorMessage(reason)
    return True


# Keywords and the display names ArcGIS Pro reports in Parameter.datatype ("Table").
_ARCIO_FOLDER_OUTPUT_EXT = {"detable": ".dbf", "table": ".dbf", "defeatureclass": ".shp",
                            "feature class": ".shp"}


def add_folder_output_extensions(parameters):
    """``updateParameters`` helper: give an extension-less table / feature class output in a
    plain folder its ``.dbf`` / ``.shp``. ArcGIS Pro validates the output before the tool
    runs and takes ``folder\name`` for an INFO table (ERROR 000734 when the path has a
    space; Pro session 1, S3, ``_work/pro_logs/dbf_probe.txt``). Outputs that accept both
    kinds are left alone."""
    for param in parameters:
        if param.direction != "Output" or param.parameterType == "Derived":
            continue
        kinds = param.datatype if isinstance(param.datatype, (list, tuple)) else [param.datatype]
        exts = set(_ARCIO_FOLDER_OUTPUT_EXT.get(str(k).casefold()) for k in kinds)
        if len(exts) != 1 or None in exts:
            continue
        text = param.valueAsText
        if not text or not str(text).strip():
            continue
        workspace, name = split_catalog_path(str(text).strip())
        if workspace and "." not in name and is_folder_workspace(workspace):
            param.value = str(text).strip() + exts.pop()


def folder_output_extensions(update_parameters):
    """Decorator for a tool's ``updateParameters``: runs it, then
    ``add_folder_output_extensions``."""
    def wrapper(self, parameters):
        result = update_parameters(self, parameters)
        add_folder_output_extensions(parameters)
        return result
    wrapper.__name__ = update_parameters.__name__
    wrapper.__doc__ = update_parameters.__doc__
    return wrapper


def protected_outputs(scanned=(), refuse_inside=False):
    """Decorator for a tool's ``updateMessages``: after the tool's own checks, every
    Output parameter that is not derived is checked with
    ``refuse_existing_protected_output`` against every Input data parameter (as typed
    and resolved to its data source, plus joined tables). ``scanned`` names Input
    parameters whose workspaces the tool reads in full."""
    scanned = (scanned,) if isinstance(scanned, str) else tuple(scanned)

    def decorate(update_messages):
        def wrapper(self, parameters):
            result = update_messages(self, parameters)
            outputs = [p for p in parameters if p.direction == "Output"
                       and p.parameterType != "Derived" and p.valueAsText]
            if not outputs:
                return result
            paths, joined = _arcio_parameter_inputs(parameters)
            roots = []
            for param in parameters:
                if param.name in scanned and param.valueAsText:
                    roots.extend(split_multivalue(param.valueAsText))
            for param in outputs:
                refuse_existing_protected_output(param, paths, roots, refuse_inside, joined)
            return result
        wrapper.__name__ = update_messages.__name__
        wrapper.__doc__ = update_messages.__doc__
        return wrapper
    return decorate


def guarded_run(execute):
    """Decorator for a tool's ``execute``: for the length of the run every input
    parameter and every dataset the tool reads through this module
    (``describe_dataset``, ``read_*``, ``walk_workspace``, ``read_domains``) is
    registered, and ``create_table`` / ``create_feature_class`` /
    ``copy_for_output`` / ``check_output_path`` / ``safe_delete`` and the report
    checks refuse to replace any of them, even when the tool did not pass it in
    ``inputs`` (quality review D1/D2: a skipped shapefile input and a lookup table
    were overwritten)."""
    def wrapper(self, parameters, messages):
        begin_input_register()
        try:
            register_parameter_inputs(parameters)
            return execute(self, parameters, messages)
        finally:
            end_input_register()
    wrapper.__name__ = execute.__name__
    wrapper.__doc__ = execute.__doc__
    return wrapper


def set_derived_output(parameters, name, value):
    """Set a derived output parameter so the result is added to the map."""
    arcpy.SetParameterAsText(param_index(parameters, name), value)


def product_info():
    """``{"version": "3.3", "licence": "ArcView"}`` for messages and checks."""
    return {"version": arcpy.GetInstallInfo()["Version"], "licence": arcpy.ProductInfo()}


# ==========================================================================
# project/crs_inventory_core.py
# ==========================================================================
# Pure logic of Workspace and CRS Inventory.
#
# The tool adapter lists datasets with ``arcpy.da.Walk`` and describes each
# one; this core turns those plain records into output rows with flags and a
# per-container coordinate-system summary. No arcpy here.
#
# Item record (built by the tool)::
#
#     {"container": "C:\data\city.gdb", "dataset": "roads",
#      "catalog_path": "C:\data\city.gdb\roads", "data_type": "FeatureClass",
#      "shape_type": "Polyline", "has_z": False, "has_m": False,
#      "row_count": 12 or None, "sr": {"wkid", "name", "type"} or None,
#      "is_feature": True, "is_shapefile": False, "prj_exists": None,
#      "parent_sr": {"wkid", "name", "type"} or None,   # feature dataset SR
#      "error": None,          # describe failed (nothing is known)
#      "count_error": None}    # described, but the row count failed
#
# Coordinate system rules
# -----------------------
# * A feature class's system is **undefined** when it is missing, has no name,
#   or its type is neither ``Projected`` nor ``Geographic`` (Pro's "Unknown"
#   system has type ``Unknown``). The type decides: a Projected or Geographic
#   system whose *name* is ``unknown`` (GDAL/QGIS write custom ``.prj`` files as
#   ``PROJCS["unknown", ...]``) is **defined**. A system with WKID 0 but a name
#   and a real type (a custom ``.prj``) counts as **defined**; its WKID is
#   written as null.
# * Distinct systems are compared by WKID. Without a WKID they are compared by
#   case-folded name plus, when the tool could read them, the name and code of
#   the geographic system and the linear unit (name and metres per unit), so
#   two custom systems of one name on different datums or units are told apart.
#   Custom systems that share all of these but differ only in projection
#   parameters (central meridian, false easting, ...) are still compared as one,
#   and the same system with and without a WKID counts as two. Known alias WKIDs
#   of one system are compared as that system (``INV_WKID_ALIASES``: Web
#   Mercator 102100, 102113, 900913 and the deprecated EPSG 3785 -> 3857), so
#   data carrying an older code is not reported as a different system.
# * ``MISSING_PRJ`` is raised for a shapefile whose ``.prj`` file is absent and
#   whose system is undefined (a shapefile without ``.prj`` has no system).
# * ``EMPTY`` only when rows were counted and there are none.
# * ``FDS_MISMATCH``: a feature class whose defined system differs from the
#   defined system of its feature dataset.
# * ``NOTE``: why a dataset or folder is ``UNREADABLE`` (the error text), else
#   null, so the reason is kept in the table even when no report is written.
# * A dataset that was described but whose rows could not be counted
#   (``count_error`` in the item record) keeps every described value and its
#   coordinate-system evaluation, gets ``UNREADABLE`` and the NOTE
#   ``row count failed: <reason>``, and still counts in the summary.
# * ``MIXED_CRS`` (summary): a container holding two or more distinct
#   **defined** systems; undefined ones are counted separately.

INV_FLAGS = ("UNDEFINED_CRS", "MISSING_PRJ", "EMPTY", "FDS_MISMATCH", "UNREADABLE")
INV_SR_TYPES = ("Projected", "Geographic")
INV_UNKNOWN = "Unknown"
# Older / unofficial WKIDs of one coordinate system -> the code they are
# compared as. 102100 is Esri's code for WGS_1984_Web_Mercator_Auxiliary_Sphere
# (same name and definition as EPSG 3857); 102113 and 900913 are earlier codes
# of the same spherical Web Mercator; 3785 is the deprecated EPSG code of the
# same spherical Mercator (identical coordinates, a sphere-based datum label).
INV_WKID_ALIASES = {102100: 3857, 102113: 3857, 900913: 3857, 3785: 3857}


def inv_sr_is_defined(sr):
    """True if a plain SR dict describes a usable coordinate system.

    The type decides (Pro's undefined system has type ``Unknown``); a defined
    custom system may be *named* ``unknown`` (GDAL/QGIS ``.prj`` files), so the
    name only has to be present.
    """
    if not sr:
        return False
    name = sr.get("name")
    if name is None or str(name).strip() == "":
        return False
    return sr.get("type") in INV_SR_TYPES


# Optional keys of a plain SR dict that tell custom systems (no WKID) apart.
INV_CUSTOM_KEYS = ("gcs_name", "gcs_code", "linear_unit", "meters_per_unit")


def _inv_custom_parts(sr):
    parts = []
    for name in INV_CUSTOM_KEYS:
        value = sr.get(name)
        if value is None or value == "":
            continue
        if name == "meters_per_unit":
            value = repr(round(float(value), 12))
        elif name == "gcs_code":
            value = str(int(value))
        else:
            value = str(value).strip().casefold()
        parts.append("{0}={1}".format(name, value))
    return parts


def inv_sr_key(sr):
    """Comparison key of a defined system (``None`` when undefined).

    WKID (aliases folded) when there is one; otherwise the case-folded name
    plus the optional ``INV_CUSTOM_KEYS`` values the tool could read.
    """
    if not inv_sr_is_defined(sr):
        return None
    wkid = sr.get("wkid")
    if wkid:
        return "wkid:{0}".format(INV_WKID_ALIASES.get(int(wkid), int(wkid)))
    return "|".join(["name:" + str(sr.get("name")).strip().casefold()] + _inv_custom_parts(sr))


def inv_sr_label(sr):
    """Readable label such as ``GCS_WGS_1984 (4326)``; ``None`` when undefined.

    A custom system names its geographic system and unit, so two custom
    systems of one name stay distinguishable in the summary.
    """
    if not inv_sr_is_defined(sr):
        return None
    wkid = sr.get("wkid")
    if wkid:
        return "{0} ({1})".format(sr.get("name"), int(wkid))
    extra = [str(sr.get(k)) for k in ("gcs_name", "linear_unit") if sr.get(k)]
    if sr.get("meters_per_unit") is not None and sr.get("linear_unit"):
        extra[-1] = "{0} = {1:g} m".format(extra[-1], float(sr.get("meters_per_unit")))
    if extra:
        return "{0} (no WKID; {1})".format(sr.get("name"), ", ".join(extra))
    return "{0} (no WKID)".format(sr.get("name"))


def inventory_row(item, count_rows):
    """Output row (dict with the output field names) for one item record."""
    flags = []
    error = item.get("error")
    count_error = None if error else item.get("count_error")
    is_feature = bool(item.get("is_feature"))
    sr = item.get("sr") if is_feature else None
    defined = inv_sr_is_defined(sr)
    if error:
        flags.append("UNREADABLE")
        sr_type = None
    elif is_feature:
        sr_type = sr.get("type") if defined else INV_UNKNOWN
        if not defined:
            flags.append("UNDEFINED_CRS")
            if item.get("is_shapefile") and item.get("prj_exists") is False:
                flags.append("MISSING_PRJ")
    else:
        sr_type = None
    counted = count_rows and not error and not count_error
    row_count = item.get("row_count") if counted else None
    if counted and row_count == 0:
        flags.append("EMPTY")
    if count_error and count_rows:
        flags.append("UNREADABLE")
    parent = item.get("parent_sr")
    if is_feature and not error and defined and inv_sr_is_defined(parent) and \
            inv_sr_key(parent) != inv_sr_key(sr):
        flags.append("FDS_MISMATCH")
    flags = [f for f in INV_FLAGS if f in flags]
    wkid = sr.get("wkid") if (defined and sr.get("wkid")) else None
    if error:
        note = str(error)
    elif count_error and count_rows:
        note = "row count failed: {0}".format(count_error)
    else:
        note = None
    return {
        "CONTAINER": item.get("container"),
        "DATASET": item.get("dataset"),
        "CATALOG_PATH": item.get("catalog_path"),
        "DATA_TYPE": item.get("data_type"),
        "SHAPE_TYPE": item.get("shape_type") if is_feature and not error else None,
        "HAS_Z": (1 if item.get("has_z") else 0) if is_feature and not error else None,
        "HAS_M": (1 if item.get("has_m") else 0) if is_feature and not error else None,
        "ROW_COUNT": row_count,
        "SR_NAME": sr.get("name") if defined else None,
        "WKID": int(wkid) if wkid else None,
        "SR_TYPE": sr_type,
        "FLAGS": ",".join(flags) if flags else None,
        "NOTE": note,
        "_sr_key": inv_sr_key(sr) if is_feature and not error else None,
        "_sr_label": inv_sr_label(sr) if is_feature and not error else None,
        "_is_feature": is_feature,
        "_described": not error,
    }


INV_OUTPUT_FIELDS = ("CONTAINER", "DATASET", "CATALOG_PATH", "DATA_TYPE", "SHAPE_TYPE", "HAS_Z",
                     "HAS_M", "ROW_COUNT", "SR_NAME", "WKID", "SR_TYPE", "FLAGS",
                     "NOTE")


def inventory_rows(items, count_rows):
    """Rows for all items, sorted by container then dataset (natural order)."""
    rows = [inventory_row(item, count_rows) for item in items]
    rows.sort(key=lambda r: (natural_sort_key(r["CONTAINER"] or ""),
                             natural_sort_key(r["DATASET"] or ""),
                             natural_sort_key(r["CATALOG_PATH"] or "")))
    return rows


def container_summary(rows):
    """Per-container summary dicts, in natural container order.

    ``{"container", "datasets", "feature_classes", "crs" (labels, sorted),
    "crs_count", "undefined", "unreadable", "mixed"}``.
    """
    groups = {}
    order = []
    for row in rows:
        key = row["CONTAINER"] or ""
        if key not in groups:
            groups[key] = {"container": row["CONTAINER"], "datasets": 0, "feature_classes": 0,
                           "_crs": {}, "undefined": 0, "unreadable": 0}
            order.append(key)
        group = groups[key]
        flags = (row["FLAGS"] or "").split(",")
        if not row["DATASET"]:
            # An error row (a folder or input the search could not read) is not a dataset.
            if "UNREADABLE" in flags:
                group["unreadable"] += 1
            continue
        group["datasets"] += 1
        if "UNREADABLE" in flags:
            group["unreadable"] += 1
            # A dataset whose rows could not be counted was still described:
            # its system counts (only a failed describe leaves it out).
            if not row.get("_described"):
                continue
        if not row["_is_feature"]:
            continue
        group["feature_classes"] += 1
        if row["_sr_key"] is None:
            group["undefined"] += 1
        else:
            group["_crs"].setdefault(row["_sr_key"], row["_sr_label"])
    result = []
    for key in sorted(order, key=natural_sort_key):
        group = groups[key]
        labels = sorted(group.pop("_crs").values(), key=natural_sort_key)
        group["crs"] = labels
        group["crs_count"] = len(labels)
        group["mixed"] = len(labels) >= 2
        result.append(group)
    return result


def inventory_flag_counts(rows):
    """``{flag: number of rows carrying it}`` for every flag (0 included)."""
    counts = dict((f, 0) for f in INV_FLAGS)
    for row in rows:
        for flag in (row["FLAGS"] or "").split(","):
            if flag in counts:
                counts[flag] += 1
    return counts



def inv_output_inside_roots(out_path, roots):
    """First scanned root that contains the output location (or is the output), else ``None``.

    Decision D-015: an output inside a scanned folder or geodatabase is refused
    whatever ``overwriteOutput`` says, because it could replace an item of any
    type there (mosaic dataset, relationship class, topology, ...), not only the
    feature classes and tables the inventory lists.
    """
    out_key = normalize_catalog_path(out_path)
    parent_key = normalize_catalog_path(split_catalog_path(out_path)[0])
    for root in roots:
        key = normalize_catalog_path(root)
        if not key:
            continue
        for candidate in (out_key, parent_key):
            if candidate == key or candidate.startswith(key.rstrip("\\") + "\\"):
                return root
    return None


# ==========================================================================
# project/redact_core.py
# ==========================================================================
# Credential masking for every string the project toolbox writes (pure Python).
#
# One function, ``redact_credentials``, is applied to every output value,
# report cell, message and error text, so a secret that reaches a data source
# string, an exception or a lookup text is never written. Masked values become
# ``***``. Over-masking is preferred to leaking.
#
# Rules
# -----
# 1. URL user-info: ``scheme://user:password@host`` -> ``scheme://***@host``;
#    the user-info runs to the last ``@`` before the host's ``/``, ``?`` or
#    ``#`` (a raw ``@`` inside a password is masked too).
# 2. Query / fragment parameters of a URL (``scheme://...``): every value is
#    masked except those of a short allow-list of harmless request parameters
#    (``REDACT_SAFE_QUERY_NAMES``: OGC WMS/WMTS/WFS and ArcGIS REST names such
#    as ``service``, ``request``, ``layer``, ``format``, ``f``, ``where``), so
#    an API key under a name no rule knows (``tk``, ``app_code``, ``ak``,
#    ``passphrase``, ...) is never written. Outside a URL, query / fragment
#    parameters (``?``, ``&`` or ``#`` before the name) whose name is a
#    credential name (``redact_key_is_secret``) or contains ``auth`` are masked.
#    The value runs to the next ``&``, ``#`` or whitespace.
# 3. ``NAME=value`` pairs anywhere in the text whose name is a credential name
#    (pattern based, see ``redact_key_is_secret``; e.g. ``PASSWORD``,
#    ``ENCRYPTED_PASSWORD_UTF8``, ``PWD``, ``SECRET_KEY``,
#    ``AWS_SECRET_ACCESS_KEY``, ``AccountKey``, ``access_token``): the whole
#    value is masked. A quoted value (``"..."``, ``'...'``, ``{...}``) ends at
#    its closing quote; an unquoted value runs to the next ``;`` or ``,`` that
#    is followed by another ``NAME=`` pair, or to the end of the line, so
#    spaces, ``;`` and ``,`` inside a password are masked too. Values of other
#    names are never consumed, so a secret pair after them is still found.

REDACT_MASK = "***"

_REDACT_USERINFO = re.compile(r"(?i)\b([a-z][a-z0-9+.\-]*://)[^/?#\s]*@")
_REDACT_QUERY = re.compile(r"([?&#])([^=&#\s]+)=([^&#\s]*)")
_REDACT_URL = re.compile(r"(?i)\b[a-z][a-z0-9+.\-]*://[^\s]*")
_REDACT_NAME = re.compile(r"(?<![A-Za-z0-9_\-])([A-Za-z][A-Za-z0-9_\-]*)\s*=")
_REDACT_VALUE = re.compile(
    r"\s*(\"[^\"]*\"?|'[^']*'?|\{[^}]*\}?|[^\r\n]*?)"
    r"(?=[;,]\s*[A-Za-z_][A-Za-z0-9_ \-]*\s*=|[\r\n]|$)")
_REDACT_WORDS = re.compile(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|[0-9]+")
_REDACT_SUBSTRINGS = ("password", "passwd", "passphrase", "secret", "token", "credential",
                      "signature")
_REDACT_PARTS = frozenset(["pwd", "pw", "pass", "key", "sig", "sas", "apikey", "sharedkey",
                           "accountkey"])
# Exact names of API keys used by common tile / basemap services (Tianditu
# "tk", Baidu "ak", HERE legacy "app_code").
_REDACT_EXACT = frozenset(["tk", "ak", "app_code", "appcode"])
# Query parameters of a URL whose values are kept (case-insensitive); every
# other query value of a URL is masked. Over-masking is preferred to leaking.
REDACT_SAFE_QUERY_NAMES = frozenset([
    "service", "request", "version", "layer", "layers", "style", "styles", "format",
    "tilematrixset", "tilematrix", "tilerow", "tilecol", "crs", "srs", "bbox", "width",
    "height", "transparent", "bgcolor", "time", "elevation", "typename", "typenames",
    "outputformat", "maxfeatures", "count", "startindex", "srsname", "propertyname",
    "sortby", "featureid", "resourceid", "f", "where", "outfields", "returngeometry",
    "outsr", "insr", "spatialrel", "geometry", "geometrytype", "objectids", "dpi", "size",
    "imagesr", "bboxsr", "x", "y", "z", "lang", "language", "locale"])


def redact_key_is_secret(key):
    """True if a parameter / dictionary key names a credential.

    Pattern based, case-insensitive: the name contains ``password``,
    ``passwd``, ``secret``, ``token``, ``credential`` or ``signature``
    (``ENCRYPTED_PASSWORD_UTF8``, ``access_token``, ``X-Amz-Signature``), or one
    of its word parts (split at ``_``, ``-``, ``.`` and camelCase) is ``key``,
    ``sig``, ``sas``, ``pwd``, ``pw`` or ``pass`` (``SECRET_KEY``,
    ``AWS_SECRET_ACCESS_KEY``, ``apiKey``, ``AccountKey``, ``Key-Pair-Id``), or
    it ends in ``key`` (``apikey``, ``sharedkey``), or it is one of the tile
    service key names ``tk``, ``ak``, ``app_code``, ``appcode``; ``passphrase``
    is matched as a substring.
    """
    text = str(key)
    low = text.casefold()
    if low in _REDACT_EXACT:
        return True
    if any(part in low for part in _REDACT_SUBSTRINGS) or low.endswith("key"):
        return True
    return any(word.casefold() in _REDACT_PARTS for word in _REDACT_WORDS.findall(text))


def _redact_pairs(text):
    """Mask the value of every ``NAME=value`` pair whose name is a credential."""
    out, pos = [], 0
    for match in _REDACT_NAME.finditer(text):
        if match.start() < pos or not redact_key_is_secret(match.group(1)):
            continue
        value = _REDACT_VALUE.match(text, match.end())
        out.append(text[pos:match.end()])
        out.append(REDACT_MASK)
        pos = value.end()
    out.append(text[pos:])
    return "".join(out)


def redact_credentials(text):
    """``text`` with credentials masked; ``None`` stays ``None``, non-text is
    returned unchanged."""
    if text is None or not isinstance(text, str):
        return text
    # user-info runs to the LAST '@' of the authority (a raw '@' in a password)
    text = _REDACT_USERINFO.sub(lambda m: m.group(1) + REDACT_MASK + "@", text)
    # in a URL, only allow-listed query values are kept
    text = _REDACT_URL.sub(lambda u: _REDACT_QUERY.sub(
        lambda m: m.group(0) if m.group(2).casefold() in REDACT_SAFE_QUERY_NAMES
        else m.group(1) + m.group(2) + "=" + REDACT_MASK, u.group(0)), text)
    text = _REDACT_QUERY.sub(
        lambda m: m.group(1) + m.group(2) + "=" + REDACT_MASK
        if (redact_key_is_secret(m.group(2)) or "auth" in m.group(2).casefold())
        else m.group(0), text)
    return _redact_pairs(text)


def redact_props(props):
    """Deep copy of a connection-properties value with every credential masked."""
    if isinstance(props, dict):
        result = {}
        for key, value in props.items():
            if redact_key_is_secret(key):
                result[key] = REDACT_MASK if value not in (None, "") else value
            else:
                result[key] = redact_props(value)
        return result
    if isinstance(props, (list, tuple)):
        return [redact_props(v) for v in props]
    return redact_credentials(props)


def redact_rows(rows):
    """Rows (lists or dicts) with every text value passed through ``redact_credentials``."""
    result = []
    for row in rows:
        if isinstance(row, dict):
            result.append(dict((k, redact_credentials(v)) for k, v in row.items()))
        else:
            result.append([redact_credentials(v) for v in row])
    return result


# ==========================================================================
# project/crs_inventory_tool.py
# ==========================================================================
# Workspace and CRS Inventory: every feature class (and table) of folders and geodatabases, one table.

INV_TEXT_FIELDS = ("CONTAINER", "DATASET", "CATALOG_PATH", "DATA_TYPE", "SHAPE_TYPE", "SR_NAME",
                   "SR_TYPE", "FLAGS", "NOTE")
# ROW_COUNT is a DOUBLE: a LONG field holds at most 2,147,483,647, and a larger count made the insert
# fail after every dataset had been described. A DOUBLE stores every whole number up to 2**53 exactly.
INV_FIELD_TYPES = {"HAS_Z": "SHORT", "HAS_M": "SHORT", "ROW_COUNT": "DOUBLE", "WKID": "LONG"}

# One dataset that cannot be described or counted must never stop the inventory: whatever arcpy
# raises for it (RuntimeError, OSError, TypeError "'in_table' is not a table or a featureclass", an
# AttributeError of a damaged item, ...) becomes an UNREADABLE row with the error in NOTE. Only
# KeyboardInterrupt / SystemExit (not Exception subclasses) still stop the run.
INV_ITEM_ERRORS = (Exception,)


def inv_split_multivalue(text):
    """Values of a multivalue parameter given as geoprocessing text, quote-aware.

    Values are separated by ``;``. A value that starts with a single or double quote runs to the
    matching closing quote that is followed by ``;`` or the end of the text, so a folder named
    ``inv;2026`` written as ``'C:\\data\\inv;2026'`` stays one value; inside quotes the quote character
    written twice is one literal quote. A value that does not start with a quote is kept as written,
    so a folder whose name ends in a quote (``C:\\d\\Farmers'``) is not changed; a value whose
    opening quote is never closed is a plain value with its quotes stripped (the old behaviour)."""
    if not text:
        return []
    text = str(text)
    values = []
    n, i = len(text), 0
    while i < n:
        while i < n and text[i] in " \t":
            i += 1
        if i >= n:
            break
        if text[i] in "'\"":
            quote, j, buf, closed = text[i], i + 1, [], False
            while j < n:
                ch = text[j]
                if ch == quote:
                    if j + 1 < n and text[j + 1] == quote:
                        buf.append(quote)
                        j += 2
                        continue
                    k = j + 1
                    while k < n and text[k] in " \t":
                        k += 1
                    if k >= n or text[k] == ";":
                        closed = True
                        j = k
                        break
                buf.append(ch)
                j += 1
            if closed:
                value = "".join(buf).strip()
                if value:
                    values.append(value)
                i = j + 1
                continue
        end = text.find(";", i)
        if end < 0:
            end = n
        value = text[i:end].strip()
        if value[:1] in ("'", '"'):
            # an unclosed opening quote: the old behaviour (quotes around the value stripped)
            value = value.strip("'\"")
        # A plain value is kept as written: Windows allows a folder name that ENDS in a quote
        # (C:\\d\\Farmers'), and stripping it named a folder that does not exist.
        if value:
            values.append(value)
        i = end + 1
    return values


def _inv_roots(param):
    """Input folders/geodatabases of the in_workspaces parameter (quote-aware split)."""
    return inv_split_multivalue(param_text(param))


def _inv_sr_dict(sr):
    """Plain dict of a SpatialReference.

    For a custom system (no WKID) the geographic system and the linear unit
    are added, so two custom systems of one name are not compared as one
    (``inv_sr_key``). Projected-only members are read only for a Projected
    system (audit: linearUnitName / metersPerUnit are documented for projected
    systems only); a member that cannot be read is left out.
    """
    if sr is None:
        return None
    info = {"wkid": sr.factoryCode or None, "name": sr.name, "type": sr.type}
    if info["wkid"] or info["type"] not in ("Projected", "Geographic"):
        return info
    getters = [("gcs_code", lambda: sr.GCS.GCSCode)]
    if info["type"] == "Projected":
        getters += [("gcs_name", lambda: sr.GCS.name),
                    ("linear_unit", lambda: sr.linearUnitName),
                    ("meters_per_unit", lambda: sr.metersPerUnit)]
    for key, getter in getters:
        try:
            value = getter()
        except (AttributeError, RuntimeError, ValueError, TypeError, NotImplementedError):
            continue
        if value not in (None, "", 0):
            info[key] = value
    return info


def _inv_connection_files(root, recursive):
    """``.sde`` connection files in the scanned folders of a folder root.

    The tool calls ``arcpy.da.Walk`` with ``followlinks=False`` (common.arcio), so
    connection files found in a folder are not followed and these databases are not
    inventoried; the tool names them in a message.
    Geodatabase folders are not entered. Read errors are ignored (the Walk
    reports unreadable folders).
    """
    root = str(root)
    if not os.path.isdir(root) or not is_folder_workspace(root):
        return []
    found = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if is_folder_workspace(d)) if recursive else []
        found.extend(os.path.join(dirpath, f) for f in sorted(filenames)
                     if f.casefold().endswith(".sde"))
    return found


# File types that a folder search does not list in ArcGIS Pro (REPORTED for GeoPackage: a folder
# with a GeoPackage and two GeoTIFFs listed 0 datasets) or may not open at all. A mobile
# geodatabase (.geodatabase) is listed too; Pro 3.3.2's folder search DOES enter it (REPORTED: it
# listed main.pts), so a file under which the search listed datasets is never named (see
# _run). A .json file counts only when its first bytes look like GeoJSON (_inv_looks_like_geojson):
# plain JSON is not a dataset.
INV_UNWALKED_SUFFIXES = (".gpkg", ".geojson", ".sqlite", ".kml", ".kmz", ".gml", ".geodatabase")
INV_GEOJSON_HEAD = 65536


INV_GEOJSON_GEOMETRIES = ("Point", "MultiPoint", "LineString", "MultiLineString", "Polygon",
                          "MultiPolygon")


INV_GEOJSON_MEMBER = {"FeatureCollection": "features", "Feature": "geometry",
                      "GeometryCollection": "geometries"}
INV_GEOJSON_MEMBER.update((name, "coordinates") for name in INV_GEOJSON_GEOMETRIES)
_INV_JSON_TOKEN = re.compile(r'"(?:[^"\\]|\\.)*"?|[{}\[\]:,]|[^\s{}\[\]:,"]+')


def _inv_json_outline(text):
    """Outline of the start of a JSON text: ``(top_keys, strings, complete)``.

    ``top_keys`` is the set of member names of the top-level object (empty when the text is not an
    object), ``strings`` maps the path of each string value at most three levels deep (member names
    and array indexes, for example ``("features", 0, "type")``) to its value (first occurrence), and
    ``complete`` is True when the top-level value ended inside ``text``. The text may be cut off
    anywhere (the first bytes of a large file); nothing past the cut is guessed."""
    text = text.lstrip("\ufeff \t\r\n")
    top_keys, strings = set(), {}
    if not text.startswith("{"):
        return top_keys, strings, False
    stack = []          # frames: [kind, key or index, state]

    def decode(token):
        try:
            return json.loads(token)
        except ValueError:
            return None     # a string cut off by the end of the text

    def value_seen(value):
        if stack:
            frame = stack[-1]
            if isinstance(value, str) and len(stack) <= 3:
                path = tuple(f[1] for f in stack)
                strings.setdefault(path, value)
            frame[2] = "comma"

    for match in _INV_JSON_TOKEN.finditer(text):
        token = match.group(0)
        if token in "{[":
            if stack and stack[-1][2] not in ("value",):
                return top_keys, strings, False     # not JSON
            stack.append(["obj", None, "key"] if token == "{" else ["arr", 0, "value"])
        elif token in "}]":
            if not stack:
                return top_keys, strings, False
            stack.pop()
            if not stack:
                return top_keys, strings, True
            stack[-1][2] = "comma"
        elif token == ":":
            if stack and stack[-1][0] == "obj" and stack[-1][2] == "colon":
                stack[-1][2] = "value"
        elif token == ",":
            if stack and stack[-1][0] == "obj":
                stack[-1][1], stack[-1][2] = None, "key"
            elif stack:
                stack[-1][1] += 1
                stack[-1][2] = "value"
        elif not stack:
            return top_keys, strings, False
        elif token.startswith('"'):
            value = decode(token)
            frame = stack[-1]
            if frame[0] == "obj" and frame[2] == "key":
                if value is None:
                    break
                frame[1], frame[2] = value, "colon"
                if len(stack) == 1:
                    top_keys.add(value)
            elif value is None:
                break
            else:
                value_seen(value)
        else:
            value_seen(None)
    return top_keys, strings, False


def inv_json_is_geojson(text):
    """True when the start of a JSON text is a GeoJSON object (RFC 7946).

    Only the TOP-LEVEL object counts: its ``"type"`` must be FeatureCollection (with
    ``"features"``), Feature (with ``"geometry"``), GeometryCollection (with ``"geometries"``) or a
    geometry type (with ``"coordinates"``). GeoJSON embedded deeper, as in a map style file or a
    settings file, does not make the file GeoJSON. When the text is cut off before the top-level
    ``"type"`` (JSON members can come in any order), a first feature of type Feature under a
    top-level ``"features"`` member, or a geometry under a top-level ``"geometry"`` member, counts."""
    top_keys, strings, complete = _inv_json_outline(text)
    kind = strings.get(("type",))
    if kind is not None:
        member = INV_GEOJSON_MEMBER.get(kind)
        return bool(member) and (member in top_keys or not complete)
    if complete or "type" in top_keys:
        return False
    if "features" in top_keys and strings.get(("features", 0, "type")) == "Feature":
        return True
    if "geometry" in top_keys and strings.get(("geometry", "type")) in INV_GEOJSON_MEMBER and \
            strings.get(("geometry", "type")) not in ("FeatureCollection", "Feature"):
        return True
    return False


def _inv_looks_like_geojson(path):
    """True when the first bytes of a ``.json`` file are a GeoJSON object (``inv_json_is_geojson``).
    Unreadable files count as not GeoJSON."""
    try:
        with open(path, "rb") as handle:
            head = handle.read(INV_GEOJSON_HEAD)
    except (OSError, IOError):
        return False
    return inv_json_is_geojson(head.decode("utf-8", "ignore"))


def _inv_unwalked_files(root, recursive):
    """GeoPackage, GeoJSON, SQLite, KML, GML and mobile geodatabase files in the scanned folders
    of a folder root.

    A folder search lists none of their layers, so the run names them in a message instead
    of leaving them out silently. Geodatabase folders are not entered.
    """
    root = str(root)
    if not os.path.isdir(root) or not is_folder_workspace(root):
        return []
    found = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if is_folder_workspace(d)) if recursive else []
        for name in sorted(filenames):
            low = name.casefold()
            full = os.path.join(dirpath, name)
            if low.endswith(INV_UNWALKED_SUFFIXES) or (
                    low.endswith(".json") and _inv_looks_like_geojson(full)):
                found.append(full)
    return found


def _inv_file_database_kind(text):
    """``"gpkg"`` or ``"mobile"`` when ``text`` (the text of a nameless Walk error) is the path of a
    GeoPackage or a mobile geodatabase, else None.

    Pro 3.3.2 raises a nameless error in its table search for every GeoPackage given as an
    input; the text is the path of the ``.gpkg`` (REPORTED from a Pro run). It does the same
    for a mobile geodatabase (``.geodatabase``), whose feature classes are still listed
    (REPORTED from a Pro run)."""
    path = str(text).strip().strip("'\"").rstrip("\\/").casefold()
    if path.endswith(".gpkg"):
        return "gpkg"
    if path.endswith(".geodatabase"):
        return "mobile"
    return None



def _inv_is_feature_dataset(text):
    """True when ``text`` (the text of a Walk error) is the path of a feature dataset.

    Pro 3.3.2 raises a nameless error for every feature dataset in its search for tables
    (REPORTED from Pro runs); the text of the error is the path of the feature dataset.
    Anything that cannot be described counts as "not a feature dataset"."""
    path = str(text).strip().strip("'\"")
    if not path:
        return False
    try:
        return arcpy.da.Describe(path)["dataType"] == "FeatureDataset"
    except INV_ITEM_ERRORS:
        return False


# The Walk keywords of the inventory, each run on its own (``_inv_walk_root``).
INV_WALK_DATATYPES = ("FeatureClass", "Table")


def _inv_walk_root(root, recursive):
    """Feature classes and tables of one input, like ``walk_workspace(root, INV_WALK_DATATYPES)``,
    but a failure never stops the inventory of the other inputs.

    ``common.arcio.walk_workspace`` turns only RuntimeError/OSError of ``arcpy.da.Walk`` into an
    error entry; anything else (UnicodeDecodeError, ValueError, TypeError, ...) stopped the whole
    run. Each keyword is walked on its own, so a failure of one keyword keeps what the other
    listed, and any Exception becomes an error entry for the input (an UNREADABLE row with the
    class and the text of the error). A missing input (ToolError) still stops the run with its
    message, and KeyboardInterrupt/SystemExit are not caught."""
    items, errors, seen = [], [], set()
    for datatype in INV_WALK_DATATYPES:
        try:
            found = walk_workspace(root, (datatype,), recursive=recursive)
        except ToolError:
            raise
        except INV_ITEM_ERRORS as exc:
            suffix = ("(while listing the {0} items of this input; the datasets it holds may be "
                      "missing from the inventory)".format(datatype))
            # The raw parts are kept, so the error text alone is masked when it is written
            # (``inv_walk_error_text``) and the fixed explanation after it is never cut.
            errors.append({"path": str(root), "datatype": datatype,
                           "message": "{0}: {1} {2}".format(type(exc).__name__, exc, suffix),
                           "parts": (type(exc).__name__, str(exc), suffix)})
            continue
        for item in found["items"]:
            key = normalize_catalog_path(item["path"])
            if key not in seen:
                seen.add(key)
                items.append(item)
        tail = " ({0})".format(datatype)
        for err in found["errors"]:
            text = str(err.get("message") or "")
            if err.get("datatype") in (None, datatype) and err.get("path") == str(root) and \
                    text.endswith(tail) and not err.get("parts"):
                # Review R13-1: ``walk_workspace`` records a RuntimeError/OSError that stops
                # ``arcpy.da.Walk`` itself as ``{"path": root, "message": "<text> (<datatype>)"}``,
                # with no ``datatype`` key (a proposed shared patch adds it; both forms are read).
                # Only one datatype is walked per call, so it is this one; the entry gets the key
                # (so Include Tables off makes it an information line) and the same explanation
                # as the error entries made above.
                if text.endswith(tail):
                    text = text[:-len(tail)]
                suffix = ("(while listing the {0} items of this input; the datasets it holds may "
                          "be missing from the inventory)".format(datatype))
                err = {"path": str(root), "datatype": datatype,
                       "message": "{0} {1}".format(text, suffix), "parts": ("", text, suffix)}
            errors.append(err)
    items.sort(key=lambda item: normalize_catalog_path(item["path"]))
    return {"items": items, "errors": errors}


def _inv_side_files(finder, root, recursive, collector, masker=None):
    """Paths found by ``finder`` (connection files, files a folder search does not list) for one
    input; a failure there only costs that note (an information line), never the run."""
    try:
        return finder(root, recursive)
    except INV_ITEM_ERRORS as exc:
        masker = masker or InvPathMasker()
        masker.path(str(root))
        # Bound now: Python deletes ``exc`` when the except block ends, and the message is made
        # later (at flush), so the lambda must not refer to it.
        kind, detail, where = type(exc).__name__, str(exc), str(root)
        _inv_say(collector, MESSAGE_INFO, lambda: (
            "The extra file check of '{0}' could not finish ({1}: {2}); connection "
            "files or GeoPackage/GeoJSON files there may not be named.".format(
                masker.finish(where), kind, masker.text(detail))))
        return []


INV_LIST_LIMIT = 20

# Dialog errors (updateMessages) for an output inside a scanned folder or geodatabase (decision
# D-015, review R11-1). An error stops ArcGIS Pro before it deletes an existing output of that name.
INV_INSIDE_TABLE_ERROR = (
    "The output table is inside a folder or geodatabase being inventoried, so the tool cannot run "
    "with it: an existing item of that name there could be replaced. Choose a location outside "
    "every input folder and geodatabase.")
INV_INSIDE_REPORT_ERROR = (
    "The report is inside a folder being inventoried, so the tool cannot run with it: a file "
    "there could be replaced. Choose a folder outside every input folder.")


def inv_walk_error_text(err, masker):
    """The text of a Walk error entry, each inserted part masked once: the error text by
    ``masker.text`` and, for an error without a file name, the input path by ``masker.finish``.
    The fixed text around them is never masked."""
    parts = err.get("parts")
    if parts:
        # An empty class name: an error ``walk_workspace`` caught and recorded as text only.
        text = "{0}{1} {2}".format(parts[0] + ": " if parts[0] else "", masker.text(parts[1]),
                                   parts[2])
    else:
        text = masker.text(err["message"])
    if err.get("unnamed"):
        text = "{0} (while reading '{1}'; Walk datatype {2})".format(
            text, masker.finish(err["path"]),
            ", ".join(str(d) for d in err.get("datatypes") or () if d) or "unknown")
    for other in err.get("more") or ():
        text += " | " + inv_walk_error_text(other, masker)
    return text


def inv_path_lines(paths, masker, limit=INV_LIST_LIMIT):
    """``paths`` for a message: one masked path per line (each masked once, name by name), at
    most ``limit`` of them, then a line saying how many more there are. One path per line, so a
    credential-like name can never hide the paths after it (review R10-2)."""
    lines = ["  " + masker.finish(path) for path in paths[:limit]]
    if len(paths) > limit:
        lines.append("  ... and {0} more".format(len(paths) - limit))
    return "\n".join(lines)


INV_PATH_FIELDS = ("CONTAINER", "DATASET", "CATALOG_PATH")
INV_MASKED_NOTE = ("Path masked: a folder or file name in it looks like a credential (NAME=value), so "
                   "the value after '=' in that name is written as *** (numbered ***(1), ***(2), ... "
                   "when different names would read the same); this path cannot be opened as written.")
_INV_PATH_SPLIT = re.compile(r"([\\/])")
# Fixed text: it holds no NAME=value example (review R10-2: "such as monkey=..." was itself masked).
INV_MASKED_WARNING = (
    "{0} row(s) have a CONTAINER, DATASET or CATALOG_PATH in which a folder or file name looks "
    "like a credential (a name such as pass, key, sig, token or password, or any name ending in "
    "'key' such as monkey, followed by '=' and a value): the value after '=' is written as *** "
    "there, so that path is no longer a valid path. The NOTE field of those rows says so; find "
    "the item in the Catalog pane, or rename the folder.")


class InvPathMasker(object):
    """Masks credential-looking names in paths ONE folder or file name at a time.

    ``redact_credentials`` on a whole path masks from ``NAME=`` to the end of the text, so
    ``C:\\inv\\key=north\\roads.shp`` lost ``roads.shp`` and two different files gave identical
    rows. Here each name between ``\\`` or ``/`` is masked on its own (``key=***``), the rest of the
    path is kept, and when two different names of one run mask to the same text they are numbered
    in order of first appearance (``key=***(1)``, ``key=***(2)``), so different paths stay
    different without writing any part of the masked value."""

    def __init__(self):
        self._seen = {}      # masked name -> {original name: ordinal}
        self._paths = {}     # every whole path seen (ordered; used by ``text``)

    def name(self, part):
        masked = redact_credentials(part)
        if masked == part:
            return part
        originals = self._seen.setdefault(masked, {})
        originals.setdefault(part, len(originals) + 1)
        return masked

    def path(self, text):
        if text is None or not isinstance(text, str):
            return text
        self._paths.setdefault(text, None)
        parts = _INV_PATH_SPLIT.split(text)
        for k in range(0, len(parts), 2):
            parts[k] = self.name(parts[k])
        return "".join(parts)

    def finish(self, text):
        """``text`` (an unmasked path already seen by ``path``) masked, with ordinals added."""
        if text is None or not isinstance(text, str):
            return text
        parts = _INV_PATH_SPLIT.split(text)
        for k in range(0, len(parts), 2):
            masked = self.name(parts[k])
            originals = self._seen.get(masked) if masked != parts[k] else None
            if originals and len(originals) > 1:
                masked = "{0}({1})".format(masked, originals[parts[k]])
            parts[k] = masked
        if text not in self._paths:
            self._paths[text] = None
        return "".join(parts)

    def text(self, text):
        """Free text (an arcpy or Python error text, a message of shared code) masked ONCE.

        A registered path (seen by ``path`` or ``finish``) that the text holds is masked name by
        name, so the mask stops at the end of the credential value (the end of that folder or
        file name) and the rest of the path and of the text is kept. Everything else is masked
        by ``redact_credentials``, whose unquoted value ends at the end of its line: the mask can
        cover at most the rest of that line of THIS text, never fixed text the tool adds around
        it. A registered path is matched only where it ends at the end of the text, a ``\\`` or
        ``/``, a quote or a line break, so a shorter path never matches inside a longer name
        (``pass=1`` inside ``pass=10``)."""
        if text is None or not isinstance(text, str) or not text:
            return text
        found = [p for p in self._paths if p and p in text and self.finish(p) != p]
        found.sort(key=len, reverse=True)
        holes = {}
        for k, raw in enumerate(found):
            hole = "\x00{0}\x00".format(k)
            pattern = re.compile(re.escape(raw) + r"(?=$|[\\/'\"\r\n])")
            text, n = pattern.subn(lambda _m, h=hole: h, text)
            if n:
                holes[hole] = self.finish(raw)
        text = redact_credentials(text)
        for hole, masked in holes.items():
            text = text.replace(hole, masked)
        return text.replace("\x00", "")


def inv_mask_rows(rows, masker=None, paths=(), masked_fields=()):
    """``(masked_rows, n)``: rows with credentials masked and the number of rows whose CONTAINER,
    DATASET or CATALOG_PATH the mask changed.

    Credential masking applies to paths too (over-masking is preferred to leaking: a file named
    ``conn_password=Secret99.shp`` must not write ``Secret99``), so a real folder named
    ``monkey=island``, ``pass=2`` or ``sig=final`` comes out as ``monkey=***``. Path fields are
    masked one folder or file name at a time (``InvPathMasker``): the rest of the path is kept and
    different paths stay different. Every other text field is masked as a whole
    (``redact_credentials``). Such a row is never rewritten silently: ``INV_MASKED_NOTE`` is added
    to its NOTE and the run warns. ``paths``: further unmasked paths (for example the containers
    of the summary) that must be numbered consistently with the rows; pass the same ``masker``
    to ``finish`` them. ``masked_fields``: fields whose text was already masked where it was made
    (the NOTE of the tool, built from masked error texts and masked paths); they are kept as they
    are, because masking a masked text again cuts it after its first ``NAME=***`` (review R10-1)."""
    masker = masker or InvPathMasker()
    for row in rows:
        for k in INV_PATH_FIELDS:
            masker.path(row.get(k))
    for text in paths:
        masker.path(text)
    result, changed = [], 0
    for row in rows:
        new = dict((k, masker.finish(v) if k in INV_PATH_FIELDS else
                    v if k in masked_fields else redact_credentials(v))
                   for k, v in row.items())
        if any(new.get(k) != row.get(k) for k in INV_PATH_FIELDS):
            changed += 1
            new["NOTE"] = INV_MASKED_NOTE if not new.get("NOTE") else \
                new["NOTE"] + " | " + INV_MASKED_NOTE
        result.append(new)
    return result, changed


def _inv_refusal(cause, fix):
    """A ToolError whose paths were masked where they were inserted (``InvPathMasker.finish``)."""
    err = ToolError(cause, fix)
    err.inv_masked = True
    return err


def inv_error_text(err, masker):
    """The text of a ToolError for ``arcpy.AddError``, masked once.

    A refusal of this tool (``_inv_refusal``) already holds masked paths and is sent as it is. A
    ToolError of shared code (a missing input, an output check) holds raw paths: its cause and its
    fix are each masked on their own by ``masker.text``, so a credential in the cause never hides
    the fix."""
    if getattr(err, "inv_masked", False):
        return str(err)
    cause = masker.text(str(err.cause))
    fix = masker.text(str(err.fix)) if err.fix else None
    return "{0} Fix: {1}".format(cause, fix) if fix else cause


def _inv_register_params(masker, p):
    """Register the inputs and outputs with ``masker`` (after every path the run already used, so
    its numbering is kept), for an error text of shared code or arcpy that names them."""
    for path in _inv_roots(p["in_workspaces"]) + [param_text(p["out_table"]),
                                                  param_text(p["out_report"])]:
        if path:
            masker.path(path)


def _inv_say(collector, level, make):
    """Queue a message whose text is made only when the messages are sent (``_inv_flush``).

    ``make`` builds the text with every path in it masked by the run's ``InvPathMasker`` at the
    place where the path is inserted (and every arcpy/Python error text masked by its ``text``),
    so it is built once all paths of the run are known and the numbering ``***(1)``/``***(2)`` is
    the same as in the table and the report."""
    collector.items.append((level, make))


def _inv_flush(collector):
    """Send the messages. Each path or error text was masked ONCE where it was put into its
    message (review R10-1/R10-2): the composed message is never masked again, because the
    line mask of ``redact_credentials`` runs from the first ``NAME=`` to the end of the line and
    cut every later path and the advice after it."""
    collector.items = [(level, text() if callable(text) else text)
                       for level, text in collector.items]
    flush_messages(collector)


def _inv_count_rows(path):
    """Number of rows of ``path``.

    Counted with a cursor on ``OID@``. A table or view without an ObjectID (for example an
    unregistered database view) cannot give ``OID@``; then the rows are counted with a cursor on
    all fields (``"*"``), and only when that fails too does the original error count as a failed
    row count."""
    try:
        return _inv_count_with(path, ["OID@"])
    except INV_ITEM_ERRORS as first:
        try:
            return _inv_count_with(path, "*")
        except INV_ITEM_ERRORS:
            raise first


def _inv_count_with(path, fields):
    count = 0
    with arcpy.da.SearchCursor(path, fields) as cursor:
        for _row in cursor:
            count += 1
    return count


def inv_is_dbase_output(out):
    """True if the output table would be a dBASE table (in a plain folder).

    dBASE fields cannot hold nulls (Add Field: null values "are only supported
    for fields in a geodatabase"; numeric fields get zeros), so an uncounted
    ROW_COUNT, the WKID of a custom system and HAS_Z/HAS_M of a table would all
    read as 0, and CATALOG_PATH can exceed the 254 characters of a dBASE text
    field.
    """
    workspace = workspace_of(out) if out else ""
    return bool(workspace) and is_folder_workspace(workspace)


INV_DBASE_FIX = ("Write the inventory table to a file geodatabase (for example "
                 "C:\\work\\audit.gdb\\crs_inventory).")


def _inv_dbase_message(out):
    return ("'{0}' is in a folder, so it would be a dBASE table. dBASE fields cannot be "
            "empty (null): ROW_COUNT when rows are not counted, the WKID of a custom system "
            "and HAS_Z/HAS_M of a table would read as 0, which looks like real values (0 rows "
            "looks EMPTY).".format(out))


class WorkspaceCrsInventory(object):
    """List every feature class (and optionally table) with its coordinate system."""

    DOC = {
        "summary": "Lists every feature class (and optionally every table) in one or more "
                   "folders and geodatabases in one table: data type, shape type, Z/M, row "
                   "count, coordinate system name, WKID and type, with flags for undefined "
                   "coordinate systems, shapefiles without a .prj file, empty datasets, feature "
                   "classes whose system differs from their feature dataset (an abnormal state), and "
                   "datasets that "
                   "cannot be read. The report summarises the distinct coordinate systems of "
                   "each folder or geodatabase and marks containers with mixed systems.",
        "usage": "The tool is read-only: it changes no data and it projects or defines "
                 "nothing (opening a geodatabase makes ArcGIS Pro add small internal files). "
                 "Its inputs are folders and geodatabases, not layers.\n\n"
                 "Folders are searched with arcpy.da.Walk. Rasters are listed in the report as "
                 "skipped. Connection files (.sde) found inside a scanned folder are not "
                 "followed. A GeoPackage, GeoJSON, SQLite, KML, GML or mobile geodatabase file "
                 "in a scanned folder whose content the search does not list is named in a "
                 "warning (in ArcGIS Pro 3.3.2 the search did list a mobile geodatabase). Add the "
                 ".sde, .gpkg or .geodatabase file itself as an input.\n\n"
                 "Flags: UNDEFINED_CRS (system Unknown), MISSING_PRJ (shapefile without a .prj "
                 "file), EMPTY (no rows; needs Count Rows), FDS_MISMATCH (abnormal state) and "
                 "UNREADABLE (the reason is in NOTE; the run goes on). The report marks "
                 "MIXED_CRS for a folder or geodatabase that holds two or more different "
                 "defined systems. Systems are compared by WKID (102100, 102113, 900913 and "
                 "3785 count as 3857). Custom systems are compared by name and what ArcGIS "
                 "reports of them, so differences only in projection parameters are not told "
                 "apart.\n\n"
                 "The output table and the report must be outside every scanned folder, and "
                 "the output must be a geodatabase table (dBASE is refused). The tool does not "
                 "poll for Cancel.\n\n"
                 "Not verified: a Basic licence and enterprise geodatabases. Details, test "
                 "status and limits are on the documentation page.",
        "params": {
            "in_workspaces": "Folders and/or geodatabases to inventory.",
            "recursive": "Search sub-folders of the chosen folders (default on).",
            "include_tables": "Also list stand-alone tables (default off).",
            "count_rows": "Count the rows of every dataset (default off; slow on large "
                          "enterprise data).",
            "out_table": "New geodatabase table with one row per dataset (NOTE holds the "
                         "reason of an UNREADABLE row).",
            "out_report": "Optional Excel (.xlsx) or CSV report: Summary sheet per folder or "
                          "geodatabase (distinct coordinate systems, MIXED_CRS) and Detail sheet "
                          "with every dataset. It must be outside the folders being "
                          "inventoried.",
            "flag_count": "Number of datasets with at least one flag (derived).",
        },
        "tags": ["inventory", "coordinate system", "projection", "spatial reference", "audit",
                 "workspace", "catalog"],
    }

    def __init__(self):
        self.label = "Workspace and CRS Inventory"
        self.description = ("Lists every feature class (and optionally every table) of folders and "
                            "geodatabases with its coordinate system and flags undefined or mixed "
                            "systems (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_workspaces", "Input Folders or Geodatabases",
                       ["DEWorkspace", "DEFolder"], multi_value=True),
            make_param("recursive", "Search Sub-folders", "GPBoolean", required=False,
                       default=True),
            make_param("include_tables", "Include Tables", "GPBoolean", required=False,
                       default=False),
            make_param("count_rows", "Count Rows", "GPBoolean", required=False, default=False),
            make_param("out_table", "Output Inventory Table", "DETable", direction="Output"),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            make_param("flag_count", "Flagged Datasets", "GPLong", required="Derived"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs(scanned="in_workspaces", refuse_inside=True)
    def updateMessages(self, parameters):
        p = param_map(parameters)
        roots = _inv_roots(p["in_workspaces"])
        out = param_text(p["out_table"])
        if out and inv_output_inside_roots(out, roots):
            # An ERROR, not a warning (review R11-1): with overwriting on, ArcGIS Pro deletes an
            # existing output before execute runs, and only a validation error prevents that. The
            # shared protected_outputs check sets its own error for this case, but it splits the
            # folder list with common.params.split_multivalue, which strips a quote that ENDS a
            # folder name (C:\d\Farmers') and so misses that folder; this check uses the tool's
            # own quote-aware split (inv_split_multivalue) and never misses it.
            p["out_table"].setErrorMessage(INV_INSIDE_TABLE_ERROR)
        elif out and inv_is_dbase_output(out):
            # Warning here, refusal in the run (as above), so the reason is also in
            # the geoprocessing messages and history.
            p["out_table"].setWarningMessage(_inv_dbase_message(out) + " The tool will "
                                             "refuse to run. " + INV_DBASE_FIX)
        report = param_text(p["out_report"])
        if report and inv_output_inside_roots(report, roots):
            p["out_report"].setErrorMessage(INV_INSIDE_REPORT_ERROR)
        elif report and os.path.splitext(report)[1].casefold() not in (".xlsx", ".csv"):
            p["out_report"].setWarningMessage(
                "The report is written as .xlsx (or two .csv files if openpyxl is missing).")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        masker = InvPathMasker()
        try:
            self._run(parameters, p, collector, masker)
        except ToolError as err:
            _inv_register_params(masker, p)
            _inv_flush(collector)
            arcpy.AddError(inv_error_text(err, masker))
        except Exception as exc:
            # Any other failure (an arcpy error while describing, counting or writing): say what
            # happened and what to do, with credentials masked everywhere (the text of an arcpy
            # error can hold a connection string). The message is the error: nothing is re-raised,
            # because a raised traceback would print the exception text unmasked.
            _inv_register_params(masker, p)
            _inv_flush(collector)
            out = param_text(p["out_table"])
            lines = traceback.format_exc().strip().splitlines()
            # Each inserted text is masked once, on its own: the output path name by name, the
            # error text and each traceback line by ``InvPathMasker.text``. The fixed advice is
            # never masked, so a secret in the error text cannot swallow it.
            arcpy.AddError(
                "The inventory stopped with an unexpected error. The output table '{0}' and the "
                "report (if any) may be missing or incomplete: delete them and run the tool again "
                "after fixing the cause below. If it keeps failing, leave the dataset it names "
                "out of the Input Folders or Geodatabases.\nError: {1}: {2}\n"
                "Technical details (last lines of the traceback):\n{3}".format(
                    masker.finish(out) if out else "the output table", type(exc).__name__,
                    masker.text(str(exc)),
                    "\n".join(masker.text(line.strip()) for line in lines[-6:])))

    def _run(self, parameters, p, collector, masker=None):
        # Every path is masked ONCE, by this run's masker, where it is put into a row or a message
        # (review R10-1/R10-2); messages are made when they are sent (``_inv_say``), after every
        # path of the run is known, so the numbering ***(1)/***(2) is the same everywhere.
        masker = masker if masker is not None else InvPathMasker()
        roots = []
        seen = set()
        for root in _inv_roots(p["in_workspaces"]):
            key = normalize_catalog_path(root)
            if key and key not in seen:
                seen.add(key)
                roots.append(root)
        if not roots:
            raise ToolError("No folder or geodatabase was given.",
                            "Choose one or more folders or geodatabases.")
        recursive = param_bool(p["recursive"], True)
        include_tables = param_bool(p["include_tables"], False)
        count_rows = param_bool(p["count_rows"], False)
        out = param_text(p["out_table"])
        # Every output is checked before the main work (rule 11).
        check_output_path(out, roots)
        inside = inv_output_inside_roots(out, roots)
        if inside:
            raise _inv_refusal("The output table '{0}' is inside '{1}', which is being "
                               "inventoried; an existing item of that name (of any type) could "
                               "be replaced.".format(masker.finish(out), masker.finish(inside)),
                               "Write the output table to a folder or geodatabase that is not "
                               "being inventoried.")
        if inv_is_dbase_output(out):
            raise _inv_refusal(_inv_dbase_message(masker.finish(out)), INV_DBASE_FIX)
        requested_report = param_text(p["out_report"])
        # D-015 for the report too: a report file inside a scanned folder could
        # replace a CSV or Excel table listed there (with overwrite on). Every
        # name the report could be written as (the name given, the .xlsx name,
        # both CSV fallback names) is checked before choose_report_path probes
        # that the location is writable, so a refused report never touches the
        # scanned folder.
        if requested_report:
            candidates = [requested_report, os.path.splitext(requested_report)[0] + ".xlsx"]
            candidates += list(csv_report_paths(requested_report))
            for report_path in candidates:
                report_inside = inv_output_inside_roots(report_path, roots)
                if report_inside:
                    raise _inv_refusal("The report file '{0}' is inside '{1}', which is being "
                                       "inventoried; it could replace a file (for example a CSV "
                                       "or Excel table) there.".format(
                                           masker.finish(report_path),
                                           masker.finish(report_inside)),
                                       "Write the report to a folder that is not being "
                                       "inventoried.")
        target = choose_report_path(requested_report, inputs=input_texts(p) + roots)
        if target and target["note"]:
            # The note of shared code names the report path(s): masked once, by ``text``.
            note = target["note"]
            _inv_say(collector, MESSAGE_INFO, lambda: masker.text(note))

        # Tables are always walked so the output can be checked against every
        # dataset found, then left out of the inventory unless asked for.
        listed, walk_errors, rasters, scanned = {}, [], [], []
        seen_errors = {}
        unnamed_errors = {}
        table_noise = []
        table_off_errors = []
        walked_keys = []        # every item the search listed, tables too (minor note R10)
        for root in roots:
            found = _inv_walk_root(root, recursive)
            for item in found["items"]:
                scanned.extend([item["path"], item["dirpath"]])
                walked_keys.append(normalize_catalog_path(item["path"]))
                if item["data_type"] == "Table" and not include_tables:
                    continue
                key = normalize_catalog_path(item["path"])
                if key not in listed:
                    listed[key] = item
            # Walk runs once per datatype (and roots may overlap), so the same
            # unreadable folder is reported several times: keep one per path.
            for err in found["errors"]:
                if not err["path"] and err.get("datatype") == "Table":
                    # The table search of ArcGIS Pro raises a nameless error for each feature
                    # dataset, each GeoPackage and each mobile geodatabase. With Include Tables
                    # off it is of no interest; for a feature dataset it is never a problem (it
                    # holds no tables); for a GeoPackage or a mobile geodatabase it is not a read
                    # failure (its layers are listed, REPORTED from Pro runs), so it is an
                    # information line, not an UNREADABLE row.
                    if not include_tables:
                        reason = "off"
                    elif _inv_file_database_kind(err["message"]):
                        reason = _inv_file_database_kind(err["message"])
                    elif _inv_is_feature_dataset(err["message"]):
                        reason = "fds"
                    else:
                        reason = None
                    if reason:
                        table_noise.append((err["message"], reason))
                        continue
                if not err["path"]:
                    # Pro 3.3.2 calls Walk's onerror without a file name for some inputs
                    # (a feature dataset, a GeoPackage): say which input was being read and
                    # which Walk datatype raised it. One row per input and message.
                    ukey = (normalize_catalog_path(root), err["message"])
                    if ukey in unnamed_errors:
                        if err.get("datatype") not in unnamed_errors[ukey]["datatypes"]:
                            unnamed_errors[ukey]["datatypes"].append(err.get("datatype"))
                        continue
                    err = {"path": root, "message": err["message"], "unnamed": True,
                           "datatypes": [err.get("datatype")]}
                    unnamed_errors[ukey] = err
                    walk_errors.append(err)
                    continue
                err_key = normalize_catalog_path(err["path"])
                if err.get("datatype") == "Table" and not include_tables:
                    # Review R10-3: with Include Tables off, a failure of the table search costs
                    # nothing the user asked for (the feature classes come from their own search),
                    # so it is an information line, not an UNREADABLE row. When the feature class
                    # search of that path failed too, its row already says so.
                    if err_key not in seen_errors:
                        table_off_errors.append(err)
                    continue
                if err_key not in seen_errors:
                    err = dict(err)
                    seen_errors[err_key] = err
                    walk_errors.append(err)
                else:
                    # Minor note R10: the feature class AND the table search of one path failed
                    # with different errors; NOTE keeps both instead of only the first.
                    first = seen_errors[err_key]
                    more = first.setdefault("more", [])
                    if err["message"] and err["message"] != first["message"] and \
                            err["message"] not in [m["message"] for m in more]:
                        more.append(err)
            try:
                raster_found = walk_workspace(root, ("RasterDataset",), recursive=recursive)
                rasters.extend(r["path"] for r in raster_found["items"])
            except INV_ITEM_ERRORS:
                pass  # rasters are only listed as skipped; never a reason to fail
        # The .dbf of a shapefile is its attribute table, not a stand-alone table: if a Table
        # walk lists it next to the shapefile, it is not listed a second time.
        shape_stems = set(normalize_catalog_path(item["path"])[:-4] for item in listed.values()
                          if item["data_type"] == "FeatureClass"
                          and item["path"].casefold().endswith(".shp"))
        for key in [k for k, item in listed.items() if item["data_type"] == "Table"
                    and item["path"].casefold().endswith(".dbf") and k[:-4] in shape_stems]:
            del listed[key]
        # Rule 4: the output must never replace a dataset (or feature dataset) that
        # is being inventoried, whatever overwriteOutput says.
        try:
            refuse_if_same([out], roots + scanned + rasters)
        except ToolError:
            raise _inv_refusal("The output table '{0}' is one of the datasets being "
                               "inventoried (in a folder, a table name also covers the .dbf/.shp "
                               "files of that name).".format(masker.finish(out)),
                               "Choose a new table name, or a location outside the scanned "
                               "folders and geodatabases; this tool never overwrites the data it "
                               "lists.")
        if table_noise:
            names = sorted(set(m for m, _t in table_noise))
            reasons = set(t for _m, t in table_noise)
            if "off" in reasons:
                why = "Include Tables is off, so tables are not inventoried anyway"
            else:
                parts = []
                if "fds" in reasons:
                    parts.append("feature datasets, which cannot hold tables")
                if "gpkg" in reasons:
                    parts.append("GeoPackages, whose layers are listed")
                if "mobile" in reasons:
                    parts.append("mobile geodatabases, whose feature classes are listed")
                why = "they concern " + " and ".join(parts)
            for name in names:
                masker.path(str(name).strip().strip("'\""))

            def noise_text(names=names, reasons=reasons, why=why):
                text = ("While looking for stand-alone tables, ArcGIS Pro returned {0} notice(s) "
                        "about {1}. This is expected ({2}): all feature classes are still listed, "
                        "and these notices are not shown as UNREADABLE.".format(
                            len(names), "; ".join(masker.text(n) for n in names[:5]) +
                            ("; ..." if len(names) > 5 else ""), why))
                if "gpkg" in reasons and "off" not in reasons:
                    text += (" Whether ArcGIS Pro lists every stand-alone table of a GeoPackage is "
                             "not verified: check the tables of the GeoPackage in the Catalog pane.")
                if "mobile" in reasons and "off" not in reasons:
                    text += (" Whether ArcGIS Pro lists every stand-alone table of a mobile "
                             "geodatabase is not verified: check its tables in the Catalog pane.")
                return text
            _inv_say(collector, MESSAGE_INFO, noise_text)
        table_off = [e for e in table_off_errors
                     if normalize_catalog_path(e["path"]) not in seen_errors]
        if table_off:
            for err in table_off:
                masker.path(str(err["path"]))
            _inv_say(collector, MESSAGE_INFO, lambda: (
                "The search for stand-alone tables could not read {0} folder(s) or "
                "geodatabase(s). Include Tables is off, so no table was to be listed and every "
                "feature class found is in the inventory; these are not UNREADABLE rows:\n{1}"
                .format(len(table_off), "\n".join(
                    "  {0}: {1}".format(masker.finish(str(e["path"])),
                                        inv_walk_error_text(e, masker))
                    for e in table_off[:INV_LIST_LIMIT]) +
                    ("\n  ... and {0} more".format(len(table_off) - INV_LIST_LIMIT)
                     if len(table_off) > INV_LIST_LIMIT else ""))))
        collector.info("Found {0} dataset(s) in {1} folder(s)/geodatabase(s).".format(
            len(listed), len(roots)))
        if not listed and not walk_errors:
            collector.warning(
                "No dataset was found, so the output table is empty. Check the folders or "
                "geodatabases you gave{0}{1}. Rasters are not inventoried, and connection files "
                "(.sde) in a folder are not followed; add the geodatabase or the .sde file itself "
                "as an input to list what it holds.".format(
                    "" if recursive else " and whether Search Sub-folders should be on",
                    "" if include_tables else " (stand-alone tables are listed only with "
                                              "Include Tables)"))
        root_keys = set(normalize_catalog_path(r) for r in roots)
        connections = []
        for root in roots:
            for path in _inv_side_files(_inv_connection_files, root, recursive, collector, masker):
                if normalize_catalog_path(path) not in root_keys and path not in connections:
                    connections.append(path)
        if connections:
            # Review R10-2: one path per line, each masked once where it is inserted, and the
            # advice BEFORE the list, so no credential-like name can hide a later path or it.
            _inv_say(collector, MESSAGE_INFO, lambda: (
                "{0} database connection file(s) (.sde) in the scanned folders were not searched "
                "(the tool does not follow connection files in a folder). To inventory such a "
                "database, add its .sde file itself as an input:\n{1}".format(
                    len(connections), inv_path_lines(connections, masker))))

        unwalked = []
        walked = set(walked_keys)
        for root in roots:
            for path in _inv_side_files(_inv_unwalked_files, root, recursive, collector, masker):
                key = normalize_catalog_path(path)
                if key in root_keys or path in unwalked:
                    continue
                # Minor note R10: judged on every item the search listed, tables too (a mobile
                # geodatabase that holds only tables WAS entered by the search).
                if any(k.startswith(key + "\\") for k in walked):
                    continue        # the search did list datasets inside it (it was walked)
                unwalked.append(path)
        if unwalked:
            _inv_say(collector, MESSAGE_WARNING, lambda: (
                "{0} GeoPackage/GeoJSON/SQLite/KML/GML/mobile geodatabase file(s) in the scanned "
                "folders were not inventoried (a folder search does not list their layers). "
                "To inventory a GeoPackage, add the .gpkg file itself as an input (for a mobile "
                "geodatabase, the .geodatabase file):\n{1}".format(
                    len(unwalked), inv_path_lines(unwalked, masker))))

        items = []
        parent_cache = {}
        progress = Progress("Describing datasets", len(listed))
        for key in sorted(listed):
            items.append(self._describe_item(listed[key], count_rows, parent_cache))
            progress.tick()
        progress.close()
        for err in walk_errors:
            items.append({"container": err["path"], "dataset": None,
                          "catalog_path": err["path"], "data_type": None, "is_feature": False,
                          "error": err["message"], "_walk_error": err})

        # The summary groups on the UNMASKED containers (two folders pass=1 and pass=2 are two
        # containers, never one mixed "pass=***"); every path is masked only for writing, one
        # folder or file name at a time, with the same numbering in the table, report and messages.
        plain_rows = inventory_rows(items, count_rows)
        summary = container_summary(plain_rows)
        raster_paths = sorted(set(rasters))
        # Every path of the run is registered first (rows first, so their numbering is the one
        # the table always had); only then is anything masked.
        for row in plain_rows:
            for k in INV_PATH_FIELDS:
                masker.path(row.get(k))
        for path in ([g["container"] for g in summary] +
                     [p_ for r_ in raster_paths for p_ in (workspace_of(r_), r_)] +
                     roots + connections + unwalked + [out] +
                     (list(target["paths"]) if target else [])):
            masker.path(path)
        # NOTE is made from masked parts: the error text once by ``text`` and, for an error
        # without a file name, the input path once by ``finish`` (never the composed NOTE).
        masked_items = [dict(item, error=self._masked_error(item, masker),
                             count_error=masker.text(item.get("count_error")))
                        for item in items]
        rows, masked_paths = inv_mask_rows(inventory_rows(masked_items, count_rows), masker,
                                           masked_fields=("NOTE",))
        for group in summary:
            group["container"] = masker.finish(group["container"])
            group["crs"] = [redact_credentials(label) for label in group["crs"]]
        counts = inventory_flag_counts(rows)

        specs = []
        for name in INV_OUTPUT_FIELDS:
            if name in INV_TEXT_FIELDS:
                specs.append({"name": name, "type": "TEXT", "values": [r[name] for r in rows]})
            else:
                specs.append({"name": name, "type": INV_FIELD_TYPES[name]})
        plan_field_names(specs, split_catalog_path(out)[0])
        out_path, mapping = create_table(out, specs, inputs=roots + scanned + rasters)
        insert_rows(out_path, [mapping[n] for n in INV_OUTPUT_FIELDS],
                    [[r[n] for n in INV_OUTPUT_FIELDS] for r in rows])
        masker.path(out_path)
        collector.info("Wrote {0} row(s) to {1}.".format(len(rows), masker.finish(out_path)))

        if target:
            summary_rows = [[g["container"], g["datasets"], g["feature_classes"], g["crs_count"],
                             "; ".join(g["crs"]), g["undefined"], g["unreadable"],
                             "MIXED_CRS" if g["mixed"] else None] for g in summary]
            detail = [[r[n] for n in INV_OUTPUT_FIELDS] for r in rows]
            raster_rows, _n = inv_mask_rows(
                [dict(zip(INV_OUTPUT_FIELDS,
                          [workspace_of(path), os.path.basename(path.rstrip("\\/")), path,
                           "RasterDataset"] + [None] * (len(INV_OUTPUT_FIELDS) - 6) +
                          ["SKIPPED", "Rasters are not inventoried."]))
                 for path in raster_paths], masker, masked_fields=("NOTE",))
            detail += [[r[n] for n in INV_OUTPUT_FIELDS] for r in raster_rows]
            # Rows are already masked (paths name by name): masking them again as whole texts
            # would cut every path after its first NAME=*** and merge different paths.
            written = write_report(target, summary_rows,
                                   list(INV_OUTPUT_FIELDS), detail,
                                   summary_header=("CONTAINER", "DATASETS", "FEATURE_CLASSES",
                                                   "DISTINCT_CRS", "CRS_LIST", "UNDEFINED_CRS",
                                                   "UNREADABLE", "MIXED_CRS"))
            for path in written:
                masker.path(path)
            collector.info("Report written: {0}.".format("; ".join(masker.finish(w)
                                                                   for w in written)))

        if rasters:
            collector.info("{0} raster dataset(s) were skipped (rasters are not inventoried)."
                           .format(len(set(rasters))))
        # Review R10-1: the containers are masked once (above, name by name, numbered); the
        # composed warning is not masked again, so pass=***(1)\d.gdb and pass=***(2)\d.gdb stay
        # two different, complete lines.
        mixed = [g["container"] for g in summary if g["mixed"]]
        if mixed:
            collector.warning("{0} folder(s)/geodatabase(s) hold more than one coordinate "
                              "system (MIXED_CRS):\n{1}".format(
                                  len(mixed), "\n".join(mixed[:INV_LIST_LIMIT]) +
                                  ("\n... and {0} more".format(len(mixed) - INV_LIST_LIMIT)
                                   if len(mixed) > INV_LIST_LIMIT else "")))
        if counts["UNDEFINED_CRS"]:
            collector.warning("{0} feature class(es) have an undefined coordinate system "
                              "(UNDEFINED_CRS); use Define Projection once the right system is "
                              "known.".format(counts["UNDEFINED_CRS"]))
        if counts["FDS_MISMATCH"]:
            collector.warning("{0} feature class(es) differ from the coordinate system of their "
                              "feature dataset (FDS_MISMATCH).".format(counts["FDS_MISMATCH"]))
        if counts["UNREADABLE"]:
            collector.warning("{0} dataset(s) or folder(s) could not be read (UNREADABLE); the "
                              "reason is in the NOTE field of the output table{1}."
                              .format(counts["UNREADABLE"],
                                      " and in the report" if target else ""))
        if masked_paths:
            collector.warning(INV_MASKED_WARNING.format(masked_paths))
        if counts["EMPTY"]:
            collector.info("{0} dataset(s) have no rows (EMPTY).".format(counts["EMPTY"]))
        flagged = sum(1 for r in rows if r["FLAGS"] and r["DATASET"])
        set_derived_output(parameters, "flag_count", str(flagged))
        _inv_flush(collector)

    @staticmethod
    def _masked_error(item, masker):
        """The error text of an item for NOTE, masked once (``None`` when there is none)."""
        err = item.get("_walk_error")
        if err is not None:
            return inv_walk_error_text(err, masker)
        return masker.text(item.get("error"))

    def _describe_item(self, found, count_rows, parent_cache):
        path = found["path"]
        container = workspace_of(path) or found["dirpath"]
        is_feature = found["data_type"] == "FeatureClass"
        item = {"container": container, "dataset": found["name"], "catalog_path": path,
                "data_type": found["data_type"], "is_feature": is_feature, "error": None}
        try:
            desc = arcpy.da.Describe(path)
            item["data_type"] = desc["dataType"]
            if is_feature:
                item["shape_type"] = desc["shapeType"]
                item["has_z"] = bool(desc["hasZ"])
                item["has_m"] = bool(desc["hasM"])
                sr = desc["spatialReference"] if "spatialReference" in desc else None
                item["sr"] = _inv_sr_dict(sr)
                folder = is_folder_workspace(container)
                item["is_shapefile"] = folder and path.casefold().endswith(".shp")
                if item["is_shapefile"]:
                    item["prj_exists"] = os.path.isfile(os.path.splitext(path)[0] + ".prj")
                parent = found["dirpath"]
                if not folder and normalize_catalog_path(parent) != \
                        normalize_catalog_path(container):
                    item["parent_sr"] = self._parent_sr(parent, parent_cache)
        except INV_ITEM_ERRORS as exc:
            item["error"] = "{0}: {1}".format(type(exc).__name__, exc)
            return item
        if count_rows:
            # A failed count must not discard the description: the row keeps its
            # shape type, Z/M and coordinate system and gets UNREADABLE with the
            # reason (core: count_error).
            try:
                item["row_count"] = _inv_count_rows(path)
            except INV_ITEM_ERRORS as exc:
                item["count_error"] = "{0}: {1}".format(type(exc).__name__, exc)
        return item

    def _parent_sr(self, parent, cache):
        """Coordinate system of a feature dataset (``None`` if it cannot be read)."""
        key = normalize_catalog_path(parent)
        if key not in cache:
            try:
                desc = arcpy.da.Describe(parent)
                sr = desc["spatialReference"] if "spatialReference" in desc else None
                cache[key] = _inv_sr_dict(sr)
            except INV_ITEM_ERRORS:
                cache[key] = None
        return cache[key]


# ==========================================================================
# Toolbox (generated)
# ==========================================================================

class Toolbox(object):
    """Project Automation & Administration"""

    def __init__(self):
        self.label = "Project Automation & Administration"
        self.alias = "projectadmin"
        self.description = "Read-only inventories for administrators: datasets and coordinate systems of folders and geodatabases. All tools run in the foreground (background geoprocessing is not used)." + " (v" + __version__ + ")"
        self.tools = [WorkspaceCrsInventory]
