# ==========================================================================
# common/errors.py
# ==========================================================================
# Error type used by every tool: a failure always states its cause and its fix.

class ToolError(Exception):
    """A user-facing failure.

    ``cause`` says what went wrong, ``fix`` says what the user can do about it.
    ``str(err)`` gives one readable sentence pair suitable for ``arcpy.AddError``.
    """

    def __init__(self, cause, fix=None):
        Exception.__init__(self, cause)
        self.cause = cause
        self.fix = fix

    def __str__(self):
        if self.fix:
            return "{0} Fix: {1}".format(self.cause, self.fix)
        return str(self.cause)


# ==========================================================================
# common/numeric.py
# ==========================================================================
# Numbers as ArcGIS stores them: single-precision (FLOAT) values.
#
# FLOAT fields hold 32-bit floats (fieldtypes.html), so a value typed as 0.1
# reads back from a cursor as 0.10000000149011612. Comparing that with the text
# "0.1" or with a DOUBLE 0.1 fails although the user sees the same number.
#
# * ``float32_shortest(value)``: the shortest decimal float that rounds to the
#   same 32-bit value (0.10000000149011612 -> 0.1); non-floats unchanged.
# * ``float32_equal(a, b)``: True when two numbers are the same 32-bit float.
# * ``is_single_field(field)``: True for a FLOAT field dict (``Field.type`` "Single").
# * ``exact_number(value)``: a number for comparisons and dictionary keys that
#   keeps integers exact (BigInteger values above 2**53 stay distinct) while
#   1, 1.0 and "1" stay equal.
#
# Pure Python (``struct``), no arcpy. Shared by every toolbox: reuse these
# instead of adding another copy.

_NUMERIC_SINGLE_TYPES = frozenset(["single", "float"])
# Integer text as ArcGIS writes it: ASCII digits only, optional sign.
_NUMERIC_INT_TEXT = re.compile(r"^[+-]?[0-9]+$")


def _numeric_pack(value):
    """4-byte single-precision form of ``value`` or ``None`` (overflow, not a number)."""
    try:
        return struct.pack("<f", value)
    except (OverflowError, struct.error, TypeError):
        return None


def float32_shortest(value):
    """Shortest decimal float with the same single-precision value as ``value``.

    Non-floats, NaN, infinities and values outside the single range are
    returned unchanged.
    """
    if not isinstance(value, float) or value != value or value in (float("inf"), float("-inf")):
        return value
    target = _numeric_pack(value)
    if target is None:
        return value
    for digits in range(1, 10):
        candidate = float("{0:.{1}g}".format(value, digits))
        if _numeric_pack(candidate) == target:
            return candidate
    return value


def float32_equal(a, b):
    """True if numbers ``a`` and ``b`` are the same single-precision value."""
    if isinstance(a, bool) or isinstance(b, bool):
        return False
    try:
        fa, fb = float(a), float(b)
    except (TypeError, ValueError):
        return False
    pa, pb = _numeric_pack(fa), _numeric_pack(fb)
    return pa is not None and pa == pb


def is_single_field(field):
    """True for a FLOAT (single-precision) field dict."""
    return str(field.get("type") or "").casefold() in _NUMERIC_SINGLE_TYPES


def exact_number(value):
    """``value`` as an exact number (``int`` or ``float``), or ``None``.

    ``float()`` loses the last digits of integers above 2**53 (BigInteger
    fields, 16+ digit identifiers), so two different keys or codes would
    compare equal. Integers stay ``int`` here, integer text ("0012",
    "9007199254740993") becomes ``int``, other numbers and numeric text become
    ``float``. Python's ``int`` and ``float`` compare and hash exactly, so 1,
    1.0 and "1" still give equal keys. NaN and values that are not numbers
    give ``None``.
    """
    if value is None:
        return None
    if isinstance(value, int):
        return int(value)  # bool -> 0 / 1, as float() gave
    if isinstance(value, float):
        return None if value != value else value
    if isinstance(value, str):
        text = value.strip()
        if _NUMERIC_INT_TEXT.match(text):
            try:
                return int(text)
            except ValueError:  # over Python's integer text limit
                return None
    try:
        number = float(value)
    except (TypeError, ValueError, OverflowError):
        return None
    return None if number != number else number


# ==========================================================================
# common/messages.py
# ==========================================================================
# Message collector so pure cores can report progress without importing arcpy.
#
# A core appends messages to a ``MessageCollector``; the tool adapter later sends
# them to ArcGIS Pro (see ``arcio.flush_messages``). Levels follow the toolkit
# rule: ``info`` for normal progress, ``warning`` only for things the user must
# act on, ``error`` only for real failure.

MESSAGE_INFO = "info"
MESSAGE_WARNING = "warning"
MESSAGE_ERROR = "error"


class MessageCollector(object):
    """Ordered list of ``(level, text)`` pairs."""

    def __init__(self):
        self.items = []

    def info(self, text):
        self.items.append((MESSAGE_INFO, str(text)))

    def warning(self, text):
        self.items.append((MESSAGE_WARNING, str(text)))

    def error(self, text):
        self.items.append((MESSAGE_ERROR, str(text)))

    def extend(self, other):
        """Append all messages of another collector, keeping their order."""
        self.items.extend(other.items)

    def texts(self, level=None):
        """Message texts, optionally only those of one level."""
        return [t for (lvl, t) in self.items if level is None or lvl == level]

    def has_errors(self):
        return any(lvl == MESSAGE_ERROR for (lvl, _t) in self.items)

    def counts(self):
        """Number of messages per level, e.g. ``{"info": 3, "warning": 1, "error": 0}``."""
        result = {MESSAGE_INFO: 0, MESSAGE_WARNING: 0, MESSAGE_ERROR: 0}
        for lvl, _t in self.items:
            result[lvl] = result.get(lvl, 0) + 1
        return result

    def clear(self):
        self.items = []

    def __len__(self):
        return len(self.items)


# ==========================================================================
# common/text.py
# ==========================================================================
# Text normalisation, placeholder detection, scripts, edit distance, natural sort.
#
# Pure Python (stdlib only). Every character set is a fixed, documented constant
# so results never depend on the Python or Unicode database version for the
# characters that matter here.
#
# Main entry points:
#
# * ``to_nfc(text)``: Unicode canonical composition (NFC). ``normalize_text``
#   and ``arabic_normalize`` always apply it first, so a decomposed spelling
#   (macOS export, PDF copy: "u" + combining diaeresis, Arabic yeh + combining
#   hamza) gets the same result as the precomposed one.
# * ``normalize_text(value, ...)``: options-driven cleaning (whitespace,
#   invisible marks, control characters, digits, case, Arabic folding).
# * ``arabic_normalize(text, ...)``: Arabic-aware folding (tashkeel, tatweel,
#   alef forms, alef maqsura / teh marbuta options, Persian letters, digits).
# * ``is_placeholder(value, ...)``: "N/A", "-", "null", "none", "0000" ...
# * ``script_of(text)`` / ``script_profile(text)``: Arabic / Latin / mixed / digits.
# * ``levenshtein`` / ``damerau_levenshtein``: bounded edit distances.
# * ``natural_sort_key``: "Lot 2" before "Lot 10".
#
# ``None`` is passed through unchanged by every normaliser (a null is not an
# empty string; callers decide how to report it).

# --------------------------------------------------------------------------
# Character sets (fixed lists)
# --------------------------------------------------------------------------

# Whitespace that is folded to an ordinary space: ASCII space and tab, NBSP,
# U+1680, U+2000-U+200A, U+202F, U+205F, U+3000. Line breaks are separate.
TEXT_SPACES = frozenset(
    [u" ", u"\u0009", u" ", u" ", u" ", u" ", u"　"]
    + [chr(c) for c in range(0x2000, 0x200B)])

# Line breaks: LF, CR, VT, FF, NEL, LINE SEPARATOR, PARAGRAPH SEPARATOR.
TEXT_LINE_BREAKS = frozenset([u"\n", u"\r", u"\x0b", u"\x0c", u"\x85", u" ", u" "])

# Invisible format characters removed by ``remove_invisible``: zero width
# space, BOM / zero width no-break space, word joiner, soft hyphen, LRM, RLM,
# Arabic letter mark, bidi embeddings/overrides (U+202A-202E) and isolates
# (U+2066-2069).
TEXT_INVISIBLE = frozenset(
    [u"​", u"﻿", u"⁠", u"­", u"‎", u"‏", u"؜"]
    + [chr(c) for c in range(0x202A, 0x202F)]
    + [chr(c) for c in range(0x2066, 0x206A)])

# Zero width non-joiner / joiner. They change Arabic and Persian shaping, so
# they are removed only when asked (``joiners=True``).
TEXT_JOINERS = frozenset([u"‌", u"‍"])

# Arabic harakat / tashkeel: U+064B-U+065F, superscript alef U+0670,
# Quranic marks U+06D6-U+06ED (excluding U+06DD/U+06DE symbols) and U+0610-061A.
TEXT_ARABIC_TASHKEEL = frozenset(
    [chr(c) for c in range(0x064B, 0x0660)] + [u"ٰ"]
    + [chr(c) for c in range(0x0610, 0x061B)]
    + [chr(c) for c in range(0x06D6, 0x06EE) if c not in (0x06DD, 0x06DE, 0x06E5, 0x06E6)])
TEXT_ARABIC_TATWEEL = u"ـ"

# Alef with madda / hamza above / hamza below / wasla -> bare alef.
TEXT_ALEF_FORMS = {u"آ": u"ا", u"أ": u"ا", u"إ": u"ا",
                   u"ٱ": u"ا"}
TEXT_ALEF_MAQSURA = {u"ى": u"ي"}      # alef maqsura -> yeh
TEXT_TEH_MARBUTA = {u"ة": u"ه"}       # teh marbuta -> heh
# Persian / Urdu letters -> Arabic equivalents (keheh -> kaf, farsi yeh -> yeh).
TEXT_PERSIAN_LETTERS = {u"ک": u"ك", u"ی": u"ي"}

# Arabic-Indic (U+0660-0669) and extended / Persian (U+06F0-06F9) digits -> ASCII.
TEXT_DIGIT_MAP = dict([(chr(0x0660 + i), str(i)) for i in range(10)]
                      + [(chr(0x06F0 + i), str(i)) for i in range(10)])
# Arabic decimal separator and thousands separator (only with separators=True).
TEXT_ARABIC_SEPARATORS = {u"٫": u".", u"٬": u","}

# Default placeholder spellings (compared after trim, whitespace collapse and
# casefold). All-zero strings are handled separately (``zero_run``).
TEXT_DEFAULT_PLACEHOLDERS = frozenset([
    u"n/a", u"n.a.", u"na", u"n\\a", u"-", u"--", u"---", u"null", u"<null>", u"none",
    u"nil", u"?", u"??", u".", u"unknown", u"tbd", u"#n/a", u"x"])


# --------------------------------------------------------------------------
# Small building blocks
# --------------------------------------------------------------------------

def collapse_whitespace(text, keep_line_breaks=False):
    """Fold every ``TEXT_SPACES`` character (and line breaks, unless
    ``keep_line_breaks``) to one space, collapse runs and trim the ends."""
    if text is None:
        return None
    out = []
    pending = False
    for ch in text:
        if ch in TEXT_SPACES or (not keep_line_breaks and ch in TEXT_LINE_BREAKS):
            pending = True
            continue
        if ch in TEXT_LINE_BREAKS:
            # keep the break itself; drop spaces around it
            out.append(ch)
            pending = False
            continue
        if pending and out and out[-1] not in TEXT_LINE_BREAKS:
            out.append(u" ")
        pending = False
        out.append(ch)
    return u"".join(out).strip(u" ")


def has_line_breaks(text):
    """True if ``text`` contains any ``TEXT_LINE_BREAKS`` character."""
    return bool(text) and any(ch in TEXT_LINE_BREAKS for ch in text)


def is_control_char(ch):
    """True for C0/C1 control characters other than line breaks and tab."""
    if ch in TEXT_LINE_BREAKS or ch == u"\t":
        return False
    return unicodedata.category(ch) == "Cc"


def has_control_chars(text):
    """True if ``text`` contains a control character (see ``is_control_char``)."""
    return bool(text) and any(is_control_char(ch) for ch in text)


def strip_control_chars(text, line_breaks=False):
    """Remove control characters; with ``line_breaks=True`` also line breaks and tabs."""
    if text is None:
        return None
    return u"".join(ch for ch in text if not is_control_char(ch)
                    and not (line_breaks and (ch in TEXT_LINE_BREAKS or ch == u"\t")))


def remove_invisible(text, joiners=False):
    """Remove ``TEXT_INVISIBLE`` marks (and ZWNJ/ZWJ when ``joiners``)."""
    if text is None:
        return None
    return u"".join(ch for ch in text if ch not in TEXT_INVISIBLE
                    and not (joiners and ch in TEXT_JOINERS))


def has_invisible(text, joiners=True):
    """True if ``text`` contains an invisible mark (ZWNJ/ZWJ count unless ``joiners=False``)."""
    return bool(text) and any(ch in TEXT_INVISIBLE or (joiners and ch in TEXT_JOINERS)
                              for ch in text)


def fold_digits(text, separators=False):
    """Arabic-Indic and Persian digits -> ASCII; with ``separators`` also
    U+066B -> "." and U+066C -> ","."""
    if text is None:
        return None
    out = []
    for ch in text:
        if ch in TEXT_DIGIT_MAP:
            out.append(TEXT_DIGIT_MAP[ch])
        elif separators and ch in TEXT_ARABIC_SEPARATORS:
            out.append(TEXT_ARABIC_SEPARATORS[ch])
        else:
            out.append(ch)
    return u"".join(out)


def to_nfc(text):
    """Unicode canonical composition (NFC) of a text; anything else (``None``,
    numbers, dates) is returned unchanged.

    Canonically equivalent spellings look identical and must compare equal:
    "u" + U+0308 becomes U+00FC, Arabic yeh + combining hamza above
    (U+064A U+0654) becomes U+0626. Only canonical equivalence is applied
    (not NFKC), so ligatures, superscripts and full-width forms are kept.
    """
    if isinstance(text, str):
        return unicodedata.normalize("NFC", text)
    return text


def _text_is_presentation_form(ch):
    c = ord(ch)
    return (0xFB50 <= c <= 0xFDFF) or (0xFE70 <= c <= 0xFEFE)


def _text_presentation_nfkc(ch):
    """NFKC of one presentation form. The isolated tashkeel forms (U+FE70-FE7E) and the
    shadda ligatures (U+FC5E-FC63) decompose into SPACE + mark(s); the space only carries
    the sign, so it is dropped (otherwise removing the mark as tashkeel leaves a space)."""
    comp = unicodedata.normalize("NFKC", ch)
    if len(comp) > 1 and comp[0] == u" " and all(unicodedata.combining(c) for c in comp[1:]):
        return comp[1:]
    return comp


def arabic_normalize(text, tashkeel=True, tatweel=True, alef=True, alef_maqsura=True,
                     teh_marbuta=False, persian=True, digits=True, presentation=True,
                     marks=True):
    """Arabic-aware folding; each step is an option.

    Unicode NFC is always applied first (``to_nfc``): without it a combining
    hamza (U+0654) of a decomposed spelling would be removed as tashkeel,
    while its precomposed equivalent U+0626 is kept.

    * ``presentation``: Arabic presentation forms (U+FB50-FDFF, U+FE70-FEFE)
      are decomposed with NFKC, applied to those code points only;
    * ``tashkeel``: remove ``TEXT_ARABIC_TASHKEEL``; ``tatweel``: remove U+0640;
    * ``alef``: U+0622/0623/0625/0671 -> U+0627;
    * ``alef_maqsura``: U+0649 -> U+064A (on by default);
    * ``teh_marbuta``: U+0629 -> U+0647 (off by default: it changes meaning);
    * ``persian``: U+06A9 -> U+0643, U+06CC -> U+064A;
    * ``digits``: Arabic-Indic / Persian digits -> ASCII;
    * ``marks``: remove invisible marks including ZWNJ/ZWJ, LRM/RLM, ALM.
    """
    if text is None:
        return None
    text = to_nfc(text)
    if presentation:
        text = u"".join(_text_presentation_nfkc(ch) if _text_is_presentation_form(ch) else ch
                        for ch in text)
    out = []
    for ch in text:
        if tashkeel and ch in TEXT_ARABIC_TASHKEEL:
            continue
        if tatweel and ch == TEXT_ARABIC_TATWEEL:
            continue
        if marks and (ch in TEXT_INVISIBLE or ch in TEXT_JOINERS):
            continue
        if alef and ch in TEXT_ALEF_FORMS:
            ch = TEXT_ALEF_FORMS[ch]
        elif alef_maqsura and ch in TEXT_ALEF_MAQSURA:
            ch = TEXT_ALEF_MAQSURA[ch]
        elif teh_marbuta and ch in TEXT_TEH_MARBUTA:
            ch = TEXT_TEH_MARBUTA[ch]
        elif persian and ch in TEXT_PERSIAN_LETTERS:
            ch = TEXT_PERSIAN_LETTERS[ch]
        elif digits and ch in TEXT_DIGIT_MAP:
            ch = TEXT_DIGIT_MAP[ch]
        out.append(ch)
    return u"".join(out)


def strip_leading_zeros(text):
    """``"007"`` -> ``"7"`` and ``"000"`` -> ``"0"`` for ASCII-digit-only strings;
    anything else is returned unchanged."""
    if text and text.isascii() and text.isdigit():
        return text.lstrip(u"0") or u"0"
    return text


def date_text(value):
    """ISO text of a date/time value; a datetime at exactly 00:00:00 is written as
    the date only ("2024-01-05"), so a DATE field value at midnight, a DATEONLY
    value and an ISO date typed as text give the same text. Other values: ``None``.
    """
    if isinstance(value, datetime.datetime):
        if value.time() == datetime.time(0, 0):
            return value.date().isoformat()
        return value.isoformat(" ")
    if isinstance(value, (datetime.date, datetime.time)):
        return value.isoformat()
    return None


def value_to_text(value):
    """Text form of a cell value for key comparison.

    ``None`` stays ``None``; integral floats lose ``.0`` (``1.0`` -> ``"1"``);
    other numbers use ``repr``-exact ``str``; bools become ``"True"``/``"False"``.
    """
    if value is None:
        return None
    if isinstance(value, bool):
        return str(value)
    if isinstance(value, float):
        if value != value or value in (float("inf"), float("-inf")):
            return str(value)
        if value == int(value):
            return str(int(value))
        return repr(value)
    if isinstance(value, bytes):
        return value.decode("utf-8", "replace")
    return value if isinstance(value, str) else str(value)


def normalize_text(value, trim=True, collapse=True, casefold=False, invisible=True,
                   controls=True, digits=True, leading_zeros=False, arabic=None):
    """Options-driven normalisation of one value (``None`` stays ``None``).

    Order: ``value_to_text`` -> Unicode NFC (always, ``to_nfc``) -> controls
    (removed, line breaks kept for ``collapse``) -> invisible marks -> Arabic (``arabic`` is ``None`` for
    off, ``True`` for defaults, or a dict of ``arabic_normalize`` options)
    -> digits -> whitespace (``collapse`` folds all spaces and line breaks
    to one space; else only ``trim``) -> casefold -> leading zeros.
    """
    text = value_to_text(value)
    if text is None:
        return None
    text = to_nfc(text)
    if controls:
        text = strip_control_chars(text)
    if invisible:
        text = remove_invisible(text)
    if arabic:
        text = arabic_normalize(text, **(arabic if isinstance(arabic, dict) else {}))
    if digits:
        text = fold_digits(text)
    if collapse:
        text = collapse_whitespace(text)
    elif trim:
        text = text.strip(u"".join(sorted(TEXT_SPACES | TEXT_LINE_BREAKS)))
    if casefold:
        text = text.casefold()
    if leading_zeros:
        text = strip_leading_zeros(text)
    return text


def is_blank(value):
    """True for ``None`` and for text that is empty after removing whitespace,
    line breaks and invisible marks."""
    if value is None:
        return True
    if not isinstance(value, str):
        return False
    return collapse_whitespace(remove_invisible(value, joiners=True)) == u""


def is_placeholder(value, placeholders=None, zero_run=3, blank=False):
    """True if ``value`` is a placeholder such as "N/A", "-", "null", "none".

    The value is compared after invisible-mark removal, digit folding,
    whitespace collapse and casefold with ``placeholders`` (an iterable of
    spellings, compared casefolded; default ``TEXT_DEFAULT_PLACEHOLDERS``).
    ``zero_run``: strings of at least this many zeros and nothing else
    ("000", "0000") count; ``None``/0 disables. ``blank``: empty/whitespace
    counts as a placeholder too (default False: report blanks separately).
    Non-text values (numbers, dates, ``None``) are never placeholders.
    """
    if not isinstance(value, str):
        return False
    text = collapse_whitespace(fold_digits(remove_invisible(value, joiners=True))).casefold()
    if text == u"":
        return bool(blank)
    pool = TEXT_DEFAULT_PLACEHOLDERS if placeholders is None else \
        frozenset(collapse_whitespace(str(p)).casefold() for p in placeholders)
    if text in pool:
        return True
    if zero_run and len(text) >= zero_run and text.strip(u"0") == u"":
        return True
    return False


# --------------------------------------------------------------------------
# Scripts
# --------------------------------------------------------------------------

SCRIPT_ARABIC = "arabic"
SCRIPT_LATIN = "latin"
SCRIPT_MIXED = "mixed"
SCRIPT_DIGITS = "digits"
SCRIPT_OTHER = "other"
SCRIPT_EMPTY = "empty"

_TEXT_ARABIC_BLOCKS = ((0x0600, 0x06FF), (0x0750, 0x077F), (0x08A0, 0x08FF),
                       (0xFB50, 0xFDFF), (0xFE70, 0xFEFF))


def _text_in_arabic_block(c):
    for lo, hi in _TEXT_ARABIC_BLOCKS:
        if lo <= c <= hi:
            return True
    return False


def script_profile(text):
    """Character counts: ``{"arabic", "latin", "other_letters", "ascii_digits",
    "arabic_digits", "other_digits", "other"}``.

    Letters are Unicode category L*; Arabic = letters in the Arabic blocks;
    Latin = letters whose Unicode name starts with "LATIN". Combining marks
    (tashkeel), spaces and punctuation count as "other".
    """
    counts = {"arabic": 0, "latin": 0, "other_letters": 0, "ascii_digits": 0,
              "arabic_digits": 0, "other_digits": 0, "other": 0}
    for ch in text or u"":
        cat = unicodedata.category(ch)
        c = ord(ch)
        if cat == "Nd":
            if u"0" <= ch <= u"9":
                counts["ascii_digits"] += 1
            elif ch in TEXT_DIGIT_MAP:
                counts["arabic_digits"] += 1
            else:
                counts["other_digits"] += 1
        elif cat.startswith("L"):
            if _text_in_arabic_block(c):
                counts["arabic"] += 1
            elif unicodedata.name(ch, "").startswith("LATIN"):
                counts["latin"] += 1
            else:
                counts["other_letters"] += 1
        else:
            counts["other"] += 1
    return counts


def script_of(text):
    """Dominant script of ``text``.

    ``"empty"`` (no letters or digits), ``"digits"`` (digits only, any
    script), ``"arabic"``, ``"latin"``, ``"other"`` (letters of one other
    script family) or ``"mixed"`` (letters of more than one of Arabic /
    Latin / other). Digits never make a text mixed.
    """
    p = script_profile(text)
    families = [k for k in ("arabic", "latin", "other_letters") if p[k]]
    if not families:
        if p["ascii_digits"] or p["arabic_digits"] or p["other_digits"]:
            return SCRIPT_DIGITS
        return SCRIPT_EMPTY
    if len(families) > 1:
        return SCRIPT_MIXED
    return {"arabic": SCRIPT_ARABIC, "latin": SCRIPT_LATIN,
            "other_letters": SCRIPT_OTHER}[families[0]]


def has_mixed_digits(text):
    """True if ``text`` mixes ASCII digits with Arabic-Indic/Persian digits."""
    p = script_profile(text)
    return bool(p["ascii_digits"] and p["arabic_digits"])


# --------------------------------------------------------------------------
# Edit distance
# --------------------------------------------------------------------------

def levenshtein(a, b, max_distance=None):
    """Levenshtein distance (insert, delete, substitute; each cost 1).

    With ``max_distance`` the computation stops early and returns
    ``max_distance + 1`` as soon as the distance is known to exceed it.
    ``None`` inputs are treated as empty strings.
    """
    a = a or u""
    b = b or u""
    if a == b:
        return 0
    if len(a) < len(b):
        a, b = b, a
    if max_distance is not None and len(a) - len(b) > max_distance:
        return max_distance + 1
    if not b:
        return len(a)
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i] + [0] * len(b)
        row_min = i
        for j, cb in enumerate(b, 1):
            cost = 0 if ca == cb else 1
            v = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            cur[j] = v
            if v < row_min:
                row_min = v
        if max_distance is not None and row_min > max_distance:
            return max_distance + 1
        prev = cur
    d = prev[-1]
    if max_distance is not None and d > max_distance:
        return max_distance + 1
    return d


def damerau_levenshtein(a, b, max_distance=None):
    """Optimal-string-alignment distance: Levenshtein plus transposition of
    two adjacent characters (cost 1). A substring is never edited twice, so
    ``("CA", "ABC")`` is 3 (the unrestricted Damerau distance would be 2).

    ``max_distance`` bounds as in ``levenshtein``.
    """
    a = a or u""
    b = b or u""
    if a == b:
        return 0
    if max_distance is not None and abs(len(a) - len(b)) > max_distance:
        return max_distance + 1
    if not a or not b:
        return max(len(a), len(b))
    n = len(b)
    two_back = None
    prev = list(range(n + 1))
    prev_min = 0
    for i in range(1, len(a) + 1):
        cur = [i] + [0] * n
        row_min = i
        for j in range(1, n + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            v = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            if (two_back is not None and j > 1 and a[i - 1] == b[j - 2]
                    and a[i - 2] == b[j - 1]):
                v = min(v, two_back[j - 2] + 1)
            cur[j] = v
            if v < row_min:
                row_min = v
        # Later cells come from this row or, by a transposition, from the
        # previous row plus 1: both minima bound the final distance.
        if max_distance is not None and min(row_min, prev_min + 1) > max_distance:
            return max_distance + 1
        two_back, prev, prev_min = prev, cur, row_min
    d = prev[-1]
    if max_distance is not None and d > max_distance:
        return max_distance + 1
    return d


# --------------------------------------------------------------------------
# Natural sort
# --------------------------------------------------------------------------

def natural_sort_key(value):
    """Sort key that orders digit runs numerically: "Lot 2" < "Lot 10".

    Digits are folded to ASCII first (Arabic-Indic digits sort as numbers),
    text chunks are compared casefolded, and the raw text is the last
    tie-break, so the order is total and deterministic ("7" < "007" < "07"
    is decided by the raw strings). ``None`` sorts before every text;
    non-text values are converted with ``value_to_text``. Signs and decimal
    points are not interpreted ("1.5" is 1, ".", 5).
    """
    if value is None:
        return (0, (), u"")
    raw = value_to_text(value)
    text = fold_digits(raw)
    chunks = []
    i = 0
    n = len(text)
    while i < n:
        j = i
        if text[i].isascii() and text[i].isdigit():
            while j < n and text[j].isascii() and text[j].isdigit():
                j += 1
            chunks.append((0, int(text[i:j]), u""))
        else:
            while j < n and not (text[j].isascii() and text[j].isdigit()):
                j += 1
            chunks.append((1, 0, text[i:j].casefold()))
        i = j
    return (1, tuple(chunks), raw)


# ==========================================================================
# common/issues.py
# ==========================================================================
# Unified QC issue schema and the adapters that fill it (pure Python, no arcpy).
#
# The QC Scorecard Report reads the Detail outputs of the toolkit's quality tools and
# turns every row into one *issue*, a plain dict with the keys of
# ``UNI_FIELDS`` (``RUN_ID`` is added by the caller)::
#
#     TOOL, RULE_ID, SOURCE, SRC_OID, SEVERITY, X, Y, MESSAGE, FIELD, VALUE
#
# There is **one adapter function per tool**; none of the tools is changed. The column
# names an adapter expects are the REAL names ArcGIS Pro wrote in the captured
# outputs (``tests/fixtures/pro/<Tool>/<case>/``), not names taken from documents:
#
# =========================  =======================================================
# GeometryQualityChecker     SRC_OID, CHECK, PART, VERTEX, VALUE, UNIT, DETAIL
#                            (point feature class; location = the point)
# DomainConformanceAudit     SRC_TABLE, SRC_OID, FIELD, SUBTYPE_CODE, DOMAIN, VALUE,
#                            ISSUE, SUGGESTED (table: no location of its own)
# LineNetworkRules           RULE, LAYER, SRC_OID, NODE_ID, DEGREE, VALUE, DETAIL
#                            (point feature class; location = the point)
# unified table              RULE_ID, SEVERITY, MESSAGE and SRC_OID (or OID); optional
#                            RUN_ID, TOOL, SOURCE, X, Y, FIELD, VALUE
# =========================  =======================================================
#
# A row given to an adapter is a dict ``{column name: value}`` plus the special keys
# ``"_xy"`` (``(x, y)`` taken from the row's geometry, or ``None``). Columns an
# adapter does not know are not lost: they are appended to MESSAGE as ``NAME=value``.
#
# The tools write no severity. ``UNI_SEVERITY_BY_RULE`` is this toolkit's own default
# classification (a judgement, not a standard); the Atlas lets a threshold table
# override it per rule.

UNI_TOOL_GEOMETRY = "GeometryQualityChecker"
UNI_TOOL_DOMAIN = "DomainConformanceAudit"
UNI_TOOL_NETWORK = "LineNetworkRules"
UNI_TOOL_UNIFIED = "UNIFIED"
UNI_TOOLS = (UNI_TOOL_GEOMETRY, UNI_TOOL_DOMAIN, UNI_TOOL_NETWORK, UNI_TOOL_UNIFIED)
UNI_TOOL_AUTO = "AUTO"

UNI_ERROR = "ERROR"
UNI_WARNING = "WARNING"
UNI_INFO = "INFO"
UNI_SEVERITIES = (UNI_ERROR, UNI_WARNING, UNI_INFO)

# Column order of the unified issue table. The handoff calls the object id column OID;
# the toolkit's own outputs all call it SRC_OID and OID is not used as a field name here.
UNI_FIELDS = ("RUN_ID", "TOOL", "RULE_ID", "SOURCE", "SRC_OID", "SEVERITY", "X", "Y",
              "MESSAGE", "FIELD", "VALUE")

UNI_MESSAGE_MAX = 1000   # characters kept in MESSAGE
UNI_VALUE_MAX = 254      # characters kept in VALUE / FIELD / SOURCE / RULE_ID

# Default severity per rule (the tools write none). Unknown rules: UNI_DEFAULT_SEVERITY.
UNI_DEFAULT_SEVERITY = UNI_WARNING
UNI_SEVERITY_BY_RULE = {
    # GeometryQualityChecker
    "SPIKE": UNI_ERROR,
    "NEAR_DUP_VERTEX": UNI_ERROR,
    "SHORT_SEGMENT": UNI_WARNING,
    "SLIVER": UNI_WARNING,
    "TINY_AREA": UNI_WARNING,
    "TINY_PART": UNI_WARNING,
    "REMOTE_PART": UNI_WARNING,
    # DomainConformanceAudit: the stored value is not a valid code of its domain
    "OUT_OF_DOMAIN": UNI_ERROR,
    "OUT_OF_RANGE": UNI_ERROR,
    "DESCRIPTION_AS_CODE": UNI_ERROR,
    "CASE_OR_SPACE_VARIANT": UNI_ERROR,
    "AMBIGUOUS_DESCRIPTION": UNI_ERROR,
    "INVALID_SUBTYPE": UNI_ERROR,
    "NULL_VALUE": UNI_WARNING,
    # LineNetworkRules
    "DANGLE": UNI_ERROR,
    "PSEUDO_NODE": UNI_WARNING,
    "T_MISS": UNI_ERROR,
    "WIDE_NODE_CLUSTER": UNI_WARNING,
    "POINT_NOT_ON_LINE": UNI_ERROR,
    "POINT_NOT_ON_ENDPOINT": UNI_ERROR,
}

# Columns that belong to the table itself, never to the issue.
_UNI_SYSTEM_COLUMNS = frozenset(["OBJECTID", "FID", "SHAPE", "SHAPE_LENGTH", "SHAPE_AREA",
                                 "SHAPE_LEN", "GLOBALID", "OID@", "SHAPE@", "SHAPE@JSON"])

# Required columns (upper case) per tool; a table is recognised as the first whose
# required columns are all present (unified first, then the others).
_UNI_REQUIRED = (
    (UNI_TOOL_UNIFIED, ("RULE_ID", "SEVERITY", "MESSAGE")),
    (UNI_TOOL_GEOMETRY, ("SRC_OID", "CHECK", "DETAIL")),
    (UNI_TOOL_DOMAIN, ("SRC_TABLE", "SRC_OID", "FIELD", "DOMAIN", "VALUE", "ISSUE")),
    (UNI_TOOL_NETWORK, ("RULE", "LAYER", "SRC_OID", "DETAIL")),
)
# Known (consumed) columns per tool; everything else goes to MESSAGE.
_UNI_KNOWN = {
    UNI_TOOL_GEOMETRY: ("SRC_OID", "CHECK", "PART", "VERTEX", "VALUE", "UNIT", "DETAIL"),
    UNI_TOOL_DOMAIN: ("SRC_TABLE", "SRC_OID", "FIELD", "SUBTYPE_CODE", "DOMAIN", "VALUE",
                      "ISSUE", "SUGGESTED"),
    UNI_TOOL_NETWORK: ("RULE", "LAYER", "SRC_OID", "NODE_ID", "DEGREE", "VALUE", "DETAIL"),
    UNI_TOOL_UNIFIED: ("RUN_ID", "TOOL", "RULE_ID", "SOURCE", "SRC_OID", "OID", "SEVERITY",
                       "X", "Y", "MESSAGE", "FIELD", "VALUE"),
}
# The hygiene table of DomainConformanceAudit (out_domain_table) is a different output.
_UNI_DOMAIN_HYGIENE = ("DOMAIN", "RECORD_TYPE", "ISSUE")


def uni_clean_text(value, limit=None):
    """Text for a table or an HTML page: ``None`` stays ``None``; control characters
    (except tab and line breaks, which become spaces) are removed; the text is cut to
    ``limit`` characters with an ellipsis."""
    if value is None:
        return None
    if isinstance(value, float):
        text = uni_format_number(value)
    else:
        text = str(value)
    out = []
    for ch in text:
        if ch in "\t\r\n":
            out.append(" ")
        elif ord(ch) < 32 or ord(ch) in (127, 0xFFFE, 0xFFFF) or 0xD800 <= ord(ch) <= 0xDFFF:
            continue
        else:
            out.append(ch)
    text = "".join(out).strip()
    if limit is not None and len(text) > limit:
        text = text[:max(limit - 3, 0)] + "..."
    return text


def uni_format_number(value):
    """Short text of a number (6 significant digits); other values as text."""
    if isinstance(value, bool):
        return str(value)
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        if math.isnan(value) or math.isinf(value):
            return ""
        return "{0:.6g}".format(value)
    return str(value)


def uni_normalise_severity(value, default=UNI_DEFAULT_SEVERITY):
    """``ERROR`` / ``WARNING`` / ``INFO`` from any capitalisation (``WARN`` too);
    ``(severity, recognised)`` where ``recognised`` is False when ``default`` was used."""
    text = str(value).strip().upper() if value is not None else ""
    aliases = {"ERR": UNI_ERROR, "CRITICAL": UNI_ERROR, "WARN": UNI_WARNING,
               "INFORMATION": UNI_INFO, "NOTE": UNI_INFO}
    text = aliases.get(text, text)
    if text in UNI_SEVERITIES:
        return text, True
    return default, False


def uni_severity_for(rule_id):
    """Default severity of a rule id (``UNI_DEFAULT_SEVERITY`` for an unknown rule)."""
    return UNI_SEVERITY_BY_RULE.get(str(rule_id).strip().upper(), UNI_DEFAULT_SEVERITY)


def _uni_upper_row(row):
    """``{UPPER NAME: value}`` of the attribute columns of a row (special keys dropped)."""
    return dict((str(k).upper(), v) for k, v in row.items() if not str(k).startswith("_"))


def uni_detect_tool(columns):
    """Which tool's Detail output (or the unified schema) a table with these column
    names is; ``None`` when none matches. Names are compared in upper case."""
    names = set(str(c).upper() for c in columns)
    if "OID" in names and "SRC_OID" not in names:
        names.add("SRC_OID")   # the unified schema as the handoff spells it
    for tool, required in _UNI_REQUIRED:
        if all(name in names for name in required):
            return tool
    return None


def uni_missing_columns(tool, columns):
    """Required columns (upper case) of ``tool`` that a table with ``columns`` lacks."""
    names = set(str(c).upper() for c in columns)
    if "OID" in names and "SRC_OID" not in names:
        names.add("SRC_OID")
    for name, required in _UNI_REQUIRED:
        if name == tool:
            return [c for c in required if c not in names]
    return []


def uni_is_domain_hygiene_table(columns):
    """True for the usage / hygiene table of DomainConformanceAudit (not an issue table)."""
    names = set(str(c).upper() for c in columns)
    return all(name in names for name in _UNI_DOMAIN_HYGIENE) and "SRC_OID" not in names


def uni_describe_columns_needed():
    """Text for an error message: the columns each supported table must have."""
    parts = []
    for tool, required in _UNI_REQUIRED:
        parts.append("{0}: {1}".format("unified issue table" if tool == UNI_TOOL_UNIFIED else tool,
                                       ", ".join(required)))
    return "; ".join(parts)


def _uni_extras(upper_row, tool):
    """Text ``NAME=value`` of the columns the adapter does not know (empty values skipped)."""
    known = set(_UNI_KNOWN[tool])
    parts = []
    for name in sorted(upper_row):
        if name in known or name in _UNI_SYSTEM_COLUMNS:
            continue
        value = upper_row[name]
        if value is None or (isinstance(value, str) and not value.strip()):
            continue
        parts.append("{0}={1}".format(name, uni_clean_text(value, 80)))
    return "; ".join(parts)


def _uni_message(text, extras, rule_id):
    text = uni_clean_text(text) or ""
    if not text:
        text = str(rule_id)
    if extras:
        text = "{0} [{1}]".format(text, extras)
    return uni_clean_text(text, UNI_MESSAGE_MAX)


def _uni_xy(row):
    xy = row.get("_xy")
    if xy is None:
        return None, None
    try:
        x, y = float(xy[0]), float(xy[1])
    except (TypeError, ValueError, IndexError):
        return None, None
    if math.isnan(x) or math.isnan(y) or math.isinf(x) or math.isinf(y):
        return None, None
    return x, y


def _uni_int(value):
    try:
        if value is None or (isinstance(value, str) and not value.strip()):
            return None
        if isinstance(value, int) and not isinstance(value, bool):
            return value
        if isinstance(value, str):
            try:
                # a text ObjectID field (``arcio.oid_field_spec`` in a folder) keeps every digit;
                # float() would round ids of more than 15 digits
                return int(value.strip())
            except ValueError:
                pass
        return int(float(value))
    except (TypeError, ValueError, OverflowError):
        return None


def _uni_issue(tool, rule_id, source, oid, severity, x, y, message, field, value,
               sev_from="default"):
    """One issue. ``_sev_from`` says where the severity came from: ``default`` (the toolkit's
    default for the rule; the source tools write none), ``table`` (a unified table's own
    SEVERITY column) or ``guess`` (an unrecognised value, taken as WARNING)."""
    return {"_sev_from": sev_from, "TOOL": tool,
            "RULE_ID": uni_clean_text(rule_id, UNI_VALUE_MAX) or "UNKNOWN",
            "SOURCE": uni_clean_text(source, UNI_VALUE_MAX),
            "SRC_OID": oid, "SEVERITY": severity, "X": x, "Y": y,
            "MESSAGE": message,
            "FIELD": uni_clean_text(field, UNI_VALUE_MAX),
            "VALUE": uni_clean_text(value, UNI_VALUE_MAX)}


def adapt_geometry_quality(rows, source=None):
    """GeometryQualityChecker ``out_features`` rows -> issues.

    RULE_ID = CHECK; SOURCE = ``source`` (the checked dataset; the tool's output carries no
    dataset name); SRC_OID = SRC_OID; X, Y = the error point; MESSAGE = DETAIL;
    VALUE = VALUE + UNIT (for example ``2.29153 deg``). PART and VERTEX are only in DETAIL.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("CHECK")
        severity = uni_severity_for(rule)
        x, y = _uni_xy(row)
        value = r.get("VALUE")
        value_text = None
        if value is not None and uni_format_number(value) != "":
            value_text = uni_format_number(value)
            if r.get("UNIT"):
                value_text += " " + str(r["UNIT"])
        message = _uni_message(r.get("DETAIL"), _uni_extras(r, UNI_TOOL_GEOMETRY), rule)
        out.append(_uni_issue(UNI_TOOL_GEOMETRY, rule, source, _uni_int(r.get("SRC_OID")),
                              severity, x, y, message, None, value_text))
    return out


_UNI_DOMAIN_TEXT = {
    "OUT_OF_DOMAIN": "is not a code of domain {domain}",
    "OUT_OF_RANGE": "is outside the range of domain {domain}",
    "DESCRIPTION_AS_CODE": "is the description of a code of domain {domain}, not the code",
    "CASE_OR_SPACE_VARIANT": "differs from a code of domain {domain} only by case or spaces",
    "AMBIGUOUS_DESCRIPTION": "matches more than one description of domain {domain}",
    "INVALID_SUBTYPE": "is not a defined subtype",
    "NULL_VALUE": "is empty although domain {domain} applies",
}


def adapt_domain_conformance(rows, source=None):
    """DomainConformanceAudit ``out_table`` rows (violations) -> issues.

    RULE_ID = ISSUE; SOURCE = SRC_TABLE (``source`` only when that is empty); SRC_OID = SRC_OID;
    FIELD = FIELD; VALUE = VALUE; MESSAGE is built from the columns (field, value, domain,
    subtype, suggestion). The table has no geometry, so X and Y are empty unless the caller
    locates the feature later (``QcScorecardAtlas`` does, from the checked dataset).
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("ISSUE")
        field = r.get("FIELD")
        value = r.get("VALUE")
        domain = r.get("DOMAIN")
        template = _UNI_DOMAIN_TEXT.get(str(rule).strip().upper() if rule is not None else "",
                                        "has the issue " + str(rule))
        shown = "empty" if value is None else "'{0}'".format(uni_clean_text(value, 120))
        text = "Field {0}: value {1} {2}".format(field, shown,
                                                 template.format(domain=domain or "(none)"))
        if r.get("SUBTYPE_CODE") is not None and uni_format_number(r["SUBTYPE_CODE"]) != "":
            text += " (subtype {0})".format(uni_format_number(r["SUBTYPE_CODE"]))
        if r.get("SUGGESTED") not in (None, ""):
            text += "; suggested: {0}".format(uni_clean_text(r["SUGGESTED"], 80))
        message = _uni_message(text + ".", _uni_extras(r, UNI_TOOL_DOMAIN), rule)
        table = r.get("SRC_TABLE")
        x, y = _uni_xy(row)
        out.append(_uni_issue(UNI_TOOL_DOMAIN, rule, table if table not in (None, "") else source,
                              _uni_int(r.get("SRC_OID")), uni_severity_for(rule), x, y, message,
                              field, value))
    return out


def adapt_line_network_rules(rows, source=None):
    """LineNetworkRules ``out_errors`` rows -> issues.

    RULE_ID = RULE; SOURCE = LAYER (``source`` only when that is empty; point-rule rows name
    the rule-point layer); SRC_OID = SRC_OID; X, Y = the error point; MESSAGE = DETAIL;
    VALUE = VALUE (metres) when present. NODE_ID and DEGREE are not carried.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("RULE")
        x, y = _uni_xy(row)
        value = r.get("VALUE")
        value_text = None
        if value is not None and uni_format_number(value) != "":
            value_text = uni_format_number(value) + " m"
        layer = r.get("LAYER")
        message = _uni_message(r.get("DETAIL"), _uni_extras(r, UNI_TOOL_NETWORK), rule)
        out.append(_uni_issue(UNI_TOOL_NETWORK, rule, layer if layer not in (None, "") else source,
                              _uni_int(r.get("SRC_OID")), uni_severity_for(rule), x, y, message,
                              None, value_text))
    return out


def adapt_unified(rows, source=None):
    """Rows already in the unified schema -> issues.

    SEVERITY is normalised (an unrecognised one becomes WARNING and the issue gets
    ``"_severity_guess": True``). X and Y come from the columns X and Y, else from the row's
    geometry. TOOL defaults to ``UNIFIED``; SOURCE to ``source``. RUN_ID is not carried.
    """
    out = []
    for row in rows:
        r = _uni_upper_row(row)
        rule = r.get("RULE_ID")
        severity, recognised = uni_normalise_severity(r.get("SEVERITY"))
        x, y = None, None
        try:
            if r.get("X") is not None and r.get("Y") is not None:
                x, y = float(r["X"]), float(r["Y"])
                if math.isnan(x) or math.isnan(y) or math.isinf(x) or math.isinf(y):
                    x, y = None, None
        except (TypeError, ValueError):
            x, y = None, None
        if x is None:
            x, y = _uni_xy(row)
        oid = _uni_int(r.get("SRC_OID") if r.get("SRC_OID") is not None else r.get("OID"))
        tool = uni_clean_text(r.get("TOOL"), UNI_VALUE_MAX) or UNI_TOOL_UNIFIED
        extras = _uni_extras(r, UNI_TOOL_UNIFIED)
        message = _uni_message(r.get("MESSAGE"), extras, rule)
        src = r.get("SOURCE")
        issue = _uni_issue(tool, rule, src if src not in (None, "") else source, oid, severity,
                           x, y, message, r.get("FIELD"), r.get("VALUE"),
                           "table" if recognised else "guess")
        if not recognised:
            issue["_severity_guess"] = True
        out.append(issue)
    return out


UNI_ADAPTERS = {UNI_TOOL_GEOMETRY: adapt_geometry_quality,
                UNI_TOOL_DOMAIN: adapt_domain_conformance,
                UNI_TOOL_NETWORK: adapt_line_network_rules,
                UNI_TOOL_UNIFIED: adapt_unified}


def uni_adapt(tool, rows, source=None):
    """Issues of ``rows`` with the adapter of ``tool`` (one of ``UNI_TOOLS``)."""
    return UNI_ADAPTERS[tool](rows, source)


def uni_issue_row(issue, run_id):
    """Values of one issue in ``UNI_FIELDS`` order (for the output table)."""
    values = dict(issue)
    values["RUN_ID"] = run_id
    return [values.get(name) for name in UNI_FIELDS]


# ==========================================================================
# common/fields.py
# ==========================================================================
# Field lookup that tolerates the way people actually type field names.
#
# Rule (toolkit engineering rule 1): match the **alias first, then the name**,
# ignoring case, spaces, dashes and underscores. The caller is told which one
# matched so it can report it. Two or more candidates is an error that lists them;
# the tool never guesses.
#
# Fields are plain dicts as returned by ``arcio.describe_dataset``::
#
#     {"name": "NAME_EN", "alias": "Name (English)", "type": "String",
#      "length": 50, "domain": None, ...}

# Characters ignored when comparing field names (besides all Unicode whitespace).
_FIELDS_IGNORED = frozenset("-_‐‑‒–—ـ")  # dashes, underscore, Arabic tatweel

MATCHED_BY_ALIAS = "alias"
MATCHED_BY_NAME = "name"


def normalize_field_name(text):
    """Comparison key for a field name or alias.

    NFKC-normalises (so Arabic presentation forms and full-width Latin compare
    equal to their plain forms), case-folds, and drops whitespace, dashes,
    underscores and the Arabic tatweel.
    """
    if text is None:
        return ""
    text = unicodedata.normalize("NFKC", str(text)).casefold()
    return "".join(ch for ch in text if not ch.isspace() and ch not in _FIELDS_IGNORED)


def describe_field(field):
    """Human readable ``NAME (alias: Alias)`` label for messages."""
    alias = field.get("alias")
    if alias and alias != field["name"]:
        return "{0} (alias: {1})".format(field["name"], alias)
    return field["name"]


def match_field(fields, wanted, required=True, label=None, exact_name_first=False):
    """Find the field the user means by ``wanted``.

    Returns ``(field, matched_by)`` where ``matched_by`` is ``"alias"`` or
    ``"name"``; returns ``(None, None)`` when nothing matches and ``required``
    is False. Raises ``ToolError`` for an ambiguous match, or for no match when
    ``required`` is True. ``label`` names the parameter in messages.

    ``exact_name_first``: use it when ``wanted`` comes from a ``Field``
    parameter (a field *name* picked from the list). A field whose name equals
    ``wanted`` exactly (then ignoring case only) wins before any alias, so a
    different field that merely carries that text as its alias is never used.
    Rule 1 (alias first, tolerant comparison) still applies when nothing has
    that exact name, e.g. for typed or configured names.
    """
    if exact_name_first and wanted:
        for same in (lambda n: n == wanted, lambda n: n.casefold() == str(wanted).casefold()):
            hits = [f for f in fields if f.get("name") is not None and same(f["name"])]
            if len(hits) == 1:
                return hits[0], MATCHED_BY_NAME
    key = normalize_field_name(wanted)
    what = label or "field"
    if not key:
        if required:
            raise ToolError("No {0} was given.".format(what),
                            "Choose a field from the list.")
        return None, None

    for matched_by, attr in ((MATCHED_BY_ALIAS, "alias"), (MATCHED_BY_NAME, "name")):
        hits = [f for f in fields if normalize_field_name(f.get(attr)) == key]
        if len(hits) == 1:
            return hits[0], matched_by
        if len(hits) > 1:
            raise ToolError(
                "The {0} '{1}' is ambiguous: it matches the {2} of {3} fields: {4}.".format(
                    what, wanted, attr, len(hits), ", ".join(describe_field(f) for f in hits)),
                "Type the exact field name instead, or rename one of the fields or aliases.")

    if required:
        available = ", ".join(describe_field(f) for f in fields) or "(none)"
        raise ToolError(
            "The {0} '{1}' was not found by alias or by name.".format(what, wanted),
            "Choose one of the available fields: {0}.".format(available))
    return None, None


def match_fields(fields, wanted_names, label=None, exact_name_first=False):
    """Resolve several required fields at once.

    Returns a list of ``(wanted, field, matched_by)`` in the given order.
    """
    return [(w,) + match_field(fields, w, True, label, exact_name_first) for w in wanted_names]


def match_message(wanted, field, matched_by):
    """Message text reporting how a field was resolved."""
    return "Field '{0}' matched {1} by {2}.".format(wanted, describe_field(field), matched_by)


def text_field_length(values, minimum=1):
    """Width for a text field that must hold every value in ``values``.

    ``None`` values are ignored; other values are measured as ``str(value)``.
    Engineering rule 8: text widths are derived from the longest value written.
    """
    longest = 0
    for value in values:
        if value is not None:
            longest = max(longest, len(str(value)))
    return max(int(minimum), longest)


# ==========================================================================
# common/domains.py
# ==========================================================================
# Coded-value and range domains, at field AND subtype level, as plain dicts.
#
# Engineering rule 2: read domains at field and subtype level, never guess a
# code, and when a needed value is not in the domain stop with a message that
# lists the accepted values.
#
# Structures (built by ``arcio.read_domains`` / ``arcio.read_subtypes``, or by
# hand in tests)::
#
#     domains = {"D_Status": {"name": "D_Status", "domain_type": "CodedValue",
#                             "field_type": "Short",
#                             "codes": {1: "Active", 2: "Retired"},
#                             "range": None}}
#
#     subtypes = {"field": "ROAD_CLASS",          # "" when the table has no subtypes
#                 "subtypes": {1: {"name": "Primary",
#                                  "domains": {"SURFACE": "D_Surface_Primary"}}}}
#
# Field-level domains come from the field dicts (``field["domain"]``).

_DOMAINS_NUMERIC_TYPES = frozenset(
    ["short", "long", "smallinteger", "integer", "biginteger", "float", "single", "double"])


def domain_for_field(field_name, field_domain, subtypes=None, subtype_code=None):
    """Name of the domain that applies to ``field_name`` for one row.

    If the table has a subtype field and ``subtype_code`` is one of its
    subtypes that lists this field, the subtype-level domain wins (``None``
    there means the subtype deliberately has no domain). Otherwise the
    field-level domain ``field_domain`` applies.
    """
    if subtypes and subtypes.get("field") and subtype_code is not None:
        entry = _domains_find_subtype(subtypes, subtype_code)
        if entry is not None:
            per_field = entry.get("domains") or {}
            for name, dom in per_field.items():
                if name.casefold() == str(field_name).casefold():
                    return dom or None
    return field_domain or None


def _domains_find_subtype(subtypes, code):
    table = subtypes.get("subtypes") or {}
    if code in table:
        return table[code]
    for key, entry in table.items():
        if _domains_same_value(key, code, numeric=True):
            return entry
    return None


def _domains_is_numeric(domain):
    return str(domain.get("field_type") or "").casefold() in _DOMAINS_NUMERIC_TYPES


def _domains_same_value(a, b, numeric):
    """Equality that treats 1, 1.0 and "1" as equal for numeric domains only."""
    if a is None or b is None:
        return a is b
    if numeric:
        # exact_number, not float(): BigInteger codes above 2**53 stay distinct.
        na, nb = exact_number(a), exact_number(b)
        return na is not None and na == nb
    return str(a) == str(b)


def accepted_values_text(domain, limit=50):
    """``code = description`` list for messages (truncated after ``limit``)."""
    if domain.get("domain_type") == "Range":
        low, high = domain.get("range") or (None, None)
        return "a value from {0} to {1}".format(low, high)
    pairs = ["{0} = {1}".format(c, d) for c, d in (domain.get("codes") or {}).items()]
    if len(pairs) > limit:
        pairs = pairs[:limit] + ["... ({0} more)".format(len(pairs) - limit)]
    return "; ".join(pairs) if pairs else "(the domain has no codes)"


class CodedValueIndex(object):
    """Set of the codes of one coded-value domain, built once.

    ``value in index`` gives the same answer as ``value_in_domain`` (numbers
    compared exactly for numeric domains, so "1", 1 and 1.0 are equal; text
    compared as text) in constant time instead of a scan over every code.
    """

    def __init__(self, domain):
        self.numeric = _domains_is_numeric(domain)
        self.keys = set()
        for code in (domain.get("codes") or {}):
            key = self._key(code)
            if key is not None:
                self.keys.add(key)

    def _key(self, value):
        if value is None:
            return None
        return exact_number(value) if self.numeric else str(value)

    def __contains__(self, value):
        key = self._key(value)
        return key is not None and key in self.keys


def value_in_domain(domain, value, index=None):
    """True if ``value`` is allowed by ``domain``. Nulls are not violations.

    ``index`` (a ``CodedValueIndex`` of a coded-value ``domain``) makes the
    test a dictionary lookup; pass it when testing many values.
    """
    if value is None or domain is None:
        return True
    numeric = _domains_is_numeric(domain)
    if domain.get("domain_type") == "Range":
        low, high = domain.get("range") or (None, None)
        lo, hi, number = exact_number(low), exact_number(high), exact_number(value)
        if lo is None or hi is None or number is None:
            return False
        return lo <= number <= hi
    if index is not None:
        return value in index
    return any(_domains_same_value(code, value, numeric) for code in (domain.get("codes") or {}))


def code_description(domain, code):
    """Description of ``code`` or ``None`` if it is not in the domain."""
    numeric = _domains_is_numeric(domain)
    for key, desc in (domain.get("codes") or {}).items():
        if _domains_same_value(key, code, numeric):
            return desc
    return None


def require_code(domain, value, field_name=None):
    """Return the stored code for ``value``, which may be a code or a description.

    Codes are tried first (exact type-aware match), then descriptions
    (case-insensitive). Raises ``ToolError`` listing the accepted values when
    there is no match, or when a description matches more than one code.
    """
    where = " for field '{0}'".format(field_name) if field_name else ""
    name = domain.get("name", "?")
    if domain.get("domain_type") == "Range":
        if value_in_domain(domain, value) and value is not None:
            return value
        raise ToolError(
            "The value '{0}'{1} is outside the range domain '{2}'.".format(value, where, name),
            "Use {0}.".format(accepted_values_text(domain)))
    numeric = _domains_is_numeric(domain)
    codes = domain.get("codes") or {}
    for code in codes:
        if _domains_same_value(code, value, numeric):
            return code
    wanted = str(value).strip().casefold()
    hits = [code for code, desc in codes.items() if str(desc).strip().casefold() == wanted]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        raise ToolError(
            "The description '{0}'{1} matches several codes in domain '{2}': {3}.".format(
                value, where, name, ", ".join(str(h) for h in hits)),
            "Give the code itself instead of the description.")
    raise ToolError(
        "The value '{0}'{1} is not in the coded-value domain '{2}'.".format(value, where, name),
        "Use one of the accepted values: {0}.".format(accepted_values_text(domain)))


# --------------------------------------------------------------------------
# Domains of fields copied to a new output
# --------------------------------------------------------------------------

def domain_fits_field_type(domain, keyword):
    """True when an output-workspace domain (``arcio.read_domains`` entry) can be
    assigned to a field of AddField type ``keyword`` (same field type, or a type
    that is not reported)."""
    field_type = str((domain or {}).get("field_type") or "")
    return not field_type or field_type.casefold() == str(keyword).casefold()


def keep_field_domain(spec, domain_name, out_domains):
    """Carry the field-level domain ``domain_name`` of a copied field to its
    output field spec (for ``arcio.add_fields``), as Copy Features does.

    ``out_domains``: the domains of the output workspace (``arcio.read_domains``
    / ``arcio.read_output_domains``; ``{}`` for a folder). The spec gets
    ``"domain"`` when that workspace has a domain of that name for the spec's
    field type, else ``"lost_domain"`` (see ``lost_domain_warning``). No domain:
    the spec is unchanged. Subtypes and subtype-level domains are not carried.
    Returns ``spec``.
    """
    if domain_name:
        if out_domains is not None and domain_name in out_domains and \
                domain_fits_field_type(out_domains[domain_name], spec["type"]):
            spec["domain"] = domain_name
        else:
            spec["lost_domain"] = domain_name
    return spec


def lost_domain_warning(specs, output):
    """Warning text, or ``None``, naming the copied fields of ``specs``
    (``keep_field_domain``) whose domain the output workspace of ``output`` does
    not have (same rule and wording as the datamgmt tools)."""
    lost = ["{0} ({1})".format(s["name"], s["lost_domain"]) for s in specs
            if s.get("lost_domain")]
    if not lost:
        return None
    return ("The workspace of {0} does not have the domain(s) of these copied fields (or has "
            "one of that name for another field type), so they have no domain there and show "
            "codes instead of descriptions: {1}. Add the domains to the output geodatabase and "
            "assign them (Assign Domain To Field), or write the output to the input's "
            "geodatabase.".format(output, ", ".join(lost)))


# ==========================================================================
# common/paths.py
# ==========================================================================
# Catalog path handling that never relies on the host operating system.
#
# Engineering rule 4: never destroy input. Before any delete or overwrite the
# tool compares normalised catalog paths and refuses if an output equals an
# input. ``os.path.normcase`` does nothing outside Windows, so normalisation is
# done by hand: separators, duplicate separators, trailing separators, ``.`` and
# ``..`` segments, Unicode form and case.

# Path components that end a workspace (everything after them is inside it).
_PATHS_WORKSPACE_EXTS = (".gdb", ".sde", ".gpkg", ".geodatabase", ".mdb")


def normalize_catalog_path(path):
    """Comparison key for a catalog path; not meant to be shown to users.

    ``C:/Data//City.GDB/Roads/`` and ``c:\\data\\city.gdb\\roads`` give the same key.
    """
    if path is None:
        return ""
    text = unicodedata.normalize("NFC", str(path).strip()).replace("/", "\\")
    unc = text.startswith("\\\\")
    parts = []
    for part in text.split("\\"):
        if part in ("", "."):
            continue
        if part == ".." and parts and parts[-1] != "..":
            parts.pop()
            continue
        parts.append(part)
    joined = "\\".join(parts)
    if unc:
        joined = "\\\\" + joined
    return joined.casefold()


# Files that belong to one shapefile / dBASE table in a folder workspace. In a
# folder, ``name``, ``name.shp`` and ``name.dbf`` (and every sidecar) are one
# dataset: Pro writes a table ``folder\name`` as ``name.dbf`` and a feature
# class as ``name.shp`` + ``name.shx`` + ``name.dbf`` + ...
FOLDER_DATASET_EXTS = (".shp", ".dbf", ".shx", ".prj", ".cpg", ".sbn", ".sbx", ".qix", ".fbn",
                       ".fbx", ".ain", ".aih", ".atx", ".ixs", ".mxs", ".xml")


def _paths_folder_stem(name):
    """Base name without shapefile/dBASE extensions (``roads.shp.xml`` -> ``roads``)."""
    text = str(name)
    while True:
        dot = text.rfind(".")
        if dot <= 0 or text[dot:].casefold() not in FOLDER_DATASET_EXTS:
            return text
        text = text[:dot]


def dataset_identity(path):
    """Canonical identity of the dataset a catalog path names (comparison key).

    * Geodatabase (and memory) datasets: ``<workspace>\\<name>``, ignoring case
      and separators; feature datasets are transparent (names are unique in a
      geodatabase), so ``a.gdb\\fds\\roads`` == ``a.gdb\\roads``.
    * Folder workspaces: ``<folder>\\<base name>`` without shapefile/dBASE
      extensions, so ``t``, ``t.dbf``, ``T.DBF``, ``t.shp`` and ``t.shx`` are the
      same dataset (they share one file set, and Pro resolves ``t`` to
      ``t.dbf`` / ``t.shp``). Other files (``t.csv``) keep their extension.
    * GeoPackage: ``x.gpkg\\main.roads`` (the way ArcGIS Pro lists it) and ``x.gpkg\\roads``
      are the same dataset.
    * A workspace path itself is its own identity.
    Returns ``""`` for an empty path.
    """
    if path is None or not str(path).strip():
        return ""
    text = str(path).strip()
    workspace = workspace_of(text)
    key = normalize_catalog_path(text)
    if not workspace or normalize_catalog_path(workspace) == key:
        return key
    name = split_catalog_path(text)[1]
    if is_folder_workspace(workspace):
        name = _paths_folder_stem(name)
    elif normalize_catalog_path(workspace).endswith(".gpkg") and name.casefold().startswith("main."):
        name = name[len("main."):]  # GeoPackage datasets are listed as <file>.gpkg\\main.<name>
    return normalize_catalog_path(workspace + "\\" + name)


def folder_dataset_candidates(path):
    """Paths an output may really occupy: for a folder output without a
    shapefile/dBASE extension, also ``.shp`` and ``.dbf`` (Pro adds one)."""
    text = str(path)
    workspace, name = split_catalog_path(text)
    if workspace and is_folder_workspace(workspace) and _paths_folder_stem(name) == name \
            and "." not in name:
        return [text, text + ".shp", text + ".dbf"]
    return [text]


def same_dataset(a, b):
    """True if two catalog paths name the same dataset (``dataset_identity``)."""
    key_a = dataset_identity(a)
    return bool(key_a) and key_a == dataset_identity(b)


# Run-scoped register of every dataset/file the running tool reads (quality review
# D1/D2: an input that a tool forgot to pass in ``inputs`` was overwritten). While a
# run is active (``arcio.guarded_run`` around ``execute``), ``refuse_if_same`` and the
# report checks compare outputs with these paths too, so a forgotten input can no
# longer be replaced. Outside a run (dialog validation) nothing is registered.
#
# Tables joined to an input layer are registered too, by NAME only: a layer reports
# the catalog path of its own table, never of the tables joined to it, so an
# output or report named like a joined table is refused in any workspace
# (conservative; re-review N1 of LineNetworkRules, first done in carto only).
_PATHS_RUN = {"active": False, "inputs": [], "joined": set()}

# Extensions of file tables a join can read (a qualifier such as ``valves.csv``).
_PATHS_JOIN_FILE_EXTS = ("csv", "txt", "tab", "dbf", "shp", "xls", "xlsx")


def begin_input_register():
    """Start a run: clear and activate the register of read datasets."""
    _PATHS_RUN["active"] = True
    _PATHS_RUN["inputs"] = []
    _PATHS_RUN["joined"] = set()


def end_input_register():
    """End a run: clear and deactivate the register."""
    _PATHS_RUN["active"] = False
    _PATHS_RUN["inputs"] = []
    _PATHS_RUN["joined"] = set()


def joined_table_names(fields):
    """Case-folded names of the tables a layer reads through joins.

    With a join, a layer's fields are qualified ``<table>.<field>`` (an enterprise
    table ``db.owner.table.field``); the table name is the last part before the
    field. The layer's own table is listed too (its fields are qualified as well).
    For a file table (``valves.csv.FIELD``) the file name and its stem are listed
    as well. A layer without qualified field names gives an empty set. ``fields``
    are dicts with a ``"name"`` (``arcio.field_info``) or objects with ``.name``.
    """
    names = set()
    for field in fields or []:
        name = (field.get("name") if isinstance(field, dict) else getattr(field, "name", "")) or ""
        if "." in name:
            qualifier = name.rsplit(".", 1)[0]
            pieces = qualifier.split(".")
            table = pieces[-1].strip()
            if table:
                names.add(table.casefold())
            if len(pieces) > 1 and table.casefold() in _PATHS_JOIN_FILE_EXTS and pieces[-2].strip():
                names.add((pieces[-2].strip() + "." + table).casefold())
                names.add(pieces[-2].strip().casefold())
    return names


def register_joined_tables(names):
    """Record names of tables joined to an input layer (ignored outside a run)."""
    if not _PATHS_RUN["active"]:
        return
    _PATHS_RUN["joined"].update(n.casefold() for n in names or () if n)


def registered_joined_tables():
    """Names registered by ``register_joined_tables`` (empty outside a run)."""
    return set(_PATHS_RUN["joined"]) if _PATHS_RUN["active"] else set()


def _paths_output_base(path):
    """Case-folded output name without a ``.shp`` / ``.dbf`` extension."""
    name = split_catalog_path(path)[1]
    if name.casefold().endswith((".dbf", ".shp")):
        name = name[:-4]
    return name.casefold()


def refuse_joined_table_outputs(outputs, joined):
    """Raise ``ToolError`` if an output has the name of a table read through a join.

    The output==input check compares catalog paths, and a layer reports only the
    path of its own table, not of the tables joined to it. So an output named
    like any table of a joined layer (``joined_table_names``) is refused, whatever
    its workspace (conservative: the joined table's workspace is not known).
    A report file is matched by its file name and by its name without extension.
    """
    if not joined:
        return
    for out in outputs:
        if not out:
            continue
        name = split_catalog_path(out)[1].casefold()
        candidates = set([_paths_output_base(out), name])
        if "." in name:
            candidates.add(name.rsplit(".", 1)[0])
        hit = sorted(candidates & set(joined))
        if hit:
            raise ToolError(
                "The output '{0}' has the name of a table that an input layer reads through "
                "a join ({1}); it could replace that table.".format(out, hit[0]),
                "Choose another output name, or remove the join from the layer.")


def register_inputs(paths):
    """Record datasets/files the running tool reads (ignored outside a run)."""
    if not _PATHS_RUN["active"]:
        return
    for path in paths or ():
        if path and str(path).strip() and path not in _PATHS_RUN["inputs"]:
            _PATHS_RUN["inputs"].append(path)


def registered_inputs():
    """Datasets/files registered by the running tool (empty outside a run)."""
    return list(_PATHS_RUN["inputs"]) if _PATHS_RUN["active"] else []


def refuse_if_same(outputs, inputs):
    """Raise ``ToolError`` if any output path equals any input path.

    ``None`` and empty entries are ignored. Inputs must already be resolved to
    catalog paths (a layer name is not a path; see ``arcio.describe_dataset``).
    During a guarded run every registered input (``registered_inputs``) is
    compared as well, whether or not the caller listed it, and an output named
    like a registered joined table (``registered_joined_tables``) is refused.
    """
    inputs = list(inputs or ()) + registered_inputs()
    refuse_joined_table_outputs(outputs, registered_joined_tables())
    for out in outputs:
        if not out:
            continue
        for inp in inputs:
            if inp and same_dataset(out, inp):
                raise ToolError(
                    "The output '{0}' is the same dataset as the input '{1}'.".format(out, inp),
                    "Choose a different output name or location; this tool never overwrites its input.")


def split_catalog_path(path):
    """Split into ``(parent, name)`` on the last ``\\`` or ``/``."""
    text = str(path).rstrip("\\/")
    cut = max(text.rfind("\\"), text.rfind("/"))
    if cut < 0:
        return "", text
    return text[:cut], text[cut + 1:]


def workspace_of(catalog_path):
    """Workspace that contains a dataset.

    The workspace is the path up to the last component ending in ``.gdb``,
    ``.sde``, ``.gpkg``, ``.geodatabase`` or ``.mdb`` (so a feature class
    inside a feature dataset still maps to its geodatabase); ``memory`` and
    ``in_memory`` are workspaces too. Otherwise (shapefiles, dBASE tables) it
    is the parent folder. The original spelling is kept.
    """
    text = str(catalog_path).rstrip("\\/")
    pieces = text.replace("/", "\\").split("\\")
    for i in range(len(pieces) - 1, -1, -1):
        low = pieces[i].casefold()
        if low.endswith(_PATHS_WORKSPACE_EXTS) or (i == 0 and low in ("memory", "in_memory")):
            if i == len(pieces) - 1:
                return text  # the path is itself a workspace
            return _paths_rejoin(text, i + 1)
    return split_catalog_path(text)[0]


def _paths_rejoin(text, count):
    """First ``count`` components of ``text`` with its original separators."""
    seen = 0
    for pos, ch in enumerate(text):
        if ch in "\\/":
            seen += 1
            if seen == count:
                return text[:pos]
    return text


def is_folder_workspace(workspace):
    """True if the workspace is a plain folder (shapefiles, dBASE).

    A container inside a geodatabase is not a folder: a feature dataset
    (``C:\\QA\\city.gdb\\Checks``, the parent ``split_catalog_path`` gives for an
    output in it) follows the rules of its geodatabase, so any component
    ending in ``.gdb``, ``.sde``, ``.gpkg``, ``.geodatabase`` or ``.mdb`` (or a
    leading ``memory`` / ``in_memory``) makes this False (RT7-Q-2).
    """
    pieces = str(workspace).rstrip("\\/").replace("/", "\\").split("\\")
    for i, piece in enumerate(pieces):
        low = piece.casefold()
        if low.endswith(_PATHS_WORKSPACE_EXTS) or (i == 0 and low in ("memory", "in_memory")):
            return False
    return True


def find_duplicate_outputs(outputs):
    """First pair ``(a, b)`` of outputs that name the same dataset, else ``None``.

    ``None`` and empty entries are ignored. Use it in ``updateMessages`` and
    at the start of ``execute`` so one output can never silently replace
    another output of the same run.
    """
    seen = {}
    for out in outputs:
        if not out:
            continue
        key = dataset_identity(out)
        if key in seen:
            return seen[key], out
        seen[key] = out
    return None


def refuse_duplicate_outputs(outputs):
    """Raise ``ToolError`` if two outputs are the same dataset."""
    pair = find_duplicate_outputs(outputs)
    if pair:
        raise ToolError(
            "Two outputs are the same dataset: '{0}' and '{1}'.".format(pair[0], pair[1]),
            "Give every output its own name.")


# ==========================================================================
# common/projection.py
# ==========================================================================
# Choose a projected, metric coordinate system for measuring.
#
# Engineering rule 3: lengths, areas and distances are measured in a projected
# metric system chosen from the data extent; degrees are never treated as
# metres. This module is pure: it decides *which* system to use. ``arcio``
# creates the ``arcpy.SpatialReference`` and projects at read time.
#
# Decision rules
# --------------
# 1. Input projected and **not** in the Web Mercator family -> keep it, convert
#    with its ``metersPerUnit``. (Web Mercator distorts distances: about x1.15 at
#    30 degrees latitude and x2 at 60.)
# 2. Otherwise use the UTM zone of the data centre: EPSG 326zz (north) or
#    327zz (south) on WGS 84. A geographic input on another datum (NAD27, ED50,
#    Ain el Abd 1970, ...) uses the EPSG UTM system of its OWN datum when one
#    exists for that zone (``DATUM_UTM_SERIES``, e.g. 4204 zone 38N -> 20438),
#    so no datum transformation is needed. Otherwise the WGS 84 zone is used
#    and a warning says that no datum transformation is applied (the result
#    may be offset by the datum shift) and how to avoid it. The centre longitude is the middle of the *smallest*
#    longitude arc that holds all sample longitudes, so data that crosses the
#    antimeridian (e.g. Fiji, 177E..178W) gets zone 60/1 and not zone 31.
#    A warning is issued if the data spans more than 3 UTM zones.
# 3. Polar data (centre latitude above 84N or below 80S, the UTM limits) uses
#    EPSG 3995 (WGS 84 / Arctic Polar Stereographic) or EPSG 3031
#    (WGS 84 / Antarctic Polar Stereographic), with the same datum warning for
#    an input that is not on WGS 84. The decision is marked ``"polar": True``:
#    both systems have their true scale at 71 degrees, so between 80 and 90
#    degrees they measure lengths 2-2.7 % and areas 4-5.4 % short.
#    ``choose_measuring`` (given ``geographic_sr``) therefore measures polar
#    data, and input already in a polar stereographic system (any one: recognised
#    from where the system puts probe points round the pole, ``polar_probe_points``
#    / ``is_polar_stereographic_probe``; ``arcio.sr_info`` adds the result as
#    ``"polar_stereographic"``), feature by feature (``local_tm_rows``: each polar
#    feature on its own polar stereographic projection with true scale at the
#    feature).
# Norway/Svalbard UTM zone exceptions are not applied (standard 6-degree zones).

WEB_MERCATOR_WKIDS = frozenset([3857, 102100, 102113, 3395, 54004, 900913])
ARCTIC_POLAR_WKID = 3995
ANTARCTIC_POLAR_WKID = 3031
# Common polar stereographic systems on WGS 84: EPSG 3995 / 3031, 3413 / 3976 (NSIDC) and
# UPS 32661 / 32761 / 5041 / 5042. Used only to tell their datum from the WKID
# (``gcs_wkid_of``). Whether an input IS polar stereographic is not taken from a WKID
# list (RT8-C-3): see ``is_polar_stereographic_probe``.
POLAR_STEREO_WKIDS = frozenset([3995, 3031, 3413, 3976, 32661, 32761, 5041, 5042])

# Probe of a projected system (RT8-C-3): the points ``polar_probe_points(sign)`` (WGS 84
# degrees, 4 meridians 90 degrees apart on 3 latitudes near one pole) are projected into
# the system (``arcio.sr_info``). A polar stereographic projection about that pole (any
# variant, any true-scale latitude, false origin, axis orientation, unit or ellipsoid of
# about the size of the Earth) puts each latitude on a circle round one centre, the
# meridians 90 degrees apart, and the radii in the ratio of the stereographic formula.
# Polar azimuthal equal-area or equidistant systems differ by 0.25-0.4 % in those ratios.
POLAR_PROBE_LATS = (80.0, 85.0, 89.0)
POLAR_PROBE_LONS = (0.0, 90.0, 180.0, -90.0)
POLAR_PROBE_TOLERANCE = 1e-3
MAX_UTM_ZONES_WITHOUT_WARNING = 3
WGS84_GCS_WKID = 4326

# UTM systems on datums other than WGS 84 (EPSG, not deprecated, standard 6-degree
# zones in metres; GDA94/GDA2020 MGA zones are UTM on that datum). Each row:
# (geographic WKID, hemisphere, first zone, last zone, WKID of the first zone); the
# WKIDs of a row are consecutive. Checked against the EPSG database (pyproj) in the
# tests. Unlisted datums fall back to WGS 84 UTM with a warning.
DATUM_UTM_SERIES = (
    (4131, "N", 48, 49, 3148),  # Indian 1960
    (4146, "N", 42, 47, 24342),  # Kalianpur 1975
    (4152, "N", 4, 5, 3750),  # NAD83(HARN)
    (4152, "N", 10, 19, 3740),  # NAD83(HARN)
    (4152, "S", 2, 2, 2195),  # NAD83(HARN)
    (4154, "N", 38, 41, 2058),  # ED50(ED77)
    (4159, "N", 32, 35, 2077),  # ELD79
    (4170, "N", 17, 22, 31986),  # SIRGAS 1995
    (4170, "S", 17, 25, 31992),  # SIRGAS 1995
    (4189, "N", 18, 20, 2201),  # REGVEN
    (4201, "N", 35, 38, 20135),  # Adindan
    (4204, "N", 36, 40, 20436),  # Ain el Abd
    (4205, "N", 38, 39, 20538),  # Afgooye
    (4209, "S", 34, 36, 20934),  # Arc 1950
    (4210, "N", 35, 37, 21095),  # Arc 1960
    (4210, "S", 35, 37, 21035),  # Arc 1960
    (4211, "S", 48, 50, 21148),  # Batavia
    (4218, "N", 18, 18, 21818),  # Bogota 1975
    (4222, "S", 34, 35, 22234),  # Cape
    (4223, "N", 32, 32, 22332),  # Carthage
    (4225, "S", 21, 25, 22521),  # Corrego Alegre 1970-72
    (4230, "N", 28, 38, 23028),  # ED50
    (4232, "N", 39, 40, 23239),  # Fahud
    (4238, "N", 46, 52, 23846),  # ID74
    (4238, "S", 47, 54, 23887),  # ID74
    (4239, "N", 46, 48, 23946),  # Indian 1954
    (4240, "N", 47, 48, 24047),  # Indian 1975
    (4245, "N", 47, 48, 24547),  # Kertau 1968
    (4247, "N", 18, 20, 24718),  # La Canoa
    (4248, "N", 17, 21, 24817),  # PSAD56
    (4248, "S", 17, 22, 24877),  # PSAD56
    (4258, "N", 28, 37, 25828),  # ETRS89
    (4263, "N", 31, 32, 26331),  # Minna
    (4267, "N", 1, 22, 26701),  # NAD27
    (4267, "N", 59, 60, 3370),  # NAD27
    (4269, "N", 1, 23, 26901),  # NAD83
    (4269, "N", 24, 24, 9712),  # NAD83
    (4269, "N", 59, 60, 3372),  # NAD83
    (4270, "N", 39, 40, 27039),  # Nahrwan 1967
    (4283, "S", 46, 47, 6736),  # GDA94
    (4283, "S", 48, 58, 28348),  # GDA94
    (4283, "S", 59, 59, 6738),  # GDA94
    (4301, "N", 51, 55, 3092),  # Tokyo
    (4307, "N", 29, 32, 30729),  # Nord Sahara 1959
    (4318, "N", 38, 39, 31838),  # NGN
    (4322, "N", 1, 60, 32201),  # WGS 72
    (4322, "S", 1, 60, 32301),  # WGS 72
    (4612, "N", 51, 55, 3097),  # JGD2000
    (4617, "N", 7, 10, 3154),  # NAD83(CSRS)
    (4617, "N", 11, 13, 2955),  # NAD83(CSRS)
    (4617, "N", 14, 16, 3158),  # NAD83(CSRS)
    (4617, "N", 17, 21, 2958),  # NAD83(CSRS)
    (4617, "N", 22, 22, 3761),  # NAD83(CSRS)
    (4617, "N", 23, 23, 9709),  # NAD83(CSRS)
    (4617, "N", 24, 24, 9713),  # NAD83(CSRS)
    (4618, "N", 17, 17, 5463),  # SAD69
    (4618, "N", 18, 22, 29168),  # SAD69
    (4618, "S", 17, 25, 29187),  # SAD69
    (4674, "N", 11, 22, 31965),  # SIRGAS 2000
    (4674, "N", 23, 24, 6210),  # SIRGAS 2000
    (4674, "S", 17, 25, 31977),  # SIRGAS 2000
    (4674, "S", 26, 26, 5396),  # SIRGAS 2000
    (4743, "N", 37, 39, 3391),  # Karbala 1979
    (4744, "N", 37, 39, 7005),  # Nahrwan 1934
    (4755, "N", 46, 52, 23866),  # DGN95
    (4755, "S", 47, 54, 23877),  # DGN95
    (4756, "N", 48, 49, 3405),  # VN-2000
    (4759, "N", 1, 19, 3708),  # NAD83(NSRS2007)
    (4759, "N", 59, 60, 3706),  # NAD83(NSRS2007)
    (6318, "N", 1, 19, 6330),  # NAD83(2011)
    (6318, "N", 59, 60, 6328),  # NAD83(2011)
    (6668, "N", 51, 55, 6688),  # JGD2011
    (7844, "S", 46, 59, 7846),  # GDA2020
)


def utm_zone(lon):
    """Standard 6-degree UTM zone number (1..60) of a longitude in degrees."""
    lon = _projection_wrap(lon)
    zone = int(math.floor((lon + 180.0) / 6.0)) + 1
    return min(max(zone, 1), 60)


def utm_wkid(lon, lat):
    """EPSG code of the WGS 84 UTM zone for a point."""
    return (32600 if lat >= 0 else 32700) + utm_zone(lon)


def _projection_wrap(lon):
    """Longitude in [-180, 180)."""
    return ((float(lon) + 180.0) % 360.0) - 180.0


def longitude_span(longitudes):
    """Smallest arc holding all longitudes: ``(west, east, centre, width)``.

    ``west``/``east``/``centre`` are wrapped to [-180, 180); ``width`` is in
    degrees (0..360). Works across the antimeridian: the arc is the complement
    of the largest gap between sorted longitudes.
    """
    lons = sorted(set(_projection_wrap(x) for x in longitudes))
    if not lons:
        raise ValueError("no longitudes")
    if len(lons) == 1:
        return lons[0], lons[0], lons[0], 0.0
    best_gap, best_i = -1.0, 0
    for i in range(len(lons)):
        nxt = lons[(i + 1) % len(lons)] + (360.0 if i == len(lons) - 1 else 0.0)
        gap = nxt - lons[i]
        if gap > best_gap:
            best_gap, best_i = gap, i
    west = lons[(best_i + 1) % len(lons)]
    east = lons[best_i]
    width = 360.0 - best_gap
    centre = _projection_wrap(west + width / 2.0)
    return west, east, centre, width


def count_utm_zones(west, width):
    """Number of UTM zones touched by an arc starting at ``west``."""
    if width >= 360.0:
        return 60
    first = int(math.floor((_projection_wrap(west) + 180.0) / 6.0))
    last = int(math.floor((_projection_wrap(west) + 180.0 + width) / 6.0))
    return min(last - first + 1, 60)


def is_web_mercator(wkid):
    return wkid is not None and int(wkid) in WEB_MERCATOR_WKIDS


# Equatorial circumference of the Web Mercator family (sphere or ellipsoid with
# a = 6378137 m): the x period of 3857/102100/102113/900913 (+-20,037,508.34 m)
# and of World Mercator 3395/54004.
WEB_MERCATOR_PERIOD_M = 2.0 * math.pi * 6378137.0


def x_period(sr_info):
    """Period of the x coordinate of a coordinate system, or ``None``: 360 for a
    geographic system (longitudes), the equatorial circumference (in the
    system's units) for the Web Mercator family, else ``None``. Coordinates
    ``x`` and ``x +- period`` are then the same place (antimeridian)."""
    sr_info = sr_info or {}
    if str(sr_info.get("type") or "") == "Geographic":
        return 360.0
    if is_web_mercator(sr_info.get("wkid")):
        return WEB_MERCATOR_PERIOD_M / float(sr_info.get("meters_per_unit") or 1.0)
    return None


def datum_utm_wkid(gcs_wkid, lon, lat):
    """WKID of the UTM zone of ``(lon, lat)`` on the datum of geographic system
    ``gcs_wkid``, or ``None`` when that datum has no EPSG UTM system there."""
    if not gcs_wkid:
        return None
    gcs_wkid = int(gcs_wkid)
    if gcs_wkid == WGS84_GCS_WKID:
        return utm_wkid(lon, lat)
    zone, hemi = utm_zone(lon), ("N" if lat >= 0 else "S")
    for gcs, h, first, last, code in DATUM_UTM_SERIES:
        if gcs == gcs_wkid and h == hemi and first <= zone <= last:
            return code + zone - first
    return None


def gcs_wkid_of(sr_info):
    """WKID of the geographic system (datum) under ``sr_info``, or ``None`` when it
    cannot be told from the WKID alone (custom or unlisted projected systems)."""
    sr_info = sr_info or {}
    wkid = sr_info.get("wkid")
    if not wkid:
        return None
    wkid = int(wkid)
    if str(sr_info.get("type") or "") == "Geographic":
        return wkid
    if is_web_mercator(wkid) or wkid in POLAR_STEREO_WKIDS \
            or 32601 <= wkid <= 32660 or 32701 <= wkid <= 32760:
        return WGS84_GCS_WKID
    for gcs, _h, first, last, code in DATUM_UTM_SERIES:
        if code <= wkid <= code + last - first:
            return gcs
    return None


def datum_mismatch_warning(label, other_info, decision):
    """Warning text when a further input (``label``) is on another datum than the
    measuring system of ``decision``: it is projected without a datum
    transformation. ``None`` when the datums match or cannot be told."""
    if not decision:
        return None
    target = decision.get("gcs_wkid")
    other = gcs_wkid_of(other_info)
    if target is None or other is None or target == other:
        return None
    return ("{0} ({1}) is on another datum than the measuring coordinate system (WKID {2}); "
            "it is projected to it without a datum transformation, so it may be offset "
            "from the other input by the datum shift (about 1 m between modern datums, up to "
            "several hundred metres for older ones). Project both inputs to the same projected "
            "metric coordinate system first (Project tool, with the right geographic "
            "transformation).".format(label, (other_info or {}).get("name") or other,
                                      decision.get("wkid")))


def sr_is_unknown(sr_info):
    """True for a dataset without a coordinate system (e.g. a shapefile with no
    .prj): type neither Projected nor Geographic and no WKID."""
    sr_info = sr_info or {}
    return (str(sr_info.get("type") or "") not in ("Projected", "Geographic")
            and not sr_info.get("wkid"))


def further_input_sr_check(label, other_info, decision, main_name=None):
    """Check the coordinate system of a further input (``label``) against the
    measuring ``decision`` of the main input.

    A cursor cannot project data whose system is unknown (audit gotcha 3), so
    its coordinates stay as they are. When the main input is projected for
    measuring, they would be compared with it in other units: ``ToolError``.
    When the main input is used in its own system, the further input is
    assumed to be in that system: returns a warning. ``None`` when the further
    input's system is known.
    """
    if not sr_is_unknown(other_info):
        return None
    fix = ("Define the coordinate system of {0} (Define Projection tool) and run the tool "
           "again.".format(label))
    if decision and decision.get("reproject"):
        raise ToolError(
            "{0} has an unknown coordinate system, so it cannot be projected to the measuring "
            "coordinate system (WKID {1}); its coordinates would be compared with the input "
            "in other units.".format(label, decision.get("wkid")), fix)
    return ("{0} has an unknown coordinate system; its coordinates are used as if they were "
            "in the coordinate system of the input ({1}). If they are not, {2}".format(
                label, main_name or "unknown", fix[0].lower() + fix[1:]))


def _projection_datum_warning(name, target_text):
    return ("The input coordinate system ({0}) is not on the WGS 84 datum and has no UTM "
            "system on its own datum for this area, so it is projected to {1} WITHOUT a datum "
            "transformation. Positions may be offset by the datum shift: about 1 m for modern "
            "datums (NAD83, ETRS89, GDA94), up to several hundred metres for older ones "
            "(NAD27, ED50, Ain el Abd 1970, Pulkovo 1942). For exact positions project the "
            "input to a projected metric coordinate system first (Project tool, with the right "
            "geographic transformation).".format(name, target_text))


def choose_metric_sr(sr_info, lonlat_samples=None):
    """Decide the measuring coordinate system.

    ``sr_info`` describes the input system: ``{"wkid": int or None,
    "type": "Projected" | "Geographic" | ..., "meters_per_unit": float or None,
    "name": str}``. ``lonlat_samples`` is an iterable of ``(lon, lat)`` in
    degrees (WGS 84) and is only needed when the input is not usable as is.

    Returns ``{"wkid", "meters_per_unit", "reproject", "gcs_wkid", "reason",
    "warnings"}`` (``gcs_wkid``: the datum of the measuring system, ``None`` if
    unknown), plus ``"utm_zones"`` (number of UTM zones the data spans) when a
    UTM zone is chosen and ``"datum_warnings"`` (the subset of ``warnings``
    about projecting without a datum transformation) when a new system is
    chosen. That warning only matters to a tool that compares positions with
    other data or writes measured positions in another system; a tool that
    writes its results back through the same projection may show it as
    information instead (``choose_measuring(..., datum_as_info=True)``);
    ``reproject`` is False when the input system is kept. An unknown system
    (type neither Projected nor Geographic and no WKID) is kept as is with a
    warning: it cannot be projected.
    Raises ``ToolError`` when a new system is needed but there are no samples.
    """
    sr_info = sr_info or {}
    wkid = sr_info.get("wkid")
    sr_type = str(sr_info.get("type") or "")
    mpu = sr_info.get("meters_per_unit")
    name = sr_info.get("name") or ("WKID {0}".format(wkid) if wkid else "unknown")

    if sr_type not in ("Projected", "Geographic") and not wkid:
        # Unknown coordinate system: a cursor cannot project it (coordinates stay as
        # they are, audit gotcha 3), so measuring "in UTM" would be a false claim.
        return {"wkid": None, "meters_per_unit": 1.0, "reproject": False, "gcs_wkid": None,
                "reason": "The input coordinate system is unknown; coordinates are used as "
                          "they are.",
                "warnings": ["The coordinate system of the input is unknown, so lengths, areas "
                             "and distances are in the data's own units and are reported as if "
                             "they were metres. Define the projection of the input (Define "
                             "Projection tool) for correct values."]}
    if sr_type == "Projected" and not is_web_mercator(wkid) and mpu:
        return {"wkid": wkid, "meters_per_unit": float(mpu), "reproject": False,
                "gcs_wkid": gcs_wkid_of(sr_info),
                "reason": "The input is already projected ({0}); it is used as is.".format(name),
                "warnings": []}

    samples = [(float(x), float(y)) for (x, y) in (lonlat_samples or [])
               if x is not None and y is not None
               and math.isfinite(float(x)) and math.isfinite(float(y))]
    if not samples:
        raise ToolError(
            "Cannot choose a metric coordinate system: the input has no usable coordinates.",
            "Check that the input contains features with geometry.")

    lats = [lat for (_lon, lat) in samples]
    centre_lat = (min(lats) + max(lats)) / 2.0
    why_not = ("is in the Web Mercator family, which distorts distances"
               if is_web_mercator(wkid) else "is not a projected system")
    warnings = []
    source_gcs = gcs_wkid_of(sr_info)
    foreign = source_gcs != WGS84_GCS_WKID      # None (custom datum) counts as foreign
    if centre_lat > 84.0 or centre_lat < -80.0:
        north = centre_lat > 84.0
        target = ARCTIC_POLAR_WKID if north else ANTARCTIC_POLAR_WKID
        label = "WGS 84 / {0} Polar Stereographic (EPSG {1})".format(
            "Arctic" if north else "Antarctic", target)
        if foreign:
            warnings.append(_projection_datum_warning(name, label))
        return {"wkid": target, "meters_per_unit": 1.0, "reproject": True, "polar": True,
                "gcs_wkid": WGS84_GCS_WKID, "datum_warnings": list(warnings),
                "reason": "The input ({0}) {1}; polar data {2} is measured in {3}.".format(
                    name, why_not, "north of 84N" if north else "south of 80S", label),
                "warnings": warnings}

    west, _east, centre_lon, width = longitude_span(lon for (lon, _lat) in samples)
    zones = count_utm_zones(west, width)
    target = utm_wkid(centre_lon, centre_lat)
    hemi = "N" if centre_lat >= 0 else "S"
    zone_text = "UTM zone {0}{1}".format(utm_zone(centre_lon), hemi)
    target_gcs = WGS84_GCS_WKID
    target_text = "WGS 84 / {0}".format(zone_text)
    if foreign:
        own = datum_utm_wkid(source_gcs, centre_lon, centre_lat)
        if own is not None:
            target, target_gcs = own, source_gcs
            target_text = "{0} on the input's own datum, so no datum transformation is " \
                          "needed".format(zone_text)
        else:
            warnings.append(_projection_datum_warning(
                name, "WGS 84 / {0} (EPSG {1})".format(zone_text, target)))
    datum_warnings = list(warnings)
    if zones > MAX_UTM_ZONES_WITHOUT_WARNING:
        warnings.append(
            "The data spans {0} UTM zones ({1:.1f} degrees of longitude); distances far from "
            "the centre zone are less accurate. Project the data to a suitable "
            "equidistant or equal-area system first for best results.".format(zones, width))
    return {"wkid": target, "meters_per_unit": 1.0, "reproject": True, "gcs_wkid": target_gcs,
            "reason": "The input ({0}) {1}; measuring in {2} (EPSG {3}).".format(
                name, why_not, target_text, target),
            "warnings": warnings, "utm_zones": zones, "datum_warnings": datum_warnings}


# --------------------------------------------------------------------------
# Per-feature local Transverse Mercator (wide geographic data)
# --------------------------------------------------------------------------
# One UTM zone cannot measure data that spans many zones: Transverse Mercator
# scale error grows with the square of the distance from the central meridian
# (about +0.1 % in area at 3 degrees, +40 % at 40 degrees on the equator, and
# far worse beyond). For such data each feature is projected on its own
# Transverse Mercator with the central meridian at the feature's centre and
# scale factor 1 (true scale on that meridian), in pure Python. The formulas
# are Krueger's series to order n**6 (C. F. F. Karney, "Transverse Mercator
# with an accuracy of a few nanometers", J. Geodesy 85, 2011, eqs. 6-11 and
# 35-36); within 3900 km of the central meridian they agree with an exact
# projection to well below a millimetre (checked against PROJ in the tests).
# The WGS 84 ellipsoid is used for every geographic system: other ellipsoids
# differ by less than 0.01 %, far below what a map-scale check can see.

TM_WGS84_A = 6378137.0
TM_WGS84_F = 1.0 / 298.257223563
# A feature reaching farther than this from its own central meridian (metres on
# its local Transverse Mercator) is measured with more than about 1 % area error
# even on that projection (warning). The scale error grows with the distance
# from the central meridian (k - 1 ~ x**2 / 2R**2), not with the longitude
# difference, which shrinks with cos(latitude): 9 degrees of longitude on the
# equator (a feature 18 degrees wide) is about 1,000 km, at 79 N only 190 km.
TM_MAX_FEATURE_OFFSET_M = TM_WGS84_A * math.pi / 20.0


def _projection_tm_constants(a=TM_WGS84_A, f=TM_WGS84_F):
    n = f / (2.0 - f)
    n2, n3 = n * n, n * n * n
    n4, n5, n6 = n2 * n2, n2 * n3, n3 * n3
    big_a = a / (1.0 + n) * (1.0 + n2 / 4.0 + n4 / 64.0 + n6 / 256.0)
    alpha = (
        n / 2.0 - 2.0 * n2 / 3.0 + 5.0 * n3 / 16.0 + 41.0 * n4 / 180.0 - 127.0 * n5 / 288.0
        + 7891.0 * n6 / 37800.0,
        13.0 * n2 / 48.0 - 3.0 * n3 / 5.0 + 557.0 * n4 / 1440.0 + 281.0 * n5 / 630.0
        - 1983433.0 * n6 / 1935360.0,
        61.0 * n3 / 240.0 - 103.0 * n4 / 140.0 + 15061.0 * n5 / 26880.0
        + 167603.0 * n6 / 181440.0,
        49561.0 * n4 / 161280.0 - 179.0 * n5 / 168.0 + 6601661.0 * n6 / 7257600.0,
        34729.0 * n5 / 80640.0 - 3418889.0 * n6 / 1995840.0,
        212378941.0 * n6 / 319334400.0)
    beta = (
        n / 2.0 - 2.0 * n2 / 3.0 + 37.0 * n3 / 96.0 - n4 / 360.0 - 81.0 * n5 / 512.0
        + 96199.0 * n6 / 604800.0,
        n2 / 48.0 + n3 / 15.0 - 437.0 * n4 / 1440.0 + 46.0 * n5 / 105.0
        - 1118711.0 * n6 / 3870720.0,
        17.0 * n3 / 480.0 - 37.0 * n4 / 840.0 - 209.0 * n5 / 4480.0 + 5569.0 * n6 / 90720.0,
        4397.0 * n4 / 161280.0 - 11.0 * n5 / 504.0 - 830251.0 * n6 / 7257600.0,
        4583.0 * n5 / 161280.0 - 108847.0 * n6 / 3991680.0,
        20648693.0 * n6 / 638668800.0)
    e = math.sqrt(f * (2.0 - f))
    return {"A": big_a, "alpha": alpha, "beta": beta, "e": e}


_PROJECTION_TM = _projection_tm_constants()


def tm_forward(lon, lat, lon0):
    """Transverse Mercator ``(x, y)`` in metres of ``(lon, lat)`` (degrees) on the
    WGS 84 ellipsoid, central meridian ``lon0``, scale factor 1, origin at the
    equator. Longitudes more than about 89 degrees from ``lon0`` are clamped
    (Transverse Mercator is not defined at 90 degrees on the equator)."""
    c = _PROJECTION_TM
    e = c["e"]
    lam = math.radians(_projection_wrap(float(lon) - float(lon0)))
    lam = max(min(lam, math.radians(89.999)), -math.radians(89.999))
    phi = math.radians(max(min(float(lat), 90.0), -90.0))
    sin_phi = math.sin(phi)
    if abs(sin_phi) >= 1.0:
        tau_c = math.copysign(1e300, sin_phi)
        xi_p, eta_p = math.copysign(math.pi / 2.0, sin_phi), 0.0
    else:
        tau_c = math.sinh(math.atanh(sin_phi) - e * math.atanh(e * sin_phi))
        xi_p = math.atan2(tau_c, math.cos(lam))
        eta_p = math.asinh(math.sin(lam) / math.hypot(tau_c, math.cos(lam)))
    xi, eta = xi_p, eta_p
    for j, a_j in enumerate(c["alpha"], 1):
        xi += a_j * math.sin(2 * j * xi_p) * math.cosh(2 * j * eta_p)
        eta += a_j * math.cos(2 * j * xi_p) * math.sinh(2 * j * eta_p)
    return c["A"] * eta, c["A"] * xi


def _projection_lat_from_conformal(tau_p):
    """Geodetic tan(latitude) from conformal tan(latitude) (Newton, Karney eq. 19-21)."""
    e = _PROJECTION_TM["e"]
    e2m = 1.0 - e * e
    tau = tau_p / e2m
    for _ in range(8):
        sigma = math.sinh(e * math.atanh(e * tau / math.sqrt(1.0 + tau * tau)))
        tau_pi = tau * math.sqrt(1.0 + sigma * sigma) - sigma * math.sqrt(1.0 + tau * tau)
        step = (tau_p - tau_pi) * (1.0 + e2m * tau * tau) / (
            e2m * math.sqrt(1.0 + tau_pi * tau_pi) * math.sqrt(1.0 + tau * tau))
        tau += step
        if abs(step) < 1e-14 * max(1.0, abs(tau)):
            break
    return tau


def tm_inverse(x, y, lon0):
    """Inverse of ``tm_forward``: ``(lon, lat)`` in degrees, ``lon`` near ``lon0``
    (``lon0`` plus an offset in -90..90, not wrapped)."""
    c = _PROJECTION_TM
    xi, eta = float(y) / c["A"], float(x) / c["A"]
    xi_p, eta_p = xi, eta
    for j, b_j in enumerate(c["beta"], 1):
        xi_p -= b_j * math.sin(2 * j * xi) * math.cosh(2 * j * eta)
        eta_p -= b_j * math.cos(2 * j * xi) * math.sinh(2 * j * eta)
    lam = math.atan2(math.sinh(eta_p), math.cos(xi_p))
    tau_p = math.sin(xi_p) / math.hypot(math.sinh(eta_p), math.cos(xi_p))
    tau = _projection_lat_from_conformal(tau_p)
    return float(lon0) + math.degrees(lam), math.degrees(math.atan(tau))


# Per-feature polar stereographic (features near a pole). Ellipsoidal formulas of
# J. P. Snyder, "Map Projections - A Working Manual" (USGS PP 1395, 1987), eqs. 15-9,
# 21-33 to 21-40, with scale 1 at the pole; ``local_tm_rows`` then divides the
# coordinates by the scale at the feature, so the feature is at true scale.
_PS_E = _PROJECTION_TM["e"]
_PS_C = math.sqrt((1.0 + _PS_E) ** (1.0 + _PS_E) * (1.0 - _PS_E) ** (1.0 - _PS_E))


def _projection_ps_rho(lat_toward_pole):
    """Distance from the pole (metres, scale 1 at the pole) of latitude ``lat``
    (degrees, positive toward the projection's pole)."""
    phi = math.radians(max(min(float(lat_toward_pole), 90.0), -89.999))
    s = math.sin(phi)
    t = math.tan(math.pi / 4.0 - phi / 2.0) / ((1.0 - _PS_E * s) / (1.0 + _PS_E * s)) ** (
        _PS_E / 2.0)
    return 2.0 * TM_WGS84_A * t / _PS_C


def _projection_ps_lat(rho):
    """Inverse of ``_projection_ps_rho``: latitude in degrees (toward the pole)."""
    t = float(rho) * _PS_C / (2.0 * TM_WGS84_A)
    phi = math.pi / 2.0 - 2.0 * math.atan(t)
    for _ in range(30):
        s = math.sin(phi)
        new = math.pi / 2.0 - 2.0 * math.atan(
            t * ((1.0 - _PS_E * s) / (1.0 + _PS_E * s)) ** (_PS_E / 2.0))
        if abs(new - phi) < 1e-15:
            phi = new
            break
        phi = new
    return math.degrees(phi)


def ps_scale(lat_toward_pole):
    """Linear scale of the polar stereographic (scale 1 at the pole) at a latitude."""
    phi = math.radians(min(abs(float(lat_toward_pole)), 90.0))
    if phi >= math.pi / 2.0 - 1e-12:
        return 1.0
    s = math.sin(phi)
    m = math.cos(phi) / math.sqrt(1.0 - _PS_E * _PS_E * s * s)
    return _projection_ps_rho(math.degrees(phi)) / (TM_WGS84_A * m)


def ps_forward(lon, lat, lon0, sign, k_ref=1.0):
    """Polar stereographic ``(x, y)`` in metres of ``(lon, lat)`` (degrees): pole
    ``sign`` (+1 north, -1 south), meridian ``lon0`` along the y axis with east
    +x and north +y on it (so ring orientation is kept), coordinates divided by
    ``k_ref`` (true scale where the scale equals ``k_ref``)."""
    rho = _projection_ps_rho(sign * float(lat)) / float(k_ref)
    lam = math.radians(_projection_wrap(float(lon) - float(lon0)))
    return rho * math.sin(lam), -sign * rho * math.cos(lam)


def ps_inverse(x, y, lon0, sign, k_ref=1.0):
    """Inverse of ``ps_forward``: ``(lon, lat)`` in degrees, ``lon`` within 180 of ``lon0``."""
    x, y = float(x) * float(k_ref), float(y) * float(k_ref)
    rho = math.hypot(x, y)
    lat = sign * _projection_ps_lat(rho)
    lam = math.atan2(x, -sign * y) if rho > 0.0 else 0.0
    return float(lon0) + math.degrees(lam), lat


def polar_probe_points(sign):
    """``[(lon, lat)]`` (WGS 84 degrees) to project into a system to test whether it is
    polar stereographic about the North (``sign`` 1) or South (-1) Pole: for each
    latitude of ``POLAR_PROBE_LATS``, the 4 longitudes of ``POLAR_PROBE_LONS``."""
    return [(lon, sign * lat) for lat in POLAR_PROBE_LATS for lon in POLAR_PROBE_LONS]


def is_polar_stereographic_probe(projected):
    """True when ``projected`` (the points of ``polar_probe_points`` in the same order,
    as ``(x, y)`` in the system tested; ``None`` or non-finite entries where a point
    could not be projected) is what a polar stereographic projection about that pole
    gives: every latitude on a circle round one common centre (the pole), the
    meridians 90 degrees apart, and the radii of the latitudes in the ratio of the
    stereographic formula (tolerance ``POLAR_PROBE_TOLERANCE``, relative)."""
    n = len(POLAR_PROBE_LONS)
    if projected is None or len(projected) != n * len(POLAR_PROBE_LATS):
        return False
    pts = []
    for p in projected:
        try:
            x, y = float(p[0]), float(p[1])
        except (TypeError, ValueError, IndexError):
            return False
        if not (math.isfinite(x) and math.isfinite(y)):
            return False
        pts.append((x, y))
    groups = [pts[i * n:(i + 1) * n] for i in range(len(POLAR_PROBE_LATS))]
    # Centre: midpoint of the opposite meridians (0 and 180, 90 and -90) of each latitude.
    mids = [((g[a][0] + g[a + 2][0]) / 2.0, (g[a][1] + g[a + 2][1]) / 2.0)
            for g in groups for a in (0, 1)]
    cx = sum(m[0] for m in mids) / len(mids)
    cy = sum(m[1] for m in mids) / len(mids)
    radii = []
    for g in groups:
        rs = [math.hypot(x - cx, y - cy) for x, y in g]
        r = sum(rs) / len(rs)
        if not r > 0.0 or any(abs(v - r) > POLAR_PROBE_TOLERANCE * r for v in rs):
            return False
        # Meridians 0 and 90 at a right angle round the pole.
        (x0, y0), (x1, y1) = g[0], g[1]
        dot = (x0 - cx) * (x1 - cx) + (y0 - cy) * (y1 - cy)
        if abs(dot) > POLAR_PROBE_TOLERANCE * rs[0] * rs[1]:
            return False
        radii.append(r)
    tol = POLAR_PROBE_TOLERANCE * radii[0]
    if any(math.hypot(m[0] - cx, m[1] - cy) > tol for m in mids):
        return False
    rho0 = _projection_ps_rho(POLAR_PROBE_LATS[0])
    for lat, r in zip(POLAR_PROBE_LATS[1:], radii[1:]):
        expected = _projection_ps_rho(lat) / rho0
        if abs((r / radii[0]) / expected - 1.0) > POLAR_PROBE_TOLERANCE:
            return False
    return True


def _projection_polar_sign(lats, width):
    """+1 / -1 when a feature is measured on a polar stereographic projection (all
    of it in one hemisphere and reaching beyond the UTM limits, 84N / 80S, or
    going round the pole above 60 degrees: more than 180 degrees of longitude),
    else 0."""
    if not lats:
        return 0
    if min(lats) >= 0.0 and (max(lats) > 84.0 or (width > 180.0 and min(lats) >= 60.0)):
        return 1
    if max(lats) <= 0.0 and (min(lats) < -80.0 or (width > 180.0 and max(lats) <= -60.0)):
        return -1
    return 0


def _projection_ps_node(node, lon0, sign, k_ref):
    if isinstance(node[0], (int, float)):
        x, y = ps_forward(node[0], node[1], lon0, sign, k_ref)
        return [x, y]
    return [_projection_ps_node(item, lon0, sign, k_ref) for item in node]


def _projection_lats(node, out):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            out.append(float(node[1]))
        else:
            for item in node:
                _projection_lats(item, out)


def local_ps_geometry(geom, lon0, sign):
    """Project a core geometry in degrees on the polar stereographic of pole
    ``sign`` with true scale at the feature: ``(geometry, k_ref, spread)``.

    ``k_ref`` is the geometric mean of the smallest and largest scale (scale 1 at
    the pole) over the vertices and the centre of the feature's extent (the pole
    itself for a feature around it); ``spread`` = largest / smallest scale, so
    the measures are within about ``spread - 1`` (area) of the truth."""
    lats = []
    _projection_lats(geom, lats)
    scales = [ps_scale(sign * lat) for lat in lats]
    raw = _projection_ps_node(geom, lon0, sign, 1.0)
    xs, ys = [], []
    _projection_xy(raw, xs, ys)
    cx, cy = (min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0
    scales.append(ps_scale(_projection_ps_lat(math.hypot(cx, cy))))
    k_min, k_max = min(scales), max(scales)
    k_ref = math.sqrt(k_min * k_max)
    return _projection_ps_node(geom, lon0, sign, k_ref), k_ref, k_max / k_min


def _projection_xy(node, xs, ys):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            xs.append(float(node[0]))
            ys.append(float(node[1]))
        else:
            for item in node:
                _projection_xy(item, xs, ys)


# A polar feature whose scale varies by more than this factor over it (largest /
# smallest, on its own polar stereographic) is measured with more than about 1 %
# area error: warning. 1.01 is reached by a feature from the pole to about 78 degrees.
PS_MAX_FEATURE_SPREAD = 1.01


def _projection_lonlats(node, out):
    if isinstance(node, (list, tuple)) and node:
        if isinstance(node[0], (int, float)):
            out.append(float(node[0]))
        else:
            for item in node:
                _projection_lonlats(item, out)


def _projection_tm_node(node, lon0):
    if isinstance(node[0], (int, float)):
        x, y = tm_forward(node[0], node[1], lon0)
        return [x, y]
    return [_projection_tm_node(item, lon0) for item in node]


def local_tm_geometry(geom):
    """Project a core geometry in geographic degrees (a point ``[lon, lat]`` or
    nested lists of them) to the local Transverse Mercator of its own centre.

    Returns ``(projected geometry, lon0, width)``: ``lon0`` is the centre of the
    smallest longitude arc holding all vertices (works across the
    antimeridian), ``width`` that arc in degrees. ``(None, None, 0.0)`` for an
    empty geometry.
    """
    lons = []
    if geom:
        _projection_lonlats(geom, lons)
    if not lons:
        return None, None, 0.0
    _west, _east, lon0, width = longitude_span(lons)
    return _projection_tm_node(geom, lon0), lon0, width


def local_tm_point_to_lonlat(point, lon0, near_lon=None):
    """``[lon, lat]`` of a point ``(x, y)`` of ``local_tm_geometry``; the
    longitude is shifted by whole turns to be nearest ``near_lon`` (the
    feature's own longitudes, so data stored in 0..360 stays there)."""
    lon, lat = tm_inverse(point[0], point[1], lon0)
    if near_lon is not None:
        lon += 360.0 * round((float(near_lon) - lon) / 360.0)
    return [lon, lat]


# --------------------------------------------------------------------------
# Measuring plan of a tool (one UTM zone, or per-feature local TM)
# --------------------------------------------------------------------------

def choose_measuring(desc, metric_sr_for, collector, what, geographic_sr=None,
                     datum_as_info=False):
    """How to measure an input: ``{"read_sr", "wkid", "mpu", "local"}``.

    ``metric_sr_for`` is ``arcio.metric_sr_or_native`` (or ``arcio.metric_sr_for``,
    or any function ``desc -> (decision, spatial reference or None)``);
    ``collector`` a ``MessageCollector``. Pure: arcpy is only reached through
    the functions passed in.
    An input with no coordinates at all (empty, empty selection, only null
    geometries) keeps its own system: there is nothing to measure. A projected
    input keeps its own system (other inputs are projected into it by the
    cursor); otherwise a UTM zone is chosen from the data. An unknown system
    gives a warning and native units (``wkid`` ``None``, 1 metre per unit).

    Wide data (``local`` True): when the data needs projecting and spans more
    than ``MAX_UTM_ZONES_WITHOUT_WARNING`` UTM zones, one zone would measure
    features far from it with gross errors (area +100 % at 40 degrees from the
    central meridian). If ``geographic_sr`` (``arcpy.SpatialReference``) is
    given, the input is then read in geographic degrees (its own geographic
    system, or WGS 84 for Web Mercator) and every feature is measured on its
    own local Transverse Mercator (``local_tm_rows``); ``wkid`` is then the
    system of the degrees read, used to write points back.

    ``datum_as_info``: the decision's ``datum_warnings`` are shown as
    information, not warnings (for tools whose results go back through the
    same projection, so a datum shift cannot offset them).
    """
    sr_type = (desc["sr"] or {}).get("type")
    if sr_type not in ("Projected", "Geographic"):
        collector.warning(
            "The {0} has an unknown coordinate system, so it is read in its native "
            "coordinates and its units are taken as metres. Define the coordinate system "
            "(Define Projection) for reliable measurements.".format(what))
        return {"read_sr": desc["sr_object"], "wkid": None, "mpu": 1.0, "local": False}
    sr_name = (desc["sr"] or {}).get("name") or "unknown"
    # Polar stereographic input of any WKID (or none): recognised by ``arcio.sr_info``.
    polar_input = sr_type == "Projected" and bool((desc["sr"] or {}).get("polar_stereographic"))
    if geographic_sr is not None and polar_input:
        # Its own scale is not 1 near the pole (EPSG 3031/3995: 0.973 at 90 degrees; 3032:
        # true scale at 71S; 9354 IBCSO: 65S).
        collector.info(
            "The {0} is in a polar stereographic system ({1}) whose scale is not 1 near the "
            "pole, so it is read in WGS 84 geographic coordinates and each feature is measured "
            "on its own projection: polar stereographic with true scale at the feature for "
            "features beyond 84N / 80S, Transverse Mercator centred on the feature otherwise "
            "(WGS 84 ellipsoid).".format(what, sr_name))
        return {"read_sr": geographic_sr(WGS84_GCS_WKID), "wkid": WGS84_GCS_WKID, "mpu": 1.0,
                "local": True}
    decision, read_sr = metric_sr_for(desc)
    zones = decision.get("utm_zones") or 0
    polar = bool(decision.get("polar")) and decision.get("reproject")
    if geographic_sr is not None and decision.get("reproject") \
            and (zones > MAX_UTM_ZONES_WITHOUT_WARNING or polar):
        if sr_type == "Geographic":
            read_sr, wkid = desc["sr_object"], (desc["sr"] or {}).get("wkid")
            source = "its own geographic coordinates"
        else:
            read_sr, wkid = geographic_sr(WGS84_GCS_WKID), WGS84_GCS_WKID
            source = "WGS 84 geographic coordinates"
        if polar:
            collector.info(
                "The {0} ({1}) is not in a projected metric system and is polar data (centre "
                "{2}). The polar stereographic systems (EPSG 3995/3031) have their true scale at "
                "71 degrees and measure 2-3 % short near the pole, so the {0} is read in {3} and "
                "each feature is measured on its own projection: polar stereographic with true "
                "scale at the feature for features beyond 84N / 80S, Transverse Mercator "
                "centred on the feature otherwise (WGS 84 ellipsoid).".format(
                    what, sr_name, "north of 84N" if decision["wkid"] == ARCTIC_POLAR_WKID
                    else "south of 80S", source))
        else:
            collector.info(
                "The {0} ({1}) is not in a projected metric system and spans {2} UTM zones, too "
                "wide for one zone to measure accurately. It is read in {3} and each feature is "
                "measured on its own Transverse Mercator projection centred on the feature (WGS "
                "84 ellipsoid, true scale on its central meridian).".format(
                    what, sr_name, zones, source))
        return {"read_sr": read_sr, "wkid": wkid, "mpu": 1.0, "local": True}
    collector.info(decision["reason"])
    if polar:  # no per-feature measuring possible here: say what the bias is
        collector.warning(
            "Polar data is measured in {0} (EPSG {1}), whose true scale is at 71 degrees: "
            "lengths near the pole are up to 2.7 % and areas up to 5.4 % short.".format(
                "WGS 84 / Arctic Polar Stereographic" if decision["wkid"] == ARCTIC_POLAR_WKID
                else "WGS 84 / Antarctic Polar Stereographic", decision["wkid"]))
    as_info = (decision.get("datum_warnings") or []) if datum_as_info else []
    for text in decision["warnings"]:
        if text in as_info:
            collector.info(text.replace(
                " For exact positions project the input to a projected metric coordinate "
                "system first (Project tool, with the right geographic transformation).",
                " The results are written back through the same projection, so they are not "
                "offset."))
        else:
            collector.warning(text)
    if read_sr is None:
        read_sr = desc["sr_object"]
    return {"read_sr": read_sr, "wkid": decision["wkid"],
            "mpu": decision["meters_per_unit"], "local": False}


def local_tm_rows(rows, collector):
    """Rows ``{"oid", "shape", ...}`` in geographic degrees -> the same rows with
    ``shape`` projected on each feature's own local Transverse Mercator (metres).

    Returns ``(rows, frames)``; ``frames[oid] = (lon0, (lo, hi))`` turns a point of
    that feature back into degrees (``local_tm_point_back``): ``lo``/``hi`` are the
    smallest and largest longitude the feature stores, so points go back in the
    input's own longitude convention (-180..180 or 0..360). A feature with a
    vertex farther than ``TM_MAX_FEATURE_OFFSET_M`` from its central meridian
    (about 1,000 km) cannot be measured accurately on one projection: warning
    with its ObjectIDs.

    A feature near a pole (``_projection_polar_sign``: beyond 84N / 80S, or round
    the pole) is projected on a polar stereographic instead (``local_ps_geometry``,
    true scale at the feature); its frame is ``(lon0, (lo, hi), sign, k_ref)``. A
    polar feature whose scale varies by more than ``PS_MAX_FEATURE_SPREAD`` over
    it gets a warning.
    """
    out, frames, wide, polar_wide = [], {}, [], []
    for row in rows:
        new = dict(row)
        lons, lats = [], []
        if row["shape"]:
            _projection_lonlats(row["shape"], lons)
            _projection_lats(row["shape"], lats)
        if not lons:
            new["shape"] = None
            out.append(new)
            continue
        _west, _east, lon0, width = longitude_span(lons)
        stored = (min(lons), max(lons))  # stored range: the input's longitude convention
        sign = _projection_polar_sign(lats, width)
        if sign:
            shape, k_ref, spread = local_ps_geometry(row["shape"], lon0, sign)
            frames[row["oid"]] = (lon0, stored, sign, k_ref)
            if spread > PS_MAX_FEATURE_SPREAD:
                polar_wide.append(row["oid"])
        else:
            shape = _projection_tm_node(row["shape"], lon0)
            frames[row["oid"]] = (lon0, stored)
            if _projection_max_abs_x(shape) > TM_MAX_FEATURE_OFFSET_M:
                wide.append(row["oid"])
        new["shape"] = shape
        out.append(new)
    if polar_wide:
        collector.warning(
            "{0} polar feature(s) span too many degrees of latitude for one polar stereographic "
            "projection to measure them within about 1 % (ObjectIDs {1}). Split them, or "
            "project the input to an equal-area or equidistant system suited to them first."
            .format(len(polar_wide), ", ".join(str(o) for o in sorted(polar_wide)[:20]) +
                    (", ..." if len(polar_wide) > 20 else "")))
    if wide:
        collector.warning(
            "{0} feature(s) reach more than {1:,.0f} km from the central meridian of their own "
            "Transverse Mercator projection (ObjectIDs {2}); even on that projection their "
            "measures can be off by more than 1 %. Split them, or project the input to an "
            "equal-area or equidistant system suited to them first."
            .format(len(wide), TM_MAX_FEATURE_OFFSET_M / 1000.0, ", ".join(
                str(o) for o in sorted(wide)[:20]) + (", ..." if len(wide) > 20 else "")))
    return out, frames


def _projection_max_abs_x(node):
    """Largest ``|x|`` of the vertices of a projected core geometry (0 if empty)."""
    if not isinstance(node, (list, tuple)) or not node:
        return 0.0
    if isinstance(node[0], (int, float)):
        return abs(float(node[0]))
    return max(_projection_max_abs_x(item) for item in node)


def _projection_lon_into_range(lon, stored, lon0=None):
    """Shift ``lon`` by whole turns into the longitudes the feature stores.

    ``stored`` is ``(lo, hi)``, the smallest and largest stored longitude of the
    feature (a single number is taken as ``(x, x)``). The shift that puts ``lon``
    inside ``[lo, hi]``, or nearest to it, wins (RT7-A-1 / RT8-C-4: a point used
    to be wrapped toward the feature's first vertex, so a part across the
    antimeridian from it came back 360 degrees away). Ties (a point exactly on
    the antimeridian) keep the input's convention: -180..180 when every stored
    longitude is in it, else 0..360 when every one is in that, then the side of
    the feature's central meridian ``lon0`` (the point as projected back), then
    the shift nearest the middle of the stored range."""
    if isinstance(stored, (int, float)):
        lo = hi = float(stored)
    else:
        lo, hi = float(stored[0]), float(stored[1])
    if -180.0 <= lo and hi <= 180.0:
        window = (-180.0, 180.0)
    elif 0.0 <= lo and hi <= 360.0:
        window = (0.0, 360.0)
    else:
        window = None
    mid = (lo + hi) / 2.0
    base = float(lon) + 360.0 * round((mid - float(lon)) / 360.0)
    best, best_key = base, None
    for cand in (base - 360.0, base, base + 360.0):
        gap = max(lo - cand, cand - hi, 0.0)
        outside = 0 if window is None or window[0] - 1e-9 <= cand <= window[1] + 1e-9 else 1
        side = 0.0 if lon0 is None else round(abs(cand - float(lon)), 9)
        key = (round(gap, 9), outside, side, abs(cand - mid))
        if best_key is None or key < best_key:
            best, best_key = cand, key
    return best


def local_tm_point_back(point, frame):
    """A point of ``local_tm_rows`` back in the degrees read (``frame`` from it).

    The longitude is put in the range of the feature's own stored longitudes
    (``_projection_lon_into_range``), so it stays in the input's convention
    whichever part of a multipart or antimeridian-crossing feature it is on."""
    if point is None or frame is None:
        return point
    if len(frame) > 2:  # polar stereographic frame (lon0, (lo, hi), sign, k_ref)
        lon, lat = ps_inverse(point[0], point[1], frame[0], frame[2], frame[3])
    else:
        lon, lat = tm_inverse(point[0], point[1], frame[0])
    return [_projection_lon_into_range(lon, frame[1], frame[0]), lat]


def local_tm_point_to_frame(point, frame):
    """A point ``(lon, lat)`` in the degrees read projected on the plane of one
    feature of ``local_tm_rows`` (``frame`` from it): the inverse of
    ``local_tm_point_back``. Used to measure another input (e.g. points)
    against that feature on the feature's own projection."""
    if point is None or frame is None:
        return point
    if len(frame) > 2:  # polar stereographic frame (lon0, (lo, hi), sign, k_ref)
        x, y = ps_forward(point[0], point[1], frame[0], frame[2], frame[3])
    else:
        x, y = tm_forward(point[0], point[1], frame[0])
    return [x, y]


# ==========================================================================
# common/geom.py
# ==========================================================================
# Pure-Python planar geometry on the toolkit's core representation.
#
# Core representation (see ARCHITECTURE)::
#
#     point       (x, y)
#     multipoint  [(x, y), ...]
#     polyline    [path, ...]            path = [(x, y), ...]
#     polygon     [ring, ...]            ring = [(x, y), ..., first point again]
#     null/empty  None
#
# Polygon rings follow the Esri convention: outer rings clockwise, holes
# counter-clockwise. All measures are planar, in the units of the coordinates;
# project to a metric system first (see ``projection``).
#
# The geometry *kind* is one of ``"point"``, ``"multipoint"``, ``"polyline"``,
# ``"polygon"`` (lower case, as used in Esri JSON helpers below).

GEOM_POINT = "point"
GEOM_MULTIPOINT = "multipoint"
GEOM_POLYLINE = "polyline"
GEOM_POLYGON = "polygon"

_GEOM_SHAPE_TYPES = {"point": GEOM_POINT, "multipoint": GEOM_MULTIPOINT,
                     "polyline": GEOM_POLYLINE, "polygon": GEOM_POLYGON}


def kind_from_shape_type(shape_type):
    """Map a Describe ``shapeType`` (``"Polygon"``...) to a core kind.

    Returns ``None`` for unsupported types such as ``"MultiPatch"``.
    """
    return _GEOM_SHAPE_TYPES.get(str(shape_type or "").casefold())


# --------------------------------------------------------------------------
# Basic measures
# --------------------------------------------------------------------------

def iter_points(kind, geom):
    """Yield every vertex of a core geometry."""
    if geom is None:
        return
    if kind == GEOM_POINT:
        yield geom
    elif kind == GEOM_MULTIPOINT:
        for p in geom:
            yield p
    else:
        for part in geom:
            for p in part:
                yield p


def geometry_bbox(kind, geom):
    """``(xmin, ymin, xmax, ymax)`` or ``None`` for an empty geometry."""
    xs, ys = [], []
    for x, y in iter_points(kind, geom):
        xs.append(x)
        ys.append(y)
    if not xs:
        return None
    return (min(xs), min(ys), max(xs), max(ys))


def bbox_intersects(a, b, tolerance=0.0):
    """True if two bboxes overlap or touch (within ``tolerance``)."""
    if a is None or b is None:
        return False
    return not (a[2] + tolerance < b[0] or b[2] + tolerance < a[0]
                or a[3] + tolerance < b[1] or b[3] + tolerance < a[1])


def point_distance(a, b):
    return math.hypot(b[0] - a[0], b[1] - a[1])


def path_length(path):
    """Length of one path (or ring)."""
    return sum(point_distance(path[i], path[i + 1]) for i in range(len(path) - 1))


def polyline_length(paths):
    """Total length of a polyline (all parts)."""
    if not paths:
        return 0.0
    return sum(path_length(p) for p in paths)


def ring_signed_area(ring):
    """Shoelace signed area: positive for counter-clockwise rings.

    Coordinates are shifted to the first vertex first, which keeps full
    precision for data far from the origin (e.g. UTM northings near 10^7).
    """
    n = len(ring)
    if n < 3:
        return 0.0
    x0, y0 = ring[0]
    total = 0.0
    for i in range(n - 1):
        x1, y1 = ring[i][0] - x0, ring[i][1] - y0
        x2, y2 = ring[i + 1][0] - x0, ring[i + 1][1] - y0
        total += x1 * y2 - x2 * y1
    # An unclosed ring needs no extra term: after the shift its closing
    # segment ends at the origin, whose cross product is zero.
    return total / 2.0


def ring_is_clockwise(ring):
    """True for clockwise rings (Esri outer rings)."""
    return ring_signed_area(ring) < 0


def close_ring(ring):
    """Copy of ``ring`` with the first vertex repeated at the end if needed."""
    ring = [tuple(p) for p in ring]
    if ring and ring[0] != ring[-1]:
        ring.append(ring[0])
    return ring


def polygon_area(rings):
    """Area of a polygon (all parts, holes subtracted), always >= 0."""
    total = 0.0
    for outer, holes in group_rings(rings):
        total += abs(ring_signed_area(outer)) - sum(abs(ring_signed_area(h)) for h in holes)
    return max(total, 0.0)


def polygon_perimeter(rings):
    """Length of all rings (outer and holes), like ``SHAPE@LENGTH`` for polygons."""
    return sum(path_length(r) for r in (rings or []))


def geometry_length(kind, geom):
    """Length for lines, perimeter for polygons, 0 for points."""
    if geom is None:
        return 0.0
    if kind == GEOM_POLYLINE:
        return polyline_length(geom)
    if kind == GEOM_POLYGON:
        return polygon_perimeter(geom)
    return 0.0


def part_count(kind, geom):
    """Number of parts (points of a multipoint, paths, or outer rings)."""
    if geom is None:
        return 0
    if kind == GEOM_POINT:
        return 1
    if kind == GEOM_POLYGON:
        return len(group_rings(geom))
    return len(geom)


# --------------------------------------------------------------------------
# Rings, containment
# --------------------------------------------------------------------------

def point_on_segment(p, a, b, tolerance=1e-9):
    """True if ``p`` lies on segment ``a``-``b`` (within ``tolerance``)."""
    return point_segment_distance(p, a, b)[0] <= tolerance


def point_in_ring(p, ring, tolerance=1e-9):
    """``"in"``, ``"out"`` or ``"boundary"`` for a point and one ring (ray casting)."""
    x, y = p
    inside = False
    n = len(ring)
    for i in range(n - 1 if ring and ring[0] == ring[-1] else n):
        a = ring[i]
        b = ring[(i + 1) % n]
        if point_on_segment(p, a, b, tolerance):
            return "boundary"
        if (a[1] > y) != (b[1] > y):
            x_cross = a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
            if x < x_cross:
                inside = not inside
    return "in" if inside else "out"


class _GeomRingProbe(object):
    """``point_in_ring`` for many points against one large ring.

    The ring's edges are filed in horizontal bands, so a query only looks at
    the edges whose y range reaches the point (a ray crossing or a boundary
    hit needs exactly those). Same answers as ``point_in_ring``, at about
    the cost of the edges in one band instead of every edge.
    """

    def __init__(self, ring, tolerance=1e-9):
        self.ring = ring
        self.tolerance = tolerance
        n = len(ring)
        self.count = n - 1 if ring and ring[0] == ring[-1] else n
        ys = [p[1] for p in ring]
        self.y0, self.y1 = min(ys), max(ys)
        self.bands = max(1, self.count // 4)
        span = self.y1 - self.y0
        self.height = span / self.bands if span > 0 and math.isfinite(span) else 0.0
        if self.height <= 0:
            self.bands = 1
        self.edges = [[] for _ in range(self.bands)]
        for i in range(self.count):
            a, b = ring[i], ring[(i + 1) % n]
            lo, hi = self._band(min(a[1], b[1])), self._band(max(a[1], b[1]))
            for k in range(lo, hi + 1):
                self.edges[k].append(i)

    def _band(self, y):
        if self.height <= 0:
            return 0
        k = int(math.floor((y - self.y0) / self.height))
        return min(max(k, 0), self.bands - 1)

    def locate(self, p):
        """``"in"``, ``"out"`` or ``"boundary"`` (see ``point_in_ring``)."""
        x, y = p
        tol = self.tolerance
        if y < self.y0 - tol or y > self.y1 + tol:
            return "out"
        lo, hi = self._band(y - tol), self._band(y + tol)
        if lo == hi:
            candidates = self.edges[lo]
        else:
            seen = set()
            for k in range(lo, hi + 1):
                seen.update(self.edges[k])
            candidates = sorted(seen)
        ring, n = self.ring, len(self.ring)
        inside = False
        for i in candidates:
            a, b = ring[i], ring[(i + 1) % n]
            if (min(a[0], b[0]) - tol <= x <= max(a[0], b[0]) + tol
                    and min(a[1], b[1]) - tol <= y <= max(a[1], b[1]) + tol
                    and point_on_segment(p, a, b, tol)):
                return "boundary"
            if (a[1] > y) != (b[1] > y):
                x_cross = a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
                if x < x_cross:
                    inside = not inside
        return "in" if inside else "out"


# Rings with more vertices than this get a _GeomRingProbe in group_rings.
_GEOM_PROBE_MIN_VERTICES = 64


def _geom_ring_inside(inner, outer, probe=None):
    """True if ring ``inner`` lies inside ring ``outer`` (vertex test).

    Uses the first vertex that is not on the boundary of ``outer``; rings that
    share every vertex are treated as inside. ``probe`` is an optional
    ``_GeomRingProbe`` of ``outer`` (same answers, faster for large rings).
    """
    for p in inner:
        state = probe.locate(p) if probe is not None else point_in_ring(p, outer)
        if state != "boundary":
            return state == "in"
    return True


def group_rings(rings):
    """Group rings into polygons: ``[(outer, [holes...]), ...]``.

    Clockwise rings are outers and counter-clockwise rings are holes (Esri
    convention). Each hole is assigned to the smallest outer that contains it.
    A hole contained by no outer is kept as its own outer (bad orientation in
    the source), so no ring is ever lost. Degenerate rings (area 0) are
    treated as outers. Output order follows input order.

    Candidate outers for a hole come from a ``GridIndex`` of ring bboxes, so a
    multipart polygon with many parts and holes is not parts x holes ring
    tests (a ring can only contain a vertex of the hole if their bboxes meet,
    so the result is the same as testing every outer).
    """
    rings = [close_ring(r) for r in (rings or []) if len(r) >= 3]
    outers, holes = [], []
    for r in rings:
        (holes if ring_signed_area(r) > 0 else outers).append(r)
    groups = [(o, []) for o in outers]
    if not holes:
        return groups
    boxes = [_geom_ring_bbox(r) for r in rings]
    width = max(b[2] for b in boxes) - min(b[0] for b in boxes)
    height = max(b[3] for b in boxes) - min(b[1] for b in boxes)
    # About one grid cell per ring over the extent of all rings.
    cell = max(math.sqrt(width * height / len(rings)), max(width, height) / len(rings))
    index = GridIndex(cell if cell > 0 and math.isfinite(cell) else 1.0)
    areas = []
    for idx, o in enumerate(outers):
        index.insert(idx, _geom_ring_bbox(o))
        areas.append(abs(ring_signed_area(o)))
    # Banded edge index per large candidate ring, built on first use: one
    # outer with thousands of vertices and hundreds of holes (a coastline
    # with lakes) is then not holes x vertices segment tests (RT4-A-2).
    probes = {}
    for h in holes:
        box = _geom_ring_bbox(h)
        best, best_area = None, None
        for idx in index.query(box):  # ascending: ties keep the first outer
            outer = groups[idx][0]
            probe = probes.get(idx)
            if probe is None and len(outer) > _GEOM_PROBE_MIN_VERTICES:
                probe = probes[idx] = _GeomRingProbe(outer)
            if _geom_ring_inside(h, outer, probe):
                area = areas[idx]
                if best is None or area < best_area:
                    best, best_area = idx, area
        if best is None:
            index.insert(len(groups), box)
            areas.append(abs(ring_signed_area(h)))
            groups.append((h, []))
        else:
            groups[best][1].append(h)
    return groups


def _geom_ring_bbox(ring):
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    return (min(xs), min(ys), max(xs), max(ys))


def point_in_polygon(p, rings, include_boundary=True):
    """True if ``p`` is inside the polygon (holes excluded)."""
    for outer, holes in group_rings(rings):
        state = point_in_ring(p, outer)
        if state == "boundary":
            return include_boundary
        if state == "out":
            continue
        in_hole = False
        for h in holes:
            hs = point_in_ring(p, h)
            if hs == "boundary":
                return include_boundary
            if hs == "in":
                in_hole = True
                break
        if not in_hole:
            return True
    return False


# --------------------------------------------------------------------------
# Segments
# --------------------------------------------------------------------------

def point_segment_distance(p, a, b):
    """``(distance, closest_point, t)`` from ``p`` to segment ``a``-``b``.

    ``t`` is the position of the closest point along the segment (0..1).
    """
    ax, ay = a
    dx, dy = b[0] - ax, b[1] - ay
    seg2 = dx * dx + dy * dy
    if seg2 == 0.0:
        return point_distance(p, a), (ax, ay), 0.0
    t = ((p[0] - ax) * dx + (p[1] - ay) * dy) / seg2
    t = min(1.0, max(0.0, t))
    c = (ax + t * dx, ay + t * dy)
    return point_distance(p, c), c, t


def _geom_cross(o, a, b):
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])


def segment_intersection(a, b, c, d, tolerance=1e-12):
    """Intersection of segments ``a``-``b`` and ``c``-``d``.

    Returns ``None``, ``("point", (x, y))`` or ``("overlap", (p, q))`` for
    collinear overlapping segments (``p``-``q`` is the shared piece).
    """
    r = (b[0] - a[0], b[1] - a[1])
    s = (d[0] - c[0], d[1] - c[1])
    denom = r[0] * s[1] - r[1] * s[0]
    qp = (c[0] - a[0], c[1] - a[1])
    scale = max(1.0, abs(r[0]), abs(r[1]), abs(s[0]), abs(s[1]))
    if abs(denom) <= tolerance * scale * scale:
        # Parallel. Collinear?
        if abs(qp[0] * r[1] - qp[1] * r[0]) > tolerance * scale * scale:
            return None
        rr = r[0] * r[0] + r[1] * r[1]
        if rr == 0.0:
            if point_on_segment(a, c, d, tolerance * scale):
                return ("point", (a[0], a[1]))
            return None
        t0 = (qp[0] * r[0] + qp[1] * r[1]) / rr
        t1 = t0 + (s[0] * r[0] + s[1] * r[1]) / rr
        lo, hi = max(0.0, min(t0, t1)), min(1.0, max(t0, t1))
        if lo > hi + tolerance:
            return None
        p = (a[0] + lo * r[0], a[1] + lo * r[1])
        q = (a[0] + hi * r[0], a[1] + hi * r[1])
        if abs(hi - lo) <= tolerance:
            return ("point", p)
        return ("overlap", (p, q))
    t = (qp[0] * s[1] - qp[1] * s[0]) / denom
    u = (qp[0] * r[1] - qp[1] * r[0]) / denom
    eps = tolerance
    if -eps <= t <= 1 + eps and -eps <= u <= 1 + eps:
        return ("point", (a[0] + t * r[0], a[1] + t * r[1]))
    return None


def densify_path(path, max_segment):
    """Copy of ``path`` with extra vertices so no segment exceeds ``max_segment``."""
    if max_segment <= 0:
        raise ValueError("max_segment must be positive")
    if not path:
        return []
    out = [tuple(path[0])]
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        n = int(math.ceil(point_distance(a, b) / max_segment))
        for k in range(1, n):
            f = float(k) / n
            out.append((a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1])))
        out.append(tuple(b))
    return out


def densify_path_segments(path, max_segment, wrap_longitude=False):
    """Copy of ``path`` with extra vertices so no segment exceeds ``max_segment``,
    each segment densified on its own (original vertices kept).

    ``wrap_longitude`` (geographic data, x = longitude in degrees): a segment
    spanning more than 180 degrees of longitude is taken to cross the
    antimeridian the short way; its new vertices are interpolated on the
    unwrapped longitude and wrapped back into [-180, 180).
    """
    if max_segment <= 0:
        raise ValueError("max_segment must be positive")
    if not path:
        return []
    out = [tuple(path[0])]
    for i in range(len(path) - 1):
        a, b = tuple(path[i]), tuple(path[i + 1])
        bx = b[0]
        if wrap_longitude and abs(bx - a[0]) > 180.0:
            bx += -360.0 if bx > a[0] else 360.0
        n = int(math.ceil(math.hypot(bx - a[0], b[1] - a[1]) / max_segment))
        for k in range(1, n):
            f = float(k) / n
            x = a[0] + f * (bx - a[0])
            if wrap_longitude:
                x = ((x + 180.0) % 360.0) - 180.0
            out.append((x, a[1] + f * (b[1] - a[1])))
        out.append(b)
    return out


# --------------------------------------------------------------------------
# Spatial index
# --------------------------------------------------------------------------

class GridIndex(object):
    """Uniform grid of bounding boxes for fast candidate-pair search.

    ``insert(key, box)`` registers a bbox; ``query(box)`` returns keys whose
    bbox intersects ``box``; ``candidate_pairs()`` returns all ``(k1, k2)``
    with ``k1 < k2`` and intersecting bboxes, sorted. Keys must be orderable.
    Choose ``cell_size`` around the typical feature size (plus any search
    tolerance, which can be passed to ``query``/``candidate_pairs``).
    """

    def __init__(self, cell_size):
        if not cell_size or cell_size <= 0:
            raise ValueError("cell_size must be positive")
        self.cell_size = float(cell_size)
        self.cells = {}
        self.boxes = {}

    def _cells_for(self, box, tolerance=0.0):
        cs = self.cell_size
        x0 = int(math.floor((box[0] - tolerance) / cs))
        y0 = int(math.floor((box[1] - tolerance) / cs))
        x1 = int(math.floor((box[2] + tolerance) / cs))
        y1 = int(math.floor((box[3] + tolerance) / cs))
        for gx in range(x0, x1 + 1):
            for gy in range(y0, y1 + 1):
                yield (gx, gy)

    def insert(self, key, box):
        if box is None:
            return
        self.boxes[key] = box
        for cell in self._cells_for(box):
            self.cells.setdefault(cell, []).append(key)

    def query(self, box, tolerance=0.0):
        found = set()
        for cell in self._cells_for(box, tolerance):
            for key in self.cells.get(cell, ()):
                if key not in found and bbox_intersects(self.boxes[key], box, tolerance):
                    found.add(key)
        return sorted(found)

    def candidate_pairs(self, tolerance=0.0):
        pairs = set()
        for keys in self.cells.values():
            for i in range(len(keys)):
                for j in range(i + 1, len(keys)):
                    k1, k2 = keys[i], keys[j]
                    if k1 == k2:
                        continue
                    if k2 < k1:
                        k1, k2 = k2, k1
                    if (k1, k2) not in pairs and bbox_intersects(
                            self.boxes[k1], self.boxes[k2], tolerance):
                        pairs.add((k1, k2))
        if tolerance > 0:
            # Boxes closer than the tolerance may sit in non-adjacent-by-content cells.
            for k1, box in self.boxes.items():
                for k2 in self.query(box, tolerance):
                    if k1 < k2:
                        pairs.add((k1, k2))
        return sorted(pairs)


# --------------------------------------------------------------------------
# Esri JSON <-> core
# --------------------------------------------------------------------------

def esri_json_has_curves(data):
    """True if an Esri JSON geometry dict contains true curves."""
    return isinstance(data, dict) and ("curvePaths" in data or "curveRings" in data)


def esri_json_zm(data):
    """``(has_z, has_m)`` of an Esri JSON geometry dict.

    Esri JSON marks Z and M with ``"hasZ": true`` / ``"hasM": true``. When neither key is
    present a coordinate with three numbers is read as Z. ``esri_json_to_core`` drops both."""
    if not isinstance(data, dict):
        return False, False
    has_z, has_m = data.get("hasZ") is True, data.get("hasM") is True
    if "hasZ" in data or "hasM" in data:
        return has_z, has_m
    first = None
    for key in ("rings", "paths"):
        parts = data.get(key)
        if parts and parts[0]:
            first = parts[0][0]
            break
    if first is None and data.get("points"):
        first = data["points"][0]
    return (first is not None and len(first) >= 3), False


def _geom_xy(coord):
    return (float(coord[0]), float(coord[1]))


def _geom_is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def esri_json_to_core(data):
    """Convert an Esri JSON geometry dict to ``(kind, geom)``.

    Z and M values are dropped. Empty geometries give ``(kind, None)``.
    Raises ``ValueError`` for curves (handle them before calling) and for
    unknown structures.
    """
    if data is None:
        return None, None
    if esri_json_has_curves(data):
        raise ValueError("true curves must be densified before conversion")
    if "x" in data:
        x, y = data.get("x"), data.get("y")
        if not (_geom_is_number(x) and _geom_is_number(y)):
            return GEOM_POINT, None
        return GEOM_POINT, (float(x), float(y))
    if "points" in data:
        pts = [_geom_xy(c) for c in data["points"]]
        return GEOM_MULTIPOINT, (pts or None)
    if "paths" in data:
        paths = [[_geom_xy(c) for c in path] for path in data["paths"]]
        paths = [p for p in paths if p]
        return GEOM_POLYLINE, (paths or None)
    if "rings" in data:
        rings = [close_ring([_geom_xy(c) for c in ring]) for ring in data["rings"]]
        rings = [r for r in rings if r]
        return GEOM_POLYGON, (rings or None)
    raise ValueError("unsupported Esri JSON geometry: keys {0}".format(sorted(data)))


def core_to_esri_json(kind, geom, wkid=None):
    """Convert a core geometry to an Esri JSON dict (for ``arcpy.AsShape(d, True)``).

    Returns ``None`` for a null geometry.
    """
    if geom is None:
        return None
    if kind == GEOM_POINT:
        data = {"x": float(geom[0]), "y": float(geom[1])}
    elif kind == GEOM_MULTIPOINT:
        data = {"points": [[float(x), float(y)] for (x, y) in geom]}
    elif kind == GEOM_POLYLINE:
        data = {"paths": [[[float(x), float(y)] for (x, y) in path] for path in geom]}
    elif kind == GEOM_POLYGON:
        data = {"rings": [[[float(x), float(y)] for (x, y) in close_ring(r)] for r in geom]}
    else:
        raise ValueError("unknown geometry kind: {0}".format(kind))
    if wkid:
        data["spatialReference"] = {"wkid": int(wkid)}
    return data


# --------------------------------------------------------------------------
# Vertex angles, segment lengths, spikes
# --------------------------------------------------------------------------

def _geom_distinct_ring(path):
    """Ring vertices without the closing duplicate."""
    pts = [tuple(p) for p in path]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    return pts


def vertex_angle(a, b, c):
    """Interior angle at ``b`` between legs ``b->a`` and ``b->c`` in degrees
    (0..180). ``None`` if a leg has zero length. 0 = spike (the line turns
    back on itself), 180 = straight."""
    v1 = (a[0] - b[0], a[1] - b[1])
    v2 = (c[0] - b[0], c[1] - b[1])
    if (v1[0] == 0.0 and v1[1] == 0.0) or (v2[0] == 0.0 and v2[1] == 0.0):
        return None
    cross = v1[0] * v2[1] - v1[1] * v2[0]
    dot = v1[0] * v2[0] + v1[1] * v2[1]
    return math.degrees(math.atan2(abs(cross), dot))


def turn_angle(a, b, c):
    """Signed change of direction at ``b`` in degrees, in (-180, 180]:
    positive = left (counter-clockwise) turn, 0 = straight on.
    ``None`` if a leg has zero length."""
    d1 = (b[0] - a[0], b[1] - a[1])
    d2 = (c[0] - b[0], c[1] - b[1])
    if (d1[0] == 0.0 and d1[1] == 0.0) or (d2[0] == 0.0 and d2[1] == 0.0):
        return None
    cross = d1[0] * d2[1] - d1[1] * d2[0]
    dot = d1[0] * d2[0] + d1[1] * d2[1]
    ang = math.degrees(math.atan2(cross, dot))
    return 180.0 if ang == -180.0 else ang


def path_is_closed(path):
    """True if the path has at least 4 points and first == last."""
    return len(path) >= 4 and tuple(path[0]) == tuple(path[-1])


def path_vertex_angles(path, closed=None, signed=False):
    """Angle at every vertex: ``vertex_angle`` (or ``turn_angle`` if ``signed``).

    ``closed=None`` detects rings (``path_is_closed``). Open path: one value
    per vertex, ``None`` at both ends. Ring: one value per *distinct*
    vertex (the closing duplicate is not repeated); the first vertex uses
    the last distinct vertex as its predecessor. Zero-length legs give
    ``None`` (remove duplicate vertices first if needed).
    """
    fn = turn_angle if signed else vertex_angle
    if closed is None:
        closed = path_is_closed(path)
    if closed:
        pts = _geom_distinct_ring(path)
        n = len(pts)
        if n < 3:
            return [None] * n
        return [fn(pts[i - 1], pts[i], pts[(i + 1) % n]) for i in range(n)]
    pts = [tuple(p) for p in path]
    n = len(pts)
    out = [None] * n
    for i in range(1, n - 1):
        out[i] = fn(pts[i - 1], pts[i], pts[i + 1])
    return out


def segment_lengths(path):
    """Length of every segment of ``path`` (``len(path) - 1`` values)."""
    return [point_distance(path[i], path[i + 1]) for i in range(len(path) - 1)]


def segment_length_stats(path):
    """``{"count", "min", "max", "mean", "total"}`` of the segment lengths
    (``None`` values for a path with no segment)."""
    lengths = segment_lengths(path)
    if not lengths:
        return {"count": 0, "min": None, "max": None, "mean": None, "total": 0.0}
    total = sum(lengths)
    return {"count": len(lengths), "min": min(lengths), "max": max(lengths),
            "mean": total / len(lengths), "total": total}


def find_spikes(path, max_angle, closed=None):
    """Vertex indices whose interior angle is below ``max_angle`` degrees.

    Indices refer to ``path`` (for rings: distinct vertices, index 0 = the
    start/closing vertex). Zero-length legs are not spikes (see
    ``near_duplicate_vertices``).
    """
    return [i for i, ang in enumerate(path_vertex_angles(path, closed))
            if ang is not None and ang < max_angle]


def near_duplicate_vertices(path, tolerance):
    """Indices ``i`` where vertex ``i`` and the next vertex are at most
    ``tolerance`` apart (exact duplicates included). For a ring the closing
    duplicate itself is not reported, but the pair (last distinct, first)
    is checked and reported as the last distinct index."""
    closed = path_is_closed(path)
    pts = _geom_distinct_ring(path) if closed else [tuple(p) for p in path]
    n = len(pts)
    out = [i for i in range(n - 1) if point_distance(pts[i], pts[i + 1]) <= tolerance]
    if closed and n > 1 and point_distance(pts[-1], pts[0]) <= tolerance:
        out.append(n - 1)
    return out


def remove_repeated_vertices(path, tolerance=0.0):
    """Copy of ``path`` without vertices within ``tolerance`` of the previous
    kept vertex. The first and last vertex are always kept (the last one
    replaces a kept vertex that is too close to it)."""
    pts = [tuple(p) for p in path]
    if len(pts) < 2:
        return pts
    out = [pts[0]]
    for p in pts[1:]:
        if point_distance(out[-1], p) > tolerance:
            out.append(p)
    if len(out) == 1:
        out.append(pts[-1])
    elif out[-1] != pts[-1]:
        out[-1] = pts[-1]
    return out


# --------------------------------------------------------------------------
# Measures along a path, interpolation, splitting
# --------------------------------------------------------------------------

def path_measures(path):
    """Cumulative distance at every vertex (first = 0; empty path -> [])."""
    if not path:
        return []
    out = [0.0]
    for i in range(len(path) - 1):
        out.append(out[-1] + point_distance(path[i], path[i + 1]))
    return out


def path_point_at(path, distance):
    """Point at ``distance`` along ``path``, clamped to [0, length].
    ``None`` for an empty path."""
    if not path:
        return None
    if distance <= 0 or len(path) == 1:
        return tuple(path[0])
    run = 0.0
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        seg = point_distance(a, b)
        if seg > 0 and run + seg >= distance:
            f = (distance - run) / seg
            return (a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1]))
        run += seg
    return tuple(path[-1])


def path_midpoint(path):
    """Point at half the length of ``path``."""
    return path_point_at(path, path_length(path) / 2.0)


def locate_point_on_path(p, path):
    """Project ``p`` onto ``path``.

    Returns ``{"measure", "offset", "side", "segment", "point"}``: distance
    along the path of the closest point, distance from ``p`` to it, side
    ``"L"`` or ``"R"`` of the digitising direction (``""`` when on the line),
    the segment index and the closest point. The first closest segment wins
    on ties. ``None`` for a path with fewer than 2 vertices.
    """
    if len(path) < 2:
        return None
    best = None
    run = 0.0
    for i in range(len(path) - 1):
        a, b = path[i], path[i + 1]
        d, c, t = point_segment_distance(p, a, b)
        seg = point_distance(a, b)
        if best is None or d < best[0]:
            cross = _geom_cross(a, b, p)
            side = "" if d == 0.0 or cross == 0.0 else ("L" if cross > 0 else "R")
            best = (d, run + t * seg, side, i, c)
        run += seg
    return {"offset": best[0], "measure": best[1], "side": best[2], "segment": best[3],
            "point": best[4]}


def split_path_at_distances(path, distances, min_length=0.0):
    """Split ``path`` at the given distances along it.

    Distances outside (0, length) are ignored and duplicates merged. Each
    piece keeps the original vertices between its cut points; the first and
    last piece end exactly on the original end vertices. Pieces not longer
    than ``min_length`` (default: zero-length pieces) are dropped.
    """
    pts = [tuple(p) for p in path]
    if len(pts) < 2:
        return []
    total = path_length(pts)
    cuts = sorted(set(float(d) for d in distances if 0.0 < d < total))
    measures = path_measures(pts)
    bounds = [0.0] + cuts + [total]
    pieces = []
    last = len(bounds) - 2
    for k in range(len(bounds) - 1):
        lo, hi = bounds[k], bounds[k + 1]
        piece = [pts[0] if k == 0 else path_point_at(pts, lo)]
        for i in range(1, len(pts) - 1):
            if lo < measures[i] < hi:
                piece.append(pts[i])
        piece.append(pts[-1] if k == last else path_point_at(pts, hi))
        if path_length(piece) > min_length:
            pieces.append(piece)
    return pieces


def split_path_at_vertices(path, min_length=0.0):
    """One two-point piece per segment; pieces not longer than ``min_length``
    (default: zero-length segments) are dropped."""
    pts = [tuple(p) for p in path]
    return [[pts[i], pts[i + 1]] for i in range(len(pts) - 1)
            if point_distance(pts[i], pts[i + 1]) > min_length]


def split_distances(length, max_length, mode="fixed"):
    """Cut distances so that no piece exceeds ``max_length``.

    ``"fixed"``: cuts at ``max_length``, ``2*max_length``, ... (the last piece
    is the remainder); ``"equal"``: ``ceil(length / max_length)`` equal
    pieces. A remainder shorter than 1e-9 * ``max_length`` is not cut off.
    """
    if max_length <= 0:
        raise ValueError("max_length must be positive")
    if mode not in ("fixed", "equal"):
        raise ValueError("mode must be 'fixed' or 'equal'")
    if length <= max_length * (1 + 1e-9):
        return []
    if mode == "equal":
        n = int(math.ceil(length / max_length - 1e-9))
        return [length * k / n for k in range(1, n)]
    eps = 1e-9 * max_length
    out = []
    k = 1
    while k * max_length < length - eps:
        out.append(k * max_length)
        k += 1
    return out


# ==========================================================================
# common/clip.py
# ==========================================================================
# Convex clipping and polygon centroids (pure Python).
#
# * Half-plane clipping of one ring (one Sutherland-Hodgman stage), the
#   bisector half-plane of two sites (Voronoi cells by successive clipping),
#   clipping against an axis-aligned rectangle or any convex ring.
# * Cyrus-Beck clipping of a segment against a convex ring (interior overlap
#   tests: a segment that only runs along the boundary has zero inside length
#   only if callers use ``strict=True``).
# * Ring / polygon centroids (area-weighted, holes subtracted).
#
# Deliberately **no general polygon-polygon overlay**. The subject ring may be
# concave when the clip region is convex; a concave subject can then produce
# zero-width "bridges" along the clip boundary (standard Sutherland-Hodgman
# behaviour): area and centroid stay correct, the vertex list is not
# simplified. Output rings are closed (first == last) and keep the
# orientation of the input ring; ``[]`` means nothing is left.
#
# A half-plane ``(a, b, c)`` is the set of points with ``a*x + b*y <= c``.

# Relative tolerance for "on the clip line" decisions.
CLIP_EPSILON = 1e-12


def _clip_open(ring):
    pts = [tuple(p) for p in ring]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    return pts


def _clip_finish(pts):
    """Drop consecutive duplicates; close; ``[]`` if fewer than 3 vertices."""
    out = []
    for p in pts:
        if not out or p != out[-1]:
            out.append(p)
    if len(out) > 1 and out[0] == out[-1]:
        out.pop()
    if len(out) < 3:
        return []
    return close_ring(out)


def clip_ring_halfplane(ring, a, b, c):
    """Keep the part of ``ring`` with ``a*x + b*y <= c`` (one Sutherland-Hodgman stage).

    Vertices within a relative tolerance of the line count as inside.
    Returns a closed ring or ``[]``.
    """
    pts = _clip_open(ring)
    if not pts:
        return []
    scale = max(1.0, abs(c), max(abs(a * x) + abs(b * y) for x, y in pts))
    eps = CLIP_EPSILON * scale
    vals = [a * x + b * y - c for x, y in pts]
    out = []
    n = len(pts)
    for i in range(n):
        p, q = pts[i], pts[(i + 1) % n]
        vp, vq = vals[i], vals[(i + 1) % n]
        p_in, q_in = vp <= eps, vq <= eps
        if p_in:
            out.append(p)
        if p_in != q_in and abs(vp - vq) > 0:
            t = vp / (vp - vq)
            if 0.0 < t < 1.0:
                out.append((p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])))
    return _clip_finish(out)


def bisector_halfplane(site, other):
    """Half-plane of points at least as close to ``site`` as to ``other``.

    ``|x - s|^2 <= |x - o|^2``  <=>  ``2(o - s) . x <= |o|^2 - |s|^2``.
    Raises ``ValueError`` for identical sites.
    """
    sx, sy = site
    ox, oy = other
    if sx == ox and sy == oy:
        raise ValueError("identical sites have no bisector")
    a = 2.0 * (ox - sx)
    b = 2.0 * (oy - sy)
    c = (ox * ox + oy * oy) - (sx * sx + sy * sy)
    return a, b, c


def rect_ring(xmin, ymin, xmax, ymax, clockwise=True):
    """Closed rectangle ring (clockwise = Esri outer ring by default)."""
    if clockwise:
        pts = [(xmin, ymin), (xmin, ymax), (xmax, ymax), (xmax, ymin)]
    else:
        pts = [(xmin, ymin), (xmax, ymin), (xmax, ymax), (xmin, ymax)]
    return close_ring(pts)


def clip_ring_rect(ring, xmin, ymin, xmax, ymax):
    """Sutherland-Hodgman clip of ``ring`` against an axis-aligned rectangle."""
    if xmin > xmax or ymin > ymax:
        raise ValueError("empty rectangle")
    out = ring
    for a, b, c in ((-1.0, 0.0, -xmin), (1.0, 0.0, xmax), (0.0, -1.0, -ymin), (0.0, 1.0, ymax)):
        out = clip_ring_halfplane(out, a, b, c)
        if not out:
            return []
    return out


def ring_is_convex(ring, tolerance=1e-9):
    """True if ``ring`` is convex (collinear vertices allowed, any orientation).

    Degenerate rings (fewer than 3 distinct vertices or zero area) are not convex.

    A vertex counts as collinear (no turn) only if the sine of its turn angle
    is at most ``tolerance`` (``|cross| <= tolerance * |e1| * |e2|``), plus a
    floating-point floor of ``CLIP_EPSILON * max|coordinate| * (|e1| + |e2|)``
    (a vertex within about 1e-12 of the coordinate size of the line through its
    neighbours). The test is relative to the edge lengths, not to the square
    of the coordinates: a densified edge that is slightly concave (a parallel
    projected to UTM, with a vertex every few hundred metres) turns by a tiny
    angle at each vertex but is still concave, and must be refused, however
    finely it is densified.
    """
    pts = _clip_open(ring)
    n = len(pts)
    if n < 3 or ring_signed_area(close_ring(pts)) == 0.0:
        return False
    floor = CLIP_EPSILON * max(1.0, max(max(abs(x), abs(y)) for x, y in pts))
    sign = 0
    for i in range(n):
        o, p, q = pts[i], pts[(i + 1) % n], pts[(i + 2) % n]
        ux, uy = p[0] - o[0], p[1] - o[1]
        vx, vy = q[0] - p[0], q[1] - p[1]
        cross = ux * vy - uy * vx
        lu, lv = math.hypot(ux, uy), math.hypot(vx, vy)
        if abs(cross) <= tolerance * lu * lv + floor * (lu + lv):
            continue
        s = 1 if cross > 0 else -1
        if sign == 0:
            sign = s
        elif s != sign:
            return False
    # A star polygon turns the same way at every vertex but winds twice.
    total = 0.0
    for i in range(n):
        o, p, q = pts[i - 1], pts[i], pts[(i + 1) % n]
        a1 = math.atan2(p[1] - o[1], p[0] - o[0])
        a2 = math.atan2(q[1] - p[1], q[0] - p[0])
        d = a2 - a1
        while d <= -math.pi:
            d += 2 * math.pi
        while d > math.pi:
            d -= 2 * math.pi
        total += d
    return abs(abs(total) - 2 * math.pi) < 1e-6


def _clip_hull_indexes(pts):
    """Indexes of the strict convex hull of ``pts`` (Andrew's monotone chain),
    counter-clockwise, collinear and duplicate points left out."""
    order = sorted(range(len(pts)), key=lambda i: pts[i])

    def cross(o, a, b):
        return ((pts[a][0] - pts[o][0]) * (pts[b][1] - pts[o][1]) -
                (pts[a][1] - pts[o][1]) * (pts[b][0] - pts[o][0]))

    lower, upper = [], []
    for i in order:
        while len(lower) >= 2 and cross(lower[-2], lower[-1], i) <= 0:
            lower.pop()
        lower.append(i)
    for i in reversed(order):
        while len(upper) >= 2 and cross(upper[-2], upper[-1], i) <= 0:
            upper.pop()
        upper.append(i)
    hull = lower[:-1] + upper[:-1]
    out = []
    for i in hull:  # duplicates of the first point can survive at both ends
        if not out or pts[i] != pts[out[-1]]:
            out.append(i)
    if len(out) > 1 and pts[out[0]] == pts[out[-1]]:
        out.pop()
    return out


def convex_hull_points(points):
    """Strict convex hull of ``points`` (``(x, y)`` tuples), counter-clockwise,
    open (first point not repeated); fewer than 3 points when they are collinear."""
    pts = sorted(set(tuple(p) for p in points))
    return [pts[i] for i in _clip_hull_indexes(pts)]


def near_convex_ring(ring, tolerance):
    """The convex hull of ``ring`` when the ring is convex up to ``tolerance``, else ``None``.

    ``tolerance`` is an absolute distance (coordinate units). The ring is accepted
    when (a) it runs around its convex hull in the hull's order (no star polygon, no
    loop) and (b) every vertex lies at most ``tolerance`` inside the hull edge of the
    stretch it belongs to. So the region between the ring and its hull is never
    deeper than ``tolerance``, however finely an edge is densified: a densified edge
    that bows inwards by more than ``tolerance`` anywhere is refused, while
    vertices on a straight edge that were rounded to the geodatabase resolution
    (a few 0.01 mm off the line) are accepted. The returned ring is the hull,
    closed, in the orientation of the input ring; it is exactly convex, so
    clipping with its half-planes is exact; its vertices are the hull vertices in
    the ring's own order, starting with the first of them in the ring (a strictly
    convex ring comes back unchanged, closed). Degenerate rings (fewer than 3
    distinct vertices, zero area) give ``None``.
    """
    pts = []
    for p in _clip_open(ring):
        if not pts or p != pts[-1]:
            pts.append(p)
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts.pop()
    n = len(pts)
    if n < 3:
        return None
    area = ring_signed_area(close_ring(pts))
    if area == 0.0:
        return None
    hull = _clip_hull_indexes(pts)
    if len(hull) < 3:
        return None
    # Position of every vertex along the ring, walked counter-clockwise (as the hull).
    if area > 0:
        pos = list(range(n))
    else:
        pos = [n - 1 - i for i in range(n)]
    walk = sorted(range(n), key=lambda i: pos[i])
    hpos = [pos[i] for i in hull]
    descents = sum(1 for k in range(len(hull)) if hpos[(k + 1) % len(hull)] < hpos[k])
    if descents != 1:
        return None  # the ring does not go round its hull once, in order
    for k in range(len(hull)):
        a, b = pts[hull[k]], pts[hull[(k + 1) % len(hull)]]
        ex, ey = b[0] - a[0], b[1] - a[1]
        length = math.hypot(ex, ey)
        if length == 0.0:
            continue
        start, end = hpos[k], hpos[(k + 1) % len(hull)]
        steps = (end - start) % n
        for s in range(1, steps):
            p = pts[walk[(start + s) % n]]
            # Left of a counter-clockwise hull edge = inside; depth below the edge.
            depth = (ex * (p[1] - a[1]) - ey * (p[0] - a[0])) / length
            if depth > tolerance:
                return None
    # Hull vertices in the ring's own order, starting at the first one met along the
    # ring, so a ring that is already strictly convex comes back unchanged.
    keep = sorted(hull)
    return close_ring([pts[i] for i in keep])


def convex_halfplanes(convex_ring):
    """The half-planes ``(a, b, c)`` whose intersection is ``convex_ring``
    (either orientation; zero-length edges skipped)."""
    pts = _clip_open(convex_ring)
    ccw = ring_signed_area(close_ring(pts)) > 0
    planes = []
    n = len(pts)
    for i in range(n):
        p, q = pts[i], pts[(i + 1) % n]
        dx, dy = q[0] - p[0], q[1] - p[1]
        if dx == 0.0 and dy == 0.0:
            continue
        # Inside is to the left of each edge for a CCW ring: cross(d, x - p) >= 0
        # <=> dy*x - dx*y <= dy*px - dx*py.
        a, b = dy, -dx
        if not ccw:
            a, b = -a, -b
        planes.append((a, b, a * p[0] + b * p[1]))
    return planes


def clip_ring_convex(ring, convex_ring):
    """Clip ``ring`` against a convex ring (``ValueError`` if not convex)."""
    if not ring_is_convex(convex_ring):
        raise ValueError("clip ring is not convex")
    out = ring
    for a, b, c in convex_halfplanes(convex_ring):
        out = clip_ring_halfplane(out, a, b, c)
        if not out:
            return []
    return out


def clip_segment_convex(p, q, convex_ring, strict=False):
    """Cyrus-Beck: the part of segment ``p``-``q`` inside a convex ring.

    Returns ``(t0, t1)`` parameters along the segment (0..1) or ``None``.
    ``strict=True`` uses the open interior: a segment lying on the boundary
    (or touching it at one point) gives ``None``. Tolerance is relative to
    the coordinate scale.
    """
    planes = convex_halfplanes(convex_ring)
    if not planes:
        return None
    dx, dy = q[0] - p[0], q[1] - p[1]
    scale = max(1.0, abs(p[0]), abs(p[1]), abs(q[0]), abs(q[1]))
    t0, t1 = 0.0, 1.0
    for a, b, c in planes:
        norm = math.hypot(a, b)
        eps = CLIP_EPSILON * scale * norm * 1e3
        num = c - (a * p[0] + b * p[1])     # >= 0 when p is inside
        den = a * dx + b * dy
        if strict:
            num -= eps
        else:
            num += eps
        if den == 0.0:
            if num < 0:
                return None
            continue
        t = num / den
        if den > 0:
            t1 = min(t1, t)
        else:
            t0 = max(t0, t)
        if t0 > t1:
            return None
    if strict and t1 - t0 <= 0.0:
        return None
    return (t0, t1)


def segment_inside_length(p, q, convex_ring, strict=True):
    """Length of segment ``p``-``q`` inside a convex ring (0.0 if none);
    ``strict`` as in ``clip_segment_convex``."""
    hit = clip_segment_convex(p, q, convex_ring, strict)
    if hit is None:
        return 0.0
    return (hit[1] - hit[0]) * math.hypot(q[0] - p[0], q[1] - p[1])


# --------------------------------------------------------------------------
# Centroids
# --------------------------------------------------------------------------

def ring_centroid(ring):
    """``(cx, cy, signed_area)`` of a ring (shoelace, shifted to the first
    vertex for precision). A zero-area ring gives the mean of its distinct
    vertices and area 0; an empty ring ``None``."""
    pts = _clip_open(ring)
    if not pts:
        return None
    x0, y0 = pts[0]
    n = len(pts)
    a2 = 0.0
    cx = cy = 0.0
    for i in range(n):
        x1, y1 = pts[i][0] - x0, pts[i][1] - y0
        x2, y2 = pts[(i + 1) % n][0] - x0, pts[(i + 1) % n][1] - y0
        cross = x1 * y2 - x2 * y1
        a2 += cross
        cx += (x1 + x2) * cross
        cy += (y1 + y2) * cross
    if a2 == 0.0:
        return (sum(p[0] for p in pts) / n, sum(p[1] for p in pts) / n, 0.0)
    return (x0 + cx / (3.0 * a2), y0 + cy / (3.0 * a2), a2 / 2.0)


def polygon_centroid(rings):
    """Area-weighted centroid ``(x, y)`` of a polygon (all parts, holes
    subtracted; ring orientation is taken from ``group_rings``, not from
    the sign of each ring). ``None`` for an empty polygon; a polygon of
    zero area gives the mean of its outer-ring vertices."""
    groups = group_rings(rings)
    if not groups:
        return None
    sx = sy = total = 0.0
    for outer, holes in groups:
        for ring, sign in [(outer, 1.0)] + [(h, -1.0) for h in holes]:
            cx, cy, a = ring_centroid(ring)
            w = sign * abs(a)
            sx += cx * w
            sy += cy * w
            total += w
    if total == 0.0:
        pts = [p for outer, _h in groups for p in _clip_open(outer)]
        return (sum(p[0] for p in pts) / len(pts), sum(p[1] for p in pts) / len(pts))
    return (sx / total, sy / total)


# ==========================================================================
# common/anchor.py
# ==========================================================================
# Pole of inaccessibility (label anchor) for polygons, pure Python.
#
# The pole of inaccessibility is the interior point farthest from the polygon
# boundary (holes included); its distance to the boundary is the radius of the
# largest inscribed circle. Implemented from the published description of the
# "polylabel" algorithm (Agafonkin, Mapbox blog, 2016): cover the bounding box
# with square cells, keep them in a priority queue ordered by the best distance
# any point of the cell could reach (centre distance + half diagonal), split the
# most promising cell into four, and stop exploring a cell once it cannot beat
# the best point found by more than ``precision``. No code was copied.
#
# Guarantee: the returned distance is within the *effective* precision of the
# true maximum (up to the cell budget, see ``ANCHOR_MAX_CELLS``). The effective
# precision is ``max(precision, ANCHOR_REL_PRECISION x the larger bbox side)``
# (``effective_precision``), so long strips cannot exhaust the cell budget;
# the first cells are never smaller than that precision, so thin slivers do not
# start with length / width cells either.
# Polygons with many edges measure distances through a ``SegmentGrid`` (same
# results as a full scan, without scanning every edge for every cell). The
# returned point is always inside the polygon when the polygon has an interior.
#
# Multipart polygons (``polygon_anchor``): the pole of the **largest part by
# area** (outer ring minus its holes) is returned; ties keep the first part in
# input order. This is decided once for every feature, so labels of multipart
# features always sit in their main part.

# Safety cap on the number of cells examined (precision far below the polygon
# size would otherwise explode); when reached, the best point so far is
# returned and ``polygon_anchor`` reports ``"capped": True``.
ANCHOR_MAX_CELLS = 200000


# Relative precision floor: the search never works finer than this fraction of
# the polygon's larger bbox side. A long strip (road, canal, river polygon) has a
# plateau of near-equal distances along its medial line; without a floor every
# cell of that plateau would be refined to ``precision`` and the search would
# run into ``ANCHOR_MAX_CELLS``. 1e-4 is 0.1 m on a 1 km polygon.
ANCHOR_REL_PRECISION = 1e-4

# Polygons with more edges than this use ``SegmentGrid`` for distances.
ANCHOR_GRID_MIN_SEGMENTS = 24


def effective_precision(precision, width, height):
    """Precision actually used: ``max(precision, ANCHOR_REL_PRECISION * max(width, height))``."""
    return max(float(precision), ANCHOR_REL_PRECISION * max(width, height))


class SegmentGrid(object):
    """Uniform grid over the segments of closed rings (or open paths).

    * ``nearest_distance(p)``: exact distance to the nearest segment, searched
      ring by ring of grid cells outwards (stops once no farther cell can be
      closer);
    * ``inside(p)``: even-odd ray-casting test using only the segments of the
      point's grid row (same crossing rule as a full scan, so the same answer);
    * ``signed_distance(p)``: positive inside, negative outside, 0 on an edge.

    Building is linear in the number of segments (plus the cells long segments
    cover); each query touches only nearby segments, so testing many points
    against a large polygon is not points x vertices.
    """

    def __init__(self, segments):
        self.segs = [(tuple(a), tuple(b)) for a, b in segments]
        xs = [p[0] for s in self.segs for p in s] or [0.0]
        ys = [p[1] for s in self.segs for p in s] or [0.0]
        self.x0, self.y0 = min(xs), min(ys)
        width, height = max(xs) - self.x0, max(ys) - self.y0
        n = max(len(self.segs), 1)
        size = max(width, height, 1e-300)
        cell = math.sqrt(max(width * height, size * size / n) / n)
        self.cell = max(cell, size / 4096.0, 1e-300)
        self.cols = int(width / self.cell) + 1
        self.rows = int(height / self.cell) + 1
        self.cells = {}
        self.bands = {}
        for idx, (a, b) in enumerate(self.segs):
            c0, c1 = sorted((self._col(a[0]), self._col(b[0])))
            r0, r1 = sorted((self._row(a[1]), self._row(b[1])))
            for r in range(r0, r1 + 1):
                self.bands.setdefault(r, []).append(idx)
                for c in range(c0, c1 + 1):
                    self.cells.setdefault((c, r), []).append(idx)

    def _col(self, x):
        return min(max(int((x - self.x0) / self.cell), 0), self.cols - 1)

    def _row(self, y):
        return min(max(int((y - self.y0) / self.cell), 0), self.rows - 1)

    def inside(self, p):
        x, y = p
        if y < self.y0 or y > self.y0 + self.rows * self.cell:
            return False
        inside = False
        for idx in self.bands.get(self._row(y), ()):
            a, b = self.segs[idx]
            if (a[1] > y) != (b[1] > y):
                if x < a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1]):
                    inside = not inside
        return inside

    def nearest_distance(self, p):
        if not self.segs:
            return float("inf")
        x, y = p
        cx = int(math.floor((x - self.x0) / self.cell))
        cy = int(math.floor((y - self.y0) / self.cell))
        best = float("inf")
        seen = set()
        # Rings that do not reach the grid yet are empty: start at the first one that does.
        start = max(0, cx - (self.cols - 1), -cx, cy - (self.rows - 1), -cy)
        limit = start + max(self.cols, self.rows) + 1
        for r in range(start, limit + 1):
            for gx in range(cx - r, cx + r + 1):
                for gy in ((cy - r, cy + r) if 0 < r else (cy,)):
                    best = self._scan(gx, gy, p, best, seen)
            for gy in range(cy - r + 1, cy + r):
                if r > 0:
                    best = self._scan(cx - r, gy, p, best, seen)
                    best = self._scan(cx + r, gy, p, best, seen)
            # Every segment not yet seen lies in a cell at least r rings away.
            if best <= r * self.cell:
                break
        return best

    def _scan(self, gx, gy, p, best, seen):
        for idx in self.cells.get((gx, gy), ()):
            if idx in seen:
                continue
            seen.add(idx)
            a, b = self.segs[idx]
            d = point_segment_distance(p, a, b)[0]
            if d < best:
                best = d
        return best

    def signed_distance(self, p):
        d = self.nearest_distance(p)
        if d == 0.0:
            return 0.0
        return d if self.inside(p) else -d


def _anchor_segments(rings):
    segs = []
    for ring in rings:
        pts = [tuple(p) for p in ring]
        if len(pts) > 1 and pts[0] != pts[-1]:
            pts.append(pts[0])
        for i in range(len(pts) - 1):
            segs.append((pts[i], pts[i + 1]))
    return segs


def signed_distance_to_rings(p, rings):
    """Distance from ``p`` to the nearest ring edge; positive inside the
    polygon formed by ``rings`` (even-odd rule, so holes count as outside),
    negative outside, 0 on the boundary."""
    segs = _anchor_segments(rings)
    if not segs:
        return float("-inf")
    return _anchor_signed(p, segs)


def _anchor_signed(p, segs):
    x, y = p
    inside = False
    best = float("inf")
    hypot = math.hypot
    for a, b in segs:
        ax, ay = a
        bx, by = b
        if (ay > y) != (by > y):
            x_cross = ax + (y - ay) * (bx - ax) / (by - ay)
            if x < x_cross:
                inside = not inside
        # Same arithmetic as common.geom.point_segment_distance, inlined: this
        # loop runs for every cell of the search (it dominates the run time).
        dx, dy = bx - ax, by - ay
        seg2 = dx * dx + dy * dy
        if seg2 == 0.0:
            d = hypot(ax - x, ay - y)
        else:
            t = ((x - ax) * dx + (y - ay) * dy) / seg2
            if t < 0.0:
                t = 0.0
            elif t > 1.0:
                t = 1.0
            d = hypot(ax + t * dx - x, ay + t * dy - y)
        if d < best:
            best = d
    if best == 0.0:
        return 0.0
    return best if inside else -best


def pole_of_inaccessibility(rings, precision=1.0):
    """``(x, y, distance)`` of the pole of inaccessibility of ``rings``.

    ``rings``: one polygon part (outer ring and its holes; orientation does
    not matter, even-odd rule). ``precision``: absolute tolerance on the
    distance, in coordinate units (must be > 0). Degenerate input (zero
    width or height) returns the bbox centre with distance 0; empty input
    returns ``None``.
    """
    result = _anchor_pole(rings, precision)
    return None if result is None else result[:3]


def pole_with_status(rings, precision=1.0, max_cells=None):
    """``(x, y, distance, capped, error_bound)`` for one polygon part (outer ring and
    its holes): like ``pole_of_inaccessibility`` plus whether the cell budget
    (``max_cells``, default ``ANCHOR_MAX_CELLS``) was reached. ``error_bound`` is an
    upper bound of how far ``distance`` can be below the true maximum: the effective
    precision when the search finished, the largest remaining cell potential minus
    ``distance`` when it was capped. Empty input gives ``(0.0, 0.0, 0.0, False, 0.0)``."""
    result = _anchor_pole(rings, precision, max_cells, True)
    return (0.0, 0.0, 0.0, False, 0.0) if result is None else result


def _anchor_pole(rings, precision, max_cells=None, with_bound=False):
    if not precision or precision <= 0:
        raise ValueError("precision must be positive")
    max_cells = ANCHOR_MAX_CELLS if max_cells is None else int(max_cells)

    def done(x, y, d, capped, bound):
        return (x, y, d, capped, bound) if with_bound else (x, y, d, capped)

    segs = _anchor_segments(rings)
    if not segs:
        return None
    xs = [p[0] for s in segs for p in s]
    ys = [p[1] for s in segs for p in s]
    xmin, ymin, xmax, ymax = min(xs), min(ys), max(xs), max(ys)
    width, height = xmax - xmin, ymax - ymin
    cell = min(width, height)
    if cell == 0.0:
        return done((xmin + xmax) / 2.0, (ymin + ymax) / 2.0, 0.0, False, 0.0)
    if all(ring_signed_area(list(r)) == 0.0 for r in rings):
        # No interior at all (e.g. a ring that runs out and back along a line):
        # nothing to search, and the search for a positive distance would only
        # run into the cell budget.
        return done((xmin + xmax) / 2.0, (ymin + ymax) / 2.0, 0.0, False, 0.0)
    precision = effective_precision(precision, width, height)
    # A tolerance above the larger bbox side says nothing more (no inscribed circle has a
    # radius above half the shorter side), but it made the first cell far larger than the
    # part, with its centre far outside: when the first guesses lie in a hole or notch the
    # search then split such cells with slow distance queries from far away (152 s for a
    # 1.7 m blob with a hole at a precision of 458,000 units).
    precision = min(precision, max(width, height))
    # First cells are never finer than the precision (a 3 km x 1 mm sliver would
    # otherwise start with 3,000,000 cells of side 1 mm, before any budget check),
    # and never so many that they alone use up a quarter of the cell budget.
    cell = max(cell, precision)
    first = math.ceil(width / cell) * math.ceil(height / cell)
    if first > max_cells // 4:
        cell *= math.sqrt(first / float(max(max_cells // 4, 1))) * 1.01
    if len(segs) > ANCHOR_GRID_MIN_SEGMENTS:
        signed = SegmentGrid(segs).signed_distance
    else:
        def signed(q):
            return _anchor_signed(q, segs)
    h = cell / 2.0
    heap = []
    counter = [0]

    def push(cx, cy, half):
        d = signed((cx, cy))
        potential = d + half * math.sqrt(2.0)
        counter[0] += 1
        # max-heap on potential; counter keeps the order deterministic
        heapq.heappush(heap, (-potential, counter[0], cx, cy, half, d))
        return d

    x = xmin
    while x < xmax:
        y = ymin
        while y < ymax:
            push(x + h, y + h, h)
            y += cell
        x += cell

    # Initial guesses: area centroid, then bbox centre.
    best = None
    cen = polygon_centroid([list(r) for r in rings])
    for gx, gy in ([cen] if cen else []) + [((xmin + xmax) / 2.0, (ymin + ymax) / 2.0)]:
        d = signed((gx, gy))
        if best is None or d > best[2]:
            best = (gx, gy, d)

    capped = False
    bound = precision
    # A first guess exactly on an edge gives a distance of float noise (~1e-15), not a
    # point inside: treat a distance this small as "nothing found yet" (comb case).
    on_edge = 1e-9 * max(width, height)
    while heap:
        neg_pot, _n, cx, cy, half, d = heapq.heappop(heap)
        if d > best[2]:
            best = (cx, cy, d)
        if -neg_pot <= 0.0:
            continue  # no point of this cell can be inside the polygon
        # While no interior point has been found (best distance <= 0, e.g. the
        # centroid of a U shape lies in its notch), keep splitting even when the
        # precision is coarser than the inscribed radius: an anchor must be inside.
        if best[2] > on_edge and -neg_pot - best[2] <= precision:
            continue
        if counter[0] >= max_cells:
            capped = True
            bound = max(-neg_pot - best[2], precision)
            break
        half2 = half / 2.0
        for ox, oy in ((-half2, -half2), (half2, -half2), (-half2, half2), (half2, half2)):
            push(cx + ox, cy + oy, half2)
    return done(best[0], best[1], max(best[2], 0.0), capped, bound)


def polygon_anchor(rings, precision=1.0, groups=None):
    """Pole of inaccessibility of a (multipart) polygon in the core representation.

    Returns ``{"point": (x, y), "distance", "part", "parts", "capped"}``:
    the pole of the largest part (index ``part`` in ``group_rings`` order),
    the inscribed-circle radius, the number of parts and whether the cell
    budget was reached. ``None`` for an empty polygon. ``groups``: the
    ``group_rings(rings)`` result when the caller already has it (the rings
    are then not grouped a second time).
    """
    if groups is None:
        groups = group_rings(rings)
    if not groups:
        return None
    best_idx, best_area = 0, None
    for idx, (outer, holes) in enumerate(groups):
        area = abs(ring_signed_area(outer)) - sum(abs(ring_signed_area(h)) for h in holes)
        if best_area is None or area > best_area:
            best_idx, best_area = idx, area
    outer, holes = groups[best_idx]
    x, y, d, capped = _anchor_pole([outer] + list(holes), precision)
    return {"point": (x, y), "distance": d, "part": best_idx, "parts": len(groups),
            "capped": capped}


# ==========================================================================
# common/linegraph.py
# ==========================================================================
# Planar line network from polylines: endpoint nodes, degree, dangles,
# pseudo-nodes, connected components (pure Python).
#
# Input: ``[(key, paths), ...]`` where ``paths`` is a polyline in the core
# representation (list of paths, path = list of ``(x, y)``). Every path (part)
# is one **edge** from its first to its last vertex. Interior vertices are not
# nodes (a line crossing another without a shared endpoint is not connected).
#
# Endpoint clustering (``cluster_points``): endpoints closer than or equal to
# ``tolerance`` are merged with a grid hash (cell = tolerance) and union-find.
# Clustering is **transitive**: if A-B and B-C are within tolerance, A, B and C
# form one node even when A-C is farther apart (a chain of points each within
# tolerance of the next can span more than the tolerance). ``tolerance == 0``
# merges only identical coordinates. The node location is the first member
# point in input order (an actual endpoint, deterministic), not an average.
#
# Degree = number of edge ends at a node; a closed path (both ends in the same
# node) contributes 2. Dangles are nodes of degree 1. Pseudo-nodes are nodes of
# degree 2 where two **different** edges meet (the start of a single closed loop
# is not a pseudo-node); whether they are reportable (equal attributes) is the
# caller's decision.

class DisjointSet(object):
    """Union-find with path halving and union by size; elements are 0..n-1."""

    def __init__(self, n):
        self.parent = list(range(n))
        self.size = [1] * n

    def find(self, i):
        parent = self.parent
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    def union(self, i, j):
        ri, rj = self.find(i), self.find(j)
        if ri == rj:
            return ri
        if self.size[ri] < self.size[rj] or (self.size[ri] == self.size[rj] and rj < ri):
            ri, rj = rj, ri
        self.parent[rj] = ri
        self.size[ri] += self.size[rj]
        return ri


def cluster_points(points, tolerance):
    """Cluster labels for ``points`` (transitive, see module docstring).

    Returns a list of cluster ids, one per point, numbered 0, 1, 2 ... in
    order of first appearance.
    """
    n = len(points)
    ds = DisjointSet(n)
    if tolerance is None or tolerance <= 0:
        first = {}
        for i, p in enumerate(points):
            key = (float(p[0]), float(p[1]))
            if key in first:
                ds.union(first[key], i)
            else:
                first[key] = i
    else:
        if not math.isfinite(tolerance):
            raise ValueError("cluster_points: the tolerance must be a finite number")
        # Cells of half the tolerance: two points in one cell are always within the
        # tolerance (diagonal 0.71 x tolerance), so a cell is one cluster without any
        # distance test; points within the tolerance are at most 2 cells apart. Each
        # pair of neighbouring cells is compared only while they are still separate
        # clusters, with an early exit, so dense data (or a tolerance much larger
        # than the data) no longer costs one distance test per pair of points.
        cell = float(tolerance) / 2.0
        grid = {}
        for i, p in enumerate(points):
            try:
                key = (int(math.floor(p[0] / cell)), int(math.floor(p[1] / cell)))
            except (OverflowError, ZeroDivisionError, ValueError):
                # a tolerance such as 1e-320 (cell 0 or p / cell = inf), or a NaN coordinate
                raise ValueError("cluster_points: the tolerance {0!r} is too small for the "
                                 "coordinates (or a coordinate is not finite)".format(tolerance))
            members = grid.get(key)
            if members is None:
                grid[key] = [i]
            else:
                ds.union(members[0], i)
                members.append(i)
        offsets = [(dx, dy) for dx in range(-2, 3) for dy in range(-2, 3) if (dx, dy) > (0, 0)]
        for (gx, gy), members in grid.items():
            for dx, dy in offsets:
                other = grid.get((gx + dx, gy + dy))
                if other is None or ds.find(members[0]) == ds.find(other[0]):
                    continue
                if _linegraph_any_close(points, members, other, tolerance):
                    ds.union(members[0], other[0])
    labels = []
    seen = {}
    for i in range(n):
        root = ds.find(i)
        if root not in seen:
            seen[root] = len(seen)
        labels.append(seen[root])
    return labels


def _linegraph_any_close(points, a_idx, b_idx, tolerance):
    """True if some point of ``a_idx`` is within ``tolerance`` of some point of ``b_idx``."""
    for i in a_idx:
        p = points[i]
        for j in b_idx:
            if point_distance(points[j], p) <= tolerance:
                return True
    return False


def build_line_graph(lines, tolerance=0.0):
    """Build the endpoint graph of ``lines`` (``[(key, paths), ...]``).

    Returns ``{"nodes": [...], "edges": [...]}``:

    * edge: ``{"id", "key", "part", "from", "to", "length", "closed"}``
      (``from``/``to`` are node ids; ``closed`` when both ends share a node);
    * node: ``{"id", "xy", "degree", "ends", "members"}`` where ``ends`` is
      a list of ``(edge_id, "from"|"to")`` in edge order and ``members`` the
      number of endpoints merged into the node.

    Parts with fewer than 2 vertices and null geometries are skipped.
    """
    edges = []
    points = []
    for key, paths in lines:
        for part_idx, path in enumerate(paths or []):
            if len(path) < 2:
                continue
            edges.append({"id": len(edges), "key": key, "part": part_idx,
                          "length": path_length(path)})
            points.append(tuple(path[0]))
            points.append(tuple(path[-1]))
    labels = cluster_points(points, tolerance)
    nodes = []
    for idx, label in enumerate(labels):
        if label == len(nodes):
            nodes.append({"id": label, "xy": points[idx], "degree": 0, "ends": [], "members": 0})
        nodes[label]["members"] += 1
    for edge in edges:
        f, t = labels[2 * edge["id"]], labels[2 * edge["id"] + 1]
        edge["from"], edge["to"], edge["closed"] = f, t, f == t
        nodes[f]["degree"] += 1
        nodes[f]["ends"].append((edge["id"], "from"))
        nodes[t]["degree"] += 1
        nodes[t]["ends"].append((edge["id"], "to"))
    return {"nodes": nodes, "edges": edges}


def node_degrees(graph):
    """``{node_id: degree}``."""
    return dict((n["id"], n["degree"]) for n in graph["nodes"])


def find_dangles(graph):
    """Nodes of degree 1 (free line ends), in node order."""
    return [n for n in graph["nodes"] if n["degree"] == 1]


def find_pseudo_nodes(graph):
    """Nodes where exactly two different edges meet (degree 2, not the start
    of a single closed loop). Returns ``[(node, edge_a, edge_b), ...]``."""
    edges = graph["edges"]
    out = []
    for n in graph["nodes"]:
        if n["degree"] != 2:
            continue
        (e1, _s1), (e2, _s2) = n["ends"]
        if e1 == e2:
            continue
        out.append((n, edges[e1], edges[e2]))
    return out


def connected_components(graph, join_parts=True):
    """Connected groups of edges.

    With ``join_parts`` (default) all parts of one feature key belong to the
    same component even if they do not touch (a multipart feature is one
    feature). Returns a list of ``{"edges": [ids], "keys": [keys], "nodes":
    [ids]}`` sorted by the smallest edge id; keys keep first-seen order.
    """
    edges = graph["edges"]
    nodes = graph["nodes"]
    ds = DisjointSet(len(nodes))
    first_node_of_key = {}
    for e in edges:
        ds.union(e["from"], e["to"])
        if join_parts:
            if e["key"] in first_node_of_key:
                ds.union(first_node_of_key[e["key"]], e["from"])
            else:
                first_node_of_key[e["key"]] = e["from"]
    groups = {}
    order = []
    for e in edges:
        root = ds.find(e["from"])
        if root not in groups:
            groups[root] = {"edges": [], "keys": [], "key_set": set(), "nodes": set()}
            order.append(root)
        g = groups[root]
        g["edges"].append(e["id"])
        if e["key"] not in g["key_set"]:   # set lookup: O(1), not O(len(keys))
            g["key_set"].add(e["key"])
            g["keys"].append(e["key"])
        g["nodes"].update((e["from"], e["to"]))
    out = []
    for root in order:
        g = groups[root]
        out.append({"edges": g["edges"], "keys": g["keys"], "nodes": sorted(g["nodes"])})
    return out


# ==========================================================================
# common/report.py
# ==========================================================================
# Reports: Excel workbook with Summary + Detail sheets, CSV fallback.
#
# Engineering rule 11: choose a writable report path **before** the main work
# (a workbook open in Excel is locked), write Excel via openpyxl when it is
# available and fall back to two CSV files when it is not.
#
# * ``choose_report_path(requested, inputs)`` -> target dict, raises
#   ``ToolError`` if the location is not writable, a file it would write is
#   one of the tool's inputs, or a file it would write already exists while
#   ``arcpy.env.overwriteOutput`` is off (engineering rule 13; RT7-P-4).
# * ``write_report(target, summary, detail_header, detail_rows)`` -> list of
#   written file paths.
#
# Text fidelity (to be stated on every tool page that offers a report):
#
# * Excel: control characters a cell cannot hold (U+0000-U+0008, U+000B, U+000C,
#   U+000E-U+001F) are written as a visible ``<U+XXXX>``; nothing is dropped
#   silently. Text cells are stored as text, never as formulas.
# * CSV: every character is kept as it is (control characters included); text
#   that a spreadsheet would run as a formula gets a leading apostrophe
#   (``neutralize_formula``).
# * Both: a lone UTF-16 surrogate (U+D800-U+DFFF, half of a pair; it cannot be
#   written as UTF-8) becomes U+FFFD.
#
# Every file is opened through ``_open_for_write`` so tests can simulate a
# locked file without touching the operating system.

REPORT_FORMAT_XLSX = "xlsx"
REPORT_FORMAT_CSV = "csv"

# Rows in one Excel worksheet (.xlsx), header included.
_REPORT_XLSX_MAX_ROWS = 1048576

# Excel rejects these control characters in cell text (XML 1.0: U+0000-U+0008, U+000B, U+000C,
# U+000E-U+001F; tab, line feed and carriage return are allowed). They are written as a visible
# "<U+XXXX>" instead of being dropped, so a value such as "Riyadh" + U+0001 never looks equal to
# "Riyadh" in an Excel report (NearMissVocabularyChecker round-5 review, D2; the same review
# finding exists for NormalisedKeyDiagnostics). Accepted ambiguity: a text that really contains
# "<U+0001>" looks the same; each tool's output table keeps the exact value.
_REPORT_ILLEGAL = dict((c, u"<U+{0:04X}>".format(c))
                       for c in list(range(0, 9)) + [11, 12] + list(range(14, 32)))
# A lone UTF-16 surrogate (half of a pair, U+D800-U+DFFF) cannot be encoded as UTF-8: the xlsx and
# csv writers raise UnicodeEncodeError on it (MojibakeDetector round 5, R5-1). It becomes U+FFFD in
# both formats (merged shared fix, round 6).
_REPORT_LONE_SURROGATES = dict.fromkeys(range(0xD800, 0xE000), u"\ufffd")
_REPORT_ILLEGAL.update(_REPORT_LONE_SURROGATES)


# A plain number such as "-5" or "+1.5e3" is not a formula and is left as is.
_REPORT_PLAIN_NUMBER = re.compile(r"^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$")


def neutralize_formula(value):
    """Text that a spreadsheet would run as a formula, made inert (CSV injection).

    Text starting with ``=``, ``@``, tab or carriage return, or with ``+``/``-``
    followed by something that is not a plain number, gets a leading
    apostrophe, so Excel shows it as text instead of evaluating it (OWASP
    "CSV injection" guidance). Other values are returned unchanged. Used for
    every CSV report cell; the Excel writer stores text cells as text instead.

    This CHANGES the text in the CSV file: ``-Riyadh`` is written as
    ``'-Riyadh`` and ``=1+1`` as ``'=1+1`` (a plain number such as ``-5`` or
    ``+1.5e3`` is kept). Kept on purpose: without it a value could run as a
    formula when the CSV is opened in Excel. Every tool page that offers a CSV
    report should say so; a program that reads the CSV must strip the
    apostrophe.
    """
    if not isinstance(value, str) or not value:
        return value
    first = value[0]
    if first in ("=", "@", "\t", "\r"):
        return "'" + value
    if first in "+-" and len(value) > 1 and not _REPORT_PLAIN_NUMBER.match(value):
        return "'" + value
    return value


def _open_for_write(path, mode, **kwargs):
    """Single place where report files are opened (test hook)."""
    return open(path, mode, **kwargs)


def _report_import_openpyxl():
    """Import openpyxl lazily; ``None`` when it is not installed."""
    try:
        import openpyxl
    except ImportError:
        return None
    return openpyxl


def _report_check_writable(path):
    """Raise ``ToolError`` if ``path`` cannot be written; leaves no new file behind."""
    folder = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(folder):
        raise ToolError("The report folder '{0}' does not exist.".format(folder),
                        "Choose an existing folder for the report.")
    existed = os.path.exists(path)
    try:
        handle = _open_for_write(path, "ab")
        handle.close()
    except (IOError, OSError):
        raise ToolError(
            "The report file '{0}' cannot be written; it is probably open in Excel "
            "or another program, or it is read-only.".format(path),
            "Close the file (or choose a different report name) and run the tool again.")
    if not existed:
        try:
            os.remove(path)
        except OSError:
            pass


def csv_report_paths(path):
    """``(summary_csv, detail_csv)`` for a requested report path."""
    base = os.path.splitext(path)[0]
    return base + "_summary.csv", base + "_detail.csv"


def _report_keys(path):
    """Comparison keys of a path: as given and absolute, plus its dataset identity."""
    text = str(path).strip().strip("'\"")
    keys = set([normalize_catalog_path(text), dataset_identity(text)])
    if text and not text.startswith("\\\\"):
        absolute = os.path.abspath(text)
        keys.update([normalize_catalog_path(absolute), dataset_identity(absolute)])
    keys.discard("")
    return keys


def refuse_report_on_inputs(paths, inputs):
    """Raise ``ToolError`` if a report file would replace (or contain) an input.

    ``paths`` are the files the report will really write (after extension
    normalisation and the CSV fallback names); ``inputs`` are input files,
    datasets or layer texts (anything that is not a path never matches).
    Paths are compared with ``paths.normalize_catalog_path`` and
    ``paths.dataset_identity``; an input inside the report file (e.g. a sheet
    ``book.xlsx\\Sheet1$``) also counts. During a guarded run every input the
    tool registered (``paths.registered_inputs``) is compared as well, and a
    report file named like a table joined to an input layer
    (``paths.registered_joined_tables``) is refused.
    """
    inputs = list(inputs or ()) + registered_inputs()
    refuse_joined_table_outputs(paths, registered_joined_tables())
    for out in paths:
        out_keys = _report_keys(out)
        for value in inputs:
            if not value:
                continue
            in_keys = _report_keys(value)
            inside = any(k.startswith(o + "\\") for k in in_keys for o in out_keys)
            if out_keys & in_keys or inside:
                raise ToolError(
                    "The report file '{0}' would replace the input '{1}'.".format(out, value),
                    "Choose another report name or folder; the tool never overwrites its "
                    "input.")


def _report_overwrite_allowed():
    """``arcpy.env.overwriteOutput`` as a bool (False when it cannot be read)."""
    try:
        return bool(arcpy.env.overwriteOutput)
    except Exception:
        return False


def refuse_existing_report_files(paths, overwrite):
    """Raise ``ToolError`` if a report file exists and overwriting is off.

    Pro's own output check only sees the parameter value; the files really
    written can differ (``book.xls`` -> ``book.xlsx``, ``audit.csv`` ->
    ``audit_summary.csv`` + ``audit_detail.csv``), so every one is checked
    here (engineering rule 13, RT7-P-4).
    """
    if overwrite:
        return
    for path in paths:
        if os.path.exists(path):
            raise ToolError(
                "The report file '{0}' already exists and overwriting outputs is off, so "
                "it was not replaced.".format(path),
                "Choose another report name or folder, or allow geoprocessing tools to "
                "overwrite existing outputs (arcpy.env.overwriteOutput) and run the tool "
                "again.")


def choose_report_path(requested, inputs=(), overwrite=None):
    """Decide the report format and check the target is writable.

    ``requested`` ends in ``.xlsx`` or ``.csv`` (anything else is treated as
    ``.xlsx``). If openpyxl is missing, or ``.csv`` was requested, two CSV
    files ``<name>_summary.csv`` and ``<name>_detail.csv`` are used instead.
    Returns ``{"format", "paths", "note"}``; ``note`` explains a fallback.
    Returns ``None`` when no report was requested. ``inputs`` (input files,
    datasets or parameter texts) are refused as report files, after the
    extension change (``book`` / ``book.xls`` -> ``book.xlsx``) and for both CSV
    fallback files (``refuse_report_on_inputs``). With overwriting off
    (``overwrite``; ``None`` reads ``arcpy.env.overwriteOutput``) an existing
    report file is refused (``refuse_existing_report_files``).
    """
    if not requested:
        return None
    requested = str(requested)
    note = None
    ext = os.path.splitext(requested)[1].casefold()
    if ext != ".csv" and _report_import_openpyxl() is not None:
        if ext != ".xlsx":
            requested = os.path.splitext(requested)[0] + ".xlsx"
        target = {"format": REPORT_FORMAT_XLSX, "paths": [requested], "note": None}
    else:
        if ext != ".csv":
            note = ("openpyxl is not available, so the report is written as two CSV files "
                    "instead of an Excel workbook.")
        target = {"format": REPORT_FORMAT_CSV, "paths": list(csv_report_paths(requested)),
                  "note": note}
    # The name as asked for counts too: 'attr.csv' writes attr_summary.csv, but a
    # report named like a table joined to an input layer is refused either way.
    refuse_joined_table_outputs([requested], registered_joined_tables())
    refuse_report_on_inputs(target["paths"], inputs)
    for path in target["paths"]:
        _report_check_writable(path)
    if overwrite is None:
        overwrite = _report_overwrite_allowed()
    refuse_existing_report_files(target["paths"], overwrite)
    return target


# An Excel cell holds at most 32,767 characters (counted in UTF-16 units). openpyxl writes longer
# text without complaint and Excel then cuts or "repairs" it silently. The cut is made AFTER the
# <U+XXXX> expansion above, so the expansion can never push a cell over the limit, and the cut cell
# ends with a visible marker (NearMissVocabularyChecker R6-D2, BilingualNameQA R6-1).
_REPORT_XLSX_MAX_CELL = 32767
_REPORT_XLSX_CUT_MARKER = u" ...[cut: an Excel cell holds 32,767 characters; choose a .csv report for the full text]"


def _report_utf16_units(text):
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def _report_fit_excel_cell(text):
    """``text`` cut to fit one Excel cell, with a visible marker when cut."""
    if len(text) <= _REPORT_XLSX_MAX_CELL // 2 or _report_utf16_units(text) <= _REPORT_XLSX_MAX_CELL:
        return text
    room = _REPORT_XLSX_MAX_CELL - len(_REPORT_XLSX_CUT_MARKER)
    kept, used = [], 0
    for ch in text:
        size = 2 if ord(ch) > 0xFFFF else 1
        if used + size > room:
            break
        kept.append(ch)
        used += size
    return u"".join(kept) + _REPORT_XLSX_CUT_MARKER


def _report_cell(value):
    """Cell value safe for openpyxl (control characters as ``<U+XXXX>``, see
    ``_REPORT_ILLEGAL``)."""
    if isinstance(value, str):
        return _report_fit_excel_cell(value.translate(_REPORT_ILLEGAL))
    if value is None or isinstance(value, (bool, int, float)):
        return value
    return str(value)


def _report_write_xlsx(path, summary, summary_header, detail_header, detail_rows, openpyxl):
    workbook = openpyxl.Workbook()
    sheets = ((workbook.active, "Summary", summary_header, summary),
              (workbook.create_sheet(), "Detail", detail_header, detail_rows))
    bold = openpyxl.styles.Font(bold=True)
    for sheet, title, header, rows in sheets:
        sheet.title = title
        sheet.append([_report_cell(h) for h in header])
        for cell in sheet[1]:
            cell.font = bold
        widths = [len(str(h)) for h in header]
        # Excel holds at most _REPORT_XLSX_MAX_ROWS rows; openpyxl would write
        # more without complaint and Excel would then drop or "repair" them.
        room = _REPORT_XLSX_MAX_ROWS - 2
        if len(rows) > room + 1:
            dropped = len(rows) - room
            rows = rows[:room] + [["{0} more rows not shown: an Excel sheet holds at most {1} "
                                   "rows. Choose a .csv report path to get every row."
                                   .format(dropped, _REPORT_XLSX_MAX_ROWS)]]
        # Track the row number ourselves: openpyxl's Worksheet.max_row scans
        # every cell written so far, which made long reports quadratic (RT4-A-4).
        row_index = 1
        for row in rows:
            values = [_report_cell(v) for v in row]
            sheet.append(values)
            row_index += 1
            for column, value in enumerate(values, 1):
                if isinstance(value, str):
                    # never let text such as "=x" become a formula
                    sheet.cell(row=row_index, column=column).data_type = "s"
            for i, v in enumerate(values[:len(widths)]):
                widths[i] = max(widths[i], len(str(v)) if v is not None else 0)
        sheet.freeze_panes = "A2"
        for i, width in enumerate(widths):
            sheet.column_dimensions[openpyxl.utils.get_column_letter(i + 1)].width = min(width + 2, 80)
    with _open_for_write(path, "wb") as handle:
        workbook.save(handle)


def _report_csv_text(value):
    """CSV cell text: control characters kept exactly, only lone surrogates become U+FFFD."""
    if isinstance(value, str):
        return value.translate(_REPORT_LONE_SURROGATES)
    return value


def _report_write_csv(path, header, rows):
    # utf-8-sig so Excel shows Arabic and other non-Latin text correctly.
    with _open_for_write(path, "w", newline="", encoding="utf-8-sig") as handle:
        writer = csv.writer(handle)
        writer.writerow([neutralize_formula(_report_csv_text(h)) for h in header])
        for row in rows:
            writer.writerow(["" if v is None else neutralize_formula(_report_csv_text(v)) for v in row])


def write_report(target, summary, detail_header, detail_rows, summary_header=("Item", "Value"), xlsx_builder=None):
    """Write the report chosen by ``choose_report_path``.

    ``summary`` is a list of rows (usually ``(item, value)`` pairs);
    ``detail_rows`` a list of rows matching ``detail_header``.
    ``xlsx_builder`` (optional) is a function ``builder(openpyxl) -> workbook`` that replaces the plain
    two-sheet Excel layout with the tool's own formatted workbook; this module opens the file and saves it
    (same error handling, same ``_open_for_write`` hook). The CSV fallback is unaffected: it always gets
    ``summary`` and ``detail_rows``.
    Returns the list of written paths. Raises ``ToolError`` if a file became
    unwritable after it was checked.
    """
    if target is None:
        return []
    # Inputs read after the report was chosen (lookup tables, vocabularies ...) are
    # registered by then: never replace one of them (quality review D1/D2).
    refuse_report_on_inputs(target["paths"], ())
    summary = [list(r) for r in summary]
    detail_rows = [list(r) for r in detail_rows]
    try:
        if target["format"] == REPORT_FORMAT_XLSX:
            openpyxl = _report_import_openpyxl()
            if xlsx_builder is not None:
                workbook = xlsx_builder(openpyxl)
                with _open_for_write(target["paths"][0], "wb") as handle:
                    workbook.save(handle)
            else:
                _report_write_xlsx(target["paths"][0], summary, list(summary_header),
                                   list(detail_header), detail_rows, openpyxl)
        else:
            _report_write_csv(target["paths"][0], list(summary_header), summary)
            _report_write_csv(target["paths"][1], list(detail_header), detail_rows)
    except (IOError, OSError) as exc:
        raise ToolError("The report could not be written: {0}".format(exc),
                        "Close the report file if it is open and run the tool again.")
    return list(target["paths"])


def choose_output_file(requested, extension, inputs=(), overwrite=None):
    """Check the target of a single output file (an HTML page, a PNG ...) before the work.

    ``extension`` is the wanted one with its dot (``".html"``): a path without extension gets
    it, a path with another extension has it replaced. Refused (``ToolError``): a folder that
    does not exist, a file that is one of ``inputs`` (or a registered input of the run), a
    file that cannot be opened for writing (open in a program, read-only), and an existing
    file while overwriting is off. Returns the path to write, or ``None`` when nothing was
    requested.
    """
    if not requested or not str(requested).strip():
        return None
    path = str(requested).strip()
    if os.path.splitext(path)[1].casefold() != extension.casefold():
        path = os.path.splitext(path)[0] + extension
    refuse_joined_table_outputs([path], registered_joined_tables())
    refuse_report_on_inputs([path], inputs)
    _report_check_writable(path)
    if overwrite is None:
        overwrite = _report_overwrite_allowed()
    refuse_existing_report_files([path], overwrite)
    return path


def write_text_file(path, text, encoding="utf-8"):
    """Write ``text`` to ``path`` (UTF-8, ``\\n`` line ends) through the same open hook as the
    reports. Raises ``ToolError`` when the file cannot be written."""
    refuse_report_on_inputs([path], ())
    try:
        with _open_for_write(path, "w", encoding=encoding, newline="\n") as handle:
            handle.write(text)
    except (IOError, OSError) as exc:
        raise ToolError("The file '{0}' could not be written: {1}".format(path, exc),
                        "Close the file if it is open and run the tool again.")
    return path


# ==========================================================================
# common/params.py
# ==========================================================================
# Consistent construction and reading of ``arcpy.Parameter`` objects.

def make_param(name, label, datatype, direction="Input", required=True, multi_value=False,
               default=None, value_list=None, category=None, depends_on=None, enabled=True,
               filter_type=None):
    """Create an ``arcpy.Parameter``.

    ``required`` may be True (``"Required"``), False (``"Optional"``) or the
    string ``"Derived"``. ``value_list`` fills ``filter.list`` (a value list
    for strings/numbers, field types for ``Field``, extensions for ``DEFile``);
    ``filter_type`` sets ``filter.type`` (e.g. ``"Range"``) before the list.
    ``depends_on`` is a parameter name or list of names.
    """
    if required == "Derived":
        parameter_type = "Derived"
        direction = "Output"
    else:
        parameter_type = "Required" if required else "Optional"
    param = arcpy.Parameter(
        name=name,
        displayName=label,
        direction=direction,
        datatype=datatype,
        parameterType=parameter_type,
        enabled=enabled,
        category=category,
        multiValue=multi_value)
    if filter_type is not None:
        param.filter.type = filter_type
    if value_list is not None:
        param.filter.list = list(value_list)
    if depends_on:
        param.parameterDependencies = [depends_on] if isinstance(depends_on, str) else list(depends_on)
    if default is not None:
        param.value = default
    return param


def derived_output(name, label, datatype):
    """Derived output parameter (set with ``arcpy.SetParameterAsText``)."""
    return make_param(name, label, datatype, required="Derived")


def param_map(parameters):
    """``{name: parameter}`` for a parameter list."""
    return dict((p.name, p) for p in parameters)


def param_index(parameters, name):
    """Index of the parameter called ``name``."""
    for i, p in enumerate(parameters):
        if p.name == name:
            return i
    raise KeyError(name)


def param_text(param):
    """``valueAsText`` or ``None`` when empty."""
    text = param.valueAsText
    if text is None or text == "":
        return None
    return text


def param_bool(param, default=False):
    """Boolean value of a ``GPBoolean`` parameter."""
    value = param.value
    if value is None:
        return default
    if isinstance(value, str):
        return value.strip().casefold() in ("true", "1", "yes")
    return bool(value)


def param_number(param, default=None):
    """Numeric value (float) of a parameter, or ``default`` when empty."""
    value = param.value
    if value is None or value == "":
        return default
    return float(value)


def split_multivalue(text):
    """Values of a multivalue parameter given as geoprocessing text, quote-aware.

    Values are separated by ``;``. A value that starts with a single or double quote runs to the
    matching closing quote that is followed by ``;`` or the end of the text, so a folder named
    ``inv;2026`` written as ``'C:\\data\\inv;2026'`` stays one value; inside quotes the quote character
    written twice is one literal quote. A quote that is never closed counts as part of a plain
    value (the old behaviour: split on ``;``, quotes stripped)."""
    if not text:
        return []
    text = str(text)
    values = []
    n, i = len(text), 0
    while i < n:
        while i < n and text[i] in " \t":
            i += 1
        if i >= n:
            break
        if text[i] in "'\"":
            quote, j, buf, closed = text[i], i + 1, [], False
            while j < n:
                ch = text[j]
                if ch == quote:
                    if j + 1 < n and text[j + 1] == quote:
                        buf.append(quote)
                        j += 2
                        continue
                    k = j + 1
                    while k < n and text[k] in " \t":
                        k += 1
                    if k >= n or text[k] == ";":
                        closed = True
                        j = k
                        break
                buf.append(ch)
                j += 1
            if closed:
                value = "".join(buf).strip()
                if value:
                    values.append(value)
                i = j + 1
                continue
        end = text.find(";", i)
        if end < 0:
            end = n
        value = text[i:end].strip().strip("'\"")
        if value:
            values.append(value)
        i = end + 1
    return values


def param_list(param):
    """Values of a multivalue parameter as a list of strings (quote-aware, ``split_multivalue``)."""
    return split_multivalue(param_text(param))


def parse_value_table_text(text):
    """Rows of a value table given as geoprocessing text.

    Rows are separated by ``;`` and cells by spaces; a cell containing spaces
    is wrapped in single quotes (or double quotes, for example around a path that holds an
    apostrophe) and an empty cell is written ``#``
    (e.g. ``"NAME ASC;'Lot No' DESC"``). Inside quotes the quote character written twice is
    one literal quote. Returns a list of lists of strings,
    with ``None`` for empty cells. Separators inside quotes are kept.
    """
    if text is None:
        return []
    rows, row, cell = [], [], []
    quote = None
    in_cell = False

    def end_cell():
        value = "".join(cell)
        row.append(None if (value == "#" or value == "") else value)
        del cell[:]

    chars = str(text)
    n = 0
    while n < len(chars):
        ch = chars[n]
        n += 1
        if quote:
            if ch == quote:
                if n < len(chars) and chars[n] == quote:
                    cell.append(ch)
                    n += 1
                else:
                    quote = None
            else:
                cell.append(ch)
            continue
        if ch in ("'", '"') and not cell:
            quote = ch
            in_cell = True
        elif ch == " ":
            if in_cell:
                end_cell()
                in_cell = False
        elif ch == ";":
            if in_cell:
                end_cell()
                in_cell = False
            if row:
                rows.append(list(row))
            del row[:]
        else:
            cell.append(ch)
            in_cell = True
    if in_cell:
        end_cell()
    if row:
        rows.append(list(row))
    return rows


def _params_vt_cell(cell):
    """Plain Python value of one value-table cell (``None`` when empty)."""
    if cell is None:
        return None
    if isinstance(cell, str):
        text = cell.strip()
        return None if text in ("", "#") else text
    if isinstance(cell, (bool, int, float)):
        return cell
    name = getattr(cell, "name", None)  # e.g. a Field object in a Field column
    if isinstance(name, str):
        return name
    return str(cell)


def param_value_table(param, columns=None):
    """Rows of a ``GPValueTable`` parameter as lists of plain values.

    Uses ``Parameter.values`` (a list of lists); rows given as text (for
    example when a script passes a string) are parsed with
    ``parse_value_table_text``. Empty cells (``#``, ``''``, empty text, or empty in
    ``valueAsText``: ArcGIS Pro returns an empty number cell as 0) become ``None``; rows whose
    cells are all empty are dropped. ``columns`` pads/cuts each row to that
    many cells.
    """
    raw = param.values
    if not raw:
        return []
    parsed_rows = []
    for item in raw:
        if isinstance(item, str):
            parsed_rows.extend(parse_value_table_text(item))
        elif isinstance(item, (list, tuple)):
            parsed_rows.append(list(item))
        else:
            parsed_rows.append([item])
    # ArcGIS Pro returns an empty numeric cell as 0 in ``values`` while the text shows
    # ``#`` (Pro session 1): a cell that is empty in ``valueAsText`` is empty (None).
    try:
        text_rows = parse_value_table_text(param.valueAsText)
    except Exception:  # an unreadable text never hides the values
        text_rows = []
    if len(text_rows) != len(parsed_rows):
        text_rows = []
    rows = []
    for k, row in enumerate(parsed_rows):
        values = [_params_vt_cell(c) for c in row]
        if text_rows:
            text = text_rows[k]
            values = [None if (i < len(text) and text[i] is None) or i >= len(text) else v
                      for i, v in enumerate(values)]
        if columns is not None:
            values = (values + [None] * columns)[:columns]
        if any(v is not None for v in values):
            rows.append(values)
    return rows


def input_texts(parameters):
    """Every value of the tool's Input parameters as text (multivalues split).

    ``parameters`` is the parameter list or a ``param_map`` dict. Used to
    refuse a report file that would replace an input
    (``report.choose_report_path(requested, inputs=input_texts(...))``).
    """
    params = parameters.values() if isinstance(parameters, dict) else parameters
    out = []
    for param in params:
        if param.direction != "Input":
            continue
        text = param_text(param)
        if text:
            out.extend(split_multivalue(text))
    return out


# ==========================================================================
# common/arcio.py
# ==========================================================================
# The only common module that touches arcpy: reading, writing, editing.
#
# Every arcpy name used here is listed in ARCHITECTURE.md and must be in the
# API audit. Geometry crosses the arcpy boundary as Esri JSON only:
# ``SHAPE@JSON`` + ``json.loads`` on read, ``arcpy.AsShape(esri_json, True)`` on
# write (decision D-003). Rows are plain dicts::
#
#     {"oid": 12, "shape": <core geometry or None>, "attrs": {"NAME": "A", ...}}

LAYER_DATA_TYPES = ("FeatureLayer", "TableView", "Layer")
GEOMETRY_KEYWORDS = {"point": "POINT", "multipoint": "MULTIPOINT",
                     "polyline": "POLYLINE", "polygon": "POLYGON"}
SHAPEFILE_MAX_TEXT = 254

# Curves are densified with Geometry.densify("ANGLE", distance, deviation):
# distance = geometry extent diagonal / _ARCIO_CURVE_DIVISIONS, deviation in radians.
_ARCIO_CURVE_DIVISIONS = 50.0
_ARCIO_CURVE_DEVIATION = math.radians(1.0)

# Depth of open edit sessions; deletes are refused while > 0 (ERROR 000496).
_ARCIO_EDIT_STATE = {"depth": 0}


# --------------------------------------------------------------------------
# ObjectID output fields (SRC_OID, REMOVED_BY, SITE_OID, ...)
# --------------------------------------------------------------------------

# ArcGIS Pro 3.2 and later can have 64-bit ObjectIDs, which a LONG field refuses on insert.
OID_LONG_MIN, OID_LONG_MAX = -2 ** 31, 2 ** 31 - 1
# REPORTED (ArcGIS Pro 3.3.2, job_410 BilingualNameQA section 5): inserting 2^53 + 1 into a
# BIGINTEGER field of a file geodatabase was refused with "Big integer values are currently
# limited to 53 bits."; the "ArcGIS field data types" page gives -(2^53 - 1) to 2^53 - 1.
OID_BIG_MAX = 2 ** 53 - 1
# REPORTED (job_410): a DOUBLE field of a dBASE table stored 1099511627783 (2^40 + 7) as
# 1099511627780.0 and kept 3000000001; job_403 stored 25030864197623.8 as 25030864197600.0.
# Both keep 12 significant digits, so a folder output takes a DOUBLE only while every ObjectID has
# at most 12 significant digits.
OID_DBF_DOUBLE_DIGITS = 12
# TEXT width for ObjectIDs in a folder output: a signed 64-bit integer has at most 19 digits + sign.
OID_TEXT_LENGTH = 20


def _arcio_oid_values(oids):
    return [int(o) for o in oids if o is not None and not isinstance(o, bool)]


def oid_significant_digits(value):
    """Significant decimal digits of the whole number ``value`` (0 has 1; trailing zeros do not
    count: 3000000000 has 1)."""
    text = str(abs(int(value))).rstrip("0")
    return max(1, len(text))


def oid_field_type(oids, workspace_is_folder):
    """``(AddField keyword, text length or None)`` for a field that holds the ObjectIDs ``oids``.

    * LONG while every id fits 32 bits (any workspace);
    * a geodatabase (or GeoPackage / memory) output: BIGINTEGER; an id beyond 2^53 - 1 in size
      raises ``ToolError`` (ArcGIS Pro refuses it: "Big integer values are currently limited to
      53 bits");
    * a folder (shapefile / dBASE) output: DOUBLE while every id has at most 12 significant digits
      (and is at most 2^53 - 1 in size), else TEXT of ``OID_TEXT_LENGTH`` characters (or the
      longest id) with every digit kept."""
    values = _arcio_oid_values(oids)
    if all(OID_LONG_MIN <= v <= OID_LONG_MAX for v in values):
        return "LONG", None
    if not workspace_is_folder:
        big = [v for v in values if abs(v) > OID_BIG_MAX]
        if big:
            worst = max(big, key=abs)
            raise ToolError(
                "ObjectID {0} is larger than 2^53 - 1 (9,007,199,254,740,991), the largest whole "
                "number a Big Integer field holds in ArcGIS Pro (\"Big integer values are "
                "currently limited to 53 bits\"), so the output cannot store it.".format(worst),
                "Write the output to a folder (shapefile or dBASE table), where such ObjectIDs are "
                "written as text with every digit kept, or copy the input to a new feature class "
                "or table (its ObjectIDs start at 1) and run the tool on the copy.")
        return "BIGINTEGER", None
    if all(abs(v) <= OID_BIG_MAX and oid_significant_digits(v) <= OID_DBF_DOUBLE_DIGITS
           for v in values):
        return "DOUBLE", None
    return "TEXT", max([OID_TEXT_LENGTH] + [len(str(v)) for v in values])


def oid_field_spec(oids, workspace_is_folder, name="SRC_OID", alias=None, label=None):
    """``(field spec, info message or None)`` for an ObjectID output field (``oid_field_type``).

    The message (None for LONG) says which type the field got and, for TEXT, why. ``label`` names
    the field in the message (default ``name``). Raises ``ToolError`` as ``oid_field_type``."""
    keyword, length = oid_field_type(oids, workspace_is_folder)
    spec = {"name": name, "type": keyword}
    if length:
        spec["length"] = length
    if alias:
        spec["alias"] = alias
    label = label or name
    if keyword == "LONG":
        return spec, None
    text = "Some ObjectIDs do not fit 32 bits (64-bit ObjectIDs); {0} is written as {1}.".format(
        label, keyword)
    if keyword == "TEXT":
        values = _arcio_oid_values(oids)
        many = sum(1 for v in values if abs(v) > OID_BIG_MAX
                   or oid_significant_digits(v) > OID_DBF_DOUBLE_DIGITS)
        text += (" A Double field in a shapefile or dBASE table keeps only {0} significant digits "
                 "and {1} ObjectID(s) have more, so the field is text ({2} characters) with every "
                 "digit kept.".format(OID_DBF_DOUBLE_DIGITS, many, length))
    return spec, text


def oid_output_field(out_path, oids, collector=None, name="SRC_OID", alias=None, label=None):
    """``oid_field_spec`` for a field of the output ``out_path`` (a folder output or not is read
    from the path); the message goes to ``collector.info``. Returns the field spec."""
    spec, note = oid_field_spec(oids, is_folder_workspace(workspace_of(out_path)), name=name,
                                alias=alias, label=label)
    if note and collector is not None:
        collector.info(note)
    return spec


def oid_field_value(spec, oid):
    """``oid`` as written to the field ``spec`` of ``oid_field_spec``: its digits for TEXT."""
    if oid is None or isinstance(oid, bool) or spec.get("type") != "TEXT":
        return oid
    return str(int(oid))


# --------------------------------------------------------------------------
# Describe
# --------------------------------------------------------------------------

def sr_info(sr):
    """Plain dict for a ``SpatialReference`` (``None`` stays ``None``).

    ``"polar_stereographic"``: 1 / -1 when a projected system is polar
    stereographic about the North / South Pole (``polar_stereographic_sign``), else
    ``None``."""
    if sr is None:
        return None
    sr_type = sr.type
    projected = sr_type == "Projected"
    return {"wkid": sr.factoryCode or None, "name": sr.name, "type": sr_type,
            "meters_per_unit": sr.metersPerUnit if projected else None,
            "polar_stereographic": polar_stereographic_sign(sr) if projected else None}


# (factoryCode, name) -> result of polar_stereographic_sign; systems with a WKID only.
_ARCIO_POLAR_CACHE = {}


def polar_stereographic_sign(sr):
    """1 / -1 when the projected system ``sr`` is polar stereographic about the North
    / South Pole, else ``None`` (RT8-C-3: any polar stereographic system, not a WKID
    list). The probe points of ``projection.polar_probe_points`` are projected into
    ``sr`` one by one (``arcpy.AsShape`` in WGS 84, ``Geometry.projectAs``) and tested
    with ``projection.is_polar_stereographic_probe``. A point that cannot be projected
    makes the system "not polar stereographic"."""
    key = (sr.factoryCode, sr.name) if sr.factoryCode else None
    if key is not None and key in _ARCIO_POLAR_CACHE:
        return _ARCIO_POLAR_CACHE[key]
    found = None
    for sign in (1, -1):
        projected = []
        for lon, lat in polar_probe_points(sign):
            try:
                shape = arcpy.AsShape({"x": lon, "y": lat, "spatialReference": {"wkid": 4326}},
                                      True).projectAs(sr)
                data = json.loads(shape.JSON)
                projected.append((float(data["x"]), float(data["y"])))
            except Exception:  # outside the system's domain: not this pole's projection
                projected.append(None)
        if is_polar_stereographic_probe(projected):
            found = sign
            break
    if key is not None:
        _ARCIO_POLAR_CACHE[key] = found
    return found


def field_info(field):
    """Plain dict for an ``arcpy.Field``."""
    return {"name": field.name, "alias": field.aliasName, "type": field.type,
            "length": field.length, "domain": field.domain or None,
            "nullable": field.isNullable, "editable": field.editable,
            "required": field.required}


def describe_dataset(path):
    """Describe a feature class, table or layer.

    Returns ``{"input", "catalog_path", "workspace", "name", "data_type",
    "is_layer", "shape_type", "sr", "sr_object", "oid_field", "fields", "has_z",
    "has_m"}`` (``has_z`` / ``has_m``: the dataset stores Z / M values; ``False`` when the
    describe result does not say).
    For a layer, ``catalog_path`` is the layer's data source, so output/input
    comparisons use the real dataset, while cursors still use ``input`` (so
    selections and definition queries are honoured).
    """
    if not path or not arcpy.Exists(path):
        raise ToolError("The input '{0}' does not exist.".format(path),
                        "Check the path or layer name, or browse to the dataset.")
    desc = arcpy.da.Describe(path)
    catalog = desc["catalogPath"]
    register_inputs([path, catalog])  # every described dataset is an input of the run
    fields = [field_info(f) for f in desc["fields"]]
    register_joined_tables(joined_table_names(fields))  # ... and so is every joined table
    sr = desc["spatialReference"] if "spatialReference" in desc else None
    return {
        "input": path,
        "catalog_path": catalog,
        "workspace": workspace_of(catalog),
        "name": split_catalog_path(catalog)[1],
        "data_type": desc["dataType"],
        "is_layer": desc["dataType"] in LAYER_DATA_TYPES,
        "shape_type": desc["shapeType"] if "shapeType" in desc else None,
        "sr": sr_info(sr),
        "sr_object": sr,
        "oid_field": desc["OIDFieldName"] if ("hasOID" in desc and desc["hasOID"]) else None,
        "fields": fields,
        "has_z": bool(desc["hasZ"]) if "hasZ" in desc else False,
        "has_m": bool(desc["hasM"]) if "hasM" in desc else False,
    }


# --------------------------------------------------------------------------
# Read
# --------------------------------------------------------------------------

def _arcio_densify_curve(shape):
    """Esri JSON dict of a curved geometry after densification."""
    ext = shape.extent
    diag = math.hypot(ext.width, ext.height) or 1.0
    dense = shape.densify("ANGLE", diag / _ARCIO_CURVE_DIVISIONS, _ARCIO_CURVE_DEVIATION)
    data = json.loads(dense.JSON)
    if esri_json_has_curves(data):
        raise ToolError("A true-curve geometry could not be densified.",
                        "Run the Densify tool on the input first, then rerun this tool.")
    return data


def read_features(path, fields=(), sr=None, where=None, geometry=True):
    """Read rows as dicts ``{"oid", "shape", "attrs"}``.

    ``path`` may be a layer (selection and definition query honoured).
    ``sr`` (an ``arcpy.SpatialReference``) projects geometry at read time so
    source ObjectIDs are kept. True curves (``curvePaths``/``curveRings``) are
    re-read with ``SHAPE@`` and densified (decision D-005). Z and M are dropped.
    """
    register_inputs([path])
    fields = list(fields)
    tokens = ["OID@"] + (["SHAPE@JSON"] if geometry else []) + fields
    first = 2 if geometry else 1
    rows, curved = [], {}
    with arcpy.da.SearchCursor(path, tokens, where_clause=where, spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None,
                   "attrs": dict(zip(fields, values[first:]))}
            if geometry and values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    curved[values[0]] = row
                else:
                    row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    if curved:
        with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@"], where_clause=where,
                                   spatial_reference=sr) as cursor:
            for oid, shape in cursor:
                if oid in curved and shape is not None:
                    curved[oid]["shape"] = esri_json_to_core(_arcio_densify_curve(shape))[1]
    return rows


def read_features_skip_curves(path, fields=(), sr=None, where=None, zm=None):
    """Like ``read_features`` but true-curve features are skipped, not densified.

    Returns ``(rows, skipped_oids)``. Tools that report individual vertices or
    segments use this: densified arcs would create artificial vertices.
    Skipped features are not in ``rows``.

    ``zm``: optional dict; when given, ``zm["z"]`` / ``zm["m"]`` are set to the lists of
    ObjectIDs of the features that carry Z / M values (which the core geometry drops).
    """
    register_inputs([path])
    fields = list(fields)
    rows, skipped = [], []
    with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@JSON"] + fields, where_clause=where,
                               spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "attrs": dict(zip(fields, values[2:]))}
            if values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    skipped.append(values[0])
                    continue
                if zm is not None:
                    has_z, has_m = esri_json_zm(data)
                    if has_z:
                        zm.setdefault("z", []).append(values[0])
                    if has_m:
                        zm.setdefault("m", []).append(values[0])
                row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    return rows, skipped


def iter_features(path, fields=(), sr=None, where=None, geometry=True):
    """Like ``read_features`` but a generator: one row at a time, nothing kept in memory.

    Yields ``{"oid", "shape", "attrs", "curved"}``. A true-curve feature is NOT densified
    here: ``shape`` is ``None`` and ``curved`` is True (callers that only draw an outline
    count and skip it). Without ``geometry`` the cursor has no shape token (tables).
    """
    register_inputs([path])
    fields = list(fields)
    tokens = ["OID@"] + (["SHAPE@JSON"] if geometry else []) + fields
    first = 2 if geometry else 1
    with arcpy.da.SearchCursor(path, tokens, where_clause=where, spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "curved": False,
                   "attrs": dict(zip(fields, values[first:]))}
            if geometry and values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    row["curved"] = True
                else:
                    row["shape"] = esri_json_to_core(data)[1]
            yield row


def count_rows(path, where=None):
    """Number of rows of a table, feature class or layer (a layer's selection and definition
    query are honoured). Counted with a cursor on the ObjectID, nothing is kept."""
    register_inputs([path])
    total = 0
    with arcpy.da.SearchCursor(path, ["OID@"], where_clause=where) as cursor:
        for _row in cursor:
            total += 1
    return total


# Straight segments of a geographic (or other non-metric) input are straight in
# THAT system; projecting only their vertices bends them (about 0.02 m off at the
# middle of a 1.5 km segment, 2 m at 15 km). Lines are therefore densified in
# their own system every ~ARCIO_DENSIFY_STEP_M before they are projected.
ARCIO_DENSIFY_STEP_M = 100.0
_ARCIO_METRES_PER_DEGREE = 111320.0


def densify_step_for(desc, decision):
    """Densify distance in the input's own units before reprojecting it, or
    ``None`` when the input is used as is (no projection, nothing bends)."""
    if not decision.get("reproject"):
        return None
    info = desc["sr"] or {}
    if info.get("type") == "Geographic":
        return ARCIO_DENSIFY_STEP_M / _ARCIO_METRES_PER_DEGREE
    mpu = info.get("meters_per_unit")
    if mpu:
        return ARCIO_DENSIFY_STEP_M / float(mpu)
    return None


def read_features_densified(path, fields=(), sr=None, step=None, skip_curves=False,
                            where=None, geographic=False):
    """Read lines/polygons projected to ``sr`` after densifying them in their own
    system, so the projected geometry follows the straight segments of the
    source system. Each segment is densified on its own in pure Python
    (``geom.densify_path_segments``), the result is rebuilt with
    ``arcpy.AsShape`` in the source system and projected with
    ``Geometry.projectAs``. Without a source WKID, ``Geometry.densify``
    ("DISTANCE") is used instead.

    Without ``sr`` or ``step`` this is ``read_features`` (or
    ``read_features_skip_curves`` with ``skip_curves``). True curves are
    skipped (``skip_curves``) or densified by angle first (D-005). Returns
    ``(rows, skipped_oids)``. Adds vertices: use only for measuring and
    snapping, never where the vertices themselves are the result.

    ``geographic``: the input is in a geographic system. A segment spanning
    more than 180 degrees of longitude is taken to cross the antimeridian the
    short way and is densified across it (only that segment is affected).
    """
    register_inputs([path])
    fields = list(fields)
    if sr is None or not step:
        if skip_curves:
            return read_features_skip_curves(path, fields, sr=sr, where=where)
        return read_features(path, fields, sr=sr, where=where), []
    rows, skipped = [], []
    with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@"] + fields, where_clause=where) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "attrs": dict(zip(fields, values[2:]))}
            shape = values[1]
            if shape is not None:
                if shape.hasCurves:
                    if skip_curves:
                        skipped.append(values[0])
                        continue
                    ext = shape.extent
                    diag = math.hypot(ext.width, ext.height) or 1.0
                    shape = shape.densify("ANGLE", diag / _ARCIO_CURVE_DIVISIONS,
                                          _ARCIO_CURVE_DEVIATION)
                source = json.loads(shape.JSON)
                kind, core = esri_json_to_core(source)
                own = shape.spatialReference
                wkid = own.factoryCode if own is not None else None
                if core is None:
                    rows.append(row)
                    continue
                if wkid:
                    dense = [densify_path_segments(part, step, geographic) for part in core]
                    shape = arcpy.AsShape(core_to_esri_json(kind, dense, wkid), True)
                    shape = shape.projectAs(sr)
                else:
                    shape = shape.densify("DISTANCE", step).projectAs(sr)
                data = json.loads(shape.JSON)
                if esri_json_has_curves(data):
                    raise ToolError("A true-curve geometry could not be densified.",
                                    "Run the Densify tool on the input first, then rerun "
                                    "this tool.")
                row["shape"] = esri_json_to_core(data)[1]
            rows.append(row)
    return rows, skipped


def _arcio_coords(node, out):
    """Collect ``(x, y)`` pairs from any nested Esri JSON coordinate list."""
    if isinstance(node, (list, tuple)):
        if len(node) >= 2 and all(isinstance(v, (int, float)) for v in node[:2]):
            out.append((float(node[0]), float(node[1])))
        else:
            for item in node:
                _arcio_coords(item, out)
    elif isinstance(node, dict):
        for value in node.values():
            _arcio_coords(value, out)


def sample_lonlat(path, where=None, max_samples=5000):
    """Up to ``max_samples`` vertices of the input in WGS 84 degrees."""
    register_inputs([path])
    samples = []
    wgs84 = arcpy.SpatialReference(4326)
    with arcpy.da.SearchCursor(path, ["SHAPE@JSON"], where_clause=where,
                               spatial_reference=wgs84) as cursor:
        for (text,) in cursor:
            if not text:
                continue
            data = json.loads(text)
            if "x" in data:
                if data.get("x") is not None and data.get("y") is not None:
                    samples.append((float(data["x"]), float(data["y"])))
                continue
            data.pop("spatialReference", None)
            _arcio_coords(data, samples)
            if len(samples) > 2 * max_samples:
                samples = samples[::2]
    if len(samples) > max_samples:
        samples = samples[::int(math.ceil(len(samples) / float(max_samples)))]
    return samples


def metric_sr_for(desc, where=None):
    """Choose the measuring coordinate system for a described dataset.

    Returns ``(decision, spatial_reference)``; ``spatial_reference`` is
    ``None`` when the input system is kept (no projection needed). See
    ``projection.choose_metric_sr`` for ``decision``.
    """
    info = desc["sr"]
    try:
        decision = choose_metric_sr(info, None)  # enough when the input system is kept
    except ToolError:
        decision = choose_metric_sr(info, sample_lonlat(desc["input"], where))
    if not decision["reproject"]:
        return decision, None
    return decision, arcpy.SpatialReference(decision["wkid"])


def metric_sr_or_native(desc, where=None):
    """Like ``metric_sr_for``, but an input without any usable coordinates
    (empty, or only null geometries) in a geographic or Web Mercator system
    keeps its own system instead of failing: there is nothing to measure.

    The decision then has ``"empty": True`` and ``meters_per_unit`` 1.0.
    """
    try:
        return metric_sr_for(desc, where)
    except ToolError:
        info = desc["sr"] or {}
        return {"wkid": info.get("wkid"), "meters_per_unit": 1.0, "reproject": False,
                "reason": "The input has no features with coordinates, so nothing is "
                          "measured.", "warnings": [], "empty": True}, None


def read_domains(workspace):
    """``{name: domain dict}`` for all domains of a workspace (see ``domains``).

    The workspace is registered as an input of the run (a domain source)."""
    register_inputs([workspace])
    try:
        return _arcio_list_domains(workspace)
    except (RuntimeError, ValueError, OSError, arcpy.ExecuteError) as exc:
        # ListDomains is documented for geodatabases only; a GeoPackage, a missing or locked
        # geodatabase would otherwise end as a bare Python traceback.
        raise ToolError("The attribute domains of '{0}' could not be read: {1}".format(
            workspace, str(exc).strip() or type(exc).__name__),
            "Attribute domains exist only in geodatabases. Use a file, mobile or enterprise "
            "geodatabase, and check that it is not locked by another application.")


def _arcio_list_domains(workspace):
    result = {}
    if is_folder_workspace(workspace):
        return result
    for dom in arcpy.da.ListDomains(workspace):
        coded = dom.domainType == "CodedValue"
        result[dom.name] = {
            "name": dom.name,
            "domain_type": dom.domainType,
            "field_type": dom.type,
            "codes": dict(dom.codedValues or {}) if coded else {},
            "range": None if coded else tuple(dom.range),
            "description": dom.description,
        }
    return result


def read_output_domains(out_path):
    """Domains of the workspace an output path will be written to (its
    geodatabase, also when the output is in a feature dataset), for
    ``domains.keep_field_domain``. ``{}`` for a folder, or when they cannot be
    listed (e.g. ``memory``, or a location that does not exist yet)."""
    try:
        return _arcio_list_domains(workspace_of(out_path)) or {}
    except Exception:
        return {}


def read_subtypes(path):
    """Subtype structure (see ``domains``); ``{"field": "", "subtypes": {}}`` if none.

    Pass a catalog path (``describe_dataset(...)["catalog_path"]``). Shapefiles
    and other folder datasets have no subtypes and are not queried.
    """
    register_inputs([path])
    empty = {"field": "", "subtypes": {}}
    workspace = workspace_of(path)
    if workspace and (is_folder_workspace(workspace) or workspace.casefold().endswith(".gpkg")):
        return empty  # shapefiles, dBASE tables and GeoPackage tables have no subtypes
    raw = arcpy.da.ListSubtypes(path)
    field = ""
    subtypes = {}
    for code, info in raw.items():
        field = info["SubtypeField"] or field
        domains, defaults = {}, {}
        for name, values in info["FieldValues"].items():
            defaults[name] = values[0]
            domains[name] = values[1].name if values[1] is not None else None
        subtypes[code] = {"name": info["Name"], "default": info["Default"],
                          "domains": domains, "defaults": defaults}
    if not field:
        return empty
    return {"field": field, "subtypes": subtypes}


# Datatype keywords documented for arcpy.da.Walk (walk.html, API audit).
WALK_DATATYPES = ("Any", "CadDrawing", "FeatureClass", "FeatureDataset", "GeometricNetwork",
                  "LasDataset", "Layer", "Locator", "Map", "MosaicDataset", "NetworkDataset",
                  "ParcelDataset", "RasterCatalog", "RasterDataset", "RelationshipClass",
                  "RepresentationClass", "Table", "Terrain", "Tin", "Tool", "Topology",
                  "UtilityNetwork")


def walk_workspace(root, datatypes=("FeatureClass", "Table"), recursive=True):
    """List datasets under a folder or workspace with ``arcpy.da.Walk``.

    Walk is called once per datatype keyword (decided before the loop), so
    every item carries the keyword it was found with; ``type=`` is never
    passed (its effect on tables is undocumented, audit gotcha 41). Folders
    and connection files are not followed (``followlinks=False``).

    Returns ``{"items": [...], "errors": [...]}``: items are
    ``{"path", "name", "dirpath", "data_type"}`` sorted by normalised path,
    without duplicates (first datatype wins); errors are
    ``{"path", "message", "datatype"}`` (the Walk keyword that raised it) for every folder Walk could not read (its
    ``onerror`` callback) or a Walk that stopped with an exception. Errors
    never stop the listing.

    ``recursive=False`` (added for the project toolbox; the default keeps the
    old behaviour): sub-folders of a folder root are not entered, but
    geodatabases directly inside it are listed in full (a geodatabase is a
    workspace of the folder, not a sub-folder). Pruning edits ``dirnames`` in
    place on a top-down walk, so skipped folders are never read.
    """
    bad = [d for d in datatypes if d not in WALK_DATATYPES]
    if bad or not datatypes:
        raise ValueError("unknown Walk datatype(s): {0}".format(", ".join(map(str, bad)) or "none"))
    if not root or not (os.path.isdir(str(root)) or arcpy.Exists(root)):
        raise ToolError("The workspace or folder '{0}' does not exist.".format(root),
                        "Browse to an existing folder or geodatabase.")
    errors = []
    current = [None]            # the datatype keyword of the Walk that is running

    def on_error(err):
        errors.append({"path": getattr(err, "filename", None) or "", "message": str(err),
                       "datatype": current[0]})

    items = {}
    for datatype in datatypes:
        current[0] = datatype
        try:
            for dirpath, dirnames, filenames in arcpy.da.Walk(
                    root, topdown=True, onerror=on_error, followlinks=False, datatype=datatype):
                if not recursive and is_folder_workspace(workspace_of(dirpath) or dirpath):
                    if normalize_catalog_path(dirpath) != normalize_catalog_path(root):
                        dirnames[:] = []
                        continue
                    dirnames[:] = [d for d in dirnames if not is_folder_workspace(d)]
                for name in filenames:
                    path = os.path.join(dirpath, name)
                    key = normalize_catalog_path(path)
                    if key not in items:
                        items[key] = {"path": path, "name": name, "dirpath": dirpath,
                                      "data_type": datatype}
        except (RuntimeError, OSError) as exc:
            errors.append({"path": str(root), "message": "{0} ({1})".format(exc, datatype),
                           "datatype": datatype})
    listed = [items[k] for k in sorted(items)]
    register_inputs([i["path"] for i in listed])
    return {"items": listed, "errors": errors}


# --------------------------------------------------------------------------
# Create and write
# --------------------------------------------------------------------------

def overwrite_output():
    """Value of ``arcpy.env.overwriteOutput`` as a bool."""
    return bool(arcpy.env.overwriteOutput)


def _arcio_existing_outputs(out_path):
    """Existing datasets an output would replace: the path itself and, for a
    folder output without extension, the ``.shp`` / ``.dbf`` Pro would write
    (``paths.folder_dataset_candidates``)."""
    return [p for p in folder_dataset_candidates(out_path) if arcpy.Exists(p)]


def check_output_path(out_path, inputs=()):
    """Every check ``create_table``/``create_feature_class`` make, without side effects.

    Refuses an output equal to an input, a missing output location, an
    existing output when overwriting is off, and an invalid name. Tools that
    edit their input call it for all outputs **before** the backup and the
    edit session (rule 6), so a bad output can never stop the run after the
    input was changed.
    """
    refuse_if_same([out_path], inputs)
    workspace, name = split_catalog_path(out_path)
    if not workspace or not arcpy.Exists(workspace):
        raise ToolError("The output location '{0}' does not exist.".format(workspace),
                        "Choose an existing geodatabase or folder for the output.")
    if _arcio_existing_outputs(out_path) and not overwrite_output():
        raise ToolError("The output '{0}' already exists.".format(out_path),
                        "Choose a new name, or allow geoprocessing tools to overwrite "
                        "existing datasets (Options > Geoprocessing).")
    base = name
    if is_folder_workspace(workspace) and name.casefold().endswith((".shp", ".dbf")):
        base = name[:-4]
    valid = arcpy.ValidateTableName(base, validation_workspace(workspace))
    if valid != base:
        raise ToolError("The output name '{0}' is not valid in '{1}'.".format(name, workspace),
                        "Use a name such as '{0}' (letters, digits and underscores).".format(valid))


def _arcio_prepare_output(out_path, inputs):
    """Checks shared by feature class and table creation; returns ``(ws, name)``."""
    refuse_if_same([out_path], inputs)
    workspace, name = split_catalog_path(out_path)
    if not workspace or not arcpy.Exists(workspace):
        raise ToolError("The output location '{0}' does not exist.".format(workspace),
                        "Choose an existing geodatabase or folder for the output.")
    existing = _arcio_existing_outputs(out_path)
    if existing:
        if not overwrite_output():
            raise ToolError("The output '{0}' already exists.".format(out_path),
                            "Choose a new name, or allow geoprocessing tools to overwrite "
                            "existing datasets (Options > Geoprocessing).")
        for path in existing:
            safe_delete(path, inputs)
    base = name
    if is_folder_workspace(workspace) and name.casefold().endswith((".shp", ".dbf")):
        base = name[:-4]
    valid = arcpy.ValidateTableName(base, validation_workspace(workspace))
    if valid != base:
        raise ToolError("The output name '{0}' is not valid in '{1}'.".format(name, workspace),
                        "Use a name such as '{0}' (letters, digits and underscores).".format(valid))
    return workspace, name


def validation_workspace(workspace):
    """Workspace to pass to ``ValidateTableName`` / ``ValidateFieldName`` for an
    output container: a feature dataset is validated against its geodatabase
    (the Validate functions document file system and geodatabase workspaces);
    a folder or geodatabase is returned unchanged."""
    if workspace and not is_folder_workspace(workspace):
        return workspace_of(workspace) or workspace
    return workspace


def _arcio_folder_name(workspace, name, ext):
    """``name`` with ``ext`` (``.shp`` / ``.dbf``) added in a folder workspace when it has no
    extension: Pro takes an extension-less table name in a folder for an INFO table
    (ERROR 000734 with a space in the path; Pro session 1, S3)."""
    if is_folder_workspace(workspace) and "." not in name:
        return name + ext
    return name


def _arcio_output_path(workspace, name):
    return workspace + "\\" + _arcio_folder_name(workspace, name, ".shp")


# A shapefile/dBASE field name holds at most 10 BYTES in UTF-8, not 10 characters (REPORTED: Pro
# job_403, ThiessenPolygonsConvex log: Arabic names of 12 and 15 letters were stored as 5 letters,
# 10 bytes; one of 4 letters, 8 bytes, was kept whole).
DBF_FIELD_NAME_BYTES = 10


def dbf_field_name_bytes(name):
    """Bytes a shapefile/dBASE field name takes (UTF-8; a character above U+FFFF as 6, like
    ``_arcio_dbf_bytes``)."""
    return _arcio_dbf_bytes(name)


def cut_dbf_field_name(name, limit=DBF_FIELD_NAME_BYTES):
    """``name`` cut at a character boundary to at most ``limit`` bytes (see
    ``dbf_field_name_bytes``): what a dBASE workspace keeps of a field name."""
    kept, used = [], 0
    for ch in str(name):
        size = _arcio_dbf_bytes(ch)
        if used + size > limit:
            break
        kept.append(ch)
        used += size
    return "".join(kept)


_ARCIO_SYSTEM_FIELDS = ("OBJECTID", "FID", "OID", "SHAPE", "SHAPE_LENGTH", "SHAPE_AREA")


def unique_field_specs(out_path, field_specs, fixed=0, reserved=()):
    """Make the output names of ``field_specs`` unique in the output workspace.

    The first ``fixed`` specs (the tool's own fields) keep their names; any
    later spec whose validated name clashes (shapefile/dBASE names are cut to
    10 BYTES in UTF-8, so ROAD_NAME_EN and ROAD_NAME_AR both become ROAD_NAME_,
    and an Arabic name keeps at most 5 letters) is renamed the way Copy Features
    does: shortened and given ``_1``, ``_2``, ... Names of system fields (ObjectID, Shape, ... and ``Id`` in a
    folder) and ``reserved`` names are avoided too. Nothing is created.

    Returns ``(specs, renamed)``: copies of the specs with ``name`` set to the
    final output name (the original name is kept as ``alias`` when no alias
    was given) and a list of ``(original, new)`` pairs.
    """
    workspace = validation_workspace(split_catalog_path(out_path)[0])
    folder = is_folder_workspace(workspace)
    taken = set(n.casefold() for n in _ARCIO_SYSTEM_FIELDS)
    taken.update(str(r).casefold() for r in reserved)
    if folder:
        taken.add("id")
    # A new name must not be the (validated) name of a LATER spec either: with input fields ORIG_X
    # and ORIG_X_1 and ORIG_X reserved, ORIG_X must become ORIG_X_2, not ORIG_X_1 (which would then
    # hold another field's data while the real ORIG_X_1 moved to ORIG_X_1_1). Review R8 F2.
    names_ahead = set(arcpy.ValidateFieldName(sp["name"], workspace).casefold()
                      for sp in field_specs[fixed:])
    out, renamed = [], []
    for k, spec in enumerate(field_specs):
        spec = dict(spec)
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        if k >= fixed and actual.casefold() in taken:
            limit = DBF_FIELD_NAME_BYTES if folder else max(len(actual), 1) + 4
            number = 1
            while True:
                suffix = "_{0}".format(number)
                if folder:
                    # dBASE names are cut to 10 BYTES (UTF-8), not characters (REPORTED: Pro
                    # job_403, Thiessen: an Arabic name kept 5 letters = 10 bytes).
                    base = cut_dbf_field_name(actual, limit - len(suffix))
                else:
                    base = actual[:limit - len(suffix)]
                candidate = arcpy.ValidateFieldName(base + suffix, workspace)
                # A workspace that cuts names by bytes (ArcGIS Pro shapefiles: an Arabic letter
                # takes 2 of the 10 bytes) drops the suffix; shorten the base until it survives,
                # so each number costs a few calls instead of ~10,000 per collision (review R5 O1).
                while base and not candidate.endswith(suffix):
                    base = base[:-1]
                    candidate = arcpy.ValidateFieldName(base + suffix, workspace)
                if candidate.casefold() not in taken and candidate.casefold() not in names_ahead:
                    break
                number += 1
            renamed.append((spec["name"], candidate))
            if not spec.get("alias"):
                spec["alias"] = spec["name"]
            actual = candidate
        taken.add(actual.casefold())
        spec["name"] = actual
        out.append(spec)
    return out, renamed


def _arcio_dbf_bytes(value):
    """Bytes a dBASE text field needs for ``value`` as Pro writes it (UTF-8; characters above U+FFFF as 6)."""
    text = str(value)
    # "surrogatepass": a lone UTF-16 surrogate (U+D800-U+DFFF) counts its 3 bytes instead of
    # raising UnicodeEncodeError (round-6 shared finding; Mojibake/Bilingual inputs can hold one).
    return len(text.encode("utf-8", "surrogatepass")) + 2 * sum(1 for ch in text if ord(ch) > 0xFFFF)


def cut_utf8_bytes(text, folder, counter, marker=""):
    """``text`` as a dBASE/shapefile text field can hold it: at most 254 bytes as Pro writes them
    (UTF-8, an Arabic letter takes 2; characters above U+FFFF count 6, see ``_arcio_dbf_bytes``;
    REPORTED by ArcGIS Pro job_222 for dBASE tables). Longer text is cut at a character boundary
    by the same rule, so a cut value can never make ``_arcio_text_length`` refuse it, and counted
    in ``counter[0]``; outside a folder nothing is cut. ``marker`` (e.g. ``" ...[cut]"``, ASCII)
    is appended to a cut value, and the cut leaves room for it."""
    if not folder or not isinstance(text, str):
        return text
    if _arcio_dbf_bytes(text) <= SHAPEFILE_MAX_TEXT:
        return text
    counter[0] += 1
    limit = SHAPEFILE_MAX_TEXT - _arcio_dbf_bytes(marker)
    kept, used = [], 0
    for ch in text:
        size = _arcio_dbf_bytes(ch)
        if used + size > limit:
            break
        kept.append(ch)
        used += size
    return "".join(kept) + marker


def _arcio_utf16_units(value):
    """Length of ``value`` in UTF-16 code units: a character above U+FFFF counts 2. A file
    geodatabase text field counts its width this way (REPORTED: Pro job_403, MojibakeDetector:
    a DETAIL value as long as the field in characters, with 5 characters above U+FFFF, was
    refused with "Field length exceeded")."""
    text = str(value)
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def _arcio_text_length(spec, actual, folder):
    """Width of the TEXT field ``spec`` (output name ``actual``).

    ``length`` if given, else the longest of ``values``. In a folder
    (shapefile/dBASE, at most 254 characters) a ``length`` that is too wide
    but comes with the ``values`` to be written (e.g. a carried field with
    Pro's default length 255) is narrowed to 254 when every value fits, as
    Copy Features does (rule 8: the values decide). Raises ``ToolError``
    only when a value, or a fixed width without values, really needs more.
    """
    values = spec.get("values")
    length = spec.get("length") or text_field_length(values or ())
    if not folder and not spec.get("length") and values:
        # geodatabase / GeoPackage: the width in UTF-16 units (job_403), never narrower than before
        length = max([length] + [_arcio_utf16_units(v) for v in values if v is not None])
    if folder and values is not None:
        # A dBASE text field written by ArcGIS Pro (UTF-8 code page) holds at most 254 BYTES, not
        # characters (REPORTED: Pro job_251, Thiessen; job_222, another tool): an Arabic letter
        # needs 2. A 97-character name of 130 bytes in a 120-wide field lost its last 10 bytes
        # without any message. The width is raised to the widest value in bytes (capped at 254).
        # Characters above U+FFFF (mathematical letters, emoji) are written by Pro as two 3-byte
        # surrogates (CESU-8: 6 bytes, not 4; CONFIRMED in the bytes of a Pro job 274 dBASE file),
        # so they count 6.
        widest_bytes = max([_arcio_dbf_bytes(v) for v in values if v is not None] or [0])
        if widest_bytes > SHAPEFILE_MAX_TEXT:
            raise ToolError(
                "Field '{0}' holds a value of {1} characters ({2} bytes in UTF-8 as ArcGIS Pro writes them, where a "
                "character above U+FFFF such as an emoji takes 6); shapefiles and dBASE tables allow "
                "{3} bytes.".format(actual, text_field_length(values), widest_bytes,
                                    SHAPEFILE_MAX_TEXT),
                "Write the output to a file geodatabase instead of a folder.")
        return min(max(length, widest_bytes), SHAPEFILE_MAX_TEXT)
    if not folder or length <= SHAPEFILE_MAX_TEXT:
        return length
    if values is not None and spec.get("length"):
        longest = text_field_length(values)
        if longest <= SHAPEFILE_MAX_TEXT:
            return SHAPEFILE_MAX_TEXT
        raise ToolError(
            "Field '{0}' holds a value of {1} characters; shapefiles and dBASE tables allow {2}.".format(
                actual, longest, SHAPEFILE_MAX_TEXT),
            "Write the output to a file geodatabase instead of a folder.")
    raise ToolError(
        "Field '{0}' needs {1} characters; shapefiles and dBASE tables allow {2}.".format(
            actual, length, SHAPEFILE_MAX_TEXT),
        "Write the output to a file geodatabase instead of a folder.")


def plan_field_names(field_specs, workspace, reserved=()):
    """Valid output names for ``field_specs`` without creating anything.

    Returns ``{requested name: actual name}`` (``arcpy.ValidateFieldName``).
    Raises ``ToolError`` when two fields would get the same name, when a name
    equals one of ``reserved`` (e.g. the ObjectID field the new table gets),
    or when a shapefile/dBASE text field would be wider than 254 characters.
    Call it before the output is created so a bad schema never leaves a
    half-built output behind.
    """
    mapping = {}
    used = {}
    taken = set(str(r).casefold() for r in reserved)
    folder = is_folder_workspace(workspace)
    workspace = validation_workspace(workspace)
    for spec in field_specs:
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        key = actual.casefold()
        if key in used:
            raise ToolError("The output fields '{0}' and '{1}' would both be called '{2}'.".format(
                used[key], spec["name"], actual),
                "Give one of them another name{0}.".format(
                    " (dBASE/shapefile field names are cut to 10 bytes in UTF-8)" if folder else ""))
        if key in taken:
            raise ToolError("The output field '{0}' would be called '{1}', a name the new output "
                            "already uses.".format(spec["name"], actual),
                            "Give that field another name.")
        used[key] = spec["name"]
        if folder and spec["type"] == "TEXT":
            _arcio_text_length(spec, actual, folder)
        mapping[spec["name"]] = actual
    return mapping


def plan_output_fields(out_path, field_specs, fixed=0, reserved=()):
    """``unique_field_specs`` then ``plan_field_names`` for one output, before
    anything is created. Returns ``(specs, renamed)`` (see ``unique_field_specs``);
    raises ``ToolError`` for problems renaming cannot solve (e.g. a text field
    wider than a shapefile allows)."""
    specs, renamed = unique_field_specs(out_path, field_specs, fixed, reserved)
    plan_field_names(specs, split_catalog_path(out_path)[0])
    return specs, renamed


def add_fields(table, field_specs, workspace):
    """Add fields; return ``{requested name: actual name}``.

    ``field_specs``: dicts with ``name``, ``type`` (AddField keyword: TEXT,
    SHORT, LONG, DOUBLE, ...), optional ``alias``, ``length``, ``values`` and
    ``domain`` (a domain of the output workspace; AddField ignores unknown ones).
    A TEXT field without ``length`` gets the width of its longest value.
    """
    mapping = {}
    used = set()
    folder = is_folder_workspace(workspace)
    workspace = validation_workspace(workspace)
    for spec in field_specs:
        actual = arcpy.ValidateFieldName(spec["name"], workspace)
        if actual.casefold() in used:
            raise ToolError("Two output fields would both be called '{0}'.".format(actual),
                            "Rename one of them (shapefile field names are cut to 10 bytes in UTF-8).")
        used.add(actual.casefold())
        length = None
        if spec["type"] == "TEXT":
            length = _arcio_text_length(spec, actual, folder)
        arcpy.management.AddField(table, actual, spec["type"], field_length=length,
                                  field_alias=spec.get("alias") or None,
                                  field_domain=spec.get("domain") or None)
        mapping[spec["name"]] = actual
    return mapping


def create_feature_class(out_path, kind, sr, field_specs, inputs=(), has_z=False, has_m=False):
    """Create an output feature class; return ``(catalog path, field mapping)``.

    ``has_z`` / ``has_m``: create the output with Z / M values (``has_z="ENABLED"`` of
    Create Feature Class); the call is the same as before when both are False."""
    workspace, name = _arcio_prepare_output(out_path, inputs)
    options = {}
    if has_z:
        options["has_z"] = "ENABLED"
    if has_m:
        options["has_m"] = "ENABLED"
    result = arcpy.management.CreateFeatureclass(
        workspace, _arcio_folder_name(workspace, name, ".shp"),
        geometry_type=GEOMETRY_KEYWORDS[kind], spatial_reference=sr, **options)
    path = _arcio_created_path(result, workspace, _arcio_output_path(workspace, name))
    return path, _arcio_fields_or_delete(path, field_specs, workspace, inputs)


def create_table(out_path, field_specs, inputs=()):
    """Create an output table; return ``(catalog path, field mapping)``."""
    workspace, name = _arcio_prepare_output(out_path, inputs)
    name = _arcio_folder_name(workspace, name, ".dbf")
    result = arcpy.management.CreateTable(workspace, name)
    path = _arcio_created_path(result, workspace, workspace + "\\" + name)
    return path, _arcio_fields_or_delete(path, field_specs, workspace, inputs)


def _arcio_created_path(result, workspace, fallback):
    """Path of a dataset that Create Table / Create Feature Class just made.

    GeoPackage datasets are listed as ``<file>.gpkg\\main.<name>``, so for a GeoPackage the
    path the tool reports is used when it exists; everywhere else (and when the tool
    reports nothing usable) ``fallback`` (``workspace\\name``) is used, as before."""
    if not str(workspace).casefold().endswith(".gpkg"):
        return fallback
    try:
        reported = result.getOutput(0)
    except Exception:  # a result without a readable output keeps the old behaviour
        return fallback
    if isinstance(reported, str) and reported.strip() and arcpy.Exists(reported):
        return reported
    return fallback


def _arcio_fields_or_delete(path, field_specs, workspace, inputs):
    """``add_fields`` on a just-created output; if it fails, the empty output
    is deleted (never leave a half-built output behind) and the error raised."""
    try:
        return add_fields(path, field_specs, workspace)
    except Exception:
        try:
            safe_delete(path, inputs)
        except Exception:
            pass
        raise


def copy_for_output(in_path, out_path, field_specs, inputs=()):
    """Copy a layer/feature class (CopyFeatures) or table view (CopyRows) and add fields.

    ``in_path`` may be a layer: its selection and definition query are
    honoured. Feature inputs keep their geometry; tables are copied with
    CopyRows. The fields are added **outside** any edit session (schema
    changes inside one fail with ERROR 000496). ObjectIDs of the copy are
    new, so callers must match copied rows by attribute values, not by OID.
    Returns ``(catalog path, field mapping)``.
    """
    workspace, name = _arcio_prepare_output(out_path, inputs)
    desc = arcpy.da.Describe(in_path)
    is_features = "shapeType" in desc
    if is_features:
        path = _arcio_output_path(workspace, name)
        arcpy.management.CopyFeatures(in_path, path)
    else:
        path = workspace + "\\" + _arcio_folder_name(workspace, name, ".dbf")
        arcpy.management.CopyRows(in_path, path)
    return path, add_fields(path, field_specs, workspace)


def copy_features(in_path, out_path, inputs=()):
    """Copy features to a new output with ``arcpy.management.CopyFeatures``.

    Same output checks as ``create_feature_class`` (refuse input = output,
    respect ``overwriteOutput``, valid name). A layer input copies only its
    selected / definition-query features. Returns the output catalog path.
    Call it outside any edit session (it creates a dataset).
    """
    workspace, name = _arcio_prepare_output(out_path, inputs)
    path = _arcio_output_path(workspace, name)
    arcpy.management.CopyFeatures(in_path, path)
    return path


# Value written instead of None to a shapefile / dBASE field, by Describe field type.
# ArcGIS Pro refuses None there ("RuntimeError: The field is not nullable. [VALUE]",
# Pro session 1, S3); dates and other types are left as they are.
_ARCIO_FOLDER_DEFAULTS = {"SmallInteger": 0, "Integer": 0, "BigInteger": 0, "Single": 0.0,
                          "Double": 0.0, "String": ""}


def _arcio_folder_defaults(path, field_names):
    """``{index: default}`` for the fields of a folder output that cannot hold None."""
    if not is_folder_workspace(workspace_of(path)):
        return {}
    types = dict((f.name.casefold(), f.type) for f in arcpy.da.Describe(path)["fields"])
    out = {}
    for i, name in enumerate(field_names):
        default = _ARCIO_FOLDER_DEFAULTS.get(types.get(str(name).casefold()))
        if default is not None:
            out[i] = default
    return out


def insert_rows(path, field_names, rows, kind=None, wkid=None, null_fields=None):
    """Insert rows; return the number inserted.

    With ``kind`` each row is ``(core geometry, values)``; without it, ``values``. The
    geometry may also be an Esri JSON dict (passed to ``arcpy.AsShape`` as it is, so Z
    and M in it are kept).
    ``null_fields``: optional set; the names of ``field_names`` that received
    at least one ``None`` are added to it (see ``folder_null_number_warning``).
    In a folder output (shapefile / dBASE) a ``None`` number is written as 0 and
    a ``None`` text as ``""`` (the type default; ArcGIS Pro refuses None there),
    and the field is still added to ``null_fields`` so the tool warns once
    naming it.
    """
    field_names = list(field_names)
    tokens = (["SHAPE@"] if kind else []) + field_names
    defaults = _arcio_folder_defaults(path, field_names)
    count = 0
    with arcpy.da.InsertCursor(path, tokens) as cursor:
        for row in rows:
            if kind:
                geom, values = row
            else:
                geom, values = None, row
            values = list(values)
            if null_fields is not None:
                for name, value in zip(field_names, values):
                    if value is None:
                        null_fields.add(name)
            for i, default in defaults.items():
                if i < len(values) and values[i] is None:
                    values[i] = default
            if kind:
                data = geom if isinstance(geom, dict) else core_to_esri_json(kind, geom, wkid)
                shape = arcpy.AsShape(data, True) if data is not None else None
                cursor.insertRow([shape] + values)
            else:
                cursor.insertRow(values)
            count += 1
    return count


def insert_shaped_rows(path, field_names, rows, null_fields=None):
    """Insert rows whose geometry is an ``arcpy.Geometry`` taken from another dataset.

    Each row is ``(geometry or None, values)``; the geometry is written as it is (a
    true curve stays a curve), so the output must be a feature class of the same
    geometry type and coordinate system. ``null_fields`` and the handling of empty
    numbers in a shapefile / dBASE output are the same as in ``insert_rows``.
    Returns the number of rows inserted.
    """
    field_names = list(field_names)
    defaults = _arcio_folder_defaults(path, field_names)
    count = 0
    with arcpy.da.InsertCursor(path, ["SHAPE@"] + field_names) as cursor:
        for geom, values in rows:
            values = list(values)
            if null_fields is not None:
                for name, value in zip(field_names, values):
                    if value is None:
                        null_fields.add(name)
            for i, default in defaults.items():
                if i < len(values) and values[i] is None:
                    values[i] = default
            cursor.insertRow([geom] + values)
            count += 1
    return count


_ARCIO_NUMBER_TYPES = ("SHORT", "LONG", "BIGINTEGER", "FLOAT", "DOUBLE")


def folder_null_number_warning(path, field_specs, mapping, null_fields, note=""):
    """Warning text, or ``None``, for empty numbers written to a folder output.

    A shapefile or dBASE table cannot store an empty (null) number: Add Field
    documents that nulls are only supported in a geodatabase and that zeros
    are inserted for numeric fields. ``field_specs`` are the specs the output
    was created with, ``mapping`` their ``{name: actual name}`` and
    ``null_fields`` the actual names ``insert_rows`` saw ``None`` in.
    ``note`` (optional) is added to say what the 0 means for those fields.
    """
    if not null_fields or not is_folder_workspace(workspace_of(path)):
        return None
    names, texts = [], []
    for spec in field_specs:
        actual = mapping.get(spec["name"], spec["name"])
        if str(spec.get("type", "")).upper() in _ARCIO_NUMBER_TYPES and actual in null_fields:
            names.append(actual)
        elif str(spec.get("type", "")).upper() == "TEXT" and actual in null_fields:
            texts.append(actual)
    if not names and not texts:
        return None
    parts = []
    if names:
        parts.append("Field(s) {0} of '{1}' have empty values, but a shapefile or dBASE table "
                     "cannot store an empty number: they are stored as 0, so 0 there can also "
                     "mean 'empty'.".format(", ".join(names), path))
    if texts:
        parts.append("Field(s) {0} of '{1}' have empty values, stored as empty text (a "
                     "shapefile or dBASE table cannot store an empty value).".format(
                         ", ".join(texts), path))
    text = " ".join(parts)
    if note:
        text += " " + note.strip()
    return text + (" Write the output to a file geodatabase to keep empty values empty.")


def update_rows(path, field_names, changes, where=None, null_fields=None):
    """Apply ``{oid: {field: value}}``; only rows whose values change are written.

    Returns the number of rows updated. Call inside ``edit_session``.
    ``null_fields``: optional set; the names of ``field_names`` that are set to
    ``None`` in at least one row are added to it (see
    ``folder_null_number_warning``).
    """
    field_names = list(field_names)
    count = 0
    with arcpy.da.UpdateCursor(path, ["OID@"] + field_names, where_clause=where) as cursor:
        for row in cursor:
            change = changes.get(row[0])
            if not change:
                continue
            new = list(row)
            for i, name in enumerate(field_names):
                if name in change:
                    new[i + 1] = change[name]
                    if null_fields is not None and change[name] is None:
                        null_fields.add(name)
            if new != list(row):
                cursor.updateRow(new)
                count += 1
    return count


# --------------------------------------------------------------------------
# Delete, backup, edit session
# --------------------------------------------------------------------------

def safe_delete(path, inputs=()):
    """Delete ``path`` unless it is an input or an edit session is open."""
    if _ARCIO_EDIT_STATE["depth"] > 0:
        raise ToolError("Refusing to delete '{0}' while an edit session is open.".format(path),
                        "This is a bug in the tool: deletes must happen before or after editing.")
    refuse_if_same([path], inputs)
    if arcpy.Exists(path):
        arcpy.management.Delete(path)


def _arcio_name_keys(path):
    """Comparison keys of a path with and without a .shp/.dbf extension."""
    key = normalize_catalog_path(path)
    keys = set([key])
    if key.endswith((".shp", ".dbf")):
        keys.add(key[:-4])
    return keys


def backup_copy(path, avoid=()):
    """Copy ``path`` to ``<name>_backupN`` next to it; return the copy's path.

    ``N`` is the first number whose name neither exists nor is one of the
    paths in ``avoid`` (pass the run's output paths, so an output can never
    replace the backup). Raises ``ToolError`` if the copy fails, so callers
    stop before editing.
    """
    taken = set()
    for other in avoid:
        if other:
            taken |= _arcio_name_keys(other)
    workspace, name = split_catalog_path(path)
    stem, ext = name, ""
    if is_folder_workspace(workspace) and "." in name:
        stem, ext = name.rsplit(".", 1)
        ext = "." + ext
    number = 1
    while True:
        candidate = "{0}\\{1}_backup{2}{3}".format(workspace, stem, number, ext)
        if not arcpy.Exists(candidate) and not (_arcio_name_keys(candidate) & taken):
            break
        number += 1
    try:
        arcpy.management.Copy(path, candidate)
    except (arcpy.ExecuteError, RuntimeError, OSError) as exc:
        raise ToolError("The backup copy of '{0}' failed, so nothing was edited: {1}".format(
            path, exc), "Check free disk space and write permission, then run the tool again.")
    if not arcpy.Exists(candidate):
        raise ToolError("The backup copy '{0}' was not created, so nothing was edited.".format(
            candidate), "Check write permission on the workspace, then run the tool again.")
    return candidate


@contextlib.contextmanager
def edit_session(workspace):
    """One ``arcpy.da.Editor`` session with one operation; rollback on failure.

    On success the operation is stopped and edits saved; on any exception the
    operation is aborted, the session stopped without saving, and the
    exception re-raised. Deletes are refused while the session is open.
    """
    editor = arcpy.da.Editor(workspace)
    editor.startEditing(False, True)
    _ARCIO_EDIT_STATE["depth"] += 1
    try:
        editor.startOperation()
    except BaseException:
        _ARCIO_EDIT_STATE["depth"] -= 1
        editor.stopEditing(False)
        raise
    try:
        yield editor
    except BaseException:
        try:
            editor.abortOperation()
        finally:
            _ARCIO_EDIT_STATE["depth"] -= 1
            editor.stopEditing(False)
        raise
    committed = False
    try:
        editor.stopOperation()
        editor.stopEditing(True)
        committed = True
    finally:
        _ARCIO_EDIT_STATE["depth"] -= 1
        if not committed and editor.isEditing:
            try:
                editor.abortOperation()
            finally:
                editor.stopEditing(False)


# --------------------------------------------------------------------------
# Messages, progress, outputs, environment
# --------------------------------------------------------------------------

def flush_messages(collector):
    """Send a ``MessageCollector``'s messages to ArcGIS Pro and clear it."""
    for level, text in collector.items:
        if level == MESSAGE_ERROR:
            arcpy.AddError(text)
        elif level == MESSAGE_WARNING:
            arcpy.AddWarning(text)
        else:
            arcpy.AddMessage(text)
    collector.clear()


class Progress(object):
    """Step progressor that updates at most ~100 times."""

    def __init__(self, label, total):
        self.total = max(int(total), 0)
        self.step = max(1, self.total // 100)
        self.count = 0
        self._shown = 0
        if self.total > 0:
            arcpy.SetProgressor("step", label, 0, self.total, self.step)
        else:
            arcpy.SetProgressor("default", label)

    def tick(self, amount=1):
        self.count += amount
        if self.total and (self.count - self._shown >= self.step or self.count >= self.total):
            self._shown = self.count
            arcpy.SetProgressorPosition(min(self.count, self.total))

    def label(self, text):
        arcpy.SetProgressorLabel(text)

    def close(self):
        arcpy.ResetProgressor()


# Parameter data types that never name a dataset or file (keywords and the display
# names Pro may report); their values are not resolved with Describe.
_ARCIO_NON_DATA_TYPES = frozenset(t.casefold() for t in (
    "GPBoolean", "Boolean", "GPString", "String", "GPLong", "Long", "GPDouble", "Double",
    "Field", "GPSQLExpression", "SQL Expression", "GPLinearUnit", "Linear Unit",
    "GPDate", "Date", "GPValueTable", "Value Table", "GPCoordinateSystem",
    "Coordinate System", "GPSpatialReference", "Spatial Reference", "GPExtent", "Extent"))


def _arcio_is_data_parameter(param):
    kinds = param.datatype if isinstance(param.datatype, (list, tuple)) else [param.datatype]
    return any(str(k).casefold() not in _ARCIO_NON_DATA_TYPES for k in kinds)


def _arcio_parameter_inputs(parameters):
    """``(paths, joined)`` of every Input parameter value naming a dataset or file
    (multivalues split): each value as typed plus its catalog path (a layer -> its
    data source), and the names of the tables joined to each input layer."""
    params = parameters.values() if isinstance(parameters, dict) else parameters
    paths, joined = [], set()
    for param in params:
        if param.direction != "Input" or not _arcio_is_data_parameter(param):
            continue
        text = param.valueAsText
        if not text:
            continue
        for value in split_multivalue(text):
            paths.append(value)
            try:
                if arcpy.Exists(value):
                    desc = arcpy.da.Describe(value)
                    paths.append(desc["catalogPath"])
                    if "fields" in desc:
                        joined.update(joined_table_names([field_info(f) for f in desc["fields"]]))
            except Exception:  # an unreadable value is still compared as typed
                pass
    return paths, joined


def register_parameter_inputs(parameters):
    """Register every Input parameter value naming a dataset or file (multivalues
    split), as typed and resolved to its catalog path (a layer -> its data source),
    so no output or report of the run can replace it (rule 4; review D1/D2).
    The names of the tables joined to each input layer (qualified field names,
    ``paths.joined_table_names``) are registered too: a layer reports only its
    own table's path, so an output or report named like a joined table is
    refused in any workspace (re-review N1)."""
    paths, joined = _arcio_parameter_inputs(parameters)
    register_inputs(paths)
    register_joined_tables(joined)


def _arcio_inside(path, root):
    """True if ``path`` is ``root`` or lies inside it (normalised catalog paths)."""
    key = normalize_catalog_path(root)
    if not key:
        return False
    for candidate in (normalize_catalog_path(path), normalize_catalog_path(split_catalog_path(path)[0])):
        if candidate == key or candidate.startswith(key.rstrip("\\") + "\\"):
            return True
    return False


def refuse_existing_protected_output(param, protected_paths, scanned_workspaces=(),
                                     refuse_inside=False, joined=()):
    """``updateMessages`` check: set an error on an output parameter that would replace
    a protected dataset or file; return True if it did.

    ArcGIS Pro deletes an existing output before ``execute`` runs when overwriting is
    on, so a refusal in ``execute`` comes too late (Pro session 1, S2: a scanned
    dataset was lost). Only an error set during validation stops the run before the
    delete (a warning does not; ``_work/pro_logs/s2_probe.txt``). Refused:

    * the output is the same dataset as any protected path (``paths.same_dataset``);
    * the output lies inside a scanned workspace (``scanned_workspaces``) and already
      exists, or lies inside it at all when ``refuse_inside`` (decision D-015);
    * the output is named like a table joined to an input layer (``joined``).
    """
    out = param.valueAsText
    if not out or not str(out).strip():
        return False
    out = str(out).strip()
    reason = None
    for path in protected_paths or ():
        if path and same_dataset(out, path):
            reason = ("The output '{0}' is the same dataset as the input '{1}'; ArcGIS Pro would "
                      "delete it before the tool runs. Choose a different output name or "
                      "location.".format(out, path))
            break
    if reason is None:
        for root in scanned_workspaces or ():
            if root and _arcio_inside(out, root) and (refuse_inside or _arcio_existing_outputs(out)):
                reason = ("The output '{0}' is inside '{1}', which is being inventoried or "
                          "audited; an existing item of that name could be replaced. Write the "
                          "output outside the scanned workspace.".format(out, root))
                break
    if reason is None and joined:
        try:
            refuse_joined_table_outputs([out], joined)
        except ToolError as err:
            reason = str(err)
    if reason is None:
        return False
    param.setErrorMessage(reason)
    return True


# Keywords and the display names ArcGIS Pro reports in Parameter.datatype ("Table").
_ARCIO_FOLDER_OUTPUT_EXT = {"detable": ".dbf", "table": ".dbf", "defeatureclass": ".shp",
                            "feature class": ".shp"}


def add_folder_output_extensions(parameters):
    """``updateParameters`` helper: give an extension-less table / feature class output in a
    plain folder its ``.dbf`` / ``.shp``. ArcGIS Pro validates the output before the tool
    runs and takes ``folder\name`` for an INFO table (ERROR 000734 when the path has a
    space; Pro session 1, S3, ``_work/pro_logs/dbf_probe.txt``). Outputs that accept both
    kinds are left alone."""
    for param in parameters:
        if param.direction != "Output" or param.parameterType == "Derived":
            continue
        kinds = param.datatype if isinstance(param.datatype, (list, tuple)) else [param.datatype]
        exts = set(_ARCIO_FOLDER_OUTPUT_EXT.get(str(k).casefold()) for k in kinds)
        if len(exts) != 1 or None in exts:
            continue
        text = param.valueAsText
        if not text or not str(text).strip():
            continue
        workspace, name = split_catalog_path(str(text).strip())
        if workspace and "." not in name and is_folder_workspace(workspace):
            param.value = str(text).strip() + exts.pop()


def folder_output_extensions(update_parameters):
    """Decorator for a tool's ``updateParameters``: runs it, then
    ``add_folder_output_extensions``."""
    def wrapper(self, parameters):
        result = update_parameters(self, parameters)
        add_folder_output_extensions(parameters)
        return result
    wrapper.__name__ = update_parameters.__name__
    wrapper.__doc__ = update_parameters.__doc__
    return wrapper


def protected_outputs(scanned=(), refuse_inside=False):
    """Decorator for a tool's ``updateMessages``: after the tool's own checks, every
    Output parameter that is not derived is checked with
    ``refuse_existing_protected_output`` against every Input data parameter (as typed
    and resolved to its data source, plus joined tables). ``scanned`` names Input
    parameters whose workspaces the tool reads in full."""
    scanned = (scanned,) if isinstance(scanned, str) else tuple(scanned)

    def decorate(update_messages):
        def wrapper(self, parameters):
            result = update_messages(self, parameters)
            outputs = [p for p in parameters if p.direction == "Output"
                       and p.parameterType != "Derived" and p.valueAsText]
            if not outputs:
                return result
            paths, joined = _arcio_parameter_inputs(parameters)
            roots = []
            for param in parameters:
                if param.name in scanned and param.valueAsText:
                    roots.extend(split_multivalue(param.valueAsText))
            for param in outputs:
                refuse_existing_protected_output(param, paths, roots, refuse_inside, joined)
            return result
        wrapper.__name__ = update_messages.__name__
        wrapper.__doc__ = update_messages.__doc__
        return wrapper
    return decorate


def guarded_run(execute):
    """Decorator for a tool's ``execute``: for the length of the run every input
    parameter and every dataset the tool reads through this module
    (``describe_dataset``, ``read_*``, ``walk_workspace``, ``read_domains``) is
    registered, and ``create_table`` / ``create_feature_class`` /
    ``copy_for_output`` / ``check_output_path`` / ``safe_delete`` and the report
    checks refuse to replace any of them, even when the tool did not pass it in
    ``inputs`` (quality review D1/D2: a skipped shapefile input and a lookup table
    were overwritten)."""
    def wrapper(self, parameters, messages):
        begin_input_register()
        try:
            register_parameter_inputs(parameters)
            return execute(self, parameters, messages)
        finally:
            end_input_register()
    wrapper.__name__ = execute.__name__
    wrapper.__doc__ = execute.__doc__
    return wrapper


def set_derived_output(parameters, name, value):
    """Set a derived output parameter so the result is added to the map."""
    arcpy.SetParameterAsText(param_index(parameters, name), value)


def product_info():
    """``{"version": "3.3", "licence": "ArcView"}`` for messages and checks."""
    return {"version": arcpy.GetInstallInfo()["Version"], "licence": arcpy.ProductInfo()}


# ==========================================================================
# analysis/analysisshared_core.py
# ==========================================================================
# Helpers shared by the Spatial Analysis tools (pure Python, no arcpy).
#
# * ``AnalysisSegmentIndex``: grid index of line segments (and points, stored
#   as zero-length segments) with an exact nearest-segment query that visits
#   the occupied cells best-first, nearest cell first.
# * Attribute carry-over: which input fields can be copied to an output and
#   the AddField specs for them.
# * ``analysis_oid_text``: short OID lists for messages.
# * ``analysis_measuring``: the measuring plan of an input (one system, or each
#   feature on its own projection for wide or polar data) plus the decision
#   needed to check further inputs against it.

# Field.type -> AddField keyword for fields that can be copied to an output.
ANALYSIS_ADDFIELD_KEYWORDS = {"String": "TEXT", "SmallInteger": "SHORT", "Integer": "LONG",
                              "BigInteger": "BIGINTEGER", "Single": "FLOAT",
                              "Double": "DOUBLE", "Date": "DATE", "DateOnly": "DATEONLY",
                              "Guid": "GUID"}


class AnalysisSegmentIndex(object):
    """Uniform grid of segments for nearest-segment queries.

    ``add(key, a, b)`` registers segment ``a``-``b`` under an orderable
    ``key``; a point is a segment with ``a == b``. Segments are registered in
    the cells of points sampled along them every half cell, so a long
    segment touches only the cells it crosses; queries therefore look one
    extra cell around their search box. ``nearest(p, radius)`` returns the
    exact nearest segment (ties: smallest key).
    """

    def __init__(self, cell_size):
        if not cell_size or cell_size <= 0 or not math.isfinite(cell_size):
            raise ValueError("cell_size must be a positive number")
        self.cell = float(cell_size)
        self.cells = {}
        self.segments = {}
        self.bbox = None
        self._levels = None
        self._levels_count = 0

    def _cell_of(self, x, y):
        return int(math.floor(x / self.cell)), int(math.floor(y / self.cell))

    def add(self, key, a, b):
        a = (float(a[0]), float(a[1]))
        b = (float(b[0]), float(b[1]))
        self.segments[key] = (a, b)
        box = (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1]))
        if self.bbox is None:
            self.bbox = box
        else:
            self.bbox = (min(self.bbox[0], box[0]), min(self.bbox[1], box[1]),
                         max(self.bbox[2], box[2]), max(self.bbox[3], box[3]))
        length = math.hypot(b[0] - a[0], b[1] - a[1])
        steps = int(math.ceil(length / (self.cell / 2.0))) if length > 0 else 0
        seen = set()
        for k in range(steps + 1):
            f = float(k) / steps if steps else 0.0
            cell = self._cell_of(a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1]))
            if cell not in seen:
                seen.add(cell)
                self.cells.setdefault(cell, []).append(key)

    def __len__(self):
        return len(self.segments)

    def within(self, p, radius, exclude=None):
        """``[(distance, key, closest_point), ...]`` of segments within ``radius``
        of ``p``, sorted by distance then key. ``exclude(key)`` -> True skips a key."""
        out = []
        reach = radius + self.cell
        x0, y0 = self._cell_of(p[0] - reach, p[1] - reach)
        x1, y1 = self._cell_of(p[0] + reach, p[1] + reach)
        seen = set()
        if (x1 - x0 + 1) * (y1 - y0 + 1) > len(self.cells):
            # A wide search box: walk the occupied cells instead of the empty ones.
            buckets = [keys for (gx, gy), keys in self.cells.items()
                       if x0 <= gx <= x1 and y0 <= gy <= y1]
        else:
            buckets = [self.cells.get((gx, gy), ()) for gx in range(x0, x1 + 1)
                       for gy in range(y0, y1 + 1)]
        for keys in buckets:
            for key in keys:
                if key in seen:
                    continue
                seen.add(key)
                if exclude is not None and exclude(key):
                    continue
                a, b = self.segments[key]
                d, c, _t = point_segment_distance(p, a, b)
                if d <= radius:
                    out.append((d, key, c))
        out.sort(key=lambda item: (item[0], item[1]))
        return out

    def nearest(self, p, radius=None, exclude=None):
        """Nearest segment ``(distance, key, closest_point)`` or ``None``.

        With ``radius`` only segments within it are considered. Without it
        the occupied cells are visited best-first (nearest cell first) through
        a pyramid of coarser cells, and the search stops once the next cell is
        farther than the best hit plus one cell (a segment is registered in a
        cell within a quarter cell of each of its points). The cost depends on
        the cells around the answer, not on the number of segments.
        """
        if not self.segments:
            return None
        if radius is not None:
            hits = self.within(p, radius, exclude)
            return hits[0] if hits else None
        levels = self._pyramid()
        heap = []
        top = len(levels) - 1
        for (gx, gy) in levels[top]:
            heapq.heappush(heap, (self._cell_distance(p, top, gx, gy), top, gx, gy))
        best = None
        seen = set()
        while heap:
            dist, level, gx, gy = heapq.heappop(heap)
            if best is not None and dist > best[0] + self.cell:
                break
            if level:
                below = levels[level - 1]
                for cx in (2 * gx, 2 * gx + 1):
                    for cy in (2 * gy, 2 * gy + 1):
                        if (cx, cy) in below:
                            heapq.heappush(heap, (self._cell_distance(p, level - 1, cx, cy),
                                                  level - 1, cx, cy))
                continue
            for key in self.cells[(gx, gy)]:
                if key in seen:
                    continue
                seen.add(key)
                if exclude is not None and exclude(key):
                    continue
                a, b = self.segments[key]
                d, c, _t = point_segment_distance(p, a, b)
                if best is None or (d, key) < (best[0], best[1]):
                    best = (d, key, c)
        return best

    def _pyramid(self):
        """Occupied cells at level 0, then sets of 2 x 2 coarser parents, up to
        a level with at most 16 cells (built once, rebuilt after ``add``)."""
        if self._levels is None or self._levels_count != len(self.segments):
            levels = [set(self.cells)]
            while len(levels[-1]) > 16:
                levels.append(set((gx >> 1, gy >> 1) for gx, gy in levels[-1]))
            self._levels = levels
            self._levels_count = len(self.segments)
        return self._levels

    def _cell_distance(self, p, level, gx, gy):
        """Distance from ``p`` to the box of cell ``(gx, gy)`` at ``level``."""
        size = self.cell * (1 << level)
        x0, y0 = gx * size, gy * size
        dx = max(x0 - p[0], 0.0, p[0] - (x0 + size))
        dy = max(y0 - p[1], 0.0, p[1] - (y0 + size))
        return math.hypot(dx, dy)


def analysis_cell_size(lengths, fallback=1.0):
    """Grid cell size from typical segment lengths (mean of the non-zero ones)."""
    values = [v for v in lengths if v > 0 and math.isfinite(v)]
    if not values:
        return fallback
    return max(sum(values) / len(values), 1e-9)


def analysis_carry_fields(fields, reserved=()):
    """Input fields that can be copied to an output.

    ``fields`` are ``arcio.field_info`` dicts. Editable fields of a type that
    AddField can create are kept, except names equal (ignoring case) to a
    ``reserved`` output field. Returns ``(carry, skipped_names)``; skipped
    names are only the clashes with reserved names (non-copyable types such
    as ObjectID, geometry, GlobalID, blob and raster are dropped silently).
    """
    reserved = set(str(r).casefold() for r in reserved)
    carry, skipped = [], []
    for f in fields:
        if f["type"] not in ANALYSIS_ADDFIELD_KEYWORDS or not f.get("editable", True):
            continue
        if f["name"].casefold() in reserved:
            skipped.append(f["name"])
            continue
        carry.append(f)
    return carry, skipped


def analysis_carry_specs(carry, values_of=None, out_domains=None):
    """AddField specs for carried fields (same name, alias and type).

    TEXT fields keep the source length; ``values_of(name)`` may return the
    values to be written. They give a source without a length a fitting
    width, and let ``arcio`` narrow a field wider than a shapefile allows
    (e.g. Pro's default 255) to the values actually written (rule 8).
    ``out_domains``: the domains of the output workspace
    (``arcio.read_output_domains``; ``{}`` for a folder). When given, a
    field-level domain is kept as Copy Features does, or the spec is marked
    ``"lost_domain"`` (``common.domains.keep_field_domain`` /
    ``lost_domain_warning``). Subtypes and subtype-level domains are not carried.
    """
    specs = []
    for f in carry:
        spec = {"name": f["name"], "type": ANALYSIS_ADDFIELD_KEYWORDS[f["type"]],
                "alias": f.get("alias") or None}
        if out_domains is not None:
            keep_field_domain(spec, f.get("domain"), out_domains)
        if spec["type"] == "TEXT":
            spec["length"] = f.get("length") or None
            if values_of or not spec["length"]:
                spec["values"] = list(values_of(f["name"])) if values_of else []
        specs.append(spec)
    return specs


def analysis_oid_text(oids, limit=20):
    """``"1, 2, 3 ... (5 more)"``."""
    oids = list(oids)
    text = ", ".join(str(o) for o in oids[:limit])
    if len(oids) > limit:
        text += " ... ({0} more)".format(len(oids) - limit)
    return text


def analysis_measuring(desc, metric_sr_for, collector, what, geographic_sr=None):
    """``(plan, decision)`` for measuring the input ``desc``.

    ``plan`` is ``projection.choose_measuring`` (``read_sr``, ``wkid``, ``mpu``,
    ``local``); with ``geographic_sr`` (``arcpy.SpatialReference``) wide data
    (more than 3 UTM zones) and polar data are read in geographic degrees and
    measured feature by feature (``plan["local"]``). ``decision`` is the
    ``choose_metric_sr`` decision of ``metric_sr_for`` (``arcio.metric_sr_or_native``)
    when one system is used; for per-feature measuring, or when no decision was
    made (unknown or polar stereographic input), it describes the system read:
    ``{"wkid", "meters_per_unit", "reproject", "gcs_wkid", "local"}``, so further
    inputs are checked against it (``further_input_sr_check``,
    ``datum_mismatch_warning``).
    """
    captured = {}

    def measuring_sr(described):
        decision, sr = metric_sr_for(described)
        captured["decision"] = decision
        return decision, sr

    plan = choose_measuring(desc, measuring_sr, collector, what, geographic_sr=geographic_sr)
    decision = captured.get("decision")
    if plan["local"] or decision is None:
        decision = {"wkid": plan["wkid"], "meters_per_unit": plan["mpu"],
                    "reproject": bool(plan["local"]),
                    "gcs_wkid": plan["wkid"] if plan["local"] else None,
                    "local": bool(plan["local"]), "warnings": [],
                    "reason": ""}
    return plan, decision


def analysis_remeasure_gcs(sr_info, decision):
    """WKID of the geographic system in which measures are taken again feature by
    feature (``projection.local_tm_rows``) by a tool that must work in ONE plane
    (Thiessen bisectors, network nodes), or ``None`` when that plane measures well
    enough. Re-measured: polar data (EPSG 3995/3031 measure 2-2.7 % short near the
    pole), a polar stereographic input used as is, and data wider than 3 UTM zones.
    ``sr_info``: ``arcio.sr_info`` of the input; ``decision``: its
    ``choose_metric_sr`` decision."""
    info = sr_info or {}
    decision = decision or {}
    if decision.get("reproject"):
        if not (decision.get("polar")
                or (decision.get("utm_zones") or 0) > MAX_UTM_ZONES_WITHOUT_WARNING):
            return None
    elif not (info.get("type") == "Projected" and info.get("polar_stereographic")
              and info.get("wkid")):
        return None
    if info.get("type") == "Geographic" and info.get("wkid"):
        return info["wkid"]
    return WGS84_GCS_WKID


# ==========================================================================
# analysis/network_rules_core.py
# ==========================================================================
# Line Network Rule Check: dangles, pseudo-nodes, T-misses, point rules and
# connected components of a line network (pure Python).
#
# All coordinates are in one projected system; ``meters_per_unit`` converts
# its units to metres. Tolerances are given in metres and every reported
# distance (VALUE, component length) is in metres.
#
# Nodes are the end points of every part (``common.linegraph``); interior
# vertices and crossings without a shared end point are **not** nodes (no
# planarisation). End points within the snap tolerance are merged
# transitively (single linkage): a chain of end points, each within the
# tolerance of the next, becomes one node even when its two extremes are
# farther apart; such a node is reported as WIDE_NODE_CLUSTER with its
# diameter.

NETWORK_CHECKS = ("DANGLE", "PSEUDO_NODE", "COMPONENTS", "T_MISS", "POINT_RULE")
NETWORK_DEFAULT_CHECKS = ("DANGLE", "PSEUDO_NODE", "COMPONENTS")
NETWORK_POINT_RULES = ("ON_LINE", "ON_ENDPOINT")
NETWORK_RULES = ("DANGLE", "PSEUDO_NODE", "T_MISS", "WIDE_NODE_CLUSTER", "POINT_NOT_ON_LINE",
                 "POINT_NOT_ON_ENDPOINT")
NETWORK_LINES = "lines"
NETWORK_POINTS = "points"

# Above this many convex-hull vertices the exact diameter is found with
# rotating calipers (O(h)) instead of comparing every pair of hull vertices.
# The result is the exact largest pairwise distance for any number of points
# (the bounding-box diagonal, used before, is an upper bound up to 1.41 times
# too large and raised false WIDE_NODE_CLUSTER rows).
NETWORK_EXACT_DIAMETER_MAX = 300

# At most this many OIDs are listed in a DETAIL text (the rest as "(n more)"),
# so the text fits a shapefile text field (254 characters) even for 10-digit
# ObjectIDs.
NETWORK_DETAIL_MAX_OIDS = 6

# The largest Snap Tolerance or T Distance accepted, in metres (10,000 km, a quarter of the
# earth's circumference). Larger, infinite or NaN values are refused: they are not a distance
# a network check can mean, and in the search grid they overflow (1e308 m gave a raw
# OverflowError; 1e308 m in a foot-based system became infinite map units).
NETWORK_MAX_DISTANCE_M = 1e7

# The smallest Snap Tolerance or T Distance above 0 accepted, in metres (1 nanometre). A smaller
# positive value is refused: no data is that exact, and a subnormal value such as 1e-310 m made the
# node clustering stop with a raw ValueError instead of a message. 0 stays allowed.
NETWORK_MIN_DISTANCE_M = 1e-9

# SRC_OID field type: ``common.arcio.oid_field_spec`` (the toolkit's one ObjectID field rule).

# Excel shows at most 15 significant digits, so a longer ObjectID goes to the report as text.
NETWORK_EXCEL_EXACT_DIGITS = 15

# Search-grid budget: a segment is registered in about 2 x length / cell cells, so the cell is
# never smaller than 2 x (total length) / (this many x the segment count). This bounds the grid
# entries to about this many per segment on average (memory and build time stay linear).
NETWORK_INDEX_ENTRIES_PER_SEGMENT = 64

# One relative slack for every "within the tolerance" test (node merging, exempt points, the
# unsplit-end search, point rules, WIDE_NODE_CLUSTER, the too-large-tolerance check and the
# T Distance): a distance d is within t when d <= t x (1 + NETWORK_TOL_REL), 10 nanometres at a 1 mm
# tolerance, several times the rounding of a coordinate near 10,000 km (about 2e-9 m). Floating-point noise
# at exactly the tolerance no longer decides: a point 1 mm from a line in UTM coordinates measured
# 0.0010000002 m and was reported at a 1 mm tolerance, two ends 1 mm apart were not merged, while
# the unsplit search (tolerance + 1e-9) did count them. A tolerance of 0 stays exact (identical
# coordinates only).
NETWORK_TOL_REL = 1e-5

# A point-to-segment distance is computed, not compared coordinate by coordinate, so a point exactly on
# a slanted segment measures a few 1e-18 to 1e-10 map units. "On a line" (the unsplit-end search and the
# ON_LINE point rule) therefore also accepts this much at a tolerance of 0. Node merging and the
# end-point tests keep a tolerance of 0 exact.
NETWORK_ON_LINE_FLOOR = 1e-9


# The word in DETAIL that marks a DANGLE row whose free end lies on another line (within the snap
# tolerance) that is not split there. Select such rows with DETAIL LIKE '%UNSPLIT%'; the real dead ends
# with RULE = 'DANGLE' AND DETAIL NOT LIKE '%UNSPLIT%'. No other DETAIL text contains the word.
NETWORK_UNSPLIT_MARK = "UNSPLIT"


def network_unsplit_detail(oid, other, distance_m):
    """DETAIL of a DANGLE row whose free end lies on line ``other`` (``distance_m`` metres from it, within
    the snap tolerance), which has no line end there."""
    return ("Free end of line OID {0}. {1}: it lies on line OID {2} ({3:.6g} m away, within the snap "
            "tolerance), which is not split here; not a dead end.".format(
                oid, NETWORK_UNSPLIT_MARK, other, distance_m))


def network_within(tol):
    """The largest distance counted as within ``tol`` (map units): ``tol x (1 + NETWORK_TOL_REL)``."""
    return float(tol) * (1.0 + NETWORK_TOL_REL)


def network_on_line_within(tol):
    """The largest point-to-segment distance counted as on a line at ``tol``: ``network_within(tol)``,
    at least ``NETWORK_ON_LINE_FLOOR``."""
    return max(network_within(tol), NETWORK_ON_LINE_FLOOR)


def network_distance_problem(label, value):
    """Text saying why ``value`` (metres) is not a usable ``label`` distance, or ``None``.

    Accepted: 0, or a finite number from ``NETWORK_MIN_DISTANCE_M`` to ``NETWORK_MAX_DISTANCE_M``;
    ``None`` (empty) is accepted too (the default applies)."""
    if value is None:
        return None
    try:
        number = float(value)
    except (TypeError, ValueError):
        return "{0} must be a number of metres.".format(label)
    if not math.isfinite(number):
        return "{0} must be a finite number of metres (not infinite or NaN).".format(label)
    if number < 0:
        return "{0} must be zero or more.".format(label)
    if 0 < number < NETWORK_MIN_DISTANCE_M:
        return ("{0} of {1:g} m is above 0 but smaller than 0.000000001 m (1 nanometre); enter 0 "
                "to join identical coordinates only, or a larger distance.".format(label, number))
    if number > NETWORK_MAX_DISTANCE_M:
        return ("{0} of {1:g} m is larger than {2:,.0f} m (10,000 km); no line network check "
                "needs such a distance.".format(label, number, NETWORK_MAX_DISTANCE_M))
    return None


def network_report_oid(oid):
    """``oid`` for a report cell: the number itself, or its digits as text when it has more than
    15 digits (Excel would show it rounded)."""
    if isinstance(oid, int) and not isinstance(oid, bool) and \
            len(str(abs(oid))) > NETWORK_EXCEL_EXACT_DIGITS:
        return str(oid)
    return oid


def _net_cross(o, a, b):
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])


def _net_convex_hull(points):
    """Convex hull of ``points`` (monotone chain), counter-clockwise, without
    collinear points; one or two points for degenerate input."""
    pts = sorted(set((float(p[0]), float(p[1])) for p in points))
    if len(pts) <= 2:
        return pts
    lower, upper = [], []
    for p in pts:
        while len(lower) >= 2 and _net_cross(lower[-2], lower[-1], p) <= 0:
            lower.pop()
        lower.append(p)
    for p in reversed(pts):
        while len(upper) >= 2 and _net_cross(upper[-2], upper[-1], p) <= 0:
            upper.pop()
        upper.append(p)
    return lower[:-1] + upper[:-1]


def _net_pairwise_max(pts):
    best = 0.0
    for i in range(len(pts)):
        for j in range(i + 1, len(pts)):
            d = point_distance(pts[i], pts[j])
            if d > best:
                best = d
    return best


def _net_calipers(hull):
    """Diameter of a convex polygon (counter-clockwise, >= 3 vertices) by
    rotating calipers: every antipodal vertex pair is visited once."""
    m = len(hull)
    best, j = 0.0, 1
    for i in range(m):
        ni = (i + 1) % m
        while True:
            nj = (j + 1) % m
            if abs(_net_cross(hull[i], hull[ni], hull[nj])) > \
                    abs(_net_cross(hull[i], hull[ni], hull[j])):
                j = nj
            else:
                break
        best = max(best, point_distance(hull[i], hull[j]), point_distance(hull[ni], hull[j]))
    return best


def cluster_diameter(points):
    """Largest distance between two of ``points`` (exact for any number of
    points: the farthest pair always lies on the convex hull)."""
    if len(points) < 2:
        return 0.0
    if len(points) <= NETWORK_EXACT_DIAMETER_MAX:
        return _net_pairwise_max(points)
    hull = _net_convex_hull(points)
    if len(hull) <= NETWORK_EXACT_DIAMETER_MAX:
        return _net_pairwise_max(hull)
    return _net_calipers(hull)


def _net_values_equal(a, b):
    """Attribute equality for pseudo-node fields (None equals None)."""
    if a is None or b is None:
        return a is None and b is None
    return a == b


def _net_nearest_within(index, p, radius, exclude=None):
    """``index.nearest(p, radius, exclude)``, found by searching 1, 4, 16, ... cells wide up to
    ``radius``. The answer is the same (the nearest segment within ``radius``, ties by smallest
    key): a hit found within a smaller radius ``r`` is the nearest of all, because every segment
    closer than it is within ``r`` too. Most free ends have a line close by, so a large T Distance
    no longer measures every segment in range."""
    r = index.cell
    while True:
        r = min(r, radius)
        hit = index.nearest(p, r, exclude)
        if hit is not None or r >= radius:
            return hit
        r *= 4.0


def network_index_cell(segments, tol=0.0):
    """Cell size of the search grid for the segments ``[(a, b), ...]`` (points are ``a == b``).

    The mean segment length, used before, is pulled up by a few long segments (300 undensified
    50 km lines beside a 10 m town grid gave a cell of about 1.5 km, so each search near the town
    measured thousands of segments) and the cell around one node of many converging segments (a
    star) held all of them. The cell is now the smaller of the median segment length and the
    spacing of the segments over their extent (sqrt(area / count), the area padded to at least
    one median length per side), but at least the budget floor
    (``NETWORK_INDEX_ENTRIES_PER_SEGMENT``), ``tol`` and 1e-9. Only the speed depends on the cell;
    the nearest-segment answers do not."""
    lengths, count = [], 0
    box = None
    for a, b in segments:
        count += 1
        d = point_distance(a, b)
        if d > 0 and math.isfinite(d):
            lengths.append(d)
        for x, y in (a, b):
            box = (x, y, x, y) if box is None else (min(box[0], x), min(box[1], y),
                                                    max(box[2], x), max(box[3], y))
    floor = max(float(tol or 0.0), 1e-9)
    if not count:
        return max(floor, 1.0)
    if not lengths:
        # Points only: their spacing over the extent.
        w, h = box[2] - box[0], box[3] - box[1]
        side = max(w, h)
        if not side > 0:
            return max(floor, 1.0)
        return max(math.sqrt(max(w, side / count) * max(h, side / count) / count), floor)
    lengths.sort()
    median = lengths[len(lengths) // 2]
    w, h = box[2] - box[0], box[3] - box[1]
    spacing = math.sqrt(max(w, median) * max(h, median) / count)
    budget = 2.0 * sum(lengths) / (NETWORK_INDEX_ENTRIES_PER_SEGMENT * count)
    return max(min(median, spacing), budget, floor)


class NetworkSegmentIndex(object):
    """Nearest-segment search over segments of very different lengths.

    ``items``: ``[(key, a, b), ...]``. The segments are grouped by length class (class 0 up to
    4 x the median length, then one class per factor of 4), and each class gets its own
    ``AnalysisSegmentIndex`` with a cell from ``network_index_cell``. One grid for all made a few
    long segments either inflate the cell (every query near short segments measured thousands of
    them) or, with a small cell, fill millions of grid entries. ``nearest`` asks every class and
    keeps the nearest hit (ties: smallest key), so the answer is the one a single index gives.
    """

    def __init__(self, items, tol=0.0):
        items = list(items)
        lengths = sorted(d for d in (point_distance(a, b) for _k, a, b in items)
                         if d > 0 and math.isfinite(d))
        median = lengths[len(lengths) // 2] if lengths else 0.0
        groups = {}
        for key, a, b in items:
            d = point_distance(a, b)
            if median > 0 and d > 4.0 * median:
                cls = max(1, int(math.floor(math.log(d / median, 4.0))))
            else:
                cls = 0
            groups.setdefault(cls, []).append((key, a, b))
        self.parts = []
        for cls in sorted(groups):
            members = groups[cls]
            index = AnalysisSegmentIndex(network_index_cell([(a, b) for _k, a, b in members], tol))
            for key, a, b in members:
                index.add(key, a, b)
            self.parts.append(index)
        self.cell = min(part.cell for part in self.parts) if self.parts else max(tol, 1e-9)

    def __len__(self):
        return sum(len(part) for part in self.parts)

    def nearest(self, p, radius=None, exclude=None):
        best = None
        for part in self.parts:
            hit = part.nearest(p, radius, exclude)
            if hit is not None and (best is None or (hit[0], hit[1]) < (best[0], best[1])):
                best = hit
        return best


def network_extent_texts(box):
    """``(xmin, xmax, ymin, ymax)`` of ``box`` ``(xmin, ymin, xmax, ymax)`` as texts for a message:
    6 decimals (about 0.1 m in degrees), more when the two ends of a range would print the same
    although they differ, else the shortest exact form. With ``.6g`` lines 0.00003 degrees (about
    3 m) high printed "Y 24.7 to 24.7"."""
    def pair(lo, hi):
        lo, hi = float(lo), float(hi)
        for decimals in range(6, 16):
            a, b = "{0:.{1}f}".format(lo, decimals), "{0:.{1}f}".format(hi, decimals)
            if lo == hi or a != b:
                return _net_trim(a), _net_trim(b)
        return repr(lo), repr(hi)
    x = pair(box[0], box[2])
    y = pair(box[1], box[3])
    return x[0], x[1], y[0], y[1]


def _net_trim(text):
    """``"24.700000"`` -> ``"24.7"``, ``"46.000000"`` -> ``"46"``, ``"-0.000000"`` -> ``"0"``."""
    if "." in text:
        text = text.rstrip("0").rstrip(".")
    return "0" if text in ("-0", "") else text


def network_skipped_fields_text(names):
    """Warning for input fields that are not copied to the line copy because the copy writes a
    field of that name (SRC_OID, COMPONENT_ID, COMP_LINES, COMP_LENGTH_M), as when the tool runs on
    its own earlier line copy."""
    names = list(names)
    text = ("Input field(s) not copied because the output uses the name: {0}. The line copy "
            "holds the values of this run under these names.".format(", ".join(names)))
    if any(n.casefold() == "src_oid" for n in names):
        text += (" The input's SRC_OID (for example the ObjectIDs of the original lines in an "
                 "earlier line copy) is not kept: SRC_OID now holds the ObjectIDs of this input. "
                 "To keep the old values, copy them to a field of another name first (Add Field "
                 "and Calculate Field).")
    return text


def network_degree_like(rows):
    """``(xmin, ymin, xmax, ymax)`` when the lines ``rows`` (``{"shape": paths}``) have at least one
    finite coordinate and every coordinate lies within -180..180 (X) and -90..90 (Y), as longitude
    and latitude in degrees do; else ``None``. Used for an input whose coordinate system is unknown
    (a shapefile without a .prj): there the tolerance would be applied in degrees."""
    box = None
    for row in rows:
        for path in row.get("shape") or ():
            for pt in path:
                x, y = float(pt[0]), float(pt[1])
                if not (math.isfinite(x) and math.isfinite(y)):
                    return None
                if not (-180.0 <= x <= 180.0 and -90.0 <= y <= 90.0):
                    return None
                box = (x, y, x, y) if box is None else (min(box[0], x), min(box[1], y),
                                                        max(box[2], x), max(box[3], y))
    return box


def _net_collapsed(path, length, tol):
    """True when the part ``path`` (its two ends in one node) shows a too large tolerance: its
    ends differ and it is at most 2 x ``tol`` long, or its ends are farther apart than ``tol``."""
    first, last = tuple(path[0]), tuple(path[-1])
    if first == last:
        return False
    return length <= 2.0 * network_within(tol) or point_distance(first, last) > network_within(tol)


def analyse_network(lines, tolerance_m=0.001, checks=NETWORK_DEFAULT_CHECKS, attrs=None,
                    t_distance_m=0.0, exempt_points=(), rule_points=(), point_rule="ON_LINE",
                    meters_per_unit=1.0, want_components=None, lengths_m=None):
    """Run the network checks.

    ``lines``: ``[(oid, paths), ...]`` (paths may be ``None``).
    ``attrs``: ``{oid: tuple}`` of pseudo-node field values; ``None`` = no
    attribute condition (every pseudo-node is reported).
    ``exempt_points``: ``[(x, y), ...]`` where a dangle is allowed.
    ``rule_points``: ``[(oid, (x, y) or None), ...]`` checked with
    ``point_rule`` when POINT_RULE is in ``checks``.
    ``want_components`` (default: COMPONENTS in checks) computes component ids.
    ``lengths_m``: optional ``{oid: length in metres}`` measured elsewhere (e.g. each
    line on its own projection for wide or polar data), used for the component
    lengths instead of the lengths in this plane.

    Returns ``{"errors", "components", "zero_length", "null_geometry",
    "node_count", "edge_count", "component_count", "rule_points_checked",
    "null_rule_points"}``. Error dicts have ``rule, role, oid, node_id,
    degree, value, detail, point`` (``role`` is ``"lines"`` or ``"points"``;
    ``node_id`` is 1-based). ``components`` maps a line OID to
    ``(component_id, line_count, length_m)``; components are numbered 1, 2,
    ... by their lowest OID.
    """
    checks = set(c.upper() for c in checks)
    mpu = float(meters_per_unit or 1.0)
    if not (math.isfinite(mpu) and mpu > 0):
        raise ValueError("meters_per_unit must be a finite number above 0")
    for label, value in (("The Snap Tolerance", tolerance_m), ("The T Distance", t_distance_m)):
        problem = network_distance_problem(label, value)
        if problem:
            raise ValueError(problem)
    tol = max(float(tolerance_m or 0.0), 0.0) / mpu
    t_dist = max(float(t_distance_m or 0.0), 0.0) / mpu
    if not (math.isfinite(tol) and math.isfinite(t_dist)):
        raise ValueError("The Snap Tolerance or T Distance is too large for the map units "
                         "of this coordinate system.")
    if want_components is None:
        want_components = "COMPONENTS" in checks

    clean, zero_length, null_geometry = [], [], []
    for oid, paths in lines:
        if not paths:
            null_geometry.append(oid)
            continue
        good = [[tuple(p) for p in path] for path in paths
                if len(path) >= 2 and path_length(path) > 0.0]
        if len(good) < len(paths):
            zero_length.append(oid)
        if good:
            clean.append((oid, good))
    parts_of = dict(clean)
    within = network_within(tol)
    graph = build_line_graph(clean, within)
    nodes, edges = graph["nodes"], graph["edges"]

    # End points of every node, from the edges (the graph keeps only the first).
    members = [[] for _n in nodes]
    for e in edges:
        path = parts_of[e["key"]][e["part"]]
        members[e["from"]].append(path[0])
        members[e["to"]].append(path[-1])

    errors = []

    def add(rule, role, oid, node, degree, value, detail, point):
        errors.append({"rule": rule, "role": role, "oid": oid,
                       "node_id": None if node is None else node + 1, "degree": degree,
                       "value": value, "detail": detail, "point": point})

    # Wide clusters (always reported: they mean the tolerance chained points).
    for n in nodes:
        pts = members[n["id"]]
        if len(pts) < 2:
            continue
        diameter = cluster_diameter(pts)
        if diameter > within:
            oids = sorted(set(edges[e]["key"] for e, _s in n["ends"]))
            add("WIDE_NODE_CLUSTER", NETWORK_LINES, oids[0], n["id"], n["degree"],
                diameter * mpu,
                "{0} end points within the tolerance of each other were merged into one "
                "node, but they span {1:.6g} m (more than the tolerance). Lines: OID {2}.".format(
                    len(pts), diameter * mpu, analysis_oid_text(oids, NETWORK_DETAIL_MAX_OIDS)),
                n["xy"])

    # Dangles.
    exempt_index = None
    if exempt_points:
        exempt_index = AnalysisSegmentIndex(max(within, 1e-9) * 4 or 1.0)
        for i, p in enumerate(exempt_points):
            exempt_index.add(i, p, p)
    dangles = []
    for n in nodes:
        if n["degree"] != 1:
            continue
        edge = edges[n["ends"][0][0]]
        exempt = exempt_index is not None and exempt_index.nearest(n["xy"], within) is not None
        dangles.append((n, edge, exempt))
        if "DANGLE" in checks and not exempt:
            add("DANGLE", NETWORK_LINES, edge["key"], n["id"], 1, None,
                "Free end of line OID {0}.".format(edge["key"]), n["xy"])

    # Pseudo-nodes.
    if "PSEUDO_NODE" in checks:
        pseudo = find_pseudo_nodes(graph)
        # The same two lines can share an end at more than one node (a two-line ring, or two
        # duplicate lines): "meet only here" would then be false. The other shared node can be any
        # node, also one where a third line ends (a duplicate road with a side road at one end, a
        # ring with a spur), so the shared nodes are taken from every node of the two lines, not
        # only from the pseudo-nodes. Each line has at most 2 nodes per part, so this stays linear.
        nodes_of_key = {}
        for e in edges:
            nodes_of_key.setdefault(e["key"], set()).update((e["from"], e["to"]))

        def nodes_of_pair(k1, k2):
            return sorted(nid + 1 for nid in nodes_of_key.get(k1, set()) & nodes_of_key.get(k2, set()))
        for n, e1, e2 in pseudo:
            k1, k2 = sorted((e1["key"], e2["key"]))
            if attrs is not None:
                v1, v2 = attrs.get(k1), attrs.get(k2)
                if v1 is None or v2 is None or len(v1) != len(v2) or not all(
                        _net_values_equal(a, b) for a, b in zip(v1, v2)):
                    continue
            if k1 == k2:
                continue        # two parts of one multipart line: not two features (spec)
            others = [nid for nid in nodes_of_pair(k1, k2) if nid != n["id"] + 1]
            if others:
                detail = ("Lines OID {0} and {1} meet end to end here and also at node {2} (a "
                          "two-line ring or duplicate lines); check them before merging.".format(
                              k1, k2, ", ".join(str(nid) for nid in others[:NETWORK_DETAIL_MAX_OIDS])
                              + ("" if len(others) <= NETWORK_DETAIL_MAX_OIDS else
                                 " ({0} more)".format(len(others) - NETWORK_DETAIL_MAX_OIDS))))
            else:
                detail = "Lines OID {0} and {1} meet only here and could be merged.".format(k1, k2)
            add("PSEUDO_NODE", NETWORK_LINES, k1, n["id"], 2, None, detail, n["xy"])

    seg_index = None
    need_t = "T_MISS" in checks and t_dist > 0
    need_points = "POINT_RULE" in checks and rule_points
    # Unsplit T-junctions: a non-exempt dangle that lies ON another line (within the snap
    # tolerance) is not a real dead end; its line meets a line that was not split there.
    # Counted whenever DANGLE, PSEUDO_NODE or the components are wanted: a
    # COMPONENTS-only run on unsplit lines would otherwise give wrong islands with no word.
    need_unsplit = (("DANGLE" in checks or "PSEUDO_NODE" in checks or want_components)
                    and any(not ex for _n, _e, ex in dangles))
    if need_t or need_unsplit or (need_points and point_rule == "ON_LINE"):
        # The cell follows the segments, not the T Distance: a cell as wide as a large T Distance
        # held thousands of segments, and every T_MISS query measured all of them (3,000 lines at
        # a T Distance of 500 m took 90 s). The search widens instead (_net_nearest_within).
        # Segments are grouped by length, each group with a cell from its median length and
        # spacing (NetworkSegmentIndex), so a few long segments no longer slow every search.
        seg_index = NetworkSegmentIndex(
            [((oid, pi, si), path[si], path[si + 1]) for oid, paths in clean
             for pi, path in enumerate(paths) for si in range(len(path) - 1)], tol)

    unsplit = []
    if need_unsplit:
        for n, edge, exempt in dangles:
            if exempt:
                continue
            own = edge["key"]
            hit = seg_index.nearest(n["xy"], network_on_line_within(tol),
                                    exclude=lambda key, own=own: key[0] == own)
            if hit is not None:
                unsplit.append((own, n["id"] + 1, hit[0] * mpu, hit[1][0]))
    # Mark the DANGLE rows of these ends (they were added above with the plain text): on unsplit data
    # (OSM, Overture) most DANGLE rows are such ends, and without a mark they could not be told apart
    # from real dead ends row by row. RULE, VALUE and the row count stay as they were.
    unsplit_marked = 0
    if unsplit and "DANGLE" in checks:
        on_line = dict(((own, node_id), (d, other)) for own, node_id, d, other in unsplit)
        for e in errors:
            if e["rule"] != "DANGLE":
                continue
            found = on_line.get((e["oid"], e["node_id"]))
            if found is None:
                continue
            e["detail"] = network_unsplit_detail(e["oid"], found[1], found[0])
            unsplit_marked += 1

    # T-misses: a dangle close to another line's segment. Lines that already meet the dangle's
    # line at the other end of its part are joined to it: when that part is not longer than the
    # T Distance, its free end is within the T Distance of them by construction (a short stub on a
    # road), so they are not searched; when the part is longer (a hook that comes back), such a
    # line can still be the nearest, and the text says that the two lines already meet.
    if need_t:
        for n, edge, exempt in dangles:
            if exempt:
                continue
            own = edge["key"]
            other = edge["to"] if edge["from"] == n["id"] else edge["from"]
            joined = set(edges[eid]["key"] for eid, _s in nodes[other]["ends"]) - set([own])
            skip = joined if edge["length"] <= t_dist else set()
            hit = _net_nearest_within(seg_index, n["xy"], network_within(t_dist),
                                      lambda key, own=own, skip=skip: key[0] == own
                                      or key[0] in skip)
            if hit is None:
                continue
            if hit[1][0] in joined:
                detail = ("Free end of line OID {0} is {1:.6g} m from line OID {2}, which it "
                          "already meets at its other end; check whether this end should meet "
                          "it too.".format(own, hit[0] * mpu, hit[1][0]))
            else:
                detail = ("Free end of line OID {0} is {1:.6g} m from line OID {2} but not "
                          "connected to it.".format(own, hit[0] * mpu, hit[1][0]))
            add("T_MISS", NETWORK_LINES, own, n["id"], 1, hit[0] * mpu, detail, n["xy"])

    # Point rules.
    checked = 0
    null_points = []
    if need_points:
        if point_rule == "ON_ENDPOINT":
            end_index = None
            all_ends = [p for pts in members for p in pts]
            if all_ends:
                # The cell is the smaller of the median line-part length (the usual distance
                # between the two ends of a part) and the spacing of the ends over their extent;
                # the mean part length let a few long lines put a whole town in one cell.
                part_lengths_now = sorted(e["length"] for e in edges)
                end_cell = min(part_lengths_now[len(part_lengths_now) // 2],
                               network_index_cell([(p, p) for p in all_ends]))
                end_index = AnalysisSegmentIndex(max(within * 4, end_cell, 1e-9))
                for i, p in enumerate(all_ends):
                    end_index.add(i, p, p)
            index, rule, what = end_index, "POINT_NOT_ON_ENDPOINT", "line end"
            limit = within
        else:
            index, rule, what = seg_index, "POINT_NOT_ON_LINE", "line"
            limit = network_on_line_within(tol)
        for oid, p in rule_points:
            if p is None:
                null_points.append(oid)
                continue
            checked += 1
            hit = index.nearest(p) if index is not None and len(index) else None
            if hit is not None and hit[0] <= limit:
                continue
            if hit is None:
                add(rule, NETWORK_POINTS, oid, None, None, None,
                    "Point OID {0}: there is no {1} to check against.".format(oid, what), p)
            else:
                add(rule, NETWORK_POINTS, oid, None, None, hit[0] * mpu,
                    "Point OID {0} is {1:.6g} m from the nearest {2} (tolerance {3:.6g} m)."
                    .format(oid, hit[0] * mpu, what, tol * mpu), p)

    components = {}
    comps = connected_components(graph, join_parts=True) if want_components else []
    if want_components:
        length_of = dict((oid, sum(path_length(p) for p in paths) * mpu)
                         for oid, paths in clean)
        if lengths_m:
            length_of.update((k, v) for k, v in lengths_m.items() if k in length_of)
        ordered = sorted(comps, key=lambda c: min(c["keys"]))
        for number, comp in enumerate(ordered, 1):
            total = sum(length_of[k] for k in comp["keys"])
            for k in comp["keys"]:
                components[k] = (number, len(comp["keys"]), total)

    # Tolerance sanity: a line part whose two distinct ends fall into one node points to a snap
    # tolerance that is too large for the data, but only when the part is short compared with the
    # tolerance (at most 2 x tolerance long) or its ends were joined through a chain (farther apart
    # than the tolerance). A long, nearly closed ring (a roundabout whose ends are 1 mm apart) is
    # closed correctly by the tolerance and is not counted.
    collapsed = sorted(set(e["key"] for e in edges if e["closed"] and _net_collapsed(
        parts_of[e["key"]][e["part"]], e["length"], tol)))
    part_lengths = sorted(e["length"] for e in edges)
    median_m = part_lengths[len(part_lengths) // 2] * mpu if part_lengths else None

    order = dict((r, i) for i, r in enumerate(NETWORK_RULES))
    errors.sort(key=lambda e: (order[e["rule"]], e["role"] != NETWORK_LINES, e["oid"],
                               e["node_id"] or 0))
    return {"errors": errors, "components": components, "zero_length": zero_length,
            "null_geometry": null_geometry, "node_count": len(nodes), "edge_count": len(edges),
            "component_count": len(comps), "rule_points_checked": checked,
            "null_rule_points": null_points, "collapsed": collapsed,
            "dangle_count": sum(1 for _n, _e, ex in dangles if not ex), "unsplit_ends": unsplit,
            "dangle_checked": "DANGLE" in checks, "unsplit_marked": unsplit_marked,
            "median_part_length_m": median_m}


def _net_good_parts(paths):
    """Number of parts with at least two vertices, finite coordinates and a length."""
    count = 0
    for path in paths or ():
        if len(path) < 2:
            continue
        if not all(math.isfinite(c) for p in path for c in p[:2]):
            continue
        if path_length(path) > 0.0:
            count += 1
    return count


def antimeridian_crossings(rows):
    """OIDs of lines (``{"oid", "shape"}``, shape = list of paths of ``[lon, lat]`` in a
    geographic system) with a segment that crosses the +/-180 degree meridian: two consecutive
    vertices more than 180 degrees of longitude apart (the short way round crosses +/-180).
    ArcGIS Pro measured such a 2-vertex line the long way round (10,654,872.6 m instead of
    about 214 m) and reported false dangles; the tool refuses them."""
    bad = []
    for row in rows:
        for path in row.get("shape") or []:
            if any(abs(b[0] - a[0]) > 180.0 for a, b in zip(path, path[1:])):
                bad.append(row["oid"])
                break
    return bad


def unprojectable_lines(projected, source):
    """OIDs of lines that the projection to the measuring system destroyed.

    ``projected``: ``[(oid, paths or None)]`` as read in the measuring system;
    ``source``: ``{oid: paths or None}`` as read in the input's own system. A line
    is unprojectable when a projected coordinate is not finite, or when it has
    fewer usable parts (two or more finite vertices, length above 0) after
    projecting than in its own system (it collapsed or read empty). Lines that
    are already empty or zero-length in their own system are not listed: they
    stay NULL_GEOMETRY / ZERO_LENGTH_PART.
    """
    bad = []
    for oid, paths in projected:
        finite = all(math.isfinite(c) for path in (paths or ()) for p in path for c in p[:2])
        if not finite or _net_good_parts(paths) < _net_good_parts(source.get(oid)):
            bad.append(oid)
    return sorted(bad)


def tolerance_problem(result, tolerance_m, units_known=True):
    """Warning text when the snap tolerance is implausibly large, else ``None``.

    Large means: some line part has its two distinct ends merged into one node while it is at
    most 2 x tolerance long (or its ends were chained together from farther apart than the
    tolerance), or the tolerance is longer than the median line part. ``units_known`` False (the
    input's coordinate system is unknown): the tolerance was applied in the data's own units, so
    the fix is to define the coordinate system, not to "enter metres" (the user already did).
    """
    collapsed = result.get("collapsed") or []
    median = result.get("median_part_length_m")
    if not collapsed and not (median and tolerance_m > median):
        return None
    why = []
    if collapsed:
        why.append("{0} line(s) have both of their different ends merged into one node "
                   "(e.g. OID {1})".format(len(collapsed), ", ".join(
                       str(o) for o in collapsed[:5])))
    if median and tolerance_m > median:
        why.append("the tolerance is longer than the median line part ({0:.6g} m)".format(median))
    if not units_known:
        fix = ("Fix: the coordinate system of the input is unknown, so the tolerance was applied "
               "in the data's own units, which may not be metres. Define the coordinate system "
               "of the input (Define Projection tool) and run the tool again.")
    else:
        fix = ("Fix: enter the tolerance in metres, typically a few millimetres to "
               "centimetres.")
    return ("The Snap Tolerance of {0:g} m is too large for these lines: {1}. Nodes, dangles "
            "and components are not reliable. {2}".format(tolerance_m, "; ".join(why), fix))


# The licence route for splitting lines at their junctions. Esri pages read
# 2026-10-30: Split Line At Point is Advanced only; Feature To Line is Standard or Advanced; the
# Planarize edit tool needs Standard or Advanced. The Split edit tool page names no licence level
# (INFERENCE: core editing, available on Basic). Read again 2026-11-08: Feature To Line (3.5 tool page,
# Licensing: Basic No, Standard Yes, Advanced Yes); Planarize ("Available with Standard or Advanced
# license", 3.1 editing page); "Split a feature" (Modify Features > Split; latest page, no licence
# stated); the 3.4 licence-levels page: "Core functionality is available with a Basic license" and the
# Editing toolbox has no geoprocessing tool at Basic. So on Basic no geoprocessing tool splits lines at
# their junctions; the Split edit tool does it by hand, one line at a time.
NETWORK_SPLIT_FIX = ("Fix: split the lines at their junctions first, then run this tool again. "
                     "Split Line At Point needs an Advanced licence; Feature To Line and the "
                     "Planarize edit tool need Standard or Advanced; on Basic, split the lines by "
                     "hand with the Split edit tool (Modify Features).")


def unsplit_problem(result):
    """Message ``(text, is_warning)`` when free line ends lie on the interior of another line
    (lines not split at the junction), else ``None``.

    Such an end is reported as a DANGLE (when DANGLE is checked) and the two lines fall into
    different components, which for a network that is merely not split at its junctions is
    mostly noise. It is a warning when at least 3 ends are affected and they are at least 5 % of
    the free ends, else a plain message.
    """
    ends = result.get("unsplit_ends") or []
    if not ends:
        return None
    total = result.get("dangle_count") or len(ends)
    # Each OID once: both ends of one line can lie on other lines ("first: OID 7352, OID 7352").
    unique = []
    for o, _n, _d, _t in ends:
        if o not in unique:
            unique.append(o)
            if len(unique) == 5:
                break
    first = ", ".join("OID {0}".format(o) for o in unique)
    if result.get("dangle_checked", True):
        text = ("{0} of {1} dangle(s) are a line end that lies on another line (within the snap "
                "tolerance), not a dead end (first: {2}). Their lines are probably not split where "
                "the other line passes, so each is reported as a DANGLE and the lines fall into "
                "separate components. {3}".format(len(ends), total, first, NETWORK_SPLIT_FIX))
        marked = result.get("unsplit_marked")
        if marked:
            text += (" The DETAIL of these {0} DANGLE row(s) says {1}: select them with DETAIL LIKE "
                     "'%{1}%', and the other DANGLE rows (ends that lie on no other line) with RULE = "
                     "'DANGLE' AND DETAIL NOT LIKE '%{1}%'.".format(marked, NETWORK_UNSPLIT_MARK))
    else:
        text = ("{0} of {1} free line end(s) lie on another line (within the snap tolerance), "
                "not a dead end (first: {2}). Their lines are probably not split where the other "
                "line passes, so they are NOT connected to it: the lines fall into separate "
                "components and the component IDs and counts are not reliable (DANGLE was not "
                "checked, so these ends have no error rows). {3}".format(
                    len(ends), total, first, NETWORK_SPLIT_FIX))
    return text, (len(ends) >= 3 and len(ends) * 20 >= total)


def network_renamed_fields_text(output, wanted, specs, already=()):
    """Warning text, or ``None``, when the output format stores a field of the tool under another
    name than the documented one.

    ``wanted``: the field names as documented/requested, in order; ``specs``: the planned output
    field specs of the same fields in the same order (their ``name`` is the name the output
    workspace will give, ``common.arcio.plan_output_fields``); ``already``: the (documented,
    new) pairs that were already announced (a clash rename), so they are not repeated.
    A shapefile or dBASE name is cut to 10 bytes (about 5 Arabic letters) (COMPONENT_ID -> COMPONENT_), and a
    geodatabase or GeoPackage may rename a reserved word; the values are in the renamed field.
    """
    done = set(tuple(pair) for pair in already)
    changed = [(a, s["name"]) for a, s in zip(wanted, specs)
               if a != s["name"] and (a, s["name"]) not in done]
    if not changed:
        return None
    one = len(changed) == 1
    return ("The output format stores {0} of '{1}' under {2}: {3}. The values are in the renamed "
            "{4}; the documentation of this tool uses the {5} it asked for.".format(
                "a field" if one else "fields", output,
                "another name" if one else "other names",
                ", ".join("{0} -> {1}".format(a, b) for a, b in changed),
                "field" if one else "fields", "name" if one else "names"))


def network_summary(result, checks, tolerance_m, line_count):
    """Summary rows ``(item, value)`` for the report."""
    rows = [("Lines read", line_count),
            ("Snap tolerance (m)", tolerance_m),
            ("Checks", ", ".join(checks)),
            ("Nodes", result["node_count"]),
            ("Line parts (edges)", result["edge_count"])]
    for rule in NETWORK_RULES:
        rows.append((rule, sum(1 for e in result["errors"] if e["rule"] == rule)))
        if rule == "DANGLE" and result.get("dangle_checked"):
            rows.append(("DANGLE marked UNSPLIT (end lies on another line)",
                         result.get("unsplit_marked") or 0))
    if result["component_count"]:
        rows.append(("Connected components", result["component_count"]))
    rows.append(("Lines with zero-length parts", len(result["zero_length"])))
    rows.append(("Lines without geometry", len(result["null_geometry"])))
    if result["rule_points_checked"] or result["null_rule_points"]:
        rows.append(("Rule points checked", result["rule_points_checked"]))
    return rows


# ==========================================================================
# analysis/vertex_core.py
# ==========================================================================
# Vertex Extractor (pure Python).
#
# Every vertex of a line part or polygon ring becomes one record with its
# position (index from the start and from the end), the distance along the
# part/ring in metres and the signed turning angle (left positive).
#
# * Lines: each path is one part (``part`` 1-based, ``ring`` None). A closed
#   polyline keeps its start and end vertex (it is a path, not a ring); the
#   turning angle is None at both ends of a path.
# * Polygons: rings are grouped into parts (outer ring + its holes, Esri
#   orientation); ``part`` is 1-based, ``ring`` 0-based within the part (0 =
#   outer ring). The closing vertex is not emitted twice; the angle at vertex
#   0 uses the last distinct vertex as its predecessor. A closing vertex that
#   is stored twice (ring ending ``... P0 P0``) is emitted once more, as the
#   last vertex, with an empty angle (like any duplicate vertex).
# * Turning angle: change of direction in degrees, (-180, 180], positive =
#   left turn. None where a neighbouring segment has zero length.
# * Index list ("0,-1,2"): negative indexes count from the end (-1 = last
#   vertex). Indexes outside a part/ring are skipped there and counted per requested index
#   (``tally`` of ``extract_vertices``; ``vertex_missing_messages`` words it as "Index 5 does not
#   exist in 1000 of 1000 ring(s)"); an index
#   given twice (or 0 and -n) gives one record. Separators: comma, semicolon,
#   space, and the Arabic comma / semicolon (U+060C, U+061B) as typed on an
#   Arabic keyboard; the minus sign may be U+2212. Arabic-Indic digits are
#   numbers too (Python ``int``). An item must be plain digits with an optional sign: "1_0" is refused, and
#   so is an item with leading zeros such as "000" (so "1,000" typed with a thousands separator is refused
#   instead of silently selecting vertices 1 and 0).
#   Invisible format characters (Unicode category Cf: right-to-left / left-to-right marks, the
#   Arabic letter mark U+061C, zero-width space, BOM, bidi isolates) that arrive when a list is
#   pasted from Arabic text are removed first; any other blank (no-break space, ...) separates.
#   A list such as "1,250" or "1 250" (a thousands separator, comma or one blank such as a no-break
#   space, with a leading group that does not start with 0) is still two indexes; ``vertex_list_thousands_hint`` returns a
#   warning for it. Only one such group gets the warning
#   ("10,200,300" would be an index of ten million, not a plausible vertex index; and "0,-1,100" is
#   three plain items, none of them glued to a thousands group). A leading group that starts with 0
#   ("0,100", "0 100", "-0,250", Arabic-Indic "٠,١٠٠") gets no warning: it is a plain list, and the
#   joined number ("0100") would be refused for its leading zeros.
#   A value that is not empty and not ALL but holds no number (",", ";", "،" or only invisible marks)
#   is refused instead of being read as ALL.

VERTEX_ALL = "ALL"
# A projected input is measured as is only when its scale at the data is close to 1
# and it keeps angles; otherwise (world systems such as Mollweide, Plate Carree, Robinson,
# or a regional system used far from its area) each feature is measured on its own
# Transverse Mercator. UTM inside its zone stays within 0.1 %; national conformal systems
# within a few tenths of a per cent.
VX_MAX_SCALE_ERROR = 0.005          # 0.5 %
VX_MAX_ANGLE_ERROR_DEG = 0.5
VX_PROBE_OFFSET_M = 100.0
# The probe covers the whole layer: its extent is cut into VX_PROBE_GRID x VX_PROBE_GRID cells
# and every cell with data is sampled (see vertex_probe_points).
VX_PROBE_GRID = 16
_VX_A = 6378137.0                   # WGS 84 ellipsoid: local radii for the scale probe
_VX_E2 = 6.69437999014e-3
# Everything that separates two indexes becomes ",": semicolon, space, tab, the Arabic comma
# and semicolon; U+2212 (minus sign, as pasted from a document) becomes "-".
_VERTEX_SEPARATORS = dict((ord(c), ",") for c in ";\t\u060c\u061b ")
_VERTEX_SEPARATORS[0x2212] = "-"
_VERTEX_TOKEN = re.compile(r"^[+-]?\d+$")
# "1,250" / "-1,250": one digit group that looks like a thousands separator, standing alone (not
# glued by a comma, digit or sign to another item: "0,-1,100" is the items 0, -1 and 100).
# Two or more groups ("10,200,300") would be an index of a million or more: no warning. A trailing
# comma with no item after it ("1,250,") does not glue the group to anything: warning.
_THOUSANDS_RUN = re.compile(r"(?<![\d,+\-])[+\-]?\d{1,3},\d{3}(?!\d)(?!,\s*[^\s,])")
# "1 250" (French / SI grouping, also with a no-break or narrow no-break space): the same, with one
# blank as the group separator. Not glued to another item by one comma or one blank on either side
# ("5 1 250" and "1 250 300" are lists, no warning). A tab or a line break separates items only.
_THOUSANDS_BLANK_RUN = re.compile(
    r"(?<![\d+\-])(?<!\d )(?<!\d,)[+\-]?\d{1,3} \d{3}(?!\d)(?![ ,][+\-]?\d)")


def _clean_vertex_text(text):
    """Drop invisible format characters (category Cf: RLM, LRM, U+061C, ZWSP, BOM, bidi
    isolates) and turn every other blank into a plain space."""
    out = []
    for ch in text:
        if unicodedata.category(ch) == "Cf":
            continue
        out.append(" " if ch.isspace() else ch)
    return "".join(out)


def _show_token(token):
    """The item as shown in a message: shortened, and with any character that cannot be
    seen written as its code point (U+XXXX)."""
    shown = token if len(token) <= 30 else token[:27] + "..."
    return "".join(ch if ch.isprintable() and not ch.isspace() else "U+{0:04X}".format(ord(ch))
                   for ch in shown)


def vertex_list_thousands_hint(text):
    """A warning (str) when the list contains a pattern such as "1,250" that may be one
    number typed with a thousands separator, else ``None``. The list is still read as
    separate indexes (vertices 1 and 250); this only says so."""
    if text is None:
        return None
    # A tab or a line break separates items, never digit groups: two blanks for the blank rule.
    raw = _clean_vertex_text("".join(
        "  " if ch.isspace() and unicodedata.category(ch) in ("Cc", "Zl", "Zp") else ch
        for ch in str(text)))
    found = []
    for pattern, sep, word in ((_THOUSANDS_RUN, ",", "comma"),
                               (_THOUSANDS_BLANK_RUN, " ", "space")):
        for match in pattern.finditer(raw):
            # No one writes a thousands number with a leading group of 0 ("0,100", "-0,250",
            # "٠,١٠٠", "05,100"): that is a plain list, and the suggested "0100" would be refused
            # for its leading zeros. Any script's zero digit counts (unicodedata.digit).
            if unicodedata.digit(match.group(0).lstrip("+-")[0], None) == 0:
                continue
            found.append((match.start(), match.group(0), sep, word))
            break
    if not found:
        return None
    _start, first, sep, word = min(found)
    return ("'{0}' is read as the separate indexes {1}. If you meant one number, write it "
            "without the {2} ({3}).".format(first, ", ".join(first.split(sep)), word,
                                            first.replace(sep, "")))


def parse_vertex_list(text):
    """``None`` for ALL (or empty), else a list of ints. ``ValueError`` on bad input."""
    if text is None:
        return None
    if not str(text).strip():
        return None                     # empty (or blanks only): ALL, the default
    raw = _clean_vertex_text(str(text)).strip()
    if raw.upper() == VERTEX_ALL:
        return None
    out, seen = [], set()   # a set, so a long list is not O(n^2) on each validation
    raw = raw.translate(_VERTEX_SEPARATORS)
    for token in raw.split(","):
        token = token.strip()
        if not token:
            continue
        shown = _show_token(token)
        # Plain digits only: int() also accepts "1_0" (10) and surrounding blanks.
        if not _VERTEX_TOKEN.match(token):
            raise ValueError("'{0}' is not a whole number".format(shown))
        digits = token.lstrip("+-")
        if len(digits) > 1 and int(digits[0]) == 0:
            # "1,000" typed as a thousands separator would silently select vertices 1 and 0
            plain = str(int(token))
            if len(digits) == 3:
                hint = ("write it as {0}; a comma separates two items, so a thousands "
                        "separator as in '1,000' cannot be used").format(plain)
            else:
                hint = "write it as {0}".format(plain)
            raise ValueError("'{0}' has leading zeros ({1})".format(shown, hint))
        value = int(token)
        if value not in seen:
            seen.add(value)
            out.append(value)
    if not out:
        # "," / ";" / "،" / only invisible marks must not run ALL without a word
        raise ValueError("the list holds no vertex index; leave it empty or write ALL for every "
                         "vertex")
    return out


def _vertex_ring_parts(rings):
    """Group polygon rings into parts with ring indexes:
    ``[[ring index of the outer, hole index, ...], ...]`` (``group_rings`` order)."""
    lookup = {}
    for i, ring in enumerate(rings):
        if len(ring) >= 3:
            lookup.setdefault(tuple(close_ring(ring)), []).append(i)
    parts = []
    for outer, holes in group_rings(rings):
        part = []
        for ring in [outer] + holes:
            part.append(lookup[tuple(ring)].pop(0))
        parts.append(part)
    return parts


class VertexCountMismatch(ValueError):
    """The copy of a feature read in the measuring system has another number of vertices than
    the feature in the input system (projection removed or added a vertex). Not a geometry
    error of the input: Repair Geometry does not cure it; projecting the input first does."""


def _vertex_records(pts, mpts, closed, indexes, mpu, missed=None):
    """Records for one path or ring (``pts`` in the source system, ``mpts`` in
    the measuring system, closing duplicate already removed for rings). ``missed``
    (a list) receives each requested index that does not exist in this path or ring."""
    n = len(pts)
    if n == 0:
        return [], 0
    if closed:
        # ``mpts`` is already open: close it again so path_vertex_angles strips
        # exactly that one copy. A closing vertex stored twice (ring ending
        # ... P0 P0) then stays a vertex of its own, with an empty angle.
        angles = path_vertex_angles(mpts + mpts[:1], closed=True, signed=True) if n >= 2 \
            else [None] * n
    else:
        angles = path_vertex_angles(mpts, closed=False, signed=True) if n >= 2 else [None] * n
    if len(angles) != n or len(mpts) != n:
        raise VertexCountMismatch("the measured part or ring has {0} vertices, the source {1}".format(
            len(mpts), n))
    if closed and n < 3:
        angles = [None] * n
    dist = [0.0]
    for i in range(1, n):
        dist.append(dist[-1] + point_distance(mpts[i - 1], mpts[i]))
    if indexes is None:
        wanted, missing = list(range(n)), 0
    else:
        chosen = set()
        missing = 0
        for k in indexes:
            if -n <= k < n:
                chosen.add(k % n)
            else:
                missing += 1
                if missed is not None:
                    missed.append(k)
        wanted = sorted(chosen)
    records = [{"idx": i, "idx_neg": i - n, "dist_m": dist[i] * mpu, "turn": angles[i],
                "x": pts[i][0], "y": pts[i][1]} for i in wanted]
    return records, missing


def extract_vertices(kind, geom, metric_geom=None, indexes=None, meters_per_unit=1.0, tally=None):
    """Vertex records of one feature.

    ``kind`` is ``"polyline"`` or ``"polygon"``; ``geom`` is in the source
    system (X/Y of the records), ``metric_geom`` the same feature in the
    measuring system (distances and angles; defaults to ``geom``). Returns
    ``(records, skipped_indexes)``; records carry ``part, ring, idx, idx_neg,
    dist_m, turn, x, y``. ``skipped_indexes`` adds up the misses of every part
    or ring (one requested index missing from 3 rings counts 3).

    ``tally`` (a dict, optional) is updated only when the feature is read without
    error: ``tally["units"]`` += the number of parts (lines) or rings (polygons,
    outer rings and holes) that hold a vertex, and ``tally["missing"][k]`` += the
    number of those in which the requested index ``k`` does not exist.
    """
    if geom is None:
        return [], 0
    if metric_geom is None:
        metric_geom = geom
    mpu = float(meters_per_unit or 1.0)
    out, skipped, units, missed = [], 0, 0, []
    if kind == "polyline":
        for pi, path in enumerate(geom):
            pts = [tuple(p) for p in path]
            recs, miss = _vertex_records(pts, [tuple(p) for p in metric_geom[pi]], False, indexes,
                                         mpu, missed)
            skipped += miss
            units += 1 if pts else 0
            for r in recs:
                r["part"], r["ring"] = pi + 1, None
                out.append(r)
    elif kind == "polygon":
        for pi, ring_ids in enumerate(_vertex_ring_parts(geom)):
            for ri, rid in enumerate(ring_ids):
                pts = [tuple(p) for p in close_ring(geom[rid])][:-1]
                mpts = [tuple(p) for p in close_ring(metric_geom[rid])][:-1]
                recs, miss = _vertex_records(pts, mpts, True, indexes, mpu, missed)
                skipped += miss
                units += 1 if pts else 0
                for r in recs:
                    r["part"], r["ring"] = pi + 1, ri
                    out.append(r)
    else:
        raise ValueError("kind must be 'polyline' or 'polygon'")
    if tally is not None:
        tally["units"] = tally.get("units", 0) + units
        per = tally.setdefault("missing", {})
        for k in missed:
            per[k] = per.get(k, 0) + 1
    return out, skipped


VX_MISSING_LINES = 10


def vertex_missing_messages(tally, kind, indexes, limit=VX_MISSING_LINES):
    """Message lines for the requested indexes that do not exist in some part or ring:
    one line per such index, in the order of the list (``indexes``), at most ``limit``
    lines plus one line that counts the rest. ``tally`` as filled by ``extract_vertices``."""
    per = (tally or {}).get("missing") or {}
    total = (tally or {}).get("units", 0)
    unit = "ring(s)" if kind == "polygon" else "part(s)"
    lines = []
    shown = [k for k in (indexes or []) if per.get(k)]
    for k in shown[:limit]:
        lines.append("Index {0} does not exist in {1} of {2} {3}; it was skipped there.".format(
            k, per[k], total, unit))
    rest = shown[limit:]
    if rest:
        lines.append("{0} more requested index(es) do not exist in some {1} and were skipped "
                     "there: {2}{3}.".format(len(rest), unit, ", ".join(str(k) for k in rest[:20]),
                                             ", ..." if len(rest) > 20 else ""))
    return lines


def _vx_ground_vector(p, q):
    """East and north components in metres of the short step from ``p`` to ``q`` (both
    (lon, lat) in degrees), from the local radii of the WGS 84 ellipsoid."""
    lat = math.radians((p[1] + q[1]) / 2.0)
    w = math.sqrt(1.0 - _VX_E2 * math.sin(lat) ** 2)
    n_radius = _VX_A / w
    m_radius = _VX_A * (1.0 - _VX_E2) / w ** 3
    dlon = (q[0] - p[0] + 180.0) % 360.0 - 180.0
    return (math.radians(dlon) * n_radius * math.cos(lat), math.radians(q[1] - p[1]) * m_radius)


def vertex_scale_distortion(samples):
    """How far a projected system is from measuring true metres at the data.

    ``samples``: ``[(p, px, py, d_m), ...]`` where ``p`` is a sample point and ``px`` / ``py``
    the points ``d_m`` metres (in the system's own units times metres per unit) east / north
    of it in the projected system, all three projected back to geographic (lon, lat) degrees.
    Returns ``None`` when no sample is usable, else ``{"scale_min", "scale_max",
    "angle_error_deg", "samples"}``: the smallest and largest ground length of one system
    metre, and the largest departure from a right angle between the system's two axes on
    the ground (0 in a conformal system).
    """
    kmin = kmax = None
    angle_max = 0.0
    used = 0
    for p, px, py, d_m in samples:
        values = [v for pt in (p, px, py) for v in pt]
        if not all(isinstance(v, (int, float)) and math.isfinite(v) for v in values) \
                or not d_m or abs(p[1]) > 89.0:
            continue
        ex = _vx_ground_vector(p, px)
        ny = _vx_ground_vector(p, py)
        kx = math.hypot(ex[0], ex[1]) / d_m
        ky = math.hypot(ny[0], ny[1]) / d_m
        if kx <= 0.0 or ky <= 0.0:
            continue
        angle = math.degrees(math.atan2(abs(ex[0] * ny[1] - ex[1] * ny[0]),
                                        ex[0] * ny[0] + ex[1] * ny[1]))
        used += 1
        kmin = min(kx, ky) if kmin is None else min(kmin, kx, ky)
        kmax = max(kx, ky) if kmax is None else max(kmax, kx, ky)
        angle_max = max(angle_max, abs(90.0 - angle))
    if not used:
        return None
    return {"scale_min": kmin, "scale_max": kmax, "angle_error_deg": angle_max, "samples": used}


def vertex_distortion_too_large(distortion):
    """True when ``vertex_scale_distortion`` says lengths or angles in the system are off by
    more than ``VX_MAX_SCALE_ERROR`` / ``VX_MAX_ANGLE_ERROR_DEG``."""
    if not distortion:
        return False
    return (abs(distortion["scale_min"] - 1.0) > VX_MAX_SCALE_ERROR
            or abs(distortion["scale_max"] - 1.0) > VX_MAX_SCALE_ERROR
            or distortion["angle_error_deg"] > VX_MAX_ANGLE_ERROR_DEG)


def vertex_probe_points(shapes, grid=VX_PROBE_GRID):
    """Sample vertices ``(x, y)`` at which a projected input system is tested.

    The extent of all the vertices of all parts of ``shapes`` (core geometries) is cut into
    ``grid`` x ``grid`` cells, and in every cell that holds a vertex the vertices with the
    smallest and largest x and y are kept (at most ``4 * grid * grid`` points). So every
    feature is covered, wherever it is stored in the layer: a few features far from the
    others (wrong-zone data mixed in, outlying islands of a national grid) get samples of
    their own, and the extremes of the data in x and y (where the scale error of a
    projection is largest) are always among the samples. Non-finite coordinates are left
    out."""
    cells = {}
    xmin = ymin = float("inf")
    xmax = ymax = float("-inf")
    pts = []
    for shape in shapes or ():
        for part in shape or ():
            for pt in part or ():
                try:
                    x, y = float(pt[0]), float(pt[1])
                except (TypeError, ValueError, IndexError):
                    continue
                if not (math.isfinite(x) and math.isfinite(y)):
                    continue
                pts.append((x, y))
                xmin, xmax = min(xmin, x), max(xmax, x)
                ymin, ymax = min(ymin, y), max(ymax, y)
    if not pts:
        return []
    grid = max(1, int(grid))
    width = (xmax - xmin) or 1.0
    height = (ymax - ymin) or 1.0
    order = []
    for x, y in pts:
        key = (min(grid - 1, int((x - xmin) / width * grid)),
               min(grid - 1, int((y - ymin) / height * grid)))
        cell = cells.get(key)
        if cell is None:
            cells[key] = [(x, y), (x, y), (x, y), (x, y)]
            order.append(key)
            continue
        if x < cell[0][0]:
            cell[0] = (x, y)
        if x > cell[1][0]:
            cell[1] = (x, y)
        if y < cell[2][1]:
            cell[2] = (x, y)
        if y > cell[3][1]:
            cell[3] = (x, y)
    out, seen = [], set()
    for key in order:
        for pt in cells[key]:
            if pt not in seen:
                seen.add(pt)
                out.append(pt)
    return out


# ==========================================================================
# analysis/thiessen_core.py
# ==========================================================================
# Thiessen (Voronoi) polygons inside a convex clip polygon (pure Python).
#
# Each site's cell is built by **half-plane clipping**: start from the convex
# clip polygon and cut it with the perpendicular bisector between the site and
# each neighbouring site, nearest neighbours first (from a k-d tree). Then only
# sites that are nearer than the own site to a vertex of the cell can still cut
# it; exactly those are clipped (see ``voronoi_cells``). No Delaunay triangulation and no extra library are needed, and
# co-circular or collinear sites need no special handling: the cell of a site
# is exactly the part of the clip polygon closer to it than to any other site.
#
# Coordinates are shifted to the centre of the clip polygon before clipping
# (precision far from the origin) and shifted back afterwards.
#
# Duplicate sites (identical coordinates) are merged first: the lowest ObjectID
# keeps the cell and DUP_COUNT counts all of them. With a merge distance (the tool passes ten
# times the XY tolerance of the output it created, 3.5 times in an unknown coordinate system,
# ``thiessen_merge_distance``), distinct sites closer than it to a kept site with a lower ObjectID
# are merged the same way (``merge_near_sites``): ArcGIS Pro rounds
# the stored vertices to the output's XY resolution and cleans the polygon with its XY tolerance,
# which empties the cells of points that close (R8-D1, R9-D1).

THIESSEN_DEFAULT_EXPAND_PCT = 10.0

# A default clip box (no Clip Extent / Clip Features) narrower than this fraction of its
# length is reported: points almost on one straight line give a box of slivers (R4-3).
THIESSEN_THIN_RATIO = 1e-3

# The duplicate warning lists at most this many groups, and at most this many merged
# OIDs inside each group (a geocoded pile of thousands of points flooded it, R4-2).
THIESSEN_DUP_GROUPS_SHOWN = 20
THIESSEN_DUP_OIDS_SHOWN = 20

# A clip polygon counts as convex when no vertex lies deeper inside its convex hull
# than this fraction of its size (largest side of its bounding box) or the caller's
# absolute floor (coordinates rounded to the geodatabase resolution), whichever is
# larger; it is then replaced by that hull (``common.clip.near_convex_ring``).
THIESSEN_CONVEX_REL_TOL = 1e-6

# Expand % above this is refused: the default box would be more than 10,000 times the
# points' extent and the cells far from the points lose precision (1e9 % gave a tiling
# 0.25 % off, R7 O3). A clip larger than THIESSEN_MAX_CLIP_M on its longer side (in
# metres; 1e8 m is 2.5 times the Earth's circumference) is refused for the same reason.
THIESSEN_MAX_EXPAND_PCT = 1e6
THIESSEN_MAX_CLIP_M = 1e8

# SITE_OID field type: ``common.arcio.oid_field_spec`` (the toolkit's one ObjectID field rule).


def merge_duplicate_sites(points):
    """``points``: ``[(oid, (x, y) or None), ...]``.

    Returns ``(sites, duplicates, nulls)``: ``sites`` are ``{"oid", "xy",
    "count"}`` in ascending OID order (the lowest OID of each location is
    kept); ``duplicates`` maps a kept OID to the other OIDs at its location;
    ``nulls`` lists OIDs without geometry.
    """
    nulls, by_xy, sites = [], {}, []
    duplicates = {}
    for oid, xy in sorted(points, key=lambda item: item[0]):
        if xy is None:
            nulls.append(oid)
            continue
        key = (float(xy[0]), float(xy[1]))
        if key in by_xy:
            site = by_xy[key]
            site["count"] += 1
            duplicates.setdefault(site["oid"], []).append(oid)
            continue
        site = {"oid": oid, "xy": key, "count": 1}
        by_xy[key] = site
        sites.append(site)
    return sites, duplicates, nulls


# The tool merges distinct sites closer than THIESSEN_MERGE_TOLERANCES x the output's XY
# tolerance (1 cm with the default tolerance of 1 mm). ArcGIS Pro rounds the stored vertices to
# the XY resolution and cleans each polygon with the XY tolerance when it stores it; in a Pro
# run it stored EMPTY every cell whose largest inscribed circle had a radius below about 1.7 x
# the XY tolerance (all 9 such cells of 150 points in 5 mm, all 85 of 150 points in 20 mm; the
# merge distance of earlier versions, one XY tolerance, left cells of radius 0.5 mm). The
# Voronoi cell of a site contains the disk of half the distance to its nearest site (unless the
# clip cuts it), so with this merge distance every cell away from the clip edge has an
# inscribed radius of at least 5 x the XY tolerance (about three times the observed limit).
THIESSEN_MERGE_TOLERANCES = 10.0
# In an unknown coordinate system (no .prj) the unit of the data is not known: it may be degrees,
# where ten tolerances (0.01 units) are about 1.1 km. The merge distance is then only the store
# limit itself, 3.5 XY tolerances (an inscribed radius of 1.75 tolerances, just above the observed
# 1.7): a point merged at this distance would have had a cell that Pro stores empty or nearly so,
# whatever the unit (R9-D1 of the round-9 review: lon/lat points 440 m apart were merged).
THIESSEN_UNKNOWN_MERGE_TOLERANCES = 3.5
# XY tolerance = this many XY resolutions when only the resolution can be read (the default).
THIESSEN_TOLERANCE_RESOLUTIONS = 10.0
# XY tolerance in metres assumed when neither the tolerance nor the resolution can be read.
THIESSEN_DEFAULT_TOLERANCE_M = 1e-3


def _thiessen_positive(value):
    try:
        v = float(value)
    except (TypeError, ValueError):
        return None
    return v if v > 0 and math.isfinite(v) else None


def thiessen_merge_factor(unknown=False):
    """How many XY tolerances the merge distance is: ``THIESSEN_MERGE_TOLERANCES`` (10), or
    ``THIESSEN_UNKNOWN_MERGE_TOLERANCES`` (3.5) for an unknown coordinate system."""
    return THIESSEN_UNKNOWN_MERGE_TOLERANCES if unknown else THIESSEN_MERGE_TOLERANCES


def thiessen_merge_distance(xy_tolerance, resolution=None, meters_per_unit=1.0, unknown=False):
    """The merge distance in units of the output's system: ``thiessen_merge_factor(unknown)`` x the
    output's XY tolerance (in those units). When the tolerance is not a positive finite number,
    ``THIESSEN_TOLERANCE_RESOLUTIONS`` x ``resolution`` is used; when that cannot be read
    either, the default 1 mm (converted with ``meters_per_unit``), or 0.001 data units for an
    unknown system (Esri's default tolerance "0.001 meters or its equivalent in map units")."""
    tol = _thiessen_positive(xy_tolerance)
    if tol is None:
        res = _thiessen_positive(resolution)
        if res is not None:
            tol = THIESSEN_TOLERANCE_RESOLUTIONS * res
        elif unknown:
            tol = THIESSEN_DEFAULT_TOLERANCE_M
        else:
            tol = THIESSEN_DEFAULT_TOLERANCE_M / float(meters_per_unit or 1.0)
    return thiessen_merge_factor(unknown) * tol


def thiessen_sr_mismatch(out_info, measure_info):
    """``True`` when the output's coordinate system ``out_info`` is another known system than the
    measuring system ``measure_info`` (both plain dicts with ``wkid``, ``name`` and ``type``, as
    ``common.arcio.sr_info`` gives them), else ``False`` (R10-1 of the round-10 review).

    ArcGIS Pro gives a feature class inside a feature dataset the dataset's coordinate system. The
    output's XY tolerance is then in the dataset's units (degrees, feet) while the cells and the merge
    distance are in the measuring system's units, and Pro would project the cells on insert, so the
    tool refuses such an output. Two systems are the same when their WKIDs are equal, or, when either
    has no WKID, when their names are equal. An unknown system on either side never counts as other
    (its coordinates are stored as they are, in the units of the cells)."""
    out_info, measure_info = out_info or {}, measure_info or {}

    def unknown(info):
        return (str(info.get("type") or "") not in ("Projected", "Geographic")
                and not info.get("wkid"))

    if unknown(out_info) or unknown(measure_info):
        return False
    a, b = out_info.get("wkid"), measure_info.get("wkid")
    if a and b:
        return int(a) != int(b)
    return str(out_info.get("name") or "").casefold() != str(measure_info.get("name") or "").casefold()


def merge_near_sites(sites, duplicates, tol):
    """Merge distinct sites closer than ``tol`` (coordinate units) to a kept site.

    ``sites``: from ``merge_duplicate_sites`` (ascending OID). In OID order a site is kept
    unless a kept site lies closer than ``tol``; then it is merged into the nearest such kept
    site (lowest OID on a tie): its count is added there, and it and its own exact duplicates
    are listed under that kept OID. So kept sites are pairwise at least ``tol`` apart, and each
    merged point lies within ``tol`` of its kept site (no chaining). Returns ``(kept, near)``,
    ``near`` = ``{kept oid: [merged oids]}``; ``duplicates`` loses the entries of merged sites
    (they move to ``near``)."""
    tol = float(tol or 0.0)
    if not (tol > 0) or not math.isfinite(tol) or len(sites) < 2:
        return list(sites), {}
    ox, oy = sites[0]["xy"]
    grid, kept, near = {}, [], {}
    for site in sites:
        x, y = site["xy"][0] - ox, site["xy"][1] - oy
        gx, gy = int(math.floor(x / tol)), int(math.floor(y / tol))
        best = None
        for i in (gx - 1, gx, gx + 1):
            for j in (gy - 1, gy, gy + 1):
                for other in grid.get((i, j), ()):
                    d = math.hypot(other["xy"][0] - site["xy"][0], other["xy"][1] - site["xy"][1])
                    if d < tol and (best is None or (d, other["oid"]) < best[:2]):
                        best = (d, other["oid"], other)
        if best is None:
            keep = dict(site)
            grid.setdefault((gx, gy), []).append(keep)
            kept.append(keep)
            continue
        keeper = best[2]
        keeper["count"] += site["count"]
        near.setdefault(keeper["oid"], []).extend([site["oid"]] + duplicates.pop(site["oid"], []))
    return kept, near


def _thiessen_short_list(items, limit):
    items = list(items)
    text = ", ".join(str(o) for o in items[:limit])
    if len(items) > limit:
        text += " ... ({0} more)".format(len(items) - limit)
    return text


def thiessen_duplicates_text(duplicates, groups_shown=THIESSEN_DUP_GROUPS_SHOWN,
                             oids_shown=THIESSEN_DUP_OIDS_SHOWN):
    """Warning text for merged duplicate sites (``{kept oid: [merged oids]}``), or ``None``.

    At most ``groups_shown`` groups (largest first, so a big pile is never hidden behind
    small ones) and at most ``oids_shown`` merged OIDs per group are printed; the rest is
    counted as ``... (N more)``. The text stays short however many points are merged."""
    if not duplicates:
        return None
    total, text = _thiessen_groups(duplicates, groups_shown, oids_shown)
    return ("{0} point(s) share a location with a lower ObjectID and were merged into its "
            "polygon, at {1} location(s) (kept OID (merged OIDs), largest first): {2}.".format(
                total, len(duplicates), text))


def _thiessen_groups(groups_by_oid, groups_shown, oids_shown):
    total = sum(len(v) for v in groups_by_oid.values())
    order = sorted(groups_by_oid.items(), key=lambda kv: (-len(kv[1]), kv[0]))
    groups = ["{0} ({1})".format(k, _thiessen_short_list(sorted(v), oids_shown))
              for k, v in order[:groups_shown]]
    text = "; ".join(groups)
    if len(order) > groups_shown:
        text += " ... ({0} more location(s))".format(len(order) - groups_shown)
    return total, text


def thiessen_near_text(near, tol, groups_shown=THIESSEN_DUP_GROUPS_SHOWN,
                       oids_shown=THIESSEN_DUP_OIDS_SHOWN, unknown=False):
    """Warning text for distinct points merged because they lie closer than the merge distance
    (``tol``: metres, or data units when ``unknown``, the coordinate system being unknown) to a kept
    point with a lower ObjectID (``{kept oid: [merged oids]}``), or ``None``. Same short form as
    ``thiessen_duplicates_text``."""
    if not near:
        return None
    total, text = _thiessen_groups(near, groups_shown, oids_shown)
    if unknown:
        dist = ("{0:.6g} data units (3.5 times the output's XY tolerance; the coordinate system is "
                "unknown, so the unit of the data is not known)".format(tol))
    else:
        dist = "{0:.6g} m (ten times the output's XY tolerance)".format(tol)
    return ("{0} point(s) lie closer than {1} to a kept point with a lower ObjectID (points are "
            "taken in ObjectID order) and were merged into the polygon of the nearest such point, "
            "at {2} location(s); DUP_COUNT counts them. ArcGIS Pro rounds stored vertices to the XY "
            "resolution and cleans each polygon with the XY tolerance, so separate polygons for "
            "points that close would be stored broken (several parts, holes or no area). Kept OID "
            "(merged OIDs), largest first: {3}.".format(total, dist, len(near), text))


def thiessen_clip_size_check(clip_ring, meters_per_unit=1.0):
    """Raise ``ToolError`` when the clip is larger than ``THIESSEN_MAX_CLIP_M`` on its longer
    side (or not finite)."""
    xs = [p[0] for p in clip_ring]
    ys = [p[1] for p in clip_ring]
    size = max(max(xs) - min(xs), max(ys) - min(ys)) * float(meters_per_unit or 1.0)
    if not math.isfinite(size) or size > THIESSEN_MAX_CLIP_M:
        raise ToolError("The clip is {0:.4g} m across, larger than the maximum of {1:.4g} m "
                        "(about 2.5 times the Earth's circumference): the polygons would lose "
                        "precision.".format(size, THIESSEN_MAX_CLIP_M),
                        "Use a Clip Extent or Clip Features for your study area, or a smaller "
                        "Expand percentage.")


def thin_clip_text(thin, expand_pct):
    """Warning text for a thin default clip box (``thiessen_polygons`` ``"thin_clip"``:
    ``(length m, width m)``), or ``None``."""
    if not thin:
        return None
    return ("The points lie almost on one straight line, so the default clip (their extent "
            "grown by {0:g} % on each side) is {1:.6g} m long but only {2:.6g} m wide: the "
            "polygons are thin slivers. Give a Clip Extent or Clip Features for your study "
            "area to get usable polygons.".format(expand_pct, thin[0], thin[1]))


def expanded_extent(xys, expand_pct=THIESSEN_DEFAULT_EXPAND_PCT):
    """Bounding box of ``xys`` grown on each side by ``expand_pct`` % of its
    width (left/right) and height (bottom/top). A zero width or height (all
    sites on one horizontal or vertical line) uses the other dimension.
    Raises ``ToolError`` when the result has no area."""
    xs = [p[0] for p in xys]
    ys = [p[1] for p in xys]
    if not xs:
        raise ToolError("There are no points with coordinates.",
                        "Check that the input points have geometry.")
    w, h = max(xs) - min(xs), max(ys) - min(ys)
    if float(expand_pct or 0.0) > THIESSEN_MAX_EXPAND_PCT:
        raise ToolError("The Expand percentage {0:g} % is larger than the maximum of {1:,.0f} %: "
                        "the clip box would be so much larger than the points that the "
                        "polygons lose precision.".format(float(expand_pct),
                                                          THIESSEN_MAX_EXPAND_PCT),
                        "Enter a smaller Expand percentage, or a Clip Extent for your study "
                        "area.")
    f = max(float(expand_pct or 0.0), 0.0) / 100.0
    dx = f * (w if w > 0 else h)
    dy = f * (h if h > 0 else w)
    box = (min(xs) - dx, min(ys) - dy, max(xs) + dx, max(ys) + dy)
    if not all(math.isfinite(v) for v in box) or \
            not math.isfinite((box[2] - box[0]) * (box[3] - box[1])):
        raise ToolError("The Expand percentage is so large that the clip extent is not a finite "
                        "rectangle.", "Enter a smaller Expand percentage, or a Clip Extent.")
    if box[2] <= box[0] or box[3] <= box[1]:
        raise ToolError("The points do not span an area that can be expanded into a clip "
                        "extent (a single location, or a straight line with Expand 0 %).",
                        "Enter a Clip Extent or Clip Features, or a larger Expand percentage.")
    return box


def thiessen_convex_floor(sr):
    """Absolute convexity floor for a clip in the system ``sr`` (an
    ``arcio.sr_info`` dict): 0.5 mm in a projected system (five times the default
    file-geodatabase XY resolution of 0.1 mm), 5e-9 degrees (about 0.5 mm) in a
    geographic one, 0 when the system is unknown."""
    sr = sr or {}
    if sr.get("type") == "Projected":
        return 0.0005 / (sr.get("meters_per_unit") or 1.0)
    if sr.get("type") == "Geographic":
        return 5e-9
    return 0.0


def convex_clip_ring(rings, floor=0.0):
    """The single convex, clockwise ring of a clip polygon given as rings.

    A ring counts as convex when no vertex lies deeper inside its convex hull than
    ``THIESSEN_CONVEX_REL_TOL`` x its size, or ``floor`` (coordinate units) if that
    is larger; it is then replaced by that hull, which is exactly convex (a vertex
    of a straight edge rounded to the geodatabase resolution no longer makes a
    convex clip "not convex"). Raises ``ToolError`` for multipart polygons, holes,
    degenerate or concave rings (v1 supports convex clip polygons only).
    """
    rings = [close_ring(r) for r in (rings or []) if len(r) >= 3]
    if len(rings) != 1:
        raise ToolError("The clip polygon has {0} rings; one ring without holes is "
                        "needed.".format(len(rings)),
                        "Use a single-part polygon without holes, or a Clip Extent.")
    ring = rings[0]
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    size = max(max(xs) - min(xs), max(ys) - min(ys))
    hull = near_convex_ring(ring, max(THIESSEN_CONVEX_REL_TOL * size, float(floor or 0.0)))
    if hull is None:
        raise ToolError("The clip polygon is not convex (or has no area): a vertex lies "
                        "inside its outline by more than one millionth of its size (at "
                        "least 0.5 mm in a known coordinate system).",
                        "Use a convex polygon such as a rectangle or a convex hull, or a Clip "
                        "Extent. Concave clip polygons are not supported in this version.")
    ring = [tuple(p) for p in hull]
    if ring_signed_area(ring) > 0:
        ring = list(reversed(ring))
    return ring


def convex_hull_ring(points):
    """Closed clockwise convex hull of ``points`` (monotone chain; collinear
    points dropped). ``ToolError`` if the points have no area.

    Used for a clip polygon that is convex in its own (e.g. geographic)
    system: after projecting its vertices, straight edges along parallels
    bend slightly, so the hull of the projected vertices is the clip."""
    pts = sorted(set((float(x), float(y)) for x, y in points))

    def cross(o, a, b):
        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

    lower, upper = [], []
    for p in pts:
        while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:
            lower.pop()
        lower.append(p)
    for p in reversed(pts):
        while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0:
            upper.pop()
        upper.append(p)
    hull = lower[:-1] + upper[:-1]          # counter-clockwise
    if len(hull) < 3:
        raise ToolError("The clip polygon has no area.", "Use a polygon with an area.")
    ring = close_ring(list(reversed(hull)))
    return ring


def thiessen_renamed_fields_text(output, wanted, specs, already=()):
    """Warning text, or ``None``, when the output format stores a field under another name
    than the one asked for.

    ``wanted``: the field names before ``common.arcio.plan_output_fields``, in order;
    ``specs``: the planned field specs of the same fields in the same order (their ``name``
    is the name the output workspace will give); ``already``: the ``(old, new)`` pairs that
    were announced already (a clash rename), so they are not repeated. A shapefile or dBASE
    name is cut to 10 characters (Population_2020 -> Population); a geodatabase or
    GeoPackage can rename a reserved word. The values are in the renamed field.
    """
    done = set(tuple(pair) for pair in already)
    changed = [(a, s["name"]) for a, s in zip(wanted, specs)
               if a != s["name"] and (a, s["name"]) not in done]
    if not changed:
        return None
    one = len(changed) == 1
    return ("The output format stores {0} of '{1}' under {2}: {3}. The values are in the "
            "renamed {4}.".format("a field" if one else "fields", output,
                                  "another name" if one else "other names",
                                  ", ".join("{0} -> {1}".format(a, b) for a, b in changed),
                                  "field" if one else "fields"))


class ThiessenKDTree(object):
    """Static 2-d tree over sites (leaf buckets), pure Python.

    ``nearest(p, k, skip)``: the ``k`` sites nearest to ``p`` (best-first).
    ``first_within(p, r2, exclude)``: the nearest site to ``p`` closer than
    ``sqrt(r2)`` that is not excluded.
    """

    LEAF = 12

    def __init__(self, pts):
        self.pts = pts
        self.nodes = []      # (xmin, ymin, xmax, ymax, left, right, idxs)
        self.root = self._build(list(range(len(pts))), 0) if pts else None

    def _build(self, idxs, depth):
        pts = self.pts
        xs = [pts[i][0] for i in idxs]
        ys = [pts[i][1] for i in idxs]
        box = (min(xs), min(ys), max(xs), max(ys))
        node = len(self.nodes)
        self.nodes.append(None)
        if len(idxs) <= self.LEAF:
            self.nodes[node] = box + (-1, -1, idxs)
            return node
        axis = 0 if (box[2] - box[0]) >= (box[3] - box[1]) else 1
        idxs.sort(key=lambda i: pts[i][axis])
        mid = len(idxs) // 2
        left = self._build(idxs[:mid], depth + 1)
        right = self._build(idxs[mid:], depth + 1)
        self.nodes[node] = box + (left, right, None)
        return node

    @staticmethod
    def _box_d2(node, x, y):
        dx = node[0] - x if x < node[0] else (x - node[2] if x > node[2] else 0.0)
        dy = node[1] - y if y < node[1] else (y - node[3] if y > node[3] else 0.0)
        return dx * dx + dy * dy

    def nearest(self, p, k, skip):
        """Up to ``k`` ``(d2, index)`` nearest to ``p``, excluding index ``skip``."""
        if self.root is None:
            return []
        x, y = p
        heap = [(0.0, 0, self.root)]
        out = []
        pts, nodes = self.pts, self.nodes
        while heap and len(out) < k:
            d2, kind, ref = heapq.heappop(heap)
            if kind == 1:
                out.append((d2, ref))
                continue
            node = nodes[ref]
            if node[6] is not None:
                for i in node[6]:
                    if i != skip:
                        q = pts[i]
                        heapq.heappush(heap, ((q[0] - x) ** 2 + (q[1] - y) ** 2, 1, i))
            else:
                for child in (node[4], node[5]):
                    heapq.heappush(heap, (self._box_d2(nodes[child], x, y), 0, child))
        return out

    def first_within(self, p, r2, exclude):
        """``(d2, index)`` of the site nearest to ``p`` with squared distance below
        ``r2`` whose index is not in ``exclude``, or ``None``. Best-first: only
        the tree nodes nearer than that site (or than ``r2``) are visited."""
        if self.root is None:
            return None
        x, y = p
        heap = [(self._box_d2(self.nodes[self.root], x, y), 0, self.root)]
        pts, nodes = self.pts, self.nodes
        while heap:
            d2, kind, ref = heapq.heappop(heap)
            if d2 >= r2:
                return None
            if kind == 1:
                return d2, ref
            node = nodes[ref]
            if node[6] is not None:
                for i in node[6]:
                    if i not in exclude:
                        q = pts[i]
                        heapq.heappush(heap, ((q[0] - x) ** 2 + (q[1] - y) ** 2, 1, i))
            else:
                for child in (node[4], node[5]):
                    heapq.heappush(heap, (self._box_d2(nodes[child], x, y), 0, child))
        return None

    def iter_within(self, p, r2, exclude):
        """``(d2, index)`` of every site nearer to ``p`` than ``sqrt(r2)`` whose index is
        not in ``exclude``, nearest first (best-first; stops at ``r2``)."""
        if self.root is None:
            return
        x, y = p
        heap = [(self._box_d2(self.nodes[self.root], x, y), 0, self.root)]
        pts, nodes = self.pts, self.nodes
        while heap:
            d2, kind, ref = heapq.heappop(heap)
            if d2 >= r2:
                return
            if kind == 1:
                yield d2, ref
                continue
            node = nodes[ref]
            if node[6] is not None:
                for i in node[6]:
                    if i not in exclude:
                        q = pts[i]
                        heapq.heappush(heap, ((q[0] - x) ** 2 + (q[1] - y) ** 2, 1, i))
            else:
                for child in (node[4], node[5]):
                    heapq.heappush(heap, (self._box_d2(nodes[child], x, y), 0, child))


def _thiessen_radius(site, ring):
    return max(point_distance(site, p) for p in ring) if ring else 0.0


# Neighbours clipped first, nearest first, before the exact candidate query.
THIESSEN_FIRST_NEIGHBOURS = 24


def voronoi_cells(sites, clip_ring, progress=None):
    """Cells of distinct ``sites`` (``[(x, y), ...]``) inside a convex clockwise
    ``clip_ring``. Returns one closed ring per site (``[]`` = empty cell).
    ``progress()`` is called once per site.

    Exact method: the cell is clipped by the nearest sites in increasing
    distance (k-d tree) until the next one is at least twice the cell's
    farthest vertex away (security radius: it cannot cut). If the nearest
    ``THIESSEN_FIRST_NEIGHBOURS`` sites do not close the cell that way: a site
    can cut a convex cell only if it is nearer than the cell's own site to at
    least one cell **vertex** ``v`` (if a half-plane meets a convex polygon it
    contains one of its vertices). Each vertex is then checked with a
    best-first k-d tree query for the nearest site that has not cut the cell
    yet: a nearer site cuts the cell (removing that vertex), otherwise the
    vertex is final; when all vertices are final the cell is the exact
    Voronoi cell (``_thiessen_verify_vertices``). Strip-shaped cells (points
    along a road) and wedge cells of tightly clustered points only look at the
    sites around each vertex, never at a whole disk of sites. Known limit:
    many sites at almost exactly the same distance from one cell vertex (for
    example stations evenly spaced around a circle, all equidistant from its
    centre) cannot be pruned by the k-d tree, so such data still costs about
    n x (number of such sites).
    """
    if not sites:
        return []
    pts = _thiessen_open(clip_ring)
    ox = (min(p[0] for p in pts) + max(p[0] for p in pts)) / 2.0
    oy = (min(p[1] for p in pts) + max(p[1] for p in pts)) / 2.0
    local = [(x - ox, y - oy) for x, y in sites]
    clip = close_ring([(x - ox, y - oy) for x, y in pts])
    tree = ThiessenKDTree(local)
    size = _thiessen_scale(clip)
    out = []
    origin = (0.0, 0.0)
    for i, s in enumerate(local):
        # Each cell is built in coordinates centred on its own site: the bisector of two
        # sites a few micrometres apart is then exact to about 1e-16 x the cell size,
        # whereas its offset |o|^2 - |s|^2 in clip-centred coordinates carries an error of
        # about 1e-16 x |s|^2 (decimetres for sites 1e-6 m apart 100 km from the centre).
        sx, sy = s
        ring = [(x - sx, y - sy) for x, y in clip]
        done = set([i])
        finished = False
        batch = tree.nearest(s, THIESSEN_FIRST_NEIGHBOURS, i)
        radius = _thiessen_radius(origin, ring)
        for d2, j in batch:
            if math.sqrt(d2) >= 2.0 * radius:      # security radius: nobody else can cut
                finished = True
                break
            done.add(j)
            ring = _thiessen_cut(ring, origin, (local[j][0] - sx, local[j][1] - sy))
            if not ring:
                break
            radius = _thiessen_radius(origin, ring)
        if ring and not finished and len(batch) == THIESSEN_FIRST_NEIGHBOURS:
            ring = _thiessen_verify_vertices(tree, local, s, ring, done, size)
        out.append(_thiessen_final_ring([(x + sx + ox, y + sy + oy) for x, y in ring])
                   if ring else [])
        if progress is not None:
            progress()
    return out


# A site ``o`` cuts a vertex ``v`` off only when ``v`` lies beyond the bisector of the own
# site ``s`` and ``o`` by more than THIESSEN_TIE x the size of the clip (in the local,
# centred coordinates) - a distance, not a fraction of |v - s|^2. The half-plane value
# ``|v - s|^2 - |v - o|^2 = 2 (o - s) . (v - m)`` (m = midpoint of s and o) is that distance
# times 2 |o - s|, so the test is ``value > 2 |o - s| x THIESSEN_TIE x size``. Exact ties
# (co-circular sites: rounding noise of about 1e-16 x size) cannot cut, and a site that is
# skipped as a tie can cut at most a sliver THIESSEN_TIE x size wide (0.1 mm in a 100 km
# clip) however close it is to the own site. (The margin of earlier versions,
# THIESSEN_TIE x |v - s|^2, let a site 1 mm from the own site leave a vertex up to
# 0.5e-9 x |v - s|^2 / 1 mm beyond the bisector: kilometres in a regional clip, R7-D1.)
THIESSEN_TIE = 1e-9


def thiessen_beyond_bisector(v, s, o):
    """``|v - s|^2 - |v - o|^2`` computed from differences (``2 (o - s) . (v - m)``,
    ``m`` the midpoint of ``s`` and ``o``): positive when ``v`` is nearer to ``o``. Its
    rounding error is about 1e-16 x |o - s| x |v|, never 1e-16 x |v - s|^2."""
    dx, dy = o[0] - s[0], o[1] - s[1]
    return 2.0 * (dx * (v[0] - (s[0] + o[0]) * 0.5) + dy * (v[1] - (s[1] + o[1]) * 0.5))


def _thiessen_scale(ring):
    return max([abs(c) for p in ring for c in p[:2]] + [0.0])


def _thiessen_verify_vertices(tree, local, s, ring, done, size=None):
    """Finish a cell exactly. ``ring`` is in coordinates centred on the own site ``s``
    (``s`` itself and the tree are in the clip-centred ``local`` coordinates). For each
    vertex ``v`` of the cell, the sites nearer to ``v`` than ``s`` that have not cut the
    cell yet are looked up (k-d tree, nearest first, with a radius widened by the
    rounding of the tree's coordinates); the first one for which ``v`` lies beyond the
    bisector by more than the tie margin (``THIESSEN_TIE`` x ``size``, a distance) cuts
    the cell (removing ``v``); if there is none ``v`` is final. When every vertex is
    final no site can cut the cell by more than that margin. Each query visits only the
    tree nodes nearer to ``v`` than ``s``, and a vertex that survives a cut is not
    checked again, so clustered sites cost about as much as uniform ones."""
    sx, sy = s
    scale = max(size if size is not None else _thiessen_scale(ring), abs(sx), abs(sy))
    tol = 2.0 * THIESSEN_TIE * scale
    widen = 1e-12 * scale
    origin = (0.0, 0.0)
    final = set()
    while ring:
        todo = [v for v in _thiessen_open(ring) if v not in final]
        if not todo:
            break
        v = todo[0]
        r = math.sqrt(v[0] * v[0] + v[1] * v[1]) * (1.0 + 1e-9) + widen
        hit = None
        for _d2, j in tree.iter_within((v[0] + sx, v[1] + sy), r * r, done):
            o = (local[j][0] - sx, local[j][1] - sy)
            sep = math.sqrt(o[0] * o[0] + o[1] * o[1])
            if thiessen_beyond_bisector(v, origin, o) > tol * sep:
                hit = o
                done.add(j)
                break
        if hit is None:
            final.add(v)
            continue
        ring = _thiessen_cut(ring, origin, hit)
    return ring


def _thiessen_final_ring(ring):
    """The cell in output coordinates as a simple convex ring. A Voronoi cell is convex, but
    rounding its vertices to the output coordinates (about 5e-10 m at UTM northings) can make
    two vertices a few nanometres apart cross over at the shared centre of exactly
    co-circular sites, a self-intersecting ring (R7 O1). The convex hull of the rounded
    vertices is the same cell to within that rounding and always simple; the orientation of
    the ring is kept. A ring whose rounded vertices have no area is returned unchanged."""
    try:
        hull = convex_hull_ring(ring)
    except ToolError:
        return ring
    if (ring_signed_area(hull) > 0) != (ring_signed_area(ring) > 0):
        hull = list(reversed(hull))
    return hull


def _thiessen_open(ring):
    pts = [tuple(p) for p in ring]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    return pts


def _thiessen_cut(ring, site, other):
    try:
        a, b, c = bisector_halfplane(site, other)
    except ValueError:      # identical sites (merged beforehand)
        return ring
    return clip_ring_halfplane(ring, a, b, c)


def thiessen_polygons(points, clip_ring=None, expand_pct=THIESSEN_DEFAULT_EXPAND_PCT,
                      meters_per_unit=1.0, progress=None, merge_tol=0.0, start=None):
    """Thiessen cells for ``points`` (``[(oid, (x, y) or None), ...]``).

    ``start(n)``, when given, is called once before the cells are built with the number ``n`` of
    kept sites, which is the number of times ``progress()`` is then called (exact duplicates and
    near-merged points are not built, so a progress bar sized to the input never reached 100 %).


    ``clip_ring``: convex ring (from ``convex_clip_ring`` or ``rect_ring``);
    ``None`` = points' bounding box expanded by ``expand_pct`` %.
    Returns ``{"cells": [{"oid", "count", "ring", "area_m2"}], "empty": [oids],
    "duplicates": {kept oid: [others]}, "nulls": [oids], "clip_ring",
    "clip_area_m2", "thin_clip"}``; cells are in ascending OID order. ``thin_clip`` is
    ``(length m, width m)`` when the default box is narrower than
    ``THIESSEN_THIN_RATIO`` of its length (points almost on one line), else ``None``.
    ``merge_tol`` (coordinate units, 0 = off): distinct sites closer than it to a site with a
    lower OID are merged into it (``merge_near_sites``); they are listed in ``"near"``.
    """
    sites, duplicates, nulls = merge_duplicate_sites(points)
    all_xy = [s["xy"] for s in sites]
    sites, near = merge_near_sites(sites, duplicates, merge_tol)
    mpu = float(meters_per_unit or 1.0)
    thin = None
    if clip_ring is None:
        if not sites:
            return {"cells": [], "empty": [], "duplicates": duplicates, "nulls": nulls,
                    "clip_ring": None, "clip_area_m2": 0.0, "thin_clip": None, "near": near}
        box = expanded_extent(all_xy, expand_pct)
        w, h = box[2] - box[0], box[3] - box[1]
        if min(w, h) < THIESSEN_THIN_RATIO * max(w, h):
            thin = (max(w, h) * mpu, min(w, h) * mpu)
        clip_ring = rect_ring(*box)
    thiessen_clip_size_check(clip_ring, mpu)
    if start is not None:
        start(len(sites))
    rings = voronoi_cells([s["xy"] for s in sites], clip_ring, progress)
    cells, empty = [], []
    for site, ring in zip(sites, rings):
        if not ring:
            empty.append(site["oid"])
            continue
        cells.append({"oid": site["oid"], "count": site["count"], "ring": ring,
                      "area_m2": abs(ring_signed_area(ring)) * mpu * mpu})
    return {"cells": cells, "empty": empty, "duplicates": duplicates, "nulls": nulls,
            "clip_ring": clip_ring, "clip_area_m2": abs(ring_signed_area(clip_ring)) * mpu * mpu,
            "thin_clip": thin, "near": near}


# ==========================================================================
# analysis/rose_core.py
# ==========================================================================
# Rose Diagram (pure Python, no arcpy).
#
# Bins directions into sectors (and optional magnitude classes) per group, and
# computes circular statistics, frequency tables, rose petals as polygon rings
# and a PNG. Everything a reader needs to interpret a number is returned with it.
#
# Conventions (the user must choose one; there is no default)
# -----------------------------------------------------------
# * ``AZIMUTH_FROM``: degrees clockwise from north; the direction the value comes
#   FROM (meteorological wind direction). The petal points at the stored value.
# * ``AZIMUTH_TO``: degrees clockwise from north; the direction of travel / heading.
#   The petal points at the stored value.
# * ``ARITHMETIC``: degrees counter-clockwise from east (mathematical angle). It is
#   converted to a bearing ``(90 - value) mod 360``; the petal points at that bearing.
#
# Inside the module every direction is a *petal bearing* ``b``: degrees clockwise
# from north in ``[0, 360)``. Statistics and sectors are computed on ``b``; angles
# reported "in the convention" are converted back with ``rose_from_bearing``.
# For bearings computed from line geometry the start-to-end direction is the
# ``AZIMUTH_TO`` bearing; ``AZIMUTH_FROM`` uses the reverse direction (+180).
#
# Rules that tests pin down
# -------------------------
# * Angles are rounded to 1e-9 degrees and wrapped into ``[0, 360)`` before they are
#   binned, so 360 and 0 are the same direction and numerically noisy values such as
#   44.99999999999999 fall where they visually belong.
# * A sector is half-open: its lower edge belongs to it, its upper edge to the next
#   sector. EDGE TOLERANCE: a bearing less than ``ROSE_EDGE_TOLERANCE_DEG`` (1e-6 degrees)
#   below an edge counts as lying exactly on it (so it belongs to the sector that starts
#   there). Stored coordinates are snapped to a grid, so a segment that is exactly 45 degrees
#   in the data can come back as 44.999999999 degrees; without the tolerance such a segment
#   would fall on either side of the edge depending on the noise. With ``CENTERED_ON_NORTH`` sector ``k`` is ``[k*w - w/2, k*w + w/2)``,
#   with ``STARTS_AT_NORTH`` it is ``[k*w, (k+1)*w)`` (``w`` = 360 / sectors).
# * AXIAL: a direction ``b`` and ``b + 180`` are the same axis. Angles are folded into
#   ``[0, 180)``; there are ``sectors / 2`` bins; each bin is drawn twice (``b`` and
#   ``b + 180``) with the same area; the table lists each bin once.
# * Petal area is proportional to the bin's weight (a count, or a length in metres):
#   a petal that reaches cumulative weight ``c`` has radius ``R * sqrt(c / REF)``
#   (``REF`` = the largest sector total of the group, or of all groups); the polygon
#   vertices lie on a circle slightly larger than that radius so that the polygon area
#   equals the exact sector area ``w/2 * (r_out^2 - r_in^2)``.

ROSE_CONVENTIONS = ("AZIMUTH_FROM", "AZIMUTH_TO", "ARITHMETIC")
ROSE_CONVENTION_TEXT = {
    "AZIMUTH_FROM": "degrees clockwise from north; the direction the value comes FROM",
    "AZIMUTH_TO": "degrees clockwise from north; the direction the value points TO",
    "ARITHMETIC": "degrees counter-clockwise from east, converted to a bearing (90 - value)",
}
ROSE_SECTOR_CHOICES = (8, 16, 36)
ROSE_ALIGN_CENTERED = "CENTERED_ON_NORTH"
ROSE_ALIGN_START = "STARTS_AT_NORTH"
ROSE_ALIGNMENTS = (ROSE_ALIGN_CENTERED, ROSE_ALIGN_START)
ROSE_SCALE_PER_GROUP = "PER_GROUP"
ROSE_SCALE_ALL = "ALL_GROUPS"
ROSE_SCALE_MODES = (ROSE_SCALE_PER_GROUP, ROSE_SCALE_ALL)
ROSE_LINE_SEGMENT = "PER_SEGMENT"
ROSE_LINE_WHOLE = "WHOLE_LINE"
ROSE_LINE_MODES = (ROSE_LINE_SEGMENT, ROSE_LINE_WHOLE)
ROSE_ANCHOR_CENTROID = "GROUP_CENTROID"
ROSE_ANCHOR_EXTENT = "GROUP_EXTENT_CENTRE"
ROSE_ANCHOR_FIELDS = "FIELD_XY"
ROSE_ANCHOR_POINT = "SINGLE_POINT"
ROSE_ANCHOR_MODES = (ROSE_ANCHOR_CENTROID, ROSE_ANCHOR_EXTENT, ROSE_ANCHOR_FIELDS,
                     ROSE_ANCHOR_POINT)

ROSE_ANGLE_DECIMALS = 9          # angles are rounded to this many decimals before binning
ROSE_EDGE_TOLERANCE_DEG = 1e-6   # a bearing this close below a sector edge is treated as on the edge
ROSE_RAYLEIGH_ALPHA = 0.05       # a direction is called "preferred" when the Rayleigh test gives p below this
ROSE_MIN_RESULTANT = 1e-9        # below this a mean direction is reported as undefined
ROSE_ARC_STEP_DEG = 2.5          # maximum angle between two vertices on a petal arc
ROSE_MAX_BREAKS = 7
ROSE_MAX_PNG_GROUPS = 24
ROSE_POSTER_THEMES = ("DARK", "LIGHT")
ROSE_POSTER_SIZE_IN = (12.0, 6.3)   # 1.9 : 1, the shape LinkedIn shows without cropping
ROSE_POSTER_DPI = 200               # 2400 x 1260 pixels
ROSE_POSTER_MIN_WIDTH = 0.5         # a map window narrower than this x its height is widened
ROSE_POSTER_MAP_CAP = 400000        # most items kept for the map of the poster (memory stays O(cap))
ROSE_POSTER_PIE_CAP = 300           # most shared point locations drawn as pies (more: one dot each)
ROSE_DEFAULT_GROUP = "ALL"
ROSE_NULL_GROUP = "(no value)"
ROSE_DEFAULT_RADIUS_M = 100.0
ROSE_AUTO_NEIGHBOUR_SHARE = 0.4  # automatic radius = this share of the nearest anchor distance
ROSE_AUTO_EXTENT_SHARE = 0.1     # one anchor: this share of the data extent diagonal
ROSE_MAX_ANCHOR_CONFLICT_REPORT = 5
ROSE_RADIANS_MIN_VALUES = 10     # the radians hint needs at least this many direction values
ROSE_RADIANS_TOL = 0.01          # slack above 2*pi of the radians hint
# A petal radius below this (metres) is only about 100 times the default XY resolution of a
# geodatabase (0.0001 m): the petals snap to a few cells and are invisible on any map.
ROSE_MIN_VISIBLE_RADIUS_M = 0.01
# Automatic radius: warn when the two closest roses are much closer than the others, i.e. the
# closest distance is below the smaller of these shares of the data diagonal:
ROSE_CLOSE_PAIR_DIAG_SHARE = 0.025          # R = 40 % of it is then below 1 % of the diagonal
ROSE_CLOSE_PAIR_SPACING_SHARE = 0.1         # x the typical spacing diagonal / sqrt(n roses)

# (name, AddField keyword) of the three tables; text widths come from the values.
ROSE_TABLE_FIELDS = (
    ("GROUP_NAME", "TEXT"), ("SECTOR", "LONG"), ("BRG_START", "DOUBLE"),
    ("BRG_END", "DOUBLE"), ("BRG_MID", "DOUBLE"), ("DIR_MID", "DOUBLE"),
    ("MAG_CLASS", "LONG"), ("MAG_LABEL", "TEXT"), ("N_ITEMS", "LONG"),
    ("WEIGHT", "DOUBLE"), ("PCT_GROUP", "DOUBLE"), ("CONVENTION", "TEXT"),
    ("AXIAL", "SHORT"), ("DIR_SOURCE", "TEXT"), ("NORTH_REF", "TEXT"),
    ("SECT_ALIGN", "TEXT"), ("WEIGHT_BY", "TEXT"))
ROSE_SUMMARY_FIELDS = (
    ("GROUP_NAME", "TEXT"), ("GRP_ORDER", "LONG"), ("N_ITEMS", "LONG"),
    ("WEIGHT", "DOUBLE"), ("N_EFF", "DOUBLE"), ("MEAN_DIR", "DOUBLE"),
    ("RESULT_R", "DOUBLE"), ("RAYLEIGH_Z", "DOUBLE"), ("RAYLEIGH_P", "DOUBLE"),
    ("PREF_DIR", "SHORT"), ("CIRC_STD", "DOUBLE"), ("ORTHO_DIR", "DOUBLE"),
    ("ORTHO_R", "DOUBLE"), ("ORTHO_P", "DOUBLE"), ("ENTROPY", "DOUBLE"),
    ("ENT_NORM", "DOUBLE"), ("DOM_SECTOR", "LONG"), ("DOM_DIR", "DOUBLE"), ("DOM_PCT", "DOUBLE"),
    ("ANCHOR_X", "DOUBLE"), ("ANCHOR_Y", "DOUBLE"), ("R_MAX_M", "DOUBLE"), ("REF_WEIGHT", "DOUBLE"),
    ("STAT_TYPE", "TEXT"), ("CONVENTION", "TEXT"), ("AXIAL", "SHORT"),
    ("DIR_SOURCE", "TEXT"), ("NORTH_REF", "TEXT"), ("SECT_ALIGN", "TEXT"),
    ("WEIGHT_BY", "TEXT"), ("CRS_NAME", "TEXT"))
ROSE_PETAL_FIELDS = (
    ("GROUP_NAME", "TEXT"), ("SECTOR", "LONG"), ("MIRROR", "SHORT"),
    ("MAG_CLASS", "LONG"), ("MAG_LABEL", "TEXT"), ("N_ITEMS", "LONG"),
    ("WEIGHT", "DOUBLE"), ("PCT_GROUP", "DOUBLE"), ("BRG_MID", "DOUBLE"),
    ("R_IN_M", "DOUBLE"), ("R_OUT_M", "DOUBLE"), ("AREA_M2", "DOUBLE"),
    ("SCALE_RULE", "TEXT"), ("CONVENTION", "TEXT"), ("AXIAL", "SHORT"),
    ("DIR_SOURCE", "TEXT"), ("NORTH_REF", "TEXT"), ("WEIGHT_BY", "TEXT"))


# --------------------------------------------------------------------------
# Angles, conventions, sectors
# --------------------------------------------------------------------------

def rose_wrap(angle, period=360.0):
    """``angle`` rounded to 1e-9 and wrapped into ``[0, period)`` (360 -> 0)."""
    value = round(float(angle) % period, ROSE_ANGLE_DECIMALS)
    return 0.0 if value >= period else value


def rose_round_angle(angle, period=360.0, digits=1):
    """``angle`` rounded to ``digits`` decimals FIRST and wrapped into ``[0, period)`` after,
    so that 359.97 prints as 0.0 (not 360.0), an axial 179.98 as 0.0 and a grid 89.97 as 0.0;
    -0.0 becomes 0.0. Used for every angle that is printed as text."""
    value = round(round(float(angle), digits) % period, digits)
    return 0.0 if value >= period or value == 0.0 else value


def rose_angle_text(angle, period=360.0):
    """``angle`` as text with one decimal, rounded then wrapped (see ``rose_round_angle``)."""
    return "{0:.1f}".format(rose_round_angle(angle, period))


def rose_to_bearing(value, convention):
    """Petal bearing (degrees clockwise from north, ``[0, 360)``) of a stored
    direction ``value``; ``None`` when ``value`` is not a finite number."""
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    if not math.isfinite(number):
        return None
    if convention == "ARITHMETIC":
        return rose_wrap(90.0 - number)
    if convention in ("AZIMUTH_FROM", "AZIMUTH_TO"):
        return rose_wrap(number)
    raise ValueError("unknown convention: {0}".format(convention))


def rose_from_bearing(bearing, convention, period=360.0):
    """A petal bearing expressed in the user's convention (wrapped into ``[0, period)``)."""
    if bearing is None:
        return None
    if convention == "ARITHMETIC":
        return rose_wrap(90.0 - bearing, period)
    return rose_wrap(bearing, period)


def rose_segment_bearing(x1, y1, x2, y2):
    """Bearing of the direction ``(x1, y1) -> (x2, y2)`` in degrees clockwise from the
    +Y axis (grid north), ``[0, 360)``; ``None`` for a zero-length or non-finite segment."""
    dx, dy = x2 - x1, y2 - y1
    if not (math.isfinite(dx) and math.isfinite(dy)) or (dx == 0.0 and dy == 0.0):
        return None
    return rose_wrap(math.degrees(math.atan2(dx, dy)))


def rose_line_bearing(az_to, convention):
    """Petal bearing of a line whose start-to-end bearing is ``az_to``:
    ``AZIMUTH_FROM`` reports the direction the line is travelled FROM (reverse)."""
    if convention == "AZIMUTH_FROM":
        return rose_wrap(az_to + 180.0)
    return rose_wrap(az_to)


def rose_bin_count(sectors, axial):
    """Number of bins in the frequency table."""
    return sectors // 2 if axial else sectors


def rose_sector_index(bearing, sectors, axial=False, centered=True):
    """Index of the bin of ``bearing`` (lower edge inclusive, upper edge exclusive; a bearing
    within ``ROSE_EDGE_TOLERANCE_DEG`` below an edge is on that edge, see the module notes)."""
    width = 360.0 / sectors
    bins = rose_bin_count(sectors, axial)
    value = rose_wrap(bearing, 180.0 if axial else 360.0)
    offset = width / 2.0 if centered else 0.0
    return int(math.floor((value + offset + ROSE_EDGE_TOLERANCE_DEG) / width)) % bins


def rose_sector_edges(index, sectors, centered=True):
    """``(start, end, centre)`` bearings of bin ``index`` (``start`` inclusive, ``end``
    exclusive, wrapped into ``[0, 360)``; the north sector has ``end < start``)."""
    width = 360.0 / sectors
    start = index * width - (width / 2.0 if centered else 0.0)
    return rose_wrap(start), rose_wrap(start + width), rose_wrap(start + width / 2.0)


def rose_parse_breaks(text):
    """Strictly increasing class breaks from ``"2, 5, 10"``; ``[]`` for empty text.
    ``ValueError`` when a break is not a number, they do not increase or there are too many."""
    if text is None or not str(text).strip():
        return []
    out = []
    for token in str(text).replace(";", ",").replace(" ", ",").split(","):
        token = token.strip()
        if not token:
            continue
        try:
            value = float(token)
        except ValueError:
            raise ValueError("'{0}' is not a number".format(token))
        if not math.isfinite(value):
            raise ValueError("'{0}' is not a finite number".format(token))
        out.append(value)
    for a, b in zip(out, out[1:]):
        if b <= a:
            raise ValueError("the breaks must increase ({0} is not above {1})".format(
                _rose_num(b), _rose_num(a)))
    if len(out) > ROSE_MAX_BREAKS:
        raise ValueError("at most {0} breaks (eight classes) are allowed".format(ROSE_MAX_BREAKS))
    return out


def _rose_num(value):
    return "{0:g}".format(value)


def rose_class_labels(breaks):
    """Labels of the classes of ``breaks`` (class 1 is the lowest); ``[""]`` without breaks."""
    if not breaks:
        return [""]
    labels = ["< " + _rose_num(breaks[0])]
    for a, b in zip(breaks, breaks[1:]):
        labels.append("{0} to < {1}".format(_rose_num(a), _rose_num(b)))
    labels.append(">= " + _rose_num(breaks[-1]))
    return labels


def rose_class_index(value, breaks):
    """Class (1-based) of a magnitude: a value equal to a break is in the upper class."""
    return bisect.bisect_right(breaks, value) + 1


def rose_group_name(value, has_field):
    """Group name text: ``ALL`` without a group field, ``(no value)`` for null or blank."""
    if not has_field:
        return ROSE_DEFAULT_GROUP
    text = value_to_text(value)
    if text is None or not text.strip():
        return ROSE_NULL_GROUP
    return text.strip()


# --------------------------------------------------------------------------
# Accumulation
# --------------------------------------------------------------------------

class RoseGroup(object):
    """Running sums of one group (no per-datum storage)."""

    def __init__(self, name):
        self.name = name
        self.n = 0
        self.weight = 0.0
        self.weight2 = 0.0             # sum of squared weights (effective sample size)
        self.sums = [0.0] * 6          # sum w*cos(b), w*sin(b), cos 2b, sin 2b, cos 4b, sin 4b
        self.bins = {}                 # (sector, class) -> [n, weight]
        self.loc_weight = 0.0
        self.loc_x = 0.0
        self.loc_y = 0.0
        self.loc_n = 0
        self.box = None
        self.field_xy = None
        self.xy_conflicts = 0

    def add(self, bearing, weight, sector, cls, x=None, y=None):
        rad = math.radians(bearing)
        self.n += 1
        self.weight += weight
        self.weight2 += weight * weight
        s = self.sums
        s[0] += weight * math.cos(rad)
        s[1] += weight * math.sin(rad)
        s[2] += weight * math.cos(2.0 * rad)
        s[3] += weight * math.sin(2.0 * rad)
        s[4] += weight * math.cos(4.0 * rad)
        s[5] += weight * math.sin(4.0 * rad)
        cell = self.bins.setdefault((sector, cls), [0, 0.0])
        cell[0] += 1
        cell[1] += weight
        if x is not None and y is not None and math.isfinite(x) and math.isfinite(y):
            self.loc_n += 1
            self.loc_weight += weight
            self.loc_x += weight * x
            self.loc_y += weight * y
            if self.box is None:
                self.box = [x, y, x, y]
            else:
                b = self.box
                b[0], b[1] = min(b[0], x), min(b[1], y)
                b[2], b[3] = max(b[2], x), max(b[3], y)

    def sector_weights(self):
        """``{sector: total weight over all classes}``."""
        out = {}
        for (sector, _cls), cell in self.bins.items():
            out[sector] = out.get(sector, 0.0) + cell[1]
        return out

    def sector_counts(self):
        out = {}
        for (sector, _cls), cell in self.bins.items():
            out[sector] = out.get(sector, 0) + cell[0]
        return out


def rose_options(convention, axial=False, sectors=16, alignment=ROSE_ALIGN_CENTERED,
                 breaks=None, line_mode=ROSE_LINE_SEGMENT, weight_length=False, mpu=1.0,
                 scale_mode=ROSE_SCALE_PER_GROUP, radius_m=None, anchor_mode=ROSE_ANCHOR_CENTROID,
                 anchor_xy=None, dir_source="FIELD", north_ref="AS_STORED"):
    """Validated option dictionary (``ValueError`` for a value outside its list)."""
    if convention not in ROSE_CONVENTIONS:
        raise ValueError("convention must be one of {0}".format(", ".join(ROSE_CONVENTIONS)))
    if int(sectors) not in ROSE_SECTOR_CHOICES:
        raise ValueError("sectors must be one of {0}".format(
            ", ".join(str(s) for s in ROSE_SECTOR_CHOICES)))
    if alignment not in ROSE_ALIGNMENTS:
        raise ValueError("alignment must be one of {0}".format(", ".join(ROSE_ALIGNMENTS)))
    if line_mode not in ROSE_LINE_MODES:
        raise ValueError("line_mode must be one of {0}".format(", ".join(ROSE_LINE_MODES)))
    if scale_mode not in ROSE_SCALE_MODES:
        raise ValueError("scale_mode must be one of {0}".format(", ".join(ROSE_SCALE_MODES)))
    if anchor_mode not in ROSE_ANCHOR_MODES:
        raise ValueError("anchor_mode must be one of {0}".format(", ".join(ROSE_ANCHOR_MODES)))
    if radius_m is not None and not (radius_m > 0 and math.isfinite(radius_m)):
        raise ValueError("the petal radius must be a positive number")
    return {
        "convention": convention, "axial": bool(axial), "sectors": int(sectors),
        "centered": alignment == ROSE_ALIGN_CENTERED, "alignment": alignment,
        "breaks": list(breaks or []), "line_mode": line_mode,
        "weight_length": bool(weight_length), "mpu": float(mpu or 1.0),
        "scale_mode": scale_mode, "radius_m": radius_m, "anchor_mode": anchor_mode,
        "anchor_xy": anchor_xy, "dir_source": dir_source, "north_ref": north_ref}


class RoseTooManyGroups(ValueError):
    """Raised by ``RoseCollector.group`` as soon as a group beyond ``max_groups`` appears, so that a
    unique-ID group field is refused while the input is streamed, not after all of it was held in
    memory. ``limit`` is the maximum, ``rows_read`` the number of the row that brought the new group."""

    def __init__(self, limit, rows_read):
        ValueError.__init__(self, "more than {0} groups at row {1}".format(limit, rows_read))
        self.limit = limit
        self.rows_read = rows_read


class RoseCollector(object):
    """Collects directions into groups and counts everything it leaves out."""

    def __init__(self, opts, has_group_field=False, track_overall=False, max_groups=None):
        self.opts = opts
        self.has_group_field = has_group_field
        self.max_groups = max_groups
        self.groups = {}
        self.overall = RoseGroup("ALL") if track_overall else None   # all groups together (poster)
        self.last_sector = None
        self.skipped = {"no_direction": 0, "no_magnitude": 0, "no_geometry": 0,
                        "zero_length": 0, "zero_chord": 0, "no_length": 0,
                        "zero_weight": 0}
        self.rows_read = 0
        self.features_used = 0         # rows that gave at least one datum (rows_read counts all)
        self.wrapped = 0               # stored values outside -360..360
        self.value_min = None
        self.value_max = None
        self.value_n = 0

    def group(self, name):
        grp = self.groups.get(name)
        if grp is None:
            if self.max_groups is not None and len(self.groups) >= self.max_groups:
                raise RoseTooManyGroups(self.max_groups, self.rows_read)
            grp = self.groups[name] = RoseGroup(name)
        return grp

    def note_value(self, number):
        """Track the range of the stored direction values (radian / out-of-range hints)."""
        self.value_n += 1
        self.value_min = number if self.value_min is None else min(self.value_min, number)
        self.value_max = number if self.value_max is None else max(self.value_max, number)
        if abs(number) > 360.0:
            self.wrapped += 1

    def add(self, grp, bearing, weight, magnitude, x=None, y=None):
        """Add one datum (a petal bearing) to ``grp``; returns False if it was skipped."""
        opts = self.opts
        cls = 0
        if not (math.isfinite(weight) and weight > 0):
            self.skipped["zero_weight"] += 1      # e.g. a zero-length line weighted by length
            return False
        if opts["breaks"]:
            if magnitude is None or not math.isfinite(magnitude):
                self.skipped["no_magnitude"] += 1
                return False
            cls = rose_class_index(magnitude, opts["breaks"])
        sector = rose_sector_index(bearing, opts["sectors"], opts["axial"], opts["centered"])
        grp.add(bearing, weight, sector, cls, x, y)
        if self.overall is not None:
            self.overall.add(bearing, weight, sector, cls, x, y)
        self.last_sector = sector
        return True

    def ordered_groups(self):
        return [self.groups[k] for k in sorted(self.groups, key=natural_sort_key)]

    @property
    def used(self):
        return sum(g.n for g in self.groups.values())

    def poster_group(self):
        """The group the poster describes: every group together (``track_overall``), or the
        only group; ``None`` when there is no data or several groups were not tracked together."""
        if self.overall is not None:
            return self.overall if self.overall.n > 0 else None
        if len(self.groups) == 1:
            grp = list(self.groups.values())[0]
            return grp if grp.n > 0 else None
        return None

    def looks_like_radians(self):
        """True when many stored values (at least ``ROSE_RADIANS_MIN_VALUES``) all fit in one
        turn measured in radians: every value within -2*pi..2*pi and the range (largest minus
        smallest) at most 2*pi. That covers 0..2*pi, signed radians -pi..pi (the output of
        ``atan2``) and -2*pi..0; degree data spread over more than about 6.3 degrees is never
        flagged (a hint, not a refusal)."""
        if self.value_n < ROSE_RADIANS_MIN_VALUES or self.value_min is None:
            return False
        turn = 2.0 * math.pi + ROSE_RADIANS_TOL
        return (abs(self.value_min) <= turn and abs(self.value_max) <= turn
                and self.value_max - self.value_min <= turn)


def rose_line_data(paths, mode, mpu, counters, ends=None):
    """``[(az_to, length_m, x, y), ...]`` of one line feature.

    ``PER_SEGMENT``: one datum per straight segment between consecutive vertices
    (``x, y`` = segment midpoint, ``length_m`` = segment length). ``WHOLE_LINE``: one
    datum per part, the chord from its first to its last vertex (``length_m`` = length of
    the part along its vertices, ``x, y`` = chord midpoint). Zero-length segments and
    parts with a zero chord (closed loops) are counted in ``counters`` and left out.
    When ``ends`` is a list, ``(x1, y1, x2, y2)`` of every datum returned is appended to it (the
    drawn segment or chord; used for the map of the poster).
    """
    out = []
    for path in paths or ():
        pts = [(float(p[0]), float(p[1])) for p in path]
        if mode == ROSE_LINE_WHOLE:
            if len(pts) < 2:
                counters["zero_chord"] += 1
                continue
            az = rose_segment_bearing(pts[0][0], pts[0][1], pts[-1][0], pts[-1][1])
            if az is None:
                counters["zero_chord"] += 1
                continue
            length = sum(math.hypot(b[0] - a[0], b[1] - a[1]) for a, b in zip(pts, pts[1:]))
            out.append((az, length * mpu, (pts[0][0] + pts[-1][0]) / 2.0,
                        (pts[0][1] + pts[-1][1]) / 2.0))
            if ends is not None:
                ends.append((pts[0][0], pts[0][1], pts[-1][0], pts[-1][1]))
            continue
        for a, b in zip(pts, pts[1:]):
            az = rose_segment_bearing(a[0], a[1], b[0], b[1])
            if az is None:
                counters["zero_length"] += 1
                continue
            out.append((az, math.hypot(b[0] - a[0], b[1] - a[1]) * mpu,
                        (a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0))
            if ends is not None:
                ends.append((a[0], a[1], b[0], b[1]))
    return out


def _rose_number(value):
    """Finite float, or ``None`` for null / text / NaN."""
    if value is None or isinstance(value, bool):
        return None
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return number if math.isfinite(number) else None


def _rose_geometry_centre(kind, shape):
    xs, ys = [], []
    if shape is None:
        return None, None
    if kind == GEOM_POINT:
        return float(shape[0]), float(shape[1])
    for part in shape:
        for p in part:
            xs.append(float(p[0]))
            ys.append(float(p[1]))
    if not xs:
        return None, None
    return (min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0


class RoseMapSample(object):
    """A bounded sample of what the poster draws on its map: line segments
    ``(x1, y1, x2, y2)`` or points ``(x, y)``, each with the bin (sector index) of its direction.

    At most ``cap`` items are kept, however many are offered, so the memory of a poster is
    O(cap), not O(features). Up to ``cap`` items every item is kept; beyond that the sample is a
    uniform random sample of the stream (reservoir sampling, Algorithm R) drawn with a FIXED seed,
    so the same input always gives the same picture, and no regular pattern of the stream (for
    example alternating directions) can fool it.
    """

    def __init__(self, points=False, cap=ROSE_POSTER_MAP_CAP, seed=20261029):
        self.points = bool(points)
        self.cap = max(2, int(cap))
        self.offered = 0
        self._rng = random.Random(seed)
        self.x1, self.y1, self.x2, self.y2 = array("d"), array("d"), array("d"), array("d")
        self.bin = array("i")

    def __len__(self):
        return len(self.bin)

    @property
    def sampled(self):
        """True when more items were offered than kept."""
        return self.offered > len(self.bin)

    def add(self, sector, x1, y1, x2=None, y2=None):
        """Offer one item (a point needs only ``x1, y1``)."""
        if sector is None or not (math.isfinite(x1) and math.isfinite(y1)):
            return
        if not self.points and not (x2 is not None and y2 is not None
                                    and math.isfinite(x2) and math.isfinite(y2)):
            return
        index = self.offered
        self.offered += 1
        if index < self.cap:
            self.x1.append(float(x1))
            self.y1.append(float(y1))
            if not self.points:
                self.x2.append(float(x2))
                self.y2.append(float(y2))
            self.bin.append(int(sector))
            return
        slot = self._rng.randint(0, index)
        if slot < self.cap:
            self.x1[slot], self.y1[slot] = float(x1), float(y1)
            if not self.points:
                self.x2[slot], self.y2[slot] = float(x2), float(y2)
            self.bin[slot] = int(sector)

    def centres(self):
        """``[(x, y)]`` of every kept item (the middle of a segment)."""
        if self.points:
            return list(zip(self.x1, self.y1))
        return [((a + c) / 2.0, (b + d) / 2.0)
                for a, b, c, d in zip(self.x1, self.y1, self.x2, self.y2)]


def rose_collect(rows, kind, opts, direction_field=None, group_field=None,
                 magnitude_field=None, anchor_x_field=None, anchor_y_field=None,
                 overall=False, sample=None, max_groups=None):
    """Collect directions from feature rows (``{"oid", "shape", "attrs"}``).

    Points need ``direction_field``. Lines use ``direction_field`` (one stored direction
    per feature, weight = feature length when ``weight_length``) or, without it, the
    bearings of their segments or parts (``opts["line_mode"]``). Returns a
    ``RoseCollector``.

    ``rows`` is read once, in order, and may be a generator: nothing but the running sums of the
    groups is kept (memory is O(groups x bins), not O(rows)). ``overall`` also sums every group
    together (``RoseCollector.overall``, for the poster); ``sample`` is an optional
    ``RoseMapSample`` that receives every used segment (or point) with its bin. With
    ``max_groups`` the read stops with ``RoseTooManyGroups`` at the first row of group
    ``max_groups + 1``.
    """
    col = RoseCollector(opts, bool(group_field), track_overall=overall, max_groups=max_groups)
    convention = opts["convention"]
    from_geometry = kind == GEOM_POLYLINE and not direction_field
    if kind == GEOM_POINT and not direction_field:
        raise ValueError("points need a direction field")
    for row in rows:
        col.rows_read += 1
        attrs = row["attrs"]
        shape = row["shape"]
        grp = col.group(rose_group_name(attrs.get(group_field) if group_field else None,
                                        bool(group_field)))
        magnitude = _rose_number(attrs.get(magnitude_field)) if magnitude_field else None
        if anchor_x_field and anchor_y_field:
            ax, ay = _rose_number(attrs.get(anchor_x_field)), _rose_number(attrs.get(anchor_y_field))
            if ax is not None and ay is not None:
                if grp.field_xy is None:
                    grp.field_xy = (ax, ay)
                elif (abs(grp.field_xy[0] - ax) > 1e-9 * max(1.0, abs(ax))
                      or abs(grp.field_xy[1] - ay) > 1e-9 * max(1.0, abs(ay))):
                    grp.xy_conflicts += 1
        if from_geometry:
            if shape is None:
                col.skipped["no_geometry"] += 1
                continue
            ends = [] if sample is not None else None
            data = rose_line_data(shape, opts["line_mode"], opts["mpu"], col.skipped, ends)
            used = False
            for i, (az, length_m, x, y) in enumerate(data):
                weight = length_m if opts["weight_length"] else 1.0
                if col.add(grp, rose_line_bearing(az, convention), weight, magnitude, x, y):
                    used = True
                    if sample is not None:
                        sample.add(col.last_sector, *ends[i])
            col.features_used += 1 if used else 0
            continue
        number = _rose_number(attrs.get(direction_field))
        if number is None:
            col.skipped["no_direction"] += 1
            continue
        col.note_value(number)
        weight = 1.0
        if kind == GEOM_POLYLINE and opts["weight_length"]:
            if shape is None:
                col.skipped["no_length"] += 1
                continue
            weight = sum(math.hypot(float(b[0]) - float(a[0]), float(b[1]) - float(a[1]))
                         for part in shape for a, b in zip(part, part[1:])) * opts["mpu"]
        x, y = _rose_geometry_centre(kind, shape)
        added = col.add(grp, rose_to_bearing(number, convention), weight, magnitude, x, y)
        col.features_used += 1 if added else 0
        if added and sample is not None:
            if kind == GEOM_POINT:
                if x is not None:
                    sample.add(col.last_sector, x, y)
            elif shape is not None:
                for part in shape:
                    for a, b in zip(part, part[1:]):
                        sample.add(col.last_sector, float(a[0]), float(a[1]), float(b[0]),
                                   float(b[1]))
    return col


# --------------------------------------------------------------------------
# Statistics
# --------------------------------------------------------------------------

def rose_effective_n(weight, weight2):
    """Effective sample size ``(sum w)^2 / sum w^2`` (Kish): equals the number of items when
    all weights are equal, and is smaller when a few heavy items dominate."""
    return (weight * weight / weight2) if weight2 > 0 else 0.0


def rose_rayleigh(r_bar, n):
    """``(Z, p)`` of the Rayleigh test of uniformity.

    ``r_bar`` is the mean resultant length of the (weighted) angles and ``n`` the sample size
    (the effective size for weighted data). ``Z = n * r_bar**2`` (Rayleigh's z) and
    ``p = exp(sqrt(1 + 4n + 4(n^2 - R^2)) - (1 + 2n))`` with ``R = n * r_bar``: the closed-form
    approximation of Zar, Biostatistical Analysis, as implemented in the CircStat toolbox
    (``circ_rtest``); for large n it tends to ``exp(-Z)``. ``(None, None)`` without data.
    """
    if r_bar is None or not n > 0:
        return None, None
    r_bar = min(1.0, max(0.0, float(r_bar)))
    big_r = n * r_bar
    z = n * r_bar * r_bar
    inner = 1.0 + 4.0 * n + 4.0 * max(0.0, n * n - big_r * big_r)
    p = math.exp(math.sqrt(inner) - (1.0 + 2.0 * n))
    return z, min(1.0, max(0.0, p))


def rose_stats(group, opts):
    """Circular (or axial) statistics of a group, weighted.

    ``mean`` (in the convention; axial: in ``[0, 180)``), ``resultant`` (mean resultant length
    R in 0..1; axial: of the doubled angles), ``std_deg`` (circular standard deviation
    ``sqrt(-2 ln R)`` in degrees; axial: of the doubled angles, halved), the fourfold
    ``ortho`` angle and ``ortho_r`` (axial only), and the Shannon entropy of the sector totals
    (bits, and divided by log2 of the number of bins). A mean is ``None`` when R is
    below 1e-9 (no preferred direction). ``rayleigh_z`` / ``rayleigh_p`` are the Rayleigh
    test of the same angles (axial: the doubled angles; ``ortho_p``: the quadrupled angles),
    ``n_eff`` the effective sample size and ``pref_dir`` True when ``rayleigh_p`` is below
    ``ROSE_RAYLEIGH_ALPHA``.
    """
    axial = opts["axial"]
    total = group.weight
    out = {"mean": None, "resultant": None, "std_deg": None, "ortho": None, "ortho_r": None,
           "entropy": None, "entropy_norm": None, "dom_sector": None, "dom_pct": None,
           "dom_dir": None, "n_eff": None, "rayleigh_z": None, "rayleigh_p": None,
           "pref_dir": None, "ortho_p": None}
    if group.n == 0 or not total > 0:
        return out
    n_eff = rose_effective_n(group.weight, group.weight2)
    out["n_eff"] = n_eff
    c, s = (group.sums[2], group.sums[3]) if axial else (group.sums[0], group.sums[1])
    resultant = min(1.0, math.hypot(c, s) / total)
    out["resultant"] = resultant
    out["rayleigh_z"], out["rayleigh_p"] = rose_rayleigh(resultant, n_eff)
    out["pref_dir"] = out["rayleigh_p"] < ROSE_RAYLEIGH_ALPHA
    if resultant >= ROSE_MIN_RESULTANT:
        mean = math.degrees(math.atan2(s, c))
        std = math.degrees(math.sqrt(max(0.0, -2.0 * math.log(resultant))))
        if axial:
            mean, std = mean / 2.0, std / 2.0
        out["mean"] = rose_from_bearing(rose_wrap(mean, 180.0 if axial else 360.0),
                                        opts["convention"], 180.0 if axial else 360.0)
        out["std_deg"] = std
    if axial:
        r4 = min(1.0, math.hypot(group.sums[4], group.sums[5]) / total)
        out["ortho_r"] = r4
        out["ortho_p"] = rose_rayleigh(r4, n_eff)[1]
        if r4 >= ROSE_MIN_RESULTANT:
            a4 = rose_wrap(math.degrees(math.atan2(group.sums[5], group.sums[4])) / 4.0, 90.0)
            out["ortho"] = rose_from_bearing(a4, opts["convention"], 90.0)
    weights = group.sector_weights()
    bins = rose_bin_count(opts["sectors"], axial)
    entropy = 0.0
    for w in weights.values():
        if w > 0:
            p = w / total
            entropy -= p * math.log(p, 2)
    out["entropy"] = max(0.0, entropy)
    out["entropy_norm"] = max(0.0, entropy) / math.log(bins, 2)
    best = max(sorted(weights), key=lambda k: weights[k])      # ties: smallest sector index
    out["dom_sector"] = best
    out["dom_pct"] = 100.0 * weights[best] / total
    centre = rose_sector_edges(best, opts["sectors"], opts["centered"])[2]
    out["dom_dir"] = rose_from_bearing(centre, opts["convention"], 180.0 if axial else 360.0)
    return out


# --------------------------------------------------------------------------
# Scale, anchors, petal geometry
# --------------------------------------------------------------------------

def rose_references(groups, opts):
    """``{group name: REF}``: the weight that maps to the full radius ``R``
    (largest sector total of the group, or of all groups with ``ALL_GROUPS``)."""
    own = {}
    for grp in groups:
        values = list(grp.sector_weights().values())
        own[grp.name] = max(values) if values else 0.0
    if opts["scale_mode"] == ROSE_SCALE_ALL:
        top = max(own.values()) if own else 0.0
        return dict((name, top) for name in own)
    return own


def rose_anchor(group, opts):
    """``(x, y)`` where the group's rose is centred, or ``None`` (no usable location)."""
    mode = opts["anchor_mode"]
    if mode == ROSE_ANCHOR_POINT:
        return opts["anchor_xy"]
    if mode == ROSE_ANCHOR_FIELDS:
        return group.field_xy
    if group.loc_n == 0:
        return None
    if mode == ROSE_ANCHOR_EXTENT:
        b = group.box
        return ((b[0] + b[2]) / 2.0, (b[1] + b[3]) / 2.0)
    if group.loc_weight > 0:
        return (group.loc_x / group.loc_weight, group.loc_y / group.loc_weight)
    b = group.box
    return ((b[0] + b[2]) / 2.0, (b[1] + b[3]) / 2.0)


def rose_nearest_distance(points):
    """Smallest distance between two different points of a list (sweep over x); ``None``
    when fewer than two distinct points exist."""
    pts = sorted(set((float(x), float(y)) for x, y in points))
    best = None
    for i, (x, y) in enumerate(pts):
        for j in range(i + 1, len(pts)):
            dx = pts[j][0] - x
            if best is not None and dx >= best:
                break
            d = math.hypot(dx, pts[j][1] - y)
            if d > 0 and (best is None or d < best):
                best = d
    return best


def rose_auto_radius(anchors, groups, opts):
    """``(radius in metres, how)``. With two or more distinct anchors: 40 % of the
    smallest distance between two anchors, so no two roses overlap. With one: 10 % of
    the diagonal of the extent of the data locations; 100 m if there is no extent."""
    mpu = opts["mpu"]
    nearest = rose_nearest_distance(anchors)
    if nearest is not None:
        return (ROSE_AUTO_NEIGHBOUR_SHARE * nearest * mpu,
                "{0:.0f} % of the smallest distance between two roses".format(
                    ROSE_AUTO_NEIGHBOUR_SHARE * 100))
    xs0, ys0, xs1, ys1 = [], [], [], []
    for grp in groups:
        if grp.box:
            xs0.append(grp.box[0])
            ys0.append(grp.box[1])
            xs1.append(grp.box[2])
            ys1.append(grp.box[3])
    if xs0:
        diag = math.hypot(max(xs1) - min(xs0), max(ys1) - min(ys0))
        if diag > 0:
            return (ROSE_AUTO_EXTENT_SHARE * diag * mpu,
                    "{0:.0f} % of the diagonal of the data extent".format(
                        ROSE_AUTO_EXTENT_SHARE * 100))
    return ROSE_DEFAULT_RADIUS_M, "{0:g} m (no extent to scale from)".format(ROSE_DEFAULT_RADIUS_M)


def rose_data_diagonal(groups):
    """Diagonal (map units) of the union of the location boxes of ``groups``; 0.0 when none."""
    boxes = [g.box for g in groups if g.box]
    if not boxes:
        return 0.0
    return math.hypot(max(b[2] for b in boxes) - min(b[0] for b in boxes),
                      max(b[3] for b in boxes) - min(b[1] for b in boxes))


def rose_radius_warning(plan, opts):
    """Warning text when the petals of ``plan`` would be too small to see, else ``None``.

    Any radius below ``ROSE_MIN_VISIBLE_RADIUS_M`` is warned (the petals collapse at the XY
    resolution of the output). An automatic radius is also warned when it is set by two roses
    that are much closer than the others: the closest distance between two roses is below
    ``ROSE_CLOSE_PAIR_DIAG_SHARE`` of the data diagonal and below
    ``ROSE_CLOSE_PAIR_SPACING_SHARE`` x the typical spacing (diagonal / sqrt(number of roses)),
    for example concentric zones or two sensors on one mast. A regular grid of many small roses
    is not warned."""
    radius = plan["radius_m"]
    mpu = opts["mpu"]
    automatic = plan.get("automatic", False)
    used = plan.get("used_anchors") or []
    diag_m = rose_data_diagonal(plan["groups"]) * mpu
    fix = (" Set Petal Radius (metres) to a size that suits the map, or choose another Rose "
           "Location (for example GROUP_EXTENT_CENTRE or FIELD_XY). The tables are not "
           "affected.")
    if automatic and len(used) >= 2 and diag_m > 0:
        nearest = rose_nearest_distance(used)
        if nearest is not None:
            nearest_m = nearest * mpu
            limit = min(ROSE_CLOSE_PAIR_DIAG_SHARE,
                        ROSE_CLOSE_PAIR_SPACING_SHARE / math.sqrt(len(set(used)))) * diag_m
            if nearest_m < limit:
                return ("The automatic petal radius is {0:.3g} m because the two closest roses "
                        "are only {1:.3g} m apart, while the data extend over {2:.3g} m: the "
                        "roses are tiny compared with the map (concentric groups, or several "
                        "groups at nearly one place?).{3}".format(radius, nearest_m, diag_m, fix))
    if radius < ROSE_MIN_VISIBLE_RADIUS_M:
        return ("The petal radius is only {0:.3g} m ({1}): the petals are about as small as the "
                "XY resolution of the output and cannot be seen on a map.{2}".format(
                    radius, plan["radius_how"], fix if automatic else
                    " Enter a larger Petal Radius. The tables are not affected."))
    return None


def rose_arc_steps(sectors):
    """Number of chords on the arc of one petal (the same for every petal)."""
    return max(2, int(math.ceil((360.0 / sectors) / ROSE_ARC_STEP_DEG)))


def rose_petal_ring(cx, cy, centre, width_deg, r_in, r_out, steps):
    """Ring (clockwise, open) of a petal: a wedge when ``r_in`` is 0, else an annular sector.

    ``centre`` / ``width_deg``: bearing of the middle and angular width; radii in map units.
    The vertices lie on circles of radius ``r * k`` with ``k = sqrt(w / (n sin(w / n)))``
    (``w`` the width in radians, ``n`` the chords), so the polygon area equals the exact
    sector area ``w / 2 * (r_out^2 - r_in^2)``.
    """
    width = math.radians(width_deg)
    k = math.sqrt(width / (steps * math.sin(width / steps)))
    angles = [math.radians(centre - width_deg / 2.0 + width_deg * i / steps)
              for i in range(steps + 1)]

    def arc(radius, seq):
        return [(cx + radius * k * math.sin(a), cy + radius * k * math.cos(a)) for a in seq]

    outer = arc(r_out, angles)
    if not r_in > 0:
        return [(cx, cy)] + outer
    return outer + arc(r_in, list(reversed(angles)))


def rose_bars(group, opts, ref):
    """Petals of a group as plain records (shared by the polygons and the PNG).

    Each record: ``sector, mirror, cls, centre`` (bearing the petal points to), ``r_in`` and
    ``r_out`` (fractions of ``R``: ``sqrt(cumulative weight / ref)``), ``n``, ``weight``. Empty
    sectors and classes give no record. Classes are stacked from the centre outwards, class 1 first.
    """
    if not ref > 0:
        return []
    classes = sorted(set(cls for (_s, cls) in group.bins))
    out = []
    mirrors = (0, 1) if opts["axial"] else (0,)
    for sector in sorted(group.sector_weights()):
        centre = rose_sector_edges(sector, opts["sectors"], opts["centered"])[2]
        cum = 0.0
        pieces = []
        for cls in classes:
            cell = group.bins.get((sector, cls))
            if not cell or not cell[1] > 0:
                continue
            r_in = math.sqrt(cum / ref)
            cum += cell[1]
            pieces.append((cls, r_in, math.sqrt(cum / ref), cell[0], cell[1]))
        for mirror in mirrors:
            for cls, r_in, r_out, n, weight in pieces:
                out.append({"sector": sector, "mirror": mirror, "cls": cls,
                            "centre": rose_wrap(centre + 180.0 * mirror), "r_in": r_in,
                            "r_out": r_out, "n": n, "weight": weight})
    return out


def rose_weight_by(opts):
    return "LENGTH_M" if opts["weight_length"] else "COUNT"


def rose_scale_rule(opts, radius_m, ref):
    """Text stored in every petal row: how area relates to weight."""
    return ("AREA IS PROPORTIONAL TO WEIGHT: R_OUT = R*SQRT(CUMULATIVE WEIGHT/REF); "
            "R = {0:g} m; REF = {1:.6g} ({2}){3}".format(
                radius_m, ref, opts["scale_mode"],
                "; EVERY AXIAL BIN IS DRAWN TWICE" if opts["axial"] else ""))


# --------------------------------------------------------------------------
# Output rows
# --------------------------------------------------------------------------

def _rose_echo(opts):
    return {"CONVENTION": opts["convention"], "AXIAL": 1 if opts["axial"] else 0,
            "DIR_SOURCE": opts["dir_source"], "NORTH_REF": opts["north_ref"],
            "SECT_ALIGN": "CENTERED" if opts["centered"] else "START",
            "WEIGHT_BY": rose_weight_by(opts)}


def rose_table_rows(groups, opts):
    """Frequency table: one row per group x bin x class (zeros included), as dicts keyed by
    ``ROSE_TABLE_FIELDS``. Axial data: ``sectors / 2`` bins, each listed once."""
    labels = rose_class_labels(opts["breaks"])
    classes = list(range(1, len(labels) + 1)) if opts["breaks"] else [0]
    bins = rose_bin_count(opts["sectors"], opts["axial"])
    echo = _rose_echo(opts)
    period = 180.0 if opts["axial"] else 360.0
    rows = []
    for grp in groups:
        for sector in range(bins):
            start, end, centre = rose_sector_edges(sector, opts["sectors"], opts["centered"])
            for cls in classes:
                n, weight = grp.bins.get((sector, cls), (0, 0.0))
                row = {"GROUP_NAME": grp.name, "SECTOR": sector, "BRG_START": start,
                       "BRG_END": end, "BRG_MID": centre,
                       "DIR_MID": rose_from_bearing(centre, opts["convention"], period),
                       "MAG_CLASS": cls, "MAG_LABEL": labels[cls - 1] if cls else "",
                       "N_ITEMS": n, "WEIGHT": weight,
                       "PCT_GROUP": 100.0 * weight / grp.weight if grp.weight > 0 else 0.0}
                row.update(echo)
                rows.append(row)
    return rows


def rose_plan(collector, radius_m=None):
    """Anchors, radius and references for a collector: ``{"groups", "anchors", "refs",
    "radius_m", "radius_how"}``."""
    opts = collector.opts
    groups = collector.ordered_groups()
    anchors = dict((g.name, rose_anchor(g, opts)) for g in groups)
    refs = rose_references(groups, opts)
    used = [anchors[g.name] for g in groups if anchors[g.name] is not None and g.n > 0]
    if radius_m:
        radius, how = float(radius_m), "given by the user"
    else:
        radius, how = rose_auto_radius(used, groups, opts)
    return {"groups": groups, "anchors": anchors, "refs": refs, "radius_m": radius,
            "radius_how": how, "automatic": not radius_m, "used_anchors": used}


def rose_summary_rows(plan, opts, crs_name=""):
    """Per-group summary rows, keyed by ``ROSE_SUMMARY_FIELDS``."""
    echo = _rose_echo(opts)
    stat_type = "AXIAL (DOUBLED ANGLES)" if opts["axial"] else "CIRCULAR"
    rows = []
    for order, grp in enumerate(plan["groups"], 1):
        st = rose_stats(grp, opts)
        anchor = plan["anchors"][grp.name]
        row = {"GROUP_NAME": grp.name, "GRP_ORDER": order, "N_ITEMS": grp.n,
               "WEIGHT": grp.weight, "N_EFF": st["n_eff"], "MEAN_DIR": st["mean"],
               "RESULT_R": st["resultant"], "RAYLEIGH_Z": st["rayleigh_z"],
               "RAYLEIGH_P": st["rayleigh_p"],
               "PREF_DIR": None if st["pref_dir"] is None else int(st["pref_dir"]),
               "CIRC_STD": st["std_deg"], "ORTHO_DIR": st["ortho"], "ORTHO_R": st["ortho_r"],
               "ORTHO_P": st["ortho_p"],
               "ENTROPY": st["entropy"], "ENT_NORM": st["entropy_norm"],
               "DOM_SECTOR": st["dom_sector"], "DOM_DIR": st["dom_dir"],
               "DOM_PCT": st["dom_pct"],
               "ANCHOR_X": anchor[0] if anchor else None,
               "ANCHOR_Y": anchor[1] if anchor else None,
               "R_MAX_M": plan["radius_m"] if anchor and plan["refs"][grp.name] > 0 else None,
               "REF_WEIGHT": plan["refs"][grp.name] if plan["refs"][grp.name] > 0 else None,
               "STAT_TYPE": stat_type, "CRS_NAME": crs_name}
        row.update(echo)
        rows.append(row)
    return rows


def rose_petal_records(plan, opts):
    """Petals as ``(ring, values dict)``; ring in map units around the group's anchor.
    Groups without an anchor or without weight give none (listed by the caller)."""
    labels = rose_class_labels(opts["breaks"])
    echo = _rose_echo(opts)
    steps = rose_arc_steps(opts["sectors"])
    width = 360.0 / opts["sectors"]
    radius_m = plan["radius_m"]
    mpu = opts["mpu"]
    out = []
    for grp in plan["groups"]:
        anchor = plan["anchors"][grp.name]
        ref = plan["refs"][grp.name]
        if anchor is None or not ref > 0:
            continue
        rule = rose_scale_rule(opts, radius_m, ref)
        for bar in rose_bars(grp, opts, ref):
            ring = rose_petal_ring(anchor[0], anchor[1], bar["centre"], width,
                                   bar["r_in"] * radius_m / mpu, bar["r_out"] * radius_m / mpu,
                                   steps)
            area = abs(ring_signed_area(list(ring) + [ring[0]])) * mpu * mpu
            values = {"GROUP_NAME": grp.name, "SECTOR": bar["sector"], "MIRROR": bar["mirror"],
                      "MAG_CLASS": bar["cls"],
                      "MAG_LABEL": labels[bar["cls"] - 1] if bar["cls"] else "",
                      "N_ITEMS": bar["n"], "WEIGHT": bar["weight"],
                      "PCT_GROUP": 100.0 * bar["weight"] / grp.weight, "BRG_MID": bar["centre"],
                      "R_IN_M": bar["r_in"] * radius_m, "R_OUT_M": bar["r_out"] * radius_m,
                      "AREA_M2": area, "SCALE_RULE": rule}
            values.update(echo)
            out.append((ring, values))
    return out


# --------------------------------------------------------------------------
# PNG (matplotlib is optional and imported only here)
# --------------------------------------------------------------------------

def rose_ramp(count):
    """``count`` blue shades, light to dark (one for a single class)."""
    if count <= 1:
        return ["#2a78d6"]
    light, dark = (0x9e, 0xc5, 0xf4), (0x0d, 0x36, 0x6b)
    out = []
    for i in range(count):
        t = i / float(count - 1)
        out.append("#{0:02x}{1:02x}{2:02x}".format(*[int(round(a + (b - a) * t))
                                                      for a, b in zip(light, dark)]))
    return out


# Typographic punctuation that the default matplotlib font (DejaVu Sans) draws and that needs no
# shaping: dashes, curly quotes, dagger and bullet, ellipsis, per mille, primes, single guillemets,
# euro and trade mark. Text pasted from a word processor carries these.
_ROSE_TEXT_EXTRA = frozenset(list(range(0x2010, 0x2016)) + list(range(0x2018, 0x2023))
                             + [0x2026, 0x2030, 0x2032, 0x2033, 0x2039, 0x203A, 0x20AC, 0x2122])
# Unusual spaces become a plain space (zero-width and direction controls are NOT accepted).
_ROSE_SPACES = {0x2002: " ", 0x2003: " ", 0x2007: " ", 0x2009: " ", 0x200A: " ", 0x202F: " ",
                0x205F: " "}


def rose_clean_text(text):
    """``text`` in Unicode NFC (a combining accent joins its letter, so ``e`` + U+0301 is ``é``),
    unusual spaces made plain and runs of white space collapsed. ``None`` gives ``""``."""
    if text is None:
        return ""
    out = unicodedata.normalize("NFC", str(text)).translate(_ROSE_SPACES)
    return " ".join(out.split())


def _rose_char_ok(ch):
    code = ord(ch)
    return 32 <= code < 0x250 and code != 0x7F or code in _ROSE_TEXT_EXTRA


def rose_unsupported_chars(text, limit=5):
    """The characters of ``text`` the poster and the PNG do not draw, as ``U+XXXX`` codes in order
    of first appearance (at most ``limit``), after ``rose_clean_text``."""
    seen = []
    for ch in rose_clean_text(text):
        code = "U+{0:04X}".format(ord(ch))
        if not _rose_char_ok(ch) and code not in seen:
            seen.append(code)
            if len(seen) >= limit:
                break
    return seen


def rose_is_latin(name):
    """True when ``name`` is non-empty text of Latin letters, digits, punctuation and common
    typographic punctuation (curly quotes, dashes, ellipsis; ``_ROSE_TEXT_EXTRA``) only, after
    ``rose_clean_text``. Arabic and other joined scripts are False: matplotlib does not shape them."""
    text = rose_clean_text(name)
    return bool(text) and all(_rose_char_ok(ch) for ch in text)


def rose_png_label(name, order):
    """Group label for the PNG: the name when it is plain Latin text, else ``G<order>``
    (matplotlib does not shape Arabic and other joined scripts)."""
    text = rose_clean_text(name)
    if rose_is_latin(text):
        return text if len(text) <= 26 else text[:25] + "..."
    return "G{0}".format(order)


def rose_independence_text(opts):
    """Who breaks the independence the tests assume, worded for the input (as on the poster)."""
    noun = rose_item_noun(opts)
    if noun in ("segments", "line parts"):
        return "neighbouring {0}".format(noun)
    return "records repeated at one place or neighbouring in space or time often"


def rose_item_noun(opts):
    """What one counted item is, for the PNG (N_ITEMS counts segments, not features)."""
    source = opts.get("dir_source", "")
    if source == "SEGMENT":
        return "segments"
    if source == "WHOLE_LINE":
        return "line parts"
    return "directions"


def rose_p_text(p):
    """``p = 0.83`` / ``p < 0.0001`` (``p = n/a`` without data)."""
    if p is None:
        return "p = n/a"
    if p < 1e-4:
        return "p < 0.0001"
    return "p = {0:.2g}".format(p) if p < 0.1 else "p = {0:.2f}".format(p)


def rose_grid_is_stronger(axial, resultant, ortho, ortho_r, ortho_p):
    """True when an axial group's square-grid pattern is the stronger one: the grid test rejects
    uniformity and ORTHO_R is above the resultant length. This is the rule the poster uses to
    headline the grid instead of the axial mean; the PNG and the messages then name the grid too,
    so the outputs of one run never disagree without saying why."""
    return bool(axial and ortho is not None and ortho_p is not None
                and ortho_p < ROSE_RAYLEIGH_ALPHA and resultant is not None
                and ortho_r is not None and ortho_r > resultant + 1e-9)


def rose_png_direction_text(stats, opts):
    """Text of the direction statistic in a PNG panel title.

    A mean direction is shown only when the Rayleigh test of uniformity rejects uniformity
    (``rayleigh_p`` below ``ROSE_RAYLEIGH_ALPHA``; axial: the test of the doubled angles); the
    test takes the sample size into account, a fixed limit on the resultant length does not.
    An axial group whose doubled-angle test fails but whose quadrupled-angle test (``ortho_p``)
    rejects uniformity shows the square-grid angle instead (the axial mean of a perfect grid is
    not a direction). Otherwise: ``no preferred direction``.
    """
    mean, p = stats.get("mean"), stats.get("rayleigh_p")
    if mean is not None and p is not None and p < ROSE_RAYLEIGH_ALPHA:
        text = "{0} {1}".format("axial mean" if opts["axial"] else "mean",
                                rose_angle_text(mean, 180.0 if opts["axial"] else 360.0))
        if rose_grid_is_stronger(opts["axial"], stats.get("resultant"), stats.get("ortho"),
                                 stats.get("ortho_r"), stats.get("ortho_p")):
            text += "; grid {0} is stronger".format(rose_angle_text(stats["ortho"], 90.0))
        return text
    p4 = stats.get("ortho_p")
    if opts["axial"] and stats.get("ortho") is not None and p4 is not None \
            and p4 < ROSE_RAYLEIGH_ALPHA:
        return "grid angle {0} ({1})".format(rose_angle_text(stats["ortho"], 90.0),
                                             rose_p_text(p4))
    return "no preferred direction"


def rose_panel_lines(label, grp, stats, opts):
    """The four lines above a PNG panel: name, n and resultant length, the Rayleigh test, the
    verdict. The resultant length is spelled out (the letter R is not used in the picture)."""
    n_text = "n = {0} {1}".format(grp.n, rose_item_noun(opts))
    res = stats["resultant"]
    line2 = "{0}, resultant length {1}".format(n_text, "n/a" if res is None else "{0:.2f}".format(res))
    z = stats.get("rayleigh_z")
    line3 = "Rayleigh Z = {0}, {1}{2}".format("n/a" if z is None else "{0:.2f}".format(z),
                                                rose_p_text(stats.get("rayleigh_p")),
                                                " (doubled angles)" if opts["axial"] else "")
    verdict = rose_png_direction_text(stats, opts)
    return [label, line2, line3, verdict]


def rose_nice_values(limit, integers):
    """Round numbers (1, 2, 5 times a power of ten) not above ``limit``, largest first."""
    out = []
    if not limit > 0:
        return out
    exp = int(math.floor(math.log10(limit)))
    for e in range(exp, exp - 4, -1):
        for m in (5, 2, 1):
            value = m * 10.0 ** e
            if value <= limit and (not integers or value >= 1):
                out.append(value)
    return out


def rose_scale_rings(ref, opts):
    """Weights (counts or metres) at which the PNG draws a ring inside the REF ring: up to two
    round numbers whose radii ``sqrt(w / ref)`` are at least 0.2 apart and below 0.9."""
    rings = []
    for value in rose_nice_values(0.8 * ref, not opts["weight_length"]):
        rho = math.sqrt(value / ref)
        if rho > 0.9 or any(abs(rho - math.sqrt(v / ref)) < 0.2 for v in rings):
            continue
        rings.append(value)
        if len(rings) == 2:
            break
    return rings


def rose_weight_text(value, opts):
    """A weight as text: ``1,234`` (count) or ``1,234 m`` / ``12.5 km`` (length)."""
    if not opts["weight_length"]:
        return "{0:,.0f}".format(value)
    if value >= 10000:
        return "{0:,.1f} km".format(value / 1000.0).replace(".0 km", " km")
    return "{0:,.0f} m".format(value)


def rose_png_available():
    """True when matplotlib can be imported."""
    try:
        __import__("matplotlib")
    except Exception:
        return False
    return True


def rose_png_ring_caption(grp, ref, opts):
    """Caption under a PNG panel: the value of the dashed ring (``ref``) and what it is.

    PER_GROUP: the ring is the group's own largest sector, given with its share of the group.
    ALL_GROUPS: the ring is the largest sector of ALL groups, which can exceed the weight of a
    small group, so no share of the group is printed for it; the group's own largest sector and
    its share are given instead (a share above 100 % is never printed)."""
    if opts["scale_mode"] == ROSE_SCALE_PER_GROUP:
        return "dashed ring = {0} ({1:.0f} % of the group)".format(
            rose_weight_text(ref, opts), 100.0 * ref / grp.weight)
    weights = grp.sector_weights()
    own = max(weights.values()) if weights else 0.0
    return "dashed ring = {0} (largest sector of all groups); largest here {1} ({2:.0f} % of " \
           "the group)".format(rose_weight_text(ref, opts), rose_weight_text(own, opts),
                               100.0 * own / grp.weight if grp.weight > 0 else 0.0)


# The dashed ring of the PNG: dark, with a white halo, drawn above the petals, so it stays visible
# where a petal ends exactly at it (a dark petal under a light grey ring hid the ring there).
ROSE_PNG_RING_COLOUR = "#1a1a19"
ROSE_PNG_RING_HALO = 2.4          # points of white stroke around each dash
ROSE_PNG_CAPTION_SIZE = 6.8       # points
ROSE_PNG_CAPTION_CHARS_PER_IN = 17  # 6.8 pt DejaVu Sans averages about 19 characters per inch


def rose_png_caption_lines(text, panel_in):
    """``text`` (a ring caption) broken into lines that fit a panel ``panel_in`` inches wide.

    The caption is first split at "; " (under ALL_GROUPS: the ring value / the group's own largest
    sector), then every part is wrapped to ``int(panel_in * 17)`` characters, so no line is wider than
    its panel (a 6.8 pt line of that many characters is about 0.9 x the panel width at most)."""
    width = max(12, int(panel_in * ROSE_PNG_CAPTION_CHARS_PER_IN))
    return "\n".join(textwrap.fill(part, width) for part in text.split("; "))


def rose_render_png(path, plan, opts, crs_note=""):
    """Write the polar bar charts of the groups to ``path``; returns ``(groups drawn, note)``.

    Uses matplotlib's object API with the Agg canvas (no pyplot, no global state). Raises
    ``ImportError`` when matplotlib is missing. At most ``ROSE_MAX_PNG_GROUPS`` groups (the
    heaviest) are drawn. Bars use the same radii as the map petals. Every panel has rings
    labelled with weights (counts or metres), because the radius is a square root of the weight,
    and says in words what n counts.
    """
    from matplotlib.backends.backend_agg import FigureCanvasAgg
    from matplotlib.figure import Figure
    from matplotlib.patches import Patch
    import matplotlib.patheffects as patheffects

    groups = [g for g in plan["groups"] if g.n > 0]
    note = ""
    if len(groups) > ROSE_MAX_PNG_GROUPS:
        keep = set(id(g) for g in sorted(groups, key=lambda g: -g.weight)[:ROSE_MAX_PNG_GROUPS])
        note = "The {0} heaviest of {1} groups are drawn.".format(ROSE_MAX_PNG_GROUPS, len(groups))
        groups = [g for g in groups if id(g) in keep]
    order = dict((g.name, i) for i, g in enumerate(plan["groups"], 1))
    cols = min(4, max(1, len(groups)))
    rows = int(math.ceil(len(groups) / float(cols))) if groups else 1
    unit = "length (m)" if opts["weight_length"] else "count"
    title = "Rose diagram. Convention: {0}. AXIAL: {1}.".format(
        opts["convention"], "on (each bin drawn twice)" if opts["axial"] else "off")
    meaning = "{0} = {1}".format(opts["convention"], ROSE_CONVENTION_TEXT[opts["convention"]])
    sub = "{0} sectors, {1}. Directions from {2}, {3}; north = {4}.".format(
        opts["sectors"], "centred on north" if opts["centered"] else "starting at north",
        opts["dir_source"],
        "weighted by length in metres" if opts["weight_length"] else "every item counts 1",
        "grid north of the data's projection" if opts["north_ref"] == "GRID" else "as stored")
    per_group = opts["scale_mode"] == ROSE_SCALE_PER_GROUP
    foot = ("Petal AREA is proportional to the {0}, so the radius grows with its square root: the "
            "dashed outer ring is the largest sector of {1} (its value is printed under each "
            "rose) and the dotted rings are round weights. Rayleigh test of uniformity (axial: of "
            "the doubled angles; grid angle: of the quadrupled angles): Z = n_eff x resultant "
            "length squared, n_eff = (sum of weights)^2 / sum of squared weights (= n when every "
            "item counts 1); a direction is shown only when p < {2:g}. The {3} are treated as "
            "independent, which {4} are not, so p is optimistic.".format(
                unit, "each group" if per_group else "all groups", ROSE_RAYLEIGH_ALPHA,
                rose_item_noun(opts), rose_independence_text(opts)))
    if note:
        foot += " " + note
    if any(not rose_is_latin(g.name) for g in groups):
        foot += " Groups named G<n> have non-Latin names: see GRP_ORDER in the summary table."
    if crs_note:
        foot += " " + crs_note
    if not per_group and groups:
        # Said in the returned note (the tool prints it) as well as under every panel.
        overall = max(plan["refs"][g.name] for g in groups)
        note = (note + " " if note else "") + (
            "ALL_GROUPS: every dashed ring is the largest sector of all groups ({0}); under each "
            "rose the group's own largest sector and its share of the group are printed.".format(
                rose_weight_text(overall, opts)))
    # Text blocks are wrapped by hand and every block gets the height of its lines, so the
    # header, the panel titles, the legend and the footer can never overlap (about 13
    # characters per inch at 8.5 pt, 15 at 7.5 pt; a line takes size * 1.2 * 1.55 / 72 inch).
    fig_w = max(3.6 * cols, 6.8)
    title_text = textwrap.fill(title, int(fig_w * 11))
    detail = "\n".join(textwrap.fill(t, int(fig_w * 13)) for t in (meaning, sub))
    foot_text = textwrap.fill(foot, int(fig_w * 17))
    title_in = 0.10 + 0.26 * (title_text.count("\n") + 1)
    detail_in = 0.22 * (detail.count("\n") + 1)
    foot_in = 0.10 + 0.17 * (foot_text.count("\n") + 1)
    legend_in = 0.65 if opts["breaks"] else 0.0
    panel_title_in = 0.95                                     # four lines above every panel
    head_in = title_in + detail_in + panel_title_in + 0.15
    bottom_in = foot_in + legend_in + 0.30                    # the last part: the S labels
    axes_in = 3.0
    # Ring captions are wrapped to the width of one panel (the figure width over the columns);
    # every caption line beyond the first adds its height under each row of roses.
    panel_in = fig_w * 0.90 / cols
    captions = dict((g.name, rose_png_caption_lines(
        rose_png_ring_caption(g, plan["refs"][g.name], opts), panel_in)) for g in groups)
    extra_lines = max([c.count("\n") for c in captions.values()] or [0])
    caption_in = 0.15 * extra_lines
    # S label (to 0.57 in under the axes, where the caption starts), the caption lines (0.14 in each)
    # and the four title lines of the next row with their pad (0.79 in), plus a margin.
    gap_in = 1.55 + caption_in
    bottom_in += caption_in
    fig_height = head_in + axes_in * rows + gap_in * (rows - 1) + bottom_in + 0.35
    fig = Figure(figsize=(fig_w, fig_height), dpi=150)
    FigureCanvasAgg(fig)
    labels = rose_class_labels(opts["breaks"])
    colours = rose_ramp(len(labels))
    width = math.radians(360.0 / opts["sectors"])
    halo = [patheffects.withStroke(linewidth=2.0, foreground="white")]
    circle = [math.radians(d) for d in range(0, 361, 5)]
    for i, grp in enumerate(groups):
        ax = fig.add_subplot(rows, cols, i + 1, projection="polar")
        ax.set_theta_zero_location("N")
        ax.set_theta_direction(-1)
        ref = plan["refs"][grp.name]
        for value in rose_scale_rings(ref, opts):
            rho = math.sqrt(value / ref)
            ax.plot(circle, [rho] * len(circle), color="#c4c3bc", linewidth=0.6,
                    linestyle=(0, (1, 2)), zorder=0.5)
            ax.text(math.radians(135), rho, rose_weight_text(value, opts), fontsize=6,
                    color="#6b6a66", ha="center", va="center", zorder=5, path_effects=halo)
        for bar in rose_bars(grp, opts, ref):
            ax.bar(math.radians(bar["centre"]), bar["r_out"] - bar["r_in"], width=width,
                   bottom=bar["r_in"], color=colours[bar["cls"] - 1 if opts["breaks"] else 0],
                   edgecolor="white", linewidth=0.6, align="center", zorder=2)
        ax.plot(circle, [1.0] * len(circle), color=ROSE_PNG_RING_COLOUR, linewidth=0.9,
                linestyle=(0, (3, 3)), zorder=4, clip_on=False,
                path_effects=[patheffects.withStroke(linewidth=ROSE_PNG_RING_HALO, foreground="white")])
        ax.set_ylim(0, 1.0)
        ax.set_yticks([])
        ax.spines["polar"].set_visible(False)
        ax.set_xticks([math.radians(d) for d in (0, 90, 180, 270)])
        ax.set_xticklabels(["N", "E", "S", "W"], fontsize=8, color="#52514e")
        ax.tick_params(axis="x", pad=2)
        ax.grid(color="#d9d8d2", linewidth=0.5)
        st = rose_stats(grp, opts)
        lines = rose_panel_lines(rose_png_label(grp.name, order[grp.name]), grp, st, opts)
        ax.set_title("\n".join(lines), fontsize=8, color="#1a1a19", pad=12, linespacing=1.25)
        ax.text(0.5, -0.19, captions[grp.name], transform=ax.transAxes, ha="center", va="top",
                fontsize=ROSE_PNG_CAPTION_SIZE, color="#6b6a66", linespacing=1.2)
    fig.text(0.5, 1.0 - 0.08 / fig_height, title_text, ha="center", va="top", fontsize=10,
             color="#1a1a19", linespacing=1.2)
    fig.text(0.5, 1.0 - (title_in + 0.04) / fig_height, detail, ha="center", va="top",
             fontsize=8.5, color="#52514e", linespacing=1.2)
    fig.text(0.5, 0.06 / fig_height, foot_text, ha="center", va="bottom", fontsize=7,
             color="#52514e", linespacing=1.25)
    if opts["breaks"]:
        handles = [Patch(facecolor=colours[i], edgecolor="white", label=labels[i])
                   for i in range(len(labels))]
        fig.legend(handles=handles, loc="lower center", ncol=min(len(labels), 8), fontsize=8,
                   frameon=False, bbox_to_anchor=(0.5, foot_in / fig_height),
                   title="Magnitude class", title_fontsize=8)
    fig.subplots_adjust(left=0.05, right=0.95, top=1.0 - head_in / fig_height,
                        bottom=(bottom_in + 0.35) / fig_height,
                        hspace=gap_in / axes_in, wspace=0.28)
    fig.savefig(path, dpi=150, facecolor="white")
    return len(groups), note


# --------------------------------------------------------------------------
# Poster: the map of the features coloured by direction bin next to the rose
# (matplotlib is optional and imported only inside rose_render_poster)
# --------------------------------------------------------------------------

_DEG = u"°"
_POSTER_STYLE = {
    "DARK": {"bg": "#0e141b", "text": "#eef1f5", "muted": "#98a3b3", "accent": "#ffd166",
             "ring": "#3a4656", "outer": "#6b7889", "grid": "#222c38", "lum": 0.62, "sat": 0.80},
    "LIGHT": {"bg": "#fbfaf7", "text": "#1a1a19", "muted": "#52514e", "accent": "#9a5b00",
              "ring": "#c4c3bc", "outer": "#8a8982", "grid": "#e3e2dc", "lum": 0.42, "sat": 0.78},
}


def rose_poster_palette(bins, theme="DARK"):
    """One ``(r, g, b)`` per bin around a closed hue cycle (the last bin is next to the first,
    so the two ends of an axial rose meet in colour)."""
    style = _POSTER_STYLE[theme]
    return [colorsys.hls_to_rgb((k / float(bins) + 0.02) % 1.0, style["lum"], style["sat"])
            for k in range(bins)]


def rose_poster_verdict(stats, opts):
    """What the poster says about the direction: ``{"kind", "headline", "detail", "angles"}``.

    ``kind`` is ``grid`` (axial, the grid test rejects uniformity and the axial mean is not the
    stronger pattern), ``axis`` (axial mean), ``mean`` (circular mean) or ``none`` (the tests do
    not reject uniformity at ``ROSE_RAYLEIGH_ALPHA``). ``angles`` are the BEARINGS (clockwise from
    north) of the lines the poster draws over the rose. Angles are printed as bearings, because
    north is up in the picture; with ``ARITHMETIC`` the stored-convention value is added.
    """
    conv = opts["convention"]
    axial = opts["axial"]
    north = "grid north" if opts["north_ref"] == "GRID" else "north"
    p2, p4 = stats.get("rayleigh_p"), stats.get("ortho_p")
    res, r4 = stats.get("resultant"), stats.get("ortho_r")
    mean_ok = stats.get("mean") is not None and p2 is not None and p2 < ROSE_RAYLEIGH_ALPHA
    grid_ok = bool(axial and stats.get("ortho") is not None and p4 is not None
                   and p4 < ROSE_RAYLEIGH_ALPHA)

    def bearing(value, period):
        return rose_wrap(rose_to_bearing(value, conv), period)

    def note(value, period):
        if conv != "ARITHMETIC":
            return ""
        return " (ARITHMETIC value {0})".format(rose_angle_text(value, period))

    res_text = "n/a" if res is None else "{0:.2f}".format(res)
    if grid_ok and not (mean_ok and res is not None and r4 is not None and res >= r4 - 1e-9):
        a = bearing(stats["ortho"], 90.0)
        shown = rose_round_angle(a, 90.0)
        # The first angle carries the callout: when rounding wraps (89.97 -> 0.0) start at the
        # line near north so the callout and the headline print the same number.
        first = 3 if round(a, 1) >= 90.0 else 0
        return {"kind": "grid",
                "angles": [rose_wrap(a + 90.0 * ((first + k) % 4)) for k in range(4)],
                "headline": "Dominant grid: {0:.1f}{1} from {2}".format(shown, _DEG, north),
                "detail": "axes cluster on {0:.1f}{1} and {2:.1f}{1}{3}   |   grid test {4}, "
                          "ORTHO_R {5:.2f}".format(shown, _DEG, shown + 90.0,
                                                   note(stats["ortho"], 90.0), rose_p_text(p4),
                                                   r4)}
    if mean_ok:
        period = 180.0 if axial else 360.0
        m = bearing(stats["mean"], period)
        shown = rose_round_angle(m, period)
        if axial:
            # 179.98 prints as 0.0: put the line near north first, it carries the callout
            angles = [m, rose_wrap(m + 180.0)]
            if round(m, 1) >= 180.0:
                angles.reverse()
            return {"kind": "axis", "angles": angles,
                    "headline": "Dominant axis: {0:.1f}{1} from {2}".format(shown, _DEG, north),
                    "detail": "axial mean{0}   |   Rayleigh {1}, resultant length {2}".format(
                        note(stats["mean"], period), rose_p_text(p2), res_text)}
        return {"kind": "mean", "angles": [m],
                "headline": "Mean direction: {0:.1f}{1} from {2}".format(shown, _DEG, north),
                "detail": "circular mean{0}   |   Rayleigh {1}, resultant length {2}".format(
                    note(stats["mean"], period), rose_p_text(p2), res_text)}
    return {"kind": "none", "angles": [], "headline": "No dominant direction",
            "detail": "Rayleigh {0}, resultant length {1}: no preferred direction at the {2:g} "
                      "level".format(rose_p_text(p2), res_text, ROSE_RAYLEIGH_ALPHA)}


def rose_poster_default_title(opts):
    """Title used when the user gives none."""
    if opts.get("dir_source") in ("SEGMENT", "WHOLE_LINE"):
        return "Which way do the lines point?"
    return "Which way do the features point?"


def rose_poster_shared_text(shared):
    """Footnote sentence for points that share a location on the poster map (``shared`` from
    ``rose_poster_locations`` / ``rose_render_poster``), or "" when no two points share one."""
    if not shared or not shared.get("locations"):
        return ""
    how = ("each such location is drawn as one pie of the direction bins of its points (slice = "
           "share of the points)" if shared.get("pies") else
           "each such location is drawn as one dot in the colour of the most frequent direction "
           "bin of its points (ties: the lowest bin number)")
    return ("{0:,} of the {1:,} points on the map share {2:,} location(s); {3}.".format(
        shared["points"], shared["drawn"], shared["locations"], how))


def rose_poster_locations(sample):
    """Points of a ``RoseMapSample`` grouped by exact location: ``[(x, y, {bin: count})]`` in the
    order of first appearance. Repeated records at one place (a wind station) sit on the same
    XY; drawn one by one only the last colour would be visible."""
    if sample is None or not sample.points:
        return []
    where = {}
    order = []
    for x, y, b in zip(sample.x1, sample.y1, sample.bin):
        key = (x, y)
        cell = where.get(key)
        if cell is None:
            cell = where[key] = {}
            order.append(key)
        cell[b] = cell.get(b, 0) + 1
    return [(k[0], k[1], where[k]) for k in order]


def rose_poster_footnote(group, stats, opts, meta, sample, verdict, trimmed=False, shared=None):
    """The honest footnote of the poster: n and what it counts, units, source, convention,
    weighting, bearing reference, colour meaning and the caveat that the Rayleigh / grid test treats
    the items as independent (optimistic for neighbouring street segments)."""
    noun = rose_item_noun(opts)
    conv = opts["convention"]
    width = 360.0 / opts["sectors"]
    parts = ["n = {0:,} {1}".format(group.n, noun)]
    features = meta.get("features")
    if features and noun in ("segments", "line parts"):
        parts[0] += " from {0:,} features".format(features)
    if opts["weight_length"]:
        parts[0] += "; total length {0}".format(rose_weight_text(group.weight, opts))
    parts[0] += "."
    if meta.get("source"):
        parts.append("Source: {0}.".format(meta["source"]))
    parts.append("Convention {0}: {1}.".format(conv, ROSE_CONVENTION_TEXT[conv]))
    parts.append("Axial: a direction and its opposite are one axis (each bin is drawn twice)."
                 if opts["axial"] else "Not axial: a direction and its opposite are different.")
    parts.append("{0} sectors of {1:g} degrees, {2}.".format(
        opts["sectors"], width, "centred on north" if opts["centered"] else "starting at north"))
    parts.append("Weighted by length in metres." if opts["weight_length"]
                 else "Every item counts 1.")
    if opts["north_ref"] == "GRID":
        parts.append("Bearings are grid bearings{0}, not true bearings.".format(
            " of " + meta["crs_note"] if meta.get("crs_note") else ""))
    else:
        parts.append("Directions are used as stored.")
    parts.append("Colour = direction, one hue per {0:g} degree bin{1}.".format(
        width, " (a bin and its opposite share a colour)" if opts["axial"] else ""))
    if opts["breaks"]:
        parts.append("Magnitude classes are not shown: a petal is the total of all classes.")
    if meta.get("has_group_field"):
        parts.append("All groups are combined; the tables keep one row per group.")
    parts.append(
        "The Rayleigh test{0} {1} the {2} as independent, which {3} are not, so "
        "{4} optimistic; read the resultant length for the strength.".format(
            " and the grid test (of the quadrupled angles)" if opts["axial"] else "",
            "treat" if opts["axial"] else "treats", noun,
            rose_independence_text(opts),
            "they are" if opts["axial"] else "it is"))
    if sample is not None and sample.sampled:
        parts.append("The map shows a random sample of {0:,} of {1:,} {2} (fixed seed); the rose "
                     "and all numbers use every one.".format(len(sample), sample.offered, noun))
    text = rose_poster_shared_text(shared)
    if text:
        parts.append(text)
    if trimmed:
        parts.append("The map window leaves out far outliers.")
    if meta.get("generator"):
        parts.append("Computed by {0}.".format(meta["generator"]))
    return " ".join(parts)


def _rose_poster_window(sample):
    """``(x0, x1, y0, y1, trimmed)`` of the map window: the extent of everything kept, or of the
    middle 99 % of the centres when a few far outliers would shrink the rest to a speck."""
    if sample.points:
        xs, ys = list(sample.x1), list(sample.y1)
    else:
        xs, ys = list(sample.x1) + list(sample.x2), list(sample.y1) + list(sample.y2)
    full = (min(xs), max(xs), min(ys), max(ys))
    centres = sample.centres()
    n = len(centres)
    if n >= 200:
        cx = sorted(c[0] for c in centres)
        cy = sorted(c[1] for c in centres)
        lo, hi = int(0.005 * n), n - 1 - int(0.005 * n)
        cut = (cx[lo], cx[hi], cy[lo], cy[hi])
        if (full[1] - full[0] > 3.0 * (cut[1] - cut[0])
                or full[3] - full[2] > 3.0 * (cut[3] - cut[2])):
            return cut + (True,)
    return full + (False,)


def _rose_poster_arrow_corner(sample, window):
    """Where the north arrow can sit without covering data: ``"TR"``, ``"TL"``, ``"BR"``, ``"BL"``
    (the first corner of the map window whose arrow box no kept item touches), or ``None`` when all
    four corners are taken (the caller then adds head room above the map).

    The box is 0.07 x 0.14 of the longer side of the window. A segment counts as touching the box
    when the bounding box of the segment does (a little over-careful, never under-careful).
    """
    x0, x1, y0, y1 = window[:4]
    span = max(x1 - x0, y1 - y0)
    if not span > 0:
        return "TR"
    bw, bh = 0.07 * span, 0.14 * span
    boxes = (("TR", x1 - bw, x1, y1 - bh, y1), ("TL", x0, x0 + bw, y1 - bh, y1),
             ("BR", x1 - bw, x1, y0, y0 + bh), ("BL", x0, x0 + bw, y0, y0 + bh))
    if sample.points:
        items = zip(sample.x1, sample.y1, sample.x1, sample.y1)
    else:
        items = zip(sample.x1, sample.y1, sample.x2, sample.y2)
    free = dict((name, True) for name, _a, _b, _c, _d in boxes)
    for ax_, ay_, bx_, by_ in items:
        lo_x, hi_x = (ax_, bx_) if ax_ <= bx_ else (bx_, ax_)
        lo_y, hi_y = (ay_, by_) if ay_ <= by_ else (by_, ay_)
        for name, bx0, bx1, by0, by1 in boxes:
            if free[name] and lo_x <= bx1 and hi_x >= bx0 and lo_y <= by1 and hi_y >= by0:
                free[name] = False
        if not any(free.values()):
            return None
    for name, _a, _b, _c, _d in boxes:
        if free[name]:
            return name
    return None


def _rose_poster_callout_angle(angle):
    """The angle at which the callout text is placed. The dashed line keeps the true angle; the text
    moves 14 degrees to the side when it would sit on the N, E, S or W label of the rose."""
    nearest = 90.0 * round(angle / 90.0)
    diff = angle - nearest
    if abs(diff) < 14.0:
        return nearest + (14.0 if diff >= 0 else -14.0)
    return angle


def rose_poster_available():
    """True when matplotlib can be imported (the poster needs it)."""
    return rose_png_available()


def rose_render_poster(path, group, sample, opts, meta, theme="DARK"):
    """Write the poster to ``path`` (2400 x 1260 pixels, deterministic: no randomness, no time stamp).

    Left: the features as a map (no basemap), every segment or point coloured by the bin of its
    direction (points that share one location: one pie of their bins, or one dot of the most
    frequent bin beyond ``ROSE_POSTER_PIE_CAP`` such locations; the footnote says so), with a
    scale bar and a north mark. Right: the rose of the same data (petal AREA
    proportional to the weight, the same colours, dotted rings at round weights, the dashed ring
    at the largest sector) with the dominant orientation marked. Above: title, the callout
    (``rose_poster_verdict``) and the statistics; below: the footnote (``rose_poster_footnote``).

    ``group`` is the ``RoseGroup`` to describe (``RoseCollector.poster_group()``); ``sample`` a
    ``RoseMapSample`` (or ``None``: no map); ``meta``: ``title``, ``source``, ``crs_note``,
    ``features``, ``generator``, ``scale_bar``. Raises ``ImportError`` without matplotlib and
    ``ValueError`` for an unknown theme or an empty group; ``meta["has_group_field"]`` adds the note that groups are combined. Returns a dict with ``size`` (pixels),
    ``kind`` and ``headline`` of the callout, ``drawn`` and ``offered`` items of the map, and for
    checks of the map furniture ``scale_bar_m`` (metres, or ``None``), ``arrow_x`` and
    ``map_xlim`` (map units). A window narrower than ``ROSE_POSTER_MIN_WIDTH`` times its height is
    widened around its middle first.
    """
    if theme not in _POSTER_STYLE:
        raise ValueError("theme must be one of {0}".format(", ".join(ROSE_POSTER_THEMES)))
    if group is None or group.n == 0 or not group.weight > 0:
        raise ValueError("the poster needs at least one direction")
    from matplotlib.backends.backend_agg import FigureCanvasAgg
    from matplotlib.collections import LineCollection
    from matplotlib.figure import Figure

    style = _POSTER_STYLE[theme]
    stats = rose_stats(group, opts)
    verdict = rose_poster_verdict(stats, opts)
    bins = rose_bin_count(opts["sectors"], opts["axial"])
    colours = rose_poster_palette(bins, theme)
    weights = group.sector_weights()
    ref = max(weights.values())
    fw, fh = ROSE_POSTER_SIZE_IN
    fig = Figure(figsize=(fw, fh), dpi=ROSE_POSTER_DPI, facecolor=style["bg"])
    FigureCanvasAgg(fig)

    window = _rose_poster_window(sample) if sample is not None and len(sample) else None
    trimmed = bool(window and window[4])
    # Points at one location (repeated records of a station) would hide each other: they are
    # drawn as one pie (or, beyond ROSE_POSTER_PIE_CAP such locations, one dot of the most
    # frequent bin) and the footnote says so.
    places = rose_poster_locations(sample) if window is not None else []
    multi = [loc for loc in places if sum(loc[2].values()) > 1]
    shared = {"drawn": len(sample) if sample is not None else 0, "locations": len(multi),
              "points": sum(sum(loc[2].values()) for loc in multi),
              "pies": 0 < len(multi) <= ROSE_POSTER_PIE_CAP}
    title = textwrap.fill(meta.get("title") or rose_poster_default_title(opts), 56)
    headline = textwrap.fill(verdict["headline"], 80)
    detail = textwrap.fill(verdict["detail"], 150)
    foot = textwrap.fill(rose_poster_footnote(group, stats, opts, meta, sample, verdict, trimmed,
                                              shared), 188)
    # vertical layout in inches from the top: title, headline, detail, then the plots, then the footnote
    title_h = 0.36 * (title.count("\n") + 1)
    head_h = 0.27 * (headline.count("\n") + 1)
    detail_h = 0.19 * (detail.count("\n") + 1)
    y_title = 0.22
    y_head = y_title + title_h + 0.04
    y_detail = y_head + head_h + 0.02
    plot_top = y_detail + detail_h + 0.18
    foot_h = 0.131 * (foot.count("\n") + 1)
    foot_top = fh - 0.2 - foot_h
    plot_bottom = foot_top - 0.15

    def top(inch):
        return 1.0 - inch / fh

    fig.text(0.03, top(y_title), title, color=style["text"], fontsize=19, fontweight="bold",
             ha="left", va="top", linespacing=1.15)
    fig.text(0.03, top(y_head), headline, color=style["accent"], fontsize=12.5, ha="left",
             va="top")
    fig.text(0.03, top(y_detail), detail, color=style["muted"], fontsize=8.5, ha="left",
             va="top", linespacing=1.3)
    fig.text(0.03, top(foot_top), foot, color=style["muted"], fontsize=7, ha="left", va="top",
             linespacing=1.35)

    # --- left: the features, one colour per direction bin
    map_h = plot_bottom - plot_top
    ax = fig.add_axes([0.02, 1.0 - plot_bottom / fh, 0.56, map_h / fh], facecolor=style["bg"])
    ax.axis("off")
    drawn = 0
    bar_m = None
    arrow_x = None
    xlim = None
    if window is None:
        ax.text(0.5, 0.5, "no geometry to draw", color=style["muted"], fontsize=10, ha="center",
                va="center", transform=ax.transAxes)
    else:
        x0, x1, y0, y1 = window[:4]
        if x1 - x0 < ROSE_POSTER_MIN_WIDTH * (y1 - y0):
            # A tall, narrow window (a north-south corridor) is widened around its middle, so the
            # scale bar and the north arrow, which are placed in fractions of the window, stay
            # visible and inside the map (a 2 m wide strip would otherwise get a "0.5 m" bar).
            mid, half = (x0 + x1) / 2.0, ROSE_POSTER_MIN_WIDTH * (y1 - y0) / 2.0
            x0, x1 = mid - half, mid + half
            window = (x0, x1, y0, y1) + tuple(window[4:])
        span = max(x1 - x0, y1 - y0)
        if not span > 0:
            span = 1.0
        pad = 0.02 * span
        low = 0.09 * span if meta.get("scale_bar") else pad      # room for the scale bar
        corner = _rose_poster_arrow_corner(sample, window)       # a corner without data, or None
        head = 0.15 * span if corner is None else pad            # no free corner: room above
        xlim = (x0 - pad, x1 + pad)
        ax.set_xlim(*xlim)
        ax.set_ylim(y0 - low, y1 + head)
        ax.set_aspect("equal", adjustable="box")
        n = len(sample)
        cols = [colours[b % bins] for b in sample.bin]
        if sample.points and multi:
            size = 3.0 if len(places) > 5000 else (8.0 if len(places) > 500 else 18.0)
            single = [loc for loc in places if sum(loc[2].values()) == 1]
            dots = single if shared["pies"] else places
            if dots:
                ax.scatter([loc[0] for loc in dots], [loc[1] for loc in dots], s=size,
                           c=[colours[min(sorted(loc[2]), key=lambda b, c=loc[2]: -c[b]) % bins]
                              for loc in dots], linewidths=0)
            if shared["pies"]:
                _rose_poster_pies(ax, multi, places, span, colours, bins, style["bg"])
        elif sample.points:
            size = 3.0 if n > 5000 else (8.0 if n > 500 else 18.0)
            ax.scatter(list(sample.x1), list(sample.y1), s=size, c=cols, linewidths=0)
        else:
            width = 0.45 if n > 3000 else (0.9 if n > 500 else 1.4)
            ax.add_collection(LineCollection(
                [((a, b), (c, d)) for a, b, c, d in zip(sample.x1, sample.y1, sample.x2, sample.y2)],
                colors=cols, linewidths=width, capstyle="round"))
        drawn = n
        if meta.get("scale_bar") and opts["mpu"] > 0:
            nice = rose_nice_values(0.3 * (x1 - x0) * opts["mpu"], False)
            if nice:
                bar = nice[0]
                bar_m = bar
                bx, by = x0 + 0.02 * span, y0 - 0.065 * span
                ax.plot([bx, bx + bar / opts["mpu"]], [by, by], color=style["text"], linewidth=1.6,
                        solid_capstyle="butt", clip_on=False)
                ax.text(bx + bar / opts["mpu"] / 2.0, by + 0.01 * span,
                        "{0:g} m".format(bar) if bar < 1000 else "{0:g} km".format(bar / 1000.0),
                        color=style["text"], fontsize=7.5, ha="center", va="bottom", clip_on=False)
        arrow_corner = corner or "TR"
        if corner is None:
            top_y = y1 + head                                    # head room above the data
        elif arrow_corner[0] == "T":
            top_y = y1
        else:
            top_y = y0 + 0.14 * span
        arrow_x = (x1 - 0.035 * span) if arrow_corner[1] == "R" else (x0 + 0.035 * span)
        ax.annotate("", xy=(arrow_x, top_y - 0.005 * span), xytext=(arrow_x, top_y - 0.07 * span),
                    arrowprops=dict(arrowstyle="-|>", color=style["text"], lw=1.0))
        ax.text(arrow_x, top_y - 0.08 * span, "N", color=style["text"], fontsize=8, ha="center",
                va="top", clip_on=False)

    # --- right: the rose, petal area proportional to the weight, the colours of the map
    caption = textwrap.fill(_rose_poster_caption(group, ref, opts), 62)
    caption_h = 0.17 * (caption.count("\n") + 1)
    sub_h = 0.28
    size_in = max(1.5, min(3.8, plot_bottom - plot_top - sub_h - caption_h - 0.75))
    cx_in = 0.79 * fw
    rose_top = plot_top + sub_h + 0.30
    rose = fig.add_axes([(cx_in - size_in / 2.0) / fw, 1.0 - (rose_top + size_in) / fh,
                         size_in / fw, size_in / fh], projection="polar", facecolor=style["bg"])
    rose.set_theta_zero_location("N")
    rose.set_theta_direction(-1)
    circle = [math.radians(d) for d in range(0, 361, 5)]
    for value in rose_scale_rings(ref, opts):
        rho = math.sqrt(value / ref)
        rose.plot(circle, [rho] * len(circle), color=style["ring"], linewidth=0.7,
                  linestyle=(0, (1, 2)), zorder=1)
        rose.text(math.radians(135), rho, rose_weight_text(value, opts), color=style["muted"],
                  fontsize=6.5, ha="center", va="center", zorder=5)
    bar_width = math.radians(360.0 / opts["sectors"])
    for sector in sorted(weights):
        centre = rose_sector_edges(sector, opts["sectors"], opts["centered"])[2]
        for mirror in ((0.0, 180.0) if opts["axial"] else (0.0,)):
            rose.bar(math.radians(centre + mirror), math.sqrt(weights[sector] / ref),
                     width=bar_width, bottom=0.0, color=colours[sector % bins],
                     edgecolor=style["bg"], linewidth=0.5, align="center", zorder=2)
    rose.plot(circle, [1.0] * len(circle), color=style["outer"], linewidth=0.9,
              linestyle=(0, (3, 3)), zorder=3)
    for angle in verdict["angles"]:
        theta = math.radians(angle)
        rose.plot([theta, theta], [0.0, 1.12], color=style["accent"], linewidth=0.9,
                  linestyle=(0, (4, 3)), zorder=4)
    if verdict["angles"]:
        call_at = _rose_poster_callout_angle(verdict["angles"][0])
        rose.text(math.radians(call_at), 1.22, "{0}{1}".format(
            rose_angle_text(verdict["angles"][0]), _DEG), color=style["accent"], fontsize=10, fontweight="bold",
            ha="center", va="center", zorder=6)
    rose.set_ylim(0, 1.0)
    rose.set_yticks([])
    rose.spines["polar"].set_visible(False)
    rose.set_xticks([math.radians(d) for d in (0, 90, 180, 270)])
    rose.set_xticklabels(["N", "E", "S", "W"], fontsize=8, color=style["muted"])
    rose.tick_params(axis="x", pad=8)
    rose.grid(color=style["grid"], linewidth=0.5)
    fig.text(0.79, top(plot_top), "Same data as a rose: petal AREA = {0}".format(
        "length" if opts["weight_length"] else "count"), color=style["text"], fontsize=9.5,
        ha="center", va="top")
    fig.text(0.79, top(rose_top + size_in + 0.42), caption, color=style["muted"], fontsize=7.5,
             ha="center", va="top", linespacing=1.3)
    try:
        fig.savefig(path, dpi=ROSE_POSTER_DPI, facecolor=style["bg"], metadata={"Software": None})
    except TypeError:
        fig.savefig(path, dpi=ROSE_POSTER_DPI, facecolor=style["bg"])
    return {"size": (int(round(fw * ROSE_POSTER_DPI)), int(round(fh * ROSE_POSTER_DPI))),
            "kind": verdict["kind"], "headline": verdict["headline"], "drawn": drawn,
            "shared_locations": shared["locations"], "shared_points": shared["points"],
            "pies": shared["locations"] if shared["pies"] else 0,
            "offered": sample.offered if sample is not None else 0,
            "sampled": bool(sample is not None and sample.sampled),
            "scale_bar_m": bar_m, "arrow_x": arrow_x, "map_xlim": xlim}


def _rose_poster_pies(ax, multi, places, span, colours, bins, edge):
    """Draw one pie per shared location of ``multi`` (``[(x, y, {bin: count})]``): slices in bin
    order, clockwise from north, slice angle = share of the points. The radius is 2 % of the map
    span, at most 45 % of the smallest distance between two drawn locations (when there are at
    most 2000 of them), at least 0.4 % of the span."""
    from matplotlib.patches import Wedge
    radius = 0.02 * span
    if 1 < len(places) <= 2000:
        best = None
        for i, a in enumerate(places):
            for b in places[i + 1:]:
                d = math.hypot(a[0] - b[0], a[1] - b[1])
                if d > 0 and (best is None or d < best):
                    best = d
        if best is not None:
            radius = min(radius, 0.45 * best)
    radius = max(radius, 0.004 * span)
    for x, y, cell in multi:
        total = float(sum(cell.values()))
        start = 90.0                                  # matplotlib: degrees counter-clockwise from east
        for b in sorted(cell):
            sweep = 360.0 * cell[b] / total
            ax.add_patch(Wedge((x, y), radius, start - sweep, start, facecolor=colours[b % bins],
                               edgecolor=edge, linewidth=0.4, zorder=3))
            start -= sweep


def rose_edge_text(angle):
    """A sector edge in degrees as printed on the poster: whole degrees when the edge is whole,
    else up to two decimals without trailing zeros (348.75, 22.5), so 16 sectors read
    "348.75 to 11.25", not the rounded "349 to 11"."""
    return "{0:.2f}".format(rose_round_angle(angle, 360.0, 2)).rstrip("0").rstrip(".")


def _rose_poster_caption(group, ref, opts):
    """Text under the rose: the largest sector (the dashed ring) with its edges and share."""
    weights = group.sector_weights()
    best = max(sorted(weights), key=lambda k: weights[k])
    start, end, _centre = rose_sector_edges(best, opts["sectors"], opts["centered"])
    return "dashed ring = the largest sector, {0}{1} to {2}{1}{3}: {4} ({5:.0f} % of the total)".format(
        rose_edge_text(start), _DEG, rose_edge_text(end), " (and its opposite)" if opts["axial"] else "",
        rose_weight_text(ref, opts), 100.0 * ref / group.weight)


# --------------------------------------------------------------------------
# Bearing check of the map projection (grid convergence and non-conformal distortion)
# --------------------------------------------------------------------------
# A bearing measured in projected coordinates is a GRID bearing. In a conformal projection
# (Transverse Mercator / UTM, Lambert Conformal Conic, Mercator, Stereographic, Oblique
# Mercator) it differs from the true (geodesic) bearing by ONE angle at each place, the grid
# convergence, whatever the direction. In a non-conformal projection (equal-area Albers,
# Lambert Azimuthal Equal Area, cylindrical equal area such as EASE-Grid, equidistant,
# sinusoidal) the difference depends on the direction too, and right angles are not kept.
# The check below MEASURES this at the data instead of trusting the name of the projection:
# the projection's local Jacobian is taken by central differences of the projection itself
# (two callables supplied by the caller), and the grid bearing of every true direction follows
# from it exactly (to second order in the step).

ROSE_CONFORMAL_TOL_DEG = 0.1     # half-spread of the bearing error above this = "not conformal here"
ROSE_PROBE_STEP_DEG = 1e-4       # step (degrees of latitude / longitude) of the central differences
ROSE_PROBE_MAX_POINTS = 25       # most probe locations (3 x 3 over the data + group centres)
ROSE_PROBE_DIRECTIONS = 720      # true directions sampled over 0-180 (the error has period 180)
ROSE_WGS84_A = 6378137.0
ROSE_WGS84_E2 = 6.69437999014e-3


def rose_probe_points(boxes, limit=ROSE_PROBE_MAX_POINTS):
    """Probe locations (map units) for ``rose_bearing_check``: a 3 x 3 grid over the union of the
    ``boxes`` (``[x0, y0, x1, y1]`` each, ``None`` skipped), then the centres of the boxes, at most
    ``limit`` distinct points in all. Empty when there is no box."""
    boxes = [b for b in boxes if b]
    if not boxes:
        return []
    x0 = min(b[0] for b in boxes)
    y0 = min(b[1] for b in boxes)
    x1 = max(b[2] for b in boxes)
    y1 = max(b[3] for b in boxes)
    out = []
    seen = set()

    def put(x, y):
        key = (round(x, 6), round(y, 6))
        if key not in seen and len(out) < limit:
            seen.add(key)
            out.append((x, y))

    for fy in (0.0, 0.5, 1.0):
        for fx in (0.0, 0.5, 1.0):
            put(x0 + fx * (x1 - x0), y0 + fy * (y1 - y0))
    for b in boxes:
        put((b[0] + b[2]) / 2.0, (b[1] + b[3]) / 2.0)
    return out


def rose_local_jacobian(lon, lat, to_grid, step_deg=ROSE_PROBE_STEP_DEG):
    """``((dx/dE, dy/dE), (dx/dN, dy/dN))``: map units per metre east and per metre north at
    ``(lon, lat)`` (degrees), by central differences of ``to_grid`` (a callable mapping a list of
    ``(lon, lat)`` to a list of ``(x, y)`` or ``None``). Metres east / north use the WGS 84
    radii of curvature (the direction of the result does not depend on the ellipsoid to better
    than about 0.001 degrees). ``None`` when a point cannot be projected or the place is within
    0.5 degrees of a pole."""
    if not (math.isfinite(lon) and math.isfinite(lat)) or abs(lat) > 89.5:
        return None
    phi = math.radians(lat)
    w = 1.0 - ROSE_WGS84_E2 * math.sin(phi) ** 2
    m_radius = ROSE_WGS84_A * (1.0 - ROSE_WGS84_E2) / w ** 1.5   # meridian
    n_radius = ROSE_WGS84_A / math.sqrt(w)                       # prime vertical
    d_lat = step_deg
    d_lon = step_deg / max(math.cos(phi), 1e-6)
    pts = to_grid([(lon + d_lon, lat), (lon - d_lon, lat), (lon, lat + d_lat), (lon, lat - d_lat)])
    if not pts or len(pts) != 4 or any(p is None for p in pts):
        return None
    try:
        pts = [(float(p[0]), float(p[1])) for p in pts]
    except (TypeError, ValueError):
        return None
    if not all(math.isfinite(v) for p in pts for v in p):
        return None
    east_m = 2.0 * math.radians(d_lon) * n_radius * math.cos(phi)
    north_m = 2.0 * math.radians(d_lat) * m_radius
    je = ((pts[0][0] - pts[1][0]) / east_m, (pts[0][1] - pts[1][1]) / east_m)
    jn = ((pts[2][0] - pts[3][0]) / north_m, (pts[2][1] - pts[3][1]) / north_m)
    det = je[0] * jn[1] - je[1] * jn[0]
    if not math.isfinite(det) or det <= 0.0:   # degenerate or mirrored (not a map projection here)
        return None
    return je, jn


def rose_bearing_error(jac, true_bearing):
    """Grid bearing minus true bearing (degrees, in ``(-180, 180]``) of a short line whose true
    (geodesic) bearing is ``true_bearing``, for the Jacobian ``jac`` of ``rose_local_jacobian``."""
    je, jn = jac
    t = math.radians(true_bearing)
    gx = je[0] * math.sin(t) + jn[0] * math.cos(t)
    gy = je[1] * math.sin(t) + jn[1] * math.cos(t)
    err = math.degrees(math.atan2(gx, gy)) - true_bearing
    err = math.fmod(err, 360.0)
    if err > 180.0:
        err -= 360.0
    elif err <= -180.0:
        err += 360.0
    return err


def rose_bearing_profile(jac, steps=ROSE_PROBE_DIRECTIONS):
    """``{"convergence", "err_min", "err_max", "deviation", "right_angle"}`` at one place:
    ``convergence`` = error of a line due north (grid bearing of true north), ``err_min`` /
    ``err_max`` = smallest and largest error over all directions, ``deviation`` = half their
    spread (0 in a conformal projection; about half the angular distortion otherwise),
    ``right_angle`` = the largest amount by which two lines at a true right angle differ from
    90 degrees on the grid. Errors are unwrapped around the convergence, so a convergence
    near 180 does not count as spread."""
    conv = rose_bearing_error(jac, 0.0)
    errs = []
    for i in range(steps):
        e = rose_bearing_error(jac, 180.0 * i / steps) - conv
        e = (e + 180.0) % 360.0 - 180.0
        errs.append(e)
    half = steps // 2                  # 90 degrees further; the error has a period of 180
    right = max(abs(errs[(i + half) % steps] - errs[i]) for i in range(steps))
    lo, hi = min(errs), max(errs)
    return {"convergence": conv, "err_min": conv + lo, "err_max": conv + hi,
            "deviation": (hi - lo) / 2.0, "right_angle": right}


def rose_signed_angle(angle):
    """``angle`` (degrees) wrapped into ``(-180, 180]``."""
    a = math.fmod(float(angle), 360.0)
    if a > 180.0:
        a -= 360.0
    elif a <= -180.0:
        a += 360.0
    return a


def rose_smallest_arc(angles):
    """The smallest arc of the circle that holds every angle of ``angles`` (degrees), as
    ``(start, width)``; the arc runs clockwise (increasing bearing) from ``start`` to
    ``start + width``. The start is the angle just after the largest gap between neighbouring
    angles, shifted by whole turns so that the middle of the arc lies in ``(-180, 180]``, except
    that an arc across 180 is given with its middle in ``(0, 360)`` (so it reads +176 to +184).
    ``(0.0, 0.0)`` for no angle."""
    vals = sorted(a % 360.0 for a in angles)
    if not vals:
        return 0.0, 0.0
    gap, start = 360.0 - vals[-1] + vals[0], vals[0]
    for i in range(1, len(vals)):
        if vals[i] - vals[i - 1] > gap:
            gap, start = vals[i] - vals[i - 1], vals[i]
    width = 360.0 - gap
    mid = rose_signed_angle(start + width / 2.0)
    if mid < 0.0 and mid - width / 2.0 <= -180.0:
        mid += 360.0                   # an arc across 180 reads e.g. +176 to +184, not -184 to -176
    return mid - width / 2.0, width


def rose_bearing_check(points_xy, to_lonlat, to_grid):
    """Measure how grid bearings of the map differ from true bearings at the data.

    ``points_xy``: probe locations in map units (``rose_probe_points``); ``to_lonlat``: callable
    mapping a list of ``(x, y)`` to a list of ``(lon, lat)`` or ``None``; ``to_grid``: the inverse.
    Returns ``None`` when no location could be checked, else ``{"checked", "probed", "conv_min",
    "conv_max", "conv_abs_max", "err_min", "err_max", "deviation", "right_angle", "conformal"}``
    over all probe locations (``probed``: how many were offered; ``checked``: at how many the
    system could be measured; ``conformal``: the deviation is below ``ROSE_CONFORMAL_TOL_DEG``).
    The convergences are reported on the smallest arc that holds them all (``conv_min`` to
    ``conv_max``, see ``rose_smallest_arc``; across 180 the range reads for example +176.1 to
    +183.9), and ``err_min`` / ``err_max`` are unwrapped onto the same arc;
    ``conv_abs_max`` is the largest size of the convergence (0 to 180) at any probe."""
    if not points_xy:
        return None
    try:
        lonlats = to_lonlat(list(points_xy))
    except Exception:
        return None
    profiles = []
    for ll in lonlats or []:
        if ll is None:
            continue
        try:
            jac = rose_local_jacobian(float(ll[0]), float(ll[1]), to_grid)
        except Exception:
            jac = None
        if jac is not None:
            profiles.append(rose_bearing_profile(jac))
    if not profiles:
        return None
    dev = max(p["deviation"] for p in profiles)
    start, width = rose_smallest_arc([p["convergence"] for p in profiles])
    shifted = []
    for p in profiles:
        # every probe's angles unwrapped onto the one smallest arc of the convergences, so
        # convergences of +179.9 and -179.9 read as +179.9 and +180.1, not as a 360 degree range
        d = (p["convergence"] - start) % 360.0
        if d > (width + 360.0) / 2.0:      # a rounding hair below the start of the arc
            d -= 360.0
        off = start + d - p["convergence"]
        shifted.append((p["convergence"] + off, p["err_min"] + off, p["err_max"] + off))
    return {"checked": len(profiles), "probed": len(points_xy),
            "conv_min": min(t[0] for t in shifted),
            "conv_max": max(t[0] for t in shifted),
            "conv_abs_max": max(abs(rose_signed_angle(p["convergence"])) for p in profiles),
            "err_min": min(t[1] for t in shifted),
            "err_max": max(t[2] for t in shifted),
            "deviation": dev,
            "right_angle": max(p["right_angle"] for p in profiles),
            "conformal": dev < ROSE_CONFORMAL_TOL_DEG}


# ==========================================================================
# analysis/shape_metrics_core.py
# ==========================================================================
# Shape metrics and width table for polygons and lines (pure Python, no arcpy).
#
# Per feature, in the plane of the input coordinates (callers refuse geographic
# systems; ``meters_per_unit`` converts lengths and areas to metres):
#
# Polygons
#     * AREA (holes subtracted) and PERIMETER (every ring, holes included);
#     * Polsby-Popper ``4 pi A / P^2`` (1 = circle), Schwartzberg ``P / (2 sqrt(pi A))``
#       (1 = circle, larger = less compact; a function of Polsby-Popper), Reock
#       ``A / area of the smallest enclosing circle``, solidity ``A / convex hull area``
#       (definitions: Duchin, "Explainer: Compactness, by the numbers", MGGG);
#     * the minimum-area rotated bounding rectangle (convex hull + rotating
#       calipers): long and short side, aspect ratio, elongation ``1 - short/long``,
#       azimuth of the long side (0..180, clockwise from grid north), ``A / rectangle area``;
#     * HULL_MINW, the minimum width of the convex hull (the narrowest parallel-sided
#       strip that holds the whole feature; the minimum Feret diameter). For a concave
#       polygon this is the width of the hull, **not** the width of its narrowest part;
#     * the maximum inscribed circle (radius and centre) by the polylabel-style search of
#       ``common.anchor``: the radius is exact for the centre found and at most
#       ``INSC_TOL`` below the true maximum. It is the **widest** place of the polygon
#       (``2 r <= HULL_MINW`` always) and says nothing about the narrowest;
#     * STRIP_W ``2 A / P``: width estimate for elongated shapes (exact for a long strip
#       and for a ring-shaped band, half the side for a square).
#
# Lines
#     length, straight-line chord between the ends, sinuosity ``length / chord``, and the
#     bounding rectangle / orientation of the vertices (same calipers).
#
# Every feature is measured relative to the centre of its own bounding box, so the
# results do not depend on where the data lies (UTM northings near 10^7 are fine).
# Degenerate, invalid or odd features never raise: undefined measures are ``None`` and
# ``flags`` names the reason. Nothing here repairs geometry.

# Relative tolerance of "equal" decisions (square, tied rectangles, internal checks).
SHAPE_REL_TOL = 1e-9
# Cell budget of the inscribed circle search of one part. A long thin sinuous band
# (river, canal) needs about one cell per tolerance step along its medial line, and a
# cell costs about 20 microseconds plus 0.025 microseconds per edge (measured, pure
# Python), so the default budget of ``common.anchor`` (200,000 cells: 40 s on 4,500
# edges) is far too slow for a table of many features. The budget is SHAPE_CELL_WORK
# microseconds of such work (about 3 s), at least SHAPE_MAX_CELLS cells and at most the
# default of ``common.anchor`` (a clamp that never binds: 3e6 / 20 = 150,000): a triangle
# gets 149,439 cells, 4,500 edges 22,641 and 5,200 or more edges 20,000 cells. When the budget is
# reached the flag INSC_CAPPED is set and INSC_TOL becomes the upper bound of the error
# derived from the cells not yet explored (largest remaining cell potential minus the
# radius found; it held in every test and cross-check, but it is not a certified bound).
SHAPE_MAX_CELLS = 20000
SHAPE_CELL_WORK = 3.0e6


def shape_cell_budget(edge_count):
    """Cell budget of the inscribed circle search for a part with ``edge_count`` edges."""
    work = int(SHAPE_CELL_WORK / (20.0 + 0.025 * edge_count))
    return max(SHAPE_MAX_CELLS, min(ANCHOR_MAX_CELLS, work))
# INSC_COARSE is flagged when INSC_TOL exceeds this share of INSC_R, or this multiple of
# the precision the user asked for (the 0.01 % floor or the cell budget set it).
SHAPE_COARSE_SHARE = 0.1
SHAPE_COARSE_FACTOR = 4.0
# Features with more edges than this are not tested for crossing edges (flag EDGE_X_SKIPPED).
SHAPE_MAX_EDGES_CROSSING = 20000
# A feature with at least this many vertices gets a message before the measuring starts
# (the circle search and the crossing test are the slow parts: seconds per feature).
SHAPE_HUGE_VERTICES = 20000
# Vertices of the polygon drawn for an inscribed circle. They lie ON the circle, so the
# drawn polygon is inside the true circle (and so inside the feature); its area is
# 1 - sin(2 pi / n) / (2 pi / n) = 0.13 % smaller than the circle's.
SHAPE_CIRCLE_SEGMENTS = 72

SHAPE_FLAG_DEGENERATE = "DEGENERATE"      # no area (polygon) / no length (line)
SHAPE_FLAG_MULTIPART = "MULTIPART"        # hull, rectangle, circle span all parts
SHAPE_FLAG_ORIENT_TIE = "ORIENT_TIE"      # the long side of the rectangle is not unique
SHAPE_FLAG_INSC_CAPPED = "INSC_CAPPED"    # search stopped at the cell budget
SHAPE_FLAG_INSC_COARSE = "INSC_COARSE"    # INSC_TOL > 10 % of INSC_R or > 4 x precision
SHAPE_FLAG_EDGE_X = "EDGE_X"              # two edges cross: invalid geometry
SHAPE_FLAG_EDGE_X_SKIPPED = "EDGE_X_SKIPPED"
SHAPE_FLAG_CLOSED = "CLOSED"              # line whose ends meet: no chord
SHAPE_FLAG_BAD_COORDS = "BAD_COORDS"      # NaN or infinite coordinate
SHAPE_FLAG_WRONG_WINDING = "WRONG_WINDING"  # an outer ring lies inside another outer ring
SHAPE_FLAG_ZERO_RING = "ZERO_RING"        # a ring without area (spike, repeated points) ignored
SHAPE_FLAG_NULL = "NULL_GEOM"             # added by the tool
SHAPE_FLAG_DENSIFIED = "DENSIFIED"        # added by the tool (true curves)
SHAPE_FLAG_FAILED = "FAILED"              # added by the tool (unexpected error, row kept)

# (name, AddField keyword, alias) of the polygon table, in order.
SHAPE_POLYGON_COLUMNS = (
    ("SRC_OID", "LONG", "Source ObjectID"),
    ("PARTS", "LONG", "Parts"),
    ("HOLES", "LONG", "Holes"),
    ("AREA_M2", "DOUBLE", "Area (m2)"),
    ("PERIM_M", "DOUBLE", "Perimeter incl. holes (m)"),
    ("POLSBY_PP", "DOUBLE", "Polsby-Popper (1 = circle)"),
    ("SCHWARTZ", "DOUBLE", "Schwartzberg (1 = circle, larger = less compact)"),
    ("REOCK", "DOUBLE", "Reock (area / smallest enclosing circle)"),
    ("SOLIDITY", "DOUBLE", "Solidity (area / convex hull area)"),
    ("RECT_FILL", "DOUBLE", "Area / oriented bounding rectangle area"),
    ("MRR_LONG", "DOUBLE", "Oriented bounding rectangle, long side (m)"),
    ("MRR_SHORT", "DOUBLE", "Oriented bounding rectangle, short side (m)"),
    ("ASPECT", "DOUBLE", "Aspect ratio long / short"),
    ("ELONGATION", "DOUBLE", "Elongation 1 - short / long"),
    ("ORIENT_DEG", "DOUBLE", "Long-side azimuth (deg from grid north, 0-180)"),
    ("HULL_MINW", "DOUBLE", "Min width of the convex hull (m), not local width"),
    ("INSC_R", "DOUBLE", "Max inscribed circle radius (m): widest place"),
    ("INSC_X", "DOUBLE", "Max inscribed circle centre X (input units)"),
    ("INSC_Y", "DOUBLE", "Max inscribed circle centre Y (input units)"),
    ("INSC_PART", "LONG", "Part holding the inscribed circle"),
    ("INSC_TOL", "DOUBLE", "Inscribed circle: radius within this of the maximum (m)"),
    ("STRIP_W", "DOUBLE", "Strip width estimate 2 x area / perimeter (m)"),
)
# The same for lines.
SHAPE_LINE_COLUMNS = (
    ("SRC_OID", "LONG", "Source ObjectID"),
    ("PARTS", "LONG", "Parts"),
    ("VERTICES", "LONG", "Vertices"),
    ("LENGTH_M", "DOUBLE", "Length (m)"),
    ("CHORD_M", "DOUBLE", "Straight-line chord between the ends (m)"),
    ("SINUOSITY", "DOUBLE", "Sinuosity length / chord"),
    ("MRR_LONG", "DOUBLE", "Oriented bounding rectangle, long side (m)"),
    ("MRR_SHORT", "DOUBLE", "Oriented bounding rectangle, short side (m)"),
    ("ASPECT", "DOUBLE", "Aspect ratio long / short"),
    ("ELONGATION", "DOUBLE", "Elongation 1 - short / long"),
    ("ORIENT_DEG", "DOUBLE", "Long-side azimuth (deg from grid north, 0-180)"),
)
SHAPE_FLAGS_COLUMN = ("FLAGS", "TEXT", "Notes (comma-separated)")

# metrics dict key of each column (lower case of the name, except where noted).
_SHAPE_KEYS = {"SRC_OID": "oid", "PARTS": "parts", "HOLES": "holes", "AREA_M2": "area_m2",
               "PERIM_M": "perim_m", "POLSBY_PP": "polsby_pp", "SCHWARTZ": "schwartz",
               "REOCK": "reock", "SOLIDITY": "solidity", "RECT_FILL": "rect_fill",
               "MRR_LONG": "mrr_long", "MRR_SHORT": "mrr_short", "ASPECT": "aspect",
               "ELONGATION": "elongation", "ORIENT_DEG": "orient_deg", "HULL_MINW": "hull_minw",
               "INSC_R": "insc_r", "INSC_X": "insc_x", "INSC_Y": "insc_y",
               "INSC_PART": "insc_part", "INSC_TOL": "insc_tol", "STRIP_W": "strip_w",
               "VERTICES": "vertices", "LENGTH_M": "length_m", "CHORD_M": "chord_m",
               "SINUOSITY": "sinuosity", "FLAGS": "flags_text"}


# --------------------------------------------------------------------------
# Convex hull helpers
# --------------------------------------------------------------------------

def shape_azimuth(dx, dy):
    """Azimuth in degrees clockwise from north of the direction ``(dx, dy)`` folded
    into ``[0, 180)`` (a line has no sense of direction)."""
    az = math.degrees(math.atan2(dx, dy)) % 180.0
    if az >= 180.0:
        az -= 180.0
    return az


def shape_calipers(hull):
    """Rotating calipers on a strictly convex counter-clockwise polygon.

    ``hull``: at least 3 vertices, first vertex not repeated. For every edge ``i``
    (vertex ``i`` to ``i + 1``) returns ``(a_min, a_max, w, ux, uy)``: the extent of
    the hull along the edge direction ``u`` (relative to vertex ``i``) and its
    extent ``w`` perpendicular to it, which is the width of the hull in the direction
    normal to the edge. The minimum of ``w`` is the minimum width of the hull; the edge
    with the smallest ``(a_max - a_min) * w`` carries the minimum-area rectangle. Linear
    in the number of vertices: the three extreme vertices only move forward.
    """
    n = len(hull)
    out = []
    r = t = lo = 0
    for i in range(n):
        p = hull[i]
        q = hull[(i + 1) % n]
        ex, ey = q[0] - p[0], q[1] - p[1]
        length = math.hypot(ex, ey)
        ux, uy = ex / length, ey / length
        r = max(r, i + 1)
        steps = 0
        while steps < n:
            a, b = hull[r % n], hull[(r + 1) % n]
            if (b[0] - a[0]) * ux + (b[1] - a[1]) * uy > 0.0:
                r += 1
                steps += 1
            else:
                break
        t = max(t, r)
        steps = 0
        while steps < n:
            a, b = hull[t % n], hull[(t + 1) % n]
            if ux * (b[1] - a[1]) - uy * (b[0] - a[0]) > 0.0:
                t += 1
                steps += 1
            else:
                break
        lo = max(lo, t)
        steps = 0
        while steps < n:
            a, b = hull[lo % n], hull[(lo + 1) % n]
            if (b[0] - a[0]) * ux + (b[1] - a[1]) * uy < 0.0:
                lo += 1
                steps += 1
            else:
                break
        far, low, top = hull[r % n], hull[lo % n], hull[t % n]
        a_max = (far[0] - p[0]) * ux + (far[1] - p[1]) * uy
        a_min = (low[0] - p[0]) * ux + (low[1] - p[1]) * uy
        w = ux * (top[1] - p[1]) - uy * (top[0] - p[0])
        out.append((a_min, a_max, w, ux, uy))
    return out


def shape_enclosing_circle(points):
    """Smallest circle holding all ``points``: ``(cx, cy, r)``. Welzl's algorithm
    (move-to-front, expected linear time) on a fixed-seed shuffle, so the result is
    reproducible. ``None`` for no points."""
    pts = [(float(x), float(y)) for x, y in points]
    if not pts:
        return None
    random.Random(20261029).shuffle(pts)
    scale = max(max(abs(x), abs(y)) for x, y in pts) or 1.0
    eps = 1e-12 * scale

    def inside(c, p):
        return math.hypot(p[0] - c[0], p[1] - c[1]) <= c[2] * (1.0 + 1e-12) + eps

    def two(a, b):
        return ((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0,
                math.hypot(a[0] - b[0], a[1] - b[1]) / 2.0)

    def three(a, b, c):
        bx, by = b[0] - a[0], b[1] - a[1]
        cx, cy = c[0] - a[0], c[1] - a[1]
        d = 2.0 * (bx * cy - by * cx)
        if abs(d) <= 1e-14 * (abs(bx * cy) + abs(by * cx) + 1e-300):
            # collinear: the circle on the two farthest points holds the third
            best = max((two(a, b), two(a, c), two(b, c)), key=lambda circ: circ[2])
            return best
        b2, c2 = bx * bx + by * by, cx * cx + cy * cy
        ux = (cy * b2 - by * c2) / d
        uy = (bx * c2 - cx * b2) / d
        return (a[0] + ux, a[1] + uy, math.hypot(ux, uy))

    circle = (pts[0][0], pts[0][1], 0.0)
    for i in range(1, len(pts)):
        if inside(circle, pts[i]):
            continue
        circle = (pts[i][0], pts[i][1], 0.0)
        for j in range(i):
            if inside(circle, pts[j]):
                continue
            circle = two(pts[i], pts[j])
            for k in range(j):
                if not inside(circle, pts[k]):
                    circle = three(pts[i], pts[j], pts[k])
    return circle


def shape_bounding(points):
    """Hull-based bounding measures of a point set (already shifted near the origin).

    Returns ``{"hull", "hull_area", "long", "short", "azimuth", "min_width", "rect",
    "tie", "circle"}``: ``rect`` is the minimum-area rectangle as a clockwise closed
    ring (``None`` when it has no area), ``tie`` is True when the long side is not
    unique, ``circle`` the smallest enclosing circle. ``None`` for no points.
    """
    pts = sorted(set((float(x), float(y)) for x, y in points))
    if not pts:
        return None
    hull = convex_hull_points(pts)
    result = {"hull": hull, "hull_area": 0.0, "rect": None, "tie": False}
    if len(hull) < 3:
        # one point, or all points on one line: the "rectangle" is the segment itself
        if len(hull) == 2:
            (x0, y0), (x1, y1) = hull
            length = math.hypot(x1 - x0, y1 - y0)
            azimuth = shape_azimuth(x1 - x0, y1 - y0) if length > 0.0 else None
        else:
            length, azimuth = 0.0, None
        result.update(long=length, short=0.0, min_width=0.0, azimuth=azimuth,
                      circle=shape_enclosing_circle(hull))
        return result
    hull_area = ring_signed_area(hull + [hull[0]])
    calipers = shape_calipers(hull)
    best_i, best_area = 0, None
    for i, (a_min, a_max, w, _ux, _uy) in enumerate(calipers):
        area = (a_max - a_min) * w
        if best_area is None or area < best_area:
            best_i, best_area = i, area
    a_min, a_max, w, ux, uy = calipers[best_i]
    side_a, side_b = a_max - a_min, w
    if side_a >= side_b:
        long_side, short_side, az = side_a, side_b, shape_azimuth(ux, uy)
    else:
        long_side, short_side, az = side_b, side_a, shape_azimuth(-uy, ux)
    # Is the orientation unique? Another rectangle of (almost) the same area with a
    # different long-side azimuth, or a square, means it is not.
    tie = abs(side_a - side_b) <= SHAPE_REL_TOL * max(side_a, side_b)
    if not tie:
        limit = best_area * (1.0 + SHAPE_REL_TOL)
        for a0, a1, ww, vx, vy in calipers:
            if (a1 - a0) * ww <= limit:
                other = shape_azimuth(vx, vy) if (a1 - a0) >= ww else shape_azimuth(-vy, vx)
                gap = abs(other - az)
                if min(gap, 180.0 - gap) > 1e-6:
                    tie = True
                    break
    p = hull[best_i]
    nx, ny = -uy, ux
    c0 = (p[0] + ux * a_min, p[1] + uy * a_min)
    c1 = (p[0] + ux * a_max, p[1] + uy * a_max)
    c2 = (c1[0] + nx * w, c1[1] + ny * w)
    c3 = (c0[0] + nx * w, c0[1] + ny * w)
    result.update(hull_area=hull_area, long=long_side, short=short_side, azimuth=az,
                  min_width=min(c[2] for c in calipers), tie=tie,
                  rect=[c0, c3, c2, c1, c0] if side_a > 0.0 and side_b > 0.0 else None,
                  circle=shape_enclosing_circle(hull))
    return result


# --------------------------------------------------------------------------
# Crossing edges (informational)
# --------------------------------------------------------------------------

def _shape_orient(a, b, c):
    """Sign of the turn a -> b -> c, 0 when (nearly) collinear."""
    cross = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
    scale = math.hypot(b[0] - a[0], b[1] - a[1]) * math.hypot(c[0] - a[0], c[1] - a[1])
    if abs(cross) <= 1e-12 * scale:
        return 0
    return 1 if cross > 0 else -1


def shape_edges_cross(rings):
    """``True`` / ``False`` whether two non-neighbouring edges of ``rings`` properly
    cross each other (touching at a vertex or along an edge does not count), or
    ``None`` when the feature has more than ``SHAPE_MAX_EDGES_CROSSING`` edges."""
    segs = []
    for ring_no, ring in enumerate(rings):
        pts = [tuple(p) for p in ring]
        if len(pts) > 1 and pts[0] == pts[-1]:
            pts = pts[:-1]
        count = len(pts)
        for i in range(count):
            a, b = pts[i], pts[(i + 1) % count]
            if a != b:
                segs.append((ring_no, i, count, a, b))
    if len(segs) < 4:
        return False
    if len(segs) > SHAPE_MAX_EDGES_CROSSING:
        return None
    xs = [s[3][0] for s in segs]
    ys = [s[3][1] for s in segs]
    span = max(max(xs) - min(xs), max(ys) - min(ys))
    lengths = [math.hypot(s[4][0] - s[3][0], s[4][1] - s[3][1]) for s in segs]
    cell = max(sum(lengths) / len(lengths), span / 512.0, 1e-300)
    index = GridIndex(cell)
    for k, (_r, _i, _c, a, b) in enumerate(segs):
        index.insert(k, (min(a[0], b[0]), min(a[1], b[1]), max(a[0], b[0]), max(a[1], b[1])))
    for k1, k2 in index.candidate_pairs():
        r1, i1, c1, a, b = segs[k1]
        r2, i2, c2, c, d = segs[k2]
        if r1 == r2 and (abs(i1 - i2) == 1 or abs(i1 - i2) == c1 - 1):
            continue                      # neighbours in the same ring
        if a in (c, d) or b in (c, d):
            continue                      # share a vertex: a touch, not a crossing
        o1, o2 = _shape_orient(a, b, c), _shape_orient(a, b, d)
        o3, o4 = _shape_orient(c, d, a), _shape_orient(c, d, b)
        if o1 * o2 < 0 and o3 * o4 < 0:
            return True
    return False


# --------------------------------------------------------------------------
# Polygons
# --------------------------------------------------------------------------

def _shape_finite(points):
    return all(math.isfinite(x) and math.isfinite(y) for x, y in points)


def _shape_centre(points):
    xs = [p[0] for p in points]
    ys = [p[1] for p in points]
    return (min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0


def _shape_empty(columns, flags):
    result = dict((_SHAPE_KEYS[c[0]], None) for c in columns)
    result["flags"] = list(flags)
    result["rect"] = None
    result["centre"] = None
    return result


def _shape_ring_box(ring):
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    return (min(xs), min(ys), max(xs), max(ys))


def _shape_ring_state(inner, ring):
    """``"in"`` / ``"out"`` of ring ``inner`` against ``ring``, decided by the first vertex
    of ``inner`` that is not on the boundary of ``ring``; ``"boundary"`` when every vertex
    is on it (the same ring stored twice: not counted as nested)."""
    for p in inner:
        state = point_in_ring(p, ring)
        if state != "boundary":
            return state
    return "boundary"


def shape_nested_outers(groups):
    """0-based indices of the parts of ``groups`` (``common.geom.group_rings``) whose outer
    ring lies inside the outer ring of another part and not inside one of that part's
    holes. In valid Esri geometry outer rings never nest that way (an island in a lake is
    inside a hole), so such a part is almost always a hole stored with the outer ring's
    winding (clockwise), or overlapping parts. It is then counted as a part of its own:
    PARTS, HOLES, AREA_M2 and INSC_R are wrong for the feature. Candidate pairs come from a
    grid of the ring boxes, so a feature with many parts is not parts x parts ring tests."""
    if len(groups) < 2:
        return []
    boxes = [_shape_ring_box(outer) for outer, _holes in groups]
    span = max(max(b[2] for b in boxes) - min(b[0] for b in boxes),
               max(b[3] for b in boxes) - min(b[1] for b in boxes))
    cells = max(1, min(64, int(math.sqrt(len(groups)))))
    cell = span / cells
    index = GridIndex(cell if cell > 0.0 and math.isfinite(cell) else 1.0)
    for idx, box in enumerate(boxes):
        index.insert(idx, box)
    nested = []
    for i, (outer, _holes) in enumerate(groups):
        bi = boxes[i]
        for j in index.query(bi):
            bj = boxes[j]
            if j == i or not (bj[0] <= bi[0] and bj[1] <= bi[1] and bj[2] >= bi[2]
                              and bj[3] >= bi[3]):
                continue
            if _shape_ring_state(outer, groups[j][0]) != "in":
                continue
            if any(_shape_ring_state(outer, hole) == "in" for hole in groups[j][1]):
                continue                  # an island inside a hole: valid
            nested.append(i)
            break
    return nested


_SHAPE_EPS = 2.220446049250313e-16


def shape_ring_without_area(ring, magnitude=0.0):
    """True when ``ring`` (3 or more points) encloses no area within the rounding of its own
    coordinates: an out-and-back spike, all points on one line or all the same point.
    ``magnitude`` is the largest absolute coordinate of the feature BEFORE it was shifted
    near the origin (the shift rounds each coordinate by up to ``magnitude`` x 1.1e-16).
    The limit is 8 x eps x (magnitude x perimeter + vertices x span^2): the area that
    moving every vertex by that rounding, plus the shoelace rounding, can create."""
    if len(ring) < 3:
        return False
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    span = max(max(xs) - min(xs), max(ys) - min(ys))
    if not span > 0.0:
        return True
    area = abs(ring_signed_area(ring))
    perimeter = path_length(ring) + math.hypot(ring[-1][0] - ring[0][0], ring[-1][1] - ring[0][1])
    limit = 8.0 * _SHAPE_EPS * (float(magnitude) * perimeter + len(ring) * span * span)
    return area <= limit


def shape_drop_rings_without_area(rings, magnitude=0.0):
    """``(rings kept, number dropped)``: the rings without area (``shape_ring_without_area``)
    are left out, but only when at least one ring with area remains (a feature that is ALL
    such rings stays as it is and is reported DEGENERATE). Such a ring is not a part and not a
    hole: kept, it was counted as a part (PARTS, MULTIPART) and, lying inside the outer ring,
    raised a false WRONG_WINDING; its vertices also widened the hull and the rectangle. A
    simplified geometry never has one; Repair Geometry removes it."""
    candidates = [r for r in rings if len(r) >= 3]
    zero = [shape_ring_without_area(r, magnitude) if len(r) >= 3 else False for r in rings]
    if not any(zero) or sum(zero) >= len(candidates):
        return rings, 0
    return [r for r, z in zip(rings, zero) if not z], sum(zero)


def shape_precision_too_coarse(metrics, precision_m):
    """True when the Precision in metres is what makes the INSC_R of a measured polygon rough
    (``metrics`` of ``shape_polygon_metrics``), so that a smaller Precision would tighten it.

    The row must really be rough (flag INSC_COARSE, or INSC_TOL above 10 % of INSC_R; the hull
    cap often makes INSC_R exact even at a huge Precision) and its tolerance must come from
    the Precision: the search was not stopped by the cell budget and the 0.01 % floor of every
    part searched is below the Precision (``insc_by_precision``). Rows made rough by the floor
    or the budget are not counted: a smaller Precision does not help them. This holds for
    concave shapes too, where HULL_MINW says little about the radius (an L of 1000 m with
    10 m arms has HULL_MINW 714.18 m and INSC_R about 5.86 m)."""
    try:
        precision = float(precision_m)
    except (TypeError, ValueError):
        return False
    flags = metrics.get("flags") or []
    if not metrics.get("area_m2"):
        return False
    if SHAPE_FLAG_DEGENERATE in flags or SHAPE_FLAG_NULL in flags or SHAPE_FLAG_FAILED in flags:
        return False
    radius, tol = metrics.get("insc_r"), metrics.get("insc_tol")
    rough = SHAPE_FLAG_INSC_COARSE in flags or (
        radius is not None and tol is not None and tol > SHAPE_COARSE_SHARE * radius)
    if not rough:
        return False
    by_precision = metrics.get("insc_by_precision")
    if by_precision is None:
        # metrics without the key (written by hand): the Precision is the cause when it is
        # at least the reported tolerance and the search was not capped
        by_precision = SHAPE_FLAG_INSC_CAPPED not in flags and tol is not None \
            and precision > 0.0 and tol <= precision * (1.0 + 1e-9)
    return bool(by_precision)


SHAPE_ADVICE_SHARE = 0.05
# Largest Precision accepted, in metres (10,000 km, a quarter of the Earth's circumference).
# Any feature in a projected system is smaller, so a larger Precision says nothing more, and
# values far above it overflow to infinity once divided by a unit factor such as the foot.
SHAPE_MAX_PRECISION_M = 1.0e7


def shape_precision_problem(precision_m):
    """``None`` when ``precision_m`` is a usable Precision in metres (a finite number above
    zero and at most ``SHAPE_MAX_PRECISION_M``); otherwise a short English reason. A
    non-finite value (infinity, NaN) used to pass the old ``> 0`` test and gave INSC_TOL NaN."""
    try:
        value = float(precision_m)
    except (TypeError, ValueError):
        return "The precision must be a number."
    if not math.isfinite(value):
        return "The precision must be a finite number (not infinity or NaN)."
    if not value > 0.0:
        return "The precision must be greater than zero."
    if value > SHAPE_MAX_PRECISION_M:
        return ("The precision must be at most {0:,.0f} m (10,000 km): no feature is larger, "
                "so a larger value says nothing more.".format(SHAPE_MAX_PRECISION_M))
    return None


def _shape_round_down(value, digits=2):
    """``value`` (> 0) rounded DOWN to ``digits`` significant digits (0.1546 -> 0.15)."""
    if not value > 0.0 or not math.isfinite(value):
        return value
    exponent = math.floor(math.log10(value)) - (digits - 1)
    step = 10.0 ** exponent
    out = math.floor(value / step * (1.0 + 1e-12)) * step
    out = float("{0:.{1}g}".format(out, digits))
    while out > value:                       # never above the limit
        out = float("{0:.{1}g}".format(out - step, digits))
    return out if out > 0.0 else value


def shape_precision_target(rows, with_basis=False):
    """Largest Precision in metres that resolves every row of ``rows`` (metrics dicts that
    ``shape_precision_too_coarse`` reported): 5 % of the smallest INSC_R, rounded down to two
    significant digits. True radius r* >= INSC_R, and a search with Precision p finds
    r' >= r* - p, so INSC_TOL <= p = 0.05 x INSC_R <= 0.053 x r': below the 10 % of
    INSC_COARSE. A row with no radius (INSC_R 0 or empty) uses HULL_MINW / 2 (an upper bound
    of r*). ``with_basis``: return ``(value, basis)``, ``basis`` ``"insc_r"`` or
    ``"hull_minw"`` naming what the smallest size was, so the advice can say so."""
    sizes = []
    for m in rows:
        radius = m.get("insc_r")
        if radius is not None and radius > 0.0:
            sizes.append((radius, "insc_r"))
        elif m.get("hull_minw"):
            sizes.append((m["hull_minw"] / 2.0, "hull_minw"))
    sizes = [item for item in sizes if math.isfinite(item[0]) and item[0] > 0.0]
    if not sizes:
        return (None, None) if with_basis else None
    size, basis = min(sizes)
    value = _shape_round_down(SHAPE_ADVICE_SHARE * size)
    return (value, basis) if with_basis else value


def shape_precision_advice(precision_m, target_m, default_m, basis="insc_r"):
    """Advice of the Precision warning: a Precision of at most ``target_m``
    (``shape_precision_target``: 5 % of the smallest INSC_R of the warned rows, or, when
    ``basis`` is ``"hull_minw"``, 5 % of half the smallest HULL_MINW of a row whose search
    found no radius at all), naming the default only when it is not above that and not
    already in use."""
    limit = float(target_m)
    if basis == "hull_minw":
        advice = ("a Precision of {0:g} m or less (5 % of HULL_MINW / 2, the largest radius "
                  "that fits in them, because the search found INSC_R 0 for at least one of "
                  "them)".format(limit))
    else:
        advice = "a Precision of {0:g} m or less (5 % of their smallest INSC_R)".format(limit)
    if float(precision_m) > float(default_m) and float(default_m) <= limit:
        advice += ", such as the default {0:g} m".format(float(default_m))
    return advice


# Coordinate systems whose scale is far from 1 over most of their extent,
# recognised by name (case-insensitive, the Esri name of ``SpatialReference.name``) and WKID.
# Mercator in any form except Transverse / Oblique (UTM, Gauss-Kruger, Hotine: local, scale
# near 1); the other cylindrical world systems; any world or global system (Mollweide,
# Robinson, EASE-Grid ...). Polar stereographic and the Web Mercator WKID list are handled by
# the tool with the shared helpers.
_SHAPE_LOCAL_MERCATOR_WORDS = ("transverse", "oblique", "utm", "hotine", "gauss")
_SHAPE_CYLINDRICAL_WORDS = ("plate_carree", "plate carree", "equidistant_cylindrical",
                            "equidistant cylindrical", "cylindrical", "miller", "behrmann",
                            "gall_", "ease_grid", "ease-grid")
_SHAPE_WORLD_WORDS = ("world_", "world ", "_world", "global", "equal_earth", "equal earth")
SHAPE_DISTORTING_WKIDS = frozenset((3395, 3832, 32662, 4087, 54001, 54002, 54003, 54004,
                                    54034, 3410, 3975, 6933, 3786, 54017, 54016))


def shape_distorting_system(name, wkid=None):
    """Short English label (``"a Mercator system"``, ``"a cylindrical world system"``, ``"a
    world-scale system"``) when the projected system named ``name`` (WKID ``wkid``) stretches
    lengths and areas by a large, place-dependent factor, else ``None``. Name based: a custom
    system with an unusual name is not recognised."""
    text = str(name or "").lower()
    if "mercator" in text and not any(w in text for w in _SHAPE_LOCAL_MERCATOR_WORDS):
        return "a Mercator system"
    if any(w in text for w in _SHAPE_CYLINDRICAL_WORDS):
        return "a cylindrical world system"
    if any(w in text for w in _SHAPE_WORLD_WORDS):
        return "a world-scale system"
    try:
        code = int(wkid) if wkid else None
    except (TypeError, ValueError):
        code = None
    if code in SHAPE_DISTORTING_WKIDS:
        return "a world-scale system"
    return None


def _shape_largest_circle(groups, precision):
    """``(part index, x, y, radius, capped, error bound)`` of the largest inscribed
    circle over all parts. Parts that cannot beat the best radius found (half the
    shorter bbox side is an upper bound) are not searched; ties keep the first part.

    ``error bound``: the radius returned is at most this far below the true maximum.
    It is the winner's own bound, or, when another searched part could still hold a
    larger circle (its radius plus its own bound exceeds the winner's radius, because
    its search was capped or its floor is coarse), the largest such excess. ``capped``
    is True when the winner's search or the search of such a part hit the cell budget.
    The seventh item is the largest 0.01 % precision floor of the parts searched (input
    units), so the caller can tell whether the Precision or the floor set the bound.
    """
    boxes = []
    for idx, (outer, _holes) in enumerate(groups):
        xs = [p[0] for p in outer]
        ys = [p[1] for p in outer]
        w, h = max(xs) - min(xs), max(ys) - min(ys)
        boxes.append((-min(w, h) / 2.0, idx, w, h))
    searched = []          # (idx, x, y, radius, capped, bound)
    best = None
    floor = 0.0            # largest 0.01 % floor of the parts searched
    for neg_bound, idx, w, h in sorted(boxes):
        if best is not None and -neg_bound <= best[3]:
            break
        outer, holes = groups[idx]
        rings_of_part = [outer] + list(holes)
        edges = sum(max(len(r) - 1, 0) for r in rings_of_part)
        # A Precision above the part's larger bbox side says nothing more (no circle inside
        # has a radius above half the shorter side), but it made the first search cell far
        # larger than the part: its centre lay far outside, and when the first guesses fell
        # in a hole or a notch the search split such cells level by level with distance
        # queries from far away (152 s for a 1.7 m blob with a hole at 139,695 m in feet).
        search = min(precision, max(w, h)) if max(w, h) > 0.0 else precision
        x, y, d, capped, bound = pole_with_status(rings_of_part, search,
                                                  shape_cell_budget(edges))
        floor = max(floor, effective_precision(0.0, w, h))
        if capped:
            bound = max(bound, effective_precision(search, w, h))
        else:
            bound = effective_precision(search, w, h)
        item = (idx, x, y, d, capped, bound)
        searched.append(item)
        if best is None or d > best[3] or (d == best[3] and idx < best[0]):
            best = item
    idx, x, y, d, capped, bound = best
    for other in searched:
        if other is best:
            continue
        excess = other[3] + other[5] - d
        if excess > bound:
            bound = excess
            capped = capped or other[4]
        elif other[4] and excess > 0.0:
            capped = True
    return (idx, x, y, d, capped, bound, floor)


def shape_polygon_metrics(rings, precision=0.05, meters_per_unit=1.0):
    """Shape measures of one polygon feature (``rings`` in the core representation).

    ``precision``: tolerance of the inscribed circle radius in metres (a floor of
    1e-4 of the feature's larger bbox side applies, see ``common.anchor``).
    Returns a dict with the keys of ``SHAPE_POLYGON_COLUMNS`` (lower case; ``None``
    where undefined), ``flags`` (list of ``SHAPE_FLAG_*``), ``rect`` (the oriented
    bounding rectangle as a clockwise closed ring in the input coordinates, or
    ``None``) and ``centre`` (inscribed circle centre, ``None`` without area).
    Never raises for odd geometry; raises ValueError for a Precision that
    ``shape_precision_problem`` refuses (infinity, NaN, zero or less, above 10,000 km) or a
    unit factor that is not a finite number above zero.
    """
    problem = shape_precision_problem(precision)
    if problem:
        raise ValueError(problem)
    mpu = float(meters_per_unit)
    if not (math.isfinite(mpu) and mpu > 0.0):
        raise ValueError("The unit factor (metres per unit) must be a finite number above zero.")
    all_points = [tuple(p) for ring in (rings or []) for p in ring]
    if not all_points:
        return _shape_empty(SHAPE_POLYGON_COLUMNS, [SHAPE_FLAG_DEGENERATE])
    if not _shape_finite(all_points):
        return _shape_empty(SHAPE_POLYGON_COLUMNS, [SHAPE_FLAG_BAD_COORDS])
    ox, oy = _shape_centre(all_points)
    shifted = [[(x - ox, y - oy) for x, y in ring] for ring in rings]
    shifted, dropped = shape_drop_rings_without_area(
        shifted, max(max(abs(x), abs(y)) for x, y in all_points))
    groups = group_rings(shifted)
    result = _shape_empty(SHAPE_POLYGON_COLUMNS, [])
    result["insc_by_precision"] = False
    flags = result["flags"]
    if dropped:
        flags.append(SHAPE_FLAG_ZERO_RING)
    used_rings = [r for outer, holes in groups for r in [outer] + list(holes)]
    parts, holes_n = len(groups), sum(len(h) for _o, h in groups)
    area = sum(abs(ring_signed_area(o)) - sum(abs(ring_signed_area(h)) for h in hs)
               for o, hs in groups)
    perim = sum(path_length(r) for r in used_rings)
    result.update(parts=parts, holes=holes_n, area_m2=max(area, 0.0) * mpu * mpu,
                  perim_m=perim * mpu)
    if parts > 1:
        flags.append(SHAPE_FLAG_MULTIPART)
        if shape_nested_outers(groups):
            flags.append(SHAPE_FLAG_WRONG_WINDING)
    crossing = shape_edges_cross(used_rings)
    if crossing:
        flags.append(SHAPE_FLAG_EDGE_X)
    elif crossing is None:
        flags.append(SHAPE_FLAG_EDGE_X_SKIPPED)
    bounding = shape_bounding([p for r in used_rings for p in r]) if used_rings else None
    if bounding is not None:
        _shape_fill_bounding(result, bounding, mpu, ox, oy)
    if area <= 0.0 or perim <= 0.0 or not groups:
        flags.insert(0, SHAPE_FLAG_DEGENERATE)
        result["polsby_pp"] = 0.0 if perim > 0.0 else None
        result["insc_r"] = 0.0
        result["insc_x"], result["insc_y"] = None, None     # no circle, no centre
        result["insc_tol"] = 0.0
        result["area_m2"] = 0.0
        return result
    result["polsby_pp"] = 4.0 * math.pi * area / (perim * perim)
    result["schwartz"] = perim / (2.0 * math.sqrt(math.pi * area))
    result["strip_w"] = 2.0 * area / perim * mpu
    if bounding is not None:
        if bounding["hull_area"] > 0.0:
            result["solidity"] = area / bounding["hull_area"]
        if bounding["rect"] is not None:
            result["rect_fill"] = area / (bounding["long"] * bounding["short"])
        circle = bounding["circle"]
        if circle is not None and circle[2] > 0.0:
            result["reock"] = area / (math.pi * circle[2] * circle[2])
    best = _shape_largest_circle(groups, float(precision) / mpu)
    idx, x, y, radius, capped, tol, floor = best
    # The Precision (not the floor or the cell budget) set the bound: a smaller one would help.
    result["insc_by_precision"] = (not capped) and floor < float(precision) / mpu
    if bounding is not None and bounding["min_width"] > 0.0:
        # The circle lies inside the polygon, so inside its convex hull: 2 r <= HULL_MINW for
        # every circle, the true maximum included. The radius found cannot be further below
        # the maximum than HULL_MINW / 2 - r, whatever the search bound says (an exactly
        # known strip of 2 m x 200 km used to report a tolerance of 20 m).
        hull_cap = bounding["min_width"] / 2.0 - radius
        if hull_cap < tol:
            tol = max(hull_cap, 0.0)
            if tol <= SHAPE_REL_TOL * bounding["min_width"]:
                tol, capped = 0.0, False        # the radius is the maximum (within rounding)
    result.update(insc_r=radius * mpu, insc_x=x + ox, insc_y=y + oy, insc_part=idx + 1,
                  insc_tol=tol * mpu)
    result["centre"] = (x + ox, y + oy)
    if capped:
        flags.append(SHAPE_FLAG_INSC_CAPPED)
    if tol > SHAPE_COARSE_SHARE * radius or tol > SHAPE_COARSE_FACTOR * float(precision) / mpu:
        flags.append(SHAPE_FLAG_INSC_COARSE)
    return result


def _shape_fill_bounding(result, bounding, mpu, ox, oy):
    """Copy the rectangle / width measures of ``shape_bounding`` into ``result``."""
    long_side, short_side = bounding["long"], bounding["short"]
    result.update(mrr_long=long_side * mpu, mrr_short=short_side * mpu,
                  hull_minw=bounding["min_width"] * mpu)
    if short_side > 0.0:
        result["aspect"] = long_side / short_side
    if long_side > 0.0:
        result["elongation"] = 1.0 - short_side / long_side
    result["orient_deg"] = bounding["azimuth"]
    if bounding["rect"] is not None:
        result["rect"] = [(x + ox, y + oy) for x, y in bounding["rect"]]
    if bounding["tie"] and bounding["azimuth"] is not None:
        result["flags"].append(SHAPE_FLAG_ORIENT_TIE)


# --------------------------------------------------------------------------
# Lines
# --------------------------------------------------------------------------

def shape_line_metrics(paths, meters_per_unit=1.0):
    """Shape measures of one line feature (``paths`` in the core representation); same
    result layout as ``shape_polygon_metrics`` (keys of ``SHAPE_LINE_COLUMNS``).

    Chord and sinuosity need one path with distinct ends; for a multipart line, or a
    line whose ends meet, they are ``None`` (flags MULTIPART / CLOSED).
    """
    mpu = float(meters_per_unit)
    paths = [[tuple(p) for p in path] for path in (paths or []) if path]
    all_points = [p for path in paths for p in path]
    if not all_points:
        return _shape_empty(SHAPE_LINE_COLUMNS, [SHAPE_FLAG_DEGENERATE])
    if not _shape_finite(all_points):
        return _shape_empty(SHAPE_LINE_COLUMNS, [SHAPE_FLAG_BAD_COORDS])
    ox, oy = _shape_centre(all_points)
    shifted = [[(x - ox, y - oy) for x, y in path] for path in paths]
    result = _shape_empty(SHAPE_LINE_COLUMNS, [])
    flags = result["flags"]
    length = sum(path_length(p) for p in shifted)
    result.update(parts=len(paths), vertices=len(all_points), length_m=length * mpu)
    bounding = shape_bounding([p for path in shifted for p in path])
    if bounding is not None:
        _shape_fill_bounding(result, bounding, mpu, ox, oy)
    if length <= 0.0:
        flags.insert(0, SHAPE_FLAG_DEGENERATE)
        return result
    if len(paths) > 1:
        flags.append(SHAPE_FLAG_MULTIPART)
        return result
    first, last = shifted[0][0], shifted[0][-1]
    chord = math.hypot(last[0] - first[0], last[1] - first[1])
    if chord <= 1e-12 * length:
        flags.append(SHAPE_FLAG_CLOSED)
        result["chord_m"] = 0.0
        return result
    result["chord_m"] = chord * mpu
    result["sinuosity"] = length / chord
    return result


# --------------------------------------------------------------------------
# Drawing helpers
# --------------------------------------------------------------------------

def shape_circle_ring(cx, cy, radius, segments=SHAPE_CIRCLE_SEGMENTS):
    """Closed clockwise ring (first point repeated) of a regular ``segments``-gon whose
    vertices lie on the circle of centre ``(cx, cy)`` and ``radius``, starting at the
    north point. The polygon is inside the circle; ``None`` for a radius that is not
    positive and finite, a centre that is not finite or fewer than 3 segments."""
    try:
        radius = float(radius)
        cx, cy = float(cx), float(cy)
    except (TypeError, ValueError):
        return None
    if not (math.isfinite(radius) and radius > 0.0 and math.isfinite(cx)
            and math.isfinite(cy)) or segments < 3:
        return None
    ring = []
    for k in range(segments):
        angle = math.pi / 2.0 - 2.0 * math.pi * k / segments
        ring.append((cx + radius * math.cos(angle), cy + radius * math.sin(angle)))
    ring.append(ring[0])
    return ring


def shape_vertex_count(shape):
    """Number of vertices of a feature in the core representation (rings or paths)."""
    return sum(len(part) for part in (shape or []))


# --------------------------------------------------------------------------
# Rows, checks, summary
# --------------------------------------------------------------------------

def shape_null_metrics(kind_is_polygon, flags=(SHAPE_FLAG_NULL,)):
    """Metrics of a feature that could not be measured (no geometry...): every
    measure ``None``, ``flags`` as given."""
    return _shape_empty(SHAPE_POLYGON_COLUMNS if kind_is_polygon else SHAPE_LINE_COLUMNS, flags)


def shape_columns(kind_is_polygon):
    """Column definitions ``(name, AddField keyword, alias)`` including FLAGS."""
    return (SHAPE_POLYGON_COLUMNS if kind_is_polygon else SHAPE_LINE_COLUMNS) \
        + (SHAPE_FLAGS_COLUMN,)


def shape_row_values(kind_is_polygon, oid, metrics):
    """Values of one table row in the order of ``shape_columns``."""
    metrics = dict(metrics)
    metrics["oid"] = oid
    metrics["flags_text"] = ",".join(metrics.get("flags") or [])
    return [metrics.get(_SHAPE_KEYS[c[0]]) for c in shape_columns(kind_is_polygon)]


def shape_consistency_issues(kind_is_polygon, m):
    """Names of internal consistency checks that fail for the metrics ``m`` (empty =
    all hold). These relations are mathematical certainties for a valid polygon, so a
    failure points at invalid geometry (crossing edges, rings outside their outer
    ring) or at a defect:

    * ``0 < Polsby-Popper <= 1`` (isoperimetric inequality), Reock, solidity and
      rectangle fill ``<= 1`` (the feature lies inside its hull, circle, rectangle);
    * ``2 x INSC_R <= HULL_MINW <= MRR_SHORT <= MRR_LONG`` (the circle lies inside the
      polygon, the polygon inside the hull, and the hull's narrowest strip is not wider
      than the rectangle's short side);
    * lines: ``CHORD_M <= LENGTH_M`` and ``SINUOSITY >= 1``.
    """
    bad = []
    tol = 1.0 + 1e-9

    def over(value, limit):
        return value is not None and value > limit * tol + 1e-12

    if kind_is_polygon:
        if m.get("area_m2") and m.get("polsby_pp") is not None:
            if not (0.0 < m["polsby_pp"] <= tol):
                bad.append("POLSBY_PP")
            for key, label in (("reock", "REOCK"), ("solidity", "SOLIDITY"),
                               ("rect_fill", "RECT_FILL")):
                if m.get(key) is not None and not (0.0 < m[key] <= tol):
                    bad.append(label)
            if m.get("schwartz") is not None and m["schwartz"] < 1.0 / tol:
                bad.append("SCHWARTZ")
            if m.get("insc_r") is not None and m.get("hull_minw") is not None \
                    and over(2.0 * m["insc_r"], m["hull_minw"]):
                bad.append("INSC_VS_HULL_MINW")
        if m.get("hull_minw") is not None and m.get("mrr_short") is not None \
                and over(m["hull_minw"], m["mrr_short"]):
            bad.append("HULL_MINW_VS_MRR")
    else:
        if m.get("chord_m") is not None and over(m["chord_m"], m.get("length_m") or 0.0):
            bad.append("CHORD_VS_LENGTH")
        if m.get("sinuosity") is not None and m["sinuosity"] < 1.0 / tol:
            bad.append("SINUOSITY")
    if m.get("mrr_long") is not None and m.get("mrr_short") is not None \
            and over(m["mrr_short"], m["mrr_long"]):
        bad.append("MRR_SIDES")
    return bad


def shape_summary(kind_is_polygon, rows, precision_m, flag_rows=None):
    """Summary lines ``[(item, value), ...]`` of ``rows`` (the metrics dicts of the
    measured features): counts, flag counts and the range of the main measures.

    ``flag_rows`` (default ``rows``) are the rows whose flags are counted, so a caller
    can count the flags of rows that were read but not measured (FAILED, BAD_COORDS)
    without counting those rows as measured."""
    out = [("Features measured", len(rows))]
    counts = {}
    for m in (rows if flag_rows is None else flag_rows):
        for flag in m.get("flags") or []:
            counts[flag] = counts.get(flag, 0) + 1
    for flag in sorted(counts):
        out.append(("Features flagged " + flag, counts[flag]))
    keys = (("polsby_pp", "Polsby-Popper"), ("reock", "Reock"), ("solidity", "Solidity"),
            ("aspect", "Aspect ratio"), ("insc_r", "Inscribed radius (m)"),
            ("hull_minw", "Hull min width (m)")) if kind_is_polygon else \
        (("length_m", "Length (m)"), ("sinuosity", "Sinuosity"), ("aspect", "Aspect ratio"))
    for key, label in keys:
        values = sorted(m[key] for m in rows if m.get(key) is not None)
        if values:
            mid = values[len(values) // 2] if len(values) % 2 else \
                (values[len(values) // 2 - 1] + values[len(values) // 2]) / 2.0
            out.append((label + " min / median / max",
                        "{0:.4g} / {1:.4g} / {2:.4g}".format(values[0], mid, values[-1])))
    if kind_is_polygon:
        out.append(("Inscribed circle precision requested (m)", precision_m))
    return out


# ==========================================================================
# analysis/polygon_holes_core.py
# ==========================================================================
# Polygon Holes and Parts (pure Python, no arcpy).
#
# INVENTORY. Every ring of a polygon feature becomes one row: outer rings (the
# parts of the feature) and holes (interior rings), with area, perimeter, vertex
# count, mean width, the part a hole sits in, the hole's share of its outer ring
# and flags. Conventions (the tool's own definitions, not an Esri standard):
#
# * Rings follow the Esri convention used by ``geom.group_rings``: a clockwise
#   ring is an outer ring (a part), a counter-clockwise ring is a hole of the
#   smallest outer ring that contains it. A counter-clockwise ring that no outer
#   ring contains is kept as a part of its own and flagged ``NO_OUTER``; such a
#   ring never takes holes (a counter-clockwise ring inside it is a ``NO_OUTER``
#   part as well, whatever the stored order), and a ``NO_OUTER`` part that shares
#   area with another part of the feature (one inside the other, or boundaries
#   crossing) gets ``OVERLAPS_PART``, as does that other part. Rings are read as
#   stored; nothing is re-oriented or repaired.
# * ``PART`` is 1-based in the order the outer rings are stored (parts made of a
#   ``NO_OUTER`` ring come last). ``RING`` is 0 for the outer ring and 1, 2, ...
#   for its holes in stored order. ``SRC_RING`` is the 0-based index of the ring
#   in the stored geometry. A multipart polygon therefore has one PART per outer
#   ring; an island lying inside a hole of another part is a part of its own
#   (flag ``NESTED`` on its outer ring, ``HAS_ISLAND`` on the hole around it).
# * A ring is degenerate (``RING_TYPE`` DEGENERATE, flag ``ZERO_AREA``, no PART)
#   when it has fewer than 3 distinct vertices or an area of at most
#   ``PH_ZERO_AREA_M2`` (1e-6 m2, a constant chosen here). Degenerate rings take
#   no part in grouping.
# * Area is the planar shoelace area of the ring in the coordinate system of the
#   data times ``meters_per_unit`` squared; perimeter likewise. The caller must
#   hand in a projected system (a geographic system is refused by the tool).
#   ``WIDTH_M`` is the mean width 2 * area / perimeter (about the width of a
#   long thin strip); the thinness is 4 * pi * area / perimeter^2 (1 for a circle).
# * Flags: ``SLIVER`` (mean width below ``sliver_width_m`` and thinness below
#   ``max_thinness``), ``TINY`` (ring area below ``tiny_area_m2``),
#   ``TOUCHES_OUTER`` (a hole shares a point with the boundary of its outer ring,
#   within ``touch_tolerance_m``), ``TOUCHES_OTHER_HOLE`` (same for two holes of a
#   part; both holes get the flag), ``NESTED``, ``HAS_ISLAND``, ``NO_OUTER``,
#   ``SELF_TOUCH`` (a coordinate occurs twice in a ring at positions that are
#   not neighbours: the ring touches itself; the ring is still one ring and its
#   shoelace area is used). Self-crossing rings are not detected.
#   ``OVERLAPS_OTHER_HOLE`` (two holes of one part share area: their boundaries
#   cross, a vertex or a stretch of one boundary lies inside the other ring (also
#   when the rings meet only at shared vertices and along shared edges, as after
#   snapping), or the boundaries coincide; both get the flag).
#   That is invalid geometry (the holes of a valid polygon never overlap). The
#   net area of the part is the outer area minus the **sum** of its hole areas,
#   so shared area is subtracted twice and the net area is too small by the
#   shared area; no union of the holes is computed. A ring with a NaN or infinite
#   coordinate is refused (``ValueError``; the tool lists the feature as one that
#   could not be analysed).
#
# CLEANING PLAN. ``plan_cleaning`` decides, from the same analysis, which holes
# are filled and which parts dropped (the idea of Eliminate Polygon Part, with
# its own rules). All decisions use the input geometry, none is sequential,
# except that a hole is not filled while a part that is kept lies inside it.
#
# * A hole is filled when its area is below ``min_hole_area_m2`` and/or its
#   percentage of the outer ring area (the outer ring of its own part, holes not
#   subtracted) is below ``max_hole_percent``. A threshold of 0 is off. With two
#   active thresholds ``hole_logic`` ANY fills when either is met, ALL when both
#   are. "Below" is strict.
# * A part is dropped when its net area (outer ring minus its holes) is below
#   ``min_part_area_m2`` (0 = off). Its holes go with it (``DROP_WITH_PART``).
# * A hole that holds a kept island is never filled (``KEEP_HOLE_ISLAND``): the
#   fill would overlap the island. (Eliminate Polygon Part removes such islands.)
#   This is transitive: an island counts for every hole it lies in, also when it
#   sits deeper, in a hole of a dropped island inside the first hole.
# * A feature never vanishes: when every part would be dropped, the largest part
#   by net area (the first on ties) is kept (``KEEP_LARGEST_PART``).
# * A hole belongs to the smallest outer ring that contains it and is larger than the hole
#   beyond rounding noise (``_ph_same_area``: relative 1e-9 plus a band of ``_ph_coord_noise``
#   along the boundary; no ring-vs-ring area test is exact); an island with the same boundary up
#   to floating-point rounding (another start vertex, extra collinear vertices, rotated or
#   reprojected coordinates) therefore does not own the hole.
#   The island then lies inside the hole (``NESTED`` / ``HAS_ISLAND``), the hole is kept
#   (``KEEP_HOLE_ISLAND``) and a fill can no longer overlap it. A hole whose only containing ring
#   has the same area (a hole that is its whole outer ring) stays with that ring (net area 0).
# * Degenerate rings are always removed (``DROP_ZERO_AREA``), unless the feature
#   has no valid part at all; then the geometry is kept as stored
#   (``KEEP_NO_VALID_PART``).
# * A feature without changes keeps its geometry exactly as stored.
# * In a feature that is changed, the outer ring of every kept ``NO_OUTER`` part (a
#   counter-clockwise ring read as a part of its own) is written clockwise, so the cleaned
#   copy holds it as the part the inventory and the summary count (positive area), also when
#   a drop leaves it as the only part. Its row is ``ORIENT_NO_OUTER`` (also when it is the part
#   kept as the largest; its DETAIL then says so), so the log names every re-oriented ring.

PH_ZERO_AREA_M2 = 1e-6          # rings at or below this area are degenerate (constant of this tool)

# Scale guard. The tool keeps every feature, ring and output row in memory (no streaming: the
# output field widths, the carried fields and the summary need the whole input first). The
# figures are the tool's own estimates from a measurement of the pure-Python core in the
# development environment: 100,000 features of one outer ring and one hole (4 vertices each)
# peaked at 441 MB (about 4.4 KB per small feature, of which the input geometry itself is 141 MB);
# rings with many vertices cost about 140 bytes per vertex for the geometry plus 10 to 40 for the
# analysis. The estimate adds a margin for the output rows and the arcpy cursors. NOT measured in
# ArcGIS Pro.
PH_WARN_FEATURES = 50000        # warn before reading when the input has at least this many features
PH_WARN_MEMORY_MB = 1000        # warn after reading when the estimate reaches this
PH_BYTES_PER_FEATURE = 4500     # small features, before reading
PH_BYTES_PER_RING = 2000        # after reading: per ring (inventory row, plan, output row)
PH_BYTES_PER_VERTEX = 200       # after reading: per vertex (tuple, floats, copies)

PH_RING_OUTER = "OUTER"
PH_RING_HOLE = "HOLE"
PH_RING_DEGENERATE = "DEGENERATE"

PH_FLAG_ZERO_AREA = "ZERO_AREA"
PH_FLAG_SLIVER = "SLIVER"
PH_FLAG_TINY = "TINY"
PH_FLAG_TOUCHES_OUTER = "TOUCHES_OUTER"
PH_FLAG_TOUCHES_HOLE = "TOUCHES_OTHER_HOLE"
PH_FLAG_NESTED = "NESTED"
PH_FLAG_HAS_ISLAND = "HAS_ISLAND"
PH_FLAG_NO_OUTER = "NO_OUTER"
PH_FLAG_SELF_TOUCH = "SELF_TOUCH"
PH_FLAG_OVERLAPS_HOLE = "OVERLAPS_OTHER_HOLE"
PH_FLAG_OVERLAPS_PART = "OVERLAPS_PART"
PH_FLAGS = (PH_FLAG_ZERO_AREA, PH_FLAG_SLIVER, PH_FLAG_TINY, PH_FLAG_TOUCHES_OUTER,
            PH_FLAG_TOUCHES_HOLE, PH_FLAG_OVERLAPS_HOLE, PH_FLAG_NESTED, PH_FLAG_HAS_ISLAND,
            PH_FLAG_NO_OUTER, PH_FLAG_OVERLAPS_PART, PH_FLAG_SELF_TOUCH)

PH_ACTION_FILL = "FILL_HOLE"
PH_ACTION_DROP_PART = "DROP_PART"
PH_ACTION_DROP_WITH_PART = "DROP_WITH_PART"
PH_ACTION_DROP_ZERO = "DROP_ZERO_AREA"
PH_ACTION_KEEP_ISLAND = "KEEP_HOLE_ISLAND"
PH_ACTION_KEEP_LARGEST = "KEEP_LARGEST_PART"
PH_ACTION_KEEP_NO_VALID = "KEEP_NO_VALID_PART"
PH_ACTION_ORIENT = "ORIENT_NO_OUTER"
PH_ACTIONS = (PH_ACTION_FILL, PH_ACTION_DROP_PART, PH_ACTION_DROP_WITH_PART, PH_ACTION_DROP_ZERO,
              PH_ACTION_KEEP_ISLAND, PH_ACTION_KEEP_LARGEST, PH_ACTION_KEEP_NO_VALID,
              PH_ACTION_ORIENT)

PH_LOGIC_ANY = "ANY"
PH_LOGIC_ALL = "ALL"

PH_DEFAULT_OPTIONS = {"tiny_area_m2": 1.0, "sliver_width_m": 1.0, "max_thinness": 0.1,
                      "touch_tolerance_m": 0.001,
                      "min_hole_area_m2": 0.0, "max_hole_percent": 0.0,
                      "hole_logic": PH_LOGIC_ANY, "min_part_area_m2": 0.0}


def polygon_holes_options(**overrides):
    """Options dict: defaults updated with ``overrides`` (``None`` values ignored).

    Raises ``KeyError`` for an unknown name and ``ValueError`` for a negative or
    non-finite number or an unknown ``hole_logic``."""
    opts = dict(PH_DEFAULT_OPTIONS)
    for key, value in overrides.items():
        if key not in opts:
            raise KeyError(key)
        if value is not None:
            opts[key] = value
    for key, value in opts.items():
        if key == "hole_logic":
            opts[key] = str(value).upper()
            if opts[key] not in (PH_LOGIC_ANY, PH_LOGIC_ALL):
                raise ValueError("hole_logic must be ANY or ALL")
        else:
            opts[key] = float(value)
            if not math.isfinite(opts[key]) or opts[key] < 0:
                raise ValueError("{0} must be a number of zero or more".format(key))
    return opts


def polygon_holes_has_thresholds(opts):
    """True when at least one cleaning threshold is on (above 0)."""
    return bool(opts["min_hole_area_m2"] > 0 or opts["max_hole_percent"] > 0
                or opts["min_part_area_m2"] > 0)


def polygon_holes_crs_problem(sr):
    """``(cause, fix)`` when an input system cannot give areas in square metres, else
    ``None``. ``sr`` is ``arcio.sr_info`` of the input (``None`` = no system).

    Only a projected system with a known linear unit is accepted. A geographic
    system (areas would be square degrees), an undefined system and the Web
    Mercator family (areas inflated by 1 / cos(latitude)^2, about 21 % at 24.7
    degrees north) are refused; no other scale error of the system is corrected.
    """
    if not sr or sr.get("type") not in ("Projected", "Geographic"):
        return ("The input has no usable coordinate system, so its areas have no unit.",
                "Define the coordinate system (Define Projection) or project the data to a "
                "projected metric system, then run the tool again.")
    if sr.get("type") == "Geographic":
        return ("The input is in a geographic coordinate system ({0}); areas and perimeters "
                "would be in square degrees and degrees, which cannot be compared with "
                "thresholds in square metres.".format(sr.get("name") or "unknown"),
                "Project the input to a projected metric system suited to its area (for "
                "example its UTM zone) with the Project tool, then run this tool on the "
                "result.")
    mpu = sr.get("meters_per_unit")
    if not mpu or mpu <= 0:
        return ("The linear unit of the input coordinate system ({0}) is unknown.".format(
            sr.get("name") or "unknown"),
                "Project the data to a projected system with a known unit (metres or feet).")
    if is_web_mercator(sr.get("wkid")):
        return ("The input is in {0}, a Web Mercator system: its areas are inflated by "
                "1 / cos(latitude)^2 (about 21 % at 24.7 degrees north, more further "
                "north), so they are not square metres on the ground.".format(
                    sr.get("name") or "Web Mercator"),
                "Project the input to a local projected system (for example its UTM zone) "
                "with the Project tool, then run this tool on the result.")
    return None


def polygon_holes_memory_estimate_mb(features, rings=None, vertices=None):
    """Estimated peak memory in MB: from rings and vertices when known, otherwise from the
    feature count alone (small features)."""
    if rings is None or vertices is None:
        return features * PH_BYTES_PER_FEATURE / 1e6
    return (rings * PH_BYTES_PER_RING + vertices * PH_BYTES_PER_VERTEX) / 1e6


def polygon_holes_scale_warning(features, rings=None, vertices=None):
    """Warning text for an input that may not fit in memory, else ``None``.

    Before reading only ``features`` is known (warns from ``PH_WARN_FEATURES``); after
    reading ``rings`` and ``vertices`` are counted too (warns from ``PH_WARN_MEMORY_MB``
    estimated)."""
    advice = ("If ArcGIS Pro runs out of memory, split the input with a selection or a "
              "definition query (for example by area or by grid cell) and run the parts one "
              "after another.")
    if rings is None or vertices is None:
        if features < PH_WARN_FEATURES:
            return None
        return ("The input has {0:,} feature(s). This tool keeps every feature, ring and "
                "output row in memory (about {1:,.0f} MB for that many small features, "
                "more when the polygons have many vertices); it was measured only in a "
                "simulated environment, up to 100,000 small features (about 0.44 GB), not "
                "in ArcGIS Pro. {2}".format(
                    features, polygon_holes_memory_estimate_mb(features), advice))
    estimate = polygon_holes_memory_estimate_mb(features, rings, vertices)
    if estimate < PH_WARN_MEMORY_MB:
        return None
    return ("The input has {0:,} feature(s), {1:,} ring(s) and {2:,} vertices, which this tool "
            "keeps in memory (estimated about {3:,.0f} MB; an estimate from a simulated "
            "environment, not measured in ArcGIS Pro). {4}".format(
                features, rings, vertices, estimate, advice))


# --------------------------------------------------------------------------
# Inventory
# --------------------------------------------------------------------------

def _ph_has_repeat(ring):
    """True when a coordinate occurs twice at positions that are not neighbours."""
    pts = [tuple(p) for p in ring]
    if len(pts) > 1 and pts[0] == pts[-1]:
        pts = pts[:-1]
    n = len(pts)
    seen = {}
    for i, p in enumerate(pts):
        j = seen.get(p)
        if j is not None and not (i - j == 1 or (j == 0 and i == n - 1)):
            return True
        seen[p] = i
    return False


def _ph_box(ring):
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    return (min(xs), min(ys), max(xs), max(ys))


def _ph_cell(boxes):
    """Grid cell size for bboxes: about one cell per box over their extent."""
    x0 = min(b[0] for b in boxes)
    y0 = min(b[1] for b in boxes)
    x1 = max(b[2] for b in boxes)
    y1 = max(b[3] for b in boxes)
    cell = max(math.sqrt(max((x1 - x0) * (y1 - y0), 0.0) / len(boxes)),
               max(x1 - x0, y1 - y0) / len(boxes))
    return cell if cell > 0 and math.isfinite(cell) else 1.0


def _ph_box_contains(outer, inner, eps=0.0):
    return (outer[0] - eps <= inner[0] and outer[1] - eps <= inner[1]
            and inner[2] <= outer[2] + eps and inner[3] <= outer[3] + eps)


class _PhBoundary(object):
    """Segment index and vertex index of one ring, built on first use."""

    def __init__(self, ring):
        self.ring = ring
        self._segments = None
        self._points = None

    def _cell(self):
        lengths = [math.hypot(self.ring[i + 1][0] - self.ring[i][0],
                              self.ring[i + 1][1] - self.ring[i][1])
                   for i in range(len(self.ring) - 1)]
        return analysis_cell_size(lengths)

    def segments(self):
        if self._segments is None:
            index = AnalysisSegmentIndex(self._cell())
            for i in range(len(self.ring) - 1):
                index.add(i, self.ring[i], self.ring[i + 1])
            self._segments = index
        return self._segments

    def points(self):
        if self._points is None:
            index = AnalysisSegmentIndex(self._cell())
            for i in range(len(self.ring) - 1):
                index.add(i, self.ring[i], self.ring[i])
            self._points = index
        return self._points


def _ph_touch(small, other, tol):
    """True when the boundaries of two closed rings come within ``tol`` of each
    other at a vertex of either ring. ``small`` is walked, ``other`` is indexed
    (``_PhBoundary``). For valid (non-crossing) rings a shared point is always
    a vertex of at least one of them, so both directions together find every
    touch."""
    ring = small.ring
    for i in range(len(ring) - 1):
        if other.segments().within(ring[i], tol):
            return True
    for i in range(len(ring) - 1):
        a, b = ring[i], ring[i + 1]
        mid = ((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0)
        reach = math.hypot(b[0] - a[0], b[1] - a[1]) / 2.0 + tol
        for _d, _key, c in other.points().within(mid, reach):
            # c is a vertex of the other ring near this segment of the walked ring
            if _ph_point_segment(c, a, b) <= tol:
                return True
    return False


def _ph_point_segment(p, a, b):
    dx, dy = b[0] - a[0], b[1] - a[1]
    length2 = dx * dx + dy * dy
    if length2 == 0.0:
        return math.hypot(p[0] - a[0], p[1] - a[1])
    t = ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / length2
    t = min(1.0, max(0.0, t))
    return math.hypot(p[0] - (a[0] + t * dx), p[1] - (a[1] + t * dy))


def _ph_orient(o, a, b):
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])


def _ph_cross_depth(a, b, c, d, tol):
    """True when segments ``a``-``b`` and ``c``-``d`` cross each other in their interiors, at a
    point farther than ``tol`` from all four end points (a touch or a vertex-on-edge contact is
    not a crossing). Segments with an end point within ``tol`` of the other segment are not
    taken as crossing here: for (nearly) collinear segments far from the origin the orientation
    signs are rounding noise. Such contacts are decided by ``_ph_ring_sides`` instead."""
    o1, o2 = _ph_orient(a, b, c), _ph_orient(a, b, d)
    o3, o4 = _ph_orient(c, d, a), _ph_orient(c, d, b)
    if not (((o1 > 0 and o2 < 0) or (o1 < 0 and o2 > 0))
            and ((o3 > 0 and o4 < 0) or (o3 < 0 and o4 > 0))):
        return False
    if (_ph_point_segment(a, c, d) <= tol or _ph_point_segment(b, c, d) <= tol
            or _ph_point_segment(c, a, b) <= tol or _ph_point_segment(d, a, b) <= tol):
        return False
    t = o3 / (o3 - o4)                       # position of the crossing along a-b
    x = (a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1]))
    return all(math.hypot(x[0] - q[0], x[1] - q[1]) > tol for q in (a, b, c, d))


def _ph_boundaries_cross(small, other, tol):
    """True when a segment of ``small`` (a ``_PhBoundary``, walked) crosses a segment of
    ``other`` (indexed). Only segments within half a segment length of the midpoint can cross it."""
    ring = small.ring
    index = other.segments()
    for i in range(len(ring) - 1):
        a, b = ring[i], ring[i + 1]
        mid = ((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0)
        reach = math.hypot(b[0] - a[0], b[1] - a[1]) / 2.0 + tol
        for _d, key, _c in index.within(mid, reach):
            c, d = index.segments[key]
            if _ph_cross_depth(a, b, c, d, tol):
                return True
    return False


_PH_PIECE_SAMPLES = (0.5, 0.25, 0.75, 0.125, 0.875)


def _ph_split_params(a, b, index, tol):
    """Sorted positions (0..1) along segment ``a``-``b`` where the other ring's boundary meets it:
    the end points, every crossing with a segment of the other ring and the projection of every
    vertex of the other ring that lies within ``tol`` of the segment (this also covers collinear
    stretches and contacts at a vertex). Between two consecutive positions the segment does not
    meet the other boundary, so it lies wholly inside, outside or along it."""
    dx, dy = b[0] - a[0], b[1] - a[1]
    length2 = dx * dx + dy * dy
    ts = [0.0, 1.0]
    if length2 == 0.0:
        return ts
    mid = ((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0)
    reach = math.sqrt(length2) / 2.0 + tol
    for _d, key, _c in index.within(mid, reach):
        c, d = index.segments[key]
        for q in (c, d):
            if _ph_point_segment(q, a, b) <= tol:
                ts.append(min(1.0, max(0.0, ((q[0] - a[0]) * dx + (q[1] - a[1]) * dy) / length2)))
        o1, o2 = _ph_orient(a, b, c), _ph_orient(a, b, d)
        o3, o4 = _ph_orient(c, d, a), _ph_orient(c, d, b)
        if ((o1 > 0 > o2) or (o1 < 0 < o2)) and ((o3 > 0 > o4) or (o3 < 0 < o4)):
            ts.append(o3 / (o3 - o4))
    return sorted(set(ts))


def _ph_ring_sides(walk, other, other_probe, tol):
    """``(inside, outside)`` for the boundary of ring ``walk`` against ring ``other`` (both
    ``_PhBoundary``): whether some stretch (or vertex) of ``walk`` lies inside ``other``, or
    outside it, farther than ``tol`` from the boundary of ``other``. Stops at the first inside."""
    ring = walk.ring
    index = other.segments()
    inside = outside = False

    def classify(p):
        if index.within(p, tol):
            return None                       # on (or within tol of) the other boundary
        state = other_probe.locate(p) if other_probe is not None else point_in_ring(p, other.ring)
        return state if state != "boundary" else None

    for i in range(len(ring) - 1):
        a, b = ring[i], ring[i + 1]
        points = [a]
        ts = _ph_split_params(a, b, index, tol)
        for t0, t1 in zip(ts[:-1], ts[1:]):
            if t1 - t0 <= 0.0:
                continue
            for f in _PH_PIECE_SAMPLES:
                t = t0 + f * (t1 - t0)
                points.append((a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])))
        for p in points:
            state = classify(p)
            if state == "in":
                return True, outside
            if state == "out":
                outside = True
    return inside, outside


def _ph_holes_overlap(box_a, box_b, ring_a, ring_b, bound_a, bound_b, tol):
    """True when two hole rings share area (invalid for the holes of one part).

    The rings share area when their boundaries cross, or when a vertex or a stretch of the
    boundary of one ring lies inside the other farther than ``tol`` from its boundary, or when
    the two boundaries coincide (within ``tol``). Each edge is cut where the other boundary meets
    it (crossings, and vertices of the other ring on or within ``tol`` of the edge), and points
    of every piece are located, so holes that meet only at shared vertices and along shared
    (collinear) edges, the usual form of a snapped overlap, are found as well. Contact that is
    only a shared point or edge, or a gap below ``tol``, is not an overlap."""
    if (min(box_a[2], box_b[2]) - max(box_a[0], box_b[0]) <= tol
            or min(box_a[3], box_b[3]) - max(box_a[1], box_b[1]) <= tol):
        return False                            # the boxes meet at most along an edge
    small, big = (bound_a, bound_b) if len(ring_a) <= len(ring_b) else (bound_b, bound_a)
    if _ph_boundaries_cross(small, big, tol):
        return True
    probe_a = _GeomRingProbe(ring_a) if len(ring_a) > 64 else None
    probe_b = _GeomRingProbe(ring_b) if len(ring_b) > 64 else None
    in_a, out_a = _ph_ring_sides(bound_a, bound_b, probe_b, tol)
    if in_a:
        return True
    in_b, out_b = _ph_ring_sides(bound_b, bound_a, probe_a, tol)
    if in_b:
        return True
    # Neither boundary enters the other: they share area only when they coincide.
    return not out_a and not out_b


def _ph_check_finite(geom):
    """Raise ``ValueError`` for a ring with a NaN or infinite coordinate: its area would be NaN
    (or infinite) and would reach the output tables."""
    for i, ring in enumerate(geom):
        for p in ring or ():
            if not (math.isfinite(p[0]) and math.isfinite(p[1])):
                raise ValueError("ring {0} has a coordinate that is NaN or infinite".format(i))


PH_EQUAL_AREA_REL = 1e-9        # rings whose areas differ by less than this share are "equal"
PH_COORD_NOISE_REL = 2.0 ** -44  # coordinate noise allowed, as a share of the largest |coordinate|


def _ph_coord_noise(rings):
    """Size of floating-point coordinate noise for these rings, in map units: a few hundred units
    in the last place of the largest coordinate (about 6e-7 at a UTM northing of 1e7). Two rings
    that are "the same boundary" but were computed differently (another start vertex, extra
    collinear vertices, rotated or reprojected by other software) differ by about this much."""
    scale = 1.0
    for ring in rings:
        for p in ring:
            scale = max(scale, abs(p[0]), abs(p[1]))
    return scale * PH_COORD_NOISE_REL


def _ph_same_area(big, small, perimeter, offset):
    """True when ``big`` is not larger than ``small`` beyond noise: the relative share
    ``PH_EQUAL_AREA_REL`` plus a band of width ``offset`` along a boundary of length
    ``perimeter`` (all in one unit system). Used for every "is this ring at least as large"
    test between rings that may share their boundary, never an exact float comparison."""
    return big <= small + small * PH_EQUAL_AREA_REL + perimeter * offset


def _ph_ring_inside_tol(inner, outer, tol, probe=None):
    """``_geom_ring_inside`` with a boundary tolerance of ``tol`` map units: a vertex of
    ``inner`` within ``tol`` of ``outer``'s boundary counts as on the boundary; the first vertex
    off the boundary decides; a ring with every vertex on the boundary is inside."""
    for p in inner:
        state = probe.locate(p) if probe is not None else point_in_ring(p, outer, tol)
        if state != "boundary":
            return state == "in"
    return True


def _ph_ring_parts(rings):
    """``[(src index, ring) ...]`` of valid rings grouped with ``group_rings``:
    ``[[outer entry, hole entry, ...], ...]`` in ``group_rings`` order.

    ``group_rings`` gives a hole to the smallest outer ring that contains it. A
    ring of exactly the hole's area (an island that fills the hole, boundary on
    boundary) is "inside" the hole's boundary as well, so it would win and the
    real outer ring would lose the hole (fills then overlap the island). A hole
    is therefore moved to the smallest containing outer ring that is strictly
    larger than the hole; an equal-area outer ring keeps it only when no larger
    ring contains it (a hole that is its whole outer ring: net area 0)."""
    lookup = {}
    for i, ring in rings:
        lookup.setdefault(tuple(ring), []).append(i)
    parts = []
    for outer, holes in group_rings([r for _i, r in rings]):
        part = []
        for ring in [outer] + holes:
            part.append((lookup[tuple(ring)].pop(0), ring))
        parts.append(part)
    return _ph_regroup_equal_area(_ph_orphans_take_no_holes(parts))


def _ph_orphans_take_no_holes(parts):
    """A counter-clockwise ring that no clockwise ring contains (``NO_OUTER``) never takes holes.

    ``group_rings`` lets such an orphan ring take later counter-clockwise rings inside it as its
    holes, so two nested counter-clockwise rings gave a part with a hole when the larger one was
    stored first, and two separate parts when the smaller one was (R13-1). Here every
    counter-clockwise ring a ``NO_OUTER`` ring took is given to the smallest clockwise outer ring
    that contains it, or else becomes a ``NO_OUTER`` part of its own, whatever the stored order.
    ``NO_OUTER`` parts are therefore single rings, and they come last, in stored order."""
    orphans = [p for p in parts if ring_signed_area(p[0][1]) > 0]
    if not any(len(p) > 1 for p in orphans):
        return parts
    outers = [p for p in parts if ring_signed_area(p[0][1]) <= 0]
    loose = []
    for p in orphans:
        loose.extend(p[1:])
        del p[1:]
    for entry in loose:
        best, best_area = None, None
        for p in outers:
            area = abs(ring_signed_area(p[0][1]))
            if (best is None or area < best_area) and _geom_ring_inside(entry[1], p[0][1]):
                best, best_area = p, area
        if best is None:
            orphans.append([entry])
        else:
            best.append(entry)
            best[1:] = sorted(best[1:], key=lambda e: e[0])
    orphans.sort(key=lambda p: p[0][0])
    return outers + orphans


def _ph_regroup_equal_area(parts):
    noise = _ph_coord_noise(r for part in parts for _i, r in part)
    moves = []
    for gi, part in enumerate(parts):
        outer = part[0][1]
        if ring_signed_area(outer) > 0:       # a counter-clockwise ring kept as a part of its own
            continue
        outer_area = abs(ring_signed_area(outer))
        for entry in part[1:]:
            hole_area = abs(ring_signed_area(entry[1]))
            if _ph_same_area(outer_area, hole_area, path_length(entry[1]), noise):
                moves.append((gi, entry, hole_area))
    if not moves:
        return parts
    for gi, entry, hole_area in moves:
        target, target_area = None, None
        for tj, other in enumerate(parts):
            o_ring = other[0][1]
            if tj == gi or ring_signed_area(o_ring) > 0:
                continue
            o_area = abs(ring_signed_area(o_ring))
            if _ph_same_area(o_area, hole_area, path_length(entry[1]), noise):
                continue
            if (target is None or o_area < target_area) and _geom_ring_inside(entry[1], o_ring):
                target, target_area = tj, o_area
        if target is not None:
            parts[gi].remove(entry)
            parts[target].append(entry)
    for part in parts:
        part[1:] = sorted(part[1:], key=lambda e: e[0])      # holes stay in stored order
    return parts


def _ph_row(oid, src_ring, ring_type, part, ring, ring_pts, mpu):
    area = abs(ring_signed_area(ring_pts)) * mpu * mpu
    perim = path_length(ring_pts) * mpu
    return {"oid": oid, "src_ring": src_ring, "ring_type": ring_type, "part": part,
            "ring": ring, "area_m2": area, "perim_m": perim, "vertices": max(len(ring_pts) - 1, 0),
            "width_m": (2.0 * area / perim) if perim > 0 else 0.0,
            "thinness": (4.0 * math.pi * area / (perim * perim)) if perim > 0 else 0.0,
            "outer_area_m2": None, "part_net_m2": None, "hole_pct": None, "hole_count": None,
            "nest_part": None, "nest_ring": None, "flags": [], "plan": "", "detail": "",
            "coords": ring_pts}


def analyse_polygon(oid, geom, meters_per_unit=1.0, opts=None):
    """Inventory of one polygon feature.

    ``geom`` is a core polygon (list of rings) or ``None``. Returns ``{"oid",
    "parts", "degenerate", "rows", "geom"}``: ``parts`` is a list of dicts
    ``{"index", "outer", "holes", "outer_row", "hole_rows", "net_m2", "host"}``
    (``host`` = ``(part, ring)`` of the hole an island part lies in, or ``None``),
    ``rows`` all ring rows ordered by part, ring, then the degenerate rings.
    """
    opts = opts or polygon_holes_options()
    mpu = float(meters_per_unit or 1.0)
    result = {"oid": oid, "parts": [], "degenerate": [], "rows": [], "geom": geom}
    if not geom:
        return result
    _ph_check_finite(geom)
    tol = opts["touch_tolerance_m"] / mpu
    valid, degenerate = [], []
    for i, ring in enumerate(geom):
        closed = close_ring(ring) if ring else []
        distinct = len(set(closed[:-1])) if len(closed) > 1 else len(closed)
        if distinct < 3 or abs(ring_signed_area(closed)) * mpu * mpu <= PH_ZERO_AREA_M2:
            degenerate.append((i, closed))
        else:
            valid.append((i, closed))
    for i, closed in degenerate:
        row = _ph_row(oid, i, PH_RING_DEGENERATE, None, None, closed, mpu)
        row["flags"].append(PH_FLAG_ZERO_AREA)
        result["degenerate"].append(row)
    parts = []
    for p_idx, entries in enumerate(_ph_ring_parts(valid), 1):
        outer_src, outer = entries[0]
        orow = _ph_row(oid, outer_src, PH_RING_OUTER, p_idx, 0, outer, mpu)
        hole_rows = []
        for r_idx, (src, ring) in enumerate(entries[1:], 1):
            hrow = _ph_row(oid, src, PH_RING_HOLE, p_idx, r_idx, ring, mpu)
            hrow["outer_area_m2"] = orow["area_m2"]
            hrow["hole_pct"] = (100.0 * hrow["area_m2"] / orow["area_m2"]) if orow["area_m2"] > 0 \
                else None
            hole_rows.append(hrow)
        net = max(orow["area_m2"] - sum(h["area_m2"] for h in hole_rows), 0.0)
        orow["outer_area_m2"] = orow["area_m2"]
        orow["part_net_m2"] = net
        orow["hole_count"] = len(hole_rows)
        if ring_signed_area(outer) > 0:
            orow["flags"].append(PH_FLAG_NO_OUTER)
        parts.append({"index": p_idx, "outer": outer, "holes": [e[1] for e in entries[1:]],
                      "outer_row": orow, "hole_rows": hole_rows, "net_m2": net, "host": None})
    # --- touching ------------------------------------------------------
    for part in parts:
        if not part["hole_rows"]:
            continue
        boundary = {}
        outer_b = _PhBoundary(part["outer"])
        boxes = []
        for hrow in part["hole_rows"]:
            boundary[hrow["ring"]] = _PhBoundary(hrow["coords"])
            boxes.append(_ph_box(hrow["coords"]))
        for hrow in part["hole_rows"]:
            if _ph_touch(boundary[hrow["ring"]], outer_b, tol):
                hrow["flags"].append(PH_FLAG_TOUCHES_OUTER)
        if len(part["hole_rows"]) > 1:
            index = GridIndex(_ph_cell(boxes))
            for k, box in enumerate(boxes):
                index.insert(k, box)
            for a, b in index.candidate_pairs(tol):
                ha, hb = part["hole_rows"][a], part["hole_rows"][b]
                small, big = (a, b) if ha["vertices"] <= hb["vertices"] else (b, a)
                if _ph_touch(boundary[part["hole_rows"][small]["ring"]],
                             boundary[part["hole_rows"][big]["ring"]], tol):
                    for h in (ha, hb):
                        if PH_FLAG_TOUCHES_HOLE not in h["flags"]:
                            h["flags"].append(PH_FLAG_TOUCHES_HOLE)
                if _ph_holes_overlap(boxes[a], boxes[b], ha["coords"], hb["coords"],
                                     boundary[ha["ring"]], boundary[hb["ring"]], tol):
                    for h in (ha, hb):
                        if PH_FLAG_OVERLAPS_HOLE not in h["flags"]:
                            h["flags"].append(PH_FLAG_OVERLAPS_HOLE)
    # --- islands: a part inside a hole of another part ----------------------
    holes_all = [(part["index"], hrow) for part in parts for hrow in part["hole_rows"]]
    if holes_all and len(parts) > 1:
        boxes = [_ph_box(h["coords"]) for _p, h in holes_all]
        index = GridIndex(_ph_cell(boxes))
        for k, box in enumerate(boxes):
            index.insert(k, box)
        # An island may have the same boundary as its hole but other numbers: another start
        # vertex, extra collinear vertices, or rounding noise of large coordinates (rotated or
        # reprojected in double precision). Areas are therefore compared with a slack (relative
        # share plus a band of coordinate noise along the hole's boundary, as in the grouping
        # step), and an island of the hole's area that the strict vertex test puts outside is
        # located again with that band. Vertices moved by more than rounding (snapped to a
        # coarser grid) are NOT the same boundary here (see the docs, Limitations).
        near = _ph_coord_noise(r for part in parts for r in [part["outer"]] + part["holes"])
        probes, near_probes = {}, {}
        for part in parts:
            obox = _ph_box(part["outer"])
            orow = part["outer_row"]
            best = None
            for k in index.query(obox):
                host_part, hrow = holes_all[k]
                if host_part == part["index"]:
                    continue
                slack_ok = _ph_same_area(orow["area_m2"], hrow["area_m2"], hrow["perim_m"], near * mpu)
                if not slack_ok:
                    continue            # the island is larger than the hole beyond noise
                if not _ph_box_contains(boxes[k], obox, max(tol, near)):
                    continue
                probe = probes.get(k)
                if probe is None and len(hrow["coords"]) > 64:
                    probe = probes[k] = _GeomRingProbe(hrow["coords"])
                inside = _geom_ring_inside(part["outer"], hrow["coords"], probe)
                if not inside and _ph_same_area(hrow["area_m2"], orow["area_m2"], hrow["perim_m"],
                                                near * mpu):
                    near_probe = near_probes.get(k)
                    if near_probe is None and len(hrow["coords"]) > 64:
                        near_probe = near_probes[k] = _GeomRingProbe(hrow["coords"], near)
                    inside = _ph_ring_inside_tol(part["outer"], hrow["coords"], near, near_probe)
                if inside:
                    if best is None or hrow["area_m2"] < holes_all[best][1]["area_m2"]:
                        best = k
            if best is not None:
                host_part, hrow = holes_all[best]
                part["host"] = (host_part, hrow["ring"])
                orow["nest_part"], orow["nest_ring"] = host_part, hrow["ring"]
                orow["flags"].append(PH_FLAG_NESTED)
                if PH_FLAG_HAS_ISLAND not in hrow["flags"]:
                    hrow["flags"].append(PH_FLAG_HAS_ISLAND)
                hrow.setdefault("islands", []).append(part["index"])
    # --- NO_OUTER parts that share area with another part (R13-1) -----------
    lone = [part for part in parts if PH_FLAG_NO_OUTER in part["outer_row"]["flags"]]
    if lone and len(parts) > 1:
        bounds, boxes = {}, {}
        for part in parts:
            boxes[part["index"]] = _ph_box(part["outer"])
        for part in lone:
            for other in parts:
                if other is part or (PH_FLAG_NO_OUTER in other["outer_row"]["flags"]
                                     and other["index"] < part["index"]):
                    continue                    # each pair of NO_OUTER parts once
                for p in (part, other):
                    if p["index"] not in bounds:
                        bounds[p["index"]] = _PhBoundary(p["outer"])
                if _ph_holes_overlap(boxes[part["index"]], boxes[other["index"]], part["outer"],
                                     other["outer"], bounds[part["index"]],
                                     bounds[other["index"]], tol):
                    for p in (part, other):
                        if PH_FLAG_OVERLAPS_PART not in p["outer_row"]["flags"]:
                            p["outer_row"]["flags"].append(PH_FLAG_OVERLAPS_PART)
    # --- generic flags, row order ----------------------------------------
    rows = []
    for part in parts:
        for row in [part["outer_row"]] + part["hole_rows"]:
            rows.append(row)
    rows.extend(result["degenerate"])
    for row in rows:
        if row["ring_type"] != PH_RING_DEGENERATE:
            if opts["tiny_area_m2"] > 0 and row["area_m2"] < opts["tiny_area_m2"]:
                row["flags"].append(PH_FLAG_TINY)
            if opts["sliver_width_m"] > 0 and row["width_m"] < opts["sliver_width_m"] \
                    and row["thinness"] < opts["max_thinness"]:
                row["flags"].append(PH_FLAG_SLIVER)
        if _ph_has_repeat(row["coords"]):
            row["flags"].append(PH_FLAG_SELF_TOUCH)
        row["flags"] = [f for f in PH_FLAGS if f in row["flags"]]
    result["parts"] = parts
    result["rows"] = rows
    return result


# --------------------------------------------------------------------------
# Cleaning plan
# --------------------------------------------------------------------------

def _ph_hole_hit(row, opts):
    area_on = opts["min_hole_area_m2"] > 0
    pct_on = opts["max_hole_percent"] > 0
    if not (area_on or pct_on):
        return False
    area_hit = area_on and row["area_m2"] < opts["min_hole_area_m2"]
    pct = row["hole_pct"]
    pct_hit = pct_on and pct is not None and pct < opts["max_hole_percent"]
    if area_on and pct_on:
        return (area_hit and pct_hit) if opts["hole_logic"] == PH_LOGIC_ALL else (area_hit or pct_hit)
    return area_hit if area_on else pct_hit


def _ph_hole_rule_text(row, opts):
    """Which fill rule(s) a hole was measured against, with the numbers, for the log:
    ``"area 20 m2 < 50 m2 (met); 0.2% of the outer ring < 0.5% (not met); logic ANY"``."""
    pieces = []
    if opts["min_hole_area_m2"] > 0:
        pieces.append("area {0:.6g} m2 < {1:.6g} m2 ({2})".format(
            row["area_m2"], opts["min_hole_area_m2"],
            "met" if row["area_m2"] < opts["min_hole_area_m2"] else "not met"))
    if opts["max_hole_percent"] > 0:
        pct = row["hole_pct"]
        pieces.append("{0:.4g}% of the outer ring < {1:.6g}% ({2})".format(
            pct or 0.0, opts["max_hole_percent"],
            "met" if pct is not None and pct < opts["max_hole_percent"] else "not met"))
    text = "; ".join(pieces)
    if len(pieces) > 1:
        text += "; logic " + opts["hole_logic"]
    return text


PH_RUN_SETTINGS = "RUN_SETTINGS"
PH_RUN_FLAGS = "RUN_FLAGS"
PH_RUN_INPUT = "RUN_INPUT"
PH_RUN_ACTIONS = (PH_RUN_SETTINGS, PH_RUN_FLAGS, PH_RUN_INPUT)
PH_RUN_TEXT_MAX = 250           # bytes: a dBASE text field holds at most 254 BYTES (UTF-8)
PH_RUN_NAME_MAX = 120           # bytes of the input name in RUN_INPUT
PH_RUN_CRS_MAX = 100            # bytes of the coordinate system name in RUN_INPUT


def _ph_dbf_bytes(text):
    """Bytes Pro writes for ``text`` in a dBASE text field: UTF-8, a character above U+FFFF
    as 6 (two 3-byte surrogates); the same rule as ``common.arcio``."""
    return len(text.encode("utf-8")) + 2 * sum(1 for ch in text if ord(ch) > 0xFFFF)


def _ph_cut_bytes(text, limit, marker=""):
    """``text`` cut at a character boundary to at most ``limit`` dBASE bytes; ``marker`` is
    appended to a cut text and fits within ``limit``."""
    if _ph_dbf_bytes(text) <= limit:
        return text
    room = limit - _ph_dbf_bytes(marker)
    kept, used = [], 0
    for ch in text:
        size = _ph_dbf_bytes(ch)
        if used + size > room:
            break
        kept.append(ch)
        used += size
    return "".join(kept) + marker


def _ph_number_list(numbers):
    """Part numbers as a short text: a run of 3 or more consecutive numbers is written "a-b"
    ([2, 3, 4, 5, 9] -> "2-5, 9"; [2, 3] -> "2, 3"), so a hole holding many islands keeps a
    DETAIL that names every one of them (R11-1)."""
    numbers = sorted(set(int(n) for n in numbers))
    out, i = [], 0
    while i < len(numbers):
        j = i
        while j + 1 < len(numbers) and numbers[j + 1] == numbers[j] + 1:
            j += 1
        if j - i >= 2:
            out.append("{0}-{1}".format(numbers[i], numbers[j]))
        else:
            out.extend(str(n) for n in numbers[i:j + 1])
        i = j + 1
    return ", ".join(out)


def polygon_holes_run_notes(opts, meters_per_unit, version, input_name, crs_name, wkid, features):
    """``[(action, detail), ...]``: the run rows that open the change log, so the log alone
    says which rules and thresholds produced it (each text is at most 250 bytes in UTF-8, so
    it fits a dBASE change log also with an Arabic input name).

    ``RUN_SETTINGS``: tool version and the cleaning thresholds; ``RUN_FLAGS``: the flag
    parameters and the degenerate-ring constant; ``RUN_INPUT``: input name, coordinate system,
    unit and number of features read. In ``RUN_INPUT`` only the names are cut (with "..."): the
    input name to the bytes the other fields leave (at most 120), the CRS name to 100 bytes, so
    the WKID, the unit and the feature count always survive."""
    def num(value):
        return "{0:.10g}".format(float(value))

    settings = ("PolygonHoleInventory v{0}; Fill Holes Smaller Than min_hole_area_m2 = {1}; "
                "Fill Holes Below Percent max_hole_percent = {2}; hole_logic = {3}; Drop Parts "
                "Smaller Than min_part_area_m2 = {4}; all comparisons strict 'below', 0 = "
                "off".format(version, num(opts["min_hole_area_m2"]),
                             num(opts["max_hole_percent"]), opts["hole_logic"],
                             num(opts["min_part_area_m2"])))
    flags = ("tiny_area_m2 = {0}; sliver_width_m = {1}; max_thinness = {2}; touch_tolerance_m = "
             "{3}; a ring is degenerate at an area of {4} m2 or less".format(
                 num(opts["tiny_area_m2"]), num(opts["sliver_width_m"]),
                 num(opts["max_thinness"]), num(opts["touch_tolerance_m"]), num(PH_ZERO_AREA_M2)))
    # The name is cut against the bytes the fixed fields leave over (and the CRS name to
    # PH_RUN_CRS_MAX), so the WKID, the unit and the feature count are never cut away.
    crs = _ph_cut_bytes(str(crs_name), PH_RUN_CRS_MAX, "...")
    rest = "; CRS = {0} (WKID {1}); metres per unit = {2}; features read = {3}".format(
        crs, wkid, num(meters_per_unit), features)
    room = PH_RUN_TEXT_MAX - _ph_dbf_bytes("input = ") - _ph_dbf_bytes(rest)
    name = _ph_cut_bytes(str(input_name), max(3, min(PH_RUN_NAME_MAX, room)), "...")
    source = "input = " + name + rest
    return [(PH_RUN_SETTINGS, _ph_cut_bytes(settings, PH_RUN_TEXT_MAX)),
            (PH_RUN_FLAGS, _ph_cut_bytes(flags, PH_RUN_TEXT_MAX)),
            (PH_RUN_INPUT, _ph_cut_bytes(source, PH_RUN_TEXT_MAX))]


def plan_cleaning(analysis, opts=None):
    """Decide the cleaning of one analysed feature.

    Sets ``plan`` / ``detail`` on the ring rows and returns ``{"geom", "changed",
    "counts"}``: ``geom`` is the cleaned core polygon (the stored geometry itself
    when nothing was removed); ``counts`` has ``filled``, ``filled_m2``,
    ``dropped_parts``, ``dropped_m2`` (net area of the dropped parts),
    ``dropped_holes``, ``kept_island``, ``kept_largest``, ``kept_single`` (the
    ``kept_largest`` features that have one part only, so nothing was dropped from them),
    ``zero_area``, ``oriented`` (kept ``NO_OUTER`` outer rings written clockwise in a changed
    feature).
    """
    opts = opts or polygon_holes_options()
    counts = {"filled": 0, "filled_m2": 0.0, "dropped_parts": 0, "dropped_m2": 0.0,
              "dropped_holes": 0, "kept_island": 0, "kept_largest": 0, "kept_single": 0,
              "zero_area": 0, "oriented": 0}
    parts = analysis["parts"]
    if not parts:
        for row in analysis["degenerate"]:
            row["plan"] = PH_ACTION_KEEP_NO_VALID
            row["detail"] = "The feature has no ring with an area; its geometry is kept as stored."
        return {"geom": analysis["geom"], "changed": False, "counts": counts}
    drop = set()
    if opts["min_part_area_m2"] > 0:
        for part in parts:
            if part["net_m2"] < opts["min_part_area_m2"]:
                drop.add(part["index"])
    if len(drop) == len(parts):
        keep = max(parts, key=lambda p: (p["net_m2"], -p["index"]))
        drop.discard(keep["index"])
        counts["kept_largest"] += 1
        if len(parts) == 1:             # a single part below the threshold: nothing is dropped
            counts["kept_single"] += 1
        row = keep["outer_row"]
        row["plan"] = PH_ACTION_KEEP_LARGEST
        row["detail"] = ("All {0} part(s) are below {1:.6g} m2 net area (Drop Parts Smaller "
                         "Than); the largest part ({2:.6g} m2) is kept so the feature does "
                         "not vanish.".format(
                             len(parts), opts["min_part_area_m2"], keep["net_m2"]))
    # Kept parts inside each hole, transitively: a part lies inside the hole that hosts it,
    # and inside every hole that hosts one of its ancestors (outer > hole > dropped island >
    # its hole > kept island: the inner island is inside the first hole too).
    by_index = {part["index"]: part for part in parts}
    inside = {}
    for part in parts:
        if part["index"] in drop:
            continue
        host, seen = part["host"], set()
        while host is not None and host not in seen:
            seen.add(host)
            inside.setdefault(host, []).append(part["index"])
            host = by_index[host[0]]["host"] if host[0] in by_index else None
    removed = False
    fill = {}
    for part in parts:
        orow = part["outer_row"]
        if part["index"] in drop:
            removed = True
            counts["dropped_parts"] += 1
            counts["dropped_m2"] += part["net_m2"]
            orow["plan"] = PH_ACTION_DROP_PART
            orow["detail"] = ("Net area {0:.6g} m2 < {1:.6g} m2 (Drop Parts Smaller Than, "
                              "strict).".format(part["net_m2"], opts["min_part_area_m2"]))
            for hrow in part["hole_rows"]:
                counts["dropped_holes"] += 1
                hrow["plan"] = PH_ACTION_DROP_WITH_PART
                hrow["detail"] = "Hole of dropped part {0}.".format(part["index"])
            continue
        for hrow in part["hole_rows"]:
            if not _ph_hole_hit(hrow, opts):
                continue
            kept_islands = sorted(inside.get((part["index"], hrow["ring"]), ()))
            if kept_islands:
                counts["kept_island"] += 1
                hrow["plan"] = PH_ACTION_KEEP_ISLAND
                direct = set(hrow.get("islands", ()))
                deeper = [i for i in kept_islands if i not in direct]
                hrow["detail"] = "Meets the fill rule ({0}) but holds kept part(s) {1}{2}.".format(
                    _ph_hole_rule_text(hrow, opts), _ph_number_list(kept_islands),
                    " ({0} inside a deeper hole)".format(_ph_number_list(deeper))
                    if deeper else "")
                continue
            removed = True
            fill[(part["index"], hrow["ring"])] = True
            counts["filled"] += 1
            counts["filled_m2"] += hrow["area_m2"]
            hrow["plan"] = PH_ACTION_FILL
            hrow["detail"] = "Rule met: {0}.".format(_ph_hole_rule_text(hrow, opts))
    for row in analysis["degenerate"]:
        removed = True
        counts["zero_area"] += 1
        row["plan"] = PH_ACTION_DROP_ZERO
        distinct = len(set(row["coords"][:-1]))
        row["detail"] = "Ring with no area ({0} distinct vertices{1}).".format(
            distinct, "; the shoelace area is 0, so it may cross itself: run Check Geometry"
            if distinct >= 3 else "")
    if not removed:
        return {"geom": analysis["geom"], "changed": False, "counts": counts}
    rings = []
    for part in parts:
        if part["index"] in drop:
            continue
        orow = part["outer_row"]
        if PH_FLAG_NO_OUTER in orow["flags"]:
            # A counter-clockwise ring read as a part of its own: written clockwise, so the
            # cleaned copy holds the part the inventory counts (never a feature of negative
            # area when a drop leaves it alone).
            rings.append(list(reversed(part["outer"])))
            counts["oriented"] += 1
            note = ("A counter-clockwise ring with no outer ring (NO_OUTER), read as a part of "
                    "its own: written clockwise in the cleaned copy.")
            # The action is always ORIENT_NO_OUTER, so the log alone names every ring whose
            # orientation changed; a part kept as the largest says so in its DETAIL.
            orow["detail"] = note + (" " + orow["detail"] if orow.get("plan") else "")
            orow["plan"] = PH_ACTION_ORIENT
        else:
            rings.append(part["outer"])
        for hrow, ring in zip(part["hole_rows"], part["holes"]):
            if (part["index"], hrow["ring"]) not in fill:
                rings.append(ring)
    return {"geom": rings, "changed": True, "counts": counts}


# --------------------------------------------------------------------------
# Summary
# --------------------------------------------------------------------------

def polygon_holes_summary(analyses, opts, plans=None):
    """Totals over analysed features (``analyse_polygon`` results); ``plans`` are
    the ``plan_cleaning`` results of the same features, when a plan was made."""
    rows = [r for a in analyses for r in a["rows"]]
    out = {"features": len(analyses), "rings": len(rows),
           "parts": sum(len(a["parts"]) for a in analyses),
           "holes": sum(1 for r in rows if r["ring_type"] == PH_RING_HOLE),
           "degenerate": sum(1 for r in rows if r["ring_type"] == PH_RING_DEGENERATE),
           "hole_area_m2": sum(r["area_m2"] for r in rows if r["ring_type"] == PH_RING_HOLE),
           "net_area_m2": sum(p["net_m2"] for a in analyses for p in a["parts"]),
           "with_holes": sum(1 for a in analyses if any(p["hole_rows"] for p in a["parts"])),
           "multipart": sum(1 for a in analyses if len(a["parts"]) > 1)}
    for flag in PH_FLAGS:
        out["flag_" + flag] = sum(1 for r in rows if flag in r["flags"])
    totals = {"filled": 0, "filled_m2": 0.0, "dropped_parts": 0, "dropped_m2": 0.0,
              "dropped_holes": 0, "kept_island": 0, "kept_largest": 0, "kept_single": 0,
              "zero_area": 0, "oriented": 0}
    changed = 0
    for plan in plans or ():
        for key in totals:
            totals[key] += plan["counts"][key]
        changed += 1 if plan["changed"] else 0
    out.update(totals)
    out["features_changed"] = changed
    out["cleaned_net_area_m2"] = out["net_area_m2"] - totals["dropped_m2"] + totals["filled_m2"]
    return out


# ==========================================================================
# analysis/thinning_core.py
# ==========================================================================
# Priority point thinning (pure Python, no arcpy).
#
# Selects a subset of points so that no two kept points are closer than a minimum
# spacing, preferring the points with the highest priority.
#
# The method is a **greedy selection** (a maximal independent set of the graph
# that joins every two points closer than the spacing):
#
# 1. Rank the points: protected points first, then by priority (highest or
#    lowest value first, null / NaN last), then by the tie-break field, then by
#    ObjectID (ascending). The order is total, so the result is deterministic.
# 2. Walk through the ranked points. A protected point is always kept. Any other
#    point is kept unless a point that is already kept lies closer than the
#    spacing; then it is removed, and the nearest such kept point is its
#    REMOVED_BY.
#
# Guarantees (proved by the tests against an O(n^2) reference):
#
# * **Spacing:** every kept point that is not protected is at least the spacing
#   away from every other kept point. Only two *protected* points can be closer
#   than the spacing (they are kept anyway and reported).
# * **Maximality:** every removed point has a kept point within the spacing that
#   was ranked before it (so it has a higher priority, or the same priority and a
#   lower ObjectID, or it is protected).
# * **Same as the recursive definition:** a point is kept exactly when no
#   higher-ranked kept point is closer than the spacing.
#
# It is a heuristic for the real goal (keep as many important points as
# possible): the result is maximal, not the largest possible set. Finding the
# largest set of points that are pairwise far enough apart is NP-hard in general.
#
# Distances are planar, in the units of the coordinates, or (with the ``ground`` maps of the
# points, see ``thin_ground_map``) ground distances in metres; the tool always uses ground
# distances. The spatial hash makes the thinning close to linear in the
# number of points for ordinary spacings (stacked PROTECTED points are the slow case:
# each one is compared with every kept point within the spacing). The spacing
# statistics use a k-d tree, O(N log N) at any density.

THIN_HIGHEST = "HIGHEST_VALUE"
THIN_LOWEST = "LOWEST_VALUE"
THIN_ORDERS = (THIN_HIGHEST, THIN_LOWEST)

# The hash cell is a little wider than the spacing so that rounding in the cell
# index can never separate two points closer than the spacing by two cells.
THIN_CELL_FACTOR = 1.0 + 1e-6
# Largest extent / spacing ratio accepted (the cell index stays far below 2**53,
# so a rounding error in the index is far below the 1e-6 margin above).
THIN_MAX_CELLS = 1e9

# Projected systems whose scale changes strongly across the map. Used only to choose the
# explanation of a refusal (the refusal itself is the scale measured at the points, outside
# THIN_MIN_SCALE .. THIN_MAX_SCALE). SAME LABEL RULE (words and WKIDs) as ``shape_distorting_system`` in
# analysis/shape_metrics_core.py; a test keeps the two in step (proposed shared home:
# common/projection.py, see docs/build_notes/PriorityPointThinning).
_THIN_LOCAL_MERCATOR_WORDS = ("transverse", "oblique", "utm", "hotine", "gauss")
_THIN_CYLINDRICAL_WORDS = ("plate_carree", "plate carree", "equidistant_cylindrical",
                           "equidistant cylindrical", "cylindrical", "miller", "behrmann",
                           "gall_", "ease_grid", "ease-grid")
_THIN_WORLD_WORDS = ("world_", "world ", "_world", "global", "equal_earth", "equal earth")
THIN_DISTORTING_WKIDS = frozenset((3395, 3832, 32662, 4087, 54001, 54002, 54003, 54004,
                                   54034, 3410, 3975, 6933, 3786, 54017, 54016))


def thin_distorting_system(name, wkid=None):
    """Short English label (``"a Mercator system"``, ``"a cylindrical world system"``,
    ``"a world-scale system"``) when the projected system ``name`` (WKID ``wkid``)
    stretches distances by a large, place-dependent factor, else ``None``. Name based
    plus a WKID list: a custom system with an unusual name is not recognised."""
    text = str(name or "").lower()
    if "mercator" in text and not any(w in text for w in _THIN_LOCAL_MERCATOR_WORDS):
        return "a Mercator system"
    if any(w in text for w in _THIN_CYLINDRICAL_WORDS):
        return "a cylindrical world system"
    if any(w in text for w in _THIN_WORLD_WORDS):
        return "a world-scale system"
    try:
        code = int(wkid) if wkid else None
    except (TypeError, ValueError):
        code = None
    if code in THIN_DISTORTING_WKIDS:
        return "a world-scale system"
    return None


# What a distorting system does to a spacing, by the label of ``thin_distorting_system``
# (each example is true for the systems of that label: no Plate Carree figure in a
# Mercator message).
THIN_DISTORTION_EXAMPLES = {
    "a Mercator system": "by 1 / cos(latitude) in every direction, about 10 % at 25 degrees "
                         "north and 41 % at 45 degrees",
    "a cylindrical world system": "by a factor that changes with latitude and differs between "
                                  "east-west and north-south (in Plate Carree, for example, "
                                  "east-west distances at 25 degrees north come out about 10 % "
                                  "too long)",
    "a world-scale system": "by a factor that changes across the map, so no single scale fits "
                            "a local spacing",
}

# Pole-centred azimuthal systems (any azimuthal projection about a pole: polar Lambert
# azimuthal equal-area, polar azimuthal equidistant, polar orthographic ...). Polar stereographic
# systems are found by the shared probe (``arcio.sr_info["polar_stereographic"]``); this test
# finds the other pole-centred ones, whose scale also changes with the distance from the pole.
# The test is exact symmetry (circles round the pole, meridians as rays 90 degrees apart), true
# for an azimuthal projection about a pole on the sphere and on the ellipsoid, so the tolerance
# only absorbs rounding; it is tight enough that a conic system (meridians n x 90 degrees apart)
# or a transverse Mercator system near the pole does not pass.
THIN_POLE_PROBE_TOLERANCE = 1e-6

# GROUND DISTANCES. Every distance the tool tests or writes is a distance on the ground (on the
# WGS 1984 ellipsoid), whatever the projected system. At every input point the tool measures the
# local linear map of the projection with a tiny probe: the point is projected to latitude and
# longitude, four points THIN_PROBE_STEP_M metres east, west, north and south of it (on the
# ellipsoid) are projected back, and central differences give J, the 2 x 2 map of a ground metre
# (east, north) to coordinate metres. Its inverse G turns a coordinate vector into ground metres.
# The ground distance of two points p and q is the trapezoid rule of the length of the straight
# segment between them: (|G_p (q - p)| + |G_q (q - p)|) / 2 (symmetric; within about 1e-6 of the
# geodesic for spacings up to 20 km in the tests, growing with the square of the distance).
# The point scale (how much the system stretches a ground distance at a point, in any direction)
# lies between the singular values of J; a point whose scale is below THIN_MIN_SCALE or above
# THIN_MAX_SCALE is refused (a system that halves or doubles distances there is not one to thin
# in), and so is a point whose scale cannot be measured.
THIN_PROBE_STEP_M = 100.0
# With ground maps, two kept points whose distances to a removed point agree to this relative
# amount are equally near (REMOVED_BY names the one ranked first): the measured maps round in
# the last digits, so an exact tie on the ground must not depend on that rounding.
THIN_TIE_REL = 1e-9
THIN_MIN_SCALE = 0.5
THIN_MAX_SCALE = 2.0
# Closer than this to the earth's axis (about 1 km from a pole) east has no usable direction and
# the probe is not taken: the scale there is "not measurable".
THIN_PROBE_MIN_AXIS_M = 1000.0
_THIN_WGS84_A = 6378137.0
_THIN_WGS84_E2 = 0.00669437999014


def thin_probe_points(lon, lat, step_m=THIN_PROBE_STEP_M):
    """``([(lon, lat) east, west, north, south], h)``: the four points ``h`` metres from
    (``lon``, ``lat``) along the parallel and the meridian on the WGS 84 ellipsoid (an arc of the
    parallel, N cos(lat) d(lon), and of the meridian, M d(lat)), ``h = min(step_m, r / 1000)``
    for the distance ``r`` from the earth's axis, so the probe never crosses a pole. ``None`` for
    non-finite input, a latitude outside -90 .. 90 or a point closer than
    ``THIN_PROBE_MIN_AXIS_M`` to the axis."""
    try:
        lon, lat = float(lon), float(lat)
    except (TypeError, ValueError):
        return None
    if not (math.isfinite(lon) and math.isfinite(lat)) or abs(lat) > 90.0:
        return None
    phi = math.radians(lat)
    w = 1.0 - _THIN_WGS84_E2 * math.sin(phi) ** 2
    axis = _THIN_WGS84_A / math.sqrt(w) * math.cos(phi)
    if not axis >= THIN_PROBE_MIN_AXIS_M:
        return None
    m_radius = _THIN_WGS84_A * (1.0 - _THIN_WGS84_E2) / w ** 1.5
    h = min(float(step_m), axis / 1000.0)
    dlon = math.degrees(h / axis)
    dlat = math.degrees(h / m_radius)
    return [(lon + dlon, lat), (lon - dlon, lat), (lon, lat + dlat), (lon, lat - dlat)], h


def thin_singular_values(a, b, c, d):
    """``(largest, smallest)`` singular value of the 2 x 2 matrix [[a, b], [c, d]]: the largest
    and smallest stretch of a vector of length 1 in any direction."""
    h1 = math.hypot(a + d, b - c)
    h2 = math.hypot(a - d, b + c)
    return (h1 + h2) / 2.0, abs(h1 - h2) / 2.0


def thin_ground_map(projected, h, metres_per_unit=1.0):
    """``(G, k_min, k_max)`` at a point from ``projected``: the four probe points of
    ``thin_probe_points`` (east, west, north, south, ``h`` metres away) as ``(x, y)`` in the
    projected system (units of ``metres_per_unit`` metres). ``G = (g11, g12, g21, g22)`` turns a
    coordinate vector ``(dx, dy)`` (system units) into ground metres east and north;
    ``k_min``, ``k_max`` are the smallest and largest factor by which the system stretches a
    ground distance there (the singular values of J). ``None`` when a point is missing or not
    finite, or the map is singular."""
    try:
        (xe, ye), (xw, yw), (xn, yn), (xs, ys) = [(float(p[0]), float(p[1])) for p in projected]
        mpu = float(metres_per_unit)
        f = mpu / (2.0 * float(h))
    except (TypeError, ValueError, IndexError, ZeroDivisionError):
        return None
    j00, j10 = (xe - xw) * f, (ye - yw) * f       # a ground metre east, in coordinate metres
    j01, j11 = (xn - xs) * f, (yn - ys) * f       # a ground metre north
    if not all(math.isfinite(v) for v in (j00, j01, j10, j11)):
        return None
    det = j00 * j11 - j01 * j10
    if not (math.isfinite(det) and det != 0.0):
        return None
    k_max, k_min = thin_singular_values(j00, j01, j10, j11)
    if not k_min > 0.0:
        return None
    g = mpu / det
    return (j11 * g, -j01 * g, -j10 * g, j00 * g), k_min, k_max


def thin_ground_distance(g_p, g_q, dx, dy):
    """Ground distance (metres) of two points ``(dx, dy)`` apart (system units) whose ground maps
    (``G`` of ``thin_ground_map``) are ``g_p`` and ``g_q``: ``(|G_p d| + |G_q d|) / 2``."""
    return (math.hypot(g_p[0] * dx + g_p[1] * dy, g_p[2] * dx + g_p[3] * dy)
            + math.hypot(g_q[0] * dx + g_q[1] * dy, g_q[2] * dx + g_q[3] * dy)) / 2.0


def thin_ground_floor(ground):
    """Smallest stretch ``|G d| / |d|`` over the maps of ``ground`` (an iterable of ``G``): a
    ground distance is never below this factor times the distance in system units, so a search
    radius of ``spacing / floor`` system units finds every pair closer than the spacing."""
    floor = None
    for g in ground:
        low = thin_singular_values(*g)[1]
        if floor is None or low < floor:
            floor = low
    return floor


def thin_pole_azimuthal_probe(projected, lats, lons, tolerance=THIN_POLE_PROBE_TOLERANCE):
    """True when ``projected`` (the points ``(lon, lat)`` for every ``lat`` of ``lats`` and
    every ``lon`` of ``lons``, latitude-major, projected into the system tested, as ``(x, y)``;
    ``None`` or non-finite entries where a point could not be projected) is what an AZIMUTHAL
    projection about that pole gives: every latitude on a circle round one common centre (the
    pole), the circles smaller towards the pole, and each meridian a straight ray from the
    centre at its own longitude (``lons`` must be 4 longitudes 90 degrees apart, as
    ``projection.POLAR_PROBE_LONS``): consecutive meridians 90 degrees apart, turning the same
    way. A conic or cylindrical system fails (meridians not 90 degrees apart, or not rays);
    the radius ratio is NOT tested, so any azimuthal projection about the pole passes."""
    n = len(lons)
    if projected is None or n != 4 or len(projected) != n * len(lats) or len(lats) < 2:
        return False
    pts = []
    for p in projected:
        try:
            x, y = float(p[0]), float(p[1])
        except (TypeError, ValueError, IndexError):
            return False
        if not (math.isfinite(x) and math.isfinite(y)):
            return False
        pts.append((x, y))
    rows = [pts[i * n:(i + 1) * n] for i in range(len(lats))]
    mids = [((g[a][0] + g[a + 2][0]) / 2.0, (g[a][1] + g[a + 2][1]) / 2.0)
            for g in rows for a in (0, 1)]
    cx = sum(m[0] for m in mids) / len(mids)
    cy = sum(m[1] for m in mids) / len(mids)
    scale = max(math.hypot(x - cx, y - cy) for x, y in pts)
    if not scale > 0.0:
        return False
    if any(math.hypot(mx - cx, my - cy) > tolerance * scale for mx, my in mids):
        return False                       # the latitude circles have no common centre
    radii = []
    turn = None
    for g in rows:
        rs = [math.hypot(x - cx, y - cy) for x, y in g]
        r = sum(rs) / len(rs)
        if not r > 0.0 or any(abs(v - r) > tolerance * r for v in rs):
            return False                   # not a circle round the centre
        radii.append(r)
        angles = [math.atan2(y - cy, x - cx) for x, y in g]
        for k in range(n):
            step = (angles[(k + 1) % n] - angles[k]) % (2.0 * math.pi)
            if abs(step - math.pi / 2.0) <= tolerance * 2.0 * math.pi:
                sign = 1
            elif abs(step - 1.5 * math.pi) <= tolerance * 2.0 * math.pi:
                sign = -1
            else:
                return False               # meridians not 90 degrees apart
            if turn is None:
                turn = sign
            elif sign != turn:
                return False
        if g is not rows[0]:               # the same meridian keeps its direction (a ray)
            first = rows[0]
            for k in range(n):
                a0 = math.atan2(first[k][1] - cy, first[k][0] - cx)
                a1 = math.atan2(g[k][1] - cy, g[k][0] - cx)
                d = abs((a1 - a0 + math.pi) % (2.0 * math.pi) - math.pi)
                if d > tolerance * 2.0 * math.pi:
                    return False
    # circles shrink towards the pole: order the latitudes by distance from the pole
    order = sorted(range(len(lats)), key=lambda i: -abs(float(lats[i])))
    ordered = [radii[i] for i in order]
    return all(ordered[i] < ordered[i + 1] for i in range(len(ordered) - 1))


# ObjectID fields (SRC_OID, REMOVED_BY): ``common.arcio.oid_field_spec``.


def thin_spacing_from_scale(scale, symbol_mm):
    """Ground spacing in metres for a minimum paper distance of ``symbol_mm``
    millimetres on a map of scale 1:``scale``: ``scale * symbol_mm / 1000``."""
    scale = float(scale)
    symbol_mm = float(symbol_mm)
    if not (math.isfinite(scale) and scale > 0):
        raise ToolError("The map scale denominator must be greater than 0.",
                        "Enter the number after the colon, for example 25000 for 1:25,000.")
    if not (math.isfinite(symbol_mm) and symbol_mm > 0):
        raise ToolError("The symbol spacing in millimetres must be greater than 0.",
                        "Enter the smallest distance you want between two symbols on paper, "
                        "for example 3.")
    metres = scale * symbol_mm / 1000.0
    if not math.isfinite(metres):
        raise ToolError("The map scale times the symbol distance is too large: the spacing "
                        "({0:g} x {1:g} mm / 1000) is not a finite number.".format(scale, symbol_mm),
                        "Check the Map Scale (the number after the colon, for example 25000) and "
                        "the Symbol Distance on Paper in millimetres (for example 3).")
    return metres


def thin_number(value):
    """``value`` as a number, or ``None`` for null, NaN, text and booleans."""
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        if isinstance(value, float) and value != value:
            return None
        return value
    return None


def thin_group_key(value):
    """Group key: ``None`` for null / NaN, else the value itself (``1`` and ``1.0`` are
    one group; text is compared exactly, case and spaces included)."""
    if value is None or (isinstance(value, float) and value != value):
        return None
    return value


def thin_group_text(key):
    """Text of a group key for the summary table (``None`` -> ``None``)."""
    return None if key is None else value_to_text(key)


def thin_rank_key(record, high_first=True, tie_high_first=True):
    """Sort key of a record ``(oid, x, y, priority, tiebreak, protected)``.

    Protected points first; then priority (null / NaN after every number, in
    either direction), then the tie-break (same rule), then the ObjectID."""
    oid, _x, _y, pri, tie, protected = record[:6]
    p = thin_number(pri)
    t = thin_number(tie)
    pk = (1, 0) if p is None else (0, -p if high_first else p)
    tk = (1, 0) if t is None else (0, -t if tie_high_first else t)
    return (0 if protected else 1, pk, tk, oid)


# Range of spacings (in coordinate units) the squared-distance test can handle: the conflict
# test compares dx^2 + dy^2 with spacing^2, and the statistics square cells up to about 1e10
# times the spacing. Outside this range a square can underflow to 0 (two coincident points
# would both be kept) or overflow to infinity. Far beyond any real map distance.
THIN_MIN_SPACING = 1e-140
THIN_MAX_SPACING = 1e140


def _thin_length_text(value, metres_per_unit=None):
    """``value`` (coordinate units) as text: in metres when ``metres_per_unit`` is known."""
    if metres_per_unit:
        return "{0:g} m".format(value * metres_per_unit)
    return "{0:g}".format(value)


def _thin_check_spacing(spacing, metres_per_unit=None):
    s = float(spacing)
    if s != s or s <= 0:
        raise ToolError("The spacing must be a number greater than 0.",
                        "Enter a minimum distance in metres, for example 50.")
    if not math.isfinite(s):
        raise ToolError("The spacing is too large: it is not a finite number.",
                        "Enter a smaller spacing (or a smaller map scale or symbol distance), "
                        "for example 50 m.")
    if s < THIN_MIN_SPACING:
        raise ToolError("The spacing ({0}) is too small to compute with: its square is below "
                        "the range of floating-point numbers, so points at one location would "
                        "not be seen as closer than the spacing.".format(
                            _thin_length_text(s, metres_per_unit)),
                        "Enter a spacing of at least {0}.".format(
                            _thin_length_text(THIN_MIN_SPACING, metres_per_unit)))
    if s > THIN_MAX_SPACING:
        raise ToolError("The spacing ({0}) is too large to compute with: its square is beyond "
                        "the range of floating-point numbers.".format(
                            _thin_length_text(s, metres_per_unit)),
                        "Enter a spacing of at most {0}.".format(
                            _thin_length_text(THIN_MAX_SPACING, metres_per_unit)))
    return s


def thin_one_group(points, spacing, high_first=True, tie_high_first=True, progress=None,
                   metres_per_unit=None, ground=None):
    """Thin the points of ONE group.

    ``points``: ``[(oid, x, y, priority, tiebreak, protected), ...]`` with finite
    coordinates and distinct ObjectIDs. Without ``ground`` the distances are planar and
    ``spacing`` is in the unit of the coordinates. With ``ground`` (``{oid: G}``, the ground map
    of every point, see ``thin_ground_map``) the distances are ground distances in metres
    (``thin_ground_distance``) and ``spacing`` is in metres. Returns a dict:

    * ``order`` - ObjectIDs in processing order; ``rank`` - ``{oid: 1-based position}``;
    * ``kept`` - kept ObjectIDs in processing order;
    * ``removed`` - ``{oid: (removed_by_oid, distance)}``; the suppressor is the
      nearest kept point that was ranked before the point (ties: lowest rank; with ``ground``,
      distances that agree to ``THIN_TIE_REL`` are ties);
    * ``violations`` - ``{oid: (partner_oid, distance)}`` for every protected
      point that has another protected point closer than the spacing (its nearest
      one); ``violation_pairs`` - the number of such protected pairs;
      ``pair_firsts`` - ``{oid: n}``: the number of those pairs whose higher-ranked
      member (processed first) is ``oid`` (at most one entry per point, so memory stays
      linear even when thousands of protected points lie within one spacing);
    * ``null_priority`` - ObjectIDs whose priority is null / NaN.

    ``metres_per_unit`` (optional) is used only to state lengths in metres in the
    refusal messages.
    """
    s = _thin_check_spacing(spacing, 1.0 if ground is not None else metres_per_unit)
    result = {"order": [], "rank": {}, "kept": [], "removed": {}, "violations": {},
              "violation_pairs": 0, "pair_firsts": {}, "null_priority": []}
    if not points:
        return result
    records = sorted(points, key=lambda r: thin_rank_key(r, high_first, tie_high_first))
    xs = [r[1] for r in records]
    ys = [r[2] for r in records]
    x0, y0 = min(xs), min(ys)
    extent = max(max(xs) - x0, max(ys) - y0)
    radius = s                                   # search radius in coordinate units
    if ground is not None:
        floor = thin_ground_floor(ground[r[0]] for r in records)
        if not (floor and floor > 0.0 and math.isfinite(s / floor)):
            raise ToolError("The ground scale of the points could not be used (a point's ground "
                            "map is singular).", "Project the points to another projected system "
                            "(Project tool) first.")
        radius = s / floor
    if extent / radius > THIN_MAX_CELLS:
        raise ToolError(
            "The spacing ({0}) is too small for the extent of the points ({1}): "
            "the extent is more than {2:.0e} times the spacing.".format(
                _thin_length_text(s, 1.0 if ground is not None else metres_per_unit),
                _thin_length_text(extent, metres_per_unit), THIN_MAX_CELLS),
            "Enter a larger spacing, or thin a smaller area (use a selection).")
    cell = radius * THIN_CELL_FACTOR
    s2 = s * s
    floor_ = math.floor
    sqrt = math.sqrt
    hypot = math.hypot
    grid = {}
    order, rank, kept = result["order"], result["rank"], result["kept"]
    removed, violations = result["removed"], result["violations"]
    pair_firsts = result["pair_firsts"]
    for position, rec in enumerate(records, 1):
        oid, x, y, pri = rec[0], rec[1], rec[2], rec[3]
        protected = rec[5]
        order.append(oid)
        rank[oid] = position
        if thin_number(pri) is None:
            result["null_priority"].append(oid)
        g = ground[oid] if ground is not None else None
        ix = int(floor_((x - x0) / cell))
        iy = int(floor_((y - y0) / cell))
        best = None          # (d2, rank of the kept point, its oid)
        close = []           # every kept point within the spacing (needed for protected points)
        near = []            # with ground maps: every kept point within the spacing
        for gx in (ix - 1, ix, ix + 1):
            for gy in (iy - 1, iy, iy + 1):
                bucket = grid.get((gx, gy))
                if not bucket:
                    continue
                for qx, qy, qoid, qrank, qg in bucket:
                    dx = x - qx
                    dy = y - qy
                    if g is None:
                        d2 = dx * dx + dy * dy
                    else:
                        d = (hypot(g[0] * dx + g[1] * dy, g[2] * dx + g[3] * dy)
                             + hypot(qg[0] * dx + qg[1] * dy, qg[2] * dx + qg[3] * dy)) / 2.0
                        d2 = d * d
                    if d2 < s2:
                        if protected:
                            close.append((d2, qoid))
                        if g is not None:
                            near.append((d2, qrank, qoid))
                        if best is None or (d2, qrank) < (best[0], best[1]):
                            best = (d2, qrank, qoid)
        if near and len(near) > 1:
            # ground distances carry the rounding of the measured maps: kept points whose
            # distances agree to THIN_TIE_REL count as equally near; the one ranked first is named
            limit = best[0] * (1.0 + THIN_TIE_REL) ** 2
            best = min((c for c in near if c[0] <= limit), key=lambda c: c[1])
        if protected:
            if best is not None:
                result["violation_pairs"] += len(close)
                dist = sqrt(best[0])
                violations[oid] = (best[2], dist)
                for d2, qoid in close:     # the earlier protected points see this one too
                    pair_firsts[qoid] = pair_firsts.get(qoid, 0) + 1
                    other = violations.get(qoid)
                    if other is None or sqrt(d2) < other[1]:
                        violations[qoid] = (oid, sqrt(d2))
            kept.append(oid)
            grid.setdefault((ix, iy), []).append((x, y, oid, position, g))
        elif best is not None:
            removed[oid] = (best[2], sqrt(best[0]))
        else:
            kept.append(oid)
            grid.setdefault((ix, iy), []).append((x, y, oid, position, g))
        if progress is not None:
            progress()
    return result


# Points per leaf of the k-d tree of ``thin_nearest_kept``.
THIN_KD_LEAF = 8


def _thin_box_gap2(x, y, x0, y0, x1, y1):
    """Squared distance from (x, y) to the box [x0, x1] x [y0, y1] (0 inside). Floating-point
    rounding is monotone, so it is never larger than the computed squared distance to any point
    of the box: a box is skipped only when none of its points can be nearer."""
    dx = x0 - x if x < x0 else (x - x1 if x > x1 else 0.0)
    dy = y0 - y if y < y0 else (y - y1 if y > y1 else 0.0)
    return dx * dx + dy * dy


def thin_nearest_kept(points, spacing, progress=None, ground=None):
    """Distance from every point to its nearest OTHER point of the same list.

    ``points``: ``[(oid, x, y), ...]``. Returns ``{oid: distance}``; a list with
    one point gives an empty dict. Exact (the smallest computed distance, so
    the same value a brute-force search gives), and O(N log N) WHATEVER the density:
    a balanced 2-d tree (median splits, at most ``THIN_KD_LEAF`` points per leaf) is
    searched nearer branch first, and a branch is skipped only when its bounding box
    is farther than the best distance found. The search stops at once when an
    identical point is found. Kept points of different groups (a Group Field without
    Apply Spacing Across Groups) can lie at any density, even stacked, so the cost
    must not depend on the spacing; ``spacing`` is only checked.

    With ``ground`` (``{oid: G}``) the distances are ground distances in metres
    (``thin_ground_distance``); a box is then skipped when its planar gap times
    ``thin_ground_floor`` (a lower bound of every ground distance to it) is farther."""
    if len(points) < 2:
        return {}
    _thin_check_spacing(spacing)
    if ground is not None:
        return _thin_nearest_ground(points, ground, progress)
    xs = [p[1] for p in points]
    ys = [p[2] for p in points]
    bx0, by0, bx1, by1, left, right, leaves = [], [], [], [], [], [], []
    leaf_size = THIN_KD_LEAF

    def build(ids):
        node = len(left)
        nx = [xs[i] for i in ids]
        ny = [ys[i] for i in ids]
        x0, x1, y0, y1 = min(nx), max(nx), min(ny), max(ny)
        bx0.append(x0)
        by0.append(y0)
        bx1.append(x1)
        by1.append(y1)
        left.append(-1)
        right.append(-1)
        leaves.append(None)
        if len(ids) <= leaf_size:
            leaves[node] = [(xs[i], ys[i], i) for i in ids]
            return node
        ids.sort(key=(xs if x1 - x0 >= y1 - y0 else ys).__getitem__)
        half = len(ids) // 2
        left[node] = build(ids[:half])
        right[node] = build(ids[half:])
        return node

    build(list(range(len(points))))
    gap2 = _thin_box_gap2

    def search(node, x, y, i, best):
        leaf = leaves[node]
        if leaf is not None:
            for qx, qy, j in leaf:
                if j != i:
                    d2 = (x - qx) * (x - qx) + (y - qy) * (y - qy)
                    if d2 < best:
                        best = d2
            return best
        a, b = left[node], right[node]
        da = gap2(x, y, bx0[a], by0[a], bx1[a], by1[a])
        db = gap2(x, y, bx0[b], by0[b], bx1[b], by1[b])
        if db < da:
            a, b, da, db = b, a, db, da
        if da <= best:
            best = search(a, x, y, i, best)
            if db <= best and best > 0.0:
                best = search(b, x, y, i, best)
        return best

    out = {}
    inf = float("inf")
    sqrt = math.sqrt
    for i, rec in enumerate(points):
        out[rec[0]] = sqrt(search(0, xs[i], ys[i], i, inf))
        if progress is not None:
            progress()
    return out


def _thin_nearest_ground(points, ground, progress=None):
    """``thin_nearest_kept`` with ground distances (same tree, ground metric)."""
    xs = [p[1] for p in points]
    ys = [p[2] for p in points]
    gs = [ground[p[0]] for p in points]
    floor = thin_ground_floor(gs)
    bx0, by0, bx1, by1, left, right, leaves = [], [], [], [], [], [], []
    leaf_size = THIN_KD_LEAF

    def build(ids):
        node = len(left)
        nx = [xs[i] for i in ids]
        ny = [ys[i] for i in ids]
        x0, x1, y0, y1 = min(nx), max(nx), min(ny), max(ny)
        bx0.append(x0)
        by0.append(y0)
        bx1.append(x1)
        by1.append(y1)
        left.append(-1)
        right.append(-1)
        leaves.append(None)
        if len(ids) <= leaf_size:
            leaves[node] = list(ids)
            return node
        ids.sort(key=(xs if x1 - x0 >= y1 - y0 else ys).__getitem__)
        half = len(ids) // 2
        left[node] = build(ids[:half])
        right[node] = build(ids[half:])
        return node

    build(list(range(len(points))))
    gap2 = _thin_box_gap2
    sqrt = math.sqrt
    dist = thin_ground_distance
    # a box is skipped when floor * gap > best; the factor below makes that safe against the
    # rounding of the bound (it only makes the search visit a box a little more often)
    margin = 1.0 - 1e-9

    def search(node, x, y, i, best):
        leaf = leaves[node]
        if leaf is not None:
            gi = gs[i]
            for j in leaf:
                if j != i:
                    d = dist(gi, gs[j], x - xs[j], y - ys[j])
                    if d < best:
                        best = d
            return best
        a, b = left[node], right[node]
        da = floor * sqrt(gap2(x, y, bx0[a], by0[a], bx1[a], by1[a])) * margin
        db = floor * sqrt(gap2(x, y, bx0[b], by0[b], bx1[b], by1[b])) * margin
        if db < da:
            a, b, da, db = b, a, db, da
        if da <= best:
            best = search(a, x, y, i, best)
            if db <= best and best > 0.0:
                best = search(b, x, y, i, best)
        return best

    out = {}
    inf = float("inf")
    for i, rec in enumerate(points):
        out[rec[0]] = search(0, xs[i], ys[i], i, inf)
        if progress is not None:
            progress()
    return out


def thin_points(points, spacing, high_first=True, tie_high_first=True, progress=None,
                across_groups=False, metres_per_unit=None, ground=None):
    """Thin points group by group.

    ``points``: ``[(oid, x, y, priority, tiebreak, protected, group), ...]``.
    Points of different groups never influence each other (a null group is a group
    of its own), so the spacing is guaranteed WITHIN each group only; with
    ``across_groups`` all points are thinned as one set (the groups then only split
    the statistics) and the spacing holds between any two kept points. Returns a dict:

    * ``groups`` - one dict per group in a natural-sort order of the group text
      (null last): ``key``, ``n_in``, ``n_kept``, ``n_removed``, ``n_protected``,
      ``n_violating`` (protected points with a protected neighbour closer than the
      spacing), ``violation_pairs`` (with ``across_groups`` a pair may join two
      groups; it is counted once, in the group of its higher-ranked point),
      ``min_spacing`` (smallest distance between two
      kept points), ``min_spacing_free`` (smallest nearest-neighbour distance of a
      kept point that is not protected: the spacing guarantee), ``mean_spacing``
      (mean nearest-neighbour distance of the kept points), ``null_priority``;
      the three spacings are ``None`` when the group keeps fewer than two points
      (``min_spacing_free``: when it keeps no unprotected point);
    * ``overall`` - the same three spacings over ALL kept points, whatever their
      group (nearest neighbour in any group);
    * ``rank``, ``kept`` (set), ``removed`` (``{oid: (by, distance)}``),
      ``violations`` (``{oid: (partner, distance)}``), ``group_of`` (``{oid: key}``).

    ``metres_per_unit`` (optional) only puts lengths in metres into the refusal messages.
    ``ground`` (optional, ``{oid: G}`` for every point, see ``thin_ground_map``): every distance
    (the spacing test, removal distances and the three spacings) is then a ground distance in
    metres, and ``spacing`` is in metres.
    """
    s = _thin_check_spacing(spacing, 1.0 if ground is not None else metres_per_unit)
    by_group = {}
    for rec in points:
        by_group.setdefault(thin_group_key(rec[6]), []).append(rec[:6])
    keys = sorted(by_group, key=lambda k: (k is None, natural_sort_key(thin_group_text(k))))
    result = {"groups": [], "rank": {}, "kept": set(), "removed": {}, "violations": {},
              "group_of": {}, "overall": None}
    xy_all = dict((r[0], (r[1], r[2])) for r in points)
    protected_all = set(r[0] for r in points if r[5])
    if across_groups:
        one_all = thin_one_group([r[:6] for r in points], s, high_first, tie_high_first, progress,
                                 metres_per_unit, ground)
        # Split the one-set result by group in ONE pass over it (O(N), not O(N x groups)).
        key_of = dict((r[0], thin_group_key(r[6])) for r in points)
        split = dict((k, {"kept": [], "removed": {}, "violations": {}, "null_priority": [],
                          "rank": {}, "order": [], "violation_pairs": 0}) for k in keys)
        for o in one_all["order"]:
            part = split[key_of[o]]
            part["order"].append(o)
            part["rank"][o] = one_all["rank"][o]
        for o in one_all["kept"]:
            split[key_of[o]]["kept"].append(o)
        for o in one_all["null_priority"]:
            split[key_of[o]]["null_priority"].append(o)
        for o, v in one_all["removed"].items():
            split[key_of[o]]["removed"][o] = v
        for o, v in one_all["violations"].items():
            split[key_of[o]]["violations"][o] = v
        # each violating pair counted once, in the group of its first (higher-ranked) member
        for first, n in one_all["pair_firsts"].items():
            split[key_of[first]]["violation_pairs"] += n
    for key in keys:
        recs = by_group[key]
        if across_groups:
            one = split[key]
        else:
            one = thin_one_group(recs, s, high_first, tie_high_first, progress, metres_per_unit,
                                 ground)
        protected = set(r[0] for r in recs if r[5])
        kept_points = [(o, xy_all[o][0], xy_all[o][1]) for o in one["kept"]]
        nn = thin_nearest_kept(kept_points, s, ground=ground)
        free = [nn[o] for o in one["kept"] if o not in protected and o in nn]
        values = list(nn.values())
        result["groups"].append({
            "key": key, "n_in": len(recs), "n_kept": len(one["kept"]),
            "n_removed": len(one["removed"]), "n_protected": len(protected),
            "n_violating": len(one["violations"]), "violation_pairs": one["violation_pairs"],
            "min_spacing": min(values) if values else None,
            "min_spacing_free": min(free) if free else None,
            "mean_spacing": (math.fsum(values) / len(values)) if values else None,
            "null_priority": len(one["null_priority"])})
        result["rank"].update(one["rank"])
        result["kept"].update(one["kept"])
        result["removed"].update(one["removed"])
        result["violations"].update(one["violations"])
        for o in one["order"]:
            result["group_of"][o] = key
    if len(result["groups"]) == 1:
        g = result["groups"][0]
        result["overall"] = {"min_spacing": g["min_spacing"],
                             "min_spacing_free": g["min_spacing_free"],
                             "mean_spacing": g["mean_spacing"]}
    else:
        kept_points = [(o, xy_all[o][0], xy_all[o][1]) for o in result["kept"]]
        nn = thin_nearest_kept(kept_points, s, ground=ground)
        free = [d for o, d in nn.items() if o not in protected_all]
        values = list(nn.values())
        result["overall"] = {"min_spacing": min(values) if values else None,
                             "min_spacing_free": min(free) if free else None,
                             "mean_spacing": (math.fsum(values) / len(values)) if values else None}
    return result


def thin_total_row(groups, overall=None):
    """Totals over the group rows of ``thin_points`` (same keys, ``key`` None).

    The three spacings are those of the whole run when ``overall`` (the ``overall``
    entry of the ``thin_points`` result) is given: the nearest neighbour of a kept
    point may then be in another group. Without it they combine the group rows
    (smallest of the group minima, weighted mean), which describes the spacing
    within groups only."""
    def smallest(name):
        values = [g[name] for g in groups if g[name] is not None]
        return min(values) if values else None
    # Mean over all kept points that have a neighbour: a group with at least two kept
    # points has one nearest-neighbour value per kept point.
    weights = [(g["mean_spacing"], g["n_kept"]) for g in groups if g["mean_spacing"] is not None]
    total_n = sum(n for _m, n in weights)
    mean = (math.fsum(m * n for m, n in weights) / total_n) if total_n else None
    return {"key": None, "n_in": sum(g["n_in"] for g in groups),
            "n_kept": sum(g["n_kept"] for g in groups),
            "n_removed": sum(g["n_removed"] for g in groups),
            "n_protected": sum(g["n_protected"] for g in groups),
            "n_violating": sum(g["n_violating"] for g in groups),
            "violation_pairs": sum(g["violation_pairs"] for g in groups),
            "min_spacing": overall["min_spacing"] if overall else smallest("min_spacing"),
            "min_spacing_free": (overall["min_spacing_free"] if overall
                                 else smallest("min_spacing_free")),
            "mean_spacing": overall["mean_spacing"] if overall else mean,
            "null_priority": sum(g["null_priority"] for g in groups)}


# ==========================================================================
# analysis/boundary_core.py
# ==========================================================================
# Boundary Description (Metes and Bounds): the logic (pure Python, no arcpy).
#
# For every polygon the rings are normalised (start vertex, orientation) and
# described as a traverse of straight courses::
#
#     parcel = bdw_describe_polygon(oid, key, rings, options)
#
# ``rings`` come from ``bdw_parse_esri_polygon`` (Esri JSON, straight rings or
# curve rings). The result holds, per ring, the courses (exact and published
# bearing and distance), the vertex schedule and the closure of the *published*
# (rounded) courses. Narratives (English / Arabic), text and HTML reports and
# the table rows are built from it here, so they can be tested without arcpy.
#
# Conventions
# -----------
# * Bearings are GRID bearings: azimuth = atan2(dx, dy) in degrees clockwise from
#   grid north (the +Y axis of the projected system), 0 <= azimuth < 360.
#   Nothing is done about convergence, scale factor or ellipsoid: distances are
#   planar distances of the projected coordinates, converted to the output unit.
# * Rounding is round-half-up on the exact binary value of the number (``decimal``),
#   done on integers, so a carry (59.9999" -> next minute) cannot be missed.
# * The closure report recomputes the traverse from the ROUNDED bearings and
#   distances. A compass-rule (or any other) closure adjustment is out of scope.

BDW_START_RULES = ("NORTHWEST", "NORTHEAST", "SOUTHWEST", "SOUTHEAST", "FIRST_VERTEX")
BDW_ORIENTATIONS = ("OUTER_CW_HOLES_CCW", "ALL_CLOCKWISE", "ALL_COUNTERCLOCKWISE")
BDW_BEARING_FORMATS = ("QUADRANT_DMS", "AZIMUTH_DMS", "AZIMUTH_DECIMAL")
BDW_LANGUAGES = ("ENGLISH", "ARABIC", "BOTH")
BDW_DIGIT_STYLES = ("WESTERN", "ARABIC_INDIC")

# unit -> (metres per unit, short label, English word, Arabic label).
# International foot = 0.3048 m exactly; US survey foot = 1200/3937 m exactly
# (NIST, https://www.nist.gov/press-coverage/deprecation-us-survey-foot and NOAA,
# https://oceanservice.noaa.gov/geodesy/international-foot.html, opened 2026-10-29).
# The Arabic word is the unit after a number ("50.00 متراً"; accusative of the number-noun).
BDW_UNITS = {
    "METERS": (1.0, "m", "metres", "متراً", "المتر"),
    "FEET": (0.3048, "ft", "feet", "قدماً", "القدم"),
    "US_SURVEY_FEET": (1200.0 / 3937.0, "ft (US survey)", "US survey feet",
                       "قدماً من أقدام المسح الأمريكية", "القدم المساحية الأمريكية"),
}
# unit -> (English area words, Arabic area words after a number)
BDW_AREA_WORDS = {
    "METERS": ("square metres", "متراً مربعاً"),
    "FEET": ("square feet", "قدماً مربعاً"),
    "US_SURVEY_FEET": ("square US survey feet", "قدماً مربعاً من أقدام المسح الأمريكية"),
}
BDW_DROP_REL_AREA = 1e-9      # a ring whose true area is below this x (bbox diagonal)^2 has no area
BDW_MERGE_AREA_WARN = 0.01    # Merge Collinear changing a ring's area by more than 1 % is warned
BDW_BASIS_POSITIONS = ("CLOSING", "OPENING", "NONE")
BDW_MAX_BASIS_TEXT = 1500
BDW_CROSSING_CAP = 100          # self-intersection pairs counted per polygon, at most
BDW_FALLBACK_BUDGET = 2000000  # pair / vertex tests when a polygon that touches itself is re-tested
BDW_COUNT_BUDGET = 50000        # segment pairs examined when COUNTING the crossings of a polygon
                                # that is already known to cross itself (the count is then "at least")

BDW_DET_ERR = 1e-15         # relative rounding-error bound of a 2x2 determinant (Shewchuk: 3.3e-16)
BDW_TIE_TOL = 1e-6          # map units: coordinates closer than this are "equal" for the start rule
BDW_DUP_TOL = 1e-9          # map units: consecutive vertices closer than this are one vertex
BDW_EXACT_RATIO = 1.0e9     # misclosure below perimeter / 1e9 is numerical noise: "closed"
BDW_MAX_ANGLE_DECIMALS = 6
BDW_MAX_DIST_DECIMALS = 6

LRI = chr(0x2066)           # left-to-right isolate (numbers inside Arabic text)
PDI = chr(0x2069)           # pop directional isolate
BDW_DEGREE = chr(0xB0)

BDW_COURSE_COLUMNS = (
    ("SRC_OID", "LONG"), ("PARCEL_KEY", "TEXT"), ("PART_NO", "LONG"), ("RING_NO", "LONG"),
    ("RING_TYPE", "TEXT"), ("COURSE_NO", "LONG"), ("FROM_PT", "LONG"), ("TO_PT", "LONG"),
    ("AZIMUTH", "DOUBLE"), ("AZ_PUB", "DOUBLE"), ("BEARING", "TEXT"),
    ("DIST_EXACT", "DOUBLE"), ("DIST_PUB", "DOUBLE"), ("DIST_TXT", "TEXT"),
    ("FROM_X", "DOUBLE"), ("FROM_Y", "DOUBLE"), ("TO_X", "DOUBLE"), ("TO_Y", "DOUBLE"),
    ("LINE_TYPE", "TEXT"), ("ARC_APPROX", "LONG"), ("NOTE", "TEXT"))
BDW_VERTEX_COLUMNS = (
    ("SRC_OID", "LONG"), ("PARCEL_KEY", "TEXT"), ("PART_NO", "LONG"), ("RING_NO", "LONG"),
    ("SEQ_NO", "LONG"), ("POINT_NO", "LONG"), ("X", "DOUBLE"), ("Y", "DOUBLE"))
BDW_LATLON_COLUMNS = (("LON_DD", "DOUBLE"), ("LAT_DD", "DOUBLE"),
                      ("LON_DMS", "TEXT"), ("LAT_DMS", "TEXT"))
BDW_CLOSURE_COLUMNS = (
    ("SRC_OID", "LONG"), ("PARCEL_KEY", "TEXT"), ("PART_NO", "LONG"), ("RING_NO", "LONG"),
    ("RING_TYPE", "TEXT"), ("COURSES", "LONG"), ("PERIMETER", "DOUBLE"),
    ("PERIM_PUB", "DOUBLE"), ("RING_AREA", "DOUBLE"), ("MISCL_E", "DOUBLE"),
    ("MISCL_N", "DOUBLE"), ("MISCLOSE", "DOUBLE"), ("MISCL_AZ", "DOUBLE"),
    ("RATIO_N", "LONG"), ("RATIO_TXT", "TEXT"), ("ROUND_BND", "DOUBLE"), ("UNIT", "TEXT"),
    ("ARC_SEGS", "LONG"))
BDW_NARRATIVE_COLUMNS = (("SRC_OID", "LONG"), ("PARCEL_KEY", "TEXT"), ("LANG", "TEXT"),
                         ("NARRATIVE", "TEXT"))
BDW_LINE_COLUMNS = (
    ("SRC_OID", "LONG"), ("PARCEL_KEY", "TEXT"), ("RING_NO", "LONG"), ("COURSE_NO", "LONG"),
    ("BEARING", "TEXT"), ("DIST_TXT", "TEXT"), ("LABEL_TXT", "TEXT"), ("ARC_APPROX", "LONG"))


# --------------------------------------------------------------------------
# Options
# --------------------------------------------------------------------------

def bdw_map_unit_words(mpu):
    """``(English, Arabic)`` words for the unit of the map coordinates (``mpu`` metres per
    unit): a known unit by name, any other as a length in metres."""
    for _key, (metres, _short, english, arabic, definite) in BDW_UNITS.items():
        if abs(mpu - metres) <= 1e-9 * metres:
            return english, arabic, definite
    return ("map units of {0:.10g} m".format(mpu),
            "وحدات خريطة طول الوحدة منها {0} متراً".format("{0:.10g}".format(mpu)),
            "وحدة خريطة طولها {0} متراً".format("{0:.10g}".format(mpu)))


def bdw_options(meters_per_unit=1.0, start_rule="NORTHWEST", orientation="OUTER_CW_HOLES_CCW",
                bearing_format="QUADRANT_DMS", angle_decimals=None, unit="METERS",
                dist_decimals=2, merge_collinear=False, collinear_tolerance=0.001,
                digits="WESTERN", crs_name="", basis_position="CLOSING", basis_text="",
                check_crossings=True):
    """Validated option dict. ``meters_per_unit``: metres in one unit of the map
    coordinates. ``collinear_tolerance`` is in the OUTPUT distance unit.
    Raises ``ValueError`` with a readable text for a wrong value."""
    start_rule = str(start_rule or "NORTHWEST").upper()
    orientation = str(orientation or "OUTER_CW_HOLES_CCW").upper()
    bearing_format = str(bearing_format or "QUADRANT_DMS").upper()
    unit = str(unit or "METERS").upper()
    digits = str(digits or "WESTERN").upper()
    for value, allowed, label in ((start_rule, BDW_START_RULES, "start vertex"),
                                  (orientation, BDW_ORIENTATIONS, "orientation"),
                                  (bearing_format, BDW_BEARING_FORMATS, "bearing format"),
                                  (unit, tuple(BDW_UNITS), "distance unit"),
                                  (digits, BDW_DIGIT_STYLES, "digit style")):
        if value not in allowed:
            raise ValueError("Unknown {0} '{1}' (use one of {2})".format(label, value,
                                                                         ", ".join(allowed)))
    mpu = float(meters_per_unit)
    if not (mpu > 0 and math.isfinite(mpu)):
        raise ValueError("The map unit must be a positive length (metres per unit {0})".format(
            meters_per_unit))
    if angle_decimals is None or angle_decimals == "":
        angle_decimals = 4 if bearing_format == "AZIMUTH_DECIMAL" else 0
    angle_decimals = int(angle_decimals)
    dist_decimals = int(dist_decimals)
    if not 0 <= angle_decimals <= BDW_MAX_ANGLE_DECIMALS:
        raise ValueError("Angle decimals must be between 0 and {0}".format(BDW_MAX_ANGLE_DECIMALS))
    if not 0 <= dist_decimals <= BDW_MAX_DIST_DECIMALS:
        raise ValueError("Distance decimals must be between 0 and {0}".format(
            BDW_MAX_DIST_DECIMALS))
    tol = float(collinear_tolerance)
    if not (tol >= 0 and math.isfinite(tol)):
        raise ValueError("The collinear tolerance must be zero or more")
    factor = mpu / BDW_UNITS[unit][0]          # map units -> output units
    basis_position = str(basis_position or "CLOSING").upper()
    if basis_position not in BDW_BASIS_POSITIONS:
        raise ValueError("Unknown basis statement position '{0}' (use one of {1})".format(
            basis_position, ", ".join(BDW_BASIS_POSITIONS)))
    basis_text = " ".join(str(basis_text or "").split())
    if len(basis_text) > BDW_MAX_BASIS_TEXT:
        raise ValueError("The basis statement is longer than {0} characters".format(
            BDW_MAX_BASIS_TEXT))
    map_en, map_ar, map_ar_def = bdw_map_unit_words(mpu)
    return {"crs_name": " ".join(str(crs_name or "").split()), "basis_position": basis_position,
            "basis_text": basis_text, "map_unit_en": map_en, "map_unit_ar": map_ar, "map_unit_ar_def": map_ar_def,
            "meters_per_unit": mpu, "start_rule": start_rule, "orientation": orientation,
            "bearing_format": bearing_format, "angle_decimals": angle_decimals, "unit": unit,
            "dist_decimals": dist_decimals, "merge_collinear": bool(merge_collinear),
            "collinear_tol_map": (tol / factor) if tol > 0 else 0.0, "digits": digits,
            "factor": factor, "check_crossings": bool(check_crossings)}


# --------------------------------------------------------------------------
# Rounding, angle and distance text
# --------------------------------------------------------------------------

def bdw_round_int(value, scale):
    """``round_half_up(value * scale)`` as an int, on the exact binary value of ``value``."""
    with localcontext() as ctx:
        ctx.prec = 80
        return int((Decimal(value) * int(scale)).to_integral_value(rounding=ROUND_HALF_UP))


def bdw_azimuth(dx, dy):
    """Grid azimuth in degrees clockwise from +Y, in ``[0, 360)``."""
    az = math.degrees(math.atan2(dx, dy)) % 360.0
    if az >= 360.0:
        az -= 360.0
    return az + 0.0          # no negative zero


def _bdw_dms_text(t, decimals):
    """``D°MM'SS.ss"`` from an integer count of 10**-decimals seconds."""
    s = 10 ** decimals
    deg, rem = divmod(t, 3600 * s)
    minute, sec_units = divmod(rem, 60 * s)
    whole, frac = divmod(sec_units, s)
    sec = "{0:02d}".format(whole)
    if decimals:
        sec += ".{0:0{1}d}".format(frac, decimals)
    return "{0}{1}{2:02d}'{3}\"".format(deg, BDW_DEGREE, minute, sec)


def _bdw_decimal_text(t, decimals):
    s = 10 ** decimals
    if decimals:
        return "{0}.{1:0{2}d}{3}".format(t // s, t % s, decimals, BDW_DEGREE)
    return "{0}{1}".format(t, BDW_DEGREE)


_BDW_CARDINAL_WORDS = {"N": "North", "E": "East", "S": "South", "W": "West"}


def bdw_publish_angle(az, bearing_format, decimals):
    """Round an azimuth to the published precision and write it as text.

    Returns ``{"t", "per_deg", "az_pub", "kind", "ns", "ew", "cardinal", "angle", "text"}``.
    ``kind``: ``"cardinal"`` (published exactly due N/E/S/W in the quadrant format),
    ``"quadrant"`` or ``"azimuth"``. ``angle`` is the angle part as text (the
    quadrant angle for quadrant bearings), ``text`` the whole bearing. A carry
    (59.9999" -> next minute, 359.99999 -> 0) is handled on the integers."""
    dms = bearing_format != "AZIMUTH_DECIMAL"
    per_deg = (3600 if dms else 1) * 10 ** decimals
    full = 360 * per_deg
    t = bdw_round_int(az, per_deg) % full
    out = {"t": t, "per_deg": per_deg, "az_pub": t / float(per_deg), "ns": None, "ew": None,
           "cardinal": None}
    if bearing_format == "QUADRANT_DMS":
        q = 90 * per_deg
        if t % q == 0:
            card = "NESW"[t // q]
            out.update({"kind": "cardinal", "cardinal": card, "angle": "",
                        "text": _BDW_CARDINAL_WORDS[card]})
            return out
        if t < q:
            ns, ew, tq = "N", "E", t
        elif t < 2 * q:
            ns, ew, tq = "S", "E", 2 * q - t
        elif t < 3 * q:
            ns, ew, tq = "S", "W", t - 2 * q
        else:
            ns, ew, tq = "N", "W", 4 * q - t
        angle = _bdw_dms_text(tq, decimals)
        out.update({"kind": "quadrant", "ns": ns, "ew": ew, "angle": angle,
                    "text": "{0} {1} {2}".format(ns, angle, ew)})
        return out
    angle = _bdw_dms_text(t, decimals) if dms else _bdw_decimal_text(t, decimals)
    out.update({"kind": "azimuth", "angle": angle, "text": angle})
    return out


def bdw_publish_distance(dist, decimals):
    """``(published value, text)`` of a distance rounded half-up to ``decimals``."""
    s = 10 ** decimals
    q = bdw_round_int(dist, s)
    text = "{0}.{1:0{2}d}".format(q // s, q % s, decimals) if decimals else str(q)
    return q / float(s), text


def bdw_coord_text(value, decimals):
    """A coordinate as text with ``decimals`` decimals, rounded half up (away from zero on an
    exact tie) like the published bearings and distances."""
    s = 10 ** decimals
    q = bdw_round_int(abs(value), s)
    sign = "-" if value < 0 and q else ""
    return sign + ("{0}.{1:0{2}d}".format(q // s, q % s, decimals) if decimals else str(q))


def bdw_format_latlon(value, is_lat, decimals=5):
    """``(decimal degrees as given, "D°MM'SS.sssss\"H")`` for a latitude / longitude."""
    hemi = ("N" if value >= 0 else "S") if is_lat else ("E" if value >= 0 else "W")
    s = 10 ** decimals
    t = bdw_round_int(abs(value), 3600 * s)
    return value, "{0} {1}".format(_bdw_dms_text(t, decimals), hemi)


# --------------------------------------------------------------------------
# Reading polygons (Esri JSON, straight or curved)
# --------------------------------------------------------------------------

def _bdw_xy(coord):
    x, y = float(coord[0]), float(coord[1])
    if not (math.isfinite(x) and math.isfinite(y)):
        raise ValueError("a vertex has a coordinate that is not a finite number")
    return (x, y)


BDW_ARC_STEP = math.radians(1.0)    # largest angle step when a true curve is sampled
BDW_ARC_SAGITTA = 1e-3              # map units: largest gap between a sampled curve and its samples
BDW_ARC_MAX_POINTS = 2048           # sample points per curve segment, at most
BDW_BEZIER_POINTS = 64


def _bdw_arc_points(cx, cy, rx, ry, rot, t0, sweep):
    """Interior sample points of an elliptic arc (centre, semi-axes, rotation in radians,
    start parameter, signed sweep in radians). The step is at most ``BDW_ARC_STEP`` and
    keeps the sagitta below ``BDW_ARC_SAGITTA`` (up to ``BDW_ARC_MAX_POINTS`` points)."""
    r = max(rx, ry)
    step = BDW_ARC_STEP
    if r > BDW_ARC_SAGITTA:
        step = min(step, 2.0 * math.acos(1.0 - BDW_ARC_SAGITTA / r))
    n = min(BDW_ARC_MAX_POINTS, max(2, int(math.ceil(abs(sweep) / step))))
    cr, sr = math.cos(rot), math.sin(rot)
    out = []
    for k in range(1, n):
        t = t0 + sweep * k / n
        ex, ey = rx * math.cos(t), ry * math.sin(t)
        out.append((cx + ex * cr - ey * sr, cy + ex * sr + ey * cr))
    return out


def _bdw_segment_area(rx, ry, sweep):
    """Signed area between an elliptic arc (semi-axes ``rx``, ``ry``, signed sweep in radians,
    counter-clockwise positive) and its chord: ``rx ry / 2 (|sweep| - sin|sweep|)``."""
    t = abs(sweep)
    return math.copysign(0.5 * rx * ry * (t - math.sin(t)), sweep)


_BDW_GAUSS3 = ((0.5 - math.sqrt(15.0) / 10.0, 5.0 / 18.0), (0.5, 8.0 / 18.0),
               (0.5 + math.sqrt(15.0) / 10.0, 5.0 / 18.0))


def _bdw_bezier_area(start, c1, c2, end):
    """Signed area between a cubic Bezier and its chord (Green's theorem; the integrand is a
    polynomial of degree 5, so 3-point Gauss-Legendre is exact). Coordinates are taken
    relative to the start point."""
    sx, sy = start
    p = [(0.0, 0.0), (c1[0] - sx, c1[1] - sy), (c2[0] - sx, c2[1] - sy),
         (end[0] - sx, end[1] - sy)]
    total = 0.0
    for t, w in _BDW_GAUSS3:
        u = 1.0 - t
        b = (u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t)
        d = (-3 * u * u, 3 * u * u - 6 * u * t, 6 * u * t - 3 * t * t, 3 * t * t)
        x = sum(bi * q[0] for bi, q in zip(b, p))
        y = sum(bi * q[1] for bi, q in zip(b, p))
        dx = sum(di * q[0] for di, q in zip(d, p))
        dy = sum(di * q[1] for di, q in zip(d, p))
        total += w * (x * dy - y * dx)
    return 0.5 * total


def _bdw_curve_samples(start, key, element, area_out=None):
    """Points strictly inside one Esri JSON curve segment from ``start`` (the TRUE curve,
    used to decide which ring a hole belongs to and whether rings cross). ``"c"``: circular
    arc ``[end, interior]``; ``"a"``: elliptic arc ``[end, centre, minor, clockwise,
    rotation, axis, ratio]`` (or ``[end, centre, minor, clockwise]`` for a circular arc);
    ``"b"``: cubic Bezier ``[end, control 1, control 2]``. An element that cannot be read
    gives no sample (the chord). When ``area_out`` (a list) is given, the exact signed area
    between the curve and its chord is appended to it (nothing for an unreadable element)."""
    try:
        end = _bdw_xy(element[0])
        sx, sy = start
        if key == "c":
            ix, iy = _bdw_xy(element[1])
            ex, ey = end
            if (sx, sy) == (ex, ey):                 # full circle: interior = opposite point
                if (ix, iy) == (sx, sy):
                    return []
                cx, cy = (sx + ix) / 2.0, (sy + iy) / 2.0
                r = math.hypot(sx - cx, sy - cy)
                a0 = math.atan2(sy - cy, sx - cx)
                if area_out is not None:
                    area_out.append(_bdw_segment_area(r, r, 2.0 * math.pi))
                return _bdw_arc_points(cx, cy, r, r, 0.0, a0, 2.0 * math.pi)
            # circumcentre RELATIVE to the start point (full precision at UTM offsets)
            bx, by, qx, qy = ix - sx, iy - sy, ex - sx, ey - sy
            d = 2.0 * (bx * qy - by * qx)
            if d == 0.0:
                return []
            b2, q2 = bx * bx + by * by, qx * qx + qy * qy
            cx = sx + (qy * b2 - by * q2) / d
            cy = sy + (bx * q2 - qx * b2) / d
            r = math.hypot(sx - cx, sy - cy)
            two_pi = 2.0 * math.pi
            a0 = math.atan2(sy - cy, sx - cx)
            ai = (math.atan2(iy - cy, ix - cx) - a0) % two_pi
            ae = (math.atan2(ey - cy, ex - cx) - a0) % two_pi
            sweep = ae if ai < ae else ae - two_pi   # counter-clockwise when it passes interior
            if area_out is not None:
                area_out.append(_bdw_segment_area(r, r, sweep))
            return _bdw_arc_points(cx, cy, r, r, 0.0, a0, sweep)
        if key == "a":
            cx, cy = _bdw_xy(element[1])
            clockwise = bool(element[3])
            rot = float(element[4]) if len(element) > 4 else 0.0
            ratio = float(element[6]) if len(element) > 6 else 1.0
            cr, sr = math.cos(-rot), math.sin(-rot)

            def local(px, py):
                dx, dy = px - cx, py - cy
                return dx * cr - dy * sr, (dx * sr + dy * cr) / (ratio or 1.0)

            lsx, lsy = local(sx, sy)
            lex, ley = local(*end)
            rx = float(element[5]) if len(element) > 5 else math.hypot(lsx, lsy)
            if not (rx > 0 and math.isfinite(rx) and ratio > 0 and math.isfinite(rot)):
                return []
            t0 = math.atan2(lsy, lsx)
            sweep = (math.atan2(ley, lex) - t0) % (2.0 * math.pi)
            if sweep == 0.0:                         # start = end: a full ellipse / circle
                sweep = 2.0 * math.pi
            if clockwise:
                sweep = sweep - 2.0 * math.pi if sweep < 2.0 * math.pi else -sweep
            if area_out is not None:
                area_out.append(_bdw_segment_area(rx, rx * ratio, sweep))
            return _bdw_arc_points(cx, cy, rx, rx * ratio, rot, t0, sweep)
        if key == "b":
            c1, c2 = _bdw_xy(element[1]), _bdw_xy(element[2])
            if area_out is not None:
                area_out.append(_bdw_bezier_area((sx, sy), c1, c2, end))
            out = []
            for k in range(1, BDW_BEZIER_POINTS):
                t = k / float(BDW_BEZIER_POINTS)
                u = 1.0 - t
                w0, w1, w2, w3 = u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t
                out.append((w0 * sx + w1 * c1[0] + w2 * c2[0] + w3 * end[0],
                            w0 * sy + w1 * c1[1] + w2 * c2[1] + w3 * end[1]))
            return out
    except (ValueError, TypeError, IndexError, ZeroDivisionError, OverflowError):
        return []
    return []


def bdw_parse_esri_polygon(data):
    """Rings of an Esri JSON polygon: ``[{"pts": closed list, "arcs": [bool, ...]}, ...]``.

    ``arcs[i]`` says that the segment ``pts[i] -> pts[i+1]`` is a true curve (circular
    arc, Bezier or elliptic arc); only its end point is used for the courses, so it is
    described by its chord. In a ``curveRings`` ring a curve object is
    ``{"c"|"b"|"a": [[x, y], ...]}`` whose first element is the end point (Esri JSON
    geometry objects page). A ring with curves also gets ``"shape"``: the closed TRUE
    boundary, each curve sampled (``_bdw_curve_samples``); it decides which outer ring a
    hole belongs to and whether rings cross, so a hole in the bulge of an arc stays a hole
    of its parcel. Z and M are ignored. ``ValueError`` for a curve object of another kind or
    a non-finite coordinate. Returns ``(rings, arc_count)``."""
    if not isinstance(data, dict):
        raise ValueError("not an Esri JSON geometry")
    if "curveRings" in data:
        raw = data["curveRings"]
    elif "rings" in data:
        raw = data["rings"]
    else:
        raise ValueError("not a polygon geometry")
    rings, arc_total = [], 0
    for ring in raw or []:
        pts, arcs, shape, curve_areas = [], [], [], []
        for node in ring:
            if isinstance(node, dict):
                key = next((k for k in ("c", "b", "a") if k in node), None)
                if key is None or not pts:
                    raise ValueError("unsupported curve element {0}".format(sorted(node)))
                end = _bdw_xy(node[key][0])
                shape.extend(_bdw_curve_samples(pts[-1], key, node[key], curve_areas))
                pts.append(end)
                shape.append(end)
                arcs.append(True)
                arc_total += 1
            else:
                if pts:
                    arcs.append(False)
                pts.append(_bdw_xy(node))
                shape.append(pts[-1])
        if len(pts) < 2:
            continue
        if pts[0] != pts[-1]:                      # an open ring is closed by a straight segment
            pts.append(pts[0])
            shape.append(pts[0])
            arcs.append(False)
        entry = {"pts": pts, "arcs": arcs}
        if any(arcs):
            entry["shape"] = shape
            entry["curve_area"] = sum(curve_areas)
        rings.append(entry)
    return rings, arc_total


def _bdw_shape(ring):
    """The closed TRUE boundary of a parsed ring (its curves sampled), or its points."""
    return ring.get("shape") or ring["pts"]


def bdw_group_rings(rings):
    """``[(outer, [holes])]`` of ring dicts (``group_rings`` on the TRUE boundaries, the
    curves sampled, see ``_bdw_shape``; the arc flags travel with their ring). Clockwise
    rings are outers, counter-clockwise rings are holes of the smallest outer that contains
    them; an outer is numbered by the order of the outers in the geometry. A hole that no
    outer contains comes back as an outer of its own (``group_rings``); the caller can
    recognise it by its counter-clockwise true boundary."""
    keyed = {}
    for index, ring in enumerate(rings):
        keyed.setdefault(tuple(close_ring(_bdw_shape(ring))), []).append(index)
    out = []
    for outer, holes in group_rings([_bdw_shape(r) for r in rings]):
        o = rings[keyed[tuple(outer)].pop(0)]
        out.append((o, [rings[keyed[tuple(h)].pop(0)] for h in holes]))
    return out


# --------------------------------------------------------------------------
# Ring normalisation
# --------------------------------------------------------------------------

def _bdw_remove_duplicates(verts, arcs, ids):
    """Drop a vertex equal to the next one (cyclic); the zero-length segment goes with it."""
    n = len(verts)
    keep = [i for i in range(n)
            if not (abs(verts[i][0] - verts[(i + 1) % n][0]) <= BDW_DUP_TOL
                    and abs(verts[i][1] - verts[(i + 1) % n][1]) <= BDW_DUP_TOL)]
    return ([verts[i] for i in keep], [arcs[i] for i in keep], [ids[i] for i in keep],
            n - len(keep))


def _bdw_lex_anchor(verts, keep=None):
    """Index of the vertex with the largest Y, then the smallest X (exact), among the
    indices for which ``keep(i)`` is true (all vertices when ``keep`` is None or no vertex
    passes)."""
    pool = [i for i in range(len(verts)) if keep is None or keep(i)] or list(range(len(verts)))
    best = pool[0]
    for i in pool[1:]:
        x, y = verts[i]
        bx, by = verts[best]
        if y > by or (y == by and x < bx):
            best = i
    return best


def _bdw_is_collinear(verts, p, i, q, tol):
    """True when ``verts[i]`` lies within ``tol`` of the line ``verts[p]`` -> ``verts[q]`` and
    between them (a spike, i.e. a reversal, is not collinear)."""
    px, py = verts[p]
    qx, qy = verts[q]
    vx, vy = verts[i]
    ex, ey = qx - px, qy - py
    length = math.hypot(ex, ey)
    if length == 0.0:
        return False
    if (vx - px) * ex + (vy - py) * ey <= 0.0 or (vx - qx) * (-ex) + (vy - qy) * (-ey) <= 0.0:
        return False
    return abs((vx - px) * ey - (vy - py) * ex) / length <= tol


BDW_MERGE_HULL = 10000      # hull points kept for the vertices one merged course replaces, at most


def _bdw_hull(points):
    """Convex hull (Andrew's monotone chain) of a list of ``(x, y)``; collinear points on
    the hull edges are left out. The largest distance of a point set from a line, and its
    smallest and largest projection on the line, are reached at hull vertices, so the
    span test of the collinear merge only needs the hull of the vertices it replaces."""
    pts = sorted(set(points))
    if len(pts) <= 2:
        return pts

    def cross(o, a, b):
        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

    lower, upper = [], []
    for p in pts:
        while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:
            lower.pop()
        lower.append(p)
    for p in reversed(pts):
        while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0:
            upper.pop()
        upper.append(p)
    return lower[:-1] + upper[:-1]


def _bdw_points_fit(points, a, b, tol):
    """``(fits, largest offset)``: every point lies within ``tol`` of the chord ``a`` ->
    ``b`` and strictly between its ends (the ``_bdw_is_collinear`` test for all of them)."""
    px, py = a
    qx, qy = b
    ex, ey = qx - px, qy - py
    length = math.hypot(ex, ey)
    if length == 0.0:
        return False, 0.0
    worst, inside = 0.0, True
    for vx, vy in points:
        if (vx - px) * ex + (vy - py) * ey <= 0.0 or (vx - qx) * (-ex) + (vy - qy) * (-ey) <= 0.0:
            inside = False
        off = abs((vx - px) * ey - (vy - py) * ex) / length
        if off > worst:
            worst = off
    return inside and worst <= tol, worst


def _bdw_merge_collinear(verts, arcs, ids, tol, stats=None):
    """Remove vertices that lie within ``tol`` of the straight line between their
    surviving neighbours AND between them, when their segments are straight. Cyclic;
    a spike (reversal) is not collinear. The anchor is kept and at least three vertices
    remain: the anchor is the topmost (then westernmost) vertex among those that are NOT
    collinear with their own neighbours (a real corner), so a near-collinear vertex is
    merged wherever it lies, the topmost one included.

    The tolerance holds for EVERY dropped vertex against the course that finally replaces
    it, not only against the neighbours it had when it was dropped: before a vertex is
    removed, all stored vertices between its two surviving neighbours (those dropped before
    it included) are tested against the new, longer chord (as in Douglas-Peucker), so the
    error cannot build up along a densified gentle curve. The test uses the convex hull of
    those vertices, kept per gap between surviving vertices and merged when a gap closes
    (``_bdw_hull``): the largest offset and the extreme projections of a point set are at
    its hull vertices, so the result is that of testing every vertex, and a straight run of
    many thousand vertices costs about linear time instead of quadratic. A gap whose hull
    would exceed ``BDW_MERGE_HULL`` points is not merged further (counted in
    ``stats["capped"]``; it does not happen for straight or gently curved runs). ``stats``
    (a dict), when given, receives ``"offset"``: the largest distance of a dropped vertex
    from its course (map units, computed from every dropped vertex), and ``"capped"``.
    Returns ``(verts, arcs, ids, removed)``."""
    n = len(verts)
    if stats is not None:
        stats["offset"] = 0.0
        stats["capped"] = 0
    if n <= 3:
        return verts, arcs, ids, 0

    def corner(i):
        p, q = (i - 1) % n, (i + 1) % n
        return arcs[p] or arcs[i] or not _bdw_is_collinear(verts, p, i, q, tol)

    anchor = _bdw_lex_anchor(verts, corner)
    prev = [(i - 1) % n for i in range(n)]
    nxt = [(i + 1) % n for i in range(n)]
    alive = [True] * n
    gap = {}                     # surviving vertex p -> hull of the dropped vertices after p
    capped = set()
    count = n
    stack = list(range(n - 1, -1, -1))
    while stack and count > 3:
        i = stack.pop()
        if not alive[i] or i == anchor:
            continue
        p, q = prev[i], nxt[i]
        if arcs[p] or arcs[i]:
            continue
        if not _bdw_is_collinear(verts, p, i, q, tol):
            continue
        hull = _bdw_hull(gap.get(p, []) + gap.get(i, []) + [tuple(verts[i])])
        if len(hull) > BDW_MERGE_HULL:
            capped.add(i)
            continue
        if not _bdw_points_fit(hull, verts[p], verts[q], tol)[0]:
            continue
        alive[i] = False
        gap[p] = hull
        gap.pop(i, None)
        nxt[p], prev[q] = q, p
        count -= 1
        stack.append(p)
        stack.append(q)
    keep = [i for i in range(n) if alive[i]]
    if stats is not None:
        stats["capped"] = sum(1 for i in capped if alive[i])
    if stats is not None and len(keep) < n:
        worst = 0.0
        for k, p in enumerate(keep):          # every dropped vertex once: linear in n
            q = keep[(k + 1) % len(keep)]
            span = range(p + 1, q) if q > p else list(range(p + 1, n)) + list(range(0, q))
            if span:
                worst = max(worst, _bdw_points_fit([verts[j] for j in span],
                                                   verts[p], verts[q], tol)[1])
        stats["offset"] = worst
    return ([verts[i] for i in keep], [arcs[i] for i in keep], [ids[i] for i in keep],
            n - len(keep))


def _bdw_start_position(verts, ids, rule):
    """Position of the start vertex: northernmost then westernmost (NORTHWEST) etc. The
    first such vertex wins when several are equal within ``BDW_TIE_TOL``."""
    if rule == "FIRST_VERTEX":
        return min(range(len(verts)), key=lambda i: ids[i])
    ys = [v[1] for v in verts]
    north = rule in ("NORTHWEST", "NORTHEAST")
    west = rule in ("NORTHWEST", "SOUTHWEST")
    best_y = max(ys) if north else min(ys)
    candidates = [i for i in range(len(verts)) if abs(ys[i] - best_y) <= BDW_TIE_TOL]
    pick = candidates[0]
    for i in candidates[1:]:
        if (verts[i][0] < verts[pick][0] - BDW_TIE_TOL) if west \
                else (verts[i][0] > verts[pick][0] + BDW_TIE_TOL):
            pick = i
    return pick


def bdw_normalise_ring(ring, clockwise, options):
    """Open, de-duplicated vertex list of a ring in the wanted orientation, starting at
    the start vertex. Returns ``{"verts", "arcs", "duplicates", "merged"}`` where
    ``arcs[i]`` flags the segment ``verts[i] -> verts[(i+1) % n]``, or ``None`` when the
    ring is degenerate (fewer than 3 distinct vertices or zero area). ``merge_area_change``:
    relative change of the ring's area caused by Merge Collinear (0 when nothing merged)."""
    pts = [tuple(p) for p in ring["pts"]]
    arcs = list(ring["arcs"])[:max(len(pts) - 1, 0)]
    arcs += [False] * (max(len(pts) - 1, 0) - len(arcs))
    if len(pts) >= 2 and pts[0] == pts[-1]:
        pts, arcs = pts[:-1], arcs[:len(pts) - 1]
    ids = list(range(len(pts)))
    verts, arcs, ids, dup = _bdw_remove_duplicates(pts, arcs, ids)
    if len(verts) < 3:
        return None
    merged = 0
    stats = {"offset": 0.0, "capped": 0}
    area_before = ring_signed_area(close_ring(verts))
    if options["merge_collinear"]:          # tolerance 0 = exactly collinear vertices only
        verts, arcs, ids, merged = _bdw_merge_collinear(verts, arcs, ids,
                                                        options["collinear_tol_map"], stats)
    area = ring_signed_area(close_ring(verts))
    if area == 0.0 or len(verts) < 3:
        return None
    n = len(verts)
    if (area < 0) != bool(clockwise):                # reverse the ring
        verts = verts[::-1]
        ids = ids[::-1]
        arcs = [arcs[(n - 2 - k) % n] for k in range(n)]
    s = _bdw_start_position(verts, ids, options["start_rule"])
    return {"verts": verts[s:] + verts[:s], "arcs": arcs[s:] + arcs[:s],
            "duplicates": dup, "merged": merged, "merge_offset": stats["offset"],
            "merge_capped": stats["capped"],
            "merge_area_change": (abs(abs(area) - abs(area_before)) / abs(area_before)
                                  if merged and area_before else 0.0)}


# --------------------------------------------------------------------------
# Courses and closure
# --------------------------------------------------------------------------

def bdw_course(a, b, options):
    """Exact and published course from point ``a`` to point ``b`` (map coordinates)."""
    dx, dy = b[0] - a[0], b[1] - a[1]
    dist = math.hypot(dx, dy) * options["factor"]
    az = bdw_azimuth(dx, dy)
    ang = bdw_publish_angle(az, options["bearing_format"], options["angle_decimals"])
    d_pub, d_txt = bdw_publish_distance(dist, options["dist_decimals"])
    return {"az": az, "dist": dist, "angle": ang, "az_pub": ang["az_pub"],
            "bearing": ang["text"], "dist_pub": d_pub, "dist_txt": d_txt}


def bdw_closure(courses, options):
    """Traverse of the PUBLISHED courses: misclosure, ratio and the rounding bound.

    The start is (0, 0) in the output unit; each course adds
    ``dist_pub * (sin az_pub, cos az_pub)``. ``misclosure`` is the vector from the start
    to the computed end (end - start; east, north). ``ratio`` is
    ``floor(perimeter_published / misclosure)`` ("1:N"), ``None`` when the misclosure is
    below perimeter / 1e9 (numerical noise). ``bound`` is a guaranteed upper bound of the
    misclosure caused by rounding alone: sum of ``0.5 unit + dist * half angle unit``."""
    es, ns = [], []
    perim_pub = math.fsum(c["dist_pub"] for c in courses)
    perim = math.fsum(c["dist"] for c in courses)
    half_angle_rad = math.radians(0.5 / courses[0]["angle"]["per_deg"]) if courses else 0.0
    half_dist = 0.5 * 10.0 ** (-options["dist_decimals"])
    bound = 0.0
    for c in courses:
        rad = math.radians(c["az_pub"])
        es.append(c["dist_pub"] * math.sin(rad))
        ns.append(c["dist_pub"] * math.cos(rad))
        bound += half_dist + c["dist"] * half_angle_rad
    east, north = math.fsum(es), math.fsum(ns)
    mis = math.hypot(east, north)
    ratio = None
    if mis > 0 and perim_pub / mis < BDW_EXACT_RATIO:
        ratio = int(math.floor(perim_pub / mis))
    az = bdw_azimuth(east, north) if mis > perim_pub / BDW_EXACT_RATIO else None
    bound = bound * (1.0 + 1e-9) + 1e-9 * perim
    return {"misclosure": mis, "east": east, "north": north, "azimuth": az, "ratio": ratio,
            "ratio_txt": "1:{0}".format(ratio) if ratio is not None else "closed",
            "perimeter": perim, "perimeter_pub": perim_pub, "bound": bound}


def _bdw_cross(ax, ay, bx, by, cx, cy):
    return (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)


def _bdw_proper_crossing(p1, p2, p3, p4):
    """True when the open segments p1p2 and p3p4 cross each other at one interior point.
    A vertex lying within BDW_TIE_TOL of the other line does not count (touching and
    overlapping are not reported)."""
    l12 = math.hypot(p2[0] - p1[0], p2[1] - p1[1])
    l34 = math.hypot(p4[0] - p3[0], p4[1] - p3[1])
    if l12 == 0 or l34 == 0:
        return False
    d1 = _bdw_cross(p3[0], p3[1], p4[0], p4[1], p1[0], p1[1]) / l34
    d2 = _bdw_cross(p3[0], p3[1], p4[0], p4[1], p2[0], p2[1]) / l34
    d3 = _bdw_cross(p1[0], p1[1], p2[0], p2[1], p3[0], p3[1]) / l12
    d4 = _bdw_cross(p1[0], p1[1], p2[0], p2[1], p4[0], p4[1]) / l12
    tol = BDW_TIE_TOL
    return ((d1 > tol and d2 < -tol) or (d1 < -tol and d2 > tol)) and \
        ((d3 > tol and d4 < -tol) or (d3 < -tol and d4 > tol))


def _bdw_det(ax, ay, bx, by, cx, cy, dx, dy):
    """``(b - a) x (d - c)`` with an exact sign: the float value is used when it is larger
    than its rounding-error bound (Shewchuk's orient2d filter, with margin), otherwise the
    value is recomputed exactly with ``Fraction`` (the floats are converted exactly)."""
    t1 = (bx - ax) * (dy - cy)
    t2 = (by - ay) * (dx - cx)
    det = t1 - t2
    bound = BDW_DET_ERR * (abs(t1) + abs(t2))
    if bound == 0.0 or abs(det) > bound:
        return det
    if (cx == ax and cy == ay and ((dx == bx and dy == by) or (dx == ax and dy == ay))) \
            or (cx == dx and cy == dy):
        return 0.0                                 # a point on its own segment's end
    F = Fraction
    exact = (F(bx) - F(ax)) * (F(dy) - F(cy)) - (F(by) - F(ay)) * (F(dx) - F(cx))
    if not exact:
        return 0.0
    value = float(exact)
    return value if value else math.copysign(5e-324, exact)


def _bdw_side(seg, px, py):
    """Sign-carrying cross product of the point against the segment (>0: the point is above
    a segment that runs left to right), with an exact sign (``_bdw_det``). 0 for a vertical
    segment (a tie, resolved by slope)."""
    (ax, ay), (bx, by) = seg
    if bx == ax:
        return 0.0
    return _bdw_det(ax, ay, bx, by, ax, ay, px, py)


def _bdw_clean_rings(rings):
    """Rings as vertex lists without consecutive (cyclic) duplicates; rings with fewer
    than 2 distinct vertices are dropped."""
    out = []
    for verts in rings:
        pts = [(v[0], v[1]) for v in verts]
        clean = [p for i, p in enumerate(pts) if p != pts[i - 1]] if len(pts) > 1 else pts
        if len(clean) >= 2:
            out.append(clean)
    return out


def _bdw_angle_between(a1, a2, b):
    """True when direction angle ``b`` lies strictly inside the counter-clockwise arc a1 -> a2."""
    two_pi = 2.0 * math.pi
    return 0.0 < (b - a1) % two_pi < (a2 - a1) % two_pi


def _bdw_shared_vertex_crossing(rings):
    """True when two non-adjacent vertices of the polygon have exactly the same coordinates
    and the boundary passes THROUGH that point (the two pairs of incident edges interleave
    around it, as in a figure-8 whose loops run in opposite directions). Two loops that only
    touch there (a hole touching its outer ring, a pinched ring) are not crossings; a
    point where incident edges overlap (same direction) is not decided and not reported."""
    seen = {}
    for ri, verts in enumerate(rings):
        n = len(verts)
        if n < 3:
            continue
        for i, p in enumerate(verts):
            seen.setdefault(p, []).append((ri, i))
    eps = 1e-12
    for p, occs in seen.items():
        if len(occs) < 2:
            continue
        dirs = []
        for ri, i in occs:
            verts = rings[ri]
            u, w = verts[i - 1], verts[(i + 1) % len(verts)]
            dirs.append((math.atan2(u[1] - p[1], u[0] - p[0]),
                         math.atan2(w[1] - p[1], w[0] - p[0])))
        for x in range(len(dirs)):
            for y in range(x + 1, len(dirs)):
                a1, a2 = dirs[x]
                b1, b2 = dirs[y]
                if min(abs(math.remainder(s - t, 2.0 * math.pi))
                       for s in (a1, a2) for t in (b1, b2)) <= eps:
                    continue                       # overlapping edges: not decided
                if _bdw_angle_between(a1, a2, b1) != _bdw_angle_between(a1, a2, b2):
                    return True
    return False


def bdw_has_crossing(rings, budget=None):
    """True when the boundary of one polygon crosses itself (rings is a list of vertex
    lists; each ring is closed implicitly).

    Three kinds of crossing are found: two segments that cross at one interior point
    (``_bdw_proper_crossing``); a vertex that lies on the inside of another segment (within
    ``BDW_TIE_TOL``) with its two neighbours on opposite sides of that segment (the boundary
    passes through the other edge AT a vertex, as snapping produces, ``_bdw_through``); and
    a point shared by two non-adjacent vertices through which the boundary passes
    (``_bdw_shared_vertex_crossing``). Touching without passing through, shared end points
    and overlaps are not crossings. Not decided (not reported): a crossing where the
    boundary first runs ALONG the other edge (collinear overlap) and then leaves on the
    other side, and two vertices closer than ``BDW_TIE_TOL`` that are not exactly equal.

    Shamos-Hoey plane sweep: segments are put in a status list ordered along the sweep line,
    and only segments that become neighbours are compared, so the cost is O(n log n)
    comparisons for n segments whatever the shape (a comb of long teeth is as cheap as a
    circle). The side and slope tests have an exact sign (``_bdw_det``). The sweep is exact
    for rings in general position. When two neighbours touch or nearly touch (a vertex on
    or within ``BDW_TIE_TOL`` of another segment, collinear overlap), the sweep order can no
    longer be trusted, so the polygon is re-tested pair by pair with a grid index
    (``_bdw_grid_crossing``), for at most ``budget`` tests (``BDW_FALLBACK_BUDGET``). Only a
    polygon that touches itself AND needs more tests than that can have a crossing missed.
    The first crossing found ends the search."""
    if budget is None:
        budget = BDW_FALLBACK_BUDGET
    rings = _bdw_clean_rings(rings)
    segs = []
    for verts in rings:
        n = len(verts)
        for i in range(n):
            a, b = verts[i], verts[(i + 1) % n]
            segs.append((a, b) if a <= b else (b, a))
    if len(segs) < 4:
        return False
    if _bdw_shared_vertex_crossing(rings):
        return True
    events = []
    for k, (p, q) in enumerate(segs):
        events.append((p[0], p[1], 1, k))        # 1 = insert
        events.append((q[0], q[1], 0, k))        # 0 = remove (before inserts at the same point)
    events.sort()
    status = []
    det = _bdw_det
    tol = BDW_TIE_TOL

    def meet(i, j):
        """2: proper crossing; 1: the two segments touch or nearly touch in a way that can
        disturb the sweep order; 0: no contact (or a clean shared end point)."""
        (ax, ay), (bx, by) = segs[i]
        (cx, cy), (dx, dy) = segs[j]
        if max(ay, by) < min(cy, dy) or max(cy, dy) < min(ay, by) \
                or bx < cx or dx < ax:
            return 0
        d1 = det(cx, cy, dx, dy, cx, cy, ax, ay)
        d2 = det(cx, cy, dx, dy, cx, cy, bx, by)
        if (d1 > 0 and d2 > 0) or (d1 < 0 and d2 < 0):
            return 0
        d3 = det(ax, ay, bx, by, ax, ay, cx, cy)
        d4 = det(ax, ay, bx, by, ax, ay, dx, dy)
        if (d3 > 0 and d4 > 0) or (d3 < 0 and d4 < 0):
            return 0
        if d1 == 0 and d2 == 0:                    # collinear: overlap or end-to-end
            if max(ax, bx) < min(cx, dx) or max(cx, dx) < min(ax, bx):
                return 0
            if (ax, ay) in ((cx, cy), (dx, dy)) or (bx, by) in ((cx, cy), (dx, dy)):
                if (bx, by) == (cx, cy) or (dx, dy) == (ax, ay):
                    return 0                      # end to end, no overlap
            return 1
        if (ax, ay) in ((cx, cy), (dx, dy)) or (bx, by) in ((cx, cy), (dx, dy)):
            return 0                              # clean shared end point
        l12 = math.hypot(bx - ax, by - ay)
        l34 = math.hypot(dx - cx, dy - cy)
        if ((d1 / l34 > tol and d2 / l34 < -tol) or (d1 / l34 < -tol and d2 / l34 > tol)) and \
                ((d3 / l12 > tol and d4 / l12 < -tol) or (d3 / l12 < -tol and d4 / l12 > tol)):
            return 2
        return 1

    touched = False
    for x, y, kind, k in events:
        if kind == 1:
            lo, hi = 0, len(status)
            (pkx, pky), (qkx, qky) = segs[k]
            while lo < hi:
                mid = (lo + hi) // 2
                (ax, ay), (bx, by) = segs[status[mid]]
                c = 0.0 if bx == ax else det(ax, ay, bx, by, ax, ay, x, y)
                if c > 0 or (c == 0 and det(ax, ay, bx, by, pkx, pky, qkx, qky) >= 0):
                    lo = mid + 1
                else:
                    hi = mid
            status.insert(lo, k)
            pairs = []
            if lo > 0:
                pairs.append((status[lo - 1], k))
            if lo + 1 < len(status):
                pairs.append((k, status[lo + 1]))
        else:
            lo, hi = 0, len(status)
            while lo < hi:                         # first entry that is not strictly below
                mid = (lo + hi) // 2
                (ax, ay), (bx, by) = segs[status[mid]]
                if bx != ax and det(ax, ay, bx, by, ax, ay, x, y) > 0:
                    lo = mid + 1
                else:
                    hi = mid
            pos = -1
            for cand in range(max(0, lo - 8), min(len(status), lo + 8)):
                if status[cand] == k:
                    pos = cand
                    break
            if pos < 0:
                pos = status.index(k)              # order disturbed: safe fallback
            status.pop(pos)
            pairs = [(status[pos - 1], status[pos])] if 0 < pos < len(status) else []
        for i, j in pairs:
            m = meet(i, j)
            if m == 2:
                return True
            if m == 1:
                touched = True
    if touched:
        return bool(_bdw_grid_crossing(rings, budget))
    return False


def _bdw_through(seg, verts, i, tol=BDW_TIE_TOL):
    """True when vertex ``verts[i]`` lies inside segment ``seg`` (within ``tol`` of it and more
    than ``tol`` from its end points) and its two ring neighbours lie on opposite sides of
    the segment's line, each more than ``tol`` from it: the boundary passes through ``seg``
    at that vertex."""
    (ax, ay), (bx, by) = seg
    length = math.hypot(bx - ax, by - ay)
    if length == 0.0:
        return False
    vx, vy = verts[i]
    along = ((vx - ax) * (bx - ax) + (vy - ay) * (by - ay)) / length
    if not tol < along < length - tol:
        return False
    if abs(_bdw_cross(ax, ay, bx, by, vx, vy)) / length > tol:
        return False
    u, w = verts[i - 1], verts[(i + 1) % len(verts)]
    su = _bdw_cross(ax, ay, bx, by, u[0], u[1]) / length
    sw = _bdw_cross(ax, ay, bx, by, w[0], w[1]) / length
    return (su > tol and sw < -tol) or (su < -tol and sw > tol)


def _bdw_grid_crossing(rings, budget):
    """Pair-by-pair test with a grid index (used when the sweep meets touching segments):
    True on the first proper crossing (``_bdw_proper_crossing``) or vertex passing through
    another segment (``_bdw_through``), False when there is none, ``None`` when ``budget``
    tests were not enough to decide. ``rings`` are clean vertex lists."""
    tol = BDW_TIE_TOL
    segs = []
    for ri, verts in enumerate(rings):
        n = len(verts)
        for i in range(n):
            segs.append((ri, i, n, verts[i], verts[(i + 1) % n]))
    xs = [v[0] for verts in rings for v in verts]
    ys = [v[1] for verts in rings for v in verts]
    x_min, y_min = min(xs) - 2 * tol, min(ys) - 2 * tol
    width, height = max(xs) - x_min + 2 * tol, max(ys) - y_min + 2 * tol
    cell = max(width, height) / max(1.0, math.sqrt(len(segs))) or 1.0
    grid, big = {}, []
    for k, (_r, _i, _n, a, b) in enumerate(segs):
        c0, c1 = int((min(a[0], b[0]) - tol - x_min) // cell), int((max(a[0], b[0]) + tol - x_min) // cell)
        r0, r1 = int((min(a[1], b[1]) - tol - y_min) // cell), int((max(a[1], b[1]) + tol - y_min) // cell)
        if (c1 - c0 + 1) * (r1 - r0 + 1) > 400:
            big.append(k)
            continue
        for cx in range(c0, c1 + 1):
            for cy in range(r0, r1 + 1):
                grid.setdefault((cx, cy), []).append(k)
    work = [0]

    def spend():
        work[0] += 1
        return work[0] > budget

    seen = set()

    def pair(k, m):
        a, b = (k, m) if k < m else (m, k)
        if a == b or (a, b) in seen:
            return False
        seen.add((a, b))
        ra, ia, na, p1, p2 = segs[a]
        rb, ib, nb, p3, p4 = segs[b]
        if ra == rb and (abs(ia - ib) == 1 or abs(ia - ib) == na - 1):
            return False
        return _bdw_proper_crossing(p1, p2, p3, p4)

    def vertex(k, ri, i):
        rk, ik, nk, p, q = segs[k]
        if rk == ri and (ik == i or ik == (i - 1) % nk):
            return False
        return _bdw_through((p, q), rings[ri], i)

    for members in grid.values():
        for x in range(len(members)):
            for y in range(x + 1, len(members)):
                if pair(members[x], members[y]):
                    return True
                if spend():
                    return None
    for k in big:
        for m in range(len(segs)):
            if pair(k, m):
                return True
            if spend():
                return None
    for ri, verts in enumerate(rings):
        for i, (vx, vy) in enumerate(verts):
            key = (int((vx - x_min) // cell), int((vy - y_min) // cell))
            for k in grid.get(key, []) + big:
                if vertex(k, ri, i):
                    return True
                if spend():
                    return None
    return False


def bdw_count_crossings(rings, cap=BDW_CROSSING_CAP, budget=BDW_COUNT_BUDGET):
    """Number of pairs of boundary segments of one polygon that cross each other (rings is
    a list of vertex lists; each ring is closed implicitly). Neighbouring segments of a
    ring are not compared.

    A polygon that does not cross itself is recognised by the exact sweep
    ``bdw_has_crossing`` (O(n log n)) and gives 0 at once. Only a polygon that does cross
    itself is then counted, with a grid index, for at most ``cap`` pairs and at most
    ``budget`` segment pairs examined: the result is "at least this many" (and never less
    than 1 for such a polygon), so an invalid giant polygon cannot stall the run."""
    if not bdw_has_crossing(rings):
        return 0
    segs = []
    for ri, verts in enumerate(rings):
        n = len(verts)
        for i in range(n):
            segs.append((ri, i, n, verts[i], verts[(i + 1) % n]))
    xs = [v[0] for _r, _i, _n, a, b in segs for v in (a, b)]
    ys = [v[1] for _r, _i, _n, a, b in segs for v in (a, b)]
    x_min, y_min = min(xs), min(ys)
    width, height = max(xs) - x_min, max(ys) - y_min
    cell = max(width, height) / max(1.0, math.sqrt(len(segs))) or 1.0
    grid, big = {}, []
    for k, (_r, _i, _n, a, b) in enumerate(segs):
        x0, x1 = sorted((a[0], b[0]))
        y0, y1 = sorted((a[1], b[1]))
        c0, c1 = int((x0 - x_min) // cell), int((x1 - x_min) // cell)
        r0, r1 = int((y0 - y_min) // cell), int((y1 - y_min) // cell)
        if (c1 - c0 + 1) * (r1 - r0 + 1) > 400:
            big.append(k)
            continue
        for cx in range(c0, c1 + 1):
            for cy in range(r0, r1 + 1):
                grid.setdefault((cx, cy), []).append(k)
    seen, found, work = set(), 0, 0

    def test(k, m):
        a, b = (k, m) if k < m else (m, k)
        if a == b or (a, b) in seen:
            return 0
        seen.add((a, b))
        ra, ia, na, p1, p2 = segs[a]
        rb, ib, nb, p3, p4 = segs[b]
        if ra == rb and (abs(ia - ib) == 1 or abs(ia - ib) == na - 1):
            return 0
        return 1 if _bdw_proper_crossing(p1, p2, p3, p4) else 0

    for members in grid.values():
        for x in range(len(members)):
            for y in range(x + 1, len(members)):
                found += test(members[x], members[y])
                work += 1
                if found >= cap or work >= budget:
                    return max(found, 1)
    for k in big:
        for m in range(len(segs)):
            found += test(k, m)
            work += 1
            if found >= cap or work >= budget:
                return max(found, 1)
    return max(found, 1)


def _bdw_count_skipped_curve(parcel, ring):
    """A skipped ring made ONLY of curve segments (a circle) counts as ``skipped_curved``; one
    that mixes curves and straight segments (a semicircle: one arc and its chord) counts as
    ``skipped_arc_flat``: it has no area once its curves are replaced by chords."""
    arcs = ring["arcs"]
    if arcs and all(arcs):
        parcel["skipped_curved"] += 1
    elif any(arcs):
        parcel["skipped_arc_flat"] += 1


def _bdw_true_area(ring):
    """Area of the TRUE boundary of a parsed ring, map units squared: the chord polygon plus
    the exact area between each curve and its chord (``curve_area``). 0 when it is below
    ``BDW_DROP_REL_AREA`` of the bounding-box diagonal (of the sampled curves) squared."""
    shape = close_ring(_bdw_shape(ring))
    if len(shape) < 2:
        return 0.0
    xs = [p[0] for p in shape]
    ys = [p[1] for p in shape]
    diag2 = (max(xs) - min(xs)) ** 2 + (max(ys) - min(ys)) ** 2
    area = abs(ring_signed_area(close_ring(ring["pts"])) + ring.get("curve_area", 0.0))
    return area if diag2 > 0 and area > BDW_DROP_REL_AREA * diag2 else 0.0


def bdw_key_text(raw):
    """Parcel key text of a field value: ``""`` for None; a whole-number float (a DOUBLE key
    such as 12.0) is written without ``.0``; anything else by ``str``, stripped."""
    if raw is None:
        return ""
    if isinstance(raw, float) and math.isfinite(raw) and raw == int(raw):
        return str(int(raw))
    return str(raw).strip()


BDW_BIDI_CONTROLS = frozenset(list(range(0x202A, 0x202F)) + list(range(0x2066, 0x206A)))
# LRE, RLE, PDF, LRO, RLO and LRI, RLI, FSI, PDI: they change the display order of the text that
# FOLLOWS them (an RLO shows a heading reversed), so a key never carries them into a heading or
# a message. The marks LRM, RLM and ALM change no order beyond themselves and are kept.


def bdw_key_has_bidi_controls(key):
    """True when the key text holds a character of ``BDW_BIDI_CONTROLS``."""
    return any(ord(ch) in BDW_BIDI_CONTROLS for ch in str(key))


def bdw_display_key(key):
    """The key as shown in report headings and messages: each embedding, override or isolate
    control (``BDW_BIDI_CONTROLS``) is written as the visible text ``<U+202E>``, so it cannot
    reverse or reorder the heading. The output tables keep the key exactly as read."""
    return "".join("<U+{0:04X}>".format(ord(ch)) if ord(ch) in BDW_BIDI_CONTROLS else ch
                   for ch in str(key))


def bdw_duplicate_keys(pairs):
    """``[(key, [oid, ...]), ...]`` for every parcel key that more than one ``(oid, key)`` pair
    uses (exact text after ``bdw_key_text``), each with its ObjectIDs in ascending order, the
    keys ordered by their smallest ObjectID. Rows of such parcels are told apart only by
    SRC_OID."""
    by_key = {}
    for oid, key in pairs:
        by_key.setdefault(key, []).append(oid)
    found = [(key, sorted(oids)) for key, oids in by_key.items() if len(oids) > 1]
    found.sort(key=lambda item: item[1][0])
    return found


BDW_NORTH_WARN = 45.0       # degrees between grid north (+Y) and true north that are warned
BDW_NORTH_STEP = 1e-4       # degrees of latitude of the northward probe point


def bdw_true_north_offset(centre, probe, northward=True):
    """Grid azimuth of TRUE north at ``centre`` (degrees clockwise from the +Y axis, in the range
    -180 < a <= 180), from ``probe``: the projected position of a point ``BDW_NORTH_STEP`` degrees
    of latitude north of ``centre`` (``northward``) or south of it (near the North Pole). Both are
    (x, y) in the map units of the projected system. ``None`` when the points coincide or a value
    is not finite. A south-orientated system (+Y towards south) gives about 180; ordinary
    systems give the convergence angle (a few degrees)."""
    try:
        dx = float(probe[0]) - float(centre[0])
        dy = float(probe[1]) - float(centre[1])
    except (TypeError, ValueError, IndexError):
        return None
    if not (math.isfinite(dx) and math.isfinite(dy)) or (dx == 0.0 and dy == 0.0):
        return None
    if not northward:
        dx, dy = -dx, -dy
    angle = math.degrees(math.atan2(dx, dy))
    if angle <= -180.0:
        angle += 360.0
    return angle


BDW_NORTH_ZERO = 0.005      # degrees: an angle that prints as 0.00 is given no side


def bdw_true_north_line(angle):
    """The information line about the grid-north angle (``bdw_true_north_offset``). An angle
    that rounds to 0.00 degrees is given no side (east / west), so a run at the central
    meridian does not read "0.00 degrees west"."""
    if abs(angle) < BDW_NORTH_ZERO:
        where = "0.00 degrees from grid north"
    else:
        where = "{0:.2f} degrees {1} of grid north".format(
            abs(angle), "east" if angle >= 0 else "west")
    return ("At the centre of the data, true north is {0} (the +Y axis); the bearings are "
            "measured from grid north and this angle is not applied.".format(where))


def bdw_count_spikes(verts):
    """Number of vertices of an open ring at which the boundary turns straight back on
    itself (a spike, out and back: the next course is the exact reverse direction of the
    previous one, parallel to within 1e-12 relative)."""
    n = len(verts)
    found = 0
    for i in range(n):
        ax, ay = verts[i - 1]
        bx, by = verts[i]
        cx, cy = verts[(i + 1) % n]
        ux, uy, vx, vy = bx - ax, by - ay, cx - bx, cy - by
        dot = ux * vx + uy * vy
        if dot >= 0.0:
            continue
        cross = ux * vy - uy * vx
        if abs(cross) <= 1e3 * BDW_DET_ERR * math.hypot(ux, uy) * math.hypot(vx, vy):
            found += 1
    return found


def bdw_describe_polygon(oid, key, rings, options):
    """Describe one polygon as normalised rings with courses, vertices and closure.

    ``rings``: ``bdw_parse_esri_polygon`` result. Returns ``{"oid", "key", "rings",
    "skipped_rings", "skipped_curved", "crossings", "arc_segments", "duplicates",
    "merged", "merge_offset", "spikes"}`` (``merge_offset``: the largest distance of a
    merged vertex from its course, output unit; ``spikes``: vertices where the boundary turns
    straight back, see ``bdw_count_spikes``; ``skipped_curved``: skipped rings made only of curve segments, for example
    a circle; ``skipped_arc_flat``: skipped rings that mix curve and straight segments but
    have no area as chords, for example a semicircle; ``crossings``: pairs of boundary segments
    that cross each other, judged on the TRUE boundaries when the polygon has curves;
    ``orphan_holes``: holes not described because their outer ring was skipped (a hole is never
    described as land); ``dropped_holes`` / ``dropped_hole_area``: holes WITH area that could not
    be written as courses (a circle, a semicircle, a hole merged away), so the description of
    their outer ring includes that area as land (output unit squared, true curves);
    ``dropped_parts`` / ``dropped_part_area``: outer rings with area that could not be written
    (net of their holes), so that land is not described; ``merge_area_change``: the largest
    relative area change of a ring caused by Merge Collinear; ``overlap_pairs``: ``(p, q)``
    part numbers of described parts whose land overlaps (one part inside another, two identical
    parts, parts that cross or run into each other's land), see ``bdw_overlapping_parts``;
    ``overlap_unchecked``: part pairs not tested (work limit); ``promoted_holes``: counter-clockwise rings inside no outer ring,
    described as outer rings; ``chord_conflicts``: described holes that the CHORD polygon of
    their outer ring does not enclose (a hole in the bulge of an arc); ``merge_capped``:
    vertices kept because a merge hull grew past ``BDW_MERGE_HULL``); each ring dict has
    ``part_no`` (1-based over the parts that are described: a part with no usable outer
    ring does not take a number), ``ring_no`` (1-based over the whole feature: the outer ring of part 1,
    its holes, the outer ring of part 2, ...), ``ring_type`` (OUTER / HOLE),
    ``point_nos`` (point numbers run on over the rings of one feature), ``vertices``,
    ``courses`` (each with ``course_no``, ``from_pt``, ``to_pt``, ``from_xy``, ``to_xy``,
    ``arc``, ``note`` and the ``bdw_course`` values), ``closure`` and ``area`` (planar,
    in output unit squared)."""
    parcel = {"oid": oid, "key": key, "rings": [], "skipped_rings": 0, "skipped_curved": 0,
              "skipped_arc_flat": 0, "crossings": 0, "arc_segments": 0, "duplicates": 0,
              "merged": 0, "merge_offset": 0.0, "spikes": 0, "merge_capped": 0,
              "promoted_holes": 0, "orphan_holes": 0, "chord_conflicts": 0,
              "dropped_holes": 0, "dropped_hole_area": 0.0, "dropped_parts": 0,
              "dropped_part_area": 0.0, "merge_area_change": 0.0, "overlap_pairs": [],
              "overlap_unchecked": 0}
    ring_no, point_no, described_parts = 0, 1, 0
    groups = bdw_group_rings(rings)
    used = set()
    for _o, _holes in groups:
        used.add(id(_o))
        used.update(id(h) for h in _holes)
    for ring in rings:
        if id(ring) not in used:
            parcel["skipped_rings"] += 1
            _bdw_count_skipped_curve(parcel, ring)
    true_rings = []                     # TRUE boundaries (curves sampled) of the described rings
    land = {}                           # part_no -> [outer, hole, ...] TRUE boundaries
    for outer, holes in groups:
        part_no = None
        if ring_signed_area(close_ring(_bdw_shape(outer))) > 0:
            parcel["promoted_holes"] += 1   # a counter-clockwise ring that no outer contains
        chord_outer = None
        for is_hole, ring in [(False, outer)] + [(True, h) for h in holes]:
            if is_hole and part_no is None:  # the outer ring was skipped: a hole without its
                parcel["skipped_rings"] += 1  # parcel is never described as if it were land
                parcel["orphan_holes"] += 1
                continue
            clockwise = (not is_hole) if options["orientation"] == "OUTER_CW_HOLES_CCW" \
                else options["orientation"] == "ALL_CLOCKWISE"
            norm = bdw_normalise_ring(ring, clockwise, options)
            if norm is None:
                parcel["skipped_rings"] += 1
                _bdw_count_skipped_curve(parcel, ring)
                true_area = _bdw_true_area(ring) * options["factor"] ** 2
                if true_area and is_hole:
                    # a hole with area that cannot be written as courses: the outer ring's
                    # description then INCLUDES its area as land (never silent)
                    parcel["dropped_holes"] += 1
                    parcel["dropped_hole_area"] += true_area
                elif true_area:
                    # an outer ring with area that cannot be written: that land is omitted
                    net = true_area - sum(_bdw_true_area(h) for h in holes) * options["factor"] ** 2
                    parcel["dropped_parts"] += 1
                    parcel["dropped_part_area"] += max(net, 0.0)
                continue
            true_rings.append([tuple(p) for p in close_ring(_bdw_shape(ring))[:-1]])
            if not is_hole:
                chord_outer = norm["verts"]
            elif (any(outer["arcs"]) or any(ring["arcs"])) and chord_outer is not None:
                if _bdw_hole_conflicts_with_chords(norm["verts"], chord_outer):
                    parcel["chord_conflicts"] += 1
            if part_no is None:              # parts are numbered over the DESCRIBED parts
                described_parts += 1
                part_no = described_parts
            land.setdefault(part_no, []).append(true_rings[-1])
            verts, arcs = norm["verts"], norm["arcs"]
            n = len(verts)
            ring_no += 1
            parcel["spikes"] += bdw_count_spikes(verts)
            first = point_no
            point_nos = list(range(first, first + n))
            courses = []
            for i in range(n):
                a, b = verts[i], verts[(i + 1) % n]
                c = bdw_course(a, b, options)
                c.update({"course_no": i + 1, "from_pt": point_nos[i],
                          "to_pt": point_nos[(i + 1) % n], "from_xy": a, "to_xy": b,
                          "arc": bool(arcs[i]), "note": ""})
                notes = []
                if arcs[i]:
                    notes.append("curve replaced by its chord")
                if float(c["dist_txt"]) == 0.0:
                    notes.append("distance rounds to zero at this precision")
                c["note"] = "; ".join(notes)
                courses.append(c)
            point_no += n
            parcel["arc_segments"] += sum(1 for a in arcs if a)
            parcel["duplicates"] += norm["duplicates"]
            parcel["merged"] += norm["merged"]
            parcel["merge_capped"] += norm.get("merge_capped", 0)
            parcel["merge_offset"] = max(parcel["merge_offset"],
                                         norm["merge_offset"] * options["factor"])
            parcel["merge_area_change"] = max(parcel["merge_area_change"],
                                              norm.get("merge_area_change", 0.0))
            area = abs(ring_signed_area(close_ring(verts))) * options["factor"] ** 2
            parcel["rings"].append({
                "part_no": part_no, "ring_no": ring_no,
                "ring_type": "HOLE" if is_hole else "OUTER", "point_nos": point_nos,
                "vertices": verts, "courses": courses, "area": area,
                "arc_segments": sum(1 for a in arcs if a),
                "closure": bdw_closure(courses, options)})
    if len(land) > 1:
        parcel["overlap_pairs"], parcel["overlap_unchecked"] = bdw_overlapping_parts(
            [land[k] for k in sorted(land)])
    if parcel["rings"] and options.get("check_crossings", True):
        if parcel["arc_segments"]:
            # Curved rings: a crossing is judged on the TRUE boundary (curves sampled), so a
            # hole that only crosses the CHORD of an arc is not called a self-intersection
            # (that case is counted in chord_conflicts instead).
            parcel["crossings"] = bdw_count_crossings(true_rings)
        else:
            parcel["crossings"] = bdw_count_crossings([r["vertices"] for r in parcel["rings"]])
    return parcel


BDW_OVERLAP_BUDGET = 4000000   # edge x edge tests per polygon for the part-overlap test


def _bdw_land_status(p, part, tol):
    """``"in"`` (inside the land of ``part``: its outer ring, outside its holes), ``"outer"`` (on
    its outer ring), ``"hole"`` (on a hole ring) or ``"out"``. ``part``: ``[outer, holes...]``,
    open rings (TRUE boundaries)."""
    state = point_in_ring(p, part[0], tol)
    if state == "out":
        return "out"
    if state == "boundary":
        return "outer"
    for hole in part[1:]:
        state = point_in_ring(p, hole, tol)
        if state == "in":
            return "out"
        if state == "boundary":
            return "hole"
    return "in"


def _bdw_bbox(ring):
    xs = [p[0] for p in ring]
    ys = [p[1] for p in ring]
    return min(xs), min(ys), max(xs), max(ys)


def _bdw_split_params(a, b, rings, tol):
    """Parameters ``0 < t < 1`` along segment ``a``-``b`` where an edge of ``rings`` meets it
    (crosses it, touches it, or has a vertex on it). Between two consecutive parameters the
    segment lies wholly inside, wholly outside or wholly on the other boundary."""
    ax, ay = a
    dx, dy = b[0] - ax, b[1] - ay
    length2 = dx * dx + dy * dy
    if length2 == 0.0:
        return []
    ts = []
    for ring in rings:
        n = len(ring)
        for i in range(n):
            c, d = ring[i], ring[(i + 1) % n]
            # a vertex of the other boundary on this segment
            t = ((c[0] - ax) * dx + (c[1] - ay) * dy) / length2
            if 0.0 < t < 1.0:
                px, py = ax + t * dx, ay + t * dy
                if math.hypot(c[0] - px, c[1] - py) <= tol:
                    ts.append(t)
            # a crossing of the two segments
            ex, ey = d[0] - c[0], d[1] - c[1]
            den = dx * ey - dy * ex
            if den != 0.0:
                t = ((c[0] - ax) * ey - (c[1] - ay) * ex) / den
                u = ((c[0] - ax) * dy - (c[1] - ay) * dx) / den
                if 0.0 < t < 1.0 and 0.0 <= u <= 1.0:
                    ts.append(t)
    return ts


def _bdw_boundary_states(outer, other, tol):
    """The set of ``_bdw_land_status`` values met by the pieces of the closed boundary ``outer``
    (open ring) against the land ``other``: each edge is cut where ``other``'s rings meet it and
    the midpoint of every piece longer than ``tol`` is classified (a piece lies wholly on one
    side, so its midpoint stands for it). Stops at the first piece inside."""
    found = set()
    n = len(outer)
    for i in range(n):
        a, b = outer[i], outer[(i + 1) % n]
        seg = math.hypot(b[0] - a[0], b[1] - a[1])
        ts = sorted(set([0.0, 1.0] + _bdw_split_params(a, b, other, tol)))
        for t0, t1 in zip(ts, ts[1:]):
            if (t1 - t0) * seg <= tol:
                continue
            tm = (t0 + t1) / 2.0
            state = _bdw_land_status((a[0] + tm * (b[0] - a[0]), a[1] + tm * (b[1] - a[1])),
                                     other, tol)
            found.add(state)
            if state == "in":
                return found
    return found


def bdw_overlapping_parts(parts, tol=BDW_TIE_TOL, budget=BDW_OVERLAP_BUDGET):
    """``([(p, q), ...], unchecked)``: 1-based numbers ``p < q`` of the parts whose LAND overlaps
    (they have area in common), and the number of part pairs not tested because the work limit
    ``budget`` (edge x edge tests over the polygon) was reached. ``parts``: ``[[outer, hole,
    ...], ...]``, open rings. The land of a part is its outer ring minus its holes, so an island
    inside the hole of another part does not overlap it, and parts that only touch (a shared
    edge or vertex) do not either.

    Two lands overlap exactly when a piece of the outer ring of one runs through the inside of
    the land of the other (either way round), or when the two outer rings are the same ring.
    Every outer edge is cut at the points where the other part's rings meet it, so each piece is
    wholly inside, outside or on the other boundary, and its midpoint decides it."""
    found, unchecked, work = [], 0, 0
    boxes = [_bdw_bbox(part[0]) for part in parts]
    for i in range(len(parts)):
        for j in range(i + 1, len(parts)):
            bi, bj = boxes[i], boxes[j]
            if bi[2] < bj[0] - tol or bj[2] < bi[0] - tol or bi[3] < bj[1] - tol \
                    or bj[3] < bi[1] - tol:
                continue
            cost = (len(parts[i][0]) * sum(len(r) for r in parts[j])
                    + len(parts[j][0]) * sum(len(r) for r in parts[i]))
            if work + cost > budget:
                unchecked += 1
                continue
            work += cost
            states = _bdw_boundary_states(parts[j][0], parts[i], tol)
            overlap = "in" in states or states == set(["outer"])
            if not overlap:
                overlap = "in" in _bdw_boundary_states(parts[i][0], parts[j], tol)
            if overlap:
                found.append((i + 1, j + 1))
    return found, unchecked


def _bdw_hole_conflicts_with_chords(hole, outer):
    """True when a described hole is not inside the CHORD polygon of its outer ring: one of
    its vertices lies outside it, or an edge of the hole crosses an edge of the outer ring.
    It happens when the hole lies (partly) in the bulge between a true curve and its chord:
    the hole is inside the true parcel but the chord courses do not enclose it."""
    ring = list(outer) + [outer[0]]
    if any(point_in_ring(p, ring) == "out" for p in hole):
        return True
    return bool(bdw_has_crossing([list(outer), list(hole)]))


# --------------------------------------------------------------------------
# Table rows
# --------------------------------------------------------------------------

def bdw_course_rows(parcel):
    """Rows for ``BDW_COURSE_COLUMNS``."""
    rows = []
    for ring in parcel["rings"]:
        for c in ring["courses"]:
            rows.append((parcel["oid"], parcel["key"], ring["part_no"], ring["ring_no"],
                         ring["ring_type"], c["course_no"], c["from_pt"], c["to_pt"], c["az"],
                         c["az_pub"], c["bearing"], c["dist"], c["dist_pub"], c["dist_txt"],
                         c["from_xy"][0], c["from_xy"][1], c["to_xy"][0], c["to_xy"][1],
                         "STRAIGHT", 1 if c["arc"] else 0, c["note"]))
    return rows


def bdw_vertex_rows(parcel, latlon=None):
    """Rows for ``BDW_VERTEX_COLUMNS`` (+ ``BDW_LATLON_COLUMNS`` when ``latlon`` is given:
    ``{point_no: (lon, lat)}``)."""
    rows = []
    for ring in parcel["rings"]:
        for seq, (pt, (x, y)) in enumerate(zip(ring["point_nos"], ring["vertices"]), 1):
            row = [parcel["oid"], parcel["key"], ring["part_no"], ring["ring_no"], seq, pt, x, y]
            if latlon is not None:
                lon, lat = latlon[pt]
                row += [lon, lat, bdw_format_latlon(lon, False)[1], bdw_format_latlon(lat, True)[1]]
            rows.append(tuple(row))
    return rows


def bdw_closure_rows(parcel, options):
    """Rows for ``BDW_CLOSURE_COLUMNS``."""
    rows = []
    for ring in parcel["rings"]:
        cl = ring["closure"]
        rows.append((parcel["oid"], parcel["key"], ring["part_no"], ring["ring_no"],
                     ring["ring_type"], len(ring["courses"]), cl["perimeter"],
                     cl["perimeter_pub"], ring["area"], cl["east"], cl["north"],
                     cl["misclosure"], cl["azimuth"], cl["ratio"], cl["ratio_txt"], cl["bound"],
                     options["unit"], ring["arc_segments"]))
    return rows


def bdw_line_rows(parcel):
    """``(segment, values)`` pairs for the labelled line feature class (``BDW_LINE_COLUMNS``)."""
    rows = []
    for ring in parcel["rings"]:
        for c in ring["courses"]:
            label = "{0}\n{1}".format(c["bearing"], c["dist_txt"])
            rows.append(([c["from_xy"], c["to_xy"]],
                         (parcel["oid"], parcel["key"], ring["ring_no"], c["course_no"],
                          c["bearing"], c["dist_txt"], label, 1 if c["arc"] else 0)))
    return rows


# --------------------------------------------------------------------------
# Narrative (English / Arabic)
# --------------------------------------------------------------------------

_BDW_ARABIC_DIGITS = dict(zip("0123456789", "٠١٢٣٤٥٦٧٨٩"))
_BDW_AR_HEMI = {"N": "شمال", "S": "جنوب", "E": "شرق", "W": "غرب"}
_BDW_AR_CARDINAL = {"N": "الشمال", "S": "الجنوب", "E": "الشرق", "W": "الغرب"}


def bdw_arabic_number(text, digits):
    """A number / angle text for use inside Arabic: isolated left to right (so ``45°30'15"``
    keeps its order in a right-to-left sentence), with Arabic-Indic digits and the Arabic
    decimal separator when ``digits`` is ``ARABIC_INDIC``."""
    if digits == "ARABIC_INDIC":
        text = "".join(_BDW_ARABIC_DIGITS.get(ch, ch) for ch in text).replace(".", chr(0x066B))
    return LRI + text + PDI


def _bdw_en_direction(c):
    angle = c["angle"]
    if angle["kind"] == "cardinal":
        return "due " + angle["text"]
    if angle["kind"] == "quadrant":
        return angle["text"]
    return "on an azimuth of " + angle["angle"]


def _bdw_ar_direction(c, digits):
    angle = c["angle"]
    if angle["kind"] == "cardinal":
        return "باتجاه " + _BDW_AR_CARDINAL[angle["cardinal"]]
    num = bdw_arabic_number(angle["angle"], digits)
    if angle["kind"] == "quadrant":
        return "باتجاه {0} {1} {2}".format(_BDW_AR_HEMI[angle["ns"]], num,
                                           _BDW_AR_HEMI[angle["ew"]])
    return "بسمت قدره " + num


def _bdw_en_ring(ring, options, lead, unit_word):
    dec = options["dist_decimals"]
    first = ring["courses"][0]["from_xy"]
    hole = ring["ring_type"] == "HOLE"
    parts = ["{0}Beginning at point {1} (easting {2} {u}, northing {3} {u})".format(
        lead, ring["point_nos"][0], bdw_coord_text(first[0], dec), bdw_coord_text(first[1], dec),
        u=options["map_unit_en"])]
    last = len(ring["courses"]) - 1
    for i, c in enumerate(ring["courses"]):
        chord = (", along the chord of a curve (a straight line between the ends of the curve, "
                 "not the curve itself),") if c["arc"] else ""
        if i == last:
            tail = ("to point {0}, the point of beginning of this excepted area" if hole
                    else "to point {0}, the point of beginning").format(c["to_pt"])
        else:
            tail = "to point {0}".format(c["to_pt"])
        parts.append("thence{0} {1} a distance of {2} {3} {4}".format(
            chord, _bdw_en_direction(c), c["dist_txt"],
            bdw_en_unit_word(c["dist_txt"], options["unit"]), tail))
    return "; ".join(parts) + "."


# unit -> (singular after 1, 2, 100, 200, 1000 ...; plural after 3 to 10) for whole-number
# distances (0 distance decimals). After 11 to 99 the accusative singular of BDW_UNITS is used,
# and after a decimal number too.
BDW_AR_COUNT_WORDS = {
    "METERS": ("متر", "أمتار"),
    "FEET": ("قدم", "أقدام"),
    "US_SURVEY_FEET": ("قدم من أقدام المسح الأمريكية", "أقدام من أقدام المسح الأمريكية"),
}


BDW_EN_SINGULAR = {"METERS": "metre", "FEET": "foot", "US_SURVEY_FEET": "US survey foot"}


def bdw_en_unit_word(dist_txt, unit):
    """The English unit word after a published distance: singular after exactly "1" (0
    distance decimals), else the plural of BDW_UNITS ("1.00 metres", "2 metres")."""
    return BDW_EN_SINGULAR[unit] if str(dist_txt).strip() == "1" else BDW_UNITS[unit][2]


def bdw_ar_unit_word(dist_txt, unit):
    """The Arabic unit word after a published distance ``dist_txt`` (Western digits, as in
    DIST_TXT). A whole number takes the counted-noun form its last two digits ask for: 3 to 10
    the plural ("5 أمتار"), 11 to 99 the accusative singular ("20 متراً"), 0, 1 and 2 (1, 2,
    100, 101, 1000 ...) the singular ("1 متر", "100 متر"). A decimal number keeps the
    accusative singular ("50.00 متراً")."""
    accusative = BDW_UNITS[unit][3]
    text = str(dist_txt).strip()
    if not text.isdigit():
        return accusative
    last_two = int(text) % 100
    singular, plural = BDW_AR_COUNT_WORDS[unit]
    if 3 <= last_two <= 10:
        return plural
    if 11 <= last_two <= 99:
        return accusative
    return singular


def _bdw_ar_ring(ring, options, lead, unit_word, digits):
    dec = options["dist_decimals"]
    first = ring["courses"][0]["from_xy"]
    hole = ring["ring_type"] == "HOLE"

    def num(text):
        return bdw_arabic_number(text, digits)

    map_key = [k for k, v in BDW_UNITS.items() if v[3] == options["map_unit_ar"]]
    east, north = bdw_coord_text(first[0], dec), bdw_coord_text(first[1], dec)

    def coord_word(text):        # a map unit named in BDW_UNITS takes the counted-noun form
        return bdw_ar_unit_word(text, map_key[0]) if map_key else options["map_unit_ar"]
    parts = ["{0}ابتداءً من النقطة {1} (الإحداثي الشرقي {2} {3}، الإحداثي الشمالي {4} {5})".format(
        lead, num(str(ring["point_nos"][0])), num(east), coord_word(east), num(north),
        coord_word(north))]
    last = len(ring["courses"]) - 1
    for i, c in enumerate(ring["courses"]):
        chord = (" على امتداد وتر المنحنى (وهو الخط المستقيم بين طرفي المنحنى وليس المنحنى نفسه)"
                 if c["arc"] else "")
        if i == last:
            tail = "إلى النقطة {0}، وهي نقطة بداية حدّ هذه المنطقة المستثناة" if hole \
                else "إلى النقطة {0}، وهي نقطة البداية"
            tail = tail.format(num(str(c["to_pt"])))
        else:
            tail = "إلى النقطة {0}".format(num(str(c["to_pt"])))
        parts.append("ثم{0} {1} مسافة قدرها {2} {3} {4}".format(
            chord, _bdw_ar_direction(c, digits), num(c["dist_txt"]),
            bdw_ar_unit_word(c["dist_txt"], options["unit"]), tail))
    return "؛ ".join(parts) + "."


def _bdw_parcel_closes(parcel):
    """True when every ring of the parcel closes to numerical precision (the rounded courses
    return to the start); False when at least one does not; None when unknown."""
    if not parcel or not parcel.get("rings"):
        return None
    return all(r["closure"]["ratio"] is None for r in parcel["rings"])


def bdw_basis_statement(options, language, parcel=None):
    """The basis-of-bearings sentence(s) of a narrative: the user's own text when given,
    else the standard text (grid bearings of the coordinate system, planar distances in
    the chosen unit, rounding, no adjustment, drafting aid). Empty when switched off.

    The sentence about closure follows the parcel: when every ring of ``parcel`` closes to
    numerical precision it says so; when a ring does not, it says the courses do not close
    exactly because of rounding; without a parcel it says they may not."""
    if options["basis_position"] == "NONE":
        return ""
    if options["basis_text"]:
        return options["basis_text"]
    unit = BDW_UNITS[options["unit"]]
    crs = options["crs_name"]
    closes = _bdw_parcel_closes(parcel)
    if language == "ARABIC":
        crs_text = ("نظام الإحداثيات " + LRI + crs + PDI) if crs else "نظام إحداثيات البيانات"
        closing = {True: "الأضلاع المنشورة تُغلق ضمن الدقة العددية ولم تُطبَّق أي تسوية للإقفال.",
                   False: "الأضلاع المنشورة لا تُغلق تماماً بسبب التقريب ولم تُطبَّق أي تسوية "
                          "للإقفال.",
                   None: "قد لا تُغلق الأضلاع المنشورة تماماً بسبب التقريب ولم تُطبَّق أي "
                         "تسوية للإقفال."}[closes]
        return ("أساس الاتجاهات: اتجاهات شبكية (grid) في {0}، تُقاس مع عقارب الساعة من شمال "
                "الشبكة لا من الشمال الحقيقي أو الجيوديسي أو المغناطيسي. المسافات مستوية على "
                "الشبكة، ووحدتها {1}، مقرَّبة كما هي مذكورة، دون معامل مقياس أو تصحيح للارتفاع، "
                "ووحدة الإحداثيات {2}. {3} "
                "هذا النص مسودة للمراجعة وليس وثيقة مساحية قانونية.").format(
                    crs_text, unit[4], options["map_unit_ar_def"], closing)
    crs_text = crs if crs else "the coordinate system of the data"
    closing = {True: "The published courses close to within numerical precision, and no "
                     "closure adjustment has been applied.",
               False: "The published courses do not close exactly because of rounding, and no "
                      "closure adjustment has been applied.",
               None: "The published courses may not close exactly because of rounding, and no "
                     "closure adjustment has been applied."}[closes]
    return ("Basis of bearings: grid bearings of {0} (azimuth measured clockwise from grid "
            "north; not true, geodetic or magnetic north). Distances are planar grid distances "
            "in {1}, rounded as shown, with no scale factor or elevation reduction; coordinates "
            "are in {2}. {3} This text is a draft for review and is not "
            "a legal survey instrument.").format(crs_text, unit[2], options["map_unit_en"],
                                                 closing)


def _bdw_dropped_notes(parcel, language, options):
    """Notes that keep a narrative from reading as complete when a ring WITH area could not be
    written as courses: a dropped hole (its area is then included as land) and a dropped part
    (that land is not described). The area is that of the true boundary, approximate."""
    notes = []
    words = BDW_AREA_WORDS[options["unit"]]
    dec = options["dist_decimals"]
    arabic = language == "ARABIC"

    def num(value):
        text = "{0:.{1}f}".format(value, dec)
        return bdw_arabic_number(text, options["digits"]) if arabic else text
    if parcel.get("dropped_holes"):
        n, area = parcel["dropped_holes"], num(parcel["dropped_hole_area"])
        if arabic:
            notes.append("(ملاحظة: تعذّر وصف {0} من المناطق المستثناة (الثقوب) في هذه القطعة "
                         "بأضلاع مستقيمة، كمنطقة لا تحدّها إلا منحنيات، ومساحتها الإجمالية نحو "
                         "{1} {2}؛ فهي غير مستثناة أعلاه، والوصف أعلاه يشمل مساحتها كأنها من "
                         "الأرض.)".format(bdw_arabic_number(str(n), options["digits"]), area,
                                          words[1]))
        else:
            notes.append("(Note: {0} excepted area(s) (hole(s)) of this parcel, about {1} {2} "
                         "in all, could not be written as straight courses (for example a hole "
                         "bounded only by curves) and are NOT excepted above: the description "
                         "above includes that area as if it were land.)".format(n, area, words[0]))
    if parcel.get("dropped_parts"):
        n, area = parcel["dropped_parts"], num(parcel["dropped_part_area"])
        if arabic:
            notes.append("(ملاحظة: تعذّر وصف {0} من أجزاء هذه القطعة بأضلاع مستقيمة، كجزء لا "
                         "تحدّه إلا منحنيات، ومساحتها الإجمالية نحو {1} {2}؛ فهي غير موصوفة "
                         "أعلاه.)".format(bdw_arabic_number(str(n), options["digits"]), area,
                                          words[1]))
        else:
            notes.append("(Note: {0} further part(s) of this parcel, about {1} {2} in all, could "
                         "not be written as straight courses (for example a part bounded only by "
                         "curves) and are NOT described above.)".format(n, area, words[0]))
    pairs = parcel.get("overlap_pairs") or []
    if pairs:
        if arabic:
            shown = "، ".join("{0} و{1}".format(bdw_arabic_number(str(a), options["digits"]),
                                                bdw_arabic_number(str(b), options["digits"]))
                              for a, b in pairs)
            notes.append("(ملاحظة: تتداخل أجزاء من هذه القطعة فيما بينها (الجزءان {0})، كأن يقع "
                         "جزء داخل جزء آخر أو يتطابق جزءان؛ فالمساحة المشتركة موصوفة أعلاه "
                         "مرتين. هذه هندسة غير سليمة، فأصلِحها قبل الاعتماد على الوصف.)".format(shown))
        else:
            shown = "; ".join("{0} and {1}".format(a, b) for a, b in pairs)
            notes.append("(Note: parts of this parcel overlap each other (parts {0}), for "
                         "example one part lying inside another or two identical parts: the "
                         "common area is described above twice. The geometry is not valid; "
                         "repair it before relying on this description.)".format(shown))
    return notes


def bdw_narrative(parcel, language, options):
    """Plain-text boundary description of one parcel in ``ENGLISH`` or ``ARABIC``.

    One paragraph per ring (outer ring, then the holes as exceptions, numbered excepted area
    1..n per parcel in the order written, not by RING_NO); several parts are
    headed ``Part p of P``. The basis-of-bearings statement is added before or after
    (``options["basis_position"]``). A parcel without a usable ring gives an empty string."""
    rings = parcel["rings"]
    if not rings:
        return ""
    parts_total = max(r["part_no"] for r in rings)
    unit = BDW_UNITS[options["unit"]]
    paragraphs = []
    hole_no = 0                  # excepted areas are numbered 1..n in the order written
    for ring in rings:
        arabic = language == "ARABIC"
        if ring["ring_type"] == "HOLE":
            hole_no += 1
        if arabic:
            lead = ""
            if parts_total > 1 and ring["ring_type"] == "OUTER":
                lead = "الجزء {0} من {1}: ".format(
                    bdw_arabic_number(str(ring["part_no"]), options["digits"]),
                    bdw_arabic_number(str(parts_total), options["digits"]))
            if ring["ring_type"] == "HOLE":
                lead = "ويُستثنى من ذلك المنطقة الداخلية رقم {0}، وحدودها كما يلي: ".format(
                    bdw_arabic_number(str(hole_no), options["digits"]))
            paragraphs.append(_bdw_ar_ring(ring, options, lead, unit[3], options["digits"]))
        else:
            lead = ""
            if parts_total > 1 and ring["ring_type"] == "OUTER":
                lead = "Part {0} of {1}: ".format(ring["part_no"], parts_total)
            if ring["ring_type"] == "HOLE":
                lead = "EXCEPTING THEREFROM the following (excepted area {0}): ".format(
                    hole_no)
            paragraphs.append(_bdw_en_ring(ring, options, lead, unit[2]))
    paragraphs.extend(_bdw_dropped_notes(parcel, language, options))
    if parcel["arc_segments"]:
        paragraphs.append("(ملاحظة: المقاطع المنحنية موصوفة بأوتارها المستقيمة.)"
                          if language == "ARABIC" else
                          "(Note: curved boundary segments are described by their chords.)")
    basis = bdw_basis_statement(options, language, parcel)
    if basis:
        if options["basis_position"] == "OPENING":
            paragraphs.insert(0, basis)
        else:
            paragraphs.append(basis)
    return "\n".join(paragraphs)


# --------------------------------------------------------------------------
# Reports
# --------------------------------------------------------------------------

BDW_CAVEAT_EN = (
    "DRAFT FOR REVIEW. This text is generated from GIS geometry. It is not a legal survey "
    "instrument and does not replace a licensed surveyor's description. Bearings are GRID "
    "bearings of the projected coordinate system (not true, geodetic or magnetic north); "
    "distances are planar grid distances, with no scale factor or elevation reduction. "
    "Bearings and distances are rounded as published: the published courses may not close "
    "exactly (see the closure figures). No closure adjustment has been applied.")
BDW_CAVEAT_AR = (
    "مسودة للمراجعة. هذا النص مُولَّد من هندسة بيانات نظام المعلومات الجغرافية، وهو ليس وثيقة "
    "مساحية قانونية ولا يحل محل وصف المساح المرخّص. الاتجاهات المذكورة هي اتجاهات شبكية (grid) "
    "لنظام الإحداثيات المسقَط، وليست الشمال الحقيقي أو الجيوديسي أو المغناطيسي؛ والمسافات هي "
    "مسافات مستوية على الشبكة دون تطبيق معامل المقياس أو التصحيح للارتفاع. الاتجاهات والمسافات "
    "مقرَّبة كما هي منشورة، لذلك قد لا تُغلق الأضلاع المنشورة تماماً (انظر أرقام الإقفال). "
    "لم تُطبَّق أي تسوية للإقفال.")


def _bdw_course_table_lines(ring):
    lines = ["  {0:>6} {1:>5} {2:>5}  {3:<26} {4:>14}  {5}".format(
        "Course", "From", "To", "Bearing", "Distance", "Note")]
    for c in ring["courses"]:
        lines.append("  {0:>6} {1:>5} {2:>5}  {3:<26} {4:>14}  {5}".format(
            c["course_no"], c["from_pt"], c["to_pt"], c["bearing"], c["dist_txt"], c["note"]))
    return lines


def _bdw_closure_line(ring, options):
    cl = ring["closure"]
    text = ("  Closure of the published courses: misclosure {0:.4f} {1}, precision {2}, "
            "perimeter {3:.{d}f} {1}, rounding bound {4:.4f} {1}.".format(
                cl["misclosure"], BDW_UNITS[options["unit"]][1], cl["ratio_txt"],
                cl["perimeter_pub"], cl["bound"], d=options["dist_decimals"]))
    if ring["arc_segments"]:
        text += (" {0} curved segment(s) are replaced by chords: perimeter, area and closure "
                 "describe the chord polygon.".format(ring["arc_segments"]))
    return text


def bdw_report_text_header(meta):
    """Header lines of the plain-text report. ``meta``: ``{"crs", "unit_label", "version",
    "settings"}``."""
    lines = ["BOUNDARY DESCRIPTIONS / أوصاف الحدود",
             "Boundary Description (Metes and Bounds) v{0}".format(meta["version"]),
             "Coordinate system: {0}. Distances in {1}.".format(meta["crs"], meta["unit_label"]),
             "Settings: {0}".format(meta["settings"]), "", BDW_CAVEAT_EN, "", BDW_CAVEAT_AR, ""]
    return "\n".join(lines) + "\n"


def bdw_report_text_parcel(parcel, narratives, options):
    """Plain-text block of one parcel: narrative(s), courses and closure per ring."""
    lines = ["=" * 78, "Parcel {0}  (OID {1})".format(bdw_display_key(parcel["key"]),
                                                      parcel["oid"]), ""]
    if not parcel["rings"]:
        lines.append("No usable ring (empty or degenerate geometry).")
    for text in narratives:
        lines.extend([text, ""])
    for ring in parcel["rings"]:
        lines.append("Ring {0} ({1}, part {2}), points {3}-{4}:".format(
            ring["ring_no"], ring["ring_type"], ring["part_no"], ring["point_nos"][0],
            ring["point_nos"][-1]))
        lines.extend(_bdw_course_table_lines(ring))
        lines.append(_bdw_closure_line(ring, options))
        lines.append("")
    return "\n".join(lines) + "\n"


def _bdw_esc(text):
    return (str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))


_BDW_CSS = (
    "body{font-family:Segoe UI,Arial,sans-serif;margin:24px;max-width:960px;color:#222}\n"
    ".caveat{border:1px solid #b36b00;background:#fff4e0;padding:8px 12px;margin:12px 0}\n"
    "section{border-top:2px solid #444;margin-top:28px;padding-top:8px}\n"
    ".narr{margin:8px 0;padding:6px 10px;background:#f4f6f8;white-space:pre-wrap}\n"
    "table{border-collapse:collapse;margin:8px 0 2px 0;font-size:90%}\n"
    "th,td{border:1px solid #bbb;padding:2px 8px;text-align:right}\n"
    "td.t,th.t{text-align:left}\n.cl{font-size:90%;color:#444;margin:2px 0 12px 0}\n")


def bdw_report_html_header(meta):
    """Start of the HTML report (UTF-8, ``<html>`` open)."""
    return (
        "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
        "<title>Boundary descriptions</title>\n<style>\n" + _BDW_CSS + "</style>\n</head>\n"
        "<body>\n<h1>Boundary descriptions</h1>\n"
        "<p>Boundary Description (Metes and Bounds) v{0}. Coordinate system: {1}. Distances in {2}.</p>\n"
        "<p>Settings: {3}</p>\n"
        "<div class=\"caveat\" lang=\"en\" dir=\"ltr\">{4}</div>\n"
        "<div class=\"caveat\" lang=\"ar\" dir=\"rtl\">{5}</div>\n".format(
            _bdw_esc(meta["version"]), _bdw_esc(meta["crs"]), _bdw_esc(meta["unit_label"]),
            _bdw_esc(meta["settings"]), _bdw_esc(BDW_CAVEAT_EN), _bdw_esc(BDW_CAVEAT_AR)))


def bdw_report_html_parcel(parcel, narratives, options):
    """HTML ``<section>`` of one parcel. ``narratives``: list of ``(language, text)``."""
    out = ["<section>\n<h2>Parcel {0} <small>(OID {1})</small></h2>\n".format(
        _bdw_esc(bdw_display_key(parcel["key"])), parcel["oid"])]
    if not parcel["rings"]:
        out.append("<p>No usable ring (empty or degenerate geometry).</p>\n")
    for language, text in narratives:
        out.append("<div class=\"narr\" lang=\"{0}\" dir=\"{1}\">{2}</div>\n".format(
            "ar" if language == "ARABIC" else "en", "rtl" if language == "ARABIC" else "ltr",
            _bdw_esc(text)))
    for ring in parcel["rings"]:
        out.append("<h3>Ring {0} ({1}, part {2})</h3>\n<table>\n<tr><th>Course</th><th>From</th>"
                   "<th>To</th><th class=\"t\">Bearing</th><th>Distance</th>"
                   "<th class=\"t\">Note</th></tr>\n".format(
                       ring["ring_no"], ring["ring_type"], ring["part_no"]))
        for c in ring["courses"]:
            out.append("<tr><td>{0}</td><td>{1}</td><td>{2}</td><td class=\"t\">{3}</td>"
                       "<td>{4}</td><td class=\"t\">{5}</td></tr>\n".format(
                           c["course_no"], c["from_pt"], c["to_pt"], _bdw_esc(c["bearing"]),
                           _bdw_esc(c["dist_txt"]), _bdw_esc(c["note"])))
        out.append("</table>\n<div class=\"cl\">{0}</div>\n".format(
            _bdw_esc(_bdw_closure_line(ring, options).strip())))
    out.append("</section>\n")
    return "".join(out)


def bdw_report_html_footer():
    return "</body>\n</html>\n"


# ==========================================================================
# analysis/network_rules_tool.py
# ==========================================================================
# Line Network Rule Check: the ArcGIS Pro tool (adapter).

_NET_COMPONENT_FIELDS = ("SRC_OID", "COMPONENT_ID", "COMP_LINES", "COMP_LENGTH_M")
_NET_MAX_UTM_ZONES = 10          # wider geographic data is refused (one plane is needed)
_NET_EXEMPT_UNUSED = ("neither DANGLE nor T_MISS (with a T Distance above 0) is checked, so "
                      "these points are not used. Add DANGLE or T_MISS to Checks to use them.")


def _net_uses_exempt(checks, t_distance):
    """True when Dangle Exempt Points change the result (DANGLE, or T_MISS with a distance)."""
    checks = [str(c).upper() for c in checks]
    return "DANGLE" in checks or ("T_MISS" in checks and t_distance is not None
                                  and float(t_distance) > 0)


_NET_DETAIL_HEADER = ["RULE", "LAYER", "SRC_OID", "NODE_ID", "DEGREE", "VALUE", "X", "Y", "DETAIL"]
_NET_DISTANCES = (("snap_tolerance_m", "The Snap Tolerance"), ("t_distance_m", "The T Distance"))


def _net_oid_spec(path, oids, what, collector):
    """SRC_OID field spec for the output ``path`` (``arcio.oid_field_spec``, the toolkit's one
    ObjectID field rule), with a message when it is not LONG."""
    spec, note = oid_field_spec(oids, is_folder_workspace(workspace_of(path)),
                                label="SRC_OID of the {0}".format(what))
    if note:
        collector.info(note)
    return spec


class LineNetworkRules(object):
    """Dangles, pseudo-nodes, T-misses, point rules and connected components on Basic."""

    DOC = {
        "summary": "Checks a line network (roads, pipes, rivers, cables) in one run and writes "
                   "one error point per problem: dangles (free line ends), pseudo-nodes (two "
                   "lines meeting end to end that could be merged), T-misses (a free end that "
                   "stops just short of another line), end points that only join through a chain of "
                   "near points wider than the snap tolerance (WIDE_NODE_CLUSTER), and point "
                   "features (valves, "
                   "hydrants) that are not on a line or not on a line end. Optionally writes a "
                   "copy of the lines with a connected-component ID. Designed for a Basic licence.",
        "usage": "Before you start: your lines must be split at every junction (each junction "
                 "an end point of every line that meets there). A line that ends on the middle "
                 "of another line is NOT connected to it: its end is reported as a DANGLE and "
                 "the lines fall into different components; the run tells you how many such "
                 "ends it found, also when only COMPONENTS or PSEUDO_NODE is checked. To split "
                 "them: Split Line At Point needs Advanced; Feature To Line and the Planarize edit "
                 "tool need Standard or Advanced; on Basic, use the Split edit tool by hand. The DANGLE row of "
                 "such an end says UNSPLIT in its DETAIL (\"Free end of line OID 7. UNSPLIT: it lies on "
                 "line OID 12 ...\"), and the run message counts these rows: select them with DETAIL "
                 "LIKE '%UNSPLIT%', and the other dangles with RULE = 'DANGLE' AND DETAIL NOT LIKE "
                 "'%UNSPLIT%'. Snap Tolerance: the default 0.001 m reports every gap larger "
                 "than a millimetre. Rules of thumb (not measured): start with 0.05 m for "
                 "surveyed or well-snapped data and 0.5 m for scraped or hand-digitised data, "
                 "and look at the WIDE_NODE_CLUSTER rows.\n\n"
                 "Nodes are the end points of every line part. Interior vertices and crossings "
                 "without a shared end point are NOT nodes: the network is not planarised, so "
                 "two lines crossing in an X are not connected. Likewise a line that ends on "
                 "the middle of another line (a T-junction where the other line is not split) "
                 "is not connected to it: its end is a DANGLE marked UNSPLIT in DETAIL (and a T_MISS "
                 "with VALUE 0, or at most the Snap Tolerance when the end is not exactly on the "
                 "line, when T_MISS is checked), and the two lines are in different components. This "
                 "differs from the topology rule Must Not Have Dangles, which accepts an end "
                 "that touches another line. When your lines are not split at junctions, split "
                 "them there first (every junction an end point of each line; see the licence "
                 "note at the top). A line end that touches its own line (a P shape) or another "
                 "part of the same multipart line is a DANGLE and is not counted as unsplit.\n\nEnd points within the snap "
                 "tolerance are merged transitively: a chain of end points, each within the "
                 "tolerance of the next, becomes one node even if its extremes are farther "
                 "apart. Such nodes are reported as WIDE_NODE_CLUSTER with their diameter in "
                 "metres (VALUE; the exact largest distance between two of its end points, "
                 "for any number of ends). A warning is given when the tolerance is too large for the "
                 "data: a line's two different ends fall into one node while the line is at most "
                 "twice the tolerance long (or its ends were chained together from farther apart "
                 "than the tolerance), or the tolerance is longer than the median line part. A "
                 "long, nearly closed ring whose ends are within the tolerance is simply closed, "
                 "with no warning. Every test against the Snap Tolerance or the T Distance "
                 "counts a distance as within it up to 1.00001 x the value (10 nanometres "
                 "above a 1 mm tolerance), so floating-point noise at exactly the tolerance "
                 "does not decide; a tolerance of 0 still joins identical coordinates only "
                 "(a free end or rule point counts as on a line up to 0.000000001 map units "
                 "away, the rounding of a computed point-to-line distance)."
                 "\n\nDANGLE: a node with one line end; not reported when a "
                 "Dangle Exempt Point is within the snap tolerance. PSEUDO_NODE: exactly two "
                 "different lines meet (two parts of one multipart line do not count); with "
                 "Pseudo-node Fields only "
                 "where all those fields are equal (null equals null; text is compared exactly, "
                 "so a trailing space, another letter case or another Unicode form counts as "
                 "different). The start of a single "
                 "closed loop is not a pseudo-node. When the same two lines meet end to end "
                 "at two nodes (a two-line ring, or two duplicate lines), each of the two "
                 "PSEUDO_NODE rows names the other node instead of saying that the lines meet "
                 "only there; when a third line also ends at one of the two nodes (a duplicate "
                 "road with a side road, a ring with a spur), that node is not a pseudo-node, and "
                 "the one PSEUDO_NODE row still names it. T_MISS (needs a T Distance above 0): a "
                 "non-exempt dangle within the T Distance of another line (other parts of the "
                 "same multipart line are not counted); VALUE is the gap in metres (0 means "
                 "the end touches the other line, on a segment or at one of its interior "
                 "vertices, but is not one of its end points). T_MISS is reported per free end: "
                 "when two free ends face each other across one gap, each gets its own row. "
                 "A line that already meets another "
                 "line at its other end is not reported against that line when the line is no "
                 "longer than the T Distance (a short stub on a road); when it is longer (a hook "
                 "that comes back), the DETAIL says that the two lines already meet. POINT_RULE "
                 "(needs Rule Points): ON_LINE reports points farther than the snap tolerance "
                 "from every line, ON_ENDPOINT points farther than the tolerance from every "
                 "line end; VALUE is the distance to the nearest one.\n\nComponents: lines "
                 "sharing nodes form one component; all parts of a multipart line belong to "
                 "the same component. Components are numbered 1, 2, ... by their lowest "
                 "ObjectID. COMP_LENGTH_M is the total length in metres.\n\nDistances are "
                 "measured in metres in a projected system chosen from the data (the input "
                 "system when it is already projected, else the matching UTM zone"
                 "; for a geographic input on another datum than WGS 84, the UTM zone on "
                 "its own datum when EPSG defines one (for example Ain el Abd 1970 / UTM "
                 "zone 38N), else the WGS 84 UTM zone with a warning that no datum "
                 "transformation is applied (older datums such as NAD27 or ED50 can then "
                 "be offset by up to several hundred metres: project such data to a "
                 "projected metric system first)"
                 "; Web Mercator family inputs (e.g. WKID 3857), which distort "
                 "distances, are re-projected to the UTM zone too, and data near the "
                 "poles to a polar stereographic system). The network is checked in that one "
                 "system. For geographic (or Web Mercator) data wider than 3 UTM zones, polar "
                 "data (beyond 84N / 80S) and input in a polar stereographic system, whose "
                 "scale is not 1 over the data, COMP_LENGTH_M is measured line by line on "
                 "each line's own projection (true metres), and a warning says that the Snap "
                 "Tolerance, T Distance and Rule Point distances are applied in the one "
                 "system. Geographic (or Web Mercator) data wider than 10 UTM zones, and "
                 "lines that cannot be projected to the measuring system (or would collapse in "
                 "it), stop the run with a fix: project the lines to a system suited to their "
                 "extent first, or check a smaller area at a time. When the "
                 "input has to be projected, the lines are first densified every 100 m in "
                 "their own system, so a point on a long straight geographic segment stays on "
                 "it. Error points and the line copy are written in the input coordinate system; "
                 "the X and Y columns of the report are in the measuring system (its WKID is "
                 "in the Summary sheet). In the "
                 "line copy true curves are densified and Z/M values are dropped.\n\n"
                 "Input lines in an unknown coordinate system (for example a shapefile without a "
                 ".prj) are used in their own units as if they were metres, with a warning; when "
                 "every coordinate lies within -180 to 180 and -90 to 90 (longitude and latitude "
                 "in degrees) the run stops: define the coordinate system first (Define "
                 "Projection tool). "
                 "Rule Points and Dangle Exempt Points in an unknown coordinate system (for example a shapefile "
                 "without a .prj) cannot be projected: the run stops when the input has to be "
                 "projected; when the input is used in its own system they are taken to be in "
                 "it, with a warning. "
                 "A copied field keeps its field-level domain when the output geodatabase "
                 "has it, as Copy Features does (a warning names the fields that lose it); "
                 "subtypes and subtype-level domains are not carried. "
                 "A copied text field wider than a shapefile allows (254 characters; Pro's "
                 "default length is 255) is written 254 wide to a folder output when every "
                 "value fits; a longer value stops the run before anything is written. A "
                 "shapefile cannot store an empty number: in a folder output empty NODE_ID, "
                 "DEGREE, VALUE and COMPONENT_ID values are stored as 0 (a message says so; "
                 "the RULE column tells which fields apply, and components are numbered "
                 "from 1).\n\n"
                 "Selections and definition queries on all input layers are honoured. The "
                 "inputs are never edited: an output or report equal to an input is refused. "
                 "Tables joined to an input layer are not known by their path (a layer "
                 "reports only its own table), so any output or report named like a table of "
                 "a joined layer is refused, in any workspace; still, never write an output "
                 "over a joined table. If an arcpy error stops the run while the outputs are "
                 "written, the outputs this run created are deleted and the messages "
                 "collected so far are shown before the error. A shapefile or dBASE output cuts "
                 "field names to 10 bytes (about 5 Arabic letters) (COMPONENT_ID is stored as COMPONENT_); a warning "
                 "names every field the output format stored under another name. SRC_OID is a "
                 "Long field while every ObjectID fits 32 bits; with 64-bit ObjectIDs it is a Big "
                 "Integer field in a geodatabase, a GeoPackage or the memory workspace (an ObjectID "
                 "above 2^53 - 1, which ArcGIS Pro cannot store there, stops the run with the "
                 "fix) and, in a shapefile, a Double "
                 "field while every ObjectID has at most 12 significant digits (a dBASE Double "
                 "keeps no more), else a text field of 20 characters with every digit kept; in the "
                 "Excel report an ObjectID of more than 15 digits is written as text.\n\n"
                 "Not checked: two lines lying on top of each other are not reported as "
                 "duplicates (a shared end where only the two lines meet shows up as a PSEUDO_NODE "
                 "whose DETAIL names their other shared node), and lengths are "
                 "planar metres in the measuring system, not geodesic.\n\n"
                 "Licence: every geoprocessing tool it calls (Create Feature Class, Add Field, "
                 "Delete) is listed as Basic: Yes on its Esri page; use on a Basic licence is "
                 "NOT VERIFIED.\n\n"
                 "Built-in alternatives: the topology rule Must Not Have Dangles needs a "
                 "Standard or Advanced licence (Create Topology: Basic no); Feature Vertices "
                 "To Points (DANGLE option) needs Advanced; Find Dangles and Find Disconnected "
                 "Polylines are Data Reviewer checks (Standard and Data Reviewer licenses). Esri "
                 "pages read 2026-11-08: Create Topology (Pro 3.5 tool page, Basic: No), Find "
                 "Dangles and Find Disconnected Polylines (Pro 3.4 pages, \"Available with ArcGIS "
                 "Pro Standard and Data Reviewer licenses\"); Feature Vertices To Points (tool page "
                 "read 2026-11-07, Basic: No, Standard: No, Advanced: Yes).",
        "params": {
            "in_lines": "Line features of the network.",
            "snap_tolerance_m": "End points closer than or equal to this many metres are the "
                                "same node. Also the distance used for exempt points and "
                                "point rules. 0 = only identical coordinates. Rule of thumb "
                                "(not measured): 0.05 m for surveyed data, 0.5 m for scraped "
                                "or hand-digitised data; the default 0.001 m is very strict. 0, or "
                                "0.000000001 m to 10,000,000 m.",
            "checks": "Checks to run: DANGLE, PSEUDO_NODE, COMPONENTS, T_MISS (needs T "
                      "Distance), POINT_RULE (needs Rule Points).",
            "pseudo_node_fields": "Optional fields that must be equal on both lines for a "
                                  "pseudo-node to be reported (for example road class and "
                                  "name). Empty = every pseudo-node is reported.",
            "t_distance_m": "T_MISS: report dangles within this many metres of another line. "
                            "0 = off. A line no longer than this distance is not reported "
                            "against a line it already meets at its other end. 0, or 0.000000001 m to "
                            "10,000,000 m.",
            "dangle_exempt_points": "Optional points where a free line end is expected (for "
                                    "example hydrants or outfalls). Used by DANGLE and T_MISS "
                                    "only; ignored, with a warning, when neither is checked.",
            "rule_points": "Optional points (for example valves) checked with the Point Rule.",
            "point_rule": "ON_LINE: each rule point must be on a line. ON_ENDPOINT: each rule "
                          "point must be on a line end.",
            "out_errors": "Output point feature class: RULE, LAYER, SRC_OID, NODE_ID, DEGREE, "
                          "VALUE, DETAIL.",
            "out_lines": "Optional copy of the lines with SRC_OID, COMPONENT_ID, COMP_LINES "
                         "and COMP_LENGTH_M (plus the input attributes). An input field of "
                         "one of these names is not copied (a warning says so): on an earlier "
                         "line copy, its SRC_OID is replaced.",
            "out_report": "Optional Excel (.xlsx) or CSV report with Summary and Detail sheets "
                          "(X and Y in the measuring system).",
            "error_count": "Number of error points written (derived).",
        },
        "tags": ["network", "topology", "dangle", "pseudo-node", "connectivity", "basic"],
    }

    def __init__(self):
        self.label = "Line Network Rule Check"
        self.description = ("Dangles, pseudo-nodes, T-misses, point-on-line rules and "
                            "connected components of a line network on a Basic licence (v"
                            + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_lines", "Input Lines", "GPFeatureLayer", value_list=["Polyline"]),
            make_param("snap_tolerance_m", "Snap Tolerance (m)", "GPDouble", required=False,
                       default=0.001),
            make_param("checks", "Checks", "GPString", required=False, multi_value=True,
                       value_list=list(NETWORK_CHECKS), default=list(NETWORK_DEFAULT_CHECKS)),
            make_param("pseudo_node_fields", "Pseudo-node Fields", "Field", required=False,
                       multi_value=True, depends_on="in_lines"),
            make_param("t_distance_m", "T Distance (m)", "GPDouble", required=False, default=0.0),
            make_param("dangle_exempt_points", "Dangle Exempt Points", "GPFeatureLayer",
                       required=False, value_list=["Point", "Multipoint"]),
            make_param("rule_points", "Rule Points", "GPFeatureLayer", required=False,
                       value_list=["Point"]),
            make_param("point_rule", "Point Rule", "GPString", required=False,
                       value_list=list(NETWORK_POINT_RULES), default="ON_LINE"),
            make_param("out_errors", "Output Error Points", "DEFeatureClass", direction="Output"),
            make_param("out_lines", "Output Lines with Components", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("error_count", "Error Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        bad_distance = False
        for name, label in _NET_DISTANCES:
            value = p[name].value
            problem = network_distance_problem(label, None if value == "" else value)
            if problem:
                bad_distance = True
                p[name].setErrorMessage(problem)
        checks = [c.upper() for c in param_list(p["checks"])]
        t_value = p["t_distance_m"].value
        if "T_MISS" in checks and not bad_distance and (t_value is None or float(t_value) <= 0):
            p["t_distance_m"].setWarningMessage("T_MISS is checked but the T Distance is 0, so "
                                                "T_MISS will be skipped. Enter a distance.")
        if "POINT_RULE" in checks and p["rule_points"].value is None:
            p["rule_points"].setWarningMessage("POINT_RULE is checked but no Rule Points are "
                                               "given, so it will be skipped.")
        if p["dangle_exempt_points"].value is not None and checks and not _net_uses_exempt(
                checks, None if bad_distance else t_value):
            p["dangle_exempt_points"].setWarningMessage(_NET_EXEMPT_UNUSED)
        if p["rule_points"].value is not None and checks and "POINT_RULE" not in checks:
            p["rule_points"].setWarningMessage("POINT_RULE is not checked, so these points "
                                               "are ignored. Add POINT_RULE to Checks.")
        out_e, out_l = param_text(p["out_errors"]), param_text(p["out_lines"])
        if out_e and out_l and same_dataset(out_e, out_l):
            p["out_lines"].setErrorMessage("The line copy must be different from the error "
                                           "points output.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            # An arcpy error (e.g. while writing): the outputs it created were deleted
            # (_run); show what was collected (field matches, measuring system) first.
            flush_messages(collector)
            raise

    def _checks(self, p):
        checks = [c.upper() for c in param_list(p["checks"])] or list(NETWORK_DEFAULT_CHECKS)
        unknown = [c for c in checks if c not in NETWORK_CHECKS]
        if unknown:
            raise ToolError("Unknown check(s): {0}.".format(", ".join(unknown)),
                            "Choose checks from the list: {0}.".format(", ".join(NETWORK_CHECKS)))
        return [c for c in NETWORK_CHECKS if c in checks]

    def _read_points(self, layer, sr, label, allow_multi, collector, decision=None,
                     main_name=None):
        desc = describe_dataset(layer)
        for text in (further_input_sr_check(label, desc["sr"], decision, main_name),
                     datum_mismatch_warning(label, desc["sr"], decision)):
            if text:
                collector.warning(text)
        kind = kind_from_shape_type(desc["shape_type"])
        allowed = (GEOM_POINT, GEOM_MULTIPOINT) if allow_multi else (GEOM_POINT,)
        if kind not in allowed:
            raise ToolError("{0} must be point features.".format(label),
                            "Choose a point layer for {0}.".format(label))
        rows = read_features(desc["input"], sr=sr)
        nulls = [r["oid"] for r in rows if r["shape"] is None]
        if nulls:
            collector.warning("{0}: {1} point(s) without geometry were ignored: OID {2}.".format(
                label, len(nulls), analysis_oid_text(nulls)))
        return desc, kind, rows

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        checks = self._checks(p)
        tolerance = param_number(p["snap_tolerance_m"], 0.001)
        t_distance = param_number(p["t_distance_m"], 0.0)
        for (_name, label), value in zip(_NET_DISTANCES, (tolerance, t_distance)):
            problem = network_distance_problem(label, value)
            if problem:
                raise ToolError(problem, "Enter 0 or a distance in metres from 0.000000001 m "
                                         "(1 nanometre) to 10,000,000 m (10,000 km).")
        point_rule = (param_text(p["point_rule"]) or "ON_LINE").upper()
        if point_rule not in NETWORK_POINT_RULES:
            raise ToolError("Unknown point rule '{0}'.".format(point_rule),
                            "Choose ON_LINE or ON_ENDPOINT.")
        out_errors, out_lines = param_text(p["out_errors"]), param_text(p["out_lines"])
        if out_lines and same_dataset(out_errors, out_lines):
            raise ToolError("The line copy and the error points have the same path.",
                            "Choose two different output names.")

        desc = describe_dataset(param_text(p["in_lines"]))
        if kind_from_shape_type(desc["shape_type"]) != GEOM_POLYLINE:
            raise ToolError("The input must contain lines.", "Choose a polyline layer.")
        inputs = [desc["catalog_path"]]
        if (desc["sr"] or {}).get("type") == "Geographic":
            crossing = antimeridian_crossings(read_features(desc["input"]))
            if crossing:
                raise ToolError(
                    "{0} line(s) cross the 180 degree meridian (the antimeridian): OID {1}. Lines "
                    "that cross +/-180 degrees are not supported: they would be measured the long "
                    "way round the earth and their ends reported as false dangles.".format(
                        len(crossing), analysis_oid_text(crossing)),
                    "Split those lines at +/-180 degrees, or project the data to a system "
                    "centred on the Pacific first (Project tool), or leave them out with a "
                    "selection or definition query.")
        decision, sr = metric_sr_or_native(desc)
        collector.info(decision["reason"])
        zones = decision.get("utm_zones") or 0
        if decision.get("reproject") and zones > _NET_MAX_UTM_ZONES:
            # One plane is needed for the snap tolerance; this far from its central
            # meridian a UTM zone is more than ~15 % off in scale and lines may collapse
            # or not project at all (wrongly reported as zero-length, false dangles).
            raise ToolError(
                "The lines span {0} UTM zones, too wide for the one projected system "
                "(WKID {1}) the network is checked in: far from its centre the scale is "
                "more than about 15 % off, and some lines may not project at all.".format(
                    zones, decision["wkid"]),
                "Project the lines to a system suited to their whole extent first (Project "
                "tool), or check a smaller area at a time (use a selection).")
        for text in decision["warnings"]:
            collector.warning(text)
        measure_sr = sr if sr is not None else desc["sr_object"]
        mpu = decision["meters_per_unit"]

        pseudo_names = []
        for wanted in param_list(p["pseudo_node_fields"]):
            field, how = match_field(desc["fields"], wanted, label="pseudo-node field",
                                     exact_name_first=True)
            collector.info(match_message(wanted, field, how))
            if field["name"] not in pseudo_names:
                pseudo_names.append(field["name"])

        # Densified in the input's own system before projecting (straight segments stay
        # straight). Only distances use these vertices; nodes are the line ends.
        lines, _none = read_features_densified(desc["input"], pseudo_names, sr=sr,
                                               step=densify_step_for(desc, decision),
            geographic=(desc["sr"] or {}).get("type") == "Geographic")
        collector.info("{0} line(s) read.".format(len(lines)))
        units_known = not sr_is_unknown(desc["sr"])
        if not units_known:
            self._refuse_degrees(lines)
        if sr is not None:
            self._refuse_unprojectable(desc, decision, lines)
        want_components = ("COMPONENTS" in checks) or bool(out_lines)
        true_lengths = None
        gcs = analysis_remeasure_gcs(desc["sr"], decision)
        if gcs:
            true_lengths = self._true_lengths(desc, gcs, decision, collector) \
                if want_components else None
            polar = decision.get("polar") or (not decision.get("reproject")
                                              and (desc["sr"] or {}).get("polar_stereographic"))
            collector.warning(
                "The network is checked in one plane, WKID {0}, whose scale is not 1 over this "
                "data ({1}). {2}The Snap Tolerance, the T Distance and the Rule Point distances "
                "(VALUE) are applied in that plane, so they are off by the same scale error "
                "where the data is far from its true scale. For exact distances project the "
                "input to a projected metric system suited to its area first, or check smaller "
                "areas at a time.".format(
                    decision.get("wkid"),
                    "polar data: up to 2.7 % short near the pole" if polar else
                    "data across {0} UTM zones".format(decision.get("utm_zones")),
                    "COMP_LENGTH_M is measured on each line's own projection, so it is in true "
                    "metres. " if want_components else ""))

        exempt = []
        exempt_layer = param_text(p["dangle_exempt_points"])
        if exempt_layer and not _net_uses_exempt(checks, t_distance):
            # still read: the layer stays an input that no output may replace
            collector.warning("Dangle Exempt Points were ignored: " + _NET_EXEMPT_UNUSED)
        if exempt_layer:
            edesc, ekind, erows = self._read_points(exempt_layer, measure_sr,
                                                    "Dangle Exempt Points", True, collector,
                                                    decision, (desc["sr"] or {}).get("name"))
            inputs.append(edesc["catalog_path"])
            for r in erows:
                exempt.extend(iter_points(ekind, r["shape"]))

        rule_rows, points_desc = [], None
        rule_layer = param_text(p["rule_points"])
        if "T_MISS" in checks and t_distance <= 0:
            collector.warning("T_MISS was skipped: the T Distance is 0. Enter a T Distance above 0 to check it.")
        if "POINT_RULE" in checks and not rule_layer:
            collector.warning("POINT_RULE was skipped: no Rule Points were given. Add a Rule Points layer to check it.")
        if rule_layer:
            points_desc, _k, prow = self._read_points(rule_layer, measure_sr, "Rule Points",
                                                      False, collector, decision,
                                                      (desc["sr"] or {}).get("name"))
            inputs.append(points_desc["catalog_path"])
            if "POINT_RULE" in checks:
                rule_rows = [(r["oid"], r["shape"]) for r in prow]
            else:
                collector.warning("Rule Points were ignored: POINT_RULE is not in Checks. Add POINT_RULE to Checks to use them.")

        check_output_path(out_errors, inputs)      # all outputs before the main work
        if out_lines:
            check_output_path(out_lines, inputs)
        progress = Progress("Checking the line network", 0)
        result = analyse_network(
            [(r["oid"], r["shape"]) for r in lines], tolerance, checks,
            attrs=(dict((r["oid"], tuple(r["attrs"][n] for n in pseudo_names)) for r in lines)
                   if pseudo_names else None),
            t_distance_m=t_distance, exempt_points=exempt, rule_points=rule_rows,
            point_rule=point_rule, meters_per_unit=mpu,
            want_components=want_components, lengths_m=true_lengths)
        progress.close()
        errors = result["errors"]
        problem = tolerance_problem(result, tolerance, units_known)
        if problem:
            collector.warning(problem)
        unsplit = unsplit_problem(result)
        if unsplit:
            (collector.warning if unsplit[1] else collector.info)(unsplit[0])

        names = {NETWORK_LINES: desc["name"]}
        if points_desc is not None:
            names["points"] = points_desc["name"]
        err_oid_spec = _net_oid_spec(out_errors, [e["oid"] for e in errors], "error points",
                                     collector)
        specs = [{"name": "RULE", "type": "TEXT", "length": 24},
                 # The values go with the width: common.arcio then sizes the
                 # field in UTF-8 bytes for a shapefile/dBASE output (an Arabic letter takes
                 # 2; Pro cuts a longer value without a word) and in UTF-16 units elsewhere.
                 {"name": "LAYER", "type": "TEXT",
                  "length": max([text_field_length(list(names.values()), 32)]
                                + [_arcio_utf16_units(n) for n in names.values()]),
                  "values": list(names.values())},
                 # the toolkit's one ObjectID field rule (lines or rule points)
                 err_oid_spec,
                 {"name": "NODE_ID", "type": "LONG"},
                 # LONG, not SHORT: a WIDE_NODE_CLUSTER writes its full end count here, and at a
                 # too-large tolerance one node can merge more than 32,767 ends (a 100 x 100 grid of
                 # 20 m roads at 25 m gave 40,400), which a Short Integer field cannot hold.
                 {"name": "DEGREE", "type": "LONG"},
                 {"name": "VALUE", "type": "DOUBLE"},
                 {"name": "DETAIL", "type": "TEXT",
                  "length": text_field_length([e["detail"] for e in errors], 50),
                  "values": [e["detail"] for e in errors]}]
        wanted_errors = [s["name"] for s in specs]
        try:
            specs, _r = plan_output_fields(out_errors, specs, fixed=len(specs))
        except ToolError as err:
            if not str(err.cause).startswith("Field 'LAYER'"):
                raise
            raise ToolError("The LAYER field of the error points holds the name of the input "
                            "dataset ('{0}'), which is too long for a shapefile or dBASE text "
                            "field: {1}".format("', '".join(names.values()), err.cause),
                            "Write the error points to a file geodatabase, or give the input "
                            "dataset a shorter name.")
        renamed_text = network_renamed_fields_text(out_errors, wanted_errors, specs)
        if renamed_text:
            collector.warning(renamed_text)
        copy_plan = self._plan_lines(out_lines, desc, collector) if out_lines else None
        created = []
        try:
            path, fmap = create_feature_class(out_errors, GEOM_POINT, desc["sr_object"], specs,
                                              inputs=inputs)
            created.append(path)
            null_fields = set()
            insert_rows(path, [fmap[s["name"]] for s in specs],
                        [(e["point"], (e["rule"], names[e["role"]],
                                       oid_field_value(err_oid_spec, e["oid"]), e["node_id"],
                                       e["degree"], e["value"], e["detail"])) for e in errors],
                        kind=GEOM_POINT, wkid=decision["wkid"], null_fields=null_fields)
            collector.info("{0} error point(s) written to {1}.".format(len(errors), path))
            note = folder_null_number_warning(path, specs, fmap, null_fields,
                                              "The RULE column tells which fields apply to a "
                                              "point.")
            if note:
                collector.info(note)
            if out_lines:
                self._write_lines(out_lines, desc, result["components"], inputs + created,
                                  copy_plan, collector, created)
        except Exception:
            for done in created:  # never leave part of the outputs behind
                try:
                    safe_delete(done, inputs)
                except Exception:
                    pass
            raise

        for rule in sorted(set(e["rule"] for e in errors)):
            collector.info("{0}: {1}".format(rule, sum(1 for e in errors if e["rule"] == rule)))
        if result["component_count"]:
            collector.info("{0} connected component(s).".format(result["component_count"]))
        if result["zero_length"]:
            collector.warning("{0} line(s) have zero-length or single-vertex parts, which were "
                              "left out of the network: OID {1}. Repair or delete them.".format(
                                  len(result["zero_length"]),
                                  analysis_oid_text(result["zero_length"])))
        if result["null_geometry"]:
            collector.warning("{0} line(s) have no geometry: OID {1}. Repair or delete them."
                              .format(len(result["null_geometry"]),
                                      analysis_oid_text(result["null_geometry"])))

        summary = network_summary(result, checks, tolerance, len(lines))
        detail = [(e["rule"], names[e["role"]], network_report_oid(e["oid"]), e["node_id"], e["degree"], e["value"],
                   e["point"][0] if e["point"] else None, e["point"][1] if e["point"] else None,
                   e["detail"]) for e in errors]
        detail += [("ZERO_LENGTH_PART", desc["name"], network_report_oid(oid), None, None, None, None, None,
                    "Zero-length or single-vertex part left out of the network.")
                   for oid in result["zero_length"]]
        detail += [("NULL_GEOMETRY", desc["name"], network_report_oid(oid), None, None, None, None, None,
                    "No geometry.") for oid in result["null_geometry"]]
        if report:
            summary.append(("X/Y coordinate system", "WKID {0} (measuring system)".format(
                decision["wkid"])))
        for written in write_report(report, summary, _NET_DETAIL_HEADER, detail):
            collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "error_count", str(len(errors)))
        flush_messages(collector)

    def _refuse_degrees(self, lines):
        """Stop when the input's coordinate system is unknown (e.g. a shapefile without a .prj) and
        every coordinate fits longitude and latitude in degrees: the Snap Tolerance and T Distance
        would be applied in degrees (0.001 m as about 111 m) and the result would look clean."""
        box = network_degree_like(lines)
        if box is None:
            return
        raise ToolError(
            "The input lines have an unknown coordinate system (for example a shapefile without "
            "a .prj file), and all their coordinates lie within -180 to 180 (X) and -90 to 90 (Y) "
            "(X {0} to {1}, Y {2} to {3}): they look like longitude and latitude "
            "in degrees. The Snap Tolerance and the T Distance would then be applied in degrees "
            "(0.001 m as about 111 m), and the result would be wrong.".format(
                *network_extent_texts(box)),
            "Define the coordinate system of the input (Define Projection tool; for longitude "
            "and latitude usually GCS WGS 1984) and run the tool again. If the coordinates "
            "really are metres of a small local grid, define that projected coordinate system "
            "instead.")

    def _refuse_unprojectable(self, desc, decision, lines):
        """Stop when a line was destroyed by the projection to the measuring system
        (non-finite coordinates, or collapsed / empty while it has a length in its own
        system): reporting it as zero-length or without geometry names the wrong cause."""
        suspect = [r["oid"] for r in lines
                   if unprojectable_lines([(r["oid"], r["shape"])], {r["oid"]: None})
                   or not r["shape"] or any(len(pt) < 2 or not path_length(pt) > 0.0
                                            for pt in r["shape"])]
        if not suspect:
            return
        wanted = set(suspect)
        source = dict((r["oid"], r["shape"]) for r in read_features(desc["input"])
                      if r["oid"] in wanted)
        bad = unprojectable_lines([(r["oid"], r["shape"]) for r in lines
                                   if r["oid"] in wanted], source)
        if bad:
            raise ToolError(
                "{0} line(s) cannot be projected to the measuring coordinate system (WKID "
                "{1}), which is chosen from the centre of the data: OID {2}. The lines are "
                "spread too widely for one projected system.".format(
                    len(bad), decision["wkid"], analysis_oid_text(bad)),
                "Project the lines to a system suited to their whole extent first (Project "
                "tool), or check a smaller area at a time (use a selection).")

    def _true_lengths(self, desc, gcs, decision, collector):
        """``{oid: length in metres}``, each line measured on its own projection
        (``projection.local_tm_rows``) after reading it in the geographic system
        ``gcs`` (densified in its own system first)."""
        info = desc["sr"] or {}
        geographic = info.get("type") == "Geographic"
        geo_sr = desc["sr_object"] if geographic else arcpy.SpatialReference(gcs)
        rows, _none = read_features_densified(desc["input"], sr=geo_sr,
                                              step=densify_step_for(desc, {"reproject": True}),
                                              geographic=geographic)
        rows = local_tm_rows(rows, collector)[0]
        return dict((r["oid"], sum(path_length(pt) for pt in r["shape"] if len(pt) >= 2))
                    for r in rows if r["shape"])

    def _plan_lines(self, out_lines, desc, collector):
        """Read the lines for the copy and plan its fields before any output exists."""
        carry, skipped = analysis_carry_fields(desc["fields"], _NET_COMPONENT_FIELDS)
        if skipped:
            collector.warning(network_skipped_fields_text(skipped))
        rows = read_features(desc["input"], [f["name"] for f in carry])  # input system
        oid_spec = _net_oid_spec(out_lines, [r["oid"] for r in rows], "line copy", collector)
        specs = [dict(oid_spec), {"name": "COMPONENT_ID", "type": "LONG"},
                 {"name": "COMP_LINES", "type": "LONG"}, {"name": "COMP_LENGTH_M", "type": "DOUBLE"}]
        fixed = len(specs)
        specs += analysis_carry_specs(carry, lambda n: [r["attrs"][n] for r in rows],
                                      read_output_domains(out_lines))
        wanted = [s["name"] for s in specs]
        specs, renamed = plan_output_fields(out_lines, specs, fixed=fixed)
        for old, new in renamed:
            collector.info("Field {0} is called {1} in the line copy.".format(old, new))
        renamed_text = network_renamed_fields_text(out_lines, wanted, specs, renamed)
        if renamed_text:
            collector.warning(renamed_text)
        return rows, carry, specs, oid_spec

    def _write_lines(self, out_lines, desc, components, inputs, plan, collector, created):
        rows, carry, specs, oid_spec = plan
        path, fmap = create_feature_class(out_lines, GEOM_POLYLINE, desc["sr_object"], specs,
                                          inputs=inputs)
        created.append(path)  # deleted by _run if a later step fails
        out_rows = []
        for r in rows:
            comp = components.get(r["oid"], (None, None, None))
            values = [oid_field_value(oid_spec, r["oid"]), comp[0], comp[1], comp[2]] + [r["attrs"][f["name"]] for f in carry]
            out_rows.append((r["shape"], values))
        wkid = desc["sr"]["wkid"] if desc["sr"] else None
        null_fields = set()
        insert_rows(path, [fmap[s["name"]] for s in specs], out_rows, kind=GEOM_POLYLINE,
                    wkid=wkid, null_fields=null_fields)
        collector.info("{0} line(s) with component IDs written to {1}.".format(len(out_rows), path))
        note = folder_null_number_warning(
            path, specs, fmap, null_fields,
            "Components are numbered from 1, so COMPONENT_ID 0 marks a line left out of the "
            "network (no geometry or zero length).")
        if note:
            collector.info(note)
        lost = lost_domain_warning(specs, path)
        if lost:
            collector.warning(lost)
        return path


# ==========================================================================
# analysis/vertex_tool.py
# ==========================================================================
# Vertex Extractor: the ArcGIS Pro tool (adapter).

_VX_FIELDS = ("SRC_OID", "PART", "RING", "IDX", "IDX_NEG", "DIST_ALONG", "TURN_DEG", "X", "Y")
# Appended to a copied text value cut to fit a shapefile (254 bytes in UTF-8); ASCII, 9 bytes.
VX_CUT_MARK = " ...[cut]"
# Field types that are never copied (system fields); any other input field that the shared
# carry list cannot add is named in a warning (TimeOnly, TimestampOffset, Blob, ...).
_VX_SYSTEM_TYPES = ("OID", "Geometry", "GlobalID")
_VX_GUID_TEXT_LENGTH = 38           # "{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
_VX_BIG_INTEGER_TEXT_LENGTH = 20    # "-9223372036854775808"
_VX_USED_AS_IS = "The input is already projected"
WGS84_WKID = 4326


def vx_shortened_field_names(carry, carried_specs, fmap, renamed):
    """``[(input name, output name)]`` for every copied field whose output name differs from its
    input name and that no collision message has named yet (``renamed`` from
    ``plan_output_fields``): a shapefile cuts names to 10 bytes in UTF-8 without a word, so an
    Arabic name keeps at most 5 letters. ``fmap`` is the {spec name: created name} mapping."""
    announced = set(old for old, _new in renamed)
    out = []
    for field, spec in zip(carry, carried_specs):
        actual = fmap.get(spec["name"], spec["name"])
        if field["name"] in announced or actual == field["name"]:
            continue
        out.append((field["name"], actual))
    return out


def vx_not_copied_fields(fields, carry, skipped_names):
    """Editable input fields that Copy Attributes cannot copy (type not supported by the
    output), as ``[(name, type), ...]``; system fields and name clashes are not listed."""
    carried = set(f["name"] for f in carry) | set(skipped_names)
    return [(f["name"], f["type"]) for f in fields
            if f.get("editable", True) and f["type"] not in _VX_SYSTEM_TYPES
            and f["name"] not in carried]


def vx_folder_specs(specs, rows, fixed):
    """Adapt copied field specs to a shapefile, whose dBASE table has no GUID, Date Only or
    Big Integer type (ArcGIS Pro 3.3.2 refused to add such a field to a new shapefile with
    ERROR 003738, "The data type is not supported by the workspace", and the run stopped):

    * GUID -> TEXT of 38 characters;
    * Date Only -> DATE (a dBASE date holds the date only, so nothing is lost); each value
      becomes the same day at 00:00, in place in ``rows``;
    * Big Integer -> TEXT of 20 characters, every digit kept; each value becomes its decimal
      text, in place in ``rows``. ArcGIS Pro 3.3.2 stores Big Integer values only up to 53 bits
      (an insert of 2^53 + 1 fails with "Big integer values are currently limited to 53 bits."
      in the BilingualNameQA Pro log; this tool's Pro job inserts the two limit values
      +/-(2^53 - 1) in section 6d, and its section 6i tries 2^53 + 1; this tool's Pro log
      shows the same refusal there), so no Pro value is rounded by a double. The text keeps
      the field a whole number with its exact digits and sign (at most 17 characters).

    Returns ``(guid_names, timed_date_names, date_only_names, big_integer_names)``; the
    second lists copied Date fields with a time of day, which a dBASE date does not hold."""
    guids, timed, date_only, bigs = [], [], [], []
    for spec in specs[fixed:]:
        name = spec["name"]
        values = [r["attrs"].get(name) for r in rows]
        if spec["type"] == "GUID":
            spec["type"] = "TEXT"
            spec["length"] = _VX_GUID_TEXT_LENGTH
            spec["values"] = [v for v in values if v is not None]
            guids.append(name)
        elif spec["type"] == "DATEONLY":
            spec["type"] = "DATE"
            for r in rows:
                v = r["attrs"].get(name)
                if isinstance(v, datetime.date) and not isinstance(v, datetime.datetime):
                    r["attrs"][name] = datetime.datetime(v.year, v.month, v.day)
            date_only.append(name)
        elif spec["type"] == "BIGINTEGER":
            spec["type"] = "TEXT"
            spec["length"] = _VX_BIG_INTEGER_TEXT_LENGTH
            for r in rows:
                v = r["attrs"].get(name)
                if v is not None:
                    r["attrs"][name] = str(int(v))
            spec["values"] = [r["attrs"][name] for r in rows if r["attrs"].get(name) is not None]
            bigs.append(name)
        elif spec["type"] == "DATE":
            if any(isinstance(v, datetime.datetime) and v.time() != datetime.time(0, 0)
                   for v in values):
                timed.append(name)
    return guids, timed, date_only, bigs


def vx_sref_json(sr_object, wkid):
    """Esri JSON ``spatialReference`` of a system: its WKID, or, for a system defined only by
    its text (a custom projection, or a .prj that ArcGIS Pro does not match to a WKID: factory
    code 0), its WKT (the part of ``exportToString`` before the first ";", which holds the
    tolerances). ``None`` when neither is known."""
    if wkid:
        return {"wkid": int(wkid)}
    try:
        text = sr_object.exportToString()
    except Exception:
        return None
    wkt = str(text or "").split(";")[0].strip()
    return {"wkt": wkt} if wkt else None


def vx_probe_distortion(rows, sr_object, wkid, mpu):
    """``vertex_scale_distortion`` of the projected input system at sample vertices of
    ``rows``: each sample and the points 100 m east and north of it (in the system) are
    projected to the system's geographic coordinate system (WGS 84 when that one has no
    WKID; for measuring, a datum shift of a few hundred metres does not matter). A system
    without a WKID is given by its WKT (``vx_sref_json``). Returns
    ``(distortion, geographic system)``; ``distortion`` is ``None`` when the system is not
    known at all or no sample could be projected."""
    sref = vx_sref_json(sr_object, wkid)
    if sref is None or not mpu:
        return None, None
    try:
        gcs = sr_object.GCS
        gcs_code = gcs.factoryCode
    except Exception:
        gcs_code = 0
    if not gcs_code:
        gcs = arcpy.SpatialReference(WGS84_WKID)
    d = VX_PROBE_OFFSET_M / float(mpu)
    samples = []
    for x, y in vertex_probe_points([r["shape"] for r in rows]):
        coords = [[x, y], [x + d, y], [x, y + d]]
        try:
            shape = arcpy.AsShape({"points": coords, "spatialReference": dict(sref)},
                                  True).projectAs(gcs)
            pts = [(float(c[0]), float(c[1])) for c in json.loads(shape.JSON).get("points", [])]
        except Exception:   # a point outside the system's domain: leave this sample out
            continue
        if len(pts) == 3:
            samples.append((pts[0], pts[1], pts[2], VX_PROBE_OFFSET_M))
    return vertex_scale_distortion(samples), gcs


def _vx_system_key(sr):
    """(factory code, name) of a spatial reference, for comparing two of them."""
    try:
        code = int(getattr(sr, "factoryCode", 0) or 0)
    except (TypeError, ValueError):
        code = 0
    try:
        name = str(getattr(sr, "name", "") or "")
    except Exception:
        name = ""
    return code, name


def vx_dataset_system_clash(out_path, sr_object):
    """Name of the coordinate system of the feature dataset that ``out_path`` is written
    into, when it differs from ``sr_object`` (the input's); else ``None``.

    A feature class in a feature dataset always takes the dataset's coordinate system, so
    the points would be projected on insert while X and Y stay in the input system: the
    run is refused instead. Not in a feature dataset, or nothing readable: ``None``."""
    text = str(out_path or "").rstrip("\\/")
    parent = split_catalog_path(text)[0]
    if not parent or parent.rstrip("\\/") == str(workspace_of(text)).rstrip("\\/"):
        return None
    try:
        d = arcpy.da.Describe(parent)
    except Exception:
        return None
    if str(d.get("dataType") or "") != "FeatureDataset":
        return None
    dsr = d.get("spatialReference")
    if dsr is None or sr_object is None:
        return None
    dcode, dname = _vx_system_key(dsr)
    icode, iname = _vx_system_key(sr_object)
    if dcode and icode:
        same = dcode == icode
    else:
        same = dname.casefold() == iname.casefold()
    return None if same else (dname or str(dcode) or "unknown")


def vx_cut_folder_text(rows, carry, folder):
    """Cut every copied text value longer than a shapefile holds (254 bytes in UTF-8: an Arabic
    letter takes 2, a character above U+FFFF 6) at a character boundary, with ``VX_CUT_MARK``,
    in place in ``rows``; return ``[(field, count), ...]`` for the fields with a cut value.
    Outside a folder nothing is cut (a long value must not stop the run)."""
    cuts = []
    if not folder:
        return cuts
    for f in carry:
        counter = [0]
        for r in rows:
            value = r["attrs"].get(f["name"])
            if isinstance(value, str):
                r["attrs"][f["name"]] = cut_utf8_bytes(value, True, counter, VX_CUT_MARK)
        if counter[0]:
            cuts.append((f["name"], counter[0]))
    return cuts


class VertexExtractor(object):
    """Vertices of lines and polygons as points, with index, distance along and turn angle."""

    DOC = {
        "summary": "Writes the vertices of line or polygon features as points, each with its "
                   "source ObjectID, part and ring number, index from the start and from the "
                   "end (IDX 0 = first vertex, IDX_NEG -1 = last vertex), distance along the "
                   "part or ring in metres and the signed turning angle in degrees. Extract "
                   "every vertex or only chosen positions such as the first and last "
                   "(\"0,-1\"). Designed for a Basic licence: no Standard or Advanced tool is used.",
        "usage": "Vertices: ALL (or empty), or a list of whole numbers such as 0,-1,2. A "
                 "comma, semicolon, space or the Arabic comma and semicolon separate items; a "
                 "minus sign pasted from a document is accepted, and invisible marks pasted "
                 "with Arabic text (right-to-left mark, zero-width space and similar) are "
                 "ignored. Write plain digits: 1,000 is refused (it would be two items), and so "
                 "are leading zeros and 1_0. A list such as 1,250 or 1 250 (a space or no-break "
                 "space as the thousands separator) is read as vertices 1 and 250, with a "
                 "warning; a first group that starts with 0, as in 0,100, is a plain list and "
                 "gets no warning. A value with no number in it is refused; write ALL in Latin "
                 "letters for every vertex. Negative indexes count from the end of each part or "
                 "ring (-1 = last vertex). An index that does not exist in a part or ring is "
                 "skipped there; a message names each such index and the number of parts "
                 "(lines) or rings (polygons, holes included) that lack it, for example "
                 "\"Index 5 does not exist in 1000 of 1000 ring(s)\".\n\n"
                 "Lines: every path is a part (PART 1-based, RING empty). A closed line keeps "
                 "its start and end vertex. TURN_DEG is empty at both ends of a line.\n\n"
                 "Polygons: PART is 1-based, in the order the outer rings are stored; RING is "
                 "0-based within the part (0 = outer ring, 1, 2, ... = holes). Polygons are read "
                 "as stored and not repaired: in a polygon that is not simple (for example an "
                 "outer ring stored counter-clockwise) a hole can be numbered as a part of its "
                 "own, after all clockwise outer rings; run Repair Geometry first on such data. "
                 "The closing vertex is not written twice; the turning angle at vertex 0 uses "
                 "the last vertex as its predecessor. A closing vertex stored twice is written "
                 "once more, as the last vertex, with an empty TURN_DEG, and vertex 0 then has "
                 "an empty TURN_DEG too. Outer rings run clockwise, so convex corners have "
                 "negative (right) turns.\n\nTURN_DEG: change of direction in degrees, "
                 "positive = left turn, 0 = straight on, empty where a neighbouring segment has "
                 "zero length (duplicate vertex).\n\n"
                 "A shapefile cannot store an empty number: in a folder output empty TURN_DEG "
                 "and RING values are stored as 0, and the run warns about it. Use a file "
                 "geodatabase output to keep them empty.\n\n"
                 "Distances and angles are measured in metres in a projected system chosen "
                 "from the data: the input system when it is projected and measures true "
                 "metres where the data is, else the matching UTM zone (on the input's own "
                 "datum when EPSG defines one, else the WGS 84 zone with a warning that no "
                 "datum transformation is applied). A projected input is tested at sample "
                 "vertices spread over the whole layer (in each of 16 x 16 cells of its extent "
                 "that holds data), so features far from the others are tested too: when one unit of it is more than 0.5 % away from a metre on the "
                 "ground, or it bends angles by more than 0.5 degrees (world systems such as "
                 "Mollweide, Plate Carree, Equidistant Cylindrical or Robinson, or a regional "
                 "system used far from its area), each feature is measured on its own "
                 "Transverse Mercator projection instead, and a message says so. A projected "
                 "system without a WKID (a custom projection) is tested through its WKT; if no "
                 "sample can be projected, it is used as is with a warning. Web Mercator "
                 "inputs are re-projected to the UTM zone. The chosen UTM zone of a "
                 "geographic or Web Mercator input is tested the same way, so a feature near "
                 "the edge of a layer two or three zones wide (where one UTM zone measures up "
                 "to about 1 % long) is measured feature by feature too. Geographic (or Web "
                 "Mercator) data wider than 3 UTM zones, polar data (beyond 84N / 80S) and input in a polar "
                 "stereographic system are also measured feature by feature (Transverse "
                 "Mercator centred on the feature, or polar stereographic with true scale at "
                 "the feature; WGS 84 ellipsoid). A feature that cannot be projected is skipped "
                 "with a warning. The points, X and Y are in the input coordinate system; an "
                 "output in a feature dataset with another coordinate system is refused. "
                 "Features with true curves are skipped and listed. Z and M values are "
                 "dropped.\n\n"
                 "Copy Attributes: a copied field keeps its field-level domain when the output "
                 "geodatabase has it (a warning names the fields that lose it); subtypes are "
                 "not carried. Fields of a type the tool cannot create (for example Time Only, "
                 "Timestamp Offset, Blob, Raster) are not copied, and a warning names them. In a "
                 "shapefile output a GUID field is written as text of 38 characters, a Big "
                 "Integer field as text of 20 characters (every digit kept) and a Date Only "
                 "field as a date field, with a message for each; a warning names copied date "
                 "fields whose time of day may be lost. A shapefile "
                 "text field holds at most 254 bytes in UTF-8 (an Arabic letter takes 2 bytes, "
                 "so about 127 Arabic letters); a longer copied value is cut at a character "
                 "boundary and ends with ' ...[cut]', and a warning counts the cut values per "
                 "field; use a file geodatabase output to keep the full text. A shapefile "
                 "field name holds at most 10 bytes (5 Arabic letters): a message lists every "
                 "copied field whose name is cut or changed in the output.\n\n"
                 "Selections and definition queries on the input layer are honoured. The input "
                 "is never edited. If an arcpy error stops the run while the output is written, "
                 "the output this run created is deleted and the messages collected so far are "
                 "shown before the error.\n\n"
                 "Built-in alternatives: Feature Vertices To Points needs an Advanced licence. "
                 "On Basic, Add Geometry Attributes (LINE_START_MID_END) and Generate Points "
                 "Along Lines give start, middle and end points but not every vertex with its "
                 "index and angle. Outside Esri's tools, QGIS (Extract specific vertices; its angle "
                 "is the bisector angle at the vertex, not a signed turn) and the "
                 "free npGeom toolbox for ArcGIS Pro (Vertices to points) exist too, and the paid "
                 "XTools Pro add-in (Convert Features to Points, All points; an ID field only).",
        "params": {
            "in_features": "Line or polygon features.",
            "vertices": "ALL, or whole numbers such as 0,-1 (first and last). Write plain digits: 1,000 is refused.",
            "out_features": "Output point feature class: SRC_OID, PART, RING, IDX, IDX_NEG, "
                            "DIST_ALONG (m), TURN_DEG, X, Y.",
            "copy_attributes": "Also copy the input attributes to every vertex point.",
            "vertex_count": "Number of vertex points written (derived).",
        },
        "tags": ["vertices", "points", "angle", "index", "basic"],
    }

    def __init__(self):
        self.label = "Vertex Extractor"
        self.description = ("Writes line and polygon vertices as points with index, distance "
                            "along and turning angle, on a Basic licence (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_features", "Input Features", "GPFeatureLayer",
                       value_list=["Polyline", "Polygon"]),
            make_param("vertices", "Vertices", "GPString", required=False, default="ALL"),
            make_param("out_features", "Output Vertex Points", "DEFeatureClass",
                       direction="Output"),
            make_param("copy_attributes", "Copy Attributes", "GPBoolean", required=False,
                       default=False),
            derived_output("vertex_count", "Vertex Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        try:
            parse_vertex_list(param_text(p["vertices"]))
        except ValueError as exc:
            p["vertices"].setErrorMessage("Use ALL or whole numbers separated by commas, such "
                                          "as 0,-1 ({0}).".format(exc))
            return
        hint = vertex_list_thousands_hint(param_text(p["vertices"]))
        if hint:
            p["vertices"].setWarningMessage(hint)
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            # An arcpy error (e.g. while writing): the output it created was deleted
            # (_run); show what was collected (features read, measuring system) first.
            flush_messages(collector)
            raise

    def _write(self, path, fmap, specs, rows, metric, sr, kind, indexes, plan, carry, desc):
        """Write the vertex points to ``path``; return (count, null_fields, state)."""
        state = {"skipped": 0, "tally": {"units": 0, "missing": {}}, "nulls": [], "failed": [],
                 "mismatch": [], "unprojected": []}
        progress = Progress("Extracting vertices", len(rows))

        def records():
            for row in rows:
                progress.tick()
                if row["shape"] is None:
                    state["nulls"].append(row["oid"])
                    continue
                mgeom = metric.get(row["oid"]) if sr is not None else row["shape"]
                if mgeom is None:          # not projectable: never measure in degrees
                    state["unprojected"].append(row["oid"])
                    continue
                try:
                    recs, missing = extract_vertices(kind, row["shape"], mgeom, indexes,
                                                     plan["mpu"], tally=state["tally"])
                except VertexCountMismatch as exc:
                    state["mismatch"].append((row["oid"], str(exc)))
                    continue
                except (ValueError, IndexError, KeyError, TypeError, ZeroDivisionError) as exc:
                    state["failed"].append((row["oid"], str(exc)))
                    continue
                state["skipped"] += missing
                extra = [row["attrs"][f["name"]] for f in carry]
                for r in recs:
                    yield ((r["x"], r["y"]),
                           [oid_field_value(specs[0], row["oid"]), r["part"], r["ring"], r["idx"], r["idx_neg"], r["dist_m"],
                            r["turn"], r["x"], r["y"]] + extra)

        wkid = desc["sr"]["wkid"] if desc["sr"] else None
        null_fields = set()
        count = insert_rows(path, [fmap[s["name"]] for s in specs], records(), kind=GEOM_POINT,
                            wkid=wkid, null_fields=null_fields)
        progress.close()
        return count, null_fields, state

    def _world_projection_plan(self, plan, decision, desc, rows, measuring):
        """A projected input used as is is first probed at the data. When its scale
        is off by more than 0.5 % or it bends angles by more than 0.5 degrees (world
        systems such as Mollweide, Plate Carree, Equidistant Cylindrical or Robinson, or a
        regional system used far from its area), the input is read in its geographic
        coordinate system and each feature is measured on its own Transverse Mercator,
        as for wide data. A system without a WKID is probed through its WKT. When no sample
        of a layer with coordinates can be projected, the system is used as is with a warning
        that it could not be tested. Returns the plan to use (``plan`` itself when nothing
        changes)."""
        info = desc["sr"] or {}
        if plan["local"] or info.get("type") != "Projected" \
                or plan["read_sr"] is not desc["sr_object"] or (decision or {}).get("empty"):
            return plan
        distortion, gcs = vx_probe_distortion(rows, desc["sr_object"], info.get("wkid"),
                                              plan["mpu"])
        if distortion is None and vertex_probe_points([r["shape"] for r in rows]):
            measuring.items = [m for m in measuring.items if not m[1].startswith(_VX_USED_AS_IS)]
            measuring.warning(
                "The input is in a projected system ({0}) whose scale where the data is could "
                "not be tested: no sample vertex could be projected to its geographic "
                "coordinate system. DIST_ALONG and TURN_DEG are measured in it as is; in a world "
                "system such as Mollweide or Robinson they can be several per cent off. Project "
                "the input to a system that measures true metres there (for example its UTM "
                "zone) to be sure.".format(info.get("name") or "unknown"))
            return plan
        if not vertex_distortion_too_large(distortion):
            return plan
        measuring.items = [m for m in measuring.items if not m[1].startswith(_VX_USED_AS_IS)]
        measuring.info(
            "The input is in a projected system ({0}) that does not measure true metres where "
            "the data is: one unit of it is {1:.4g} to {2:.4g} m on the ground and its axes "
            "are bent by up to {3:.2g} degrees (limits {4:g} % and {5:g} degrees). DIST_ALONG "
            "and TURN_DEG are therefore measured feature by feature, each on its own "
            "Transverse Mercator projection centred on the feature (WGS 84 ellipsoid), from "
            "the input read in {6}. The points, X and Y stay in the input system.".format(
                info.get("name") or "unknown", distortion["scale_min"], distortion["scale_max"],
                distortion["angle_error_deg"], VX_MAX_SCALE_ERROR * 100.0,
                VX_MAX_ANGLE_ERROR_DEG, gcs.name))
        return {"read_sr": gcs, "wkid": gcs.factoryCode, "mpu": 1.0, "local": True}

    def _utm_scale_plan(self, plan, decision, desc, measuring):
        """A geographic or Web Mercator input of up to three UTM zones is measured in the one
        UTM zone of the data's centre (shared ``projection.choose_metric_sr``). A feature
        near the edge of such a layer can lie 9 degrees from that zone's central meridian,
        where UTM lengths are about 1 % long. The chosen zone is therefore probed at the data
        like a projected input (``vx_probe_distortion``, the same samples and the same 0.5 %
        limit); beyond the limit the input is read in geographic degrees (its own geographic
        system, WGS 84 for Web Mercator) and each feature is measured on its own Transverse
        Mercator, as for wider data. Returns ``(plan, rows read in the UTM zone or None)``:
        the rows are reused when the zone is kept, so the input is not read twice."""
        info = desc["sr"] or {}
        decision = decision or {}
        if plan["local"] or decision.get("empty") or not decision.get("reproject") \
                or not decision.get("utm_zones") or plan["read_sr"] is desc["sr_object"]:
            return plan, None
        mrows, _mc = read_features_skip_curves(desc["input"], sr=plan["read_sr"])
        distortion, _gcs = vx_probe_distortion(mrows, plan["read_sr"], plan["wkid"],
                                               plan["mpu"] or 1.0)
        if not vertex_distortion_too_large(distortion):
            return plan, mrows
        drop = set([decision.get("reason")] + list(decision.get("datum_warnings") or []))
        measuring.items = [m for m in measuring.items if m[1] not in drop]
        if info.get("type") == "Geographic":
            read_sr, wkid = desc["sr_object"], info.get("wkid")
            source = "its own geographic coordinates"
        else:
            read_sr, wkid = arcpy.SpatialReference(WGS84_WKID), WGS84_WKID
            source = "WGS 84 geographic coordinates"
        measuring.info(
            "The input ({0}) is not in a projected metric system. Its data spans {1} UTM "
            "zone(s), and on the one UTM zone of its centre (EPSG {2}) one metre of that zone "
            "is {3:.4g} to {4:.4g} m on the ground where the data is (limit {5:g} %). DIST_ALONG and TURN_DEG "
            "are therefore measured feature by feature, each on its own Transverse Mercator "
            "projection centred on the feature (WGS 84 ellipsoid), from the input read in {6}. "
            "The points, X and Y stay in the input system.".format(
                info.get("name") or "unknown", decision.get("utm_zones"), plan["wkid"],
                distortion["scale_min"], distortion["scale_max"], VX_MAX_SCALE_ERROR * 100.0,
                source))
        return {"read_sr": read_sr, "wkid": wkid, "mpu": 1.0, "local": True}, None

    def _run(self, parameters, p, collector):
        try:
            indexes = parse_vertex_list(param_text(p["vertices"]))
        except ValueError as exc:
            raise ToolError("The vertex list is not valid: {0}.".format(exc),
                            "Use ALL or whole numbers separated by commas, such as 0,-1.")
        hint = vertex_list_thousands_hint(param_text(p["vertices"]))
        if hint:
            collector.warning(hint)
        desc = describe_dataset(param_text(p["in_features"]))
        kind = kind_from_shape_type(desc["shape_type"])
        if kind not in (GEOM_POLYLINE, GEOM_POLYGON):
            raise ToolError("The input must contain lines or polygons.",
                            "Choose a line or polygon layer.")
        check_output_path(param_text(p["out_features"]), [desc["catalog_path"]])
        clash = vx_dataset_system_clash(param_text(p["out_features"]), desc["sr_object"])
        if clash:
            raise ToolError(
                "The output is in a feature dataset whose coordinate system ({0}) is not the "
                "input's ({1}). The points would be projected to the feature dataset's system "
                "while X and Y stay in the input system.".format(
                    clash, _vx_system_key(desc["sr_object"])[1] or "unknown"),
                "Write the output outside the feature dataset, or into a feature dataset with "
                "the input's coordinate system, or project the input first (Project tool).")
        # Wide (more than 3 UTM zones) or polar data: each feature is measured on its own
        # projection; the vertices are always written in the input system.
        measuring = MessageCollector()
        plan, decision = analysis_measuring(desc, metric_sr_or_native, measuring, "input",
                                            geographic_sr=arcpy.SpatialReference)
        carry, skipped_names, not_copied = [], [], []
        if param_bool(p["copy_attributes"], False):
            carry, skipped_names = analysis_carry_fields(desc["fields"], _VX_FIELDS)
            not_copied = vx_not_copied_fields(desc["fields"], carry, skipped_names)
        rows, curved = read_features_skip_curves(desc["input"], [f["name"] for f in carry])
        plan = self._world_projection_plan(plan, decision, desc, rows, measuring)
        plan, utm_rows = self._utm_scale_plan(plan, decision, desc, measuring)
        collector.extend(measuring)
        if skipped_names:
            collector.info("Input field(s) not copied because the output uses the name: "
                           "{0}.".format(", ".join(skipped_names)))
        if not_copied:
            collector.warning(
                "Input field(s) not copied because the tool cannot create their field type in "
                "the output: {0}. Copy them with a join on SRC_OID if you need them.".format(
                    ", ".join("{0} ({1})".format(n, t) for n, t in not_copied)))
        sr = None if plan["read_sr"] is desc["sr_object"] and not plan["local"] \
            else plan["read_sr"]
        metric = {}
        if sr is not None:
            if utm_rows is not None:
                mrows = utm_rows
            else:
                mrows, _mc = read_features_skip_curves(desc["input"], sr=sr)
            if plan["local"]:
                mrows = local_tm_rows(mrows, collector)[0]
            metric = dict((r["oid"], r["shape"]) for r in mrows)
        collector.info("{0} feature(s) read.".format(len(rows)))
        cuts = vx_cut_folder_text(rows, carry,
                                  is_folder_workspace(workspace_of(param_text(p["out_features"]))))
        if cuts:
            collector.warning(
                "A shapefile text field holds at most {0} bytes (UTF-8: an Arabic letter takes 2, "
                "an emoji 6), so longer copied values were cut at a character boundary and end "
                "with '{1}': {2} value(s) per field. Write the output to a file geodatabase to "
                "keep the full text.".format(SHAPEFILE_MAX_TEXT, VX_CUT_MARK.strip(),
                                             ", ".join("{0} ({1})".format(n, c) for n, c in cuts)))

        # SRC_OID: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``)
        specs = [oid_output_field(param_text(p["out_features"]), [r["oid"] for r in rows],
                                  collector), {"name": "PART", "type": "LONG"},
                 {"name": "RING", "type": "LONG"}, {"name": "IDX", "type": "LONG"},
                 {"name": "IDX_NEG", "type": "LONG"}, {"name": "DIST_ALONG", "type": "DOUBLE"},
                 {"name": "TURN_DEG", "type": "DOUBLE"}, {"name": "X", "type": "DOUBLE"},
                 {"name": "Y", "type": "DOUBLE"}]
        fixed = len(specs)
        specs += analysis_carry_specs(carry, lambda n: [r["attrs"][n] for r in rows],
                                      read_output_domains(param_text(p["out_features"])))
        if is_folder_workspace(workspace_of(param_text(p["out_features"]))):
            guids, timed, date_only, bigs = vx_folder_specs(specs, rows, fixed)
            if guids:
                collector.info("A shapefile has no GUID field type, so these GUID field(s) are "
                               "written as text of {0} characters: {1}.".format(
                                   _VX_GUID_TEXT_LENGTH, ", ".join(guids)))
            if date_only:
                collector.info("A shapefile has no Date Only field type, so these Date Only "
                               "field(s) are written as date fields (the date is kept): "
                               "{0}.".format(", ".join(date_only)))
            if bigs:
                collector.info("A shapefile has no Big Integer field type, so these Big Integer "
                               "field(s) are written as text of {0} characters, with every "
                               "digit kept: {1}. Write the output to a file geodatabase to "
                               "keep them as numbers.".format(_VX_BIG_INTEGER_TEXT_LENGTH,
                                                               ", ".join(bigs)))
            if timed:
                collector.warning("A shapefile date field holds the date only, so the time of "
                                  "day of these copied field(s) may be lost: {0}. Write the "
                                  "output to a file geodatabase to keep it.".format(
                                      ", ".join(timed)))
        specs, renamed = plan_output_fields(param_text(p["out_features"]), specs, fixed=fixed)
        for old, new in renamed:
            collector.info("Field {0} is called {1} in the output.".format(old, new))
        inputs = [desc["catalog_path"]]
        created = []
        try:
            path, fmap = create_feature_class(param_text(p["out_features"]), GEOM_POINT,
                                              desc["sr_object"], specs, inputs=inputs)
            created.append(path)
            count, null_fields, state = self._write(path, fmap, specs, rows, metric, sr, kind,
                                                    indexes, plan, carry, desc)
        except Exception:
            for done in created:  # never leave part of the output behind
                try:
                    safe_delete(done, inputs)
                except Exception:
                    pass
            raise
        collector.info("{0} vertex point(s) written to {1}.".format(count, path))
        cut_names = vx_shortened_field_names(carry, specs[fixed:], fmap, renamed)
        if cut_names:
            collector.info(
                "{0}these copied field(s) have another name in the output: {1}.".format(
                    "A shapefile field name holds at most 10 bytes (UTF-8: an Arabic letter takes "
                    "2, so 5 Arabic letters), so "
                    if is_folder_workspace(workspace_of(param_text(p["out_features"]))) else "",
                    ", ".join("{0} -> {1}".format(a, b) for a, b in cut_names)))
        if indexes is not None:
            # one line per requested index that is missing somewhere, counted in parts / rings
            # (review R14-1: the old count added up every part and ring that missed any index)
            for line in vertex_missing_messages(state["tally"], kind, indexes):
                collector.info(line)
        if state["nulls"]:
            collector.warning("{0} feature(s) have no geometry: OID {1}.".format(
                len(state["nulls"]), analysis_oid_text(state["nulls"])))
        if state["unprojected"]:
            collector.warning("{0} feature(s) could not be projected to the measuring "
                              "coordinate system and were skipped: OID {1}. Project the input "
                              "to a projected metric coordinate system suited to these "
                              "features first (Project tool), then run the tool again.".format(
                                  len(state["unprojected"]),
                                  analysis_oid_text(state["unprojected"])))
        if state["mismatch"]:
            collector.warning("{0} feature(s) were skipped because their copy in the measuring "
                              "coordinate system has another number of vertices than the input: "
                              "OID {1} (first: {2}). Project the input to a projected coordinate "
                              "system in metres suited to these features first (Project tool), "
                              "then run the tool again.".format(
                                  len(state["mismatch"]),
                                  analysis_oid_text([f[0] for f in state["mismatch"]]),
                                  state["mismatch"][0][1]))
        if state["failed"]:
            collector.warning("{0} feature(s) could not be processed and were skipped: OID {1} "
                              "(first cause: {2}). Run Repair Geometry on them, then run the "
                              "tool again.".format(len(state["failed"]),
                                                   analysis_oid_text([f[0] for f in state["failed"]]),
                                                   state["failed"][0][1]))
        note = folder_null_number_warning(
            path, specs, fmap, null_fields,
            "TURN_DEG 0 then also marks line ends and duplicate vertices (not only straight on), "
            "and RING 0 also marks line vertices (not only outer rings).")
        if note:
            collector.warning(note)
        lost = lost_domain_warning(specs, path)
        if lost:
            collector.warning(lost)
        if curved:
            collector.warning("{0} feature(s) with true curves were skipped: OID {1}. Densify "
                              "them first to extract their vertices.".format(
                                  len(curved), analysis_oid_text(curved)))
        set_derived_output(parameters, "vertex_count", str(count))
        flush_messages(collector)


# ==========================================================================
# analysis/thiessen_tool.py
# ==========================================================================
# Thiessen Polygons (Clipped): the ArcGIS Pro tool (adapter).

_TH_FIELDS = ("SITE_OID", "DUP_COUNT", "AREA_M2")
_TH_SHORT_MAX = 32767
_TH_MAX_UTM_ZONES = 10           # wider geographic data is refused (one plane is needed)
_TH_AREA_DENSIFY_M = 1000.0      # edge densify step before re-measuring AREA_M2 (wide/polar)
_TH_NOT_USER = ("shape_length", "shape_area", "shape_leng", "shape.starea()", "shape.stlength()")


def thiessen_geometry_field_names(path, names=()):
    """The casefolded names of the fields of ``path`` that ArcGIS Pro derives from the
    geometry (``Shape_Length``/``Shape_Area`` in a geodatabase), which are not user fields.

    Only the output's real length and area fields count (R6-D1): ``Describe`` gives
    ``lengthFieldName`` / ``areaFieldName`` (empty for a shapefile, which has none). When
    ``Describe`` cannot say, a field counts only when its name is one of the usual
    geometry names *and* ArcGIS Pro marks it as not editable. A name the tool itself added
    (``names``) never counts, so a carried user field such as ``Shape_Leng`` (left by
    exporting a polygon layer to a shapefile) is kept."""
    own = set(str(n).casefold() for n in names)
    found = None
    try:
        desc = arcpy.Describe(path)
        values = [getattr(desc, attr) for attr in ("lengthFieldName", "areaFieldName")]
        found = set(str(v).casefold() for v in values if v)
    except Exception:
        found = None
    if found is None:
        found = set(f.name.casefold() for f in arcpy.ListFields(path)
                    if f.name.casefold() in _TH_NOT_USER and not getattr(f, "editable", True))
    return found - own


def thiessen_stored_fields(path, names, fixed):
    """The field names ``path`` really has for the fields added as ``names`` (the names
    ``arcpy.ValidateFieldName`` predicted, in the order they were added), and the list of
    ``(predicted, stored)`` pairs that differ.

    The prediction is trusted when every name exists. Otherwise (for example a shapefile
    that cuts an Arabic name by bytes, not characters; R4-5) the added fields are the last
    ``len(names)`` user fields, in order, and are used when the first ``fixed`` of them (the
    tool's ASCII fields) match. Raises ``ToolError`` when the stored fields cannot be matched.
    Only the output's real geometry fields are left out of the user fields (R6-D1)."""
    geometry = thiessen_geometry_field_names(path, names)
    fields = [f for f in arcpy.ListFields(path)
              if f.type not in ("OID", "Geometry") and f.name.casefold() not in geometry]
    stored = [f.name for f in fields]
    have = set(n.casefold() for n in stored)
    if all(str(n).casefold() in have for n in names):
        return list(names), []
    tail = stored[-len(names):] if names else []
    if (len(tail) != len(names)
            or any(a.casefold() != str(b).casefold() for a, b in zip(tail[:fixed], names[:fixed]))):
        raise ToolError(
            "The output {0} does not have the fields the tool added under the expected names "
            "(expected {1}; stored {2}).".format(path, ", ".join(names), ", ".join(stored)),
            "Uncheck Copy Attributes, or rename the copied input fields to short names in "
            "Latin letters, and run the tool again.")
    return tail, [(a, b) for a, b in zip(names, tail) if a != b]


def thiessen_resolution(sr):
    """``sr.XYResolution`` (units of the system), or ``None`` when it cannot be read."""
    try:
        return float(sr.XYResolution)
    except Exception:
        return None


def thiessen_xy_tolerance(sr):
    """``sr.XYTolerance`` (units of the system), or ``None`` when it cannot be read."""
    try:
        return float(sr.XYTolerance)
    except Exception:
        return None


def thiessen_output_merge_distance(path, meters_per_unit=1.0, unknown=False):
    """The merge distance (``thiessen_merge_distance``) from the XY tolerance of the created output
    ``path`` (``Describe(path).spatialReference``), or ``None`` when neither its tolerance nor its
    resolution can be read (R9-D2: the XY Tolerance environment and a feature dataset set the
    output's tolerance, which can differ from the measuring system's)."""
    try:
        out_sr = arcpy.Describe(path).spatialReference
    except Exception:
        return None
    tol, res = thiessen_xy_tolerance(out_sr), thiessen_resolution(out_sr)
    if not ((tol is not None and tol > 0 and math.isfinite(tol))
            or (res is not None and res > 0 and math.isfinite(res))):
        return None
    return thiessen_merge_distance(tol, res, meters_per_unit, unknown)


def thiessen_sr_dict(sr):
    """``{"wkid", "name", "type"}`` of a ``SpatialReference`` (``None`` stays ``None``); each value
    that cannot be read is ``None`` (no other property is read)."""
    if sr is None:
        return None
    out = {}
    for key, attr in (("wkid", "factoryCode"), ("name", "name"), ("type", "type")):
        try:
            out[key] = getattr(sr, attr)
        except Exception:
            out[key] = None
    out["wkid"] = out["wkid"] or None
    return out


def thiessen_output_sr(path):
    """``thiessen_sr_dict`` of the created output ``path`` (``Describe(path).spatialReference``), or
    ``None`` when it cannot be read."""
    try:
        return thiessen_sr_dict(arcpy.Describe(path).spatialReference)
    except Exception:
        return None


def thiessen_sr_text(info):
    """``"name, WKID n"`` for a message (``"name"`` alone when there is no WKID)."""
    info = info or {}
    name = info.get("name") or "unnamed system"
    return "{0}, WKID {1}".format(name, info["wkid"]) if info.get("wkid") else str(name)


def thiessen_stored_problems(path, oid_field):
    """SITE_OIDs whose polygon, as ArcGIS Pro stored it, is not one ring (several parts, a hole,
    or empty). Pro rounds the vertices to the output's XY resolution and cleans the polygon with
    its XY tolerance when it stores it; this
    reads the stored shapes back (``SHAPE@JSON``) instead of trusting the computed cells."""
    bad = []
    with arcpy.da.SearchCursor(path, [oid_field, "SHAPE@JSON"]) as cursor:
        for oid, text in cursor:
            try:
                data = json.loads(text) if text else {}
            except ValueError:
                data = {}
            rings = data.get("rings") or data.get("curveRings") or []
            if len(rings) != 1:
                bad.append(oid)
    return sorted(bad, key=lambda v: (str(type(v)), v))


def thiessen_extent_numbers(text):
    """``(xmin, ymin, xmax, ymax)`` from extent text such as ``"0 0 10 10"``
    (anything after the first four numbers, e.g. a coordinate system, is
    ignored) or four numbers separated by commas (``"0, 0, 10, 10"``). A decimal
    comma (``"0,5 0 10 10"``) is refused: it used to be read as two numbers and gave
    another box without a message (round-10 review). Raises ``ToolError`` when the
    text cannot be read or has no area.

    Only reached when the parameter value is a ``str``. In ArcGIS Pro the GPExtent
    text is parsed by Pro before ``execute`` (dialog and arcpy script calls alike;
    Pro 3.3.2 read ``499990,5`` as 499990.5), so the tool gets an ``arcpy.Extent``."""
    raw = str(text or "")

    def numbers(parts):
        try:
            return [float(v) for v in parts]
        except ValueError:
            return None

    values = numbers(raw.split()[:4])
    if values is None or len(values) != 4:
        values = None
        parts = [p.strip() for p in raw.split(",")]
        if len(parts) == 4:
            values = numbers(parts)
    if values is None or len(values) != 4:
        decimal_comma = any(c == "," and raw[i - 1:i].isdigit() and raw[i + 1:i + 2].isdigit()
                            for i, c in enumerate(raw) if 0 < i < len(raw) - 1)
        raise ToolError("The Clip Extent '{0}' could not be read{1}.".format(
                            text, " (a comma between digits is not read as a decimal comma)"
                            if decimal_comma else ""),
                        "Enter the extent as four numbers with a decimal point: XMin YMin XMax "
                        "YMax, separated by spaces (or by commas).")
    return _thiessen_check_box(values)


def _thiessen_check_box(values):
    x0, y0, x1, y1 = values
    if not all(math.isfinite(v) for v in values):
        raise ToolError("The Clip Extent contains a number that is not finite (XMin {0}, YMin {1}, "
                        "XMax {2}, YMax {3}).".format(x0, y0, x1, y1),
                        "Enter the extent as four ordinary numbers: XMin YMin XMax YMax.")
    if not (x1 > x0 and y1 > y0):
        raise ToolError("The Clip Extent has no area (XMin {0}, YMin {1}, XMax {2}, YMax {3})."
                        .format(x0, y0, x1, y1), "Enter an extent with XMax > XMin and YMax > YMin.")
    return (x0, y0, x1, y1)


class ThiessenPolygonsConvex(object):
    """Exact vector Thiessen (Voronoi) polygons on a Basic licence."""

    DOC = {
        "summary": "Creates Thiessen (Voronoi) polygons from points: each polygon is the area "
                   "closer to its point than to any other point. The polygons are exact vector "
                   "cells clipped to a rectangle, a convex polygon or the points' extent "
                   "expanded by a percentage. Each polygon carries the source ObjectID, the "
                   "number of points at that location and its area in square metres. Works on "
                   "a Basic licence, no extension.",
        "usage": "In short: choose the point layer. With no clip, the polygons are cut at the "
                 "points' extent grown by Expand % (default 10 %), which leaves large cells at "
                 "the edge; to get your study area, give a Clip Extent, or one convex polygon "
                 "in Clip Features (for example a rectangle or a convex hull). The output is "
                 "written in the measuring system (see below: a projected input keeps its own "
                 "system and units, for example US feet) with SITE_OID, DUP_COUNT and AREA_M2 "
                 "(always square metres). Large "
                 "inputs take a while: roughly one minute for 50,000 points in the Python core "
                 "(not measured in Pro); the progress bar counts the kept point locations "
                 "(duplicates and merged points are not built).\n\n"
                 "Clip: give a Clip Extent or one convex Clip Feature (a single polygon "
                 "without holes, for example a rectangle or a convex hull), not both. Without "
                 "either, the points' bounding box is grown on each side by Expand % of its "
                 "width (left and right) and height (bottom and top); points on one straight "
                 "line use the other dimension; points almost on one line give a box "
                 "thinner than 1/1000 of its length, and a warning then says the polygons "
                 "are slivers (give a clip). Expand is at most 1,000,000 %, and a clip "
                 "(given or grown) larger than 100,000 km across is refused: the polygons "
                 "would lose precision. Concave clip polygons are not supported in "
                 "this version. Convexity is checked in the clip's own coordinate system: the "
                 "clip counts as convex when no vertex lies deeper inside its convex hull than "
                 "one millionth of its size (at least 0.5 mm, for coordinates rounded to the "
                 "geodatabase resolution), and it is then replaced by that hull; a clip in "
                 "another system than the measuring system is replaced by the convex hull of "
                 "its projected vertices. A Clip Extent without a coordinate system (typed as "
                 "four numbers) is taken in the input's coordinate system; an extent that "
                 "carries a coordinate system (for example one taken from a layer or the map "
                 "in the dialog) is projected from that system, and the rectangle around "
                 "its projected corners in the measuring system is used (an edge that "
                 "follows a parallel can bow outside it).\n\nPoints at the same "
                 "location are merged: the lowest ObjectID keeps the polygon (SITE_OID) and "
                 "DUP_COUNT counts all of them; the others are listed in a warning (at most "
                 "20 locations, largest first, and 20 merged OIDs per location). Points "
                 "outside the clip still shape their neighbours' polygons; a point whose "
                 "polygon lies completely outside the clip gets no polygon and is listed. "
                 "The cells are exact up to rounding: a polygon edge lies within about one "
                 "billionth of the clip size of the true bisector (0.1 mm in a 100 km clip). "
                 "ArcGIS Pro stores the vertices on the output's XY resolution grid (0.1 mm by "
                 "default) and cleans each polygon with the XY tolerance (1 mm by default): a "
                 "polygon less than about 3.5 XY tolerances wide is stored empty. So the points "
                 "are taken in ObjectID order and a point closer than ten times the XY "
                 "tolerance (1 cm by default) to a kept point is merged into the nearest kept "
                 "point like a duplicate (DUP_COUNT counts it, its attributes are not copied), "
                 "with a warning; such a point can lie a few millimetres inside a neighbouring "
                 "polygon. Every polygon is then at least 10 XY tolerances wide, except where "
                 "the clip cuts it. The tolerance is the one of the output as created: the XY "
                 "Tolerance environment or a feature dataset in the same coordinate system can "
                 "set it (the output is then built again with it, with a message). An output in "
                 "a feature dataset in another coordinate system than the measuring system is "
                 "refused and deleted: its XY tolerance would be in other units (for example "
                 "degrees) and ArcGIS Pro would project the polygons; write it outside the "
                 "feature dataset. In an unknown coordinate "
                 "system (for example a shapefile without a .prj) the unit is not known (it may "
                 "be degrees), so the merge distance is only 3.5 XY tolerances (0.0035 data "
                 "units by default) and the warning gives it in data units. The stored shapes "
                 "are read back and a polygon that is not one ring is named in a warning (this "
                 "can still happen for a point within a few millimetres of the clip edge, or "
                 "outside it); such a polygon is still counted in Polygon Count.\n\n"
                 "Polygons are built in a projected system chosen from the data (the input "
                 "system, in its own units such as US feet, when it is already projected, "
                 "else the matching UTM zone in metres"
                 "; for a geographic input on another datum than WGS 84, the UTM zone on "
                 "its own datum when EPSG defines one (for example Ain el Abd 1970 / UTM "
                 "zone 38N), else the WGS 84 UTM zone with a warning that no datum "
                 "transformation is applied (older datums such as NAD27 or ED50 can then "
                 "be offset by up to several hundred metres: project such data to a "
                 "projected metric system first)"
                 "; Web Mercator family inputs (e.g. WKID 3857), which distort "
                 "distances, are re-projected to the UTM zone too, and data near the "
                 "poles to a polar stereographic system), and "
                 "the output is written in that system and its units. AREA_M2 is always in "
                 "square metres, whatever the units of that system. For "
                 "geographic (or Web Mercator) data wider than 3 UTM zones, polar data "
                 "(beyond 84N / 80S) and input in a polar stereographic system, whose scale "
                 "is not 1 over the data, the polygons are still built in that one system, "
                 "but AREA_M2 is measured polygon by polygon on its own projection "
                 "(Transverse Mercator centred on it, or polar stereographic with true scale "
                 "at it near the poles; WGS 84 ellipsoid). Data wider than 10 UTM zones, "
                 "and points that cannot be projected to the system, stop the run with a "
                 "fix (project the points to a system suited to their extent first). Between "
                 "4 and 10 UTM zones the polygon edges are the bisectors in that one system "
                 "(a message says so).\n\nSpeed: many points spaced evenly on one circle "
                 "(co-circular) are slow, because every such point is a neighbour of every "
                 "other: in the Python core (CPU time, not an ArcGIS Pro run time) 2,000 such "
                 "points took 2.5 s near the origin and about 5 to 9 s at UTM coordinates, and 8,000 "
                 "took 59 s near the origin. Ordinary data can reach this: stations spaced "
                 "evenly along a ring road or another circular layout are nearly co-circular "
                 "(8,000 chainage stations on a long arc of a 20 km curve took about 110 s of "
                 "CPU time, 2,000 took 0.9 s); run such data in parts (a selection) or thin "
                 "it. Scattered point data (addresses, facilities, samples) is not affected. A "
                 "clip with many vertices is slow too: the time grows with points x clip "
                 "vertices (a review measured 500 points with 20,000 clip vertices: 10.8 s of "
                 "CPU time); simplify a densified clip first.\n\n"
                 "Clip Features in an unknown coordinate system (for example a shapefile "
                 "without a .prj) cannot be projected: the run stops when the input has to be "
                 "projected; when the input is used in its own system they are taken to be in "
                 "it, with a warning. "
                 "A copied field keeps its field-level domain when the output geodatabase "
                 "has it, as Copy Features does (a warning names the fields that lose it); "
                 "subtypes and subtype-level domains are not carried. "
                 "Fields of the types GlobalID, Blob, Raster, Time Only and Timestamp Offset, and "
                 "fields that are not editable, are not copied (no message). A user field "
                 "named like a geometry field, such as Shape_Leng or Shape_Area from a "
                 "shapefile export, is copied like any other field, possibly under another "
                 "name (a shapefile output stores a user field Shape_Area as Shape_Ar_1; a "
                 "message names it). "
                 "A copied text field wider than a shapefile allows (254 bytes as ArcGIS Pro "
                 "writes them: an Arabic letter takes 2, a character above U+FFFF such as an "
                 "emoji takes 6 bytes, not the 4 of UTF-8; Pro's default length is 255) is written as wide as "
                 "its longest value in bytes, at most 254, to a folder output; a longer value "
                 "stops the run before anything is written. In a "
                 "shapefile, copied field names are cut to 10 characters (Population_2020 "
                 "becomes Population) and a warning names every field stored under another "
                 "name; the fixed fields SITE_OID, DUP_COUNT and AREA_M2 are never changed. "
                 "The names are read back from the output before writing: if ArcGIS Pro "
                 "stored a field under another name than predicted (for example an Arabic "
                 "name cut by bytes), the values go to the stored field and a warning names "
                 "it.\n\n"
                 "Not checked or not done: a Basic licence is the target but is NOT VERIFIED; "
                 "AREA_M2 is the planar area in the measuring system "
                 "(for example UTM), not the area on the ellipsoid, except for wide or polar "
                 "data (the planar area is up to about 0.2 % larger than the ellipsoid area "
                 "near the edge of a UTM zone, less near its centre); the clip must be convex; "
                 "64-bit ObjectIDs above 2,147,483,647 make SITE_OID a Big Integer field in a "
                 "geodatabase (an ObjectID above 2^53 - 1 stops the run) and, in a shapefile, a "
                 "Double field while every ObjectID has at most 12 significant digits, else a "
                 "text field of 20 characters with every digit kept (not verified in Pro); the tool does not poll for Cancel, so "
                 "cancelling during the build is not reliable (not verified in Pro).\n\n"
                 "Selections and definition queries on the input layers are honoured. The "
                 "input is never edited. If an arcpy error stops the run while the output is "
                 "written, the output this run created is deleted and the messages collected "
                 "so far are shown before the error.\n\nBuilt-in alternatives: Create Thiessen Polygons "
                 "is Basic: No, Standard: No, Advanced: Yes; Generate Weighted Voronoi needs "
                 "the Spatial Analyst extension and creates its polygons from a Voronoi raster.",
        "params": {
            "in_points": "Point features (sites).",
            "clip_extent": "Optional rectangle the polygons are clipped to. Four numbers "
                           "(xmin ymin xmax ymax, separated by spaces, with a decimal point) "
                           "are read in the input's coordinate system; an "
                           "extent taken from a layer or the map carries its own system and is "
                           "projected. ArcGIS Pro parses typed extent text itself before the "
                           "tool gets it (Pro 3.3.2 read 499990,5 in an arcpy script call as "
                           "499990.5), so the tool cannot refuse a decimal comma there: type a "
                           "decimal point. Only when "
                           "the extent reaches the tool's code as text (the tool run outside "
                           "Pro's geoprocessing, as with the simulated arcpy of the tests) does "
                           "the tool read it itself: then commas between the four numbers are "
                           "also accepted and a decimal comma is refused. Use Clip Features "
                           "instead for a study area that is not a rectangle.",
            "clip_features": "Optional layer with one convex polygon (your study area) the "
                             "polygons are clipped to (select one feature if the layer has "
                             "several). Without a clip, the points' extent grown by Expand % is "
                             "used.",
            "expand_pct": "Without a clip: grow the points' extent by this percentage on each "
                          "side (0 to 1,000,000). Disabled and not checked when a clip is "
                          "given.",
            "copy_attributes": "Copy the attributes of each point (the lowest ObjectID at a "
                               "duplicated location) to its polygon.",
            "out_features": "Output polygon feature class: SITE_OID, DUP_COUNT, AREA_M2 plus "
                            "the point attributes.",
            "polygon_count": "Number of polygons written (derived).",
        },
        "tags": ["thiessen", "voronoi", "proximity", "polygons", "basic"],
    }

    def __init__(self):
        self.label = "Thiessen Polygons (Clipped)"
        self.description = ("Exact vector Thiessen (Voronoi) polygons clipped to a convex "
                            "extent, on a Basic licence (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_points", "Input Points", "GPFeatureLayer", value_list=["Point"]),
            make_param("clip_extent", "Clip Extent", "GPExtent", required=False),
            make_param("clip_features", "Clip Features", "GPFeatureLayer", required=False,
                       value_list=["Polygon"]),
            make_param("expand_pct", "Expand (%)", "GPDouble", required=False,
                       default=THIESSEN_DEFAULT_EXPAND_PCT),
            make_param("copy_attributes", "Copy Attributes", "GPBoolean", required=False,
                       default=True),
            make_param("out_features", "Output Thiessen Polygons", "DEFeatureClass",
                       direction="Output"),
            derived_output("polygon_count", "Polygon Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        p = param_map(parameters)
        p["expand_pct"].enabled = p["clip_extent"].value is None and \
            p["clip_features"].value is None
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        if p["clip_extent"].value is not None and p["clip_features"].value is not None:
            p["clip_features"].setErrorMessage("Give a Clip Extent or Clip Features, not both.")
        # Expand is used (and enabled) only without a clip: a value left from before a clip was
        # given no longer blocks a run that does not use it (round-10 review).
        unused = p["clip_extent"].value is not None or p["clip_features"].value is not None
        pct = None if unused else p["expand_pct"].value
        if pct is not None and float(pct) < 0:
            p["expand_pct"].setErrorMessage("The percentage must be zero or more.")
        elif pct is not None and not float(pct) <= THIESSEN_MAX_EXPAND_PCT:
            p["expand_pct"].setErrorMessage(
                "Expand must be a number of at most {0:,.0f} %; for a larger area give a Clip "
                "Extent.".format(THIESSEN_MAX_EXPAND_PCT))
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            # An arcpy error (e.g. while writing): the output it created was deleted
            # (_run); show what was collected (points read, measuring system) first.
            flush_messages(collector)
            raise

    def _clip_from_extent(self, param, desc, sr):
        """Clip rectangle in the measuring system from a GPExtent parameter."""
        value = param.value
        ext_sr = None
        if value is None:
            return None
        if isinstance(value, str):
            box = thiessen_extent_numbers(value)
        else:   # an arcpy.Extent
            box = _thiessen_check_box([float(value.XMin), float(value.YMin),
                                       float(value.XMax), float(value.YMax)])
            ext_sr = value.spatialReference
        if ext_sr is None:
            ext_sr = desc["sr_object"]          # numbers are in the input's system
        target = sr if sr is not None else desc["sr_object"]
        same = (ext_sr is None or target is None
                or (ext_sr.factoryCode and ext_sr.factoryCode == target.factoryCode))
        if not same:
            projected = arcpy.Extent(box[0], box[1], box[2], box[3],
                                     spatial_reference=ext_sr).projectAs(target)
            box = _thiessen_check_box([projected.XMin, projected.YMin, projected.XMax,
                                       projected.YMax])
        return rect_ring(*box)

    def _clip_from_features(self, layer, measure_sr, measure_wkid, inputs, decision=None,
                            collector=None, main_name=None):
        cdesc = describe_dataset(layer)
        for text in (further_input_sr_check("Clip Features", cdesc["sr"], decision, main_name),
                     datum_mismatch_warning("Clip Features", cdesc["sr"], decision)):
            if text and collector is not None:
                collector.warning(text)
        if kind_from_shape_type(cdesc["shape_type"]) != GEOM_POLYGON:
            raise ToolError("Clip Features must be polygons.", "Choose a polygon layer.")
        inputs.append(cdesc["catalog_path"])
        rows = [r for r in read_features(cdesc["input"]) if r["shape"]]   # its own system
        if len(rows) != 1:
            raise ToolError("Clip Features has {0} polygons with geometry; exactly one is "
                            "needed.".format(len(rows)),
                            "Select the one clip polygon in the layer, or use a Clip Extent.")
        # Convexity is judged in the clip's own system (RT-A-6): projecting bends edges
        # that run along parallels, so in the measuring system the clip is the convex
        # hull of its projected vertices.
        ring = convex_clip_ring(rows[0]["shape"], thiessen_convex_floor(cdesc["sr"]))
        # Kept as is only when it is already in the measuring system, or when its
        # system is unknown (a cursor cannot project it; further_input_sr_check has
        # refused that case unless the input itself is used in its own system).
        # A custom system without a WKID is projected like any other (RT4-A-3).
        own_wkid = cdesc["sr"]["wkid"] if cdesc["sr"] else None
        if (measure_sr is None or sr_is_unknown(cdesc["sr"])
                or (own_wkid and own_wkid == measure_wkid)):
            return ring
        projected = [r for r in read_features(cdesc["input"], sr=measure_sr) if r["shape"]]
        points = [pt for rg in projected[0]["shape"] for pt in rg] if projected else []
        if (len(points) < 3
                or not all(math.isfinite(c) for pt in points for c in pt[:2])):
            # The cursor returns an empty (or non-finite) geometry for a polygon it
            # cannot project; without this the run ended with a bare IndexError.
            raise ToolError(
                "The clip polygon in {0} cannot be projected to the measuring coordinate "
                "system{1}, which is chosen from the centre of the points. It is probably "
                "too far from the points, or its coordinate system cannot be converted to "
                "that one.".format(layer, " (WKID {0})".format(measure_wkid)
                                   if measure_wkid else ""),
                "Use a clip polygon that lies around the points, project it to the points' "
                "coordinate system first (Project tool), or use a Clip Extent instead.")
        return convex_hull_ring(points)

    def _true_areas(self, rings, plane_wkid, mpu, geo_wkid, collector):
        """``{key: area in m2}`` of rings in the plane ``plane_wkid``, each projected
        to the geographic system ``geo_wkid`` (edges densified every 1 km first) and
        measured on its own projection (``projection.local_tm_rows``)."""
        geo_sr = arcpy.SpatialReference(geo_wkid)
        rows = []
        for key, ring in rings:
            if not ring:
                continue
            dense = densify_path_segments(ring, _TH_AREA_DENSIFY_M / float(mpu or 1.0))
            shape = arcpy.AsShape(core_to_esri_json(GEOM_POLYGON, [dense], plane_wkid), True)
            core = esri_json_to_core(json.loads(shape.projectAs(geo_sr).JSON))[1]
            rows.append({"oid": key, "shape": core})
        rows = local_tm_rows(rows, collector)[0]
        return dict((r["oid"], sum(abs(ring_signed_area(rg)) for rg in r["shape"]))
                    for r in rows if r["shape"])

    def _build_cells(self, rows, clip, expand, decision, desc, sr, merge_tol, collector):
        """``(result, cells, clip_area)``: the cells of ``rows`` with merge distance ``merge_tol``
        (``thiessen_polygons``), AREA_M2 re-measured for wide or polar data."""
        # The bar is sized to the kept sites (one tick each), not to the points read: duplicates and
        # merged points are not built, so a bar sized to the input never reached 100 % (round 10).
        bar = {}

        def start(total):
            bar["p"] = Progress("Building Thiessen polygons", total)

        def tick():
            if "p" in bar:
                bar["p"].tick()

        try:
            result = thiessen_polygons([(r["oid"], r["shape"]) for r in rows], clip, expand,
                                       decision["meters_per_unit"], progress=tick,
                                       merge_tol=merge_tol, start=start)
        finally:
            if "p" in bar:
                bar["p"].close()
        cells = result["cells"]
        clip_area = result["clip_area_m2"]
        geo_wkid = analysis_remeasure_gcs(desc["sr"], decision)
        if geo_wkid and cells:
            plane = decision["wkid"] if sr is not None else (desc["sr"] or {}).get("wkid")
            areas = self._true_areas([(c["oid"], c["ring"]) for c in cells], plane,
                                     decision["meters_per_unit"], geo_wkid, collector)
            for c in cells:
                c["area_m2"] = areas.get(c["oid"], c["area_m2"])
            clip_area = self._true_areas([(0, result.get("clip_ring"))], plane,
                                         decision["meters_per_unit"], geo_wkid,
                                         MessageCollector()).get(0, clip_area)
            collector.info(
                "The polygons are built in WKID {0}, whose scale is not 1 over this data "
                "(wide or polar data), so AREA_M2 is measured on each polygon's own projection "
                "(Transverse Mercator centred on it, or polar stereographic with true scale at "
                "it near the poles; WGS 84 ellipsoid). The polygon edges are the bisectors in "
                "WKID {0}.".format(plane))
        return result, cells, clip_area

    def _run(self, parameters, p, collector):
        clip_layer = param_text(p["clip_features"])
        if p["clip_extent"].value is not None and clip_layer:
            raise ToolError("Both a Clip Extent and Clip Features were given.",
                            "Give only one of them.")
        expand = param_number(p["expand_pct"], THIESSEN_DEFAULT_EXPAND_PCT)
        if p["clip_extent"].value is not None or clip_layer:
            expand = THIESSEN_DEFAULT_EXPAND_PCT      # not used with a clip (the dialog disables it)
        if not math.isfinite(expand) or expand < 0:
            raise ToolError("Expand must be a number, zero or more.", "Enter a percentage such as 10.")
        desc = describe_dataset(param_text(p["in_points"]))
        if kind_from_shape_type(desc["shape_type"]) != GEOM_POINT:
            raise ToolError("The input must contain points.", "Choose a point layer.")
        inputs = [desc["catalog_path"]]
        decision, sr = metric_sr_or_native(desc)
        collector.info(decision["reason"])
        zones = decision.get("utm_zones") or 0
        if decision.get("reproject") and zones > _TH_MAX_UTM_ZONES:
            # The polygons need one plane; a UTM zone this far from its central meridian
            # is more than ~15 % off in scale, so the bisectors are no longer meaningful.
            raise ToolError(
                "The points span {0} UTM zones, too wide for the one projected system "
                "(WKID {1}) the polygons are built in: far from its centre the scale is more "
                "than about 15 % off, and some points may not project at all.".format(
                    zones, decision["wkid"]),
                "Project the points to an equidistant or equal-area system suited to their "
                "whole extent first (Project tool), or run the tool on a smaller area (use a "
                "selection).")
        for text in decision["warnings"]:
            collector.warning(text)
        measure_sr = sr if sr is not None else desc["sr_object"]

        if clip_layer:
            clip = self._clip_from_features(clip_layer, measure_sr, decision["wkid"], inputs,
                                           decision, collector, (desc["sr"] or {}).get("name"))
            collector.info("Clipping to the polygon in {0}.".format(clip_layer))
        else:
            clip = self._clip_from_extent(p["clip_extent"], desc, sr)
            if clip is None:
                collector.info("Clipping to the points' extent grown by {0:g} % on each side."
                               .format(expand))
        check_output_path(param_text(p["out_features"]), inputs)
        carry = []
        if param_bool(p["copy_attributes"], True):
            carry, skipped_names = analysis_carry_fields(desc["fields"], _TH_FIELDS)
            if skipped_names:
                collector.info("Input field(s) not copied because the output uses the name: "
                               "{0}.".format(", ".join(skipped_names)))
        rows = read_features(desc["input"], [f["name"] for f in carry], sr=sr)
        attrs = dict((r["oid"], r["attrs"]) for r in rows)
        collector.info("{0} point(s) read.".format(len(rows)))
        if not rows:
            collector.warning("The input has no points (an empty layer, or a selection or "
                              "definition query that leaves none): the output has no polygons.")
        unprojected = set()
        if sr is not None and any(r["shape"] is None for r in rows):
            # A point the cursor cannot project reads as empty: it has a geometry, so it
            # is reported as not projectable, not as "no geometry" (RT6-A-2).
            unprojected = set(r["oid"] for r in read_features(desc["input"])
                              if r["shape"] is not None)
            unprojected &= set(r["oid"] for r in rows if r["shape"] is None)
            if unprojected:
                raise ToolError(
                    "{0} point(s) cannot be projected to the measuring coordinate system "
                    "(WKID {1}), which is chosen from the centre of the data: OID {2}. The "
                    "points are spread too widely for one projected system.".format(
                        len(unprojected), decision["wkid"],
                        analysis_oid_text(sorted(unprojected))),
                    "Project the points to an equidistant or equal-area system suited to "
                    "their whole extent first (Project tool), or run the tool on a smaller "
                    "area (use a selection).")

        if len(rows) >= 10000:
            collector.info("Building the polygons of {0:,} points in Python: this takes a while "
                           "(roughly one minute for 50,000 points); the progress bar counts "
                           "the kept point locations.".format(len(rows)))
        # Distinct points closer than ten times the output's XY tolerance (3.5 times in an unknown
        # coordinate system) are merged (R8-D1, R9-D1): Pro stores vertices on the XY resolution
        # grid and cleans each polygon with the XY tolerance, which empties cells narrower than about
        # 3.5 tolerances. The tolerance is first taken from the measuring system; once the output
        # exists its own tolerance is read back (the XY Tolerance environment or a feature dataset
        # can change it) and, when it differs, the output is deleted and built again with it.
        mpu = float(decision["meters_per_unit"] or 1.0)
        unknown = sr is None and sr_is_unknown(desc["sr"])
        merge_tol = thiessen_merge_distance(thiessen_xy_tolerance(measure_sr),
                                            thiessen_resolution(measure_sr), mpu, unknown)
        out_param = param_text(p["out_features"])
        retol_note = None
        for attempt in (0, 1):
            step = MessageCollector()
            result, cells, clip_area = self._build_cells(rows, clip, expand, decision, desc, sr,
                                                         merge_tol, step)
            # SITE_OID: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``)
            oid_spec, oid_note = oid_field_spec(
                [c["oid"] for c in cells], is_folder_workspace(workspace_of(out_param)),
                name="SITE_OID")
            if oid_note:
                step.info(oid_note)
            specs = [dict(oid_spec), {"name": "DUP_COUNT", "type": "SHORT"},
                     {"name": "AREA_M2", "type": "DOUBLE"}]
            fixed = len(specs)
            specs += analysis_carry_specs(carry, lambda n: [a[n] for a in attrs.values()],
                                          read_output_domains(out_param))
            wanted = [s["name"] for s in specs]
            specs, renamed = plan_output_fields(out_param, specs, fixed=fixed)
            for old, new in renamed:
                step.info("Field {0} is called {1} in the output.".format(old, new))
            renamed_text = thiessen_renamed_fields_text(out_param, wanted, specs, renamed)
            if renamed_text:
                step.warning(renamed_text)
            clamped = [c["oid"] for c in cells if c["count"] > _TH_SHORT_MAX]
            out_rows = [([c["ring"]], [oid_field_value(oid_spec, c["oid"]),
                                       min(c["count"], _TH_SHORT_MAX), c["area_m2"]]
                         + [attrs[c["oid"]][f["name"]] for f in carry]) for c in cells]
            null_fields = set()
            created = []
            try:
                path, fmap = create_feature_class(out_param, GEOM_POLYGON, measure_sr, specs,
                                                  inputs=inputs)
                created.append(path)
                out_info = thiessen_output_sr(path)
                measure_info = thiessen_sr_dict(measure_sr)
                if out_info is not None and thiessen_sr_mismatch(out_info, measure_info):
                    # R10-1: in a feature dataset in another system the output's XY tolerance is in
                    # that system's units (degrees, feet) and Pro would project the cells on insert.
                    # The output just created is deleted by the handler below.
                    raise ToolError(
                        "The output {0} is in another coordinate system ({1}) than the measuring "
                        "coordinate system the polygons are built in ({2}). ArcGIS Pro gives a "
                        "feature class in a feature dataset the coordinate system of the dataset; "
                        "its XY tolerance would then be in other units than the merge distance, and "
                        "the polygons would be projected when they are written.".format(
                            path, thiessen_sr_text(out_info), thiessen_sr_text(measure_info)),
                        "Write the output outside the feature dataset (for example directly in the "
                        "geodatabase), or into a feature dataset in {0}.".format(
                            thiessen_sr_text(measure_info)))
                out_merge = thiessen_output_merge_distance(path, mpu, unknown)
                if (attempt == 0 and out_merge is not None
                        and not abs(out_merge - merge_tol) <= 1e-9 * max(out_merge, merge_tol)):
                    retol_note = (
                        "The output's XY tolerance differs from the measuring system's (the XY "
                        "Tolerance environment or the output's feature dataset sets it), so the "
                        "polygons were built again with the merge distance of the output: {0:.6g} "
                        "{2} instead of {1:.6g} {2}.".format(
                            out_merge * (1.0 if unknown else mpu),
                            merge_tol * (1.0 if unknown else mpu),
                            "data units" if unknown else "m"))
                    merge_tol = out_merge
                    created.pop()
                    safe_delete(path, inputs)
                    continue
                names, moved = thiessen_stored_fields(path, [fmap[s["name"]] for s in specs],
                                                      fixed)
                if moved:
                    fmap = dict(fmap)
                    for s, name in zip(specs, names):
                        fmap[s["name"]] = name
                    step.warning(
                        "ArcGIS Pro stored {0} under another name than predicted: {1}. The "
                        "values are in the stored {2}.".format(
                            "a field" if len(moved) == 1 else "fields",
                            ", ".join("{0} -> {1}".format(a, b) for a, b in moved),
                            "field" if len(moved) == 1 else "fields"))
                insert_rows(path, names, out_rows, kind=GEOM_POLYGON,
                            wkid=decision["wkid"], null_fields=null_fields)
                broken = thiessen_stored_problems(path, names[0])
            except Exception:
                for done in created:  # never leave part of the output behind
                    try:
                        safe_delete(done, inputs)
                    except Exception:
                        pass
                raise
            break
        if retol_note:
            collector.info(retol_note)
        collector.extend(step)
        note = folder_null_number_warning(path, specs, fmap, null_fields)
        if note:
            collector.info(note)
        lost = lost_domain_warning(specs, path)
        if lost:
            collector.warning(lost)
        collector.info("{0} polygon(s) written to {1}, in the measuring coordinate system "
                       "(WKID {2}); total area {3:.6g} m2 of a clip area of {4:.6g} m2.".format(
                           len(cells), path, decision["wkid"],
                           sum(c["area_m2"] for c in cells), clip_area))
        thin = thin_clip_text(result.get("thin_clip"), expand)
        if thin:
            collector.warning(thin)
        dup_text = thiessen_duplicates_text(result["duplicates"])
        if dup_text:
            collector.warning(dup_text)
        near_text = thiessen_near_text(result.get("near"), merge_tol * (1.0 if unknown else mpu),
                                       unknown=unknown)
        if near_text:
            collector.warning(near_text)
        if broken:
            collector.warning(
                "{0} polygon(s) were stored by ArcGIS Pro with more than one ring or with no area "
                "(Pro rounds the vertices to the output's XY resolution and cleans each polygon "
                "with its XY tolerance): SITE_OID {1}. Their "
                "AREA_M2 is the area of the cell before storing; check their shapes before you "
                "use them.".format(
                    len(broken), analysis_oid_text(broken)))
        if clamped:
            collector.warning("DUP_COUNT is capped at {0} for OID {1}.".format(
                _TH_SHORT_MAX, analysis_oid_text(clamped)))
        if result["empty"]:
            collector.warning("{0} point(s) have no polygon because their area lies outside the "
                              "clip: OID {1}.".format(len(result["empty"]),
                                                       analysis_oid_text(result["empty"])))
        if result["nulls"]:
            collector.warning("{0} point(s) have no geometry: OID {1}.".format(
                len(result["nulls"]), analysis_oid_text(result["nulls"])))
        set_derived_output(parameters, "polygon_count", str(len(cells)))
        flush_messages(collector)


# ==========================================================================
# analysis/rose_tool.py
# ==========================================================================
# Rose Diagram: the ArcGIS Pro tool (adapter).

_RS_NUMERIC = ["Short", "Long", "BigInteger", "Float", "Double"]
_RS_NUMERIC_FIELD_TYPES = ("SmallInteger", "Integer", "BigInteger", "Single", "Double")
_RS_MAX_GROUPS = 5000
_RS_WARN_GROUPS = 1000
_RS_MAX_CURVED_OIDS = 1000      # ObjectIDs of left-out curved features that are remembered (the count is exact)
_RS_MAX_TITLE = 110
_RS_SMALL_N = 3               # below this many items the group message says the test means little
# Geographic points drawn in one UTM zone: a warning when the grid convergence at the data reaches
# this (degrees), or the data span this many UTM zones (3 zones = 18 degrees of longitude).
_RS_WIDE_CONVERGENCE_DEG = 5.0
_RS_WIDE_ZONES = 4
_RS_SHORT = {"CENTERED_ON_NORTH": "centred on north", "STARTS_AT_NORTH": "starting at north"}


def _rs_specs(fields, rows):
    """AddField specs of a table; text widths come from the values written (rule 8)."""
    specs = []
    for name, kind in fields:
        spec = {"name": name, "type": kind}
        if kind == "TEXT":
            spec["values"] = [r[name] for r in rows]
        specs.append(spec)
    return specs


def _rs_group_line(row, opts):
    """One message line per group: n, resultant length, Rayleigh test, and a mean direction
    only when the test rejects uniformity (the table keeps MEAN_DIR for every group)."""
    if row["PREF_DIR"]:
        verdict = "{0} {1}".format("axial mean" if opts["axial"] else "mean",
                                   rose_angle_text(row["MEAN_DIR"], 180.0 if opts["axial"] else 360.0))
        # one verdict rule with the poster: a stronger square grid is named too
        if rose_grid_is_stronger(opts["axial"], row.get("RESULT_R"), row.get("ORTHO_DIR"),
                                 row.get("ORTHO_R"), row.get("ORTHO_P")):
            verdict += "; the square grid at {0} is stronger (grid test {1}, ORTHO_R {2})".format(
                rose_angle_text(row["ORTHO_DIR"], 90.0), rose_p_text(row["ORTHO_P"]),
                _rs_num(row["ORTHO_R"], "{0:.3f}"))
    elif opts["axial"] and row["ORTHO_P"] is not None and row["ORTHO_P"] < ROSE_RAYLEIGH_ALPHA:
        verdict = "no preferred direction, but a square grid at {0} (grid test {1})".format(
            rose_angle_text(row["ORTHO_DIR"], 90.0), rose_p_text(row["ORTHO_P"]))
    else:
        verdict = "no preferred direction"
    # The dominant sector is named by its index AND its centre (DOM_DIR, in the convention of the
    # values), because a bare bin index such as "sector 6" says nothing about the direction.
    dom = "n/a" if row["DOM_SECTOR"] is None else str(row["DOM_SECTOR"])
    if row["DOM_SECTOR"] is not None and row.get("DOM_DIR") is not None:
        dom += " at {0}".format(rose_angle_text(row["DOM_DIR"], 180.0 if opts["axial"] else 360.0))
    # Zar's closed form is poor for tiny samples (n = 1, R = 1 gives p = 0.47; exact: 1).
    small = (" (n below {0}: the Rayleigh test means little)".format(_RS_SMALL_N)
             if row["N_ITEMS"] is not None and 0 < row["N_ITEMS"] < _RS_SMALL_N else "")
    return ("{0}: n = {1}, resultant length {2}, Rayleigh Z = {3}, {4}{8} -> {5}; dominant sector "
            "{6} ({7}).".format(
                row["GROUP_NAME"], row["N_ITEMS"], _rs_num(row["RESULT_R"], "{0:.3f}"),
                _rs_num(row["RAYLEIGH_Z"], "{0:.2f}"), rose_p_text(row["RAYLEIGH_P"]), verdict,
                dom, _rs_num(row["DOM_PCT"], "{0:.0f} %"), small))


def _rs_num(value, template):
    """``template`` filled with ``value``, or ``n/a`` when there is no number."""
    return "n/a" if value is None else template.format(value)


def _rs_iter_rows(path, fields, sr, curved):
    """The features of ``path`` one at a time (a generator: nothing is kept in memory), as dicts
    ``{"oid", "shape", "attrs"}`` like ``common.arcio.read_features``. A feature with true curves
    is not yielded: it is counted in ``curved["n"]`` and its ObjectID is remembered (the first
    ``_RS_MAX_CURVED_OIDS``) in ``curved["oids"]``. A feature without geometry has ``shape`` None."""
    register_inputs([path])
    fields = list(fields)
    with arcpy.da.SearchCursor(path, ["OID@", "SHAPE@JSON"] + fields,
                               spatial_reference=sr) as cursor:
        for values in cursor:
            row = {"oid": values[0], "shape": None, "attrs": dict(zip(fields, values[2:]))}
            if values[1]:
                data = json.loads(values[1])
                if esri_json_has_curves(data):
                    curved["n"] += 1
                    if len(curved["oids"]) < _RS_MAX_CURVED_OIDS:
                        curved["oids"].append(values[0])
                    continue
                row["shape"] = esri_json_to_core(data)[1]
            yield row


def _rs_project_xy(xy, in_sr, out_sr, geographic, what):
    """``xy`` given in the input's coordinate system, as ``(x, y)`` in ``out_sr`` (the system
    the roses are drawn in). Anchor coordinates are always read in the input's own system: for
    points in a geographic system that is longitude/latitude in degrees, which the tool then
    projects to the UTM zone it draws in (used unprojected, they would put the roses far from
    the data)."""
    x, y = float(xy[0]), float(xy[1])
    if geographic and not (-180.0 <= x <= 180.0 and -90.0 <= y <= 90.0):
        raise ToolError(
            "{0} ({1:g}, {2:g}) is not a longitude/latitude pair, but the input points are in a "
            "geographic coordinate system, so the anchor coordinates are read in degrees "
            "(X = longitude -180 to 180, Y = latitude -90 to 90).".format(what, x, y),
            "Give the anchor as longitude/latitude of the input system (the tool projects it to "
            "the UTM zone the roses are drawn in), or project the points first and give the "
            "anchor in that projected system.")
    try:
        # The same projection (no datum transformation) as the cursor that reads the points.
        geom = arcpy.AsShape({"x": x, "y": y, "spatialReference": _rs_sref(in_sr)},
                             True).projectAs(out_sr)
        pt = geom.firstPoint
        px, py = float(pt.X), float(pt.Y)
    except Exception as exc:
        raise ToolError("{0} ({1:g}, {2:g}) could not be projected to {3}: {4}".format(
            what, x, y, getattr(out_sr, "name", "the output system"), exc),
            "Check the anchor coordinates, or project the points first.")
    if not (math.isfinite(px) and math.isfinite(py)):
        raise ToolError("{0} ({1:g}, {2:g}) could not be projected to {3}.".format(
            what, x, y, getattr(out_sr, "name", "the output system")),
            "Check the anchor coordinates, or project the points first.")
    return (px, py)


def _rs_sref(sr):
    """Esri JSON ``spatialReference`` of ``sr`` (its WKID, or its string when it has none)."""
    wkid = getattr(sr, "factoryCode", None)
    return {"wkid": int(wkid)} if wkid else {"wkt": sr.exportToString()}


def _rs_project_points(points, from_sref, to_sr):
    """``points`` (``(x, y)`` in ``from_sref``) projected one by one to ``to_sr`` with
    ``AsShape(...).projectAs`` (no datum transformation, as the cursor); ``None`` for a point that
    cannot be projected."""
    out = []
    for x, y in points:
        try:
            pt = arcpy.AsShape({"x": float(x), "y": float(y), "spatialReference": from_sref},
                               True).projectAs(to_sr).firstPoint
            px, py = float(pt.X), float(pt.Y)
            out.append((px, py) if math.isfinite(px) and math.isfinite(py) else None)
        except Exception:
            out.append(None)
    return out


def _rs_bearing_check(map_sr, groups):
    """How grid bearings of ``map_sr`` (the system the bearings are measured or the roses drawn
    in) differ from true bearings at the data (``rose_core.rose_bearing_check``), or ``None``
    when it cannot be measured (no projected system, no locations, or projection failed)."""
    if map_sr is None or getattr(map_sr, "type", None) != "Projected":
        return None
    points = rose_probe_points([g.box for g in groups])
    if not points:
        return None
    try:
        own = _rs_sref(map_sr)
        wgs = arcpy.SpatialReference(4326)
    except Exception:
        return None
    return rose_bearing_check(
        points, lambda pts: _rs_project_points(pts, own, wgs),
        lambda pts: _rs_project_points(pts, {"wkid": 4326}, map_sr))


def _rs_conv_text(check):
    """``between a and b degrees`` (or ``a degrees``) for the convergence range of ``check``."""
    lo, hi = check["conv_min"], check["conv_max"]
    if abs(hi - lo) < 0.005:
        return "{0} degrees".format(_rs_signed(lo))
    return "between {0} and {1} degrees".format(_rs_signed(lo), _rs_signed(hi))


def _rs_signed(value):
    """``+1.25`` / ``-0.70``; a value that rounds to zero prints ``0.00`` (never ``-0.00``)."""
    rounded = round(float(value), 2)
    if rounded == 0:
        return "0.00"
    return "{0:+.2f}".format(rounded)


def _rs_conv_abs(check):
    """Largest size (0 to 180 degrees) of the grid convergence at the probes of ``check``."""
    if "conv_abs_max" in check:
        return float(check["conv_abs_max"])
    return max(abs(check["conv_min"]), abs(check["conv_max"]))


def _rs_turned_text(check, crs_name):
    """Warning for points already in a projected system whose grid north is far from true
    north at the data (polar stereographic, south-oriented or rotated grids, far from the
    central meridian): petals drawn from true bearings are turned on the map."""
    size = _rs_conv_abs(check)
    return ("The grid north of {0} differs from true north by up to {1:.1f} degrees at the data "
            "(measured at {2}; c {3}). If the direction values are true bearings, every petal "
            "on the map is turned by c{4}. The direction values and the tables are not "
            "affected. For a map of true directions, project the points to a conformal system "
            "whose grid north is close to true north at the data (for example the UTM zone of "
            "the area) and run the tool again; if the values are already grid bearings of this "
            "system, the petals are right.".format(
                crs_name or "the coordinate system", size, _rs_where(check),
                _rs_conv_text(check),
                ", so the petals point nearly the opposite way" if size >= 135.0 else ""))


def _rs_where(check):
    """``9 place(s)`` or ``4 of the 11 places probed (the system could not be measured at the
    other 7)``: where ``check`` (``rose_core.rose_bearing_check``) could measure the system."""
    probed = int(check.get("probed") or check["checked"])
    if probed <= check["checked"]:
        return "{0} place(s)".format(check["checked"])
    return ("{0} of the {1} places probed; the system could not be measured at the other {2}, "
            "where the projection fails or folds over".format(
                check["checked"], probed, probed - check["checked"]))


def _rs_where_short(check):
    """``9 place(s) measured`` or ``4 of 11 places that could be measured (at the other 7 the
    difference is undefined or larger)``."""
    probed = int(check.get("probed") or check["checked"])
    if probed <= check["checked"]:
        return "{0} place(s) measured".format(check["checked"])
    return ("{0} of {1} places that could be measured (at the other {2} it could not be "
            "measured at all: there it is undefined or larger)".format(
                check["checked"], probed, probed - check["checked"]))


def _rs_zone_warning(decision, kind):
    """The rose tool's own text in place of the shared wide-data warning of
    ``metric_sr_or_native`` (whose advice, an equidistant or equal-area system, would distort
    bearings), or ``None`` to drop it (lines in degrees are refused next with the fix; points
    spread over 4 or more zones get the specific warning later)."""
    zones = int(decision.get("utm_zones") or 1)
    if kind == GEOM_POLYLINE or zones >= _RS_WIDE_ZONES:
        return None
    return ("The points span {0} UTM zones; every rose is drawn in the one zone chosen from "
            "the data, so roses far from its centre are drawn turned by the grid convergence "
            "(measured below). For directions, keep to a conformal system such as the UTM zone "
            "of each region: an equal-area or equidistant system would turn the petals by an "
            "amount that depends on the direction.".format(zones))


def _rs_not_conformal_text(check, crs_name, lines):
    """Warning for a map system that is not conformal at the data (direction-dependent error)."""
    what = ("Bearings measured in it differ from true bearings by between {0:+.1f} and {1:+.1f} "
            "degrees depending on the direction of the line" if lines else
            "A direction drawn on that map is turned by between {0:+.1f} and {1:+.1f} degrees "
            "depending on the direction").format(check["err_min"], check["err_max"])
    text = ("{0} is not a conformal projection at the data (measured at {1}): {2}, not "
            "by one angle (the grid convergence) as in a conformal system such as UTM or Lambert "
            "Conformal Conic, and two lines at a true right angle can read up to {3:.1f} degrees "
            "away from 90.").format(crs_name or "The coordinate system", _rs_where(check), what,
                                    check["right_angle"])
    if lines:
        return text + (" The sectors, MEAN_DIR and ORTHO_DIR carry this error. For street or "
                       "fault orientation, project the lines to a conformal system suited to "
                       "the area (for example the UTM zone) and run the tool again.")
    return text + (" The direction values and the tables are not affected (the values are used "
                   "as stored); only the petals on the map are.")


def _rs_far_anchors(plan, opts):
    """Names of groups whose rose centre lies more than 10 data diagonals (or 10 rose radii,
    whichever is larger) outside the extent of all the data: usually anchor coordinates given
    in another coordinate system or unit."""
    boxes = [g.box for g in plan["groups"] if g.box]
    if not boxes:
        return []
    x0 = min(b[0] for b in boxes)
    y0 = min(b[1] for b in boxes)
    x1 = max(b[2] for b in boxes)
    y1 = max(b[3] for b in boxes)
    diag = ((x1 - x0) ** 2 + (y1 - y0) ** 2) ** 0.5
    limit = 10.0 * max(diag, float(plan["radius_m"] or 0.0) / (opts["mpu"] or 1.0))
    far = []
    for g in plan["groups"]:
        a = plan["anchors"].get(g.name)
        if a is None or g.n == 0:
            continue
        dx = max(x0 - a[0], 0.0, a[0] - x1)
        dy = max(y0 - a[1], 0.0, a[1] - y1)
        if (dx * dx + dy * dy) ** 0.5 > limit:
            far.append(g.name)
    return far


def _rs_dataset_name(path):
    """Last part of a catalog path (``roads_utm38``), or ``""`` when it is not plain Latin text."""
    name = re.split(r"[\\/]", str(path or "").strip())[-1]
    return name if rose_is_latin(name) else ""


def _rs_png_name(requested):
    """The file a PNG output is written to: ``choose_output_file`` gives it the ``.png`` extension
    (added when missing, replacing another one), so ``rose``, ``rose.png`` and ``rose.jpg`` are one
    file. ``None`` when nothing was requested."""
    if not requested or not str(requested).strip():
        return None
    path = str(requested).strip()
    if os.path.splitext(path)[1].casefold() != ".png":
        path = os.path.splitext(path)[0] + ".png"
    return path


def _rs_same_png_text(png_text, poster_text):
    """Error text when the Output PNG and the Output Poster PNG end up in one file, else ``None``."""
    png, poster = _rs_png_name(png_text), _rs_png_name(poster_text)
    if not (png and poster) or not same_dataset(png, poster):
        return None
    return ("The Output PNG '{0}' and the Output Poster PNG '{1}' are the same file '{2}' (both get "
            "the .png extension), so the poster would replace the PNG.".format(
                png_text, poster_text, poster))


def _rs_refuse_same_png(png_text, poster_text):
    """Raise ``ToolError`` when the PNG and the poster would be written to one file."""
    text = _rs_same_png_text(png_text, poster_text)
    if text:
        raise ToolError(text, "Give the poster its own file name, for example '{0}'.".format(
            os.path.splitext(_rs_png_name(poster_text))[0] + "_poster.png"))


def _rs_choose_png(requested, what, inputs):
    """``choose_output_file`` for a PNG; the shared helper says "report", this says ``what``."""
    try:
        return choose_output_file(requested, ".png", inputs=inputs)
    except ToolError as err:
        cause = str(err.cause).replace("The report folder", "The " + what + " folder")
        cause = cause.replace("The report file", "The " + what + " file")
        fix = None if err.fix is None else str(err.fix).replace(
            "Choose an existing folder for the report.", "Choose an existing folder for the " + what + ".")
        fix = None if fix is None else fix.replace("different report name", "different " + what + " name") \
            .replace("another report name", "another " + what + " name")
        raise ToolError(cause, fix)


class RoseDiagramBuilder(object):
    """Rose diagrams of directions per group: frequency table, summary, petals, PNG."""

    DOC = {
        "summary": "Bins directions into 8, 16 or 36 sectors (and optional magnitude classes) per "
                   "group and writes a frequency table, a per-group summary (circular or axial "
                   "mean, mean resultant length, Rayleigh test of uniformity, circular standard "
                   "deviation, entropy), rose "
                   "petals as polygons drawn around each group's anchor on the map, and an "
                   "optional PNG of polar bar charts and an optional poster (a map of the "
                   "features coloured by direction next to the rose). Directions come from a field (points, "
                   "lines) or from the bearings of line segments, for example the dominant "
                   "street orientation per district. The direction convention is chosen "
                   "explicitly and repeated in every output row and in the PNG title. Calls "
                   "nothing above a Basic licence (a Basic run is not proven), no extension.",
        "usage": "The tool calls nothing above a Basic licence and no extension; a run with a "
                 "Basic licence is not verified.\n\n"
                 "Quick start, street orientation of a district: (1) project the streets to a "
                 "metric projected system such as UTM (lines in degrees are refused); (2) Input "
                 "Features = the streets, leave Direction Field empty; (3) Direction Convention = "
                 "AZIMUTH_TO and tick Axial; (4) Number of Sectors = 36; (5) set the two output "
                 "tables and, for a picture, Output Poster PNG; (6) run and read the grid angle in "
                 "the messages (ORTHO_DIR in the summary table).\n\n"
                 "Convention (required, no default): AZIMUTH_FROM = degrees clockwise from north, "
                 "the direction the value comes FROM (wind direction); AZIMUTH_TO = degrees "
                 "clockwise from north, the direction it points TO (heading); ARITHMETIC = degrees "
                 "counter-clockwise from east, converted to a bearing as (90 - value). Petals "
                 "always point at the bearing: north is up on the map and in the PNG. For line "
                 "bearings computed from geometry, AZIMUTH_TO is the direction from the first "
                 "to the last vertex and AZIMUTH_FROM the reverse; AXIAL makes the two the same.\n\n"
                 "AXIAL: a direction and its opposite are one axis (streets, faults, trends). "
                 "Angles are folded into 0-180, the table has sectors/2 bins, every bin is "
                 "drawn twice (opposite petals) and the mean is an axial mean (computed on "
                 "the doubled angles). The summary also gives ORTHO_DIR and ORTHO_R: the angle "
                 "(0-90) around which the axes cluster if the pattern is a square grid, and how "
                 "strongly (computed on the quadrupled angles).\n\n"
                 "Sectors: CENTERED_ON_NORTH puts sector 0 on 0 degrees (N); STARTS_AT_NORTH "
                 "starts it at 0. A sector includes its lower edge and excludes its upper "
                 "edge; angles are wrapped before binning, so 360 is 0, and a bearing "
                 "less than 1e-6 degrees below an edge counts as ON the edge (it belongs to "
                 "the sector that starts there), which absorbs the rounding noise of stored "
                 "coordinates.\n\n"
                 "Lines: without a Direction Field the bearing of every straight segment is "
                 "computed (PER_SEGMENT), or one bearing per part from its first to its last "
                 "vertex (WHOLE_LINE; closed loops have no chord and are skipped). Weight "
                 "by Length (on by default) counts each datum with its length in metres "
                 "(segment length, or the length of the part along its vertices) instead of 1; "
                 "unweighted, a curved street with many vertices outweighs a straight one. Line input must be in a "
                 "projected coordinate system whose units are not distorted (geographic and Web "
                 "Mercator lines are refused: project them first, for example to UTM). Bearings "
                 "are GRID bearings of that projection, measured from grid north, not true "
                 "bearings. In a conformal projection (UTM and other Transverse Mercator, "
                 "Lambert Conformal Conic, Mercator, Stereographic) they differ from true north "
                 "by one angle at each place, the grid convergence, which is 0 on the central "
                 "meridian of a Transverse Mercator zone and grows away from it. In a "
                 "non-conformal projection (equal-area Albers, Lambert Azimuthal Equal Area, "
                 "cylindrical equal area such as EASE-Grid 2.0, equidistant or sinusoidal) the "
                 "difference also depends on the direction and right angles are not kept (a true "
                 "30 degree street reads 27.7 in EASE-Grid 2.0 at Riyadh). The tool measures this "
                 "at the data from the projection itself, reports the convergence, and warns with "
                 "the measured range when the system is not conformal there: project such lines "
                 "to a conformal system (for example UTM) first.\n\n"
                 "Points need a Direction Field. Points in a geographic system are drawn "
                 "in the UTM zone chosen from the data (the directions are used as stored); "
                 "points spread over four or more UTM zones, or where the grid north of that "
                 "zone differs from true north by 5 degrees or more, get a warning: roses far "
                 "from the zone are misplaced and turned, so run each region separately. "
                 "Points already in a projected system are drawn in it; where its grid north "
                 "differs from true north by 5 degrees or more at the data (for example "
                 "Antarctic Polar Stereographic, EPSG 3031, or a south-oriented Transverse "
                 "Mercator, where it can reach 180 degrees) a warning says that petals of true "
                 "bearings are turned by that angle on the map.\n\n"
                 "Rayleigh test: for every group the summary gives RAYLEIGH_Z = n_eff x "
                 "RESULT_R squared and RAYLEIGH_P = exp(sqrt(1 + 4n + 4(n^2 - R^2)) - (1 + 2n)) "
                 "with n = n_eff and R = n_eff x RESULT_R (Zar's approximation of the Rayleigh "
                 "test of uniformity; axial: of the doubled angles). n_eff = (sum of weights)^2 / "
                 "sum of squared weights, which is the number of items when every item counts 1. "
                 "PREF_DIR is 1 when p is below 0.05, and the PNG and the messages show a mean "
                 "direction only then; RESULT_R, n and p are always printed. When an axial "
                 "group's grid test also rejects uniformity and ORTHO_R is above RESULT_R, the "
                 "PNG and the messages name that stronger grid angle next to the axial mean (the "
                 "poster headlines it). With fewer than 3 items the message says the test means "
                 "little (Zar's approximation gives p = 0.47 for one item). The test assumes "
                 "independent items; neighbouring street segments are not, so p is optimistic "
                 "and R is the number to judge the strength by. ORTHO_P is the same test on the "
                 "quadrupled angles (the square-grid angle).\n\n"
                 "Poster (Output Poster PNG): one picture of 2400 x 1260 pixels, no basemap. Left: "
                 "the features as a map, every segment (or point) coloured by the bin of its "
                 "direction, one hue per bin; points that share one location (repeated records "
                 "of a station) are drawn as one small pie of their bins (slice = share of the "
                 "points; above 300 such locations, one dot in the colour of the most frequent "
                 "bin) and the footnote says how many points share how many locations. Right: the rose of the same data (petal area = "
                 "length or count) with the dominant orientation marked. Above: the title "
                 "(Poster Title), a callout (the grid angle where the grid test rejects "
                 "uniformity and either the Rayleigh test does not or ORTHO_R is above RESULT_R, "
                 "else the axial or circular mean where the Rayleigh test rejects uniformity, "
                 "else no dominant direction) and the statistics. Below: a footnote with n and "
                 "what it counts, units, source (Poster Source Note, default the input name), "
                 "convention, weighting, bearing reference and the caveat that the Rayleigh and "
                 "grid tests treat the items as independent, which neighbouring street segments "
                 "are not, so they are optimistic. With a Group Field the poster describes all "
                 "groups together. Magnitude classes are not shown (a petal is the total). Above "
                 "400,000 items the map shows a random sample (fixed seed) and the footnote "
                 "says so; the rose and the numbers always use every item. Poster Theme: DARK or "
                 "LIGHT. Needs matplotlib; without it a warning is given and nothing else changes. "
                 "Titles and source notes must be Latin text: letters, digits and punctuation, "
                 "including curly quotes, dashes and the ellipsis (matplotlib does not shape "
                 "Arabic or other joined scripts).\n\n"
                 "Magnitude classes: give a numeric Magnitude Field and Class Breaks "
                 "(for example 2,5,10) to stack the petals by class; a value equal to a break "
                 "belongs to the upper class. Rows without a usable magnitude are left out and "
                 "counted.\n\n"
                 "Petals: area is proportional to the weight of the sector (a count, or metres "
                 "of line). A petal reaching cumulative weight c has radius R*sqrt(c/REF), "
                 "where R is the Petal Radius in metres and REF the largest sector total of "
                 "its group (PER_GROUP: every rose has the same size, to compare shapes) or of "
                 "all groups (ALL_GROUPS: roses of larger groups are larger). The rule, R and "
                 "REF are stored in every petal row (SCALE_RULE). Without a Petal Radius it is "
                 "40 % of the smallest distance between two roses (one rose: 10 % of the "
                 "diagonal of the extent of the data locations, which are the segment or chord "
                 "midpoints for lines and the points themselves; 100 m when that extent is zero, "
                 "for example a single segment). A warning appears when the petals would be "
                 "too small to see: a radius below 0.01 m, or an automatic radius set by two roses much closer "
                 "than the others (closest distance below 2.5 % of the data diagonal and below a "
                 "tenth of the typical spacing, diagonal / sqrt(number of roses)), for example "
                 "concentric zones. Anchors: GROUP_CENTROID (weighted mean of the "
                 "locations), GROUP_EXTENT_CENTRE, FIELD_XY (the first X/Y pair of the group "
                 "in two fields) or SINGLE_POINT (every rose at one point). FIELD_XY and "
                 "SINGLE_POINT coordinates are in the coordinate system of the input: for points "
                 "in a geographic system they are longitude (X) and latitude (Y) in degrees, and "
                 "the tool projects them to the UTM zone the roses are drawn in (values outside "
                 "-180..180 / -90..90 are refused); ANCHOR_X/ANCHOR_Y in the summary are in the "
                 "output system. A warning appears when a rose lies more than 10 times the size "
                 "of the data extent outside the data.\n\n"
                 "Direction values outside -360 to 360 are wrapped and counted; a warning "
                 "appears when 10 or more values all fit in one turn of radians: between 0 and "
                 "6.28, between -3.14 and 3.14 (signed radians, as from atan2) or any other range "
                 "of at most 6.28 within -6.28..6.28 (radians?). Rows with no "
                 "direction, magnitude or geometry are left out and counted. The input is never "
                 "edited. Selections and definition queries on the input layer are honoured.\n\n"
                 "Built-in alternatives: ArcGIS Pro charts have no rose or direction chart; the wind "
                 "rose report of Generate Desire Lines requires Business Analyst and Network "
                 "Analyst.",
        "params": {
            "in_features": "Point or line features. Lines must be in a projected coordinate system "
                           "(not degrees, not Web Mercator); points need a Direction Field. "
                           "Selections and definition queries on a layer are honoured.",
            "direction_field": "Numeric field with the direction in degrees, read as set in "
                               "Direction Convention. Required for points. For lines leave it empty "
                               "to use the bearing of every segment. Example: a field WD with 270 "
                               "in a row means 'a wind from the west' under AZIMUTH_FROM.",
            "convention": "Required, no default: what the numbers mean. The petal always points at "
                          "the bearing (clockwise from north, north up).\n\n"
                          "AZIMUTH_TO: degrees clockwise from north, the direction it points or "
                          "travels TO. Example: 90 is a vehicle heading east, the petal points "
                          "east.\n\n"
                          "AZIMUTH_FROM: degrees clockwise from north, the direction it comes FROM "
                          "(meteorological wind). Example: 270 is a wind blowing from the west, "
                          "the petal points west. Lines are read from the last vertex back to the "
                          "first.\n\n"
                          "ARITHMETIC: degrees counter-clockwise from east (the maths angle), "
                          "turned into a bearing as 90 minus the value. Example: 0 is east, 90 is "
                          "north, 180 is west.\n\n"
                          "The choice is repeated in every output row.",
            "axial": "Check when a direction and its opposite are the same thing: streets, "
                     "faults, trends. Example: 10 and 190 degrees fall into the same bin and every "
                     "bin is drawn twice, mirrored; the mean is an axial mean. Leave unchecked for "
                     "real headings or winds, where 10 and 190 differ. For streets: check it.",
            "sectors": "Number of sectors in 360 degrees: 8 (45 degrees each), 16 (22.5) or 36 "
                       "(10). Axial data use half as many bins in 180 degrees.",
            "sector_alignment": "CENTERED_ON_NORTH: sector 0 is centred on north (16 sectors: "
                                "348.75 to 11.25 degrees), so N, E, S and W are sector centres. "
                                "STARTS_AT_NORTH: sector 0 starts at north (0 to 22.5).",
            "group_field": "Optional field; one rose per value, for example a district. Without "
                           "it there is one group, ALL.",
            "magnitude_field": "Optional numeric field (wind speed, ...) used to stack petals "
                               "by class. Needs Class Breaks.",
            "class_breaks": "Increasing class limits such as 2,5,10 (up to 7 breaks). Example: "
                            "2,5,10 gives the classes < 2, 2 to < 5, 5 to < 10 and >= 10; a "
                            "value equal to a break belongs to the upper class.",
            "line_mode": "Lines without a Direction Field. PER_SEGMENT: the bearing of every "
                         "straight segment (use this for streets). WHOLE_LINE: one bearing per "
                         "line part, from its first to its last vertex (closed loops are skipped).",
            "weight_by_length": "Lines: count each datum (segment, line part or line) by its length "
                                "in metres instead of 1. On by default. Example: a 300 m street at "
                                "10 degrees and a 100 m street at 100 degrees give the weights "
                                "300 and 100; unchecked both count 1, and a street digitised with "
                                "40 vertices outweighs a straight one with 2 (the run warns). "
                                "Ignored for points.",
            "anchor_mode": "Where each rose is drawn: GROUP_CENTROID, GROUP_EXTENT_CENTRE, "
                           "FIELD_XY or SINGLE_POINT.",
            "anchor_x_field": "FIELD_XY: numeric field with the X coordinate of the rose, in the "
                              "coordinate system of the input (longitude in degrees for points "
                              "in a geographic system; the tool projects it).",
            "anchor_y_field": "FIELD_XY: numeric field with the Y coordinate of the rose, in the "
                              "coordinate system of the input (latitude in degrees for points "
                              "in a geographic system; the tool projects it).",
            "anchor_x": "SINGLE_POINT: X coordinate in the coordinate system of the input "
                        "(longitude in degrees for points in a geographic system; the tool "
                        "projects it to the UTM zone it draws in).",
            "anchor_y": "SINGLE_POINT: Y coordinate in the coordinate system of the input "
                        "(latitude in degrees for points in a geographic system).",
            "petal_radius_m": "Radius in metres of the largest petal; empty = automatic: 40 % "
                              "of the smallest distance between two roses, or for one rose 10 % "
                              "of the diagonal of the extent of the segment midpoints "
                              "(WHOLE_LINE: of the chord midpoints; points: of the points), and "
                              "100 m when that extent is zero. A warning appears when the petals "
                              "would be too small to see (below 0.01 m, or two roses much closer "
                              "than the others).",
            "scale_mode": "PER_GROUP (every rose the same size, to compare shapes) or ALL_GROUPS "
                          "(one common scale, larger groups get larger roses).",
            "out_table": "Output frequency table: one row per group, sector and class.",
            "out_summary": "Output per-group summary table with the statistics.",
            "out_petals": "Optional output polygon feature class with one polygon per petal.",
            "out_png": "Optional PNG with one polar bar chart per group (needs matplotlib). The "
                       "file always gets the .png extension; it must not be the same file as the "
                       "Output Poster PNG (rose and rose.png are one file and are refused).",
            "out_poster": "Optional poster PNG (2400 x 1260 pixels, no basemap): left the features "
                          "as a map coloured by direction bin, right the rose with the dominant "
                          "orientation marked and the grid test; title, statistics and an honest "
                          "footnote (n, units, source, convention, optimistic test). With a Group "
                          "Field all groups are shown together. Needs matplotlib.",
            "poster_title": "Optional title of the poster, Latin letters, digits and punctuation "
                            "(curly quotes and dashes are fine; at most 110 characters; default: "
                            "'Which way do the lines point?' when the directions come from the "
                            "line geometry, else 'Which way do the features point?').",
            "poster_source": "Optional source note for the footnote of the poster, for example "
                             "'Overture Maps roads 2026-10-21' (default: the name of the input).",
            "poster_theme": "DARK (default) or LIGHT colours of the poster.",
            "group_count": "Number of groups (derived).",
            "item_count": "Number of directions used (derived).",
        },
        "tags": ["rose diagram", "wind rose", "orientation", "circular statistics", "basic"],
    }

    def __init__(self):
        self.label = "Rose Diagram"
        self.description = ("Rose diagrams of directions per group: frequency table, circular "
                            "statistics, petal polygons and a PNG, on a Basic licence (v"
                            + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_features", "Input Features", "GPFeatureLayer",
                       value_list=["Point", "Polyline"]),
            make_param("direction_field", "Direction Field (degrees)", "Field", required=False,
                       depends_on="in_features", value_list=_RS_NUMERIC),
            make_param("convention", "Direction Convention", "GPString",
                       value_list=list(ROSE_CONVENTIONS)),
            make_param("axial", "Axial (a direction and its opposite are one axis)", "GPBoolean",
                       required=False, default=False),
            make_param("sectors", "Number of Sectors", "GPLong", required=False, default=16,
                       value_list=list(ROSE_SECTOR_CHOICES)),
            make_param("sector_alignment", "Sector Alignment", "GPString", required=False,
                       default=ROSE_ALIGN_CENTERED, value_list=list(ROSE_ALIGNMENTS)),
            make_param("group_field", "Group Field", "Field", required=False,
                       depends_on="in_features"),
            make_param("magnitude_field", "Magnitude Field", "Field", required=False,
                       depends_on="in_features", value_list=_RS_NUMERIC),
            make_param("class_breaks", "Magnitude Class Breaks", "GPString", required=False),
            make_param("line_mode", "Line Bearings", "GPString", required=False,
                       default=ROSE_LINE_SEGMENT, value_list=list(ROSE_LINE_MODES)),
            make_param("weight_by_length", "Weight Lines by Length", "GPBoolean", required=False,
                       default=True),
            make_param("anchor_mode", "Rose Location", "GPString", required=False,
                       default=ROSE_ANCHOR_CENTROID, value_list=list(ROSE_ANCHOR_MODES)),
            make_param("anchor_x_field", "Anchor X Field", "Field", required=False,
                       depends_on="in_features", value_list=_RS_NUMERIC, enabled=False),
            make_param("anchor_y_field", "Anchor Y Field", "Field", required=False,
                       depends_on="in_features", value_list=_RS_NUMERIC, enabled=False),
            make_param("anchor_x", "Anchor X", "GPDouble", required=False, enabled=False),
            make_param("anchor_y", "Anchor Y", "GPDouble", required=False, enabled=False),
            make_param("petal_radius_m", "Petal Radius (m)", "GPDouble", required=False),
            make_param("scale_mode", "Petal Scale", "GPString", required=False,
                       default=ROSE_SCALE_PER_GROUP, value_list=list(ROSE_SCALE_MODES)),
            make_param("out_table", "Output Frequency Table", "DETable", direction="Output"),
            make_param("out_summary", "Output Summary Table", "DETable", direction="Output"),
            make_param("out_petals", "Output Petal Polygons", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("out_png", "Output PNG", "DEFile", direction="Output", required=False,
                       value_list=["png"]),
            make_param("out_poster", "Output Poster PNG (map + rose)", "DEFile",
                       direction="Output", required=False, value_list=["png"]),
            make_param("poster_title", "Poster Title", "GPString", required=False),
            make_param("poster_source", "Poster Source Note", "GPString", required=False),
            make_param("poster_theme", "Poster Theme", "GPString", required=False,
                       default=ROSE_POSTER_THEMES[0], value_list=list(ROSE_POSTER_THEMES)),
            derived_output("group_count", "Group Count", "GPLong"),
            derived_output("item_count", "Direction Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        p = param_map(parameters)
        mode = param_text(p["anchor_mode"])
        p["anchor_x_field"].enabled = mode == ROSE_ANCHOR_FIELDS
        p["anchor_y_field"].enabled = mode == ROSE_ANCHOR_FIELDS
        p["anchor_x"].enabled = mode == ROSE_ANCHOR_POINT
        p["anchor_y"].enabled = mode == ROSE_ANCHOR_POINT
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        text = param_text(p["class_breaks"])
        if text:
            try:
                rose_parse_breaks(text)
            except ValueError as exc:
                p["class_breaks"].setErrorMessage("Use increasing numbers such as 2,5,10 ({0})."
                                                  .format(exc))
        if param_text(p["magnitude_field"]) and not text:
            p["class_breaks"].setErrorMessage("A Magnitude Field needs Class Breaks, for example "
                                              "2,5,10.")
        if text and not param_text(p["magnitude_field"]):
            p["magnitude_field"].setErrorMessage("Class Breaks need a Magnitude Field.")
        radius = p["petal_radius_m"].value
        if radius is not None and float(radius) <= 0:
            p["petal_radius_m"].setErrorMessage("The radius must be above zero; leave it empty "
                                                "for an automatic radius.")
        same = _rs_same_png_text(param_text(p["out_png"]), param_text(p["out_poster"]))
        if same:
            p["out_poster"].setErrorMessage(same + " Give the poster its own file name.")
        mode = param_text(p["anchor_mode"])
        if mode == ROSE_ANCHOR_FIELDS and not (param_text(p["anchor_x_field"])
                                               and param_text(p["anchor_y_field"])):
            p["anchor_y_field"].setErrorMessage("FIELD_XY needs an Anchor X Field and an Anchor "
                                                "Y Field.")
        if mode == ROSE_ANCHOR_POINT and (p["anchor_x"].value is None
                                          or p["anchor_y"].value is None):
            p["anchor_y"].setErrorMessage("SINGLE_POINT needs Anchor X and Anchor Y.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            flush_messages(collector)
            raise

    # ------------------------------------------------------------------
    def _field(self, desc, p, name, label, numeric=False, required=False):
        wanted = param_text(p[name])
        if not wanted:
            if required:
                raise ToolError("No {0} was given.".format(label), "Choose a field.")
            return None
        field, _how = match_field(desc["fields"], wanted, True, label, exact_name_first=True)
        if numeric and field["type"] not in _RS_NUMERIC_FIELD_TYPES:
            raise ToolError("The {0} '{1}' is not a numeric field (type {2}).".format(
                label, field["name"], field["type"]),
                "Choose a Short, Long, Float or Double field; a number stored as text is not "
                "read.")
        return field["name"]

    def _options(self, p, kind, has_direction_field):
        convention = (param_text(p["convention"]) or "").upper()
        if convention not in ROSE_CONVENTIONS:
            raise ToolError("No direction convention was chosen.",
                            "Choose one of {0}: the tool has no default because the same "
                            "numbers mean different directions in each.".format(
                                ", ".join(ROSE_CONVENTIONS)))
        breaks = []
        try:
            breaks = rose_parse_breaks(param_text(p["class_breaks"]))
        except ValueError as exc:
            raise ToolError("The class breaks are not valid: {0}.".format(exc),
                            "Use increasing numbers such as 2,5,10.")
        radius = param_number(p["petal_radius_m"])
        anchor_xy = None
        if param_text(p["anchor_mode"]) == ROSE_ANCHOR_POINT:
            ax, ay = param_number(p["anchor_x"]), param_number(p["anchor_y"])
            if ax is None or ay is None:
                raise ToolError("SINGLE_POINT needs Anchor X and Anchor Y.",
                                "Enter both coordinates.")
            anchor_xy = (ax, ay)
        geometry = kind == GEOM_POLYLINE and not has_direction_field
        source = "FIELD"
        if geometry:
            source = param_text(p["line_mode"]) or ROSE_LINE_SEGMENT
            source = "SEGMENT" if source == ROSE_LINE_SEGMENT else "WHOLE_LINE"
        try:
            return rose_options(
                convention, axial=param_bool(p["axial"], False),
                sectors=int(param_number(p["sectors"], 16)),
                alignment=param_text(p["sector_alignment"]) or ROSE_ALIGN_CENTERED,
                breaks=breaks, line_mode=param_text(p["line_mode"]) or ROSE_LINE_SEGMENT,
                weight_length=param_bool(p["weight_by_length"], True) and kind == GEOM_POLYLINE,
                scale_mode=param_text(p["scale_mode"]) or ROSE_SCALE_PER_GROUP,
                radius_m=radius, anchor_mode=param_text(p["anchor_mode"]) or ROSE_ANCHOR_CENTROID,
                anchor_xy=anchor_xy, dir_source=source,
                north_ref="GRID" if geometry else "AS_STORED")
        except ValueError as exc:
            raise ToolError("An option is not valid: {0}.".format(exc),
                            "Choose a value from the list of the parameter.")

    def _run(self, parameters, p, collector):
        # Outputs are checked before any work (rule 4/13).
        table_path = param_text(p["out_table"])
        summary_path = param_text(p["out_summary"])
        petals_path = param_text(p["out_petals"])
        outputs = [o for o in (table_path, summary_path, petals_path) if o]
        # R13-1: the PNG and the poster are compared AFTER the .png extension is given to both
        # (``rose`` and ``rose.png`` are one file); before, the poster silently replaced the PNG.
        png_text, poster_text = param_text(p["out_png"]), param_text(p["out_poster"])
        _rs_refuse_same_png(png_text, poster_text)
        files = [_rs_png_name(t) for t in (png_text, poster_text) if t]
        refuse_duplicate_outputs(outputs + files)
        png_path = _rs_choose_png(png_text, "PNG", input_texts(p))
        poster_path = _rs_choose_png(poster_text, "poster", input_texts(p))
        theme = (param_text(p["poster_theme"]) or ROSE_POSTER_THEMES[0]).upper()
        if theme not in ROSE_POSTER_THEMES:
            raise ToolError("The poster theme '{0}' is not valid.".format(theme),
                            "Choose one of {0}.".format(", ".join(ROSE_POSTER_THEMES)))
        desc = describe_dataset(param_text(p["in_features"]))
        inputs = [desc["catalog_path"]]
        for out in outputs:
            check_output_path(out, inputs)
        kind = kind_from_shape_type(desc["shape_type"])
        if kind not in (GEOM_POINT, GEOM_POLYLINE):
            raise ToolError("The input must contain points or lines.",
                            "Choose a point or line layer (multipoints and polygons are not "
                            "supported).")
        dir_name = self._field(desc, p, "direction_field", "Direction Field", numeric=True,
                               required=kind == GEOM_POINT)
        group_name = self._field(desc, p, "group_field", "Group Field")
        mag_name = self._field(desc, p, "magnitude_field", "Magnitude Field", numeric=True)
        ax_name = ay_name = None
        if param_text(p["anchor_mode"]) == ROSE_ANCHOR_FIELDS:
            ax_name = self._field(desc, p, "anchor_x_field", "Anchor X Field", numeric=True,
                                  required=True)
            ay_name = self._field(desc, p, "anchor_y_field", "Anchor Y Field", numeric=True,
                                  required=True)
        opts = self._options(p, kind, bool(dir_name))
        if opts["breaks"] and not mag_name:
            raise ToolError("Class breaks were given without a Magnitude Field.",
                            "Choose a Magnitude Field or remove the breaks.")
        if mag_name and not opts["breaks"]:
            raise ToolError("A Magnitude Field was given without Class Breaks.",
                            "Enter breaks such as 2,5,10.")

        # Measuring system. Lines are never re-projected: bearings in degrees or in a distorted
        # system would be wrong, so they are refused with the fix.
        decision, sr = metric_sr_or_native(desc)
        collector.info(decision["reason"])
        datum_notes = decision.get("datum_warnings")
        for text in decision["warnings"]:
            if datum_notes is not None and text not in datum_notes:
                # the wide-data advice of the shared helper (equal-area) does not suit bearings
                text = _rs_zone_warning(decision, kind)
            if text:
                collector.warning(text)
        if kind == GEOM_POLYLINE and decision.get("reproject"):
            info = desc["sr"] or {}
            raise ToolError(
                "The lines are in {0} ({1}), where bearings and lengths are not undistorted "
                "(degrees, or Web Mercator).".format(
                    info.get("name") or "an unknown system", info.get("type") or "unknown type"),
                "Project the lines to a projected coordinate system suited to the area, for "
                "example the UTM zone (Project tool), and run the tool again.")
        opts["mpu"] = float(decision.get("meters_per_unit") or 1.0)
        out_sr = sr if sr is not None else desc["sr_object"]
        out_wkid = decision["wkid"] if sr is not None else (desc["sr"] or {}).get("wkid")
        crs_name = (out_sr.name if out_sr is not None else "") or ""
        # Anchor coordinates are in the input's own system. When the points are drawn in another
        # system (geographic or Web Mercator points go to a UTM zone), they are projected too.
        project_anchor = kind == GEOM_POINT and sr is not None
        geographic = (desc["sr"] or {}).get("type") == "Geographic"
        if project_anchor and opts["anchor_xy"] is not None:
            opts["anchor_xy"] = _rs_project_xy(opts["anchor_xy"], desc["sr_object"], sr,
                                               geographic, "The SINGLE_POINT anchor")
            collector.info("The SINGLE_POINT anchor was read in {0} and projected to {1}: "
                           "({2:.2f}, {3:.2f}).".format(
                               (desc["sr"] or {}).get("name") or "the input system", crs_name,
                               opts["anchor_xy"][0], opts["anchor_xy"][1]))

        fields =[f for f in (dir_name, group_name, mag_name, ax_name, ay_name) if f]
        fields = list(dict.fromkeys(fields))
        # Features are streamed through the collector: only the running sums of the groups (and,
        # for a poster, a bounded sample for its map) stay in memory, however many features there are.
        curved = {"n": 0, "oids": []}
        rows = _rs_iter_rows(desc["input"], fields, None if kind == GEOM_POLYLINE else sr, curved)
        if dir_name:
            opts["dir_source"] = "FIELD:" + dir_name
        sample = RoseMapSample(points=kind == GEOM_POINT) if poster_path else None
        try:
            col = rose_collect(rows, kind, opts, direction_field=dir_name, group_field=group_name,
                               magnitude_field=mag_name, anchor_x_field=ax_name,
                               anchor_y_field=ay_name, overall=bool(poster_path and group_name),
                               sample=sample, max_groups=_RS_MAX_GROUPS)
        except RoseTooManyGroups as exc:
            # Refused while reading: a unique-ID group field must not fill the memory first.
            raise ToolError("The Group Field has more than {0} distinct values (found at feature "
                            "{1:,} of the input); at most {0} roses are written, and nothing was "
                            "written.".format(exc.limit, exc.rows_read),
                            "Use a coarser group field or select a part of the data.")
        if project_anchor and ax_name:
            done = 0
            for grp in col.groups.values():
                if grp.field_xy is not None:
                    grp.field_xy = _rs_project_xy(
                        grp.field_xy, desc["sr_object"], sr, geographic,
                        "The anchor of group '{0}' (fields {1}, {2})".format(
                            grp.name, ax_name, ay_name))
                    done += 1
            if done:
                collector.info("The anchor fields {0}/{1} were read in {2} and projected to {3} "
                               "for {4} group(s).".format(
                                   ax_name, ay_name,
                                   (desc["sr"] or {}).get("name") or "the input system",
                                   crs_name, done))
        collector.info("{0} feature(s) read. Convention {1}: {2}. AXIAL {3}; {4} sectors, {5}."
                       .format(col.rows_read, opts["convention"],
                               ROSE_CONVENTION_TEXT[opts["convention"]],
                               "on" if opts["axial"] else "off", opts["sectors"],
                               _RS_SHORT[opts["alignment"]]))
        check = _rs_bearing_check(out_sr, list(col.groups.values()))
        self._messages(col, kind, opts, dir_name, curved, crs_name, desc, sr, collector, check,
                       decision)
        groups = col.ordered_groups()
        if len(groups) > _RS_MAX_GROUPS:
            raise ToolError("The Group Field has {0} distinct values; at most {1} roses are "
                            "written.".format(len(groups), _RS_MAX_GROUPS),
                            "Use a coarser group field or select a part of the data.")
        if len(groups) > _RS_WARN_GROUPS:
            collector.warning("{0} groups give {0} roses; the tables are large.".format(len(groups)))

        plan = rose_plan(col, opts["radius_m"])
        if opts["anchor_mode"] in (ROSE_ANCHOR_FIELDS, ROSE_ANCHOR_POINT):
            far = _rs_far_anchors(plan, opts)
            if far:
                collector.warning(
                    "The rose of {0} group(s) lies far outside the data (more than 10 times the "
                    "size of the data extent): {1}. Anchor coordinates must be in the input's "
                    "coordinate system (longitude/latitude for geographic points); check their "
                    "system and units.".format(len(far), analysis_oid_text(far)))
        table_rows = rose_table_rows(groups, opts)
        summary_rows = rose_summary_rows(plan, opts, crs_name)
        petal_records = rose_petal_records(plan, opts) if petals_path else []
        if petals_path:
            collector.info("Petal radius R = {0:.6g} m ({1}). Petal area is proportional to "
                           "the weight ({2}) of the sector: radius = R*sqrt(cumulative "
                           "weight/REF), REF = largest sector total of {3}.".format(
                               plan["radius_m"], plan["radius_how"],
                               "metres of line" if opts["weight_length"] else "count",
                               "its group" if opts["scale_mode"] == ROSE_SCALE_PER_GROUP
                               else "all groups"))
            small = rose_radius_warning(plan, opts)
            if small:
                collector.warning(small)
            missing = [g.name for g in groups if g.n > 0 and plan["anchors"][g.name] is None]
            if missing:
                collector.warning("{0} group(s) have no location for their rose and no petals: "
                                  "{1}.".format(len(missing), analysis_oid_text(missing)))
            placed = [plan["anchors"][g.name] for g in groups
                      if g.n > 0 and plan["anchors"][g.name] is not None]
            distinct = len(set((round(x, 6), round(y, 6)) for x, y in placed))
            if opts["anchor_mode"] != ROSE_ANCHOR_POINT and distinct < len(placed):
                collector.warning("{0} rose(s) share a location with another rose and are drawn "
                                  "on top of each other ({1} distinct locations for {2} roses). "
                                  "Use another Rose Location or a coarser Group Field.".format(
                                      len(placed) - distinct, distinct, len(placed)))

        created = []
        null_fields = set()
        try:
            for path, fields_def, rows_out, label in (
                    (table_path, ROSE_TABLE_FIELDS, table_rows, "frequency table"),
                    (summary_path, ROSE_SUMMARY_FIELDS, summary_rows, "summary table")):
                specs = _rs_specs(fields_def, rows_out)
                specs, _renamed = plan_output_fields(path, specs, fixed=len(specs))
                made, fmap = create_table(path, specs, inputs=inputs)
                created.append(made)
                nulls = set()
                insert_rows(made, [fmap[s["name"]] for s in specs],
                            [[r[name] for name, _k in fields_def] for r in rows_out],
                            null_fields=nulls)
                note = folder_null_number_warning(made, specs, fmap, nulls)
                if note:
                    collector.warning(note)
                collector.info("{0} row(s) written to the {1} {2}.".format(
                    len(rows_out), label, made))
            if petals_path:
                specs = _rs_specs(ROSE_PETAL_FIELDS, [v for _r, v in petal_records])
                specs, _renamed = plan_output_fields(petals_path, specs, fixed=len(specs))
                made, fmap = create_feature_class(petals_path, GEOM_POLYGON, out_sr, specs,
                                                  inputs=inputs)
                created.append(made)
                insert_rows(made, [fmap[s["name"]] for s in specs],
                            [([ring], [v[name] for name, _k in ROSE_PETAL_FIELDS])
                             for ring, v in petal_records],
                            kind=GEOM_POLYGON, wkid=out_wkid, null_fields=null_fields)
                collector.info("{0} petal polygon(s) written to {1}, in {2}.".format(
                    len(petal_records), made, crs_name or "the input coordinate system"))
        except Exception:
            for done in created:  # never leave part of the output behind
                try:
                    safe_delete(done, inputs)
                except Exception:
                    pass
            raise

        if png_path:
            self._png(png_path, plan, opts, col, crs_name, collector)
        if poster_path:
            self._poster(poster_path, col, sample, opts, crs_name, desc, group_name, theme,
                         param_text(p["poster_title"]), param_text(p["poster_source"]), collector)
        for row in summary_rows[:10]:
            if row["N_ITEMS"]:
                collector.info(_rs_group_line(row, opts))
        if len(summary_rows) > 10:
            collector.info("... and {0} more group(s) in the summary table.".format(
                len(summary_rows) - 10))
        set_derived_output(parameters, "group_count", str(len(groups)))
        set_derived_output(parameters, "item_count", str(col.used))
        flush_messages(collector)

    def _messages(self, col, kind, opts, dir_name, curved, crs_name, desc, sr, collector,
                  check=None, decision=None):
        sk = col.skipped
        conformal = check is None or check["conformal"]
        if check is not None and conformal:
            measured = (" Measured at the data ({0}): a true bearing B reads B + c on "
                        "this grid, with c {1}.".format(_rs_where(check), _rs_conv_text(check)))
        elif check is not None:
            measured = (" Here the difference also depends on the direction (next warning); "
                        "the grid convergence alone is {0}.".format(_rs_conv_text(check)))
        else:
            measured = " (The difference could not be measured for this coordinate system.)"
        if opts["north_ref"] == "GRID":
            collector.warning(
                "Bearings were computed from the line geometry in {0} and are GRID bearings "
                "(from the grid north of that projection), not true bearings. In a conformal "
                "projection they differ from true north by the grid convergence at each place "
                "(0 on the central meridian of a Transverse Mercator zone, growing away from "
                "it).{1}".format(crs_name or "the input coordinate system", measured))
            if not conformal:
                collector.warning(_rs_not_conformal_text(check, crs_name, True))
        elif sr is not None:
            collector.warning(
                "The points are drawn in {0}; their direction values are used as stored and are "
                "assumed to be measured from true north, while the petals are drawn relative to "
                "the grid north of that system (the difference is the grid convergence).{1}"
                .format(crs_name, measured))
            zones = int((decision or {}).get("utm_zones") or 1)
            big = check is not None and _rs_conv_abs(check) >= _RS_WIDE_CONVERGENCE_DEG
            if big or zones >= _RS_WIDE_ZONES:
                collector.warning(
                    "The points span {0} UTM zone(s) but every rose is drawn in the one zone "
                    "{1}{2}. Far from the centre of that zone the roses are placed with large "
                    "distortion and turned against true north; for data spread over a "
                    "continent or the world the positions of the roses are not meaningful (the "
                    "tables are not affected). Run the tool on each region separately, or "
                    "project the points to a system suited to each region first.".format(
                        zones, crs_name,
                        "" if check is None else
                        ", whose grid north differs from true north by up to {0:.1f} degrees at "
                        "the {1}".format(_rs_conv_abs(check), _rs_where_short(check))))
        else:
            collector.info("Direction values are used as stored. Petals are drawn relative to "
                           "the grid north of the map; if the values are true bearings they "
                           "differ by the grid convergence of the coordinate system.{0}".format(
                               measured))
            if check is not None and _rs_conv_abs(check) >= _RS_WIDE_CONVERGENCE_DEG:
                collector.warning(_rs_turned_text(check, crs_name))
            if not conformal:
                collector.warning(_rs_not_conformal_text(check, crs_name, False))
        if kind == GEOM_POLYLINE and not dir_name and not opts["weight_length"]:
            collector.warning(
                "Weight Lines by Length is off: every straight segment (or line part) counts "
                "1, so a street digitised with many vertices counts more than a straight "
                "street, and N_ITEMS counts segments, not features. Switch it on for the usual "
                "street-orientation result.")
        if kind == GEOM_POLYLINE and opts["weight_length"]:
            collector.info("Lines are weighted by length: every {0} counts with its length in "
                           "metres. N_ITEMS counts {1}, WEIGHT is in metres.".format(
                               "line" if dir_name else "segment (or line part)",
                               "lines" if dir_name else "segments (or line parts), not features"))
        if opts["axial"] and kind == GEOM_POLYLINE and not dir_name:
            collector.info("AXIAL is on: a line and its reverse count as the same axis.")
        if not opts["axial"] and kind == GEOM_POLYLINE and not dir_name:
            collector.info("AXIAL is off: the digitising direction (first to last vertex) of "
                           "every line matters. Streets usually have none; switch AXIAL on.")
        used_text = "{0} direction(s) used in {1} group(s).".format(col.used, len(col.groups))
        collector.info(used_text)
        for key, text in (("no_direction", "feature(s) without a usable direction value"),
                          ("no_magnitude", "direction(s) without a usable magnitude"),
                          ("no_geometry", "feature(s) without geometry"),
                          ("zero_length", "zero-length segment(s)"),
                          ("zero_chord", "line part(s) with identical first and last vertex "
                                         "(no chord)"),
                          ("no_length", "feature(s) without geometry, so without a length weight"),
                          ("zero_weight", "item(s) with a zero length weight (zero-length lines "
                                          "weighted by length)")):
            if sk[key]:
                collector.warning("{0} {1} left out.".format(sk[key], text))
        if curved["n"]:
            collector.warning("{0} line feature(s) with true curves were left out: OID {1}. "
                              "Densify them first.".format(
                                  curved["n"], analysis_oid_text(curved["oids"])))
        if col.wrapped:
            collector.warning("{0} direction value(s) lie outside -360 to 360 and were wrapped "
                              "into 0-360.".format(col.wrapped))
        if col.looks_like_radians():
            collector.warning("All {0} direction values lie between {1:g} and {2:g}: are they "
                              "radians? This tool expects degrees.".format(
                                  col.value_n, col.value_min, col.value_max))
        if not col.used:
            collector.warning("No direction could be used, so the tables hold zero counts.")
        conflicts = [g.name for g in col.groups.values() if g.xy_conflicts]
        if conflicts:
            collector.warning("The anchor fields differ within {0} group(s); the first X/Y pair "
                              "of each is used: {1}.".format(len(conflicts),
                                                            analysis_oid_text(conflicts)))
        if opts["anchor_mode"] == ROSE_ANCHOR_POINT and len(col.groups) > 1:
            collector.warning("SINGLE_POINT: all {0} roses are drawn at the same point and "
                              "overlap.".format(len(col.groups)))

    def _png(self, png_path, plan, opts, col, crs_name, collector):
        if not any(g.n > 0 for g in plan["groups"]):
            collector.warning("The PNG was not written: no group has a usable direction.")
            return
        if not rose_png_available():
            collector.warning("The PNG was not written: matplotlib is not installed in this "
                              "Python environment. The tables and polygons are not affected.")
            return
        try:
            note = "Coordinate system: {0}.".format(crs_name) if crs_name and \
                opts["north_ref"] == "GRID" else ""
            drawn, extra = rose_render_png(png_path, plan, opts, note)
        except Exception as exc:  # a drawing problem must not discard the tables
            collector.warning("The PNG could not be written ({0}: {1}). The tables and polygons "
                              "were written.".format(type(exc).__name__, exc))
            return
        collector.info("PNG with {0} rose(s) written to {1}. {2}".format(drawn, png_path,
                                                                         extra).strip())

    def _poster(self, poster_path, col, sample, opts, crs_name, desc, group_name, theme, title,
                source, collector):
        group = col.poster_group()
        if group is None or not group.weight > 0:
            collector.warning("The poster was not written: no direction could be used.")
            return
        if not rose_poster_available():
            collector.warning("The poster was not written: matplotlib is not installed in this "
                              "Python environment. The tables and polygons are not affected.")
            return
        title = rose_clean_text(title)
        if title and not rose_is_latin(title):
            collector.warning("The poster title contains characters the poster cannot draw ({0}); "
                              "it draws Latin letters, digits and punctuation (matplotlib does not "
                              "shape Arabic or other joined scripts). The default title is "
                              "used.".format(", ".join(rose_unsupported_chars(title))))
            title = ""
        if len(title) > _RS_MAX_TITLE:
            collector.warning("The poster title was shortened to {0} characters.".format(
                _RS_MAX_TITLE))
            title = title[:_RS_MAX_TITLE - 3].rstrip() + "..."
        source = rose_clean_text(source)
        if source and not rose_is_latin(source):
            collector.warning("The poster source note contains characters the poster cannot draw "
                              "({0}); it draws Latin letters, digits and punctuation. The name of "
                              "the input dataset is used.".format(
                                  ", ".join(rose_unsupported_chars(source))))
            source = ""
        meta = {"title": title, "source": source or _rs_dataset_name(desc["catalog_path"]),
                "crs_note": crs_name if opts["north_ref"] == "GRID" else "",
                "features": col.features_used, "has_group_field": bool(group_name),
                "scale_bar": bool(crs_name), "generator": "RoseDiagramBuilder " + __version__}
        try:
            info = rose_render_poster(poster_path, group, sample, opts, meta, theme)
        except Exception as exc:  # a drawing problem must not discard the tables
            collector.warning("The poster could not be written ({0}: {1}). The tables and "
                              "polygons were written.".format(type(exc).__name__, exc))
            return
        collector.info("Poster ({0} x {1} px, {2}) written to {3}: {4}. The map shows {5} of {6} "
                       "{7}.{8}".format(info["size"][0], info["size"][1], theme.lower(),
                                        poster_path,
                                        info["headline"].replace(u"\u00b0", " degrees"),
                                        info["drawn"],
                                        info["offered"], "points" if sample.points else
                                        "line segments or parts",
                                        " Every group is combined in the poster." if group_name
                                        else "") + (" " + rose_poster_shared_text(
                                            {"drawn": info["drawn"], "points": info["shared_points"],
                                             "locations": info["shared_locations"],
                                             "pies": info["pies"] > 0})
                                            if info.get("shared_locations") else ""))


# ==========================================================================
# analysis/shape_metrics_tool.py
# ==========================================================================
# Polygon Shape and Width Metrics: the ArcGIS Pro tool (adapter).

SHAPE_DEFAULT_PRECISION_M = 0.05

_SM_CENTRE_FIELDS = (("SRC_OID", "LONG", "Source ObjectID"), ("PART", "LONG", "Part"),
                     ("RADIUS_M", "DOUBLE", "Max inscribed circle radius (m)"),
                     ("DIAM_M", "DOUBLE", "Max inscribed circle diameter (m): widest place"),
                     ("TOL_M", "DOUBLE", "Radius within this of the true maximum (m)"))
_SM_RECT_FIELDS = (("SRC_OID", "LONG", "Source ObjectID"),
                   ("LONG_M", "DOUBLE", "Long side (m)"), ("SHORT_M", "DOUBLE", "Short side (m)"),
                   ("ASPECT", "DOUBLE", "Aspect ratio long / short"),
                   ("ORIENT_DEG", "DOUBLE", "Long-side azimuth (deg from grid north, 0-180)"),
                   ("AREA_M2", "DOUBLE", "Rectangle area (m2)"))


def shape_measuring_units(sr):
    """``meters_per_unit`` of the input coordinate system ``sr`` (``arcio.sr_info``).

    Raises ``ToolError`` for the systems the measures cannot be trusted in: none
    defined, geographic (degrees), Mercator (Web, World, PDC, regional), the other
    cylindrical world systems (Plate Carree, Equidistant Cylindrical, Miller, Cylindrical
    Equal Area ...), other world-scale systems (``shape_distorting_system``, by name and
    WKID) and polar stereographic systems (scale far from 1). Any other projected system is
    measured in its own plane, like Shape_Area / Shape_Length of a feature class in that
    system.
    """
    project = ("Project the data to a projected coordinate system suited to the area (for "
               "example its UTM zone) with the Project tool, then run this tool on the result.")
    if sr is None or sr_is_unknown(sr):
        raise ToolError("The input has no coordinate system, so lengths and areas have no unit.",
                        "Define the coordinate system (Define Projection tool) and run the tool "
                        "again. If it is geographic, project it afterwards.")
    if sr.get("type") == "Geographic":
        raise ToolError("The input is in a geographic coordinate system ({0}); its units are "
                        "degrees, so areas, widths and perimeters cannot be measured.".format(
                            sr.get("name")), project)
    if is_web_mercator(sr.get("wkid")):
        raise ToolError("The input is in a Mercator system (Web Mercator or World Mercator: "
                        "{0}), which stretches lengths "
                        "and areas by a large and latitude-dependent factor.".format(
                            sr.get("name")), project)
    distorting = shape_distorting_system(sr.get("name"), sr.get("wkid"))
    if distorting:
        raise ToolError("The input is in {0} ({1}), which stretches lengths and areas by a "
                        "factor that changes across the map (often 10 % or more in area), so "
                        "the measures would be wrong.".format(distorting, sr.get("name")),
                        project)
    if sr.get("polar_stereographic"):
        raise ToolError("The input is in a polar stereographic system ({0}), whose scale "
                        "changes strongly across the map.".format(sr.get("name")), project)
    mpu = sr.get("meters_per_unit")
    if not mpu or mpu <= 0:
        raise ToolError("The linear unit of the input coordinate system ({0}) is not "
                        "known.".format(sr.get("name")), project)
    return float(mpu)


# Flags of a row without measures (its table row is empty apart from SRC_OID and FLAGS).
_SM_UNMEASURED = frozenset((SHAPE_FLAG_NULL, SHAPE_FLAG_FAILED, SHAPE_FLAG_BAD_COORDS))


def shape_rectangle_gap_message(results, missing):
    """The info line for the ``missing`` features that have no polygon in Output Oriented Rectangles:
    those without geometry, those without measures (FAILED, BAD_COORDS; their row is empty) and those
    whose rectangle has zero width (their row is complete). Only non-zero groups are named."""
    no_geom = len([1 for _o, m in results if SHAPE_FLAG_NULL in m["flags"]])
    no_measures = len([1 for _o, m in results if SHAPE_FLAG_NULL not in m["flags"]
                       and set(m["flags"]) & _SM_UNMEASURED])
    zero = missing - no_geom - no_measures
    parts = []
    if no_geom:
        parts.append("{0} without geometry".format(no_geom))
    if no_measures:
        parts.append("{0} that could not be measured (flag FAILED or BAD_COORDS; their table "
                     "row has no measures)".format(no_measures))
    if zero > 0:
        parts.append("{0} with zero width (a straight line, with all vertices on one line, or a "
                     "figure without area), whose rectangle would be a line and cannot be drawn "
                     "as a polygon".format(zero))
    text = "{0} feature(s) are not in the rectangle output: {1}.".format(missing, ", ".join(parts))
    if zero > 0:
        text += (" The table row of a zero-width feature is still complete: for a straight "
                 "line MRR_LONG is its length, MRR_SHORT is 0 and ORIENT_DEG its direction.")
    return text


class ShapeMetricsWidthTable(object):
    """One table of shape measures per feature: compactness, rectangle, width, circle."""

    DOC = {
        "summary": "Pick a polygon or line layer, name an Output Table and press Run; the "
                   "optional outputs draw the inscribed circles and give a copy of your layer "
                   "with the measures. Writes one row per polygon or line feature with its shape measures, on a "
                   "Basic licence. For polygons the measure that Esri's tools do not give is "
                   "the maximum inscribed circle (the largest circle that fits inside; radius, "
                   "centre, and optionally the circles drawn as polygons). Alongside it the "
                   "table has area, perimeter, Polsby-Popper, Schwartzberg, Reock, solidity, "
                   "the minimum-area oriented rectangle and the minimum width of the convex "
                   "hull, several of which Esri tools also give (see Usage). For lines: "
                   "length, straight-line chord, sinuosity and the oriented rectangle. The tool "
                   "does not measure the narrowest local width of a polygon. Optional outputs: "
                   "a copy of the input features with the measures joined, the inscribed "
                   "circles (centres and circles), the oriented rectangles and an Excel or CSV "
                   "report.",
        "usage": "How to use: choose a polygon or line layer, set Output Table and press Run. "
                 "To see the result on the map, also set Output Features With Metrics (a copy "
                 "of the input whose attribute table carries the measures; symbolise it by "
                 "INSC_R, POLSBY_PP or ASPECT) and, for polygons, Output Inscribed Circles (the "
                 "largest circle that fits in each polygon, drawn as a polygon). Without "
                 "Output Features With Metrics, join the table yourself: Add Join with the "
                 "layer's ObjectID field as Input Join Field, the Output Table as Join Table "
                 "and SRC_OID as Output Join Field (Add Relate with the same two fields keeps "
                 "the tables separate). SRC_OID is the ObjectID of the input feature.\n\n"
                 "What this tool adds, and what Esri already does. The one measure that the "
                 "Esri tools checked for this help do not give is the maximum inscribed circle "
                 "(INSC_R, INSC_X, INSC_Y: the largest circle inside the polygon, holes "
                 "respected). The other fields are in the table so that one run gives them "
                 "together, but Esri tools already give the same quantities: area and "
                 "perimeter (Calculate Geometry Attributes), Polsby-Popper and Schwartzberg "
                 "(one Calculate Field line from area and perimeter, for example "
                 "4 * pi * area / perimeter ^ 2), and the minimum-area rectangle "
                 "(MRR_LONG, MRR_SHORT, ORIENT_DEG) and the minimum width of the convex hull "
                 "(HULL_MINW), which equal Minimum Bounding Geometry with Rectangle by area "
                 "and Rectangle by width. If you only need those, use Minimum Bounding "
                 "Geometry. Beyond "
                 "that, this tool gives solidity, Reock (area / smallest circle around the "
                 "feature itself), the internal consistency check and, for lines, chord and "
                 "sinuosity in the same table.\n\n"
                 "What 'width' means here. The tool does not measure the narrowest part of a "
                 "polygon (the local minimum width; that needs a medial axis or a buffer test "
                 "and is not provided). It gives three different numbers. HULL_MINW is the "
                 "minimum width of the convex hull, the narrowest parallel-sided strip that "
                 "holds the whole feature (the minimum Feret diameter); for a concave polygon "
                 "it is the width of the hull, not of the narrowest part. INSC_R is the radius "
                 "of the maximum inscribed circle, so 2 x INSC_R is the WIDEST place of the "
                 "polygon: a fat polygon with a thin neck has a large INSC_R, so do not use it "
                 "to accept or reject narrow features. 2 x INSC_R is always at most HULL_MINW. "
                 "STRIP_W (2 x area / perimeter) estimates the width of elongated shapes and "
                 "is only a rough guide for fat ones.\n\n"
                 "INSC_R is exact for the centre found (INSC_X, INSC_Y) and at most INSC_TOL "
                 "below the true maximum. INSC_TOL is the Precision you give, but never less "
                 "than 0.01 % of the feature's larger bounding-box side (a precision floor, so "
                 "long strips stay fast), and never more than HULL_MINW / 2 - INSC_R: no circle "
                 "inside a polygon can have a radius above half the hull width, so a rectangle, "
                 "however long, gets INSC_TOL 0. For a long thin polygon that is curved or "
                 "winding the floor can still be larger than the radius itself (a thin arc of "
                 "50 km radius and 3 m width has a floor of 5 m for a radius of 1.5 m): such "
                 "rows are flagged INSC_COARSE (INSC_TOL above 10 % of INSC_R or "
                 "above 4 times the Precision you gave). The search is limited to a number of "
                 "cells per part (about 149,000 for polygons with few edges, falling to 20,000 "
                 "at 5,200 edges or more); a long, thin, winding polygon (river, "
                 "canal, 5,000 to 15,000 vertices) can use them all and take several seconds "
                 "on its own (in a sandbox up to about 17 s for 8,800 edges; the budget is "
                 "sized by a work model of about 3 s, not a time limit), and below 20,000 "
                 "vertices it is not announced. It is then flagged INSC_CAPPED and INSC_TOL is the upper bound "
                 "of the error derived from the cells not yet explored (for a multipart "
                 "polygon it also covers parts searched but not chosen).\n\n"
                 "Run time in ArcGIS Pro 3.3.2, rounded out with a margin of a few seconds so that it covers "
                 "every Pro run of this tool so far (the measured times of the Pro runs are in "
                 "the tool page docs/tools/ShapeMetricsWidthTable.md): 3,000 building "
                 "footprints with table, centres, rectangles and report about 12 to 19 s "
                 "(about 3 to 5 s of it measuring); with Output Inscribed Circles and Output "
                 "Features With Metrics added about 15 to 26 s (about 3 to 6 s measuring); "
                 "2,000 road lines about 4 to 7 s; 488 real land-use polygons (median 5 "
                 "vertices, largest 147) about 15 to 22 s for the whole run (about 1 to 2 s "
                 "measuring); one built regular polygon of 20,501 vertices about 4 to 5 s for "
                 "the whole run (under 0.3 s measuring). "
                 "Footprint-sized polygons are cheap; long, "
                 "thin or very large polygons are not. Measured in the Python core of the "
                 "tool in a Linux sandbox (precision 0.05 m): about "
                 "1 s for a 2 m wide strip of 2 to 200 km, so a layer of thousands of such "
                 "strips takes about an hour; a winding band 12 m wide took 4.9 s with 5,000 "
                 "vertices, 12.7 s with 20,000, 22.6 s with 60,000 and 35 s with 150,000; a "
                 "coastline-like polygon 7.2 s with 19,000 vertices and 30 s with 150,000. A "
                 "feature with 20,000 or more vertices is announced before the measuring "
                 "starts, and the run reports the total time and the slowest feature. To "
                 "speed up a layer of very long or very large polygons, run a selection "
                 "first or raise the Precision.\n\n"
                 "Measures are taken in the plane of the input coordinate system and converted "
                 "to metres with its linear unit; they are not corrected for map-projection "
                 "scale. Geographic systems, a missing coordinate system, Mercator systems "
                 "(Web, World, PDC and regional; not Transverse Mercator such as UTM), the other "
                 "cylindrical world systems (Plate Carree, Equidistant Cylindrical, Miller, "
                 "Cylindrical Equal Area), other world-scale systems (Mollweide, Robinson ...) and "
                 "polar stereographic systems are refused with the fix (Project to a local "
                 "projected system first). These systems are recognised by name and WKID; a "
                 "custom system with an unusual name is not. INSC_X and INSC_Y are in the input "
                 "units.\n\n"
                 "Multipart polygons: area and perimeter are totals, the hull, rectangle, "
                 "circle and Reock/solidity use the whole feature (flag MULTIPART), and the "
                 "inscribed circle is the largest over the parts (INSC_PART). Run Multipart To "
                 "Singlepart first for per-part measures. For multipart lines chord and "
                 "sinuosity are empty.\n\n"
                 "FLAGS lists notes: DEGENERATE (the net area is zero or there is no length; a "
                 "figure-eight whose lobes cancel is also reported so), MULTIPART, ORIENT_TIE "
                 "(the minimum-area rectangle is not unique, for example squares, circles, and "
                 "acute and right triangles; an obtuse triangle has one: MRR_LONG, MRR_SHORT, ASPECT, ELONGATION and ORIENT_DEG are "
                 "then one of several equally small rectangles; area, RECT_FILL and HULL_MINW "
                 "do not depend on the choice), INSC_CAPPED, INSC_COARSE, EDGE_X (two edges cross: "
                 "invalid geometry, run Check Geometry / Repair Geometry), EDGE_X_SKIPPED "
                 "(more than 20,000 edges, crossing not tested), CLOSED (line whose ends "
                 "meet), BAD_COORDS (a coordinate is NaN or infinite: the row has no measures and "
                 "the run warns), NULL_GEOM, DENSIFIED (true curves were densified, so the "
                 "values are approximate), FAILED, WRONG_WINDING (an outer ring lies inside "
                 "another outer ring of the feature: almost always a hole stored with the "
                 "winding of an outer ring, counted as a part, so PARTS, HOLES, AREA_M2 and "
                 "INSC_R are wrong; run Check Geometry / Repair Geometry), ZERO_RING (a ring "
                 "without area, such as an out-and-back spike, was left out of every measure; "
                 "Repair Geometry removes it). Every input feature gets a row. When the "
                 "Precision you gave makes the INSC_R of a feature rough (INSC_COARSE, or "
                 "INSC_TOL above 10 % of INSC_R, with the tolerance set by the Precision and not "
                 "by the 0.01 % floor or the cell budget) the run warns and advises a Precision "
                 "of at most 5 % of their smallest INSC_R; this also covers concave shapes, "
                 "whose HULL_MINW / 2 is far above the radius (if the search found INSC_R 0 "
                 "for one of them, the advice is 5 % of HULL_MINW / 2 and says so). No warning "
                 "is given when the hull bound made INSC_R exact.\n\n"
                 "ORIENT_DEG is the azimuth of the long side of the rectangle in degrees "
                 "clockwise from grid north (the north of the plane of the projection, not true "
                 "north; in UTM they differ by up to about 3 degrees), 0 to 180 (a line has no "
                 "direction). Polygons are "
                 "measured as stored and not repaired.\n\n"
                 "Output Inscribed Circles: each circle is drawn as a polygon with 72 vertices "
                 "on the circle, so it lies inside the true circle and therefore inside the "
                 "feature (its area is 0.13 % below pi x radius squared); RADIUS_M is the exact "
                 "radius. Output Features With Metrics: the input geometry is copied as it is "
                 "stored (Z and M values are not kept) with the measures and the input "
                 "attributes; the ObjectID of the copy is new, SRC_OID is the ObjectID of the "
                 "input.\n\n"
                 "A shapefile or dBASE output cannot store an empty number: empty numbers are "
                 "stored as 0 and the run warns about it. Use a geodatabase output to keep "
                 "them empty.\n\n"
                 "A copied field keeps its field-level domain when the output geodatabase has "
                 "it (a warning names the fields that lose it); subtypes are not carried. "
                 "Selections and definition queries on the input layer are honoured. The input "
                 "is never edited.\n\n"
                 "Other Esri tools: Calculate Polygon Main Angle needs a Standard or Advanced licence (Esri tool page, read 2026-11-08) and is "
                 "meant for orthogonal polygons. Zonal Geometry (THICKNESS) needs the Spatial "
                 "Analyst extension at every licence level; its zones can come from an integer "
                 "raster or a feature layer and the result is a raster of the deepest point of "
                 "each zone, not a vector circle with a centre and a radius (Esri page "
                 "https://doc.esri.com/en/arcgis-pro/latest/tool-reference/spatial-analyst/"
                 "zonal-geometry.html, read on 2026-11-07). Outside ArcGIS Pro the maximum inscribed circle is also in "
                 "shapely 2.1 (maximum_inscribed_circle) and PostGIS 3.1 "
                 "(ST_MaximumInscribedCircle), and QGIS Pole of inaccessibility stores the "
                 "same radius (distance from the pole to the boundary) in the field "
                 "dist_pole.\n\n"
                 "Not verified: a Basic licence (the tool calls nothing above Basic, but Basic "
                 "compatibility is not verified); in ArcGIS Pro the shapefile, selection and "
                 "overwrite cases of the smoke test and the WRONG_WINDING, ZERO_RING and "
                 "BAD_COORDS paths "
                 "(simulated arcpy only; in ArcGIS Pro arcpy did not store a NaN coordinate, and "
                 "such a feature arrived without geometry and got NULL_GEOM). Multipart polygons and polygons with 20,000 or more vertices "
                 "were exercised in ArcGIS Pro on built features only, not on real data. The "
                 "numbers are also checked against shapely in the development tests.",
        "params": {
            "in_features": "Polygon or line features.",
            "out_table": "Output table, one row per input feature (key SRC_OID).",
            "precision_m": "Tolerance in metres of the maximum inscribed circle radius "
                           "(polygons). Smaller is slower. Must be a finite number greater "
                           "than zero and at most 10,000 km (10,000,000 m); a Precision above a "
                           "part's larger bounding-box side is used as that side. A floor of 0.01 % "
                           "of the feature's larger bounding-box side applies; the reported "
                           "INSC_TOL is never more than HULL_MINW / 2 - INSC_R.",
            "copy_attributes": "Also copy the input attributes to the output table.",
            "out_centres": "Optional point feature class: centre of each polygon's maximum "
                           "inscribed circle with its radius.",
            "out_circles": "Optional polygon feature class: the maximum inscribed circle of "
                           "each polygon drawn as a polygon, with its radius (polygons only).",
            "out_rectangles": "Optional polygon feature class: the minimum-area oriented "
                              "bounding rectangle of each feature.",
            "out_features": "Optional feature class: a copy of the input features (geometry "
                            "as stored, all copyable attributes) with the measures of the "
                            "table as extra fields, ready to symbolise.",
            "out_report": "Optional Excel (.xlsx) or CSV report with Summary and Detail sheets.",
            "feature_count": "Number of rows written to the table (derived).",
        },
        "tags": ["shape", "compactness", "inscribed circle", "bounding rectangle", "basic"],
    }

    def __init__(self):
        self.label = "Polygon Shape and Width Metrics"
        self.description = ("Per-feature shape measures for polygons and lines and the maximum "
                            "inscribed circle of each polygon; it does not measure the "
                            "narrowest local width. Basic licence (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_features", "Input Features", "GPFeatureLayer",
                       value_list=["Polyline", "Polygon"]),
            make_param("out_table", "Output Table", "DETable", direction="Output"),
            make_param("precision_m", "Inscribed circle precision (m)", "GPDouble",
                       required=False, default=SHAPE_DEFAULT_PRECISION_M),
            make_param("copy_attributes", "Copy Attributes", "GPBoolean", required=False,
                       default=False),
            make_param("out_centres", "Output Inscribed Circle Centres", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("out_circles", "Output Inscribed Circles", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("out_rectangles", "Output Oriented Rectangles", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("out_features", "Output Features With Metrics", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("feature_count", "Feature Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        value = p["precision_m"].value
        if value is not None and value != "":
            problem = shape_precision_problem(value)
            if problem:
                p["precision_m"].setErrorMessage(problem + " Enter a tolerance in metres such as "
                                                 "0.05.")
        pair = find_duplicate_outputs([param_text(p["out_table"]), param_text(p["out_centres"]),
                                       param_text(p["out_circles"]),
                                       param_text(p["out_rectangles"]),
                                       param_text(p["out_features"])])
        if pair:
            target = next((p[n] for n in ("out_centres", "out_circles", "out_rectangles",
                                          "out_features") if param_text(p[n]) == pair[1]),
                          p["out_centres"])
            target.setErrorMessage(
                "Every output needs its own name: '{0}' is used twice.".format(pair[1]))
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            # an arcpy error while writing: show what was collected before it
            flush_messages(collector)
            raise

    # ------------------------------------------------------------------

    def _measure(self, rows, is_poly, mpu, precision, curved, collector):
        """``(results, failed, timing)``: ``results`` is ``[(oid, metrics), ...]`` for every
        row; ``timing`` is ``{"seconds", "slowest_oid", "slowest_vertices",
        "slowest_seconds", "huge"}`` (``huge``: ``[(oid, vertices), ...]`` of the features
        with ``SHAPE_HUGE_VERTICES`` or more)."""
        results, failed = [], []
        vertices = dict((row["oid"], shape_vertex_count(row["shape"])) for row in rows
                        if row["shape"] is not None)
        huge = sorted(((oid, n) for oid, n in vertices.items() if n >= SHAPE_HUGE_VERTICES),
                      key=lambda item: -item[1])
        if huge:
            collector.info(
                "{0} feature(s) have {1:,} vertices or more (largest: OID {2} with {3:,}). Such "
                "a feature can take from several seconds to about half a minute on its own "
                "(the maximum inscribed circle search); the progress label names the feature "
                "being measured.".format(len(huge), SHAPE_HUGE_VERTICES, huge[0][0], huge[0][1]))
            flush_messages(collector)       # show it before the slow part starts
        progress = Progress("Measuring shapes", len(rows))
        started = time.time()
        slowest = (None, 0, 0.0)
        for row in rows:
            progress.tick()
            oid = row["oid"]
            if row["shape"] is None:
                results.append((oid, shape_null_metrics(is_poly)))
                continue
            count = vertices[oid]
            if count >= SHAPE_HUGE_VERTICES:
                progress.label("Measuring feature OID {0} ({1:,} vertices)".format(oid, count))
            begun = time.time()
            try:
                if is_poly:
                    metrics = shape_polygon_metrics(row["shape"], precision, mpu)
                else:
                    metrics = shape_line_metrics(row["shape"], mpu)
            except (ValueError, IndexError, KeyError, TypeError, ZeroDivisionError,
                    OverflowError) as exc:
                failed.append((oid, str(exc)))
                results.append((oid, shape_null_metrics(is_poly, [SHAPE_FLAG_FAILED])))
                continue
            finally:
                spent = time.time() - begun
                if spent > slowest[2]:
                    slowest = (oid, count, spent)
                if count >= SHAPE_HUGE_VERTICES:
                    progress.label("Measuring shapes")
            if oid in curved:
                metrics["flags"].append(SHAPE_FLAG_DENSIFIED)
            results.append((oid, metrics))
        progress.close()
        timing = {"seconds": time.time() - started, "slowest_oid": slowest[0],
                  "slowest_vertices": slowest[1], "slowest_seconds": slowest[2], "huge": huge}
        return results, failed, timing

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))  # before the main work
        if report and report["note"]:
            collector.info(report["note"])
        precision = param_number(p["precision_m"], SHAPE_DEFAULT_PRECISION_M)
        problem = shape_precision_problem(precision)
        if problem:
            raise ToolError(problem, "Enter a tolerance in metres such as 0.05.")
        out_table = param_text(p["out_table"])
        out_centres = param_text(p["out_centres"])
        out_circles = param_text(p["out_circles"])
        out_rects = param_text(p["out_rectangles"])
        out_features = param_text(p["out_features"])
        refuse_duplicate_outputs([out_table, out_centres, out_circles, out_rects, out_features])
        desc = describe_dataset(param_text(p["in_features"]))
        kind = kind_from_shape_type(desc["shape_type"])
        if kind not in (GEOM_POLYLINE, GEOM_POLYGON):
            raise ToolError("The input must contain lines or polygons.",
                            "Choose a line or polygon layer.")
        is_poly = kind == GEOM_POLYGON
        for label, out in (("centres", out_centres), ("circles", out_circles)):
            if out and not is_poly:
                raise ToolError("Inscribed circle {0} exist only for polygons, but the input "
                                "contains lines.".format(label),
                                "Clear Output Inscribed Circle Centres and Output Inscribed "
                                "Circles, or choose a polygon layer.")
        inputs = [desc["catalog_path"]]
        for out in (out_table, out_centres, out_circles, out_rects, out_features):
            if out:
                check_output_path(out, inputs)
        sr = desc["sr"]
        mpu = shape_measuring_units(sr)
        collector.info("Coordinate system: {0} (WKID {1}); 1 unit = {2:g} m. Lengths and areas "
                       "are measured in the plane of this system, in metres and square metres, "
                       "without a correction for map-projection scale.".format(
                           sr.get("name"), sr.get("wkid"), mpu))

        carry, skipped_names = [], []
        carry_names = []
        reserved = [c[0] for c in shape_columns(is_poly)]
        copy_to_table = param_bool(p["copy_attributes"], False)
        if copy_to_table or out_features:
            carry, skipped_names = analysis_carry_fields(desc["fields"], reserved)
            carry_names = [f["name"] for f in carry]
            if skipped_names:
                collector.info("Input field(s) not copied because the output uses the name: "
                               "{0}.".format(", ".join(skipped_names)))
        table_carry = carry if copy_to_table else []
        rows, curved_oids = read_features_skip_curves(desc["input"], carry_names)
        curved = set(curved_oids)
        if curved:
            rows = read_features(desc["input"], carry_names)   # true curves densified by angle
        collector.info("{0} feature(s) read.".format(len(rows)))

        results, failed, timing = self._measure(rows, is_poly, mpu, precision, curved, collector)

        # ---- schema, planned for every output before anything is created
        columns = shape_columns(is_poly)
        flag_values = [shape_row_values(is_poly, oid, m)[-1] for oid, m in results]
        by_oid = dict((r["oid"], r) for r in rows)

        def metric_specs():
            out = []
            for name, field_type, alias in columns:
                spec = {"name": name, "type": field_type, "alias": alias}
                if name == "FLAGS":
                    spec["values"] = flag_values
                out.append(spec)
            return out

        specs = metric_specs()
        fixed = len(specs)
        specs += analysis_carry_specs(table_carry, lambda n: [r["attrs"][n] for r in rows],
                                      read_output_domains(out_table))
        specs, renamed = plan_output_fields(out_table, specs, fixed=fixed)
        for old, new in renamed:
            collector.info("Field {0} is called {1} in the output.".format(old, new))
        centre_specs = circle_specs = rect_specs = feature_specs = None
        if out_centres:
            centre_specs, _r = plan_output_fields(
                out_centres, [{"name": n, "type": t, "alias": a} for n, t, a in _SM_CENTRE_FIELDS],
                fixed=len(_SM_CENTRE_FIELDS))
        if out_circles:
            circle_specs, _r = plan_output_fields(
                out_circles, [{"name": n, "type": t, "alias": a} for n, t, a in _SM_CENTRE_FIELDS],
                fixed=len(_SM_CENTRE_FIELDS))
        if out_rects:
            rect_specs, _r = plan_output_fields(
                out_rects, [{"name": n, "type": t, "alias": a} for n, t, a in _SM_RECT_FIELDS],
                fixed=len(_SM_RECT_FIELDS))
        if out_features:
            feature_specs = metric_specs()
            feature_specs += analysis_carry_specs(
                carry, lambda n: [r["attrs"][n] for r in rows], read_output_domains(out_features))
            feature_specs, renamed_f = plan_output_fields(out_features, feature_specs,
                                                          fixed=fixed)
            for old, new in renamed_f:
                collector.info("Field {0} is called {1} in Output Features With Metrics.".format(
                    old, new))

        # SRC_OID of every output: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``)
        all_oids = [oid for oid, _m in results]

        def oid_first(out, out_specs):
            if not out_specs:
                return {"type": "LONG"}
            spec = oid_output_field(out, all_oids, collector, label="SRC_OID of {0}".format(out))
            out_specs[0] = dict(out_specs[0], type=spec["type"])
            if spec.get("length"):
                out_specs[0]["length"] = spec["length"]
            return spec

        table_oid = oid_first(out_table, specs)
        centre_oid = oid_first(out_centres, centre_specs)
        circle_oid = oid_first(out_circles, circle_specs)
        rect_oid = oid_first(out_rects, rect_specs)
        feature_oid = oid_first(out_features, feature_specs)

        def with_oid(spec, values):
            values = list(values)
            values[0] = oid_field_value(spec, values[0])
            return values

        created = []
        try:
            path, fmap = create_table(out_table, specs, inputs=inputs)
            created.append(path)
            null_fields = set()

            def table_rows():
                for oid, m in results:
                    values = with_oid(table_oid, shape_row_values(is_poly, oid, m))
                    attrs = by_oid[oid]["attrs"]
                    yield values + [attrs[f["name"]] for f in table_carry]

            count = insert_rows(path, [fmap[s["name"]] for s in specs], table_rows(),
                                null_fields=null_fields)
            collector.info("{0} row(s) written to {1}.".format(count, path))
            wkid = sr.get("wkid")
            n_centres = n_circles = n_rects = n_features = 0
            with_circle = [(oid, m) for oid, m in results
                           if m.get("centre") is not None and m["insc_r"] and m["insc_r"] > 0]
            if out_centres:
                cpath, cmap = create_feature_class(out_centres, GEOM_POINT, desc["sr_object"],
                                                   centre_specs, inputs=inputs)
                created.append(cpath)
                cnames = [cmap[s["name"]] for s in centre_specs]
                crow = [(m["centre"], [oid_field_value(centre_oid, oid), m["insc_part"], m["insc_r"], 2.0 * m["insc_r"],
                                       m["insc_tol"]]) for oid, m in with_circle]
                n_centres = insert_rows(cpath, cnames, crow, kind=GEOM_POINT, wkid=wkid)
                collector.info("{0} inscribed circle centre(s) written to {1}.".format(
                    n_centres, cpath))
            if out_circles:
                kpath, kmap = create_feature_class(out_circles, GEOM_POLYGON, desc["sr_object"],
                                                   circle_specs, inputs=inputs)
                created.append(kpath)
                knames = [kmap[s["name"]] for s in circle_specs]
                krow = []
                for oid, m in with_circle:
                    ring = shape_circle_ring(m["centre"][0], m["centre"][1], m["insc_r"] / mpu)
                    if ring is not None:
                        krow.append(([ring], [oid_field_value(circle_oid, oid), m["insc_part"],
                                              m["insc_r"],
                                              2.0 * m["insc_r"], m["insc_tol"]]))
                n_circles = insert_rows(kpath, knames, krow, kind=GEOM_POLYGON, wkid=wkid)
                collector.info("{0} inscribed circle(s) written to {1}.".format(n_circles, kpath))
            if out_rects:
                rpath, rmap = create_feature_class(out_rects, GEOM_POLYGON, desc["sr_object"],
                                                   rect_specs, inputs=inputs)
                created.append(rpath)
                rnames = [rmap[s["name"]] for s in rect_specs]
                rrow = []
                for oid, m in results:
                    if m.get("rect") is not None:
                        rrow.append(([m["rect"]], [oid_field_value(rect_oid, oid), m["mrr_long"], m["mrr_short"], m["aspect"],
                                                   m["orient_deg"], m["mrr_long"] * m["mrr_short"]]))
                n_rects = insert_rows(rpath, rnames, rrow, kind=GEOM_POLYGON, wkid=wkid)
                collector.info("{0} oriented rectangle(s) written to {1}.".format(n_rects, rpath))
            feature_nulls = set()
            if out_features:
                fpath, fmap2 = create_feature_class(out_features, kind, desc["sr_object"],
                                                    feature_specs, inputs=inputs)
                created.append(fpath)
                fnames = [fmap2[s["name"]] for s in feature_specs]
                metrics_of = dict(results)

                def feature_rows():
                    with arcpy.da.SearchCursor(desc["input"], ["OID@", "SHAPE@"]) as cursor:
                        for oid, shape in cursor:
                            if oid not in metrics_of:
                                continue
                            values = with_oid(feature_oid,
                                              shape_row_values(is_poly, oid, metrics_of[oid]))
                            attrs = by_oid[oid]["attrs"]
                            yield shape, values + [attrs[f["name"]] for f in carry]

                n_features = insert_shaped_rows(fpath, fnames, feature_rows(),
                                                null_fields=feature_nulls)
                collector.info("{0} feature(s) with the measures written to {1}.".format(
                    n_features, fpath))
        except Exception:
            for done in created:  # never leave part of the outputs behind
                try:
                    safe_delete(done, inputs)
                except Exception:
                    pass
            raise

        self._messages(collector, results, failed, curved, is_poly, path, specs, fmap,
                       null_fields, out_centres, out_circles, out_rects, n_centres, n_circles,
                       n_rects, timing, precision)
        if out_features:
            note = folder_null_number_warning(
                fpath, feature_specs, fmap2, feature_nulls,
                "0 then also stands for 'not defined' (for example ASPECT of a zero-width "
                "rectangle) or for an empty input value.")
            if note:
                collector.warning(note)
            lost = lost_domain_warning(feature_specs, fpath)
            if lost:
                collector.warning(lost)
        self._report(report, collector, desc, sr, mpu, precision, is_poly, results, columns,
                     len(rows))
        set_derived_output(parameters, "feature_count", str(count))
        flush_messages(collector)

    def _messages(self, collector, results, failed, curved, is_poly, path, specs, fmap,
                  null_fields, out_centres, out_circles, out_rects, n_centres, n_circles,
                  n_rects, timing, precision=SHAPE_DEFAULT_PRECISION_M):
        collector.info("Measured {0} feature(s) in {1:.1f} s; slowest: OID {2} ({3:,} "
                       "vertices, {4:.2f} s).".format(
                           len(results), timing["seconds"], timing["slowest_oid"],
                           timing["slowest_vertices"], timing["slowest_seconds"])
                       if timing["slowest_oid"] is not None else
                       "Measured {0} feature(s) in {1:.1f} s.".format(len(results),
                                                                      timing["seconds"]))
        nulls = [oid for oid, m in results if SHAPE_FLAG_NULL in m["flags"]]
        if nulls:
            collector.warning("{0} feature(s) have no geometry and got a row without measures "
                              "(flag NULL_GEOM): OID {1}.".format(len(nulls),
                                                                  analysis_oid_text(nulls)))
        if failed:
            collector.warning("{0} feature(s) could not be measured (flag FAILED): OID {1} "
                              "(first cause: {2}). Run Repair Geometry on them, then run the "
                              "tool again.".format(len(failed),
                                                   analysis_oid_text([f[0] for f in failed]),
                                                   failed[0][1]))
        bad_coords = [oid for oid, m in results if SHAPE_FLAG_BAD_COORDS in m["flags"]]
        if bad_coords:
            collector.warning("{0} feature(s) have a coordinate that is NaN or infinite and got a "
                              "row without measures (flag BAD_COORDS): OID {1}. Run Check "
                              "Geometry and Repair Geometry on them, then run the tool "
                              "again.".format(len(bad_coords), analysis_oid_text(bad_coords)))
        if curved:
            collector.warning("{0} feature(s) with true curves were densified before measuring "
                              "(flag DENSIFIED): OID {1}. Their values are approximate; the "
                              "rectangle and circle are exact for the densified shape.".format(
                                  len(curved), analysis_oid_text(sorted(curved))))
        flagged = {}
        for oid, m in results:
            for flag in m["flags"]:
                flagged.setdefault(flag, []).append(oid)
        if flagged.get("EDGE_X"):
            collector.warning("{0} feature(s) have edges that cross each other (invalid "
                              "geometry, flag EDGE_X): OID {1}. Their measures are computed "
                              "from the coordinates as stored; run Check Geometry and Repair "
                              "Geometry, then run the tool again.".format(
                                  len(flagged["EDGE_X"]), analysis_oid_text(flagged["EDGE_X"])))
        if flagged.get(SHAPE_FLAG_INSC_CAPPED):
            collector.warning("{0} feature(s) reached the search limit of the inscribed circle "
                              "(flag INSC_CAPPED): OID {1}. Their INSC_R is a lower bound; "
                              "INSC_TOL holds the upper bound of the error derived from the "
                              "cells not yet explored. A smaller precision does not help; a "
                              "larger one is faster."
                              .format(len(flagged[SHAPE_FLAG_INSC_CAPPED]),
                                      analysis_oid_text(flagged[SHAPE_FLAG_INSC_CAPPED])))
        if flagged.get("DEGENERATE"):
            collector.info("{0} feature(s) have no area or no length (flag DEGENERATE).".format(
                len(flagged["DEGENERATE"])))
        if flagged.get("ORIENT_TIE"):
            collector.info("{0} feature(s) have no unique minimum-area rectangle (flag "
                           "ORIENT_TIE, for example squares, circles, and acute and right "
                           "triangles); their MRR_LONG, "
                           "MRR_SHORT, ASPECT, ELONGATION and ORIENT_DEG are one of several "
                           "equally small rectangles.".format(len(flagged["ORIENT_TIE"])))
        coarse = [oid for oid, m in results if shape_precision_too_coarse(m, precision)] \
            if is_poly else []
        coarse_set = set(coarse)
        other_coarse = [oid for oid in flagged.get(SHAPE_FLAG_INSC_COARSE, [])
                        if oid not in coarse_set]
        if other_coarse:
            collector.info("{0} feature(s) have an INSC_TOL above 10 % of INSC_R or above 4 "
                           "times the precision you gave (flag INSC_COARSE; the 0.01 % floor of "
                           "the larger bounding-box side or the cell budget set it, typical for "
                           "large polygons and long thin curved ones, so a smaller Precision "
                           "does not help). INSC_R is at most INSC_TOL below the "
                           "true maximum and may be more exact than that.".format(
                               len(other_coarse)))
        if flagged.get(SHAPE_FLAG_WRONG_WINDING):
            collector.warning("{0} feature(s) have an outer ring inside another outer ring of "
                              "the same feature (flag WRONG_WINDING): OID {1}. This is almost "
                              "always a hole stored with the winding of an outer ring; it is "
                              "counted as a part of its own, so PARTS, HOLES, AREA_M2 and INSC_R "
                              "of these features are wrong. Run Check Geometry and Repair "
                              "Geometry, then run the tool again.".format(
                                  len(flagged[SHAPE_FLAG_WRONG_WINDING]),
                                  analysis_oid_text(flagged[SHAPE_FLAG_WRONG_WINDING])))
        if flagged.get(SHAPE_FLAG_ZERO_RING):
            collector.info("{0} feature(s) have a ring without area (an out-and-back spike, "
                           "points on one line or one repeated point; flag ZERO_RING): OID {1}. "
                           "Such a ring is neither a part nor a hole, so it was left out of "
                           "every measure. Repair Geometry removes it.".format(
                               len(flagged[SHAPE_FLAG_ZERO_RING]),
                               analysis_oid_text(flagged[SHAPE_FLAG_ZERO_RING])))
        if coarse:
            by_oid = dict(results)
            warned = [by_oid[oid] for oid in coarse]
            target, basis = shape_precision_target(warned, with_basis=True)
            above_hull = [oid for oid in coarse if by_oid[oid].get("hull_minw")
                          and precision > by_oid[oid]["hull_minw"] / 2.0]
            hull_note = ""
            if above_hull:
                hull_note = (" For {0} of them it is even above HULL_MINW / 2, the largest "
                             "radius any circle inside them can have.".format(len(above_hull)))
            advice = (" Enter " + shape_precision_advice(precision, target,
                                                          SHAPE_DEFAULT_PRECISION_M,
                                                          basis) + ".") \
                if target else ""
            collector.warning("The Precision you gave ({0:g} m) is too coarse for {1} "
                              "feature(s) (OID {2}): it set their INSC_TOL, which is above "
                              "10 % of their INSC_R (flag INSC_COARSE), so their INSC_R may be "
                              "up to INSC_TOL below the true radius.{3}{4}".format(
                                  precision, len(coarse), analysis_oid_text(coarse),
                                  hull_note, advice))
        bad = [(oid, shape_consistency_issues(is_poly, m)) for oid, m in results]
        bad = [(oid, names) for oid, names in bad if names]
        if bad:
            collector.warning("{0} feature(s) fail an internal consistency check (OID {1}; "
                              "first: {2}). These relations hold for every valid polygon or "
                              "line, so check the geometry (Check Geometry).".format(
                                  len(bad), analysis_oid_text([b[0] for b in bad]),
                                  ", ".join(bad[0][1])))
        else:
            measured = len([1 for _o, m in results
                            if not set(m["flags"]) & _SM_UNMEASURED])
            if measured:
                collector.info("Internal consistency checks passed for all {0} measured "
                               "feature(s).".format(measured))
            elif len([1 for _o, m in results if SHAPE_FLAG_NULL not in m["flags"]]):
                collector.info("No feature could be measured (flag FAILED or BAD_COORDS), so "
                               "no internal consistency check ran.")
            else:
                collector.info("No feature had a geometry to measure, so no internal "
                               "consistency check ran.")
        note = folder_null_number_warning(
            path, specs, fmap, null_fields,
            "0 then also stands for 'not defined' (for example ASPECT of a zero-width "
            "rectangle, SINUOSITY of a closed line).")
        if note:
            collector.warning(note)
        lost = lost_domain_warning(specs, path)
        if lost:
            collector.warning(lost)
        if (out_centres or out_circles) and \
                max(n_centres, n_circles) < len([1 for _o, m in results if m.get("centre")]):
            collector.info("Centres and circles were not written for features with an "
                           "inscribed circle radius of 0.")
        if out_rects:
            missing = len(results) - n_rects
            if missing:
                collector.info(shape_rectangle_gap_message(results, missing))

    def _report(self, report, collector, desc, sr, mpu, precision, is_poly, results, columns,
                total):
        if report is None:
            return
        # Rows flagged FAILED or BAD_COORDS have no measures, so they are not "measured"
        # (as in the run message); their flags are still counted, over every row with a geometry.
        with_geometry = [m for _oid, m in results if SHAPE_FLAG_NULL not in m["flags"]]
        measured = [m for m in with_geometry if not set(m["flags"]) & _SM_UNMEASURED]
        summary = [("Tool", "Polygon Shape and Width Metrics v" + __version__),
                   ("Input", desc["catalog_path"]),
                   ("Geometry", "Polygon" if is_poly else "Polyline"),
                   ("Coordinate system", "{0} (WKID {1})".format(sr.get("name"), sr.get("wkid"))),
                   ("Linear unit (metres per unit)", mpu),
                   ("Features read", total)]
        summary += shape_summary(is_poly, measured, precision, flag_rows=with_geometry)
        bad = [oid for oid, m in results if shape_consistency_issues(is_poly, m)]
        summary.append(("Features failing internal consistency checks", len(bad)))
        summary.append(("Note", "INSC_R is the widest place of a polygon, not a minimum width; "
                                "HULL_MINW is the width of the convex hull, not of the "
                                "narrowest part of a concave polygon."))
        header = [c[0] for c in columns]
        detail = [shape_row_values(is_poly, oid, m) for oid, m in results]
        for written in write_report(report, summary, header, detail):
            collector.info("Report written to {0}.".format(written))


# ==========================================================================
# analysis/polygon_holes_tool.py
# ==========================================================================
# Polygon Holes and Parts: the ArcGIS Pro tool (adapter).

_PH_INV_FIELDS = ("SRC_OID", "PART", "RING", "SRC_RING", "RING_TYPE", "AREA_M2", "PERIM_M",
                  "VERTICES", "WIDTH_M", "OUTER_M2", "NET_M2", "HOLE_PCT", "HOLES",
                  "NEST_PART", "NEST_RING", "FLAGS", "PLAN")
_PH_LOG_FIELDS = ("SRC_OID", "PART", "RING", "SRC_RING", "RING_TYPE", "AREA_M2", "HOLE_PCT",
                  "ACTION", "DETAIL")
_PH_THRESHOLDS = ("min_hole_area_m2", "max_hole_percent", "min_part_area_m2", "tiny_area_m2",
                  "sliver_width_m", "max_thinness", "touch_tolerance_m")


def _ph_inventory_values(row):
    return [row["oid"], row["part"], row["ring"], row["src_ring"], row["ring_type"],
            row["area_m2"], row["perim_m"], row["vertices"], row["width_m"], row["outer_area_m2"],
            row["part_net_m2"], row["hole_pct"], row["hole_count"], row["nest_part"],
            row["nest_ring"], ";".join(row["flags"]), row["plan"]]


def _ph_oid_field(out_path, specs, rows, collector):
    """Give SRC_OID (the first of ``specs``) the toolkit's one ObjectID field rule
    (``arcio.oid_field_spec``); returns the spec, for ``_ph_with_oid``."""
    spec = oid_output_field(out_path, [r["oid"] for r in rows], collector)
    specs[0] = dict(spec, name=specs[0]["name"])
    return spec


def _ph_with_oid(spec, values):
    values[0] = oid_field_value(spec, values[0])
    return values


def _ph_log_values(row):
    return [row["oid"], row["part"], row["ring"], row["src_ring"], row["ring_type"],
            row["area_m2"], row["hole_pct"], row["plan"], row["detail"]]


def _ph_run_row(action, detail):
    """A run row of the change log (no ring: the numeric fields stay empty)."""
    return {"oid": None, "part": None, "ring": None, "src_ring": None, "ring_type": "RUN",
            "area_m2": None, "hole_pct": None, "plan": action, "detail": detail}


PH_DETAIL_CUT_MARKER = " ...[cut]"


def _ph_fit_log_details(rows, folder):
    """``(rows, cut)``: the change log rows with every DETAIL that a dBASE table cannot hold
    (more than 254 UTF-8 bytes, ``arcio.cut_utf8_bytes``) cut to 254 bytes ending in
    ``PH_DETAIL_CUT_MARKER``, and the number of DETAIL texts cut. Outside a folder the rows are
    returned unchanged (a geodatabase or GeoPackage keeps the whole text). The ring rows
    themselves are not changed: copies are returned (R11-1: one long DETAIL used to refuse the
    whole run)."""
    if not folder:
        return rows, 0
    counter = [0]
    out = []
    for row in rows:
        cut = cut_utf8_bytes(row["detail"], True, counter, PH_DETAIL_CUT_MARKER)
        out.append(row if cut == row["detail"] else dict(row, detail=cut))
    return out, counter[0]


def _ph_detail_cut_warning(cut):
    if not cut:
        return None
    return ("{0} change log DETAIL text(s) were longer than the {1} bytes a dBASE table holds and "
            "were cut to {1} bytes, ending in \"{2}\". Write the change log to a file geodatabase "
            "or a GeoPackage to keep the whole text.".format(cut, SHAPEFILE_MAX_TEXT,
                                                         PH_DETAIL_CUT_MARKER.strip()))


def _ph_uncopied_fields(fields):
    """``[(name, type), ...]`` of the input fields the cleaned copy cannot carry because of their
    type (BLOB, raster, GlobalID, or any type Add Field cannot create), in input order. The
    ObjectID and the geometry are left out: the copy has its own. Read-only fields of a type that
    can be created (Shape_Area, Shape_Length) are left out too: the output computes its own."""
    return [(f["name"], f["type"]) for f in fields
            if f["type"] not in ANALYSIS_ADDFIELD_KEYWORDS and f["type"] not in ("OID", "Geometry")]


def _ph_uncopied_warning(fields):
    """Warning text naming the input fields the cleaned copy leaves out (``_ph_uncopied_fields``),
    else ``None``. Never silent: a BLOB or raster value is lost in the copy."""
    dropped = _ph_uncopied_fields(fields)
    if not dropped:
        return None
    kinds = set(t for _n, t in dropped)
    tail = []
    if kinds - set(("GlobalID",)):
        tail.append("their values are not in the cleaned copy; join it back to the input on "
                    "SRC_OID if you need them")
    if "GlobalID" in kinds:
        tail.append("the cleaned copy has no GlobalID field (run Add Global IDs on it if you "
                    "need new ones; the input's GlobalID values are not kept)")
    text = "; ".join(tail)
    return ("Input field(s) of a type the cleaned copy cannot carry are left out: {0}. {1}."
            .format(", ".join("{0} ({1})".format(n, t) for n, t in dropped),
                    text[:1].upper() + text[1:]))


def _ph_count_features(path):
    """Number of rows the input yields (selections and definition queries honoured); only the
    ObjectID is read, so this costs little memory."""
    count = 0
    with arcpy.da.SearchCursor(path, ["OID@"]) as cursor:
        for _row in cursor:
            count += 1
    return count


def _ph_inventory_specs(rows):
    return [{"name": "SRC_OID", "type": "LONG"}, {"name": "PART", "type": "LONG"},
            {"name": "RING", "type": "LONG"}, {"name": "SRC_RING", "type": "LONG"},
            {"name": "RING_TYPE", "type": "TEXT", "length": 10},
            {"name": "AREA_M2", "type": "DOUBLE"}, {"name": "PERIM_M", "type": "DOUBLE"},
            {"name": "VERTICES", "type": "LONG"}, {"name": "WIDTH_M", "type": "DOUBLE"},
            {"name": "OUTER_M2", "type": "DOUBLE"}, {"name": "NET_M2", "type": "DOUBLE"},
            {"name": "HOLE_PCT", "type": "DOUBLE"}, {"name": "HOLES", "type": "LONG"},
            {"name": "NEST_PART", "type": "LONG"}, {"name": "NEST_RING", "type": "LONG"},
            {"name": "FLAGS", "type": "TEXT",
             "length": text_field_length([";".join(r["flags"]) for r in rows], 8)},
            {"name": "PLAN", "type": "TEXT", "length": 18}]


def _ph_log_specs(rows):
    return [{"name": "SRC_OID", "type": "LONG"}, {"name": "PART", "type": "LONG"},
            {"name": "RING", "type": "LONG"}, {"name": "SRC_RING", "type": "LONG"},
            {"name": "RING_TYPE", "type": "TEXT", "length": 10},
            {"name": "AREA_M2", "type": "DOUBLE"}, {"name": "HOLE_PCT", "type": "DOUBLE"},
            {"name": "ACTION", "type": "TEXT", "length": 18},
            # the values let a folder (dBASE) output size DETAIL in UTF-8 bytes, not characters
            {"name": "DETAIL", "type": "TEXT",
             "length": text_field_length([r["detail"] for r in rows], 8),
             "values": [r["detail"] for r in rows]}]


def ph_plan_summary_text(s, cleaned):
    """The run message for a cleaning (``cleaned``) or a plan only: a plan says what WOULD be
    done, so "Plan (nothing was changed)" is never followed by "filled" or "dropped". Features
    kept by their largest part that have one part only (nothing dropped from them) are counted
    apart, so a single-part layer below Drop Parts Smaller Than does not read as many changes."""
    single = s.get("kept_single", 0)
    if cleaned:
        largest = "{0} feature(s) kept by their largest part".format(s["kept_largest"])
        if single:
            largest += " ({0} of them single-part, nothing dropped from those)".format(single)
        return ("Cleaned: {0} hole(s) filled ({1:.6g} m2), {2} part(s) dropped ({3:.6g} m2 net) "
                "with {4} hole(s), {5} hole(s) kept because of an island, {6}, {7} zero-area "
                "ring(s) removed; {8} feature(s) changed.".format(
                    s["filled"], s["filled_m2"], s["dropped_parts"], s["dropped_m2"],
                    s["dropped_holes"], s["kept_island"], largest, s["zero_area"],
                    s["features_changed"]))
    largest = "would keep {0} feature(s) by their largest part".format(s["kept_largest"])
    if single:
        largest += " ({0} of them single-part, nothing dropped from those)".format(single)
    return ("Plan (nothing was changed): would fill {0} hole(s) ({1:.6g} m2), would drop {2} "
            "part(s) ({3:.6g} m2 net) with {4} hole(s), would keep {5} hole(s) because of an "
            "island, {6}, would remove {7} zero-area ring(s); {8} feature(s) would "
            "change.".format(s["filled"], s["filled_m2"], s["dropped_parts"], s["dropped_m2"],
                             s["dropped_holes"], s["kept_island"], largest, s["zero_area"],
                             s["features_changed"]))


class PolygonHoleInventory(object):
    """Inventory of the holes and parts of polygons, and an optional cleaned copy (no Advanced tool)."""

    DOC = {
        "summary": "Lists every ring of every polygon feature (outer rings and holes) with its "
                   "area, perimeter, vertex count, the part a hole sits in, the hole's share of "
                   "its outer ring and flags (SLIVER, TINY, TOUCHES_OUTER, TOUCHES_OTHER_HOLE, "
                   "OVERLAPS_OTHER_HOLE, NESTED, HAS_ISLAND, NO_OUTER, OVERLAPS_PART, SELF_TOUCH, "
                   "ZERO_AREA). "
                   "Optionally writes the holes as polygons for mapping, and a cleaned copy in "
                   "which holes and small parts below a threshold are removed, with a change log "
                   "of every ring changed. Calls no Advanced or Standard tool (Eliminate Polygon "
                   "Part needs Advanced); use on a Basic licence is NOT VERIFIED.",
        "usage": "Quick start: (1) choose the polygon layer (projected coordinate system) and a "
                 "name for Output Ring Inventory, then run: you get one row per ring (outer rings "
                 "and holes) with area, share of the outer ring and flags. (2) Add Output Hole "
                 "Polygons to map the holes. (3) To clean, set a threshold (Fill Holes Smaller "
                 "Than, Fill Holes Below Percent or Drop Parts Smaller Than) and give both Output "
                 "Cleaned Polygons and Output Change Log; with only the log you get a preview.\n\n"
                 "Verification: that the tool needs only Basic rests on Esri's licence pages; "
                 "use on a Basic licence is NOT VERIFIED. The NaN check is tested in Python "
                 "only, and enterprise geodatabase outputs are untested. Output format "
                 "effects: in a GeoPackage Pro stores PLAN as PLAN_ and ACTION as ACTION_ (the "
                 "run warns); in shapefile and dBASE outputs "
                 "empty numbers are 0, empty text reads back as a space, a carried field called "
                 "id becomes id_1, and Pro adds an Id or Field1 field.\n\n"
                 "Input: polygon features in a projected coordinate system. Areas are planar "
                 "areas in square metres of that system (a unit other than metres is converted "
                 "with its metres per unit); any scale error of the system itself is not "
                 "corrected. A geographic system, an undefined system and a Web Mercator system "
                 "are refused with a message: project the data first (for example to its UTM "
                 "zone). The coordinate system and unit are reported.\n\n"
                 "Rings: a clockwise ring is an outer ring (a part), a counter-clockwise ring "
                 "is a hole of the smallest outer ring that contains it and is larger than the "
                 "hole beyond rounding noise (Esri convention); an island with the same boundary "
                 "as its hole up to floating-point rounding (another start vertex, extra collinear "
                 "vertices, coordinates rotated or reprojected in double precision) therefore does "
                 "not own it and is NESTED in it. Vertices that differ by more than rounding "
                 "(snapped to a coarser grid) are not the same boundary. A "
                 "counter-clockwise ring that no outer ring contains is kept as a part of its "
                 "own and flagged NO_OUTER; it never takes holes, so a counter-clockwise ring "
                 "inside it is a NO_OUTER part too, whatever the stored order. A NO_OUTER part "
                 "that shares area with another part of the feature is flagged OVERLAPS_PART "
                 "(both parts; the run warns): the shared area is counted twice. Rings are read "
                 "as stored and not repaired, with one "
                 "exception: in a feature the cleaned copy changes, a NO_OUTER ring is written "
                 "clockwise (ORIENT_NO_OUTER in the log), so the copy never holds a feature of "
                 "negative area; the log audit counts such a ring positive. PART is "
                 "1-based in stored order; RING is 0 for the outer ring and 1, 2, ... for its "
                 "holes; SRC_RING is the position of the ring in the stored geometry. A part "
                 "inside a hole of another part (an island) is a part of its own: NESTED on its "
                 "outer ring, HAS_ISLAND on the hole. A hole is never filled while a kept part "
                 "lies inside it at any depth (also inside a hole of a dropped island): "
                 "KEEP_HOLE_ISLAND. A ring with fewer than 3 distinct "
                 "vertices or an area of 0.000001 m2 or less is RING_TYPE DEGENERATE (ZERO_AREA, "
                 "no part). A ring that visits a coordinate twice (not as neighbours) is "
                 "flagged SELF_TOUCH and still counts as one ring with its shoelace area; "
                 "self-crossing rings are not detected (use Check Geometry).\n\n"
                 "Measures: AREA_M2 and PERIM_M are those of the ring; OUTER_M2 is the area of "
                 "the outer ring of the part; NET_M2 (on outer rings) is the part's area with "
                 "its holes subtracted; HOLE_PCT is the hole area as a percentage of OUTER_M2; "
                 "WIDTH_M is the mean width 2 * area / perimeter. SLIVER: WIDTH_M below the "
                 "Sliver Width and thinness 4 * pi * area / perimeter^2 below Maximum Thinness. "
                 "TINY: ring area below Tiny Area. TOUCHES_OUTER / TOUCHES_OTHER_HOLE: boundary "
                 "points within Touch Tolerance of the outer ring or of another hole of the "
                 "part. OVERLAPS_OTHER_HOLE: two holes of a part share area (boundaries cross, "
                 "or a stretch of one lies inside the other, also when they meet only at "
                 "shared vertices and edges, or identical): invalid geometry; NET_M2 subtracts the "
                 "shared area twice and is too small, so repair the geometry first (the run "
                 "warns and names the features). A ring with a NaN or infinite coordinate is "
                 "refused: the feature is listed as not analysed.\n\n"
                 "Cleaning (the Fill Holes / Drop Parts thresholds; 0 = off, all comparisons "
                 "are strict 'below', in double precision, so a hole within about 1e-8 m2 of a "
                 "threshold can go either way): a hole is filled when its area is below Fill Holes "
                 "Smaller Than and/or its HOLE_PCT is below Fill Holes Below Percent (Hole "
                 "Threshold Logic ANY or ALL when both are set). A part is dropped when its "
                 "NET_M2 is below Drop Parts Smaller Than; its holes go with it. All decisions "
                 "use the input geometry, so a part is dropped by its net area before any fill "
                 "(a 100 m2 part with a 98 m2 hole goes at Drop Parts Smaller Than 10 even when "
                 "the hole meets the fill rule; fill in a first run and drop in a second to keep "
                 "it). A hole that holds a part that is kept is not filled "
                 "(KEEP_HOLE_ISLAND). A feature never vanishes: if every part would be dropped, "
                 "the largest part (by NET_M2, the first on ties) is kept (KEEP_LARGEST_PART); "
                 "so a single-part feature below Drop Parts Smaller Than is kept and logged "
                 "KEEP_LARGEST_PART, with nothing dropped (the run message counts such "
                 "single-part features apart). Without Output Cleaned Polygons the message "
                 "starts 'Plan (nothing was changed)' and says what would be done. SRC_OID is LONG while every ObjectID "
                 "fits 32 bits, else BIGINTEGER in a geodatabase, GeoPackage or memory (above "
                 "2^53 - 1 refused) and, in a folder, DOUBLE up to 12 significant digits, else "
                 "TEXT(20). The cleaned copy carries the input fields of a type Add Field can "
                 "create; BLOB, raster and GlobalID fields are left out and a warning names them "
                 "(run Add Global IDs on the copy for new GlobalIDs). "
                 "Rings without area are always removed from the cleaned copy "
                 "(DROP_ZERO_AREA), unless the feature has no ring with an area (kept as "
                 "stored). A feature without any change keeps its geometry exactly. The "
                 "PLAN field of the inventory shows the planned action per ring whenever a "
                 "threshold is set, so the result can be previewed (and the hole layer styled "
                 "by PLAN) before a cleaned copy is written. Without Output Cleaned Polygons a "
                 "change log is a preview of the plan. The change log opens with three run rows "
                 "(RUN_SETTINGS, RUN_FLAGS, RUN_INPUT) that record the thresholds, logic, flag "
                 "parameters, coordinate system and unit of the run; every other row names a ring "
                 "(SRC_OID, SRC_RING) and its DETAIL says which rule fired. In a folder (dBASE) "
                 "change log a DETAIL longer than 254 bytes is cut to 254 bytes ending in "
                 "' ...[cut]' and the run warns; a geodatabase or GeoPackage log keeps it whole.\n\n"
                 "Differences from Eliminate Polygon Part (Advanced licence; source: its Esri "
                 "help page, linked at the end): by default it removes only parts contained by "
                 "other parts, "
                 "this tool drops any part below the threshold; it also has a percentage for "
                 "parts, this tool has not; its percentage is of the feature's total outer area, "
                 "here of the outer ring of the hole's own part; it removes an island inside a "
                 "hole that is filled, this tool keeps the hole (KEEP_HOLE_ISLAND); this tool "
                 "drops a part by its net area (how Eliminate Polygon Part measures a part with "
                 "holes is not verified); and every action is listed in a log.\n\n"
                 "Features with true curves are listed and skipped in the inventory; with an "
                 "Output Cleaned Polygons they stop the run (Densify them first). Features "
                 "without geometry are skipped in the inventory and copied without geometry. "
                 "Z and M values are not kept: the cleaned polygons and the hole polygons are "
                 "2D, and the run warns when the input stores Z or M values.\n\n"
                 "Size: the whole input is held in memory (no streaming). The tool warns for "
                 "50,000 features or more, and when its estimate reaches 1,000 MB (about 4.4 KB "
                 "per small feature, measured only in a simulated environment, not in ArcGIS "
                 "Pro). If Pro runs out of memory, split the input with a selection or "
                 "definition query and run the parts one after another.\n\n"
                 "A shapefile cannot store an empty number: in a folder output empty values "
                 "are stored as 0 (text as empty text) and the run warns about it. Use a file "
                 "geodatabase for empty values. Selections and definition queries on the input "
                 "layer are honoured. The input is never edited; no output may replace the "
                 "input or another output. If an arcpy error stops the run while outputs are "
                 "written, the outputs this run created are deleted.\n\n"
                 "Built-in alternative: Eliminate Polygon Part needs an Advanced licence (its "
                 "Esri help page, Licensing: Basic No, Standard No, Advanced Yes: "
                 "https://pro.arcgis.com/en/pro-app/latest/tool-reference/data-management/eliminate-polygon-part.htm); it produces one "
                 "feature class, with no inventory or log.",
        "params": {
            "in_features": "Polygon features in a projected coordinate system.",
            "out_inventory": "Output table with one row per ring (outer rings, holes and "
                             "degenerate rings).",
            "out_holes": "Optional output polygon feature class with every hole as a polygon "
                         "(same fields as the inventory).",
            "out_features": "Optional output cleaned polygons (holes and small parts below the "
                            "thresholds removed). Needs a change log and a threshold.",
            "out_log": "Optional output table: three run rows (the settings of the run) and one "
                       "row per ring changed or deliberately kept (ACTION and DETAIL). Required "
                       "with the cleaned polygons; alone it is a preview of the plan.",
            "min_hole_area_m2": "Fill holes with an area below this many square metres "
                                "(0 = off).",
            "max_hole_percent": "Fill holes whose area is below this percentage of their outer "
                                "ring (0 = off).",
            "hole_logic": "ANY fills a hole that meets either hole threshold, ALL one that "
                          "meets both (only matters when both are set).",
            "min_part_area_m2": "Drop parts with a net area below this many square metres "
                                "(0 = off).",
            "tiny_area_m2": "Flag TINY on rings with an area below this (square metres, "
                            "0 = off).",
            "sliver_width_m": "Flag SLIVER on rings with a mean width below this (metres, "
                              "0 = off) and a thinness below Maximum Thinness.",
            "max_thinness": "Thinness 4 * pi * area / perimeter^2 below this counts as thin "
                            "(1 = circle).",
            "touch_tolerance_m": "Boundary points closer than this (metres) count as touching.",
            "out_report": "Optional Excel (or CSV) report: summary and the inventory.",
            "hole_count": "Number of holes found (derived).",
        },
        "tags": ["polygon", "holes", "eliminate", "inventory", "basic"],
    }

    def __init__(self):
        self.label = "Polygon Holes and Parts"
        self.description = ("Inventory of polygon holes and parts with flags, optional hole "
                            "layer and a cleaned copy with a change log, without an Advanced tool (v"
                            + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_features", "Input Polygon Features", "GPFeatureLayer",
                       value_list=["Polygon"]),
            make_param("out_inventory", "Output Ring Inventory", "DETable", direction="Output"),
            make_param("out_holes", "Output Hole Polygons", "DEFeatureClass", direction="Output",
                       required=False),
            make_param("out_features", "Output Cleaned Polygons", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("out_log", "Output Change Log", "DETable", direction="Output",
                       required=False),
            make_param("min_hole_area_m2", "Fill Holes Smaller Than (m2)", "GPDouble",
                       required=False, default=0.0, category="Cleaning"),
            make_param("max_hole_percent", "Fill Holes Below Percent of Outer Ring", "GPDouble",
                       required=False, default=0.0, category="Cleaning"),
            make_param("hole_logic", "Hole Threshold Logic", "GPString", required=False,
                       value_list=[PH_LOGIC_ANY, PH_LOGIC_ALL], default=PH_LOGIC_ANY,
                       category="Cleaning"),
            make_param("min_part_area_m2", "Drop Parts Smaller Than (m2)", "GPDouble",
                       required=False, default=0.0, category="Cleaning"),
            make_param("tiny_area_m2", "Tiny Area (m2)", "GPDouble", required=False,
                       default=1.0, category="Flags"),
            make_param("sliver_width_m", "Sliver Width (m)", "GPDouble", required=False,
                       default=1.0, category="Flags"),
            make_param("max_thinness", "Maximum Thinness for Sliver", "GPDouble",
                       required=False, default=0.1, category="Flags"),
            make_param("touch_tolerance_m", "Touch Tolerance (m)", "GPDouble", required=False,
                       default=0.001, category="Flags"),
            make_param("out_report", "Output Report", "DEFile", direction="Output",
                       required=False, value_list=["xlsx", "csv"]),
            derived_output("hole_count", "Hole Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        for name in _PH_THRESHOLDS:
            value = p[name].value
            if value is not None and value != "":
                try:
                    number = float(value)
                except (TypeError, ValueError):
                    p[name].setErrorMessage("Enter a number.")
                    continue
                if number != number or number < 0 or number == float("inf"):
                    p[name].setErrorMessage("Enter a number of zero or more.")
        thresholds = self._thresholds_set(p)
        if param_text(p["out_features"]) and not param_text(p["out_log"]):
            p["out_log"].setErrorMessage("A change log is required with the cleaned polygons, "
                                         "so every change can be audited.")
        if (param_text(p["out_features"]) or param_text(p["out_log"])) and not thresholds:
            target = p["out_features"] if param_text(p["out_features"]) else p["out_log"]
            target.setErrorMessage("Set at least one cleaning threshold above 0 (Fill Holes "
                                   "Smaller Than, Fill Holes Below Percent of Outer Ring or "
                                   "Drop Parts Smaller Than), or there is nothing to change.")
        outs = [(n, param_text(p[n])) for n in ("out_inventory", "out_holes", "out_features",
                                                "out_log") if param_text(p[n])]
        for i, (name, path) in enumerate(outs):
            if any(same_dataset(path, other) for _n, other in outs[:i]):
                p[name].setErrorMessage("Every output needs its own name.")
        return

    @staticmethod
    def _thresholds_set(p):
        for name in ("min_hole_area_m2", "max_hole_percent", "min_part_area_m2"):
            try:
                if param_number(p[name], 0.0) > 0:
                    return True
            except (TypeError, ValueError):
                continue
        return False

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            # An arcpy error (e.g. while writing): the outputs it created were deleted
            # (_run); show what was collected first.
            flush_messages(collector)
            raise

    def _options(self, p):
        try:
            return polygon_holes_options(
                **dict((n, param_number(p[n], None)) for n in _PH_THRESHOLDS),
                hole_logic=param_text(p["hole_logic"]) or PH_LOGIC_ANY)
        except ValueError as exc:
            raise ToolError("A threshold is not valid: {0}.".format(exc),
                            "Enter numbers of zero or more; Hole Threshold Logic is ANY or ALL.")

    def _run(self, parameters, p, collector):
        report = choose_report_path(param_text(p["out_report"]), inputs=input_texts(p))
        if report and report["note"]:
            collector.info(report["note"])
        opts = self._options(p)
        out_inv = param_text(p["out_inventory"])
        out_holes = param_text(p["out_holes"])
        out_clean = param_text(p["out_features"])
        out_log = param_text(p["out_log"])
        planning = polygon_holes_has_thresholds(opts)
        if (out_clean or out_log) and not planning:
            raise ToolError("No cleaning threshold is set, so there is nothing to change.",
                            "Set Fill Holes Smaller Than, Fill Holes Below Percent of Outer "
                            "Ring or Drop Parts Smaller Than above 0, or leave the cleaned "
                            "polygons and the change log out.")
        if out_clean and not out_log:
            raise ToolError("A change log is required with the cleaned polygons.",
                            "Give Output Change Log a name, so every change can be audited.")
        outputs = [o for o in (out_inv, out_holes, out_clean, out_log) if o]
        refuse_duplicate_outputs(outputs)

        desc = describe_dataset(param_text(p["in_features"]))
        if kind_from_shape_type(desc["shape_type"]) != GEOM_POLYGON:
            raise ToolError("The input must contain polygons.", "Choose a polygon layer.")
        problem = polygon_holes_crs_problem(desc["sr"])
        if problem:
            raise ToolError(problem[0], problem[1])
        mpu = float(desc["sr"]["meters_per_unit"])
        collector.info("Areas are planar areas in square metres of {0} (WKID {1}); one "
                       "coordinate unit is {2:.10g} m.".format(
                           desc["sr"]["name"], desc["sr"]["wkid"], mpu))
        inputs = [desc["catalog_path"]]
        for out in outputs:       # all outputs before the main work
            check_output_path(out, inputs)

        carry, skipped_names = [], []
        if out_clean:
            carry, skipped_names = analysis_carry_fields(desc["fields"], ("SRC_OID",))
            if skipped_names:
                collector.warning("Input field(s) not copied to the cleaned copy because the "
                                  "output uses the name: {0}. The new SRC_OID holds this "
                                  "input's ObjectIDs; an older SRC_OID (for example from an "
                                  "earlier run of this tool) is lost in the copy. Rename that "
                                  "field first if you need the first lineage.".format(
                                      ", ".join(skipped_names)))
            uncopied = _ph_uncopied_warning(desc["fields"])
            if uncopied:
                collector.warning(uncopied)
        scale_note = polygon_holes_scale_warning(_ph_count_features(desc["input"]))
        if scale_note:
            collector.warning(scale_note)
            flush_messages(collector)      # visible before the long read, not only at the end
        zm = {}
        rows, curved = read_features_skip_curves(desc["input"], [f["name"] for f in carry],
                                                 zm=zm)
        collector.info("{0} feature(s) read.".format(len(rows)))
        ring_count = sum(len(r["shape"]) for r in rows if r["shape"])
        vertex_count = sum(len(ring) for r in rows if r["shape"] for ring in r["shape"])
        scale_note = polygon_holes_scale_warning(len(rows), ring_count, vertex_count)
        if scale_note:
            collector.warning(scale_note)
        if curved and out_clean:
            raise ToolError(
                "{0} feature(s) have true curves: OID {1}. A cleaned copy would have to drop "
                "or alter them.".format(len(curved), analysis_oid_text(curved)),
                "Densify them first (Densify tool on a copy), or leave them out with a "
                "selection or definition query, then run the tool again.")

        if out_clean or out_holes:
            zm_note = self._zm_warning(desc, zm, bool(out_clean), bool(out_holes))
            if zm_note:
                collector.warning(zm_note)

        progress = Progress("Analysing rings", len(rows))
        analyses, plans, nulls, failed = [], [], [], []
        by_oid = {}
        for row in rows:
            progress.tick()
            if row["shape"] is None:
                nulls.append(row["oid"])
                continue
            try:
                analysis = analyse_polygon(row["oid"], row["shape"], mpu, opts)
                plan = plan_cleaning(analysis, opts) if planning else None
            except (ValueError, IndexError, KeyError, TypeError, ZeroDivisionError,
                    OverflowError) as exc:
                failed.append((row["oid"], str(exc)))
                continue
            analyses.append(analysis)
            by_oid[row["oid"]] = (analysis, plan)
            if plan is not None:
                plans.append(plan)
        progress.close()
        if failed and out_clean:
            raise ToolError(
                "{0} feature(s) could not be analysed: OID {1} (first cause: {2}).".format(
                    len(failed), analysis_oid_text([f[0] for f in failed]), failed[0][1]),
                "Run Repair Geometry on a copy of the input, or leave them out with a "
                "selection, then run the tool again.")

        ring_rows = [r for a in analyses for r in a["rows"]]
        hole_rows = [r for r in ring_rows if r["ring_type"] == PH_RING_HOLE]
        log_rows = [r for r in ring_rows if r["plan"]]
        detail_cut = 0
        if out_log:
            log_rows, detail_cut = _ph_fit_log_details(
                log_rows, is_folder_workspace(workspace_of(out_log)))
        run_rows = [_ph_run_row(a, d) for a, d in polygon_holes_run_notes(
            opts, mpu, __version__, desc["name"], desc["sr"]["name"], desc["sr"]["wkid"],
            len(rows))]
        summary = polygon_holes_summary(analyses, opts, plans if planning else None)

        wanted_inv = [f["name"] for f in _ph_inventory_specs(ring_rows)]
        wanted_log = [f["name"] for f in _ph_log_specs(run_rows + log_rows)]
        inv_specs, _r = plan_output_fields(out_inv, _ph_inventory_specs(ring_rows),
                                           fixed=len(_PH_INV_FIELDS))
        holes_specs = None
        if out_holes:
            holes_specs, _r = plan_output_fields(out_holes, _ph_inventory_specs(hole_rows),
                                                 fixed=len(_PH_INV_FIELDS))
        log_specs = None
        if out_log:
            log_specs, _r = plan_output_fields(out_log, _ph_log_specs(run_rows + log_rows),
                                               fixed=len(_PH_LOG_FIELDS))
        inv_oid = _ph_oid_field(out_inv, inv_specs, ring_rows, collector)
        holes_oid = _ph_oid_field(out_holes, holes_specs, hole_rows, collector) \
            if out_holes else None
        log_oid = _ph_oid_field(out_log, log_specs, run_rows + log_rows, collector) \
            if out_log else None
        clean_specs = None
        if out_clean:
            clean_oid = oid_output_field(out_clean, [r["oid"] for r in rows], collector)
            clean_specs = [clean_oid]
            clean_specs += analysis_carry_specs(carry, lambda n: [r["attrs"][n] for r in rows],
                                                read_output_domains(out_clean))
            clean_specs, renamed = plan_output_fields(out_clean, clean_specs, fixed=1)
            for old, new in renamed:
                collector.info("Field {0} is called {1} in the cleaned polygons.".format(
                    old, new))

        wkid = desc["sr"]["wkid"]
        created = []
        notes = []
        try:
            path, fmap = create_table(out_inv, inv_specs, inputs=inputs)
            created.append(path)
            notes.append(self._renamed_warning(path, wanted_inv, inv_specs))
            nulls_seen = set()
            insert_rows(path, [fmap[s["name"]] for s in inv_specs],
                        [_ph_with_oid(inv_oid, _ph_inventory_values(r)) for r in ring_rows],
                        null_fields=nulls_seen)
            collector.info("{0} ring(s) written to {1}.".format(len(ring_rows), path))
            notes.append(folder_null_number_warning(
                path, inv_specs, fmap, nulls_seen,
                "PART and RING 0 then also mark degenerate rings; NEST_PART, HOLES, NET_M2 "
                "and the other ring-type specific numbers are 0 where they do not apply."))
            if out_holes:
                hpath, hmap = create_feature_class(out_holes, GEOM_POLYGON, desc["sr_object"],
                                                   holes_specs, inputs=inputs)
                created.append(hpath)
                notes.append(self._renamed_warning(hpath, wanted_inv, holes_specs))
                nulls_seen = set()
                insert_rows(hpath, [hmap[s["name"]] for s in holes_specs],
                            [([list(reversed(r["coords"]))],
                              _ph_with_oid(holes_oid, _ph_inventory_values(r)))
                             for r in hole_rows],
                            kind=GEOM_POLYGON, wkid=wkid, null_fields=nulls_seen)
                collector.info("{0} hole polygon(s) written to {1}.".format(len(hole_rows),
                                                                             hpath))
                notes.append(folder_null_number_warning(
                    hpath, holes_specs, hmap, nulls_seen,
                    "NET_M2 and HOLES (outer-ring fields) and NEST_PART, NEST_RING are 0 on "
                    "hole rows."))
            if out_clean:
                cpath, cmap = create_feature_class(out_clean, GEOM_POLYGON, desc["sr_object"],
                                                   clean_specs, inputs=inputs)
                created.append(cpath)
                nulls_seen = set()
                out_rows = []
                for row in rows:
                    values = [oid_field_value(clean_oid, row["oid"])] + \
                        [row["attrs"][f["name"]] for f in carry]
                    if row["oid"] in by_oid:
                        analysis, plan = by_oid[row["oid"]]
                        geom = plan["geom"] if plan is not None else analysis["geom"]
                    else:
                        geom = None
                    out_rows.append((geom, values))
                insert_rows(cpath, [cmap[s["name"]] for s in clean_specs], out_rows,
                            kind=GEOM_POLYGON, wkid=wkid, null_fields=nulls_seen)
                collector.info("{0} cleaned polygon(s) written to {1}.".format(len(out_rows),
                                                                                cpath))
                lost = lost_domain_warning(clean_specs, cpath)
                if lost:
                    notes.append(lost)
            if out_log:
                lpath, lmap = create_table(out_log, log_specs, inputs=inputs)
                created.append(lpath)
                notes.append(self._renamed_warning(lpath, wanted_log, log_specs))
                nulls_seen = set()
                insert_rows(lpath, [lmap[s["name"]] for s in log_specs],
                            [_ph_with_oid(log_oid, _ph_log_values(r))
                             for r in run_rows + log_rows],
                            null_fields=nulls_seen)
                collector.info("{0} {1} row(s) and {2} run row(s) (RUN_SETTINGS, RUN_FLAGS, "
                               "RUN_INPUT: the settings of this run) written to {3}.".format(
                                   len(log_rows), "change log" if out_clean else "planned-change",
                                   len(run_rows), lpath))
                notes.append(folder_null_number_warning(
                    lpath, log_specs, lmap, nulls_seen,
                    "SRC_OID, PART, RING, SRC_RING, AREA_M2 and HOLE_PCT 0 then also mean 'not "
                    "applicable' (the run rows have no ring)."))
        except Exception:
            for done in created:  # never leave part of the outputs behind
                try:
                    safe_delete(done, inputs)
                except Exception:
                    pass
            raise

        notes.append(self._overlap_warning(analyses))
        notes.append(self._part_overlap_warning(analyses, bool(out_clean)))
        notes.append(_ph_detail_cut_warning(detail_cut))
        self._messages(collector, summary, opts, planning, bool(out_clean), nulls, failed,
                       curved, notes)
        if report:
            items = [("Input", desc["name"]),
                     ("Coordinate system", "{0} (WKID {1})".format(desc["sr"]["name"],
                                                                    desc["sr"]["wkid"])),
                     ("Metres per coordinate unit", mpu),
                     ("Area unit", "square metres")]
            for key in ("min_hole_area_m2", "max_hole_percent", "hole_logic", "min_part_area_m2",
                        "tiny_area_m2", "sliver_width_m", "max_thinness", "touch_tolerance_m"):
                items.append(("Setting " + key, opts[key]))
            items += self._summary_items(summary, planning, bool(out_clean))
            header = list(_PH_INV_FIELDS)
            for written in write_report(report, items, header,
                                        [_ph_inventory_values(r) for r in ring_rows]):
                collector.info("Report written to {0}.".format(written))
        set_derived_output(parameters, "hole_count", str(summary["holes"]))
        flush_messages(collector)

    @staticmethod
    def _renamed_warning(path, wanted, specs):
        """A warning when the output workspace validates a documented field name to another one.

        ``wanted``: the documented names, in order; ``specs``: the planned output specs (their
        ``name`` is the validated name)."""
        changed = [(a, s["name"]) for a, s in zip(wanted, specs) if a != s["name"]]
        if not changed:
            return None
        return ("The output workspace stores {0} under another name in '{1}': {2}. The values are "
                "in the renamed field; this tool's documentation uses the names it asked for."
                .format("a field" if len(changed) == 1 else "fields", path,
                        ", ".join("{0} -> {1}".format(a, b) for a, b in changed)))

    @staticmethod
    def _overlap_warning(analyses):
        """Warning text when holes of a part overlap (invalid geometry), else ``None``."""
        oids = [a["oid"] for a in analyses
                if any(PH_FLAG_OVERLAPS_HOLE in r["flags"] for r in a["rows"])]
        if not oids:
            return None
        return ("{0} feature(s) have holes that overlap each other (OID {1}); the geometry is "
                "invalid. The net area (NET_M2) of their parts subtracts the shared area twice "
                "and is too small, so a Drop Parts Smaller Than decision on such a part can be "
                "wrong, and the cleaned area no longer equals the input area plus the filled "
                "holes. Rings are flagged OVERLAPS_OTHER_HOLE. Run Repair Geometry on a copy of "
                "the input and run the tool again.".format(len(oids), analysis_oid_text(oids)))

    @staticmethod
    def _part_overlap_warning(analyses, cleaned):
        """Warning text when a NO_OUTER part shares area with another part of its feature
        (flag OVERLAPS_PART; invalid geometry), else ``None``."""
        oids = [a["oid"] for a in analyses
                if any(PH_FLAG_OVERLAPS_PART in r["flags"] for r in a["rows"])]
        if not oids:
            return None
        return ("{0} feature(s) have a NO_OUTER part (a counter-clockwise ring with no outer "
                "ring) that shares area with another part of the feature (OID {1}); the "
                "geometry is invalid. Both parts are counted in full, so the shared area is "
                "counted twice in the summary's net area{2}. Rings are flagged "
                "OVERLAPS_PART. Run Repair Geometry on a copy of the input and run the tool "
                "again.".format(len(oids), analysis_oid_text(oids),
                                ", and a changed feature is written with both parts clockwise, "
                                "so they still overlap in the cleaned copy" if cleaned else ""))

    @staticmethod
    def _zm_warning(desc, zm, cleaned, holes):
        """Warning text when the input stores Z or M values: the outputs are 2D (areas, rings
        and containment are planar), so the values are not copied. ``None`` when there are none."""
        z_ids, m_ids = zm.get("z", []), zm.get("m", [])
        has_z = bool(z_ids) or desc.get("has_z")
        has_m = bool(m_ids) or desc.get("has_m")
        if not (has_z or has_m):
            return None
        kinds = "Z and M" if has_z and has_m else ("Z" if has_z else "M")
        where = []
        if cleaned:
            where.append("the cleaned polygons")
        if holes:
            where.append("the hole polygons")
        ids = sorted(set(z_ids) | set(m_ids))
        counted = ("{0} feature(s) carry them (OID {1})".format(len(ids), analysis_oid_text(ids))
                   if ids else "the input is Z/M-enabled")
        return ("The input stores {0} values, which this tool does not keep: {1} are written "
                "as 2D polygons with the {0} values removed ({2}). Areas, rings and holes are "
                "planar and are not affected. If you need the {0} values, do not use the cleaned "
                "copy for that data.".format(kinds, " and ".join(where), counted))

    @staticmethod
    def _summary_items(summary, planning, cleaned):
        items = [("Features analysed", summary["features"]),
                 ("Features with holes", summary["with_holes"]),
                 ("Multipart features", summary["multipart"]),
                 ("Parts (outer rings)", summary["parts"]),
                 ("Holes", summary["holes"]),
                 ("Degenerate rings", summary["degenerate"]),
                 ("Total hole area (m2)", summary["hole_area_m2"]),
                 ("Total net area (m2)", summary["net_area_m2"])]
        for flag in PH_FLAGS:
            items.append(("Rings flagged " + flag, summary["flag_" + flag]))
        if planning:
            word = "" if cleaned else "planned: "
            items += [(word + "holes filled", summary["filled"]),
                      (word + "area of holes filled (m2)", summary["filled_m2"]),
                      (word + "parts dropped", summary["dropped_parts"]),
                      (word + "net area of parts dropped (m2)", summary["dropped_m2"]),
                      (word + "holes removed with dropped parts", summary["dropped_holes"]),
                      (word + "holes kept because of an island", summary["kept_island"]),
                      (word + "features whose largest part was kept", summary["kept_largest"]),
                      (word + "zero-area rings removed", summary["zero_area"]),
                      (word + "NO_OUTER rings written clockwise", summary["oriented"]),
                      (word + "features changed", summary["features_changed"]),
                      (word + "net area after cleaning (m2)", summary["cleaned_net_area_m2"])]
        return items

    def _messages(self, collector, s, opts, planning, cleaned, nulls, failed, curved, notes):
        collector.info("{0} feature(s): {1} part(s), {2} hole(s) ({3:.6g} m2 in total), {4} "
                       "degenerate ring(s); {5} feature(s) have holes, {6} are multipart."
                       .format(s["features"], s["parts"], s["holes"], s["hole_area_m2"],
                               s["degenerate"], s["with_holes"], s["multipart"]))
        flagged = ["{0}: {1}".format(f, s["flag_" + f]) for f in PH_FLAGS if s["flag_" + f]]
        if flagged:
            collector.info("Flags: " + ", ".join(flagged) + ".")
        if planning:
            collector.info(ph_plan_summary_text(s, cleaned))
            if s["oriented"]:
                collector.info(
                    "{0} NO_OUTER ring(s) (counter-clockwise, with no outer ring) in changed "
                    "features {1} written clockwise, as the parts the inventory counts "
                    "(ORIENT_NO_OUTER in the change log).".format(
                        s["oriented"], "are" if cleaned else "would be"))
        for note in notes:
            if note:
                collector.warning(note)
        if nulls:
            collector.warning("{0} feature(s) have no geometry: OID {1}. {2}".format(
                len(nulls), analysis_oid_text(nulls),
                "They are copied without geometry." if cleaned else "They are skipped."))
        if curved:
            collector.warning("{0} feature(s) with true curves were skipped: OID {1}. Densify "
                              "them first to include them.".format(len(curved),
                                                                   analysis_oid_text(curved)))
        if failed:
            collector.warning("{0} feature(s) could not be analysed and were skipped: OID {1} "
                              "(first cause: {2}). Run Repair Geometry on a copy, then run "
                              "the tool again.".format(
                                  len(failed), analysis_oid_text([f[0] for f in failed]),
                                  failed[0][1]))
        if s["degenerate"] and not planning:
            collector.warning("{0} ring(s) have no area: they are listed in the "
                              "inventory (RING_TYPE DEGENERATE).".format(s["degenerate"]))


# ==========================================================================
# analysis/thinning_tool.py
# ==========================================================================
# Point Thinning by Priority: the ArcGIS Pro tool (adapter).

_TP_CONTENT_KEPT = "KEPT_ONLY"
_TP_CONTENT_ALL = "ALL_WITH_FLAGS"
_TP_CONTENTS = (_TP_CONTENT_KEPT, _TP_CONTENT_ALL)
_TP_NUMBER_TYPES = ("SmallInteger", "Integer", "BigInteger", "Single", "Double")
_TP_GROUP_SKIP_TYPES = ("Geometry", "Blob", "Raster", "XML")
# Names the tool writes itself (carried input fields with these names are not copied).
_TP_FIELDS = ("SRC_OID", "KEPT", "IS_PROT", "PRI_RANK", "PROT_VIOL", "REMOVED_BY", "REM_DIST_M")
_TP_NUMBER_KEYWORDS = ("SHORT", "LONG", "BIGINTEGER", "FLOAT", "DOUBLE")


# What an empty value of a tool field means, for the folder-output warning: (fields, meaning).
_TP_NULL_MEANINGS = ((("REMOVED_BY", "REM_DIST_M"), "'not removed' (the point is kept)"),
                     (("MIN_SP_M", "MIN_SP_NP", "MEAN_SP_M"),
                      "'not defined' (fewer than two kept points)"))


# (factoryCode, name) -> result of thin_pole_azimuthal_sign; systems with a WKID only.
_TP_POLE_CACHE = {}


def thin_pole_azimuthal_sign(sr):
    """1 / -1 when the projected system ``sr`` is an azimuthal projection about the North /
    South Pole (any kind: polar stereographic, Lambert azimuthal equal-area, azimuthal
    equidistant ...), else ``None``. The points of ``projection.polar_probe_points`` are
    projected into ``sr`` one by one (``arcpy.AsShape`` in WGS 84, ``projectAs``) and tested
    with ``thinning_core.thin_pole_azimuthal_probe``; a point that cannot be projected makes
    the system "not about that pole". Name independent."""
    if sr is None:
        return None
    try:
        key = (sr.factoryCode, sr.name) if sr.factoryCode else None
    except Exception:
        key = None
    if key is not None and key in _TP_POLE_CACHE:
        return _TP_POLE_CACHE[key]
    found = None
    for sign in (1, -1):
        projected = []
        for lon, lat in polar_probe_points(sign):
            try:
                shape = arcpy.AsShape({"x": lon, "y": lat, "spatialReference": {"wkid": 4326}},
                                      True).projectAs(sr)
                data = json.loads(shape.JSON)
                projected.append((float(data["x"]), float(data["y"])))
            except Exception:  # outside the system's domain: not this pole's projection
                projected.append(None)
        if thin_pole_azimuthal_probe(projected, [sign * v for v in POLAR_PROBE_LATS],
                                     POLAR_PROBE_LONS):
            found = sign
            break
    if key is not None:
        _TP_POLE_CACHE[key] = found
    return found


# Points per multipoint when the tool projects the points and their probes (one projectAs call
# per batch instead of one per point; a batch that fails falls back to one call per point).
_TP_BATCH = 2000


def _tp_sr_ref(sr):
    """Esri JSON ``spatialReference`` of ``sr`` (its WKID, else its WKT)."""
    wkid = int(getattr(sr, "factoryCode", 0) or 0)
    return {"wkid": wkid} if wkid else {"wkt": sr.exportToString()}


def _tp_finite(p):
    return p is not None and math.isfinite(p[0]) and math.isfinite(p[1])


def _tp_project_one(xy, from_ref, to_sr):
    """``(x, y)`` of the point ``xy`` (in ``from_ref``) projected into ``to_sr``, or ``None``."""
    try:
        data = json.loads(arcpy.AsShape({"x": float(xy[0]), "y": float(xy[1]),
                                         "spatialReference": from_ref}, True).projectAs(to_sr).JSON)
        out = (float(data["x"]), float(data["y"]))
    except Exception:  # outside the system's domain, or no coordinates
        return None
    return out if _tp_finite(out) else None


def thin_project_points(points, from_ref, to_sr):
    """``points`` (``(x, y)`` in the system of the JSON ``spatialReference`` ``from_ref``)
    projected into ``to_sr`` (``Geometry.projectAs``, no datum transformation): a list of
    ``(x, y)`` or ``None`` where a point cannot be projected. The points go in multipoints of
    ``_TP_BATCH``; a batch is used only when it returns as many finite points as it was given and
    its first, middle and last points equal the same points projected one by one; otherwise (and
    for each point it could not project) the points are projected one by one."""
    out = []
    for start in range(0, len(points), _TP_BATCH):
        chunk = points[start:start + _TP_BATCH]
        got = None
        try:
            data = json.loads(arcpy.AsShape({"points": [[float(x), float(y)] for x, y in chunk],
                                             "spatialReference": from_ref}, True)
                              .projectAs(to_sr).JSON)
            back = [(float(q[0]), float(q[1])) for q in (data.get("points") or [])]
            if len(back) == len(chunk):
                got = back
                for k in sorted(set((0, len(chunk) // 2, len(chunk) - 1))):
                    one = _tp_project_one(chunk[k], from_ref, to_sr)
                    if one is None or not _tp_finite(back[k]) or any(
                            abs(u - v) > 1e-9 * (1.0 + abs(u)) for u, v in zip(one, back[k])):
                        got = None
                        break
        except Exception:  # the batch could not be projected: one by one below
            got = None
        if got is None:
            got = [_tp_project_one(q, from_ref, to_sr) for q in chunk]
        else:
            got = [q if _tp_finite(q) else _tp_project_one(chunk[k], from_ref, to_sr)
                   for k, q in enumerate(got)]
        out.extend(got)
    return out


def thin_ground_maps(sr, metres_per_unit, xy):
    """``{(x, y): (G, k_min, k_max) or None}`` for every distinct point of ``xy`` (coordinates of
    the projected system ``sr``): the ground map of ``thinning_core.thin_ground_map`` at the point.
    Each point is projected to WGS 1984 (no datum transformation, so the latitude and longitude
    are those of the system's own datum), its four probe points (``thin_probe_points``) are
    projected back into ``sr``, and ``None`` marks a point where any of that fails. Name
    independent."""
    unique = list(dict.fromkeys((float(x), float(y)) for x, y in xy))
    out = dict((p, None) for p in unique)
    if sr is None or not unique:
        return out
    try:
        sref = _tp_sr_ref(sr)
        wgs = arcpy.SpatialReference(4326)
    except Exception:
        return out
    lonlat = thin_project_points(unique, sref, wgs)
    probes, owners = [], []
    for p, ll in zip(unique, lonlat):
        made = thin_probe_points(ll[0], ll[1]) if ll is not None else None
        if made is None:
            continue
        probes.extend(made[0])
        owners.append((p, made[1]))
    back = thin_project_points(probes, {"wkid": 4326}, sr)
    for k, (p, h) in enumerate(owners):
        four = back[4 * k:4 * k + 4]
        if all(q is not None for q in four):
            out[p] = thin_ground_map(four, h, metres_per_unit)
    return out


def thin_null_note(field_specs, mapping, null_fields):
    """What the empty tool fields of a folder output mean, or ``""``.

    Only the fields of ``field_specs`` (``{name, type}``) that the output really has and that
    received an empty value (``null_fields``: the actual names, as ``insert_rows`` reports them)
    are named, each as a shapefile stores it: 0 for a number field, empty text for a TEXT
    field (REMOVED_BY becomes text with ObjectIDs of 13 or more digits). Copied attributes and
    other fields are not described here."""
    null_fields = set(null_fields or ())
    by_name = dict((s.get("name"), s) for s in field_specs or ())
    sentences = []
    for names, meaning in _TP_NULL_MEANINGS:
        said = []
        for name in names:
            spec = by_name.get(name)
            if spec is None:
                continue
            actual = (mapping or {}).get(name, name)
            if actual not in null_fields:
                continue
            kind = str(spec.get("type", "")).upper()
            if kind in _TP_NUMBER_KEYWORDS:
                said.append("{0} 0".format(actual))
            elif kind == "TEXT":
                said.append("an empty {0}".format(actual))
        if said:
            sentences.append("{0} then also {1} {2}.".format(
                " and ".join(said), "means" if len(said) == 1 else "mean", meaning))
    return " ".join(sentences)


def _tp_system_key(sr):
    """(factory code, name) of a spatial reference, for comparing two of them."""
    try:
        code = int(getattr(sr, "factoryCode", 0) or 0)
    except (TypeError, ValueError):
        code = 0
    try:
        name = str(getattr(sr, "name", "") or "")
    except Exception:
        name = ""
    return code, name


def thin_dataset_system_clash(out_path, sr_object):
    """Name of the coordinate system of the feature dataset that ``out_path`` is written into,
    when it differs from ``sr_object`` (the input's); else ``None``.

    A feature class in a feature dataset always takes the dataset's coordinate system: the
    points would be projected on insert (or, for a system without a WKID, read in the wrong
    system) and the output would not be in the input's system. The run is refused instead.
    Not in a feature dataset (a geodatabase root, a folder), or nothing readable: ``None``.
    Systems are compared by WKID when both have one, else by name (ignoring case).
    Same rule as Vertex Extractor's ``vx_dataset_system_clash``."""
    text = str(out_path or "").rstrip("\\/")
    if not text:
        return None
    parent = split_catalog_path(text)[0].rstrip("\\/")
    if not parent or parent == str(workspace_of(text)).rstrip("\\/"):
        return None
    try:
        d = arcpy.da.Describe(parent)
    except Exception:
        return None
    if not isinstance(d, dict) or str(d.get("dataType") or "") != "FeatureDataset":
        return None
    dsr = d.get("spatialReference")
    if dsr is None or sr_object is None:
        return None
    dcode, dname = _tp_system_key(dsr)
    icode, iname = _tp_system_key(sr_object)
    if dcode and icode:
        same = dcode == icode
    else:
        same = dname.casefold() == iname.casefold()
    return None if same else (dname or str(dcode) or "unknown")


class PriorityPointThinning(object):
    """Keeps the highest-priority points that are at least a minimum distance apart."""

    DOC = {
        "summary": "Thins a dense point layer so that no two kept points are closer than a "
                   "minimum spacing (in metres, or taken from a map scale and the smallest "
                   "distance between two symbols on paper), keeping the points with the "
                   "highest priority first. Priority comes from a numeric field, optionally "
                   "with a second field as tie-break; chosen points can be protected (always "
                   "kept), and the points can be thinned group by group. Writes the kept "
                   "points (or all points with KEPT flags), optionally the removed points "
                   "with the point that removed each one and the distance, and a summary "
                   "table. Works on a Basic licence, no extension.",
        "usage": "Method: a greedy selection. The points are ranked (protected points first, "
                 "then by the priority field, then by the tie-break field, then by ObjectID "
                 "ascending). Walking down the ranking, a point is kept unless a point that is "
                 "already kept lies closer than the spacing. This is a heuristic: the result "
                 "is maximal (no removed point could be added back) but not necessarily the "
                 "largest possible set, which is NP-hard to find in general. In the tests, on "
                 "200 sets of 18 random points per spacing (spacings of 15, 25 and 35 in a "
                 "100 x 100 square, compared with an exhaustive search), the greedy result had "
                 "on average 3 to 17 percent fewer points than the largest possible set, and in "
                 "a constructed worst case it kept 1 point where 5 fit. It is deterministic: the same input and settings always give "
                 "the same result.\n\n"
                 "Guarantees: (1) any two kept points are at least the spacing apart, except "
                 "two protected points; (2) every removed point has a kept point closer than "
                 "the spacing that was ranked before it; (3) a point is kept exactly when no "
                 "higher-ranked kept point is closer than the spacing. A pair of points at "
                 "exactly the spacing is not 'closer' and both stay. No tolerance is applied to "
                 "the spacing test. Distances are measured on the ground (see Spacing), so points "
                 "on a regular grid of the coordinate system are not exactly the grid step apart "
                 "on the ground unless the system's scale is 1 there; to keep every grid point, "
                 "use a spacing a little below the smallest ground step.\n\n"
                 "Priority: Keep First HIGHEST_VALUE keeps the points with the largest value "
                 "first, LOWEST_VALUE the smallest. Points with a null or NaN priority are "
                 "ranked after every point that has a value (in both directions) and are then "
                 "ordered by the tie-break field and ObjectID. Equal priorities are decided by "
                 "the tie-break field, then by the lower ObjectID. The priority and tie-break "
                 "fields are number fields (Short, Long, Big Integer, Float, Double); text "
                 "fields are not accepted.\n\n"
                 "Spacing: give either Minimum Spacing in metres, or a Map Scale (the number "
                 "after the colon, 25000 for 1:25,000) together with the smallest distance "
                 "between two symbol centres on paper in millimetres: spacing = scale x mm / "
                 "1000 (1:25,000 and 3 mm give 75 m). The input must be in a projected coordinate "
                 "system with a known linear unit; geographic (degree) input and input without "
                 "a coordinate system are refused. Every distance (the spacing test, REM_DIST_M "
                 "and the summary spacings) is a ground distance in metres on the WGS 1984 "
                 "ellipsoid, whatever the projected system: at every point the tool measures "
                 "how the system maps the ground there (the point is projected to latitude and "
                 "longitude without a datum transformation, and four points 100 m east, west, "
                 "north and south of it are projected back; near a pole the step is shorter), "
                 "and the distance of two points is the mean of their two local measurements "
                 "(the trapezoid rule; in the tests it is within 0.0002 % of the geodesic for "
                 "distances up to 20 km, and the difference grows with the square of the "
                 "distance). So the spacing is right on the ground in a national or continental "
                 "system (Albers, Lambert, LAEA Europe), in UTM, in polar systems and in Web "
                 "Mercator up to about 60 degrees latitude, and the run reports the range it measured: 'this coordinate "
                 "system stretches a ground distance by a factor of A to B'. The tool refuses "
                 "only points where that factor is below 0.5 or above 2 (Web Mercator beyond "
                 "about 60 degrees latitude, a world system far from its true-scale line, a "
                 "polar system far from its pole), naming the points and the kind of system, "
                 "and points where the scale could not be measured (they could not be projected "
                 "to WGS 1984 and back, or lie within about 1 km of a pole). Fix: project the "
                 "points to a system made for their area (an Albers or Lambert system for a "
                 "country or continent, the UTM zone for a small area), or split the area. The "
                 "latitude and longitude are measured on the WGS 1984 ellipsoid even when the "
                 "system's datum uses another ellipsoid (a difference of at most about 0.02 % "
                 "for the usual ellipsoids).\n\n"
                 "Protected points: an SQL query (for example IMPORTANT = 1) selects points "
                 "that are always kept. They are placed first in the ranking, so they also "
                 "remove other points within the spacing, even points with a higher priority. "
                 "Two protected points closer than the spacing are both kept and reported "
                 "(PROT_VIOL = 1, a warning, and the summary table). Many protected points "
                 "within one spacing of each other are slow: each one is compared with every "
                 "other, so the time grows with the square of their number (thousands of "
                 "them stacked at a few addresses can take minutes).\n\n"
                 "Groups: with a Group Field the points are thinned separately for every value "
                 "(points of different groups never remove each other, so the spacing is "
                 "guaranteed within each group only and points of different groups can be "
                 "closer); null and NaN values form one group of their own, marked GROUP_NULL = 1 "
                 "in the summary table (a shapefile or dBASE table stores a null text as an "
                 "empty one, so GROUP_VAL alone cannot tell it from a group of empty text). "
                 "Text values are compared exactly. Apply Spacing Across Groups thins all points as one set instead: "
                 "the spacing then holds between any two kept points, and the groups only "
                 "split the summary. PRI_RANK restarts at 1 in every group (it is one "
                 "ranking over all points with Apply Spacing Across Groups).\n\n"
                 "Output Content KEPT_ONLY writes only the kept points; ALL_WITH_FLAGS writes "
                 "every point with KEPT 1 or 0 and, for removed points, REMOVED_BY and "
                 "REM_DIST_M. REMOVED_BY is the nearest kept point that was ranked before the "
                 "removed point (kept points whose distances agree to 1 part in 10^9 count as "
                 "equally near, and the one ranked first is named). The optional removed-points output has the removed points "
                 "only.\n\n"
                 "Z and M values are ignored (distances use x and y only, measured on the "
                 "ground; outputs are 2D). Points without geometry or with non-finite coordinates are skipped and "
                 "listed. Points at the same location: the best-ranked one is kept, the others "
                 "have distance 0. A shapefile or dBASE output cannot hold empty numbers: they "
                 "are stored as 0 and the run warns about it. SRC_OID and REMOVED_BY are Long "
                 "fields while every ObjectID fits 32 bits; with larger (64-bit) ObjectIDs they "
                 "are Big Integer in a geodatabase (an ObjectID above 2^53 - 1, which ArcGIS Pro "
                 "cannot store there, stops the run with the fix) and, in a shapefile or dBASE "
                 "table, Double while every ObjectID has at most 12 significant digits (a dBASE "
                 "Double keeps no more) and else text of 20 characters with every digit kept, "
                 "with a message (a kept point then has an empty REMOVED_BY text instead of 0). "
                 "An output into a feature dataset whose coordinate system is not the input's is "
                 "refused: a feature dataset would project the points to its own system.\n\n"
                 "Selections and definition queries on the input layer are honoured. The "
                 "input is never edited. If an arcpy error stops the run while an output is "
                 "written, the outputs this run created are deleted and the messages "
                 "collected so far are shown before the error.\n\n"
                 "Built-in alternatives (licences as Esri's ArcGIS Pro 3.3 help pages state "
                 "them): Reduce Point Density thins by a depth value and needs the ArcGIS "
                 "Bathymetry extension (Basic: No; pro.arcgis.com/en/pro-app/3.3/tool-reference/"
                 "bathymetry/reduce-point-density.htm); Thin Spot Heights works on spot-height "
                 "points only (Basic and Standard: No; Advanced: Requires Production Mapping; "
                 "pro.arcgis.com/en/pro-app/3.3/tool-reference/topographic-production/"
                 "thin-spot-heights.htm); Aggregate Points makes polygons around clusters "
                 "(Basic and Standard: No; Advanced: Yes; pro.arcgis.com/en/pro-app/3.3/"
                 "tool-reference/cartography/aggregate-points.htm). The free QGIS plugin "
                 "point_selection is a related tool outside ArcGIS Pro.",
        "params": {
            "in_points": "Point features to thin.",
            "priority_field": "Numeric field that says which points matter most.",
            "priority_order": "HIGHEST_VALUE keeps the largest priority values first, "
                              "LOWEST_VALUE the smallest.",
            "tiebreak_field": "Optional numeric field that decides between equal priorities.",
            "tiebreak_order": "Direction of the tie-break field.",
            "min_spacing": "Minimum distance between kept points, in metres. Use this or the "
                           "map scale with the symbol distance.",
            "map_scale": "Map scale denominator (25000 for 1:25,000), used with the symbol "
                         "distance on paper.",
            "symbol_spacing_mm": "Smallest distance between two symbol centres on paper, in "
                                 "millimetres. Spacing in metres = scale x mm / 1000.",
            "group_field": "Optional field: points are thinned separately for each value. The "
                           "spacing is then guaranteed within each group only.",
            "across_groups": "With a Group Field: apply the spacing between points of "
                             "different groups too (all points are thinned as one set).",
            "protected_where": "Optional SQL query selecting points that are always kept.",
            "output_content": "KEPT_ONLY writes the kept points; ALL_WITH_FLAGS writes every "
                              "point with a KEPT flag.",
            "copy_attributes": "Copy the input attributes to the output points.",
            "out_features": "Output point feature class: SRC_OID, KEPT, IS_PROT, PRI_RANK, "
                            "PROT_VIOL (plus REMOVED_BY, REM_DIST_M with ALL_WITH_FLAGS) and "
                            "the input attributes.",
            "out_removed": "Optional output point feature class with the removed points: "
                           "SRC_OID, REMOVED_BY, REM_DIST_M, PRI_RANK and the input "
                           "attributes.",
            "out_summary": "Optional output table: one row per group (with a Group Field) and "
                           "a TOTAL row with counts, protected violations and the minimum and "
                           "mean spacing achieved. GROUP_NULL = 1 marks the row of the null "
                           "group.",
            "kept_count": "Number of kept points (derived).",
            "removed_count": "Number of removed points (derived).",
        },
        "tags": ["thinning", "points", "generalization", "priority", "spacing", "basic"],
    }

    def __init__(self):
        self.label = "Point Thinning by Priority"
        self.description = ("Thins a dense point layer to a minimum spacing, keeping the "
                            "highest-priority points first, on a Basic licence (v"
                            + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_points", "Input Points", "GPFeatureLayer", value_list=["Point"]),
            make_param("priority_field", "Priority Field", "Field", depends_on="in_points",
                       value_list=["Short", "Long", "BigInteger", "Float", "Double"]),
            make_param("priority_order", "Keep First", "GPString", required=False,
                       default=THIN_HIGHEST, value_list=list(THIN_ORDERS)),
            make_param("tiebreak_field", "Tie-break Field", "Field", required=False,
                       depends_on="in_points", value_list=["Short", "Long", "BigInteger", "Float", "Double"]),
            make_param("tiebreak_order", "Tie-break Order", "GPString", required=False,
                       default=THIN_HIGHEST, value_list=list(THIN_ORDERS)),
            make_param("min_spacing", "Minimum Spacing (meters)", "GPDouble", required=False),
            make_param("map_scale", "Map Scale (1 : ...)", "GPDouble", required=False),
            make_param("symbol_spacing_mm", "Symbol Distance on Paper (mm)", "GPDouble",
                       required=False),
            make_param("group_field", "Group Field", "Field", required=False,
                       depends_on="in_points"),
            make_param("across_groups", "Apply Spacing Across Groups", "GPBoolean", required=False,
                       default=False),
            make_param("protected_where", "Protected Points (SQL query)", "GPSQLExpression",
                       required=False, depends_on="in_points"),
            make_param("output_content", "Output Content", "GPString", required=False,
                       default=_TP_CONTENT_KEPT, value_list=list(_TP_CONTENTS)),
            make_param("copy_attributes", "Copy Attributes", "GPBoolean", required=False,
                       default=True),
            make_param("out_features", "Output Points", "DEFeatureClass", direction="Output"),
            make_param("out_removed", "Output Removed Points", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("out_summary", "Output Summary Table", "DETable", direction="Output",
                       required=False),
            derived_output("kept_count", "Kept Count", "GPLong"),
            derived_output("removed_count", "Removed Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        p = param_map(parameters)
        by_scale = p["map_scale"].value is not None or p["symbol_spacing_mm"].value is not None
        by_distance = p["min_spacing"].value is not None
        p["across_groups"].enabled = bool(param_text(p["group_field"]))
        p["min_spacing"].enabled = not by_scale
        p["map_scale"].enabled = not by_distance
        p["symbol_spacing_mm"].enabled = not by_distance
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        distance = p["min_spacing"].value
        scale = p["map_scale"].value
        mm = p["symbol_spacing_mm"].value
        if distance is not None and (scale is not None or mm is not None):
            p["min_spacing"].setErrorMessage("Give a Minimum Spacing, or a Map Scale with the "
                                             "Symbol Distance, not both.")
        elif distance is None and scale is None and mm is None:
            p["min_spacing"].setErrorMessage("Give a Minimum Spacing in meters, or a Map Scale "
                                             "with the Symbol Distance on Paper.")
        elif distance is None and (scale is None or mm is None):
            (p["symbol_spacing_mm"] if mm is None else p["map_scale"]).setErrorMessage(
                "The Map Scale and the Symbol Distance on Paper are needed together.")
        for name, label in (("min_spacing", "The spacing"), ("map_scale", "The map scale"),
                            ("symbol_spacing_mm", "The symbol distance")):
            value = p[name].value
            if value is not None and not float(value) > 0:
                p[name].setErrorMessage("{0} must be greater than 0.".format(label))
        prio, tie = param_text(p["priority_field"]), param_text(p["tiebreak_field"])
        if prio and tie and prio.casefold() == tie.casefold():
            p["tiebreak_field"].setErrorMessage("Use a different field than the Priority Field.")
        outputs = [param_text(p["out_features"]), param_text(p["out_removed"]),
                   param_text(p["out_summary"])]
        if find_duplicate_outputs(outputs):
            p["out_features"].setErrorMessage("Give every output its own name.")
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            # An arcpy error (e.g. while writing): the outputs it created were deleted
            # (_run); show what was collected (points read, spacing) first.
            flush_messages(collector)
            raise

    # -- settings ---------------------------------------------------------------------

    def _spacing(self, p, collector):
        """``(spacing in metres, description)`` from the distance or the scale parameters."""
        distance = param_number(p["min_spacing"])
        scale = param_number(p["map_scale"])
        mm = param_number(p["symbol_spacing_mm"])
        if distance is not None and (scale is not None or mm is not None):
            raise ToolError("Both a Minimum Spacing and a Map Scale / Symbol Distance were "
                            "given.", "Give only one of them.")
        if distance is not None:
            if not distance > 0:
                raise ToolError("The Minimum Spacing must be greater than 0.",
                                "Enter a distance in meters such as 50.")
            if not math.isfinite(distance):
                raise ToolError("The Minimum Spacing is too large: it is not a finite number.",
                                "Enter a distance in meters such as 50.")
            return distance, "{0:g} m".format(distance)
        if scale is None or mm is None:
            raise ToolError("No spacing was given.",
                            "Enter a Minimum Spacing in meters, or both a Map Scale and the "
                            "Symbol Distance on Paper in millimetres.")
        metres = thin_spacing_from_scale(scale, mm)
        return metres, "{0:g} m (1:{1:,.0f} x {2:g} mm / 1000)".format(metres, scale, mm)

    def _measuring(self, desc):
        """Metres per coordinate unit; refuses input without a projected system and linear unit.
        The ground scale of every point is measured later (``_ground``)."""
        info = desc["sr"] or {}
        if sr_is_unknown(info):
            raise ToolError("The input has no coordinate system, so a spacing in meters cannot "
                            "be applied.",
                            "Define the coordinate system (Define Projection) or project the "
                            "points to a projected system such as UTM first.")
        if info.get("type") == "Geographic":
            raise ToolError("The input is in a geographic coordinate system ({0}); its units "
                            "are degrees, not meters.".format(info.get("name")),
                            "Project the points to a projected system suited to the area, such "
                            "as the UTM zone (Project tool), then run the tool on the result.")
        if info.get("type") != "Projected" or not info.get("meters_per_unit"):
            raise ToolError("The coordinate system of the input ({0}) is not a projected system "
                            "with a known linear unit.".format(info.get("name")),
                            "Project the points to a projected system such as UTM first.")
        return float(info["meters_per_unit"])

    def _ground(self, desc, mpu, points, collector):
        """``{oid: G}``: the ground map of every point (``thin_ground_maps``), so that every
        distance is a ground distance in metres. Refuses the input when the scale cannot be
        measured at a point, or when the system stretches a ground distance there by less than
        ``THIN_MIN_SCALE`` or more than ``THIN_MAX_SCALE``; the system's kind (Web Mercator,
        Mercator, cylindrical, polar ...) only chooses the explanation."""
        info = desc["sr"] or {}
        name = info.get("name")
        sr = desc.get("sr_object")
        maps = thin_ground_maps(sr, mpu, [(pt[1], pt[2]) for pt in points])
        unmeasured = sorted(pt[0] for pt in points if maps[(float(pt[1]), float(pt[2]))] is None)
        if unmeasured:
            raise ToolError(
                "The scale of the coordinate system ({0}) could not be measured at {1} point(s) "
                "(OID {2}): they could not be projected to WGS 1984 and back, or they lie within "
                "about 1 km of a pole, so their ground distances are not known.".format(
                    name, len(unmeasured), analysis_oid_text(unmeasured)),
                "Project the points to a projected system that covers them (Project tool), or "
                "leave those points out with a selection or definition query.")
        low = min(m[1] for m in maps.values())
        high = max(m[2] for m in maps.values())
        extreme = sorted(pt[0] for pt in points
                         if not (THIN_MIN_SCALE <= maps[(float(pt[1]), float(pt[2]))][1]
                                 and maps[(float(pt[1]), float(pt[2]))][2] <= THIN_MAX_SCALE))
        if extreme:
            if is_web_mercator(info.get("wkid")):
                why = ("The input is in a Web Mercator system ({0}), which stretches distances by "
                       "about 1 / cos(latitude) (by 2 at 60 degrees north or south).".format(name))
            elif thin_distorting_system(name, info.get("wkid")):
                label = thin_distorting_system(name, info.get("wkid"))
                why = "The input is in {0} ({1}), which stretches distances {2}.".format(
                    label, name, THIN_DISTORTION_EXAMPLES.get(
                        label, "by a factor that changes across the map"))
            elif info.get("polar_stereographic"):
                why = ("The input is in a polar stereographic system ({0}), whose scale grows "
                       "with the distance from the pole.".format(name))
            else:
                pole = thin_pole_azimuthal_sign(sr)
                if pole:
                    why = ("The input is in a pole-centred azimuthal system ({0}, about the {1} "
                           "Pole), whose scale changes with the distance from the pole.".format(
                               name, "North" if pole > 0 else "South"))
                else:
                    why = ("The coordinate system of the input ({0}) stretches or shrinks "
                           "distances strongly at some of the points.".format(name))
            raise ToolError(
                "{0} At {1} point(s) (OID {2}) it stretches a ground distance by less than {3:g} "
                "or more than {4:g} (at the input points the factor is {5:.3f} to {6:.3f}); the "
                "tool accepts {3:g} to {4:g}.".format(why, len(extreme), analysis_oid_text(extreme),
                                                      THIN_MIN_SCALE, THIN_MAX_SCALE, low, high),
                "Project the points to a system made for their area (Project tool), for example "
                "a conformal or equal-area system centred on the region such as a Lambert "
                "conformal conic, an Albers or the UTM zone, or split the area and thin each "
                "part on its own.")
        collector.info("Distances are measured on the ground (WGS 1984 ellipsoid) at every point: "
                       "at the input points this coordinate system stretches a ground distance by "
                       "a factor of {0:.6f} to {1:.6f}; the spacing and every distance written "
                       "are in ground metres.".format(low, high))
        return dict((pt[0], maps[(float(pt[1]), float(pt[2]))][0]) for pt in points)

    def _field(self, desc, name, label, collector, numeric):
        found, how = match_field(desc["fields"], name, label=label, exact_name_first=True)
        collector.info(match_message(name, found, how))
        if numeric and found["type"] not in _TP_NUMBER_TYPES:
            raise ToolError("The {0} '{1}' is of type {2}; a number field is needed.".format(
                label, found["name"], found["type"]),
                "Choose a Short, Long, Big Integer, Float or Double field.")
        if not numeric and found["type"] in _TP_GROUP_SKIP_TYPES:
            raise ToolError("The {0} '{1}' is of type {2} and cannot group points.".format(
                label, found["name"], found["type"]), "Choose a text or number field.")
        return found

    # -- output -----------------------------------------------------------------------

    def _run(self, parameters, p, collector):
        spacing_m, spacing_text = self._spacing(p, collector)
        order = param_text(p["priority_order"]) or THIN_HIGHEST
        tie_order = param_text(p["tiebreak_order"]) or THIN_HIGHEST
        content = param_text(p["output_content"]) or _TP_CONTENT_KEPT
        for label, value, allowed in (("Keep First", order, THIN_ORDERS),
                                      ("Tie-break Order", tie_order, THIN_ORDERS),
                                      ("Output Content", content, _TP_CONTENTS)):
            if value not in allowed:
                raise ToolError("{0} '{1}' is not valid.".format(label, value),
                                "Choose one of: {0}.".format(", ".join(allowed)))
        out_main = param_text(p["out_features"])
        out_removed = param_text(p["out_removed"])
        out_summary = param_text(p["out_summary"])
        refuse_duplicate_outputs([out_main, out_removed, out_summary])
        desc = describe_dataset(param_text(p["in_points"]))
        if kind_from_shape_type(desc["shape_type"]) != GEOM_POINT:
            raise ToolError("The input must contain points (single points, not multipoints).",
                            "Choose a point layer; use Multipart To Singlepart first for "
                            "multipoints.")
        mpu = self._measuring(desc)
        inputs = [desc["catalog_path"]]
        for out in (out_main, out_removed, out_summary):
            if out:
                check_output_path(out, inputs)
        for out, label in ((out_main, "Output Points"), (out_removed, "Output Removed Points")):
            clash = thin_dataset_system_clash(out, desc["sr_object"]) if out else None
            if clash:
                raise ToolError(
                    "{0} is in a feature dataset whose coordinate system ({1}) is not the "
                    "input's ({2}). The points would be projected to the feature dataset's "
                    "system, so the output would not be in the input's system.".format(
                        label, clash, _tp_system_key(desc["sr_object"])[1] or "unknown"),
                    "Write the output outside the feature dataset, or into a feature dataset "
                    "with the input's coordinate system, or project the input first (Project "
                    "tool).")
        prio = self._field(desc, param_text(p["priority_field"]), "priority field", collector, True)
        tie = None
        if param_text(p["tiebreak_field"]):
            tie = self._field(desc, param_text(p["tiebreak_field"]), "tie-break field", collector,
                              True)
            if tie["name"] == prio["name"]:
                raise ToolError("The tie-break field is the priority field.",
                                "Choose a different field, or leave the tie-break empty.")
        group = None
        if param_text(p["group_field"]):
            group = self._field(desc, param_text(p["group_field"]), "group field", collector,
                                False)
        sr_name = (desc["sr"] or {}).get("name")
        collector.info("Spacing {0} on the ground; input coordinates in {1} (1 unit = {2:g} m).".format(
            spacing_text, sr_name, mpu))

        carry = []
        if param_bool(p["copy_attributes"], True):
            carry, skipped_names = analysis_carry_fields(desc["fields"], _TP_FIELDS)
            if skipped_names:
                collector.info("Input field(s) not copied because the output uses the name: "
                               "{0}.".format(", ".join(skipped_names)))
        read_names = []
        for name in [prio["name"]] + ([tie["name"]] if tie else []) + \
                ([group["name"]] if group else []) + [f["name"] for f in carry]:
            if name not in read_names:
                read_names.append(name)
        rows = read_features(desc["input"], read_names)
        collector.info("{0} point(s) read.".format(len(rows)))
        protected = set()
        where = param_text(p["protected_where"])
        if where:
            try:
                protected = set(r["oid"] for r in read_features(desc["input"], [], where=where,
                                                                geometry=False))
            except ToolError:
                raise
            except Exception as exc:
                raise ToolError("The protected-points query '{0}' could not be applied ({1}).".format(
                    where, str(exc).strip() or type(exc).__name__),
                    "Check the field names and the SQL syntax of the query.")

        points, attrs, no_geometry, bad_coordinates = [], {}, [], []
        for r in rows:
            shape = r["shape"]
            if shape is None:
                no_geometry.append(r["oid"])
                continue
            x, y = shape[0], shape[1]
            if not (math.isfinite(x) and math.isfinite(y)):
                bad_coordinates.append(r["oid"])
                continue
            a = r["attrs"]
            points.append((r["oid"], x, y, a[prio["name"]], a[tie["name"]] if tie else None,
                           r["oid"] in protected, a[group["name"]] if group else None))
            attrs[r["oid"]] = a
        rows = None
        if where:
            # count only the points that are thinned (with geometry and finite coordinates), so
            # this agrees with the "protected point(s) kept" line and the summary N_PROT
            n_match = sum(1 for pt in points if pt[5])
            skipped = len(protected) - n_match
            collector.info("{0} point(s) match the protected-points query{1}.".format(
                n_match, "" if not skipped else
                " ({0} more match it but have no geometry or non-finite coordinates and are "
                "skipped)".format(skipped)))
        if not points:
            collector.warning("There are no points with geometry; nothing was written.")
            raise ToolError("The input has no points with coordinates to thin.",
                            "Check the layer, its selection and definition query.")
        ground = self._ground(desc, mpu, points, collector)
        across = bool(group) and param_bool(p["across_groups"], False)
        progress = Progress("Thinning points", len(points))
        result = thin_points(points, spacing_m, order == THIN_HIGHEST, tie_order == THIN_HIGHEST,
                             progress=progress.tick, across_groups=across, metres_per_unit=mpu,
                             ground=ground)
        progress.close()
        xy = dict((pt[0], (pt[1], pt[2])) for pt in points)
        kept_set, removed, violations = result["kept"], result["removed"], result["violations"]
        rank = result["rank"]

        # schemas ------------------------------------------------------------------------
        all_mode = content == _TP_CONTENT_ALL
        # SRC_OID / REMOVED_BY: the toolkit's one ObjectID field rule (``arcio.oid_field_spec``):
        # LONG while every ObjectID fits 32 bits, BIGINTEGER in a geodatabase, in a folder DOUBLE
        # while every id has at most 12 significant digits and TEXT otherwise.
        oid_specs = {}
        for key, path in (("main", out_main), ("removed", out_removed)):
            if path:
                oid_specs[key], oid_note = oid_field_spec(
                    attrs, is_folder_workspace(workspace_of(path)),
                    label="SRC_OID and REMOVED_BY of {0}".format(path))
                if oid_note:
                    collector.info(oid_note)
        main_oid_spec = oid_specs.get("main", {"type": "LONG"})
        rem_oid_spec = oid_specs.get("removed", {"type": "LONG"})

        def oid_spec(name, base):
            spec = dict(base)
            spec["name"] = name
            return spec

        main_specs = [oid_spec("SRC_OID", main_oid_spec), {"name": "KEPT", "type": "SHORT"},
                      {"name": "IS_PROT", "type": "SHORT"}, {"name": "PRI_RANK", "type": "LONG"},
                      {"name": "PROT_VIOL", "type": "SHORT"}]
        if all_mode:
            main_specs += [oid_spec("REMOVED_BY", main_oid_spec),
                           {"name": "REM_DIST_M", "type": "DOUBLE"}]
        removed_specs = [oid_spec("SRC_OID", rem_oid_spec), oid_spec("REMOVED_BY", rem_oid_spec),
                         {"name": "REM_DIST_M", "type": "DOUBLE"}, {"name": "PRI_RANK", "type": "LONG"}]

        def carried(path, which):
            domains = read_output_domains(path)
            if which == "main":
                members = [o for o in attrs if all_mode or o in kept_set]
            else:
                members = [o for o in attrs if o in removed]
            return analysis_carry_specs(carry, lambda n, m=members: [attrs[o].get(n) for o in m],
                                        domains)

        plans = {}
        for key, path, base in (("main", out_main, main_specs), ("removed", out_removed, removed_specs)):
            if not path:
                continue
            specs = list(base)
            fixed = len(specs)
            specs += carried(path, key)
            specs, renamed = plan_output_fields(path, specs, fixed=fixed)
            for old, new in renamed:
                collector.info("Field {0} is called {1} in the output.".format(old, new))
            plans[key] = specs

        summary_specs = None
        if out_summary:
            group_texts = [thin_group_text(g["key"]) for g in result["groups"]]
            summary_specs = [
                {"name": "ROW_TYPE", "type": "TEXT", "length": 5},
                {"name": "GROUP_VAL", "type": "TEXT", "values": [t for t in group_texts if t]},
                {"name": "GROUP_NULL", "type": "SHORT"},
                {"name": "N_IN", "type": "LONG"}, {"name": "N_KEPT", "type": "LONG"},
                {"name": "N_REMOVED", "type": "LONG"}, {"name": "N_PROT", "type": "LONG"},
                {"name": "N_PROT_VIO", "type": "LONG"}, {"name": "VIOL_PAIRS", "type": "LONG"},
                {"name": "N_NULL_PRI", "type": "LONG"}, {"name": "MIN_SP_M", "type": "DOUBLE"},
                {"name": "MIN_SP_NP", "type": "DOUBLE"}, {"name": "MEAN_SP_M", "type": "DOUBLE"},
                {"name": "SPACING_M", "type": "DOUBLE"},
                {"name": "CRS_NAME", "type": "TEXT", "values": [sr_name or ""]}]
            summary_specs, _renamed = plan_output_fields(out_summary, summary_specs,
                                                         fixed=len(summary_specs))

        wkid = desc["sr"]["wkid"] if desc["sr"] else None
        extra_main = [f["name"] for f in carry]
        created, null_fields, counts = [], {"main": set(), "removed": set(), "summary": set()}, {}
        paths, fmaps = {}, {}
        try:
            if "main" in plans:
                paths["main"], fmaps["main"] = create_feature_class(out_main, GEOM_POINT,
                                                                    desc["sr_object"],
                                                                    plans["main"], inputs=inputs)
                created.append(paths["main"])
                oids = sorted(o for o in attrs if all_mode or o in kept_set)

                def main_rows():
                    for o in oids:
                        is_kept = o in kept_set
                        vals = [oid_field_value(main_oid_spec, o), 1 if is_kept else 0,
                                1 if o in protected else 0, rank[o], 1 if o in violations else 0]
                        if all_mode:
                            by = removed.get(o)
                            vals += [oid_field_value(main_oid_spec, by[0]) if by else None,
                                     by[1] if by else None]
                        yield (xy[o], vals + [attrs[o].get(n) for n in extra_main])
                counts["main"] = insert_rows(paths["main"],
                                             [fmaps["main"][s["name"]] for s in plans["main"]],
                                             main_rows(), kind=GEOM_POINT, wkid=wkid,
                                             null_fields=null_fields["main"])
            if "removed" in plans:
                paths["removed"], fmaps["removed"] = create_feature_class(
                    out_removed, GEOM_POINT, desc["sr_object"], plans["removed"], inputs=inputs)
                created.append(paths["removed"])

                def removed_rows():
                    for o in sorted(removed):
                        by, dist = removed[o]
                        yield (xy[o], [oid_field_value(rem_oid_spec, o),
                                       oid_field_value(rem_oid_spec, by), dist, rank[o]]
                               + [attrs[o].get(n) for n in extra_main])
                counts["removed"] = insert_rows(paths["removed"],
                                                [fmaps["removed"][s["name"]] for s in plans["removed"]],
                                                removed_rows(), kind=GEOM_POINT, wkid=wkid,
                                                null_fields=null_fields["removed"])
            if summary_specs:
                paths["summary"], fmaps["summary"] = create_table(out_summary, summary_specs,
                                                                  inputs=inputs)
                created.append(paths["summary"])
                srows = []
                entries = [("GROUP", g) for g in result["groups"]] if group else []
                entries.append(("TOTAL", thin_total_row(result["groups"], result["overall"])))
                def metres(v):  # the core's distances are ground metres already
                    return v
                for kind, g in entries:
                    srows.append([kind, thin_group_text(g["key"]) if kind == "GROUP" else None,
                                  1 if kind == "GROUP" and g["key"] is None else 0,
                                  g["n_in"], g["n_kept"], g["n_removed"], g["n_protected"],
                                  g["n_violating"], g["violation_pairs"], g["null_priority"],
                                  metres(g["min_spacing"]), metres(g["min_spacing_free"]),
                                  metres(g["mean_spacing"]), spacing_m, sr_name])
                counts["summary"] = insert_rows(paths["summary"],
                                                [fmaps["summary"][s["name"]] for s in summary_specs],
                                                srows, null_fields=null_fields["summary"])
        except Exception:
            for done in created:  # never leave part of the outputs behind
                try:
                    safe_delete(done, inputs)
                except Exception:
                    pass
            raise

        # messages ---------------------------------------------------------------------
        total = thin_total_row(result["groups"], result["overall"])
        n_kept, n_removed = len(kept_set), len(removed)
        collector.info("{0} point(s) kept, {1} removed (of {2}) at a spacing of {3}.".format(
            n_kept, n_removed, len(points), spacing_text))
        collector.info("Greedy selection: the result is maximal (no removed point can be added "
                       "back) but not necessarily the largest possible set.")
        for key in ("main", "removed", "summary"):
            if key in paths:
                collector.info("{0} row(s) written to {1}.".format(counts[key], paths[key]))
        if total["min_spacing_free"] is not None:
            scope = ""
            if group and not across and len(result["groups"]) > 1:
                scope = (" (across all groups; the spacing is guaranteed within each group only, "
                         "points of different groups may be closer)")
            collector.info("Smallest distance between kept points that involves an unprotected "
                           "point{3}: {0:.6g} m (the spacing is {1:.6g} m); mean nearest-neighbour "
                           "distance of the kept points: {2:.6g} m.".format(
                               total["min_spacing_free"], spacing_m,
                               total["mean_spacing"] or 0, scope))
            if group and not across and len(result["groups"]) > 1:
                within = [g["min_spacing_free"] for g in result["groups"]
                          if g["min_spacing_free"] is not None]
                if within:
                    collector.info("Smallest such distance within a group: {0:.6g} m.".format(
                        min(within)))
        if protected:
            collector.info("{0} protected point(s) kept; they were ranked first.".format(
                total["n_protected"]))
        if violations:
            collector.warning(
                "{0} protected point(s) are closer than the spacing to another protected "
                "point ({1} pair(s)); all of them were kept: OID {2}.".format(
                    len(violations), total["violation_pairs"],
                    analysis_oid_text(sorted(violations))))
        if total["null_priority"]:
            collector.warning("{0} point(s) have a null or NaN priority and were ranked after "
                              "every point with a value.".format(total["null_priority"]))
        if no_geometry:
            collector.warning("{0} point(s) have no geometry and were skipped: OID {1}.".format(
                len(no_geometry), analysis_oid_text(no_geometry)))
        if bad_coordinates:
            collector.warning("{0} point(s) have non-finite coordinates and were skipped: "
                              "OID {1}.".format(len(bad_coordinates),
                                                analysis_oid_text(bad_coordinates)))
        if (group and not across and n_removed == 0 and len(result["groups"]) > 1
                and total["min_spacing_free"] is not None
                and total["min_spacing_free"] < spacing_m * (1.0 - 1e-9)):
            collector.warning(
                "No point was removed although kept points of different groups are closer "
                "than the spacing ({0:.6g} m against {1:.6g} m): the Group Field kept them "
                "apart ({2} group(s), largest {3} point(s)). Check the Group Field (a nearly "
                "unique field leaves nothing to thin), or check Apply Spacing Across "
                "Groups.".format(total["min_spacing_free"], spacing_m,
                                 len(result["groups"]),
                                 max(g["n_in"] for g in result["groups"])))
        if group:
            collector.info("{0} group(s) {1}.".format(
                len(result["groups"]), "thinned together: the spacing applies across groups"
                if across else "thinned separately: the spacing applies within each group only"))
        for key, label in (("main", "Output Points"), ("removed", "Output Removed Points"),
                           ("summary", "Output Summary Table")):
            if key in paths:
                specs_k = plans.get(key) or summary_specs
                note = folder_null_number_warning(paths[key], specs_k, fmaps[key],
                                                  null_fields[key],
                                                  thin_null_note(specs_k, fmaps[key],
                                                               null_fields[key]))
                if note:
                    collector.warning(note)
                lost = lost_domain_warning(plans.get(key) or [], paths[key])
                if lost:
                    collector.warning(lost)
        set_derived_output(parameters, "kept_count", str(n_kept))
        set_derived_output(parameters, "removed_count", str(n_removed))
        flush_messages(collector)


# ==========================================================================
# analysis/boundary_tool.py
# ==========================================================================
# Boundary Description (Metes and Bounds): the ArcGIS Pro tool (adapter).

_BDW_REPORT_EXTENSIONS = (".txt", ".html", ".htm")
_BDW_BIG_INPUT = 200000          # vertices: an information line about the self-intersection test
_BDW_BIG_POLYGON = 20000         # vertices: the progressor names the polygon being described
_BDW_SHORT_NAMES = {"out_courses": "Course Table", "out_vertices": "Vertex Schedule",
                    "out_closure": "Closure Report", "out_narrative": "Narrative Table",
                    "out_lines": "Labelled Lines"}
_BDW_FOLDER_NARRATIVE = (
    "A narrative table in a folder is a dBASE table, whose text field holds at most 254 BYTES "
    "(an Arabic letter takes 2). Almost every narrative is longer (with the standard basis "
    "sentence, every one; even a triangle at UTM coordinates with Basis NONE), so the run will "
    "most likely be refused before anything is written. Write the narrative table to a "
    "geodatabase, or use the Output Narrative File (.txt or .html).")


def _bdw_param_options(p, meters_per_unit, crs_name=""):
    """Options of the run from the parameters (``ValueError`` text for a wrong value)."""
    angle = p["angle_decimals"].value
    return bdw_options(
        meters_per_unit=meters_per_unit,
        start_rule=param_text(p["start_vertex"]), orientation=param_text(p["orientation"]),
        bearing_format=param_text(p["bearing_format"]),
        angle_decimals=None if angle in (None, "") else int(angle),
        unit=param_text(p["distance_unit"]),
        dist_decimals=2 if p["distance_decimals"].value in (None, "")
        else int(p["distance_decimals"].value),
        merge_collinear=param_bool(p["merge_collinear"], False),
        collinear_tolerance=param_number(p["collinear_tolerance"], 0.001),
        digits=param_text(p["arabic_digits"]), crs_name=crs_name,
        basis_position=param_text(p["basis_position"]), basis_text=param_text(p["basis_text"]),
        check_crossings=param_bool(p["check_crossings"], True))


def _bdw_languages(p):
    language = (param_text(p["language"]) or "BOTH").upper()
    if language not in BDW_LANGUAGES:
        raise ToolError("Unknown language '{0}'.".format(language),
                        "Choose one of: {0}.".format(", ".join(BDW_LANGUAGES)))
    return ["ENGLISH", "ARABIC"] if language == "BOTH" else [language]


class BoundaryDescriptionWriter(object):
    """Course table, vertex schedule, closure report and bilingual narrative per polygon."""

    DOC = {
        "summary": "Writes a boundary description for every polygon (parcel, concession, "
                   "zone, licence block): a course table, a vertex schedule, a closure report "
                   "and an English and Arabic narrative. Each ring is first "
                   "put in a standard form (start vertex, orientation). The closure report "
                   "recomputes the traverse from the ROUNDED published bearings and distances "
                   "and shows the error that rounding causes; it is never adjusted away. An "
                   "optional line layer carries bearing and distance labels for the map. A "
                   "drafting aid, not a legal survey instrument.",
        "usage": "Licence: no Advanced-only tool is called; working on a Basic licence is "
                 "NOT VERIFIED.\n\n"
                 "Input: polygons in a PROJECTED coordinate system. Geographic (degree) input "
                 "and Web Mercator are refused with \"Project first\": bearings and distances "
                 "are computed on the plane of the coordinates, in the coordinate system's own "
                 "units. A selection or definition query on a layer is honoured. The input is "
                 "never edited.\n\n"
                 "Bearings are GRID bearings: azimuth = atan2(dx, dy) clockwise from grid north "
                 "(the +Y axis), not true, geodetic or magnetic north. The angle between "
                 "grid north and true north at the centre of the data is reported in the "
                 "messages but not applied to the bearings (it needs a coordinate system with "
                 "a WKID; without one nothing is said). Distances are planar distances between the vertices, "
                 "converted to the chosen unit; no scale factor, elevation or ellipsoid "
                 "reduction is applied.\n\n"
                 "Start vertex: NORTHWEST = northernmost, then westernmost (the default); "
                 "NORTHEAST, SOUTHWEST and SOUTHEAST likewise; FIRST_VERTEX keeps the first "
                 "stored vertex. Values closer than 0.000001 map units count as equal; the "
                 "first such vertex wins. Orientation: by default each outer ring runs "
                 "clockwise and each hole counter-clockwise (the Esri "
                 "convention for polygons). Rings are numbered over the whole feature (RING_NO 1, 2, ...: "
                 "outer ring of part 1, its holes, outer ring of part 2, ...), points are "
                 "numbered on over the rings of one feature, and every ring closes on its own "
                 "first point.\n\n"
                 "Bearing format: QUADRANT_DMS (N 45°30'15\" E; a bearing published as "
                 "exactly due north, east, south or west is written North, East, South, "
                 "West), AZIMUTH_DMS or AZIMUTH_DECIMAL. Angle decimals: decimals of the "
                 "second (DMS formats, default 0) or of the degree (AZIMUTH_DECIMAL, default "
                 "4). Angles and distances are rounded half up, and a carry (59.9999 seconds "
                 "becomes the next minute) is handled.\n\n"
                 "Closure: the Closure Report recomputes each ring from the published, "
                 "rounded bearings and distances (not from the coordinates) and reports the "
                 "misclosure, the precision ratio 1:N (perimeter / misclosure, rounded down) "
                 "and ROUND_BND, the largest misclosure that rounding alone can cause. "
                 "Rounding can break closure; that is shown, not hidden. A closure adjustment "
                 "(compass rule or any other) is OUT of scope and is never applied.\n\n"
                 "Curves: true curve segments are written as straight chords and flagged "
                 "ARC_APPROX = 1 (and counted in a warning; ARC_SEGS in the Closure Report "
                 "flags the ring and its area and perimeter are those of the chord polygon). "
                 "No arc elements (radius, arc length, chord, delta) are written. A ring made "
                 "ONLY of curve segments (a circle, a two-arc shape) cannot be written as "
                 "straight courses and is skipped with a message of its own: densify it first. "
                 "When such a ring (or a semicircle) is a HOLE, the outer ring's description "
                 "includes its area as land: a warning and a note in the narrative say so, with "
                 "the area; a part with area that cannot be written gets the same note. "
                 "A curve that was already densified into many short segments cannot be "
                 "recognised and appears as many short courses. Which outer ring a hole "
                 "belongs to, and whether rings cross, is decided on the TRUE curves (sampled), "
                 "so a hole in the bulge of an arc stays a hole of its parcel; a warning names "
                 "a hole that the chord courses do not enclose. A hole whose outer ring is "
                 "skipped (for example inside a circle) is not described, with a warning, and "
                 "a counter-clockwise ring that lies in no outer ring is described as an outer "
                 "ring with a warning.\n\n"
                 "Optional collinear merge: a vertex is dropped when its segments are straight "
                 "and it lies within the tolerance of the line between its neighbours (and "
                 "between them); every vertex dropped is kept within the tolerance of the "
                 "course that finally replaces it (all the vertices it replaces are re-tested), "
                 "and the message gives the largest offset; a tolerance of 0 merges only "
                 "vertices exactly on the line; a warning names polygons whose "
                 "ring area changes by more than 1% (tolerance too large). The test uses the convex hull "
                 "of the replaced vertices, so a long densified straight side is merged in "
                 "about linear time. The start vertex is chosen "
                 "afterwards, and a near-collinear topmost vertex is merged like any other. "
                 "Repeated vertices are "
                 "always dropped. Z and M values are ignored. A ring with fewer than three "
                 "distinct vertices or no area is skipped with a warning. A polygon whose "
                 "boundary crosses itself (for example a bow-tie) is described as stored, "
                 "with a warning that names it; so is a spike (the boundary runs out and "
                 "straight back). Parts are numbered over the parts that are described.\n\n"
                 "Narrative: English and/or Arabic. The narrative is only written when you tick "
                 "Output Narrative Table or Output Narrative File (one row per parcel and "
                 "language in the table, and in the .txt or .html file). Every narrative ends "
                 "(or starts, see Basis of Bearings Statement) with a basis-of-bearings "
                 "sentence naming the coordinate system, saying the bearings are grid "
                 "bearings, the distances planar, and the text a draft; coordinates are "
                 "labelled with their unit. Arabic numbers are "
                 "isolated left to right so that bearings read correctly inside right-to-left "
                 "text; Arabic-Indic digits are optional. The Arabic wording has not been "
                 "reviewed by a legal translator. A dBASE text field holds at most 254 bytes "
                 "(an Arabic letter takes 2), so a narrative table in a folder essentially "
                 "never fits (with the basis sentence, never; validation warns): use a "
                 "geodatabase for the narrative table, or the narrative file.\n\n"
                 "Parcel keys used by more than one polygon are warned (the rows are told "
                 "apart by SRC_OID only). The run also compares grid north (+Y) with true "
                 "north at the centre of the data and gives the angle; when they differ by "
                 "more than 45 degrees (for example a south-orientated system, where +Y "
                 "points south) it warns that the bearings do not refer to north. This "
                 "check needs a coordinate system with a WKID: a custom system without one "
                 "(even a south-orientated one) gets no angle and no warning.\n\n"
                 "Limits: a drafting aid, not a legal survey instrument; liability for the "
                 "text stays with whoever signs it. Polygons are read as stored and not "
                 "repaired (self-intersections, an outer ring stored counter-clockwise).\n\n"
                 "Self-intersection test: each polygon is swept once (Shamos-Hoey plane "
                 "sweep, O(n log n)), so a 50,000-vertex ring takes a fraction of a second "
                 "(measured in Python). All rings of one polygon are tested "
                 "together. A crossing is two segments crossing each other, a vertex lying "
                 "on another segment with the boundary passing through it (as snapping "
                 "produces), or a shared point the boundary passes through (a figure-8). "
                 "Touching without passing through, shared end points and overlaps are not "
                 "crossings. A polygon that touches itself is re-tested pair by pair (up to "
                 "2,000,000 tests); only a very large touching polygon can have a crossing "
                 "missed, and a boundary that runs along another edge before crossing it is "
                 "not reported. Crossings between different polygons are not tested. Check "
                 "Self-Intersection can be unticked to skip it.",
        "params": {
            "in_polygons": "Polygon features (projected coordinate system).",
            "key_field": "Field that names each parcel in the outputs. Default: the ObjectID. A "
                         "whole-number value of a decimal field (12.0) is written as 12.",
            "out_courses": "Output course table: one row per course (parcel key, part, ring, "
                           "course, from and to point, exact and published bearing and "
                           "distance, from and to X/Y, line type, ARC_APPROX).",
            "out_vertices": "Optional vertex schedule: one row per vertex with point number "
                            "and X/Y (and latitude/longitude when requested).",
            "out_closure": "Optional closure report: one row per ring, from the ROUNDED courses.",
            "out_narrative": "Optional narrative table: one row per parcel and language.",
            "out_report": "Optional report file: .txt (plain text) or .html (simple HTML) "
                          "with the narratives, course tables and closure of every parcel.",
            "out_lines": "Optional line feature class: one line per course with BEARING, "
                         "DIST_TXT and LABEL_TXT for labelling the map.",
            "start_vertex": "Point 1 of every ring. NORTHWEST (default) = the northernmost vertex "
                            "(largest Y), and of equal Y the westernmost: on a tilted parcel "
                            "it can be the north-EAST corner. NORTHEAST, SOUTHWEST and "
                            "SOUTHEAST work the same way (north/south first, then east/west). "
                            "FIRST_VERTEX keeps the stored first vertex.",
            "orientation": "OUTER_CW_HOLES_CCW (default), ALL_CLOCKWISE or ALL_COUNTERCLOCKWISE.",
            "bearing_format": "QUADRANT_DMS (default), AZIMUTH_DMS or AZIMUTH_DECIMAL.",
            "angle_decimals": "Decimals of the second (DMS formats) or of the degree "
                              "(AZIMUTH_DECIMAL). Empty: 0 for DMS, 4 for decimal degrees.",
            "distance_unit": "METERS (default), FEET (international foot, 0.3048 m) or "
                             "US_SURVEY_FEET (1200/3937 m).",
            "distance_decimals": "Decimals of the published distances (default 2).",
            "merge_collinear": "Drop vertices that lie on the straight line between their "
                               "neighbours (default off). Every dropped vertex stays within "
                               "the tolerance of the course that replaces it.",
            "collinear_tolerance": "Distance (in the chosen unit) within which a vertex counts "
                                   "as collinear (default 0.001). 0 merges only vertices "
                                   "that lie exactly on the line.",
            "add_latlon": "Add longitude and latitude (decimal degrees and DMS, on the "
                          "geographic system of the input) to the vertex schedule.",
            "language": "BOTH (default), ENGLISH or ARABIC narrative.",
            "arabic_digits": "WESTERN (default) or ARABIC_INDIC digits in the Arabic narrative.",
            "basis_position": "Where the basis-of-bearings sentence goes in every narrative: "
                              "CLOSING (default, after the last paragraph), OPENING (before "
                              "the first) or NONE.",
            "basis_text": "Optional. Your own wording for the basis statement, used instead of "
                          "the standard English and Arabic sentences (the same text in both "
                          "languages). Empty: the standard sentence, which names the "
                          "coordinate system, says the bearings are grid bearings and the "
                          "distances planar, and that the text is a draft.",
            "check_crossings": "Test every polygon for boundary segments that cross each other "
                               "(default on; a plane-sweep test that takes a fraction of a second "
                               "for a 50,000-vertex ring). Untick to skip the test for very "
                               "large inputs; no self-intersection warning is then given.",
            "course_count": "Number of courses written (derived).",
        },
        "tags": ["boundary description", "metes and bounds", "bearing", "distance", "closure",
                 "arabic"],
    }

    def __init__(self):
        self.label = "Boundary Description (Metes and Bounds)"
        self.description = ("Course table, vertex schedule, closure report and English / Arabic "
                            "narrative for polygon boundaries; no Advanced-only tool is "
                            "called, a Basic licence is not verified (v" + __version__ + ").")
        self.canRunInBackground = False

    def getParameterInfo(self):
        return [
            make_param("in_polygons", "Input Polygons", "GPFeatureLayer",
                       value_list=["Polygon"]),
            make_param("key_field", "Parcel Key Field", "Field", required=False,
                       depends_on="in_polygons"),
            make_param("out_courses", "Output Course Table", "DETable", direction="Output"),
            make_param("out_vertices", "Output Vertex Schedule", "DETable", direction="Output",
                       required=False),
            make_param("out_closure", "Output Closure Report", "DETable", direction="Output",
                       required=False),
            make_param("out_narrative", "Output Narrative Table", "DETable",
                       direction="Output", required=False),
            make_param("out_report", "Output Narrative File (.txt or .html)", "DEFile",
                       direction="Output", required=False, value_list=["txt", "html"]),
            make_param("out_lines", "Output Labelled Lines", "DEFeatureClass",
                       direction="Output", required=False),
            make_param("start_vertex", "Start Vertex", "GPString", required=False,
                       value_list=list(BDW_START_RULES), default="NORTHWEST"),
            make_param("orientation", "Ring Orientation", "GPString", required=False,
                       value_list=list(BDW_ORIENTATIONS), default="OUTER_CW_HOLES_CCW"),
            make_param("bearing_format", "Bearing Format", "GPString", required=False,
                       value_list=list(BDW_BEARING_FORMATS), default="QUADRANT_DMS"),
            make_param("angle_decimals", "Angle Decimals", "GPLong", required=False),
            make_param("distance_unit", "Distance Unit", "GPString", required=False,
                       value_list=list(BDW_UNITS), default="METERS"),
            make_param("distance_decimals", "Distance Decimals", "GPLong", required=False,
                       default=2),
            make_param("merge_collinear", "Merge Collinear Vertices", "GPBoolean",
                       required=False, default=False),
            make_param("collinear_tolerance", "Collinear Tolerance", "GPDouble",
                       required=False, default=0.001),
            make_param("add_latlon", "Add Latitude and Longitude", "GPBoolean", required=False,
                       default=False),
            make_param("language", "Narrative Language", "GPString", required=False,
                       value_list=list(BDW_LANGUAGES), default="BOTH"),
            make_param("arabic_digits", "Arabic Narrative Digits", "GPString", required=False,
                       value_list=list(BDW_DIGIT_STYLES), default="WESTERN"),
            make_param("basis_position", "Basis of Bearings Statement", "GPString",
                       required=False, value_list=list(BDW_BASIS_POSITIONS), default="CLOSING"),
            make_param("basis_text", "Own Basis Statement Text", "GPString", required=False),
            make_param("check_crossings", "Check Self-Intersection", "GPBoolean",
                       required=False, default=True),
            derived_output("course_count", "Course Count", "GPLong"),
        ]

    def isLicensed(self):
        return True

    @folder_output_extensions
    def updateParameters(self, parameters):
        return

    @protected_outputs()
    def updateMessages(self, parameters):
        p = param_map(parameters)
        for name, low, high in (("angle_decimals", 0, 6), ("distance_decimals", 0, 6)):
            value = p[name].value
            if value is not None and value != "" and not low <= int(value) <= high:
                p[name].setErrorMessage("Use a whole number from {0} to {1}.".format(low, high))
        tol = p["collinear_tolerance"].value
        if tol is not None and tol != "" and float(tol) < 0:
            p["collinear_tolerance"].setErrorMessage("The tolerance must be zero or more.")
        report = param_text(p["out_report"])
        if report and not report.casefold().endswith(_BDW_REPORT_EXTENSIONS):
            p["out_report"].setErrorMessage("The narrative file must end in .txt or .html.")
        outputs = [param_text(p[n]) for n in ("out_courses", "out_vertices", "out_closure",
                                              "out_narrative", "out_lines")]
        pair = find_duplicate_outputs(outputs)
        if pair:
            p["out_courses"].setErrorMessage("Two outputs are the same dataset: '{0}' and "
                                             "'{1}'.".format(pair[0], pair[1]))
        narrative = param_text(p["out_narrative"])
        if (narrative and not p["out_narrative"].hasError()
                and is_folder_workspace(workspace_of(narrative))):
            p["out_narrative"].setWarningMessage(_BDW_FOLDER_NARRATIVE)
        return

    @guarded_run
    def execute(self, parameters, messages):
        p = param_map(parameters)
        collector = MessageCollector()
        try:
            self._run(parameters, p, collector)
        except ToolError as err:
            flush_messages(collector)
            arcpy.AddError(str(err))
        except Exception:
            # An arcpy error while writing: the outputs this run created were deleted
            # (_run); show what was collected first.
            flush_messages(collector)
            raise

    # -- reading ---------------------------------------------------------------------

    def _read(self, path, key_name, collector):
        """``[(oid, key text, rings or None)]`` plus problem lists, in ObjectID order."""
        register_inputs([path])
        tokens = ["OID@", "SHAPE@JSON"] + ([key_name] if key_name else [])
        features, nulls, unreadable = [], [], []
        arcs_in_input = 0
        with arcpy.da.SearchCursor(path, tokens) as cursor:
            for values in cursor:
                oid = values[0]
                raw = values[2] if key_name else None
                key = bdw_key_text(raw)
                if not key:
                    key = "OID {0}".format(oid)
                rings = None
                if values[1]:
                    try:
                        rings, count = bdw_parse_esri_polygon(json.loads(values[1]))
                        arcs_in_input += count
                    except (ValueError, TypeError, KeyError, IndexError) as exc:
                        unreadable.append((oid, str(exc)))
                        continue
                if not rings:
                    nulls.append(oid)
                    continue
                features.append((oid, key, rings))
        features.sort(key=lambda f: f[0])
        return features, nulls, unreadable

    def _latlon(self, parcel, sr_object, wkid):
        """``{point_no: (lon, lat)}`` of the vertices of a parcel on the geographic system of
        the input (Geometry.projectAs)."""
        points, numbers = [], []
        for ring in parcel["rings"]:
            for number, (x, y) in zip(ring["point_nos"], ring["vertices"]):
                points.append([x, y])
                numbers.append(number)
        if not points:
            return {}
        shape = arcpy.AsShape({"points": points, "spatialReference": {"wkid": int(wkid)}}, True)
        data = json.loads(shape.projectAs(sr_object.GCS).JSON)["points"]
        return dict((n, (float(c[0]), float(c[1]))) for n, c in zip(numbers, data))

    def _grid_north(self, features, desc, collector):
        """Compare grid north (+Y) with true north at the centre of the data: the vertex box
        centre is projected to the geographic system of the input and a point
        ``BDW_NORTH_STEP`` degrees north of it back (Geometry.projectAs). An information line
        gives the angle; more than ``BDW_NORTH_WARN`` degrees (a south-orientated system, a
        polar projection far from its central meridian) is warned. Returns the angle or None
        (no WKID, or the projection fails: nothing is said)."""
        sr = desc.get("sr_object")
        wkid = (desc.get("sr") or {}).get("wkid")
        xs = [x for _o, _k, rings in features for r in rings for x, _y in r["pts"]]
        ys = [y for _o, _k, rings in features for r in rings for _x, y in r["pts"]]
        if sr is None or not wkid or not xs:
            return None
        centre = ((min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0)
        try:
            gcs = sr.GCS
            gcs_wkid = gcs.factoryCode
            if not gcs_wkid:
                return None
            here = json.loads(arcpy.AsShape({"x": centre[0], "y": centre[1],
                                             "spatialReference": {"wkid": int(wkid)}},
                                            True).projectAs(gcs).JSON)
            lon, lat = float(here["x"]), float(here["y"])
            northward = lat + BDW_NORTH_STEP <= 90.0
            lat2 = lat + BDW_NORTH_STEP if northward else lat - BDW_NORTH_STEP
            there = json.loads(arcpy.AsShape({"x": lon, "y": lat2,
                                              "spatialReference": {"wkid": int(gcs_wkid)}},
                                             True).projectAs(sr).JSON)
            angle = bdw_true_north_offset(centre, (there["x"], there["y"]), northward)
        except Exception:                     # outside the domain of the system: say nothing
            return None
        if angle is None:
            return None
        collector.info(bdw_true_north_line(angle))
        if abs(angle) > BDW_NORTH_WARN:
            collector.warning(
                "The +Y axis of '{0}' points {1:.1f} degrees away from true north at the centre of "
                "the data{2}. Every bearing is measured from the +Y axis, so the bearings, the "
                "quadrant letters (N, S, E, W) and the words North, East, South, West of the "
                "description do NOT refer to true north here. Project the polygons to a system "
                "whose +Y axis points north (for example their UTM zone) for bearings that read "
                "from north.".format(
                    (desc.get("sr") or {}).get("name"), abs(angle),
                    " (it points about south: a south-orientated system)"
                    if abs(angle) > 135.0 else ""))
        return angle

    def _duplicate_keys(self, usable, key_name, collector):
        dups = bdw_duplicate_keys([(pc["oid"], pc["key"]) for pc in usable])
        if not dups:
            return
        shown = "; ".join("'{0}' (OID {1})".format(bdw_display_key(key), analysis_oid_text(oids))
                          for key, oids in dups[:5])
        collector.warning(
            "{0} value(s) of the Parcel Key Field '{1}' are used by more than one polygon: {2}{3}. "
            "Their rows carry the same PARCEL_KEY in every output and are told apart only by "
            "SRC_OID (the narrative file heads them with the same name). Check the key field, or use "
            "a field whose values are unique.".format(
                len(dups), key_name, shown, "; ..." if len(dups) > 5 else ""))

    def _bidi_keys(self, usable, key_name, collector):
        oids = [pc["oid"] for pc in usable if bdw_key_has_bidi_controls(pc["key"])]
        if not oids:
            return
        collector.warning(
            "{0} value(s) of the Parcel Key Field '{1}' contain invisible text-direction controls "
            "(U+202A-U+202E or U+2066-U+2069, which can show the text that follows reversed or "
            "reordered): OID {2}. The narrative file and these messages show each one as visible "
            "text such as <U+202E>; the output tables keep the key exactly as read. Remove the "
            "controls from the key field (Calculate Field) if they are not intended.".format(
                len(oids), key_name, analysis_oid_text(oids)))

    # -- the run ---------------------------------------------------------------------

    def _crs_checks(self, desc):
        info = desc["sr"]
        if info is None or info.get("type") not in ("Projected", "Geographic"):
            raise ToolError("The input has no usable coordinate system.",
                            "Define the coordinate system (Define Projection) or project the "
                            "polygons to a projected coordinate system, then run the tool again.")
        if info["type"] == "Geographic":
            raise ToolError(
                "The input is in a geographic coordinate system ({0}, degrees): bearings and "
                "distances cannot be computed on a plane of degrees. Project first.".format(
                    info.get("name")),
                "Project the polygons to a projected coordinate system suited to the area "
                "(for example its UTM zone) with the Project tool, then run this tool on the "
                "result.")
        if info.get("wkid") and is_web_mercator(info["wkid"]):
            raise ToolError(
                "The input is in Web Mercator ({0}), which distorts distances and bearings "
                "away from the equator. Project first.".format(info.get("name")),
                "Project the polygons to a projected coordinate system suited to the area "
                "(for example its UTM zone) with the Project tool, then run this tool on the "
                "result.")
        mpu = info.get("meters_per_unit")
        if not mpu or not mpu > 0:
            raise ToolError("The length unit of the coordinate system '{0}' is not known."
                            .format(info.get("name")),
                            "Project the polygons to a projected coordinate system with a "
                            "metre or foot unit, then run the tool again.")
        return float(mpu)

    def _report_target(self, p, collector):
        text = param_text(p["out_report"])
        if not text:
            return None
        if not text.casefold().endswith(_BDW_REPORT_EXTENSIONS):
            raise ToolError("The narrative file '{0}' must end in .txt or .html.".format(text),
                            "Choose a file name such as boundaries.html or boundaries.txt.")
        refuse_report_on_inputs([text], input_texts(p))
        _report_check_writable(text)
        refuse_existing_report_files([text], overwrite_output())
        return text

    def _run(self, parameters, p, collector):
        report_path = self._report_target(p, collector)        # before the main work
        languages = _bdw_languages(p)
        desc = describe_dataset(param_text(p["in_polygons"]))
        if kind_from_shape_type(desc["shape_type"]) != GEOM_POLYGON:
            raise ToolError("The input must contain polygons.", "Choose a polygon layer.")
        mpu = self._crs_checks(desc)
        try:
            options = _bdw_param_options(p, mpu, desc["sr"].get("name") or "")
        except ValueError as exc:
            raise ToolError("{0}.".format(exc), "Correct the parameter and run the tool again.")
        info = desc["sr"]
        wkid = info.get("wkid")
        want_latlon = param_bool(p["add_latlon"], False)
        if want_latlon and not wkid:
            raise ToolError("Latitude and longitude need a coordinate system with a WKID, and "
                            "'{0}' has none.".format(info.get("name")),
                            "Turn Add Latitude and Longitude off, or project the polygons to a "
                            "system that has a WKID.")
        key_name = None
        if param_text(p["key_field"]):
            field, how = match_field(desc["fields"], param_text(p["key_field"]),
                                     label="parcel key field", exact_name_first=True)
            key_name = field["name"]
            collector.info(match_message(param_text(p["key_field"]), field, how))
        inputs = [desc["catalog_path"]]
        outputs = [(n, param_text(p[n])) for n in ("out_courses", "out_vertices", "out_closure",
                                                   "out_narrative", "out_lines")
                   if param_text(p[n])]
        refuse_duplicate_outputs([o for _n, o in outputs])
        for _name, out in outputs:
            check_output_path(out, inputs)                     # all outputs before the work
        unit = BDW_UNITS[options["unit"]]
        collector.info("Coordinate system: {0} (WKID {1}); one map unit = {2:.10g} m. "
                       "Bearings are grid bearings (azimuth from grid north of this "
                       "coordinate system); distances are planar, in {3}; no scale factor is "
                       "applied.".format(info.get("name"), wkid, mpu, unit[2]))

        features, nulls, unreadable = self._read(desc["input"], key_name, collector)
        self._grid_north(features, desc, collector)
        progress = Progress("Describing boundaries", len(features))
        total_vertices = sum(len(r["pts"]) for _o, _k, rings in features for r in rings)
        if not options["check_crossings"]:
            collector.info("Self-intersection check switched off (Check Self-Intersection is "
                           "unticked): no warning is given for a polygon whose boundary crosses "
                           "itself.")
        elif total_vertices > _BDW_BIG_INPUT:
            collector.info("{0} vertices to describe and check for self-intersection; the check "
                           "is a plane sweep and usually takes seconds. It can be switched off "
                           "with Check Self-Intersection.".format(total_vertices))
        parcels = []
        for oid, key, rings in features:
            progress.tick()
            vertices = sum(len(r["pts"]) for r in rings)
            if vertices > _BDW_BIG_POLYGON:
                progress.label("Describing OID {0} ({1} vertices)".format(oid, vertices))
            parcels.append(bdw_describe_polygon(oid, key, rings, options))
            if vertices > _BDW_BIG_POLYGON:
                progress.label("Describing boundaries")
        progress.close()
        usable = [pc for pc in parcels if pc["rings"]]
        read_total = len(features) + len(nulls) + len(unreadable)
        if read_total and not usable:
            self._summary(collector, features, parcels, nulls, unreadable, options, [])
            flush_messages(collector)
            raise ToolError(
                "None of the {0} feature(s) could be described: every one has no geometry, "
                "could not be read, or has no ring that can be written as straight "
                "courses.".format(read_total),
                "Read the warnings above. Curve-only rings (circles) and rings without "
                "area cannot be described; densify curves or repair the geometry and run "
                "the tool again.")
        latlon = {}
        if want_latlon:
            for pc in usable:
                latlon[pc["oid"]] = self._latlon(pc, desc["sr_object"], wkid)

        course_rows, vertex_rows, closure_rows, line_rows = [], [], [], []
        narrative_rows, text_blocks = [], []
        for pc in usable:
            course_rows.extend(bdw_course_rows(pc))
            if param_text(p["out_vertices"]):
                vertex_rows.extend(bdw_vertex_rows(pc, latlon.get(pc["oid"])
                                                   if want_latlon else None))
            closure_rows.extend(bdw_closure_rows(pc, options))
            if param_text(p["out_lines"]):
                line_rows.extend(bdw_line_rows(pc))
            texts = [(lang, bdw_narrative(pc, lang, options)) for lang in languages]
            if param_text(p["out_narrative"]):
                narrative_rows.extend((pc["oid"], pc["key"], "EN" if lang == "ENGLISH" else "AR",
                                       text) for lang, text in texts)
            text_blocks.append(texts)

        created = []
        try:
            if outputs:
                self._write_tables(p, desc, want_latlon, course_rows, vertex_rows, closure_rows,
                                   narrative_rows, line_rows, inputs, created, collector)
            if report_path:
                self._write_report(report_path, desc, options, usable, text_blocks, collector)
        except Exception:
            for done in created:                               # never leave part of it behind
                try:
                    safe_delete(done, inputs)
                except Exception:
                    pass
            raise

        self._summary(collector, features, parcels, nulls, unreadable, options, course_rows)
        if key_name:
            self._duplicate_keys(usable, key_name, collector)
            self._bidi_keys(usable, key_name, collector)
        set_derived_output(parameters, "course_count", str(len(course_rows)))
        flush_messages(collector)

    # -- outputs ---------------------------------------------------------------------

    def _specs(self, columns, rows):
        specs = []
        for index, (name, ftype) in enumerate(columns):
            spec = {"name": name, "type": ftype}
            if ftype == "TEXT":
                spec["values"] = [r[index] for r in rows]
            specs.append(spec)
        return specs

    def _write_one(self, out_path, label, columns, rows, inputs, created, collector,
                   segments=None, sr=None, wkid=None, note=""):
        """Create and fill one table (or, with ``segments``, one line feature class)."""
        specs, renamed = plan_output_fields(out_path, self._specs(columns, rows),
                                            fixed=len(columns))
        for old, new in renamed:
            collector.info("Field {0} is called {1} in the {2}.".format(old, new, label))
        if segments is None:
            path, fmap = create_table(out_path, specs, inputs=inputs)
        else:
            path, fmap = create_feature_class(out_path, GEOM_POLYLINE, sr, specs, inputs=inputs)
        created.append(path)
        null_fields = set()
        names = [fmap[s["name"]] for s in specs]
        if segments is None:
            count = insert_rows(path, names, rows, null_fields=null_fields)
        else:
            count = insert_rows(path, names, [([seg], vals) for seg, vals in zip(segments, rows)],
                                kind=GEOM_POLYLINE, wkid=wkid, null_fields=null_fields)
        collector.info("{0} row(s) written to {1}.".format(count, path))
        warning = folder_null_number_warning(path, specs, fmap, null_fields, note)
        if warning:
            collector.warning(warning)
        return path

    def _write_tables(self, p, desc, want_latlon, course_rows, vertex_rows, closure_rows,
                      narrative_rows, line_rows, inputs, created, collector):
        out = dict((n, param_text(p[n])) for n in _BDW_SHORT_NAMES)
        segments = [seg for seg, _v in line_rows]
        line_values = [vals for _s, vals in line_rows]
        plans = [("out_courses", BDW_COURSE_COLUMNS, course_rows),
                 ("out_vertices", BDW_VERTEX_COLUMNS + (BDW_LATLON_COLUMNS if want_latlon
                                                        else ()), vertex_rows),
                 ("out_closure", BDW_CLOSURE_COLUMNS, closure_rows),
                 ("out_narrative", BDW_NARRATIVE_COLUMNS, narrative_rows),
                 ("out_lines", BDW_LINE_COLUMNS, line_values)]
        # SRC_OID (the first column of every table): the toolkit's one ObjectID field rule
        # (``arcio.oid_field_spec``)
        typed = []
        for name, columns, rows in plans:
            if out[name]:
                spec = oid_output_field(out[name], [r[0] for r in rows], collector,
                                        label="SRC_OID of the {0}".format(_BDW_SHORT_NAMES[name]))
                if spec["type"] != columns[0][1]:
                    columns = ((columns[0][0], spec["type"]),) + tuple(columns[1:])
                    rows = [[oid_field_value(spec, r[0])] + list(r[1:]) for r in rows]
            typed.append((name, columns, rows))
        plans = typed
        # Every schema is planned (text widths from the values, shapefile limits) BEFORE
        # the first output is created, so a bad schema never leaves a half-built result.
        for name, columns, rows in plans:
            if out[name]:
                plan_output_fields(out[name], self._specs(columns, rows), fixed=len(columns))
        notes = {"out_courses": "An empty NOTE and ARC_APPROX 0 then both mean 'none'.",
                 "out_closure": "RATIO_N and MISCL_AZ are empty where the ring closes to "
                                "numerical precision; a dBASE or shapefile stores 0 instead."}
        sr_wkid = desc["sr"]["wkid"] if desc["sr"] else None
        for name, columns, rows in plans:
            if not out[name]:
                continue
            if name == "out_lines":
                self._write_one(out[name], _BDW_SHORT_NAMES[name], columns, rows, inputs,
                                created, collector, segments=segments, sr=desc["sr_object"],
                                wkid=sr_wkid)
            else:
                self._write_one(out[name], _BDW_SHORT_NAMES[name], columns, rows, inputs,
                                created, collector, note=notes.get(name, ""))

    def _write_report(self, path, desc, options, parcels, text_blocks, collector):
        html = path.casefold().endswith((".html", ".htm"))
        info = desc["sr"]
        meta = {"version": __version__,
                "crs": "{0} (WKID {1})".format(info.get("name"), info.get("wkid")),
                "unit_label": BDW_UNITS[options["unit"]][2],
                "settings": "start vertex {0}; orientation {1}; bearings {2}; angle decimals "
                            "{3}; distance decimals {4}; collinear merge {5}.".format(
                                options["start_rule"], options["orientation"],
                                options["bearing_format"], options["angle_decimals"],
                                options["dist_decimals"],
                                "on" if options["merge_collinear"] else "off")}
        with _open_for_write(path, "w", encoding="utf-8" if html else "utf-8-sig") as handle:
            handle.write(bdw_report_html_header(meta) if html else bdw_report_text_header(meta))
            for pc, texts in zip(parcels, text_blocks):
                if html:
                    handle.write(bdw_report_html_parcel(pc, texts, options))
                else:
                    handle.write(bdw_report_text_parcel(pc, [t for _l, t in texts], options))
            if html:
                handle.write(bdw_report_html_footer())
        collector.info("Narrative file written to {0}.".format(path))

    def _summary(self, collector, features, parcels, nulls, unreadable, options, course_rows):
        usable = [pc for pc in parcels if pc["rings"]]
        unusable = [pc["oid"] for pc in parcels if not pc["rings"]]
        rings = sum(len(pc["rings"]) for pc in usable)
        collector.info("{0} polygon(s) read; {1} ring(s) and {2} course(s) described."
                       .format(len(features) + len(nulls) + len(unreadable), rings,
                               len(course_rows)))
        arcs = [pc for pc in usable if pc["arc_segments"]]
        if arcs:
            collector.warning(
                "{0} curved segment(s) in {1} polygon(s) were written as straight chords "
                "(ARC_APPROX = 1): OID {2}. No arc elements (radius, arc length, delta) are "
                "written; the bearing and distance of a flagged course describe the chord."
                .format(sum(pc["arc_segments"] for pc in arcs), len(arcs),
                        analysis_oid_text([pc["oid"] for pc in arcs])))
        if nulls:
            collector.warning("{0} feature(s) have no geometry and were skipped: OID {1}."
                              .format(len(nulls), analysis_oid_text(nulls)))
        if unreadable:
            collector.warning("{0} feature(s) could not be read and were skipped: OID {1} "
                              "(first cause: {2}). Run Repair Geometry on them.".format(
                                  len(unreadable), analysis_oid_text([u[0] for u in unreadable]),
                                  unreadable[0][1]))
        curved = [pc["oid"] for pc in parcels if pc["skipped_curved"]]
        if curved:
            collector.warning(
                "{0} ring(s) made only of curve segments (for example a circle or a "
                "two-arc shape) cannot be written as straight courses and were skipped "
                "(OID {1}). They are valid geometry: this tool does not describe a circle by "
                "its centre and radius. Densify the curves first to describe them as many "
                "short chords (the courses then follow the chords, not the arc).".format(
                    sum(pc["skipped_curved"] for pc in parcels), analysis_oid_text(curved)))
        flat = [pc["oid"] for pc in parcels
                if pc["skipped_rings"] > pc["skipped_curved"] + pc.get("orphan_holes", 0)]
        if flat:
            arc_flat = [pc["oid"] for pc in parcels if pc["skipped_arc_flat"]]
            collector.warning(
                "{0} ring(s) with fewer than three distinct vertices or no area were skipped "
                "(OID {1}). Check the geometry (Check Geometry) and, if it is damaged, run "
                "Repair Geometry on a copy.{2}".format(
                    sum(pc["skipped_rings"] - pc["skipped_curved"] - pc.get("orphan_holes", 0)
                        for pc in parcels),
                    analysis_oid_text(flat),
                    (" {0} ring(s) (OID {1}) have curve segments and become a line or a point "
                     "when each curve is replaced by its chord (for example a semicircle): "
                     "densify the curves first to describe them.".format(
                         sum(pc["skipped_arc_flat"] for pc in parcels),
                         analysis_oid_text(arc_flat)) if arc_flat else "")))
        orphans = [pc["oid"] for pc in parcels if pc.get("orphan_holes")]
        if orphans:
            collector.warning(
                "{0} hole(s) were not described because the outer ring that contains them could "
                "not be described (OID {1}): a hole on its own is not land, so it is never "
                "written as a parcel. Densify the curves of the outer ring (or repair it) and "
                "run the tool again.".format(sum(pc["orphan_holes"] for pc in parcels),
                                             analysis_oid_text(orphans)))
        dropped = [pc["oid"] for pc in usable if pc.get("dropped_holes")]
        if dropped:
            collector.warning(
                "{0} hole(s) could not be written as straight courses (for example a hole "
                "bounded only by curves, such as a circle or a semicircle) and were NOT "
                "excepted (OID {1}): the description of the outer ring INCLUDES their area as "
                "land, about {2:.{d}f} {3} in all. The narrative says so in a note. Densify the "
                "curves of the hole first to describe it by short chords.".format(
                    sum(pc["dropped_holes"] for pc in usable), analysis_oid_text(dropped),
                    sum(pc["dropped_hole_area"] for pc in usable),
                    BDW_AREA_WORDS[options["unit"]][0], d=options["dist_decimals"]))
        lost = [pc["oid"] for pc in usable if pc.get("dropped_parts")]
        if lost:
            collector.warning(
                "{0} part(s) could not be written as straight courses (for example a part "
                "bounded only by curves) and are NOT described, while other parts of the same "
                "polygon are (OID {1}): about {2:.{d}f} {3} of land is missing from the "
                "description. The narrative says so in a note. Densify the curves first.".format(
                    sum(pc["dropped_parts"] for pc in usable), analysis_oid_text(lost),
                    sum(pc["dropped_part_area"] for pc in usable),
                    BDW_AREA_WORDS[options["unit"]][0], d=options["dist_decimals"]))
        promoted = [pc["oid"] for pc in usable if pc.get("promoted_holes")]
        if promoted:
            collector.warning(
                "{0} ring(s) stored counter-clockwise (the direction of a hole) lie inside no "
                "outer ring and were described as outer rings of their own (OID {1}). If they "
                "are holes, the polygon is damaged: run Check Geometry / Repair Geometry on a "
                "copy.".format(sum(pc["promoted_holes"] for pc in usable),
                               analysis_oid_text(promoted)))
        conflicts = [pc["oid"] for pc in usable if pc.get("chord_conflicts")]
        if conflicts:
            collector.warning(
                "{0} hole(s) lie partly or wholly between a true curve of their outer ring and "
                "its chord (OID {1}). The hole is inside the true parcel and is described as a "
                "hole of it, but the straight chord courses of the outer ring do not enclose "
                "it, so the chord description and the hole overlap. Densify the curves first "
                "to describe the curved side by short chords.".format(
                    sum(pc["chord_conflicts"] for pc in usable), analysis_oid_text(conflicts)))
        overlapping = [pc for pc in usable if pc.get("overlap_pairs")]
        if overlapping:
            collector.warning(
                "{0} polygon(s) have parts whose land overlaps another part of the same polygon "
                "(for example one part inside another, or two identical parts): {1}. Each part is "
                "described as land, so the common area is described twice, and the narrative "
                "says so in a note. Such a polygon is not valid geometry: run Check Geometry / "
                "Repair Geometry (or Dissolve) on a copy and describe the repaired polygons. An "
                "island inside a hole of another part, and parts that only touch, are not "
                "overlaps.".format(
                    len(overlapping), "; ".join(
                        "OID {0} (parts {1})".format(pc["oid"], ", ".join(
                            "{0} and {1}".format(a, b) for a, b in pc["overlap_pairs"][:3]) +
                            (", ..." if len(pc["overlap_pairs"]) > 3 else ""))
                        for pc in overlapping[:5]) + ("; ..." if len(overlapping) > 5 else "")))
        unchecked = [pc["oid"] for pc in usable if pc.get("overlap_unchecked")]
        if unchecked:
            collector.info(
                "{0} pair(s) of parts were not tested for overlapping land because the polygon "
                "is very large (OID {1}).".format(
                    sum(pc["overlap_unchecked"] for pc in usable), analysis_oid_text(unchecked)))
        if unusable:
            collector.warning("{0} feature(s) have no ring left to describe: OID {1}.".format(
                len(unusable), analysis_oid_text(unusable)))
        crossing = [pc for pc in usable if pc["crossings"]]
        if crossing:
            collector.warning(
                "{0} polygon(s) have boundary segments that cross each other (self-intersection, "
                "for example a bow-tie): OID {1}. They were described as stored, in vertex "
                "order, but such a description is not a valid boundary and its area and "
                "closure figures are not those of a simple polygon. Run Check Geometry / "
                "Repair Geometry on a copy and describe the repaired polygons. Segments that "
                "only touch (without passing through) are not crossings, and crossings "
                "between different polygons are not tested.".format(
                    len(crossing), analysis_oid_text([pc["oid"] for pc in crossing])))
        dup = sum(pc["duplicates"] for pc in usable)
        if dup:
            collector.info("{0} repeated vertex(es) were dropped.".format(dup))
        merged = sum(pc["merged"] for pc in usable)
        if merged:
            collector.info(
                "{0} collinear vertex(es) were merged. Every merged vertex lies within the "
                "Collinear Tolerance of the course that replaces it; the largest offset is "
                "{1:.6f} {2}.".format(merged, max(pc.get("merge_offset", 0.0) for pc in usable),
                                     BDW_UNITS[options["unit"]][1]))
        reshaped = [pc for pc in usable if pc.get("merge_area_change", 0.0) > BDW_MERGE_AREA_WARN]
        if reshaped:
            collector.warning(
                "Merge Collinear changed the area of a ring by more than {0:.0%} in {1} "
                "polygon(s) (largest change {2:.1%}; OID {3}): the Collinear Tolerance is too "
                "large for these rings and the courses no longer follow their shape. Lower the "
                "tolerance.".format(BDW_MERGE_AREA_WARN, len(reshaped),
                                   max(pc["merge_area_change"] for pc in reshaped),
                                   analysis_oid_text([pc["oid"] for pc in reshaped])))
        capped = sum(pc.get("merge_capped", 0) for pc in usable)
        if capped:
            collector.info(
                "{0} collinear vertex(es) were kept because one merged course would have "
                "replaced more than {1} hull points (OID {2}).".format(
                    capped, BDW_MERGE_HULL,
                    analysis_oid_text([pc["oid"] for pc in usable if pc.get("merge_capped")])))
        spiky = [pc["oid"] for pc in usable if pc.get("spikes")]
        if spiky:
            collector.warning(
                "{0} spike(s) (the boundary runs out and straight back along the same line) in "
                "{1} polygon(s): OID {2}. They were described as stored, as two opposite "
                "courses, but a spike encloses no area and is not a valid boundary. Run Check "
                "Geometry / Repair Geometry on a copy and describe the repaired polygons."
                .format(sum(pc["spikes"] for pc in usable), len(spiky),
                        analysis_oid_text(spiky)))
        zero = [r for r in course_rows if "rounds to zero" in r[-1]]
        if zero:
            collector.warning("{0} course(s) are shorter than the published distance precision "
                              "(distance rounds to zero); their bearing is not meaningful. "
                              "Raise Distance Decimals or clean the geometry.".format(len(zero)))
        closures = [r["closure"] for pc in usable for r in pc["rings"]]
        if closures:
            worst = max(closures, key=lambda c: c["misclosure"])
            ratios = [c for c in closures if c["ratio"] is not None]
            lowest = min(ratios, key=lambda c: c["ratio"]) if ratios else None
            collector.info(
                "Closure of the published (rounded) courses: largest misclosure {0:.4f} {1} "
                "(precision {2}); rounding alone can cause up to {3:.4f} {1} on that ring.{4} "
                "{5} No closure adjustment is applied (out of scope)."
                .format(worst["misclosure"], BDW_UNITS[options["unit"]][1], worst["ratio_txt"],
                        worst["bound"],
                        " Lowest precision of all rings: {0} (misclosure {1:.4f} {2}).".format(
                            lowest["ratio_txt"], lowest["misclosure"],
                            BDW_UNITS[options["unit"]][1]) if lowest else "",
                        "Rounding breaks closure on {0} of {1} ring(s); the misclosure is "
                        "shown, not hidden.".format(len(ratios), len(closures)) if ratios else
                        "Every ring closes to within numerical precision at these settings."))
        collector.info("A drafting aid, not a legal survey instrument. Bearings are grid "
                       "bearings; distances are planar and unreduced.")


# ==========================================================================
# Toolbox (generated)
# ==========================================================================

class Toolbox(object):
    """Spatial Analysis"""

    def __init__(self):
        self.label = "Spatial Analysis"
        self.alias = "spatialbasic"
        self.description = "Line network rules, vertex extraction and Thiessen polygons on a Basic licence; measurements in metres in a projected system. Added since the first list: Rose Diagram; Polygon Shape and Width Metrics; Polygon Holes and Parts; Point Thinning by Priority; Boundary Description (Metes and Bounds). All tools run in the foreground (background geoprocessing is not used)." + " (v" + __version__ + ")"
        self.tools = [LineNetworkRules, VertexExtractor, ThiessenPolygonsConvex, RoseDiagramBuilder, ShapeMetricsWidthTable, PolygonHoleInventory, PriorityPointThinning, BoundaryDescriptionWriter]
